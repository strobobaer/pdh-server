{{/*
  grid-drag: Einträge in einem Tage-Raster ziehen (Schichtplan, Kalender).
    - Eintrag anfassen und auf ein anderes Feld ziehen = verschieben,
      mit Strg/Alt (oder „Kopieren“ eingeschaltet) = kopieren.
    - Griff am rechten Rand des Eintrags über weitere Tage derselben Zeile
      ziehen = an jedem dieser Tage eintragen (z. B. Montag bis Freitag).
  Aufruf: pdhGridDrag({root, chip, cell, onMove(chip, from, to, copy), onFill(chip, from, cells), canDrop(chip, cell)})
*/}}
{{define "grid-drag"}}
<style>
.dg-chip{position:relative;touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}
.dg-chip:active{cursor:grabbing}
.dg-chip .dg-end{position:absolute;top:0;right:0;bottom:0;width:9px;cursor:ew-resize;border-radius:0 6px 6px 0;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--text) 22%,transparent));opacity:0;transition:opacity .12s}
.dg-chip:hover .dg-end,.dg-chip:focus-within .dg-end,html.dg-touch .dg-chip .dg-end{opacity:1}
.dg-ghost{position:fixed;z-index:2000;pointer-events:none;opacity:.85;transform:translate(-50%,-50%) rotate(-2deg);box-shadow:0 6px 18px rgba(0,0,0,.25)}
.dg-over{outline:2px dashed var(--accent);outline-offset:-3px;background:color-mix(in srgb,var(--accent) 12%,transparent)!important}
.dg-no{outline:2px dashed var(--red);outline-offset:-3px}
.dg-fill{background:color-mix(in srgb,var(--accent) 16%,transparent)!important;box-shadow:inset 0 0 0 2px var(--accent)}
.dg-src{opacity:.45}
.dg-copy-on{background:var(--accent)!important;color:var(--on-accent,#fff)!important;border-color:var(--accent)!important}
</style>
<script>
window.pdhGridDrag = function(o){
  const root = o.root; if(!root) return {setCopy(){}};
  let st = null, copyMode = false, swallow = false;
  if(matchMedia('(pointer:coarse)').matches) document.documentElement.classList.add('dg-touch');
  root.querySelectorAll(o.chip).forEach(ch => {
    ch.classList.add('dg-chip'); ch.setAttribute('draggable', 'false');
    if(!ch.querySelector('.dg-end')){ const h = document.createElement('span'); h.className = 'dg-end'; h.title = 'Am Rand ziehen: über weitere Tage verlängern'; ch.appendChild(h); }
    if(!ch.title.includes('ziehen')) ch.title += (ch.title ? ' · ' : '') + 'ziehen = verschieben, Strg = kopieren';
  });
  const cellAt = (x, y) => { const el = document.elementFromPoint(x, y); const c = el && el.closest(o.cell); return c && root.contains(c) ? c : null; };
  const rowCells = c => [...c.closest('tr').querySelectorAll(o.cell)];
  const clear = () => root.querySelectorAll('.dg-over,.dg-no,.dg-fill').forEach(e => e.classList.remove('dg-over', 'dg-no', 'dg-fill'));
  function end(cancel){
    if(!st) return;
    clear(); if(st.ghost) st.ghost.remove(); st.ch.classList.remove('dg-src');
    const s = st; st = null;
    if(cancel || !s.moved) return;
    swallow = true; setTimeout(() => swallow = false, 50);
    if(s.fill){ if(s.cells && s.cells.length > 1 && o.onFill) o.onFill(s.ch, s.from, s.cells); }
    else if(s.to && s.to !== s.from && o.onMove) o.onMove(s.ch, s.from, s.to, s.copy);
  }
  root.addEventListener('pointerdown', e => {
    const ch = e.target.closest(o.chip); if(!ch || !root.contains(ch) || e.button > 0) return;
    const from = ch.closest(o.cell); if(!from) return;
    st = {ch, from, fill: !!e.target.closest('.dg-end'), x: e.clientX, y: e.clientY, moved: false, copy: e.ctrlKey || e.altKey || e.metaKey || copyMode};
    try{ ch.setPointerCapture(e.pointerId); }catch(_){}
    e.preventDefault();
  });
  root.addEventListener('pointermove', e => {
    if(!st) return;
    if(!st.moved){
      if(Math.hypot(e.clientX - st.x, e.clientY - st.y) < 6) return;
      st.moved = true; st.ch.classList.add('dg-src');
      if(!st.fill){ st.ghost = st.ch.cloneNode(true); st.ghost.classList.add('dg-ghost'); st.ghost.style.width = st.ch.offsetWidth + 'px'; document.body.appendChild(st.ghost); }
    }
    st.copy = st.copy || e.ctrlKey || e.altKey || e.metaKey;
    clear();
    const c = cellAt(e.clientX, e.clientY);
    if(st.fill){
      const cells = rowCells(st.from); const a = cells.indexOf(st.from);
      const b = c && c.closest('tr') === st.from.closest('tr') ? cells.indexOf(c) : a;
      st.cells = cells.slice(Math.min(a, b), Math.max(a, b) + 1);
      st.cells.forEach(x => x.classList.add('dg-fill'));
      return;
    }
    st.ghost.style.left = e.clientX + 'px'; st.ghost.style.top = e.clientY + 'px';
    st.to = c && (!o.canDrop || o.canDrop(st.ch, c)) ? c : null;
    if(c) c.classList.add(st.to ? 'dg-over' : 'dg-no');
  });
  root.addEventListener('pointerup', () => end(false));
  root.addEventListener('pointercancel', () => end(true));
  document.addEventListener('keydown', e => { if(e.key === 'Escape') end(true); });
  // nach dem Ziehen keinen Klick (Dialog öffnen) auslösen
  root.addEventListener('click', e => { if(swallow){ e.stopPropagation(); e.preventDefault(); } }, true);
  return {setCopy(v){ copyMode = !!v; }};
};
// pdhGridPost: Änderung speichern, Hinweise zeigen, Seite neu laden
window.pdhGridPost = async function(url, body){
  try{
    const res = await fetch(url, {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
    const j = await res.json().catch(() => ({}));
    if(!res.ok || j.success === false) throw new Error(j.error || ('HTTP ' + res.status));
    if(j.skipped && j.skipped.length) alert((j.added ? j.added + ' Tag(e) eingetragen.\n' : '') + 'Übersprungen:\n• ' + j.skipped.join('\n• '));
    location.reload();
  }catch(err){ alert('Nicht gespeichert: ' + err.message); }
};
</script>
{{end}}
