{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Import</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Verbindungen für Excel-, Datenbank-, MQTT- und Web-/REST-API-Import verwalten</p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if .CanWrite}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title" id="conn-form-title">Neue Verbindung anlegen</div>
  <form id="conn-form" method="POST" action="/import/connections">
    <input type="hidden" name="_id" id="conn-id" value="">
    <div class="grid2" style="gap:10px">
      <div class="form-group">
        <label class="form-label">Name</label>
        <input id="conn-name" name="name" class="form-input" maxlength="150" required placeholder="z.B. ERP-Stammdaten">
      </div>
      <div class="form-group">
        <label class="form-label">Typ</label>
        <select id="conn-kind" name="kind" class="form-input" onchange="connFormKindChanged()" required>
          <option value="">– Typ wählen –</option>
          {{range .Kinds}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
        </select>
      </div>
    </div>

    <div class="kind-fields" id="fields-excel" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Quellpfad</label><input name="f_excel_source_path" class="form-input" placeholder="Pfad/Freigabe der Excel-Datei"></div>
        <div class="form-group"><label class="form-label">Tabellenblatt</label><input name="f_excel_sheet_name" class="form-input" placeholder="z.B. Tabelle1"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_excel_has_header"> Erste Zeile enthält Spaltenüberschriften</label>
    </div>

    <div class="kind-fields" id="fields-sqlite" hidden>
      <div class="form-group"><label class="form-label">Dateipfad</label><input name="f_sqlite_file_path" class="form-input" placeholder="Pfad zur .sqlite/.db-Datei"></div>
    </div>

    <div class="kind-fields" id="fields-mysql" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Host</label><input name="f_mysql_host" class="form-input"></div>
        <div class="form-group"><label class="form-label">Port</label><input type="number" name="f_mysql_port" class="form-input" value="3306"></div>
        <div class="form-group"><label class="form-label">Datenbank</label><input name="f_mysql_database" class="form-input"></div>
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_mysql_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_mysql_password" class="form-input" autocomplete="new-password"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mysql_use_tls"> TLS-Verschlüsselung</label>
    </div>

    <div class="kind-fields" id="fields-mssql" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Host</label><input name="f_mssql_host" class="form-input"></div>
        <div class="form-group"><label class="form-label">Port</label><input type="number" name="f_mssql_port" class="form-input" value="1433"></div>
        <div class="form-group"><label class="form-label">Datenbank</label><input name="f_mssql_database" class="form-input"></div>
        <div class="form-group"><label class="form-label">Instanzname</label><input name="f_mssql_instance_name" class="form-input" placeholder="optional"></div>
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_mssql_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_mssql_password" class="form-input" autocomplete="new-password"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mssql_use_tls"> TLS-Verschlüsselung</label>
    </div>

    <div class="kind-fields" id="fields-mqtt" hidden>
      <div class="form-group" style="max-width:260px">
        <label class="form-label">Broker</label>
        <select id="f_mqtt_broker_mode" name="f_mqtt_broker_mode" class="form-input" onchange="mqttModeChanged()">
          <option value="external">Externer Broker</option>
          <option value="integrated">Integrierter Broker (PDH-eigen)</option>
        </select>
      </div>

      <div id="mqtt-mode-external">
        <div class="grid2" style="gap:10px">
          <div class="form-group"><label class="form-label">Broker-Host</label><input name="f_mqtt_ext_broker_host" class="form-input"></div>
          <div class="form-group"><label class="form-label">Broker-Port</label><input type="number" name="f_mqtt_ext_broker_port" class="form-input" value="1883"></div>
          <div class="form-group"><label class="form-label">Benutzername</label><input name="f_mqtt_ext_username" class="form-input"></div>
          <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_mqtt_ext_password" class="form-input" autocomplete="new-password"></div>
          <div class="form-group"><label class="form-label">Client-ID</label><input name="f_mqtt_ext_client_id" class="form-input"></div>
          <div class="form-group"><label class="form-label">Topic-Filter</label><input name="f_mqtt_ext_topic_filter" class="form-input" placeholder="z.B. werk/+/status"></div>
          <div class="form-group"><label class="form-label">QoS</label>
            <select name="f_mqtt_ext_qos" class="form-input"><option value="0">0</option><option value="1">1</option><option value="2">2</option></select>
          </div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mqtt_ext_use_tls"> TLS-Verschlüsselung</label>
      </div>

      <div id="mqtt-mode-integrated" hidden>
        <p style="font-size:11px;color:var(--muted);margin:0 0 10px">Startet einen in PDH eingebetteten MQTT-Broker mit den folgenden Einstellungen.</p>
        <div class="grid2" style="gap:10px">
          <div class="form-group"><label class="form-label">Listen-Port</label><input type="number" name="f_mqtt_int_listen_port" class="form-input" value="1883"></div>
          <div class="form-group"><label class="form-label">WebSocket-Port</label><input type="number" name="f_mqtt_int_websocket_port" class="form-input" placeholder="optional"></div>
          <div class="form-group"><label class="form-label">Broker-Benutzername</label><input name="f_mqtt_int_broker_username" class="form-input" placeholder="optional"></div>
          <div class="form-group"><label class="form-label">Broker-Passwort</label><input type="password" name="f_mqtt_int_broker_password" class="form-input" autocomplete="new-password"></div>
          <div class="form-group"><label class="form-label">Max. Clients</label><input type="number" name="f_mqtt_int_max_clients" class="form-input" placeholder="optional"></div>
          <div class="form-group"><label class="form-label">TLS-Zertifikat</label><input name="f_mqtt_int_tls_cert_path" class="form-input" placeholder="Pfad zum Zertifikat, optional"></div>
          <div class="form-group"><label class="form-label">TLS-Schlüssel</label><input name="f_mqtt_int_tls_key_path" class="form-input" placeholder="Pfad zum privaten Schlüssel, optional"></div>
          <div class="form-group"><label class="form-label">Topic-Filter</label><input name="f_mqtt_int_topic_filter" class="form-input" placeholder="z.B. werk/+/status"></div>
          <div class="form-group"><label class="form-label">QoS</label>
            <select name="f_mqtt_int_qos" class="form-input"><option value="0">0</option><option value="1">1</option><option value="2">2</option></select>
          </div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 4px"><input type="checkbox" name="f_mqtt_int_allow_anonymous"> Anonyme Verbindungen erlauben</label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:0 0 4px"><input type="checkbox" name="f_mqtt_int_persistence_enabled"> Persistenz aktivieren</label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:0 0 10px"><input type="checkbox" name="f_mqtt_int_retain_enabled"> Retained Messages erlauben</label>
      </div>
    </div>

    <div class="kind-fields" id="fields-web" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">URL</label><input type="url" name="f_web_url" class="form-input" placeholder="https://..."></div>
        <div class="form-group"><label class="form-label">Methode</label>
          <select name="f_web_method" class="form-input"><option value="GET">GET</option><option value="POST">POST</option></select>
        </div>
        <div class="form-group"><label class="form-label">Abruf-Intervall (Minuten)</label><input type="number" min="0" name="f_web_poll_interval_minutes" class="form-input" placeholder="0 = nur manuell"></div>
      </div>
    </div>

    <div class="kind-fields" id="fields-rest_api" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Basis-URL</label><input type="url" name="f_rest_api_base_url" class="form-input" placeholder="https://api..."></div>
        <div class="form-group"><label class="form-label">Authentifizierung</label>
          <select id="f_rest_api_auth_method" name="f_rest_api_auth_method" class="form-input" onchange="restAuthMethodChanged()">
            <option value="none">Keine</option>
            <option value="basic">Basic Auth</option>
            <option value="bearer">Bearer-Token</option>
            <option value="api_key">API-Key</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Abruf-Intervall (Minuten)</label><input type="number" min="0" name="f_rest_api_poll_interval_minutes" class="form-input" placeholder="0 = nur manuell"></div>
      </div>
      <div id="rest-auth-basic" hidden class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_rest_api_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_rest_api_password" class="form-input" autocomplete="new-password"></div>
      </div>
      <div id="rest-auth-bearer" hidden class="form-group"><label class="form-label">Bearer-Token</label><input name="f_rest_api_bearer_token" class="form-input"></div>
      <div id="rest-auth-api_key" hidden class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Header-Name</label><input name="f_rest_api_api_key_header" class="form-input" placeholder="z.B. X-Api-Key"></div>
        <div class="form-group"><label class="form-label">Header-Wert</label><input name="f_rest_api_api_key_value" class="form-input"></div>
      </div>
    </div>

    <div style="display:flex;gap:8px;margin-top:10px">
      <button type="submit" class="btn btn-primary" id="conn-submit"><i class="ti ti-plus"></i> Verbindung anlegen</button>
      <button type="button" class="btn" id="conn-cancel" onclick="resetConnForm()" hidden>Abbrechen</button>
    </div>
  </form>
</div>
{{end}}

<div class="card">
  <div class="card-title">Bestehende Verbindungen · {{len .Connections}}</div>
  {{if .Connections}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Name</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Typ</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Status</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Angelegt von</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Am</th>
      </tr>
    </thead>
    <tbody>
      {{range .Connections}}
      <tr data-conn-id="{{.ID}}" data-conn-kind="{{.Kind}}" data-conn-name="{{.Name}}" data-conn-config='{{.ConfigJSON}}'
          {{if $.CanWrite}}oncontextmenu="showContextMenu(event, connContextItems(this, 'import')); return false;"{{end}}>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Name}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.KindLabel}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{if .Enabled}}<span class="badge" style="background:var(--green)">Aktiv</span>{{else}}<span class="badge" style="background:var(--muted)">Deaktiviert</span>{{end}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.CreatedBy}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.CreatedAt}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Verbindungen angelegt</div>
  {{end}}
</div>
{{end}}

{{define "scripts"}}
<script>
function connFormKindChanged(){
  document.querySelectorAll('.kind-fields').forEach(function(el){ el.hidden = true; });
  const kind = document.getElementById('conn-kind').value;
  const target = document.getElementById('fields-' + kind);
  if(target) target.hidden = false;
}
function mqttModeChanged(){
  const mode = document.getElementById('f_mqtt_broker_mode').value;
  document.getElementById('mqtt-mode-external').hidden = mode !== 'external';
  document.getElementById('mqtt-mode-integrated').hidden = mode !== 'integrated';
}
function restAuthMethodChanged(){
  const method = document.getElementById('f_rest_api_auth_method').value;
  ['basic','bearer','api_key'].forEach(function(m){
    document.getElementById('rest-auth-' + m).hidden = method !== m;
  });
}

function resetConnForm(){
  const form = document.getElementById('conn-form');
  form.reset();
  form.action = '/import/connections';
  document.getElementById('conn-id').value = '';
  document.getElementById('conn-kind').disabled = false;
  document.getElementById('conn-form-title').textContent = 'Neue Verbindung anlegen';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-plus"></i> Verbindung anlegen';
  document.getElementById('conn-cancel').hidden = true;
  connFormKindChanged();
  mqttModeChanged();
  restAuthMethodChanged();
}

function fillConnField(kind, field, value, isCheckbox){
  const el = document.querySelector('[name="f_' + kind + '_' + field + '"]');
  if(!el) return;
  if(isCheckbox) el.checked = value === 'true';
  else el.value = value || '';
}

function editConnFromRow(row){
  const form = document.getElementById('conn-form');
  const id = row.dataset.connId;
  const kind = row.dataset.connKind;
  const name = row.dataset.connName;
  let config = {};
  try{ config = JSON.parse(row.dataset.connConfig || '{}'); }catch(e){}

  form.reset();
  document.getElementById('conn-kind').value = kind;
  document.getElementById('conn-kind').disabled = true;
  connFormKindChanged();
  mqttModeChanged();
  restAuthMethodChanged();
  document.getElementById('conn-name').value = name;
  document.getElementById('conn-id').value = id;

  const booleanFields = ['has_header','use_tls','ext_use_tls','int_allow_anonymous','int_persistence_enabled','int_retain_enabled'];
  Object.keys(config).forEach(function(field){
    fillConnField(kind, field, config[field], booleanFields.indexOf(field) !== -1);
  });
  if(kind === 'mqtt') mqttModeChanged();
  if(kind === 'rest_api') restAuthMethodChanged();

  form.action = form.action.replace(/\/connections.*/, '/connections/' + id + '/edit-web');
  document.getElementById('conn-form-title').textContent = 'Verbindung bearbeiten';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-device-floppy"></i> Speichern';
  document.getElementById('conn-cancel').hidden = false;
  form.scrollIntoView({behavior:'smooth', block:'start'});
}

async function toggleConnFromRow(row, direction){
  try{
    const res = await fetch('/' + direction + '/connections/' + row.dataset.connId + '/toggle-web', {method:'POST', credentials:'same-origin'});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    location.reload();
  }catch(e){
    alert('Status konnte nicht geändert werden: ' + e.message);
  }
}

function deleteConnFromRow(row, direction){
  if(!confirm('Verbindung "' + row.dataset.connName + '" wirklich löschen?')) return;
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/' + direction + '/connections/' + row.dataset.connId + '/delete-web';
  document.body.appendChild(form);
  form.submit();
}

function connContextItems(row, direction){
  return [
    {heading: row.dataset.connName},
    {label: 'Bearbeiten', icon: 'ti-edit', onClick: function(){ editConnFromRow(row); }},
    {label: 'Aktivieren/Deaktivieren', icon: 'ti-power', onClick: function(){ toggleConnFromRow(row, direction); }},
    {separator: true},
    {label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){ deleteConnFromRow(row, direction); }}
  ];
}

if(document.getElementById('conn-form')){
  connFormKindChanged();
  mqttModeChanged();
  restAuthMethodChanged();
}
</script>
{{end}}
