{{define "t-pick"}}<h3>Anlage wählen</h3>
<nav class="t-crumbs" aria-label="Ebene">{{range .Crumbs}}<a class="t-btn" href="{{$.Self}}?nav={{.Value}}">{{.Label}}</a><span aria-hidden="true">›</span>{{end}}<b>{{.Here.Label}}</b></nav>
<div class="t-rzgrid t-pickgrid">
  <a class="t-btn primary" href="{{.Self}}?infra={{.Here.Value}}"><i class="ti ti-check" aria-hidden="true"></i> {{.Here.Label}} wählen</a>
  {{range .Items}}{{if .Kids}}<a class="t-btn" href="{{$.Self}}?nav={{.ID}}">{{.Name}} <i class="ti ti-chevron-right" aria-hidden="true"></i></a>{{else}}<a class="t-btn" href="{{$.Self}}?infra={{.ID}}">{{.Name}}</a>{{end}}{{end}}
</div>{{end}}
{{define "t-picked"}}{{if not .Single}}<div class="t-picked"><span>Anlage: <b>{{.SelName}}</b></span><a class="t-btn" href="{{.Self}}">Ändern</a></div>{{end}}{{end}}
<!DOCTYPE html>
<html lang="de" data-theme="{{if eq .Scheme "light"}}light{{else}}dark{{end}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>{{if .NoInfra}}Terminal{{else}}{{.Name}} – Terminal{{end}}</title>
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css?v={{appVersion}}">
<style>
/* Anlagenterminal (terminal_page.go): Vollbild für den Wandmonitor, nur Berührung.
   Trefferflächen mindestens 64 px, keine Hover-Bedienung, wenig Text. */
*{box-sizing:border-box;margin:0;padding:0}
/* Farben wie das übrige PDH (base.gohtml): dunkel = :root, hell = html[data-theme="light"]; das Feld theme der Geräte-Schnittstelle trägt dieselben Werte (terminal_functions.go) */
:root{--bg:#202020;--bg2:#2b2b2b;--bg3:#323232;--accent:#4f8ef7;--on-accent:#fff;--text:#f3f3f3;--muted:#a3a3a3;--border:#3b3b3b;--red:#ef4444;--amber:#f59e0b;--green:#10b981;--font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
html[data-theme="light"]{--bg:#f3f3f3;--bg2:#ffffff;--bg3:#f9f9f9;--accent:#005fb8;--text:#1b1b1b;--muted:#5f5f5f;--border:#e2e2e2;--red:#dc2626;--amber:#d97706;--green:#059669}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);font-size:clamp(18px,1.6vw,28px);line-height:1.3;overflow:hidden;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;cursor:default}
body{display:flex;flex-direction:column;padding:max(2vh,12px) max(2vw,16px)}
[hidden]{display:none !important}
a{color:inherit;text-decoration:none}
.t-head{display:flex;align-items:center;gap:1.2vw;min-height:64px;padding-bottom:1.4vh}
.t-path{flex:1;min-width:0;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.t-path b{color:var(--text);font-weight:700}
.t-clock{color:var(--muted);font-variant-numeric:tabular-nums}
.t-btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-width:64px;min-height:64px;padding:0 1.6em;border-radius:18px;border:2px solid var(--border);background:var(--bg3);color:var(--text);font:inherit;font-weight:700}
.t-btn:active{filter:brightness(1.25)}
.t-btn.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.t-btn.big{min-height:clamp(88px,12vh,140px);font-size:1.25em;border-radius:22px;width:100%}
/* Schoner */
.t-saver{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3vh;text-align:center;padding:4vh 4vw;background:var(--bg)}
.t-saver .name{font-size:clamp(40px,7vw,120px);font-weight:800;line-height:1.1;max-width:92vw;overflow-wrap:anywhere}
.t-saver .time{font-size:clamp(32px,5vw,84px);color:var(--muted);font-variant-numeric:tabular-nums}
.t-saver .hint{font-size:clamp(20px,2.2vw,36px);color:var(--accent);font-weight:700;padding:1.2vh 2.4vw;border:2px solid var(--accent);border-radius:999px}
/* Störungsinfo */
.t-cols{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:1.6vw}
.t-tile{display:flex;flex-direction:column;min-height:0;background:var(--bg2);border:2px solid var(--border);border-radius:22px;padding:1.4vh 1.4vw}
.t-tile h2{display:flex;align-items:center;gap:.5em;font-size:1.25em;padding-bottom:1vh;border-bottom:2px solid var(--border)}
.t-tile h2 .n{margin-left:auto;min-width:2.2em;text-align:center;padding:.05em .5em;border-radius:999px;background:var(--bg3);font-variant-numeric:tabular-nums}
.t-tile.faults h2 .n.has{background:var(--red);color:#fff}
.t-tile.tickets h2 .n.has{background:var(--amber);color:#1b1500}
.t-list{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;list-style:none}
.t-list li{display:grid;grid-template-columns:1fr auto;column-gap:1em;padding:1.1vh 0;border-bottom:1px solid var(--border)}
.t-list .ti-title{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-meta{grid-column:1/-1;color:var(--muted);font-size:.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-st{color:var(--muted);font-size:.85em;white-space:nowrap}
.t-empty{display:flex;align-items:center;justify-content:center;gap:.5em;flex:1;color:var(--green);font-weight:700;font-size:1.1em}
.t-more{color:var(--muted);text-align:center;padding:1vh 0;font-size:.85em}
/* Sensoren nach Kartenanmeldung (terminal_sensors.go, terminal.js) */
.t-sensors{margin-top:1.6vh;background:var(--bg2);border:2px solid var(--border);border-radius:22px;padding:1.4vh 1.4vw;max-height:38vh;overflow-y:auto}
.t-sensors h2{display:flex;align-items:center;gap:.5em;font-size:1.15em;padding-bottom:.8vh;border-bottom:2px solid var(--border)}
.t-sens-body{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,22em),1fr));gap:1vh 1.4vw;margin-top:1vh}
.t-sens{border:1px solid var(--border);border-radius:14px;padding:.8vh .9vw;min-width:0}
.t-sens-head{display:flex;flex-wrap:wrap;align-items:center;gap:.4em .8em;font-weight:700;overflow-wrap:anywhere}
.t-sens-g{color:var(--muted);font-size:.75em;font-weight:700;text-transform:uppercase;margin-top:.6vh}
.t-sens-row{display:flex;justify-content:space-between;gap:1em;padding:.3vh 0;border-top:1px solid var(--border)}
.t-sens-row .v{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}.t-sens-row.stale{color:var(--muted)}.t-sens-row.stale .v{font-weight:400}
.hs{display:inline-flex;align-items:center;gap:.35em;flex-wrap:wrap;font-size:.85em;font-weight:600;padding:.1em .6em;border-radius:999px;border:1px solid var(--border)}
.hs-run .hs-state{color:var(--green)}.hs-stop .hs-state{color:var(--red)}.hs-none .hs-state{color:var(--muted)}.hs-count{font-variant-numeric:tabular-nums;font-weight:800}
.hs.hs-pulse{animation:t-hs-pulse .6s ease-out}@keyframes t-hs-pulse{40%{transform:scale(1.08)}}
@media (prefers-reduced-motion:reduce){.hs.hs-pulse{animation:none}}
.t-foot{padding-top:1.6vh;display:flex;gap:1.6vw}
/* Neu */
.t-new{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) auto;gap:1.6vw}
.t-tilebtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2vh;border-radius:26px;border:2px solid var(--border);font-weight:800;font-size:1.7em;padding:3vh 2vw;min-height:64px;text-align:center}
.t-tilebtn i{font-size:2.2em}
.t-tilebtn.fault{background:#7f1d1d;border-color:var(--red);color:#fff}
.t-tilebtn.ticket{background:#78350f;border-color:var(--amber);color:#fff}
.t-tilebtn:active{filter:brightness(1.25)}
.t-tilebtn.off{opacity:.35;filter:grayscale(1)}
.t-tilebtn.off:active{filter:grayscale(1)}
.t-note{grid-column:1/-1;color:var(--muted);text-align:center;font-weight:700}
.t-empty.off{color:var(--muted)}
.t-stop{grid-column:1/-1;background:var(--bg2);border:2px dashed var(--border);border-radius:22px;padding:2vh 2vw}
.t-stop h2{font-size:1.1em;display:flex;align-items:center;gap:.5em}
.t-stop p{color:var(--muted);margin-top:.5vh}
/* Hinweis ohne Anlage */
.t-none{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2vh;text-align:center}
.t-none i{font-size:4em;color:var(--amber)}
.t-none p{font-size:1.6em;font-weight:700;max-width:30em}
.t-none small{color:var(--muted);font-size:.9em}
/* Kartensitzung: Leiste unten, Hinweis bei unbekannter Karte */
.t-card{flex-shrink:0;margin-top:1.4vh;display:flex;align-items:center;gap:1.6vw;padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--green);border-radius:22px}
.t-card .who{flex:1;min-width:0;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-card .t-btn{min-height:64px}
.t-cardmsg{position:fixed;left:50%;transform:translateX(-50%);bottom:max(2vh,12px);max-width:90vw;padding:1.2vh 2vw;background:var(--bg3);border:2px solid var(--amber);border-radius:22px;font-weight:700;text-align:center;z-index:8}
/* Anmeldung ohne Kartenleser: Ziffernfeld, Knopf, Dialog (Tasten mindestens 64 px) */
.t-login{flex-shrink:0;margin-top:1.4vh;padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--border);border-radius:22px;display:flex;flex-direction:column;gap:1vh}
.t-login .l-msg{color:var(--amber);font-weight:700;text-align:center}
.t-login .l-row{display:flex;gap:1vw;align-items:center;flex-wrap:wrap;margin-bottom:1vh}
.t-login input,.t-dialog input{min-height:64px;flex:1;min-width:8em;padding:0 .8em;border-radius:14px;border:2px solid var(--border);background:var(--bg);color:var(--text);font:inherit;-webkit-user-select:text;user-select:text}
.t-login input:focus,.t-dialog input:focus{border-color:var(--accent);outline:none}
.t-keypad{display:grid;grid-template-columns:repeat(6,minmax(64px,1fr));gap:.6vh .6vw}
.t-keypad .t-btn{padding:0;min-width:64px;min-height:64px}
.t-dialog{position:fixed;inset:0;z-index:7;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.7)}
.t-dialog form{width:min(90vw,32em);display:flex;flex-direction:column;gap:1.4vh;padding:2vh 2vw;background:var(--bg2);border:2px solid var(--border);border-radius:22px}
.t-dialog .l-row{display:flex;gap:1vw}
.t-dialog .l-row .t-btn{flex:1}
/* Infobildschirm (Modus global): Folienschau, nur Berührung, nichts verlinkt, kein Markieren */
body[data-mode="global"],body[data-saver-slides]{padding:0;-webkit-touch-callout:none}
.g-stage{touch-action:none;position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--bg);overflow:hidden}
.g-img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;pointer-events:none;-webkit-user-drag:none}
.g-cap{position:absolute;left:0;right:0;bottom:0;padding:2vh 4vw;background:linear-gradient(transparent,rgba(0,0,0,.75));font-size:clamp(24px,3vw,56px);font-weight:800;text-align:center;pointer-events:none}
.g-text{max-width:90vw;max-height:94vh;overflow:hidden;text-align:center;display:flex;flex-direction:column;gap:3vh}
.g-text h1{font-size:clamp(40px,6vw,110px);line-height:1.1;overflow-wrap:anywhere}
.g-text p{font-size:clamp(26px,3.4vw,64px);line-height:1.3;white-space:pre-wrap;overflow-wrap:anywhere}
.g-vorg{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:grid;grid-template-columns:1fr 1fr;gap:1.6vw}
.g-vorg.one{grid-template-columns:1fr}
.g-vorg .t-tile{min-height:0}
.g-vorg .t-list li{cursor:pointer}
.g-vorg .t-list li:active{background:var(--bg3)}
.g-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff;pointer-events:none}
.g-shield{position:absolute;inset:0;background:transparent;touch-action:none}
.g-stats{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:flex;flex-direction:column;gap:2vh;min-height:0}
.g-stats h1{font-size:clamp(28px,3.6vw,64px);line-height:1.1;text-align:center;overflow-wrap:anywhere}
.g-nums{display:flex;flex-wrap:wrap;gap:1.4vw;justify-content:center}
.g-num{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:1.2vh 2vw;text-align:center;min-width:12vw}
.g-num b{display:block;font-size:clamp(34px,5vw,90px);line-height:1.1}
.g-num span{font-size:clamp(16px,1.8vw,32px);color:var(--muted)}
.g-chartbox{flex:1;min-height:0;display:flex;flex-direction:column;gap:1vh}
.g-chart{flex:1;min-height:0;width:100%}
.g-grid{stroke:var(--border);stroke-width:1}
.g-axis{fill:var(--muted);font-size:20px}
.g-bar.s0{fill:var(--accent)}
.g-bar.s1{fill:var(--green)}
.g-legend{display:flex;gap:2vw;justify-content:center;font-size:clamp(16px,1.8vw,32px);color:var(--muted)}
.g-legend .k::before{content:"";display:inline-block;width:.9em;height:.9em;border-radius:3px;margin-right:.4em;vertical-align:-.1em;background:var(--accent)}
.g-legend .k.s1::before{background:var(--green)}
.g-plan{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:flex;flex-direction:column;gap:2vh;min-height:0}
.g-plan h1{font-size:clamp(28px,3.6vw,64px);line-height:1.1;text-align:center;overflow-wrap:anywhere}
.g-plan-days{flex:1;min-height:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22vw),1fr));gap:1.2vw;align-content:start;overflow:hidden}
.g-plan-days.one{grid-template-columns:minmax(0,60vw);justify-content:center}
.g-plan-day{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:1.2vh 1.2vw;min-width:0;overflow:hidden}
.g-plan-day.today{border-color:var(--accent)}
.g-plan-day h2{font-size:clamp(20px,2.4vw,44px);margin-bottom:1vh;overflow-wrap:anywhere}
.g-plan-group{margin-bottom:1vh}
.g-plan-group h3{font-size:clamp(16px,1.9vw,34px);color:var(--muted);border-left:6px solid var(--accent);padding-left:.5em;overflow-wrap:anywhere}
.g-plan-item{font-size:clamp(18px,2.2vw,40px);line-height:1.25;overflow-wrap:anywhere}
.g-plan-item.more,.g-plan-none{color:var(--muted)}
.g-plan-empty{flex:1;display:flex;align-items:center;justify-content:center;font-size:clamp(28px,4vw,72px);color:var(--muted)}
.g-tk,.g-yr{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:flex;flex-direction:column;gap:2vh;min-height:0}
.g-tk h1,.g-yr h1{font-size:clamp(28px,3.6vw,64px);line-height:1.1;text-align:center;overflow-wrap:anywhere}
.g-tk-cols{flex:1;min-height:0;column-width:26vw;column-gap:1.4vw;overflow:hidden}
.g-tk-block{break-inside:avoid-column;background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:1.2vh 1.2vw;margin-bottom:1.2vh}
.g-tk-block.late{border-color:#d13438}
.g-tk-block h2{font-size:clamp(20px,2.2vw,40px);margin-bottom:.8vh;overflow-wrap:anywhere}
.g-tk-block.late h2{color:#d13438}
.g-tk-block h3{font-size:clamp(16px,1.8vw,32px);color:var(--muted);margin:.8vh 0 .3vh}
.g-tk-block h3.today{color:var(--accent)}
.g-tk-item{border-left:6px solid var(--accent);padding-left:.6em;margin-bottom:.8vh;break-inside:avoid-column}
.g-tk-item.late{border-left-color:#d13438}
.g-tk-title{font-size:clamp(18px,2vw,36px);line-height:1.2;overflow-wrap:anywhere}
.g-tk-badge{display:inline-block;background:#d13438;color:#fff;border-radius:6px;padding:0 .4em;margin-right:.4em;font-size:.7em;font-weight:800;vertical-align:.1em}
.g-tk-meta{font-size:clamp(14px,1.5vw,26px);color:var(--muted);overflow-wrap:anywhere}
.g-yr-body{flex:1;min-height:0;display:grid;grid-template-columns:minmax(14vw,22vw) minmax(0,1fr);column-gap:1vw;overflow:hidden}
.g-yr-months{position:relative;height:clamp(24px,3.4vh,48px);border-bottom:2px solid var(--border)}
.g-yr-month{position:absolute;top:0;bottom:0;box-sizing:border-box;text-align:center;font-size:clamp(13px,1.5vw,26px);color:var(--muted);overflow:hidden;white-space:nowrap;border-left:1px solid var(--border)}
.g-yr-plot{position:relative;pointer-events:none}
.g-yr-line{position:absolute;top:0;bottom:0;width:1px;background:var(--border)}
.g-yr-today{position:absolute;top:0;bottom:0;width:3px;margin-left:-1px;background:#d13438;z-index:2}
.g-yr-name{display:flex;flex-direction:column;justify-content:center;min-width:0;overflow:hidden}
.g-yr-name b{font-size:clamp(15px,1.7vw,30px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.g-yr-name small{font-size:clamp(12px,1.2vw,21px);color:var(--muted)}
.g-yr-track{position:relative;min-width:0}
.g-yr-bar{position:absolute;top:18%;bottom:18%;box-sizing:border-box;border-radius:8px;background:#8a94a6;color:#fff;font-size:clamp(12px,1.3vw,22px);font-weight:700;line-height:1;display:flex;align-items:center;padding:0 .5em;white-space:nowrap;overflow:hidden;min-width:3px}
.g-yr-bar.cl{border-top-left-radius:0;border-bottom-left-radius:0}
.g-yr-bar.cr{border-top-right-radius:0;border-bottom-right-radius:0}
.g-yr-info{display:flex;gap:2vw;justify-content:center;font-size:clamp(14px,1.5vw,26px);color:var(--muted)}
.g-yr-info .k::before{content:"";display:inline-block;width:.9em;height:.9em;border-radius:3px;margin-right:.4em;vertical-align:-.1em;background:var(--k,var(--accent))}
.g-empty{font-size:clamp(32px,5vw,90px);font-weight:800;text-align:center}
.g-empty small{display:block;margin-top:2vh;font-size:.4em;color:var(--muted);font-weight:700}
/* Zahnrad zur Terminal-Einstellung (nur Gerätesitzung), oben rechts über allem; Trefferfläche 48 px */
.t-gear{position:fixed;top:max(6px,.8vh);right:max(6px,.8vw);z-index:50;display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);color:var(--muted);font-size:24px;opacity:.7}
.t-gear:active{opacity:1;filter:brightness(1.25)}
body.has-gear .t-head{padding-right:56px}
body.has-gear .g-vorg{padding-top:60px}
/* Rüsten (terminal_setup.go): Kachel auf „Neu“, Seite /terminal/rusten – Raster folgt der Bildschirmgröße */
.t-new .t-rzlink{grid-column:1/-1;flex-direction:row;font-size:1.3em;padding:2.2vh 2vw;background:#064e3b;border-color:var(--green);color:#fff}
.t-new .t-rzlink.off{color:var(--text)}
.t-new.one .t-tilebtn.fault,.t-new.one .t-tilebtn.ticket{grid-column:1/-1}.t-new.nof{grid-template-rows:auto}
.t-new .t-rzlink i{font-size:1.6em}.t-rzlink small{display:block;font-weight:600;font-size:.6em;color:inherit;opacity:.8}
.t-new.has-rz{grid-template-rows:minmax(0,1fr) auto auto}
.t-rz{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:1.6vh;padding-bottom:1vh;-webkit-overflow-scrolling:touch}
.t-rz h3{font-size:.8em;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-top:.6vh}
.t-rznote{padding:1.2vh 1.6vw;background:var(--bg3);border:2px solid var(--amber);border-radius:18px;font-weight:700}
.t-rzrun{padding:1.6vh 2vw;background:var(--bg2);border:2px solid var(--border);border-left:10px solid var(--amber);border-radius:22px;display:flex;align-items:center;gap:2vw;flex-wrap:wrap}
.t-rzrun.fault{border-left-color:var(--red)}.t-rzrun b{flex:1;min-width:12em}.t-rzrun span{color:var(--amber);font-weight:700}
.t-rzrun .t-btn{min-width:10em}
.t-rzgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,13em),1fr));gap:1.4vw}
.t-rzgrid .t-btn,.t-opt span{min-height:clamp(72px,11vh,120px);font-size:1.1em;border-radius:20px;text-align:center;padding:.4em 1em}
.t-rzgrid .t-btn.cur{border-color:var(--amber);background:var(--bg2);opacity:1}
.t-opt{position:relative;display:block}
.t-opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
.t-opt span{display:flex;align-items:center;justify-content:center;border:2px solid var(--border);background:var(--bg3);font-weight:700}
.t-opt input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}
.t-rzadd{display:flex;flex-direction:column;gap:1.4vh}
.t-rzh{font-size:1.3em}
.t-text{width:100%;min-height:clamp(90px,14vh,200px);padding:1vh 1.2vw;border-radius:18px;border:2px solid var(--border);background:var(--bg2);color:var(--text);font:inherit;-webkit-user-select:text;user-select:text}
.t-file{color:var(--muted);font:inherit}
.t-rzname{display:block;width:100%;font-size:1.1em;font-weight:700}
.t-rzname input{display:block;width:100%;min-height:clamp(72px,11vh,120px);margin-top:.4em;padding:0 1.2vw;font:inherit;font-size:1.5em;border-radius:20px;border:2px solid var(--border);background:var(--bg2);color:var(--text);-webkit-user-select:text;user-select:text}
.t-crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.5em;font-size:1.05em}.t-crumbs .t-btn{min-height:52px;padding:0 1em}
.t-pickgrid .t-btn{justify-content:space-between;text-decoration:none}
.t-pickgrid .t-btn.primary{grid-column:1/-1;justify-content:center}
.t-picked{display:flex;align-items:center;justify-content:space-between;gap:2vw;padding:1.2vh 1.6vw;background:var(--bg2);border:2px solid var(--border);border-radius:18px}
/* Vorgänge (terminal_vorgaenge.go): Liste, Fenster zum Vorgang, Abschluss-Assistent */
.t-new .t-vlink{background:#14532d;border-color:#22c55e;color:#fff}
body[data-mode="vorgaenge"]{--accent-rgb:79,142,247}
.v-sec{display:flex;flex-direction:column;gap:.4vh}
.v-sec h2{font-size:1.15em;display:flex;align-items:center;gap:.5em}
.v-list{list-style:none;display:flex;flex-direction:column;gap:1vh}
.v-row{display:flex;align-items:center;gap:1.2vw;min-height:64px;padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--border);border-radius:18px}
.v-row.work{border-left:10px solid var(--accent)}.v-row.wait{border-left:10px solid var(--amber)}
a.v-row:active{filter:brightness(1.2)}
a.v-row.v-nope{opacity:.7}
.v-t{flex:1;min-width:0;display:flex;flex-direction:column}
.v-t b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.v-t small{color:var(--muted);font-size:.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.v-st{font-weight:700;white-space:nowrap}
.v-st.work{color:var(--accent)}.v-st.wait{color:var(--amber)}
.v-act{display:flex;gap:1vw;margin:0}
.v-act form{margin:0}
.t-dialog .v-dlg{width:min(94vw,44em);max-height:92vh;overflow-y:auto}
.v-dlg h2{font-size:1.2em}
.v-dlg .v-meta{color:var(--muted);font-size:.85em}
.v-people{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,11em),1fr));gap:1vw}
.v-people .t-opt span{min-height:64px;font-size:1em;flex-direction:column;gap:.1em}
.v-people .t-opt span small{font-weight:400;font-size:.7em;opacity:.8}
.v-dlg .l-row{display:flex;gap:1vw}.v-dlg .l-row .t-btn{flex:1}
.t-btn.warn{background:var(--amber);border-color:var(--amber);color:#1b1b1b}
.t-btn.ok{background:var(--green);border-color:var(--green);color:#fff}
.cw .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:64px;padding:0 1.4em;border-radius:16px;border:2px solid var(--border);background:var(--bg3);color:var(--text);font:inherit;font-weight:700}
.cw .btn-primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.cw .form-input,.cw select,.cw textarea{width:100%;min-height:56px;padding:.4em .8em;border-radius:14px;border:2px solid var(--border);background:var(--bg);color:var(--text);font:inherit;-webkit-user-select:text;user-select:text}
.cw .form-label{display:block;font-weight:700;margin:.6em 0 .2em}
.cw{font-size:.95em}.cw-body{font-size:1em}
.cw-check input,.cw-people input{width:28px;height:28px}
.cw-people label{min-height:56px}
/* HMI und Wartungen (terminal_hmi.go, terminal_wartung.go): Kacheln neben Rüsten, Listen, Viewer */
.t-xrow{grid-column:1/-1;display:flex;gap:1.6vw}
.t-new .t-xrow .t-rzlink{flex:1;grid-column:auto;min-width:0}
.t-new .t-hmilink{background:#1e3a8a;border-color:var(--accent);color:#fff}
.t-new .t-mlink{background:#4c1d95;border-color:#8b5cf6;color:#fff}
.t-mlist li.t-mrow{display:flex;align-items:center;gap:1.2vw;padding:1.1vh 0}
.t-mrow .m-t{flex:1;min-width:0;display:flex;flex-direction:column}
.t-mrow .m-t b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-mrow form{margin:0}
.ti-meta.late{color:var(--amber)}
.t-mcount{display:inline-block;min-width:2.2em;text-align:center;padding:.05em .5em;border-radius:999px;background:var(--bg3);font-size:.8em}
.t-hmihead{flex-wrap:wrap;gap:1vw}
.t-hmimode{display:inline-flex;align-items:center;gap:.4em;font-weight:700;color:var(--accent)}
.t-hmimode.ctl{color:var(--amber)}
.t-hmistatus{color:var(--muted);font-size:.85em}.t-hmistatus.ok{color:var(--green)}.t-hmistatus.err{color:var(--red)}
.t-hmiscreen{flex:1;min-height:0;background:#000;border:2px solid var(--border);border-radius:14px;overflow:hidden;position:relative;touch-action:none}
.t-card form{margin:0}
/* Schichtplan (terminal_schichtplan.go) */
.t-new .t-plink{background:#134e4a;border-color:#14b8a6;color:#fff}
.t-pdepts,.t-pweek{display:flex;flex-wrap:wrap;gap:1vw;align-items:center}
.t-pdepts .t-btn.sel,.t-pweek .t-btn.sel{background:var(--accent);border-color:var(--accent);color:#fff}
.t-pgroup{padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--border);border-radius:18px}
.t-pgroup h3{margin:0 0 .4vh}.t-pgroup .tm{color:var(--muted);font-weight:400;font-size:.85em}
.t-pgroup.abs{border-style:dashed}
.t-ptable{width:100%;border-collapse:collapse;font-size:.9em}
.t-ptable th,.t-ptable td{padding:.9vh .6vw;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}
.t-ptable th small{display:block;color:var(--muted);font-weight:400}
.t-ptable .today{background:var(--bg3)}.t-ptable .we{color:var(--muted)}
.t-ptable .abs{color:var(--muted);font-style:italic}.t-ptable .du{display:block;color:var(--accent);font-size:.85em}
.t-ptable .sh small{display:block;color:var(--muted)}
.t-pscroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
@media (max-width:820px){.t-xrow{flex-direction:column}.g-vorg{grid-template-columns:1fr}.t-cols,.t-new{grid-template-columns:1fr}.t-new,.t-new.has-rz{grid-template-rows:auto}}
</style>
</head>
<body{{if .DeviceSession}} class="has-gear"{{end}}{{if .Fn.Vorgaenge}} data-vorgaenge="1"{{end}}{{if .SetupCard}} data-card-in="1"{{end}} data-mode="{{.Mode}}"{{if .SaverSlides}} data-saver-slides="1"{{end}} data-idle="{{.Idle}}"{{if .SettingsEvents}} data-settings-events="1"{{end}}{{if .CardEvents}} data-card-events="1" data-card-notify="{{.CardNotify}}"{{if ne .Mode "schoner"}} data-manual-login="{{.ManualLogin}}" data-password-button="{{if .PasswordButton}}1{{else}}0{{end}}"{{end}}{{end}}>
{{if .DeviceSession}}<a class="t-gear" href="{{.AdminURL}}" aria-label="Terminal-Einstellungen" title="Terminal-Einstellungen"><i class="ti ti-settings" aria-hidden="true"></i></a>{{end}}
{{if .NoInfra}}
<div class="t-none">
  <i class="ti ti-plug-off" aria-hidden="true"></i>
  <p>Diesem Terminal ist keine Anlage zugeordnet</p>
  <small>Bitte in PDH unter „Benutzer“ eine Anlage für dieses Terminal festlegen.</small>
</div>
{{else if eq .Mode "global"}}
<div class="g-stage" id="g-stage" data-name="{{.Name}}" data-frame-csp="{{.FrameCSP}}" aria-live="off"><div class="g-empty">{{.Name}}<small>Folien werden geladen …</small></div></div>
{{else if and (eq .Mode "schoner") .SaverSlides}}
<div class="g-stage" id="g-stage" data-name="{{.Name}}" data-frame-csp="{{.FrameCSP}}" aria-live="off"><div class="g-empty">{{.Name}}<small>Folien werden geladen …</small></div></div>
{{else if eq .Mode "schoner"}}
<a class="t-saver" href="/terminal/info" aria-label="Zum Melden berühren">
  <div class="name">{{.Name}}</div>
  <div class="time t-clock" data-clock>&nbsp;</div>
  <div class="hint"><i class="ti ti-hand-finger" aria-hidden="true"></i> Zum Melden berühren</div>
</a>
{{else if eq .Mode "info"}}
<div class="t-head">
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .NoPerm}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier keine Störungen und Tickets anzeigen.</small></div>
{{else}}
<div class="t-cols">
  {{if .CanFaults}}<section class="t-tile faults" aria-labelledby="h-faults">
    <h2 id="h-faults"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Offene Störungen <span class="n{{if .Info.FaultsTotal}} has{{end}}" data-count="faults">{{.Info.FaultsTotal}}</span></h2>
    {{if .Info.Faults}}<ul class="t-list" data-list="faults">
      {{range .Info.Faults}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="faults" hidden></ul><div class="t-empty" data-empty="faults"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Störungen</div>{{end}}
    <div class="t-more" data-more="faults"{{if not .FaultsMore}} hidden{{end}}>{{if .FaultsMore}}… und {{.FaultsMore}} weitere{{end}}</div>
  </section>{{else}}<section class="t-tile faults" aria-labelledby="h-faults"><h2 id="h-faults"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Offene Störungen</h2><div class="t-empty off"><i class="ti ti-lock" aria-hidden="true"></i> Keine Berechtigung für Störungen</div></section>{{end}}
  {{if .CanTickets}}<section class="t-tile tickets" aria-labelledby="h-tickets">
    <h2 id="h-tickets"><i class="ti ti-ticket" aria-hidden="true"></i> Offene Tickets <span class="n{{if .Info.TicketsTotal}} has{{end}}" data-count="tickets">{{.Info.TicketsTotal}}</span></h2>
    {{if .Info.Tickets}}<ul class="t-list" data-list="tickets">
      {{range .Info.Tickets}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="tickets" hidden></ul><div class="t-empty" data-empty="tickets"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Tickets</div>{{end}}
    <div class="t-more" data-more="tickets"{{if not .TicketsMore}} hidden{{end}}>{{if .TicketsMore}}… und {{.TicketsMore}} weitere{{end}}</div>
  </section>{{else}}<section class="t-tile tickets" aria-labelledby="h-tickets"><h2 id="h-tickets"><i class="ti ti-ticket" aria-hidden="true"></i> Offene Tickets</h2><div class="t-empty off"><i class="ti ti-lock" aria-hidden="true"></i> Keine Berechtigung für Tickets</div></section>{{end}}
</div>
{{end}}
<section class="t-sensors" data-sensors hidden aria-labelledby="h-sensors">
  <h2 id="h-sensors"><i class="ti ti-cpu" aria-hidden="true"></i> Sensoren</h2>
  <div class="t-sens-body" data-sensors-body></div>
</section>
<div class="t-foot">
  <a class="t-btn primary big" href="/terminal/neu"><i class="ti ti-plus" aria-hidden="true"></i> Neu</a>
</div>
{{else if eq .Mode "melden"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .Report.LoggedIn}} · {{.Report.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .Report.Can}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier nichts melden.</small></div>
{{else if not .Report.Pick.Sel}}
<div class="t-rz">
  <h2 class="t-rzh">{{.Report.Title}}</h2>
  {{if .Report.Notice}}<div class="t-rznote" role="alert">{{.Report.Notice}}</div>{{end}}
  {{template "t-pick" .Report.Pick}}
</div>
{{else}}
<form class="t-rz t-rzadd" method="post" action="/terminal/{{if eq .Report.Type "fault"}}stoerung{{else}}ticket{{end}}" enctype="multipart/form-data">
  <h2 class="t-rzh">{{.Report.Title}}</h2>
  {{if .Report.Notice}}<div class="t-rznote" role="alert">{{.Report.Notice}}</div>{{end}}
  <input type="hidden" name="infra" value="{{.Report.Pick.Sel}}">
  {{template "t-picked" .Report.Pick}}
  {{if not .Report.LoggedIn}}<label class="t-rzname">Kürzel/Name (freiwillig)<input type="text" name="name" maxlength="40" autocomplete="off"></label>{{end}}
  {{if .Report.Texts}}<h3>Was ist los?</h3>
  <div class="t-rzgrid">{{range .Report.Texts}}<label class="t-opt"><input type="radio" name="text_id" value="{{.ID}}"><span>{{.Label}}</span></label>{{end}}</div>{{end}}
  <h3>{{if .Report.Texts}}Ergänzung (freiwillig){{else}}Beschreibung{{end}}</h3>
  <textarea class="t-text" name="text" maxlength="2000" rows="3" aria-label="Beschreibung"></textarea>
  <h3>Art</h3>
  <div class="t-rzgrid"><label class="t-opt"><input type="radio" name="kind" value="electrical" required><span><i class="ti ti-bolt" aria-hidden="true"></i>&nbsp;elektrisch</span></label><label class="t-opt"><input type="radio" name="kind" value="mechanical" required><span><i class="ti ti-settings" aria-hidden="true"></i>&nbsp;mechanisch</span></label></div>
  <h3>Zustand der Anlage</h3>
  <div class="t-rzgrid"><label class="t-opt"><input type="radio" name="state" value="running" required><span><i class="ti ti-player-play" aria-hidden="true"></i>&nbsp;Anlage läuft</span></label><label class="t-opt"><input type="radio" name="state" value="stopped" required><span><i class="ti ti-player-pause" aria-hidden="true"></i>&nbsp;Anlage steht</span></label></div>
  <h3>Foto (freiwillig)</h3>
  <input class="t-file" type="file" name="files" accept="image/*" capture="environment" multiple aria-label="Foto">
  <button type="submit" class="t-btn primary big"><i class="ti ti-send" aria-hidden="true"></i> Melden</button>
</form>
{{end}}
{{else if eq .Mode "rusten"}}
<div class="t-head">
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .SetupCard}} · {{.SetupPerson}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .SetupCan}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>{{if .SetupPerson}}{{.SetupPerson}} darf an dieser Anlage nicht rüsten.{{else}}Dieses Terminal darf hier nicht rüsten.{{end}}</small></div>
{{else}}
<div class="t-rz">
  {{if .Setup.Notice}}<div class="t-rznote" role="alert">{{.Setup.Notice}}</div>{{end}}
  {{if not .Pick.Sel}}
  {{template "t-pick" .Pick}}
  {{else}}
  {{template "t-picked" .Pick}}
  {{if .SetupAdd}}
  <form class="t-rzadd" method="post" action="/terminal/rusten/add">
    <input type="hidden" name="infra" value="{{.Pick.Sel}}">
    <h3>Rüsttaste</h3>
    <div class="t-rzgrid">{{range .Setup.Buttons}}<label class="t-opt"><input type="radio" name="button_id" value="{{.ID}}" required><span>{{.Name}}</span></label>{{end}}</div>
    <h3>Beginn</h3>
    <div class="t-rzgrid">{{range .SetupAgo}}<label class="t-opt"><input type="radio" name="ago" value="{{.Value}}" required><span>{{.Label}}</span></label>{{end}}</div>
    <h3>Dauer</h3>
    <div class="t-rzgrid">{{range .SetupDur}}<label class="t-opt"><input type="radio" name="dur" value="{{.Value}}" required><span>{{.Label}}</span></label>{{end}}</div>
    {{if not .SetupCard}}<label class="t-rzname">Kürzel/Name (freiwillig)<input type="text" name="name" maxlength="40" autocomplete="off"></label>{{end}}
    <button type="submit" class="t-btn primary big"><i class="ti ti-check" aria-hidden="true"></i> Nachtragen</button>
  </form>
  {{else}}
  {{if .Setup.Running}}<div class="t-rzrun"><b>{{.Setup.Text}}</b>{{if .Setup.Overrun}}<span><i class="ti ti-alert-triangle" aria-hidden="true"></i> Höchstdauer überschritten</span>{{end}}
    <form method="post" action="/terminal/rusten/finish"><input type="hidden" name="infra" value="{{.Pick.Sel}}"><button type="submit" class="t-btn primary big"><i class="ti ti-check" aria-hidden="true"></i> Fertig</button></form></div>
  {{else if .Setup.Fault}}<div class="t-rzrun fault"><b><i class="ti ti-alert-triangle" aria-hidden="true"></i> {{.Setup.Text}}</b></div>{{end}}
  {{if .Setup.Buttons}}
  <form class="t-rzadd" method="post" action="/terminal/rusten/start">
    <input type="hidden" name="infra" value="{{.Pick.Sel}}">
    {{if not .SetupCard}}<label class="t-rzname">Kürzel/Name (freiwillig)<input type="text" name="name" maxlength="40" autocomplete="off"></label>{{end}}
    <div class="t-rzgrid">{{range .Setup.Buttons}}<button type="submit" class="t-btn{{if .Current}} cur{{end}}" name="button_id" value="{{.ID}}"{{if .Current}} aria-current="true" disabled{{end}}>{{.Name}}</button>{{end}}</div>
  </form>
  <a class="t-btn" href="/terminal/rusten?infra={{.Pick.Sel}}&amp;nachtragen=1"><i class="ti ti-plus" aria-hidden="true"></i> Rüstzeit nachtragen</a>
  {{else}}<div class="t-empty"><i class="ti ti-tool-off" aria-hidden="true"></i> Keine Rüsttasten an dieser Anlage</div>{{end}}
  {{end}}
  {{end}}
</div>
{{end}}
{{else if eq .Mode "stillstand"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .Down.Card}} · {{.Down.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .Down.Can}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>{{if .Down.Person}}{{.Down.Person}} darf an dieser Anlage keinen Stillstand melden.{{else}}Dieses Terminal darf hier keinen Stillstand melden.{{end}}</small></div>
{{else}}
<div class="t-rz">
  {{if .Down.Notice}}<div class="t-rznote" role="alert">{{.Down.Notice}}</div>{{end}}
  {{if not .Pick.Sel}}
  {{template "t-pick" .Pick}}
  {{else}}
  {{template "t-picked" .Pick}}
  {{if .Down.Running}}<div class="t-rzrun"><b><i class="ti ti-player-pause" aria-hidden="true"></i> Stillstand{{if .Down.Reason}}: {{.Down.Reason}}{{end}}</b><span>{{.Down.Since}}</span>
    <form method="post" action="/terminal/stillstand/finish"><input type="hidden" name="infra" value="{{.Pick.Sel}}"><button type="submit" class="t-btn primary big"><i class="ti ti-player-play" aria-hidden="true"></i> Ende</button></form></div>
  {{else if .Down.Reasons}}
  <form class="t-rzadd" method="post" action="/terminal/stillstand/start">
    <input type="hidden" name="infra" value="{{.Pick.Sel}}">
    {{if not .Down.Card}}<label class="t-rzname">Kürzel/Name (freiwillig)<input type="text" name="name" maxlength="40" autocomplete="off"></label>{{end}}
    <h3>Grund des Stillstands</h3>
    <div class="t-rzgrid">{{range .Down.Reasons}}<button type="submit" class="t-btn" name="reason_id" value="{{.ID}}">{{.Name}}</button>{{end}}</div>
  </form>
  {{else}}<div class="t-empty"><i class="ti ti-player-pause" aria-hidden="true"></i> Keine Stillstandsgründe an dieser Anlage</div>{{end}}
  {{end}}
</div>
{{end}}
{{else if eq .Mode "hmi"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .HMI.LoggedIn}} · {{.HMI.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
<div class="t-rz">
  <h2 class="t-rzh">HMI</h2>
  {{if .HMI.Items}}<ul class="t-list t-mlist">
    {{range .HMI.Items}}<li class="t-mrow"><div class="m-t"><b>{{.Name}}</b>{{if .Path}}<span class="ti-meta">{{.Path}}</span>{{end}}</div>
      <a class="t-btn" href="{{printf "/terminal/hmi/%s/%s" .InfraID .ID}}"><i class="ti ti-eye" aria-hidden="true"></i> Ansehen</a>{{if .Control}}<a class="t-btn primary" href="{{printf "/terminal/hmi/%s/%s?mode=control" .InfraID .ID}}"><i class="ti ti-hand-click" aria-hidden="true"></i> Bedienen</a>{{end}}</li>{{end}}
  </ul>{{else}}<div class="t-empty off"><i class="ti ti-lock" aria-hidden="true"></i> Kein HMI verfügbar</div>{{end}}
</div>
{{else if eq .Mode "hmiview"}}
<div class="t-head t-hmihead">
  <a class="t-btn" href="/terminal/hmi"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path"><b>{{.HMI.Sel.Name}}</b>{{if .HMI.Sel.Path}} · {{.HMI.Sel.Path}}{{end}}</div>
  {{if eq .HMI.Mode "control"}}<span class="t-hmimode ctl"><i class="ti ti-hand-click" aria-hidden="true"></i> Bedienen</span><a class="t-btn" href="{{printf "/terminal/hmi/%s/%s" .HMI.Sel.InfraID .HMI.Sel.ID}}"><i class="ti ti-eye" aria-hidden="true"></i> Nur ansehen</a>
  {{else}}<span class="t-hmimode"><i class="ti ti-eye" aria-hidden="true"></i> Nur ansehen</span>{{if .HMI.Sel.Control}}<a class="t-btn" href="{{printf "/terminal/hmi/%s/%s?mode=control" .HMI.Sel.InfraID .HMI.Sel.ID}}"><i class="ti ti-hand-click" aria-hidden="true"></i> Bedienen</a>{{end}}{{end}}
  <span id="hmi-status" class="t-hmistatus">Verbinde…</span>
</div>
<div id="hmi-screen" class="t-hmiscreen" data-infra="{{.HMI.Sel.InfraID}}" data-hmi="{{.HMI.Sel.ID}}" data-hmi-mode="{{.HMI.Mode}}"></div>
<script type="module">
import { RFB } from '/vendor/novnc/rfb.min.js';
const screen = document.getElementById('hmi-screen'), status = document.getElementById('hmi-status');
const MODE = screen.dataset.hmiMode === 'control' ? 'control' : 'view';
let rfb = null;
function setStatus(t, k){ status.textContent = t; status.className = 't-hmistatus' + (k ? ' ' + k : ''); }
function connect(){
  if(rfb){ try{ rfb.disconnect(); }catch(e){} }
  screen.replaceChildren(); setStatus('Verbinde…');
  const url = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/terminal/hmi/' + screen.dataset.infra + '/' + screen.dataset.hmi + '/ws?mode=' + MODE;
  rfb = new RFB(screen, url, {shared: true, wsProtocols: ['binary']});
  rfb.viewOnly = MODE !== 'control'; rfb.showDotCursor = MODE !== 'control'; rfb.scaleViewport = true; rfb.resizeSession = false; rfb.focusOnClick = MODE === 'control';
  rfb.addEventListener('connect', () => setStatus('Verbunden', 'ok'));
  rfb.addEventListener('disconnect', e => { setStatus(e.detail && e.detail.clean ? 'Getrennt' : 'Verbindung unterbrochen – zum Neuverbinden berühren', 'err'); screen.addEventListener('pointerdown', connect, {once: true}); });
  rfb.addEventListener('securityfailure', () => setStatus('Anmeldung am HMI fehlgeschlagen', 'err'));
}
window.addEventListener('beforeunload', () => { if(rfb) rfb.disconnect(); });
connect();
</script>
{{else if eq .Mode "schichtplan"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .Plan.Denied}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Für die Abteilungen dieses Terminals darf der Schichtplan hier nicht angezeigt werden.</small></div>
{{else}}
<div class="t-rz">
  <h2 class="t-rzh"><i class="ti ti-calendar-week" aria-hidden="true"></i> Schichtplan {{.Plan.DeptName}}</h2>
  {{if gt (len .Plan.Depts) 1}}<div class="t-pdepts">{{range .Plan.Depts}}<a class="t-btn{{if .Sel}} sel{{end}}" href="/terminal/schichtplan?abt={{.ID}}{{if $.Plan.Next}}&amp;woche=naechste{{end}}">{{.Name}}</a>{{end}}</div>{{end}}
  <div class="t-pweek">
    <a class="t-btn{{if not .Plan.Next}} sel{{end}}" href="/terminal/schichtplan?abt={{.Plan.Dept}}">Diese Woche</a>
    <a class="t-btn{{if .Plan.Next}} sel{{end}}" href="/terminal/schichtplan?abt={{.Plan.Dept}}&amp;woche=naechste">Nächste Woche</a>
    <span class="t-mcount">{{.Plan.WeekLabel}}</span>
  </div>
  {{if .Plan.ShowToday}}
  <h3>Heute</h3>
  {{range .Plan.Today}}<div class="t-pgroup{{if .Absent}} abs{{end}}"><h3>{{.Title}}{{if .Time}} <span class="tm">{{.Time}}</span>{{end}}</h3>{{range $i, $n := .Names}}{{if $i}}, {{end}}{{$n}}{{end}}</div>
  {{else}}<div class="t-empty off">Heute ist niemand eingeteilt</div>{{end}}
  {{end}}
  <h3>Woche</h3>
  {{if .Plan.Rows}}<div class="t-pscroll"><table class="t-ptable">
    <thead><tr><th></th>{{range .Plan.Days}}<th class="{{if .Today}}today{{end}}{{if .Weekend}} we{{end}}">{{.Short}}<small>{{.Label}}</small>{{if .Holiday}}<small>{{.Holiday}}</small>{{end}}</th>{{end}}</tr></thead>
    <tbody>{{range .Plan.Rows}}<tr><th>{{.Name}}</th>{{range $i, $c := .Cells}}<td class="{{if (index $.Plan.Days $i).Today}}today{{end}}">{{if $c.Absent}}<span class="abs">abwesend</span>{{else if $c.Shift}}<span class="sh">{{$c.Shift}}<small>{{$c.Time}}</small></span>{{end}}{{range $c.Duties}}<span class="du">{{.}}</span>{{end}}</td>{{end}}</tr>{{end}}</tbody>
  </table></div>
  {{else}}<div class="t-empty off">Für diese Woche ist nichts eingeteilt</div>{{end}}
</div>
{{end}}
{{else if eq .Mode "vorgaenge"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .Vorg.LoggedIn}} · {{.Vorg.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .Vorg.NoView}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier keine Vorgänge anzeigen.</small></div>
{{else}}
<div class="t-rz" id="v-root">
  <div class="t-rznote" id="v-note" role="alert"{{if not .Vorg.Notice}} hidden{{end}}>{{.Vorg.Notice}}</div>
  {{if .Vorg.ReadOnly}}<div class="t-rznote" role="status"><i class="ti ti-id-badge-2" aria-hidden="true"></i> Nur Ansicht{{if eq .Vorg.Modus "nur_karte"}} – zum Bearbeiten bitte mit der Karte anmelden{{else}} an diesem Gerät{{end}}.</div>{{end}}
  {{if .Vorg.Mine}}
  <section class="v-sec" aria-label="Meine Vorgänge">
    <h2><i class="ti ti-user-check" aria-hidden="true"></i> Meine Vorgänge · {{.Vorg.Person}}</h2>
    <ul class="v-list">
    {{range .Vorg.Mine}}<li class="v-row {{.Group}}"><div class="v-t"><b>{{.TypeLabel}}: {{.Title}}</b><small>{{if .Path}}{{.Path}} · {{end}}{{.PeopleNames}}</small></div><span class="v-st {{.Group}}">{{.StatusLabel}}</span>
      {{if .Started}}<div class="v-act">
        <form method="post" action="/terminal/vorgaenge/warten"><input type="hidden" name="type" value="{{.Type}}"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" class="t-btn warn"><i class="ti ti-player-pause" aria-hidden="true"></i> Warten</button></form>
        <form method="post" action="/terminal/vorgaenge/beenden" data-fin><input type="hidden" name="type" value="{{.Type}}"><input type="hidden" name="id" value="{{.ID}}"><button type="submit" class="t-btn ok"><i class="ti ti-check" aria-hidden="true"></i> Beenden</button></form>
      </div>{{else}}<a class="t-btn primary" href="/terminal/vorgaenge?sel={{.Sel}}">Starten</a>{{end}}</li>{{end}}
    </ul>
  </section>
  {{end}}
  {{range .Vorg.Groups}}{{$g := .}}
  <section class="v-sec" aria-label="{{.Kind.Plural}}">
    <h2><i class="ti {{.Kind.Icon}}" aria-hidden="true"></i> {{.Kind.Plural}} <span class="t-mcount">{{.Total}}</span></h2>
    {{if .Items}}<ul class="v-list">
    {{range .Items}}<li><a class="v-row {{.Group}}{{if not .CanAct}} v-nope{{end}}" href="/terminal/vorgaenge?sel={{.Sel}}"><div class="v-t"><b>{{.Title}}</b><small>{{if .Path}}{{.Path}}{{end}}{{if and .Path .PeopleNames}} · {{end}}{{.PeopleNames}}</small></div><span class="v-st {{.Group}}">{{.StatusLabel}}</span>{{if .CanAct}}<i class="ti ti-chevron-right" aria-hidden="true"></i>{{else}}<i class="ti ti-lock" aria-hidden="true"></i>{{end}}</a></li>{{end}}
    </ul>{{if .More}}<div class="t-more">… und {{.More}} weitere</div>{{end}}
    {{else}}<div class="t-empty"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen {{.Kind.Plural}}</div>{{end}}
  </section>
  {{end}}
</div>
{{with .Vorg.Sel}}
<div class="t-dialog" role="dialog" aria-modal="true" aria-label="{{.TypeLabel}}">
{{if .Started}}
  <form class="v-dlg" method="post" action="/terminal/vorgaenge/beenden" data-fin>
    <h2>{{.TypeLabel}}: {{.Title}}</h2>
    <div class="v-meta">{{if .Path}}{{.Path}} · {{end}}{{.StatusLabel}}{{if .PeopleNames}} · {{.PeopleNames}}{{end}}</div>
    <input type="hidden" name="type" value="{{.Type}}"><input type="hidden" name="id" value="{{.ID}}">
    <button type="submit" class="t-btn ok big"><i class="ti ti-check" aria-hidden="true"></i> Beenden</button>
    <button type="submit" class="t-btn warn big" formaction="/terminal/vorgaenge/warten"><i class="ti ti-player-pause" aria-hidden="true"></i> Warten (geht noch weiter)</button>
    <a class="t-btn" href="/terminal/vorgaenge">Abbrechen</a>
  </form>
{{else}}
  <form class="v-dlg" method="post" action="/terminal/vorgaenge/start">
    <h2>{{.TypeLabel}}: {{.Title}}</h2>
    <div class="v-meta">{{if .Path}}{{.Path}} · {{end}}{{.StatusLabel}}</div>
    <input type="hidden" name="type" value="{{.Type}}"><input type="hidden" name="id" value="{{.ID}}">
    <h3>Wer arbeitet daran?</h3>
    {{if $.Vorg.PickFallback}}<div class="v-meta"><i class="ti ti-info-circle" aria-hidden="true"></i> Keine Personen in den Abteilungen des Terminals – Instandhaltung</div>{{end}}
    {{if $.Vorg.Pick}}<div class="v-people">{{range $.Vorg.Pick}}<label class="t-opt"><input type="checkbox" name="people" value="{{.ID}}"{{if .On}} checked{{end}}><span>{{.Name}}{{if .Dept}}<small>{{.Dept}}</small>{{end}}</span></label>{{end}}</div>
    {{else}}<div class="t-empty off"><i class="ti ti-users-minus" aria-hidden="true"></i> Keine Mitarbeitenden in den Abteilungen dieses Terminals und keine Abteilung „Instandhaltung“ mit Personen</div>{{end}}
    <div class="l-row">
      <a class="t-btn" href="/terminal/vorgaenge">Abbrechen</a>
      <button type="submit" class="t-btn primary"{{if not $.Vorg.Pick}} disabled{{end}}><i class="ti ti-player-play" aria-hidden="true"></i> Starten</button>
    </div>
  </form>
{{end}}
</div>
{{end}}
{{template "completion-wizard"}}
{{end}}
{{else if eq .Mode "wartung"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .Maint.LoggedIn}} · {{.Maint.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .Maint.LoggedIn}}
<div class="t-none"><i class="ti ti-id-badge-2" aria-hidden="true"></i><p>Bitte mit der Karte anmelden</p><small>Die Wartungen zeigt PDH nur angemeldeten Personen – mit deren eigenen Rechten.</small></div>
{{else}}
<div class="t-rz">
  <h2 class="t-rzh">Offene Wartungen <span class="t-mcount">{{.Maint.Total}}</span></h2>
  {{if .Maint.Items}}<ul class="t-list t-mlist">
    {{range .Maint.Items}}<li class="t-mrow"><div class="m-t"><b>{{.Title}}</b><span class="ti-meta{{if .Overdue}} late{{end}}">{{if .Path}}{{.Path}} · {{end}}fällig {{.Due}}{{if .Overdue}} (überfällig){{end}} · {{.Status}}</span></div>
      <form method="post" action="/terminal/pdh"><input type="hidden" name="next" value="/maintenance/tasks/{{.ID}}"><button type="submit" class="t-btn primary"><i class="ti ti-external-link" aria-hidden="true"></i> Öffnen</button></form></li>{{end}}
  </ul>
  {{if .Maint.More}}<div class="t-more">… und {{.Maint.More}} weitere – in PDH unter Wartung</div>{{end}}
  {{else}}<div class="t-empty"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Wartungen</div>{{end}}
  <form method="post" action="/terminal/pdh"><input type="hidden" name="next" value="/maintenance"><button type="submit" class="t-btn"><i class="ti ti-external-link" aria-hidden="true"></i> Alle Wartungen in PDH</button></form>
</div>
{{end}}
{{else}}
<div class="t-head">
  <a class="t-btn" href="/terminal/info"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .NoPerm}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier nichts melden oder anzeigen.</small></div>
{{else}}
{{if .Done}}<div class="t-rznote" role="status">{{if eq .Done "fault"}}Störung gemeldet – danke.{{else}}Ticket erstellt – danke.{{end}}</div>{{end}}
<div class="t-new{{if or .Setup.Show .HMITile .MaintTile .VorgTile .PlanTile}} has-rz{{end}}{{if and .Fn.Stoerung (not .Fn.Ticket)}} one{{else if and .Fn.Ticket (not .Fn.Stoerung)}} one{{else if not .Fn.Stoerung}} nof{{end}}">
  {{if .Fn.Stoerung}}<a class="t-tilebtn fault" href="/terminal/stoerung"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Störung</a>{{end}}
  {{if .Fn.Ticket}}<a class="t-tilebtn ticket" href="/terminal/ticket"><i class="ti ti-ticket" aria-hidden="true"></i> Ticket</a>{{end}}
  {{if or .Setup.Show .HMITile .MaintTile .VorgTile .PlanTile}}<div class="t-xrow">{{end}}
  {{if .Setup.Show}}{{if .SetupCan}}<a class="t-tilebtn t-rzlink" href="/terminal/rusten"><i class="ti ti-tool" aria-hidden="true"></i><span>Rüsten{{if .Setup.Running}}<small>{{.Setup.Text}}</small>{{else if .Setup.Fault}}<small>{{.Setup.Text}}</small>{{end}}</span></a>{{else}}<span class="t-tilebtn t-rzlink off" aria-disabled="true"><i class="ti ti-tool" aria-hidden="true"></i><span>Rüsten<small>Keine Berechtigung zum Rüsten</small></span></span>{{end}}{{end}}
  {{if .HMITile}}<a class="t-tilebtn t-rzlink t-hmilink" href="/terminal/hmi"><i class="ti ti-device-desktop-analytics" aria-hidden="true"></i><span>HMI</span></a>{{end}}
  {{if .MaintTile}}<a class="t-tilebtn t-rzlink t-mlink" href="/terminal/wartung"><i class="ti ti-calendar-check" aria-hidden="true"></i><span>Wartungen</span></a>{{end}}
  {{if .VorgTile}}<a class="t-tilebtn t-rzlink t-vlink" href="/terminal/vorgaenge"><i class="ti ti-list-check" aria-hidden="true"></i><span>Vorgänge</span></a>{{end}}
  {{if .PlanTile}}<a class="t-tilebtn t-rzlink t-plink" href="/terminal/schichtplan"><i class="ti ti-calendar-week" aria-hidden="true"></i><span>Schichtplan</span></a>{{end}}
  {{if or .Setup.Show .HMITile .MaintTile .VorgTile .PlanTile}}</div>{{end}}
  {{if .Fn.Stillstand}}
  <div class="t-stop{{if .Down.Running}} run{{end}}">
    <h2><i class="ti ti-player-pause" aria-hidden="true"></i> Stillstand</h2>
    {{if .Down.Can}}<a class="t-btn{{if .Down.Running}} primary{{end}} big" href="/terminal/stillstand">{{if .Down.Running}}<i class="ti ti-player-pause" aria-hidden="true"></i> {{.Down.ToolText}}{{else}}<i class="ti ti-player-pause" aria-hidden="true"></i> Stillstand melden{{end}}</a>
    {{else}}<p>Keine Berechtigung für Stillstände</p>{{end}}
  </div>
  {{end}}
</div>
{{end}}
{{end}}
{{if and .CardEvents (ne .Mode "schoner")}}<div class="t-card" data-card-bar hidden><span class="who"><i class="ti ti-id-badge-2" aria-hidden="true"></i> Angemeldet: <span data-card-name></span></span><form method="post" action="/terminal/pdh"><button type="submit" class="t-btn" data-pdh-open><i class="ti ti-external-link" aria-hidden="true"></i> PDH öffnen</button></form><button type="button" class="t-btn" data-card-logout>Abmelden</button></div>
<div class="t-cardmsg" data-card-msg role="status" hidden></div>
<div class="t-login" id="login-panel" hidden>
  <div class="l-msg" data-login-msg hidden></div>
  <div data-login-fields hidden>
    <div class="l-row">
      <input type="text" id="login-card" inputmode="none" autocomplete="off" autocapitalize="characters" maxlength="32" placeholder="Kartennummer" aria-label="Kartennummer">
      <input type="password" id="login-pin" inputmode="none" autocomplete="off" maxlength="8" placeholder="PIN" aria-label="PIN">
    </div>
    <div class="t-keypad" id="login-keypad" aria-label="Ziffernfeld"></div>
  </div>
  <button type="button" class="t-btn" id="login-password-btn" hidden><i class="ti ti-user" aria-hidden="true"></i> Mit Benutzer und Passwort</button>
</div>
<div class="t-dialog" id="login-dialog" role="dialog" aria-modal="true" aria-label="Mit Benutzer und Passwort" hidden>
  <form autocomplete="off">
    <input type="text" id="login-user" autocomplete="off" autocapitalize="none" placeholder="Benutzer" aria-label="Benutzer">
    <input type="password" id="login-pass" autocomplete="off" placeholder="Passwort" aria-label="Passwort">
    <div class="l-row">
      <button type="button" class="t-btn" data-login-cancel>Abbrechen</button>
      <button type="submit" class="t-btn primary">Anmelden</button>
    </div>
  </form>
</div>{{end}}
<script src="/terminal/terminal.js?v={{appVersion}}"></script>
</body>
</html>
