    <rect class="bg3" x="470" y="36" width="154" height="34" rx="8"/><rect x="480" y="44" width="20" height="18" rx="3" fill="#e30613"/><text x="508" y="51">Firmenfarbe</text><text x="508" y="63" class="t-m">wird angepasst</text>
  </g>
  <rect class="bg3" x="16" y="84" width="608" height="52" rx="8"/>
  <text x="28" y="104" class="t-m">Vorschau:</text>
  <rect class="ac" x="84" y="94" width="92" height="22" rx="6"/><text x="130" y="109" class="t-w t-c" font-size="10">✓ Schaltfläche</text>
  <rect class="acl" x="186" y="94" width="88" height="22" rx="11"/><text x="230" y="109" class="t-c" font-size="10">Hervorhebung</text>
  <text x="290" y="109" font-size="10" style="fill:var(--accent)">Verknüpfung</text>
  <text x="28" y="128" class="t-m">☑ Benutzer dürfen im Benutzermenü ein eigenes Farbschema wählen</text>
  <rect class="ac" x="540" y="94" width="72" height="22" rx="6"/><text x="576" y="109" class="t-w t-c" font-size="10">Speichern</text>
</svg>
<figcaption>Schema antippen (die Seite zeigt es sofort zur Probe), dann Speichern. Hell/Dunkel bleibt die Wahl jedes Benutzers.</figcaption>
</figure>
{{end}}

{{/* Versionen & Updates */}}
{{define "hb-fig-update"}}
<figure class="hb-fig">
<svg viewBox="0 0 640 120" role="img" aria-label="Ablauf eines Updates">
  <rect class="acl" x="6" y="30" width="112" height="56" rx="8"/><text x="62" y="53" class="t-c t-b">🔍 Prüfen</text><text x="62" y="70" class="t-c t-m">GitHub main</text>
  <rect class="am" x="134" y="30" width="112" height="56" rx="8"/><text x="190" y="53" class="t-c t-b">✨ Neu in 0.x</text><text x="190" y="70" class="t-c t-m">Änderungen lesen</text>
  <rect class="acl" x="262" y="30" width="112" height="56" rx="8"/><text x="318" y="53" class="t-c t-b">⬇ Installieren</text><text x="318" y="70" class="t-c t-m">Update-Agent</text>
  <rect class="bg3" x="390" y="30" width="112" height="56" rx="8"/><text x="446" y="53" class="t-c t-b">🗄 Vollsicherung</text><text x="446" y="70" class="t-c t-m">„Vor Update“</text>
  <rect class="gr" x="518" y="30" width="116" height="56" rx="8"/><text x="576" y="53" class="t-c t-b">✔ Neue Version</text><text x="576" y="70" class="t-c t-m">läuft, Kopfzeile v…</text>
  <path class="ar" d="M118 58 H132"/><path class="ar" d="M246 58 H260"/><path class="ar" d="M374 58 H388"/><path class="ar" d="M502 58 H516"/>
</svg>
<figcaption>Erst lesen, was neu ist, dann installieren. Vor den Datenbank-Änderungen sichert PDH automatisch den bisherigen Stand.</figcaption>
</figure>
{{end}}
