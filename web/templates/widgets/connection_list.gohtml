{{/*
Gemeinsame Teile der Seiten Import und Export: Tabelle der Verbindungen und
das Skript zum Bearbeiten, Aktivieren und Loeschen (vorher in beiden Seiten
kopiert).

  {{template "connection-list" (dict "Direction" "import" "Connections" .Connections "CanWrite" .CanWrite "CanExecute" .CanExecute)}}
  {{template "connection-list-js" (dict "Direction" "import")}}

Die Seite liefert davor im eigenen <script>:
  CONN_BOOL_FIELDS     – Ja/Nein-Felder der Konfiguration (Checkboxen)
  connFormSync()       – Umschalter der Formularteile je Typ (MQTT-Modus, Anmeldung …)
  connPageItems(row)   – eigene Eintraege im Kontextmenue (Sniffer, Vorschau …)
*/}}

{{define "connection-list"}}
{{$th := "text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)"}}{{$td := "padding:6px 10px;border-bottom:1px solid var(--border)"}}
{{$d := .}}
<div class="card">
  <div class="card-title">Bestehende Verbindungen · {{len .Connections}}</div>
  {{if .Connections}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="{{css $th}}">Name</th>
        <th style="{{css $th}}">Typ</th>
        <th style="{{css $th}}">Status</th>
        <th style="{{css $th}}">Angelegt von</th>
        <th style="{{css $th}}">Am</th>
      </tr>
    </thead>
    <tbody>
      {{range .Connections}}
      <tr data-conn-id="{{.ID}}" data-conn-kind="{{.Kind}}" data-conn-name="{{.Name}}" {{if $d.CanWrite}}data-conn-config='{{.ConfigJSON}}'{{end}} data-conn-can-write="{{$d.CanWrite}}"{{if eq $d.Direction "import"}} data-conn-broker-integrated="{{.IsIntegratedBroker}}"{{end}}
          {{if or $d.CanWrite $d.CanExecute}}oncontextmenu="showContextMenu(event, connContextItems(this, '{{$d.Direction}}')); return false;"{{end}}>
        <td style="{{css $td}}"><a href="/{{$d.Direction}}/connections/{{.ID}}" style="color:var(--accent);font-weight:600"><i class="ti ti-chevron-right"></i> {{.Name}}</a></td>
        <td style="{{css $td}}">{{.KindLabel}}</td>
        <td style="{{css $td}}">{{if .Enabled}}<span class="badge" style="background:var(--green)">Aktiv</span>{{else}}<span class="badge" style="background:var(--muted)">Deaktiviert</span>{{end}}</td>
        <td style="{{css $td}}">{{.CreatedBy}}</td>
        <td style="{{css $td}}">{{.CreatedAt}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Verbindungen angelegt</div>
  {{end}}
</div>
{{end}}

{{/* Weg, Abfragezeit über VPN, Schreiben erlaubt und Fingerabdruck – Felder für Typ MSSQL (Import und Export). Dict: Tunnels. */}}
{{define "mssql-route-fields"}}
<div class="grid2" style="gap:10px">
  <div class="form-group">
    <label class="form-label" for="f_mssql_route">Weg</label>
    <select id="f_mssql_route" name="f_mssql_route" class="form-input" onchange="mssqlRouteChanged()">
      <option value="direct">Direkt</option>
      {{range .Tunnels}}<option value="vpn:{{.ID}}">{{.Name}}</option>{{end}}
    </select>
  </div>
</div>
<div id="mssql-vpn-fields" class="grid2" style="gap:10px" hidden>
  <div class="form-group"><label class="form-label">Abfragetakt über VPN (Minuten)</label><input type="number" min="5" max="30" name="f_mssql_vpn_poll_minutes" class="form-input" value="5"></div>
  <div class="form-group"><label class="form-label">Zeitgrenze je Abfrage über VPN (Sekunden)</label><input type="number" min="5" max="600" name="f_mssql_vpn_timeout_seconds" class="form-input" value="60"></div>
</div>
<p id="mssql-vpn-hint" style="font-size:11px;color:var(--muted);margin:-4px 0 10px" hidden>Der Tunnel dient nur zum Testen. Das PDH baut ihn nicht auf; steht er nicht, wird der Lauf übersprungen.</p>
<label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mssql_allow_write"> Schreiben erlaubt</label>
<div class="form-group">
  <label class="form-label">Fingerabdruck des Zertifikats</label>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <input name="f_mssql_tls_fingerprint" id="f_mssql_tls_fingerprint" class="form-input" style="flex:1;min-width:200px;font-family:monospace;font-size:11px" readonly placeholder="nicht bestätigt – Zertifikat wird über die Kette geprüft">
    <button type="button" class="btn btn-small" id="mssql-fp-read" onclick="mssqlReadFingerprint()"><i class="ti ti-fingerprint"></i> Fingerabdruck lesen und bestätigen</button>
    <button type="button" class="btn btn-small" id="mssql-fp-clear" onclick="mssqlClearFingerprint()" hidden>Entfernen</button>
  </div>
  <div id="mssql-fp-confirm" hidden style="margin-top:8px;padding:8px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg2);font-size:12px">
    <div>Der Server zeigt dieses Zertifikat (SHA-256):</div>
    <div id="mssql-fp-value" style="font-family:monospace;font-size:11px;word-break:break-all;margin:4px 0;color:var(--text)"></div>
    <div style="color:var(--muted);margin-bottom:6px">Nur bestätigen, wenn Sie das Zertifikat kennen. Danach verbindet das PDH nur noch mit genau diesem Zertifikat.</div>
    <button type="button" class="btn btn-primary btn-small" onclick="mssqlConfirmFingerprint()">Bestätigen</button>
    <button type="button" class="btn btn-small" onclick="mssqlDiscardFingerprint()">Verwerfen</button>
  </div>
  <div id="mssql-fp-msg" style="font-size:12px;margin-top:6px;color:var(--muted)" role="status"></div>
</div>
{{end}}

{{define "connection-list-js"}}
<script>
// Verbindungen bearbeiten/aktivieren/loeschen (widgets/connection_list.gohtml)
const CONN_DIRECTION = {{.Direction}};
function connFormKindChanged(){
  document.querySelectorAll('.kind-fields').forEach(function(el){ el.hidden = true; });
  const kind = document.getElementById('conn-kind').value;
  const target = document.getElementById('fields-' + kind);
  if(target) target.hidden = false;
}
function opcuaAuthModeChanged(){
  const el = document.getElementById('f_opcua_auth_mode');
  if(!el) return;
  document.getElementById('opcua-auth-username').hidden = el.value !== 'username';
}
function connSync(){
  connFormKindChanged();
  if(typeof connFormSync === 'function') connFormSync(); else opcuaAuthModeChanged();
  mssqlRouteChanged();
  mssqlFpState();
}

// MSSQL: Weg, Abfragezeit über VPN, Fingerabdruck (mssql-route-fields)
function mssqlRouteChanged(){
  const sel = document.getElementById('f_mssql_route');
  if(!sel) return;
  const vpn = sel.value.indexOf('vpn:') === 0;
  document.getElementById('mssql-vpn-fields').hidden = !vpn;
  document.getElementById('mssql-vpn-hint').hidden = !vpn;
}
// gespeicherter Tunnel, der nicht mehr angeboten wird: als eigene Option erhalten,
// damit Speichern den Weg nicht stillschweigend auf „Direkt“ stellt
function mssqlEnsureRoute(route){
  const sel = document.getElementById('f_mssql_route');
  if(!sel) return;
  sel.querySelectorAll('option[data-missing]').forEach(function(o){ o.remove(); });
  if(route && route.indexOf('vpn:') === 0 && !Array.prototype.some.call(sel.options, function(o){ return o.value === route; })){
    const o = document.createElement('option');
    o.value = route; o.textContent = 'Tunnel nicht mehr vorhanden'; o.setAttribute('data-missing', '1');
    sel.appendChild(o);
  }
}
function mssqlFpState(){
  const el = document.getElementById('f_mssql_tls_fingerprint');
  if(!el) return;
  document.getElementById('mssql-fp-clear').hidden = !el.value;
}
let mssqlFpPending = '';
async function mssqlReadFingerprint(){
  const msg = document.getElementById('mssql-fp-msg');
  const q = function(n){ const e = document.querySelector('[name="f_mssql_' + n + '"]'); return e ? e.value : ''; };
  const body = new URLSearchParams({host: q('host'), port: q('port'), instance_name: q('instance_name'), route: q('route')});
  msg.textContent = 'Zertifikat wird gelesen …';
  document.getElementById('mssql-fp-confirm').hidden = true;
  try{
    const res = await fetch('/' + CONN_DIRECTION + '/connections/fingerprint', {method:'POST', credentials:'same-origin', body: body});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const out = await res.json();
    if(out.error){ msg.textContent = out.error; return; }
    mssqlFpPending = out.fingerprint;
    const cur = document.getElementById('f_mssql_tls_fingerprint').value;
    document.getElementById('mssql-fp-value').textContent = out.fingerprint;
    msg.textContent = cur && cur !== out.fingerprint ? 'Achtung: weicht vom bisher bestätigten Fingerabdruck ab.' : '';
    document.getElementById('mssql-fp-confirm').hidden = false;
  }catch(e){
    msg.textContent = 'Zertifikat konnte nicht gelesen werden: ' + e.message;
  }
}
function mssqlConfirmFingerprint(){
  document.getElementById('f_mssql_tls_fingerprint').value = mssqlFpPending;
  document.getElementById('mssql-fp-confirm').hidden = true;
  document.getElementById('mssql-fp-msg').textContent = 'Bestätigt – wird mit „Speichern“ übernommen. Die TLS-Verschlüsselung bleibt dabei aktiv.';
  mssqlFpState();
}
function mssqlDiscardFingerprint(){
  mssqlFpPending = '';
  document.getElementById('mssql-fp-confirm').hidden = true;
  document.getElementById('mssql-fp-msg').textContent = '';
}
function mssqlClearFingerprint(){
  document.getElementById('f_mssql_tls_fingerprint').value = '';
  mssqlFpState();
}

function connSecretHint(on){
  // Kennwörter werden nie zurück in den Browser gegeben: beim Bearbeiten leer lassen = unverändert
  document.querySelectorAll('#conn-form input[type="password"]').forEach(function(el){
    el.placeholder = on ? 'unverändert lassen' : '';
  });
}

function resetConnForm(){
  const form = document.getElementById('conn-form');
  form.reset();
  mssqlEnsureRoute('');
  connSecretHint(false);
  form.action = '/' + CONN_DIRECTION + '/connections';
  document.getElementById('conn-id').value = '';
  document.getElementById('conn-kind').disabled = false;
  document.getElementById('conn-form-title').textContent = 'Neue Verbindung anlegen';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-plus"></i> Verbindung anlegen';
  document.getElementById('conn-cancel').hidden = true;
  connSync();
}

function fillConnField(kind, field, value, isCheckbox){
  const el = document.querySelector('[name="f_' + kind + '_' + field + '"]');
  if(!el) return;
  if(isCheckbox) el.checked = value === 'true';
  else el.value = value || '';
}

function editConnFromRow(row){
  const form = document.getElementById('conn-form');
  const id = row.dataset.connId;
  const kind = row.dataset.connKind;
  let config = {};
  try{ config = JSON.parse(row.dataset.connConfig || '{}'); }catch(e){}

  form.reset();
  connSecretHint(true);
  document.getElementById('conn-kind').value = kind;
  document.getElementById('conn-kind').disabled = true;
  connSync();
  document.getElementById('conn-name').value = row.dataset.connName;
  document.getElementById('conn-id').value = id;

  mssqlEnsureRoute(config.route);
  const booleanFields = typeof CONN_BOOL_FIELDS !== 'undefined' ? CONN_BOOL_FIELDS : [];
  Object.keys(config).forEach(function(field){
    fillConnField(kind, field, config[field], booleanFields.indexOf(field) !== -1);
  });
  connSync();

  form.action = form.action.replace(/\/connections.*/, '/connections/' + id + '/edit-web');
  document.getElementById('conn-form-title').textContent = 'Verbindung bearbeiten';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-device-floppy"></i> Speichern';
  document.getElementById('conn-cancel').hidden = false;
  form.scrollIntoView({behavior:'smooth', block:'start'});
}

async function toggleConnFromRow(row, direction){
  try{
    const res = await fetch('/' + direction + '/connections/' + row.dataset.connId + '/toggle-web', {method:'POST', credentials:'same-origin'});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    location.reload();
  }catch(e){
    alert('Status konnte nicht geändert werden: ' + e.message);
  }
}

function deleteConnFromRow(row, direction){
  if(!confirm('Verbindung "' + row.dataset.connName + '" wirklich löschen?')) return;
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/' + direction + '/connections/' + row.dataset.connId + '/delete-web';
  document.body.appendChild(form);
  form.submit();
}

function connContextItems(row, direction){
  const canWrite = row.dataset.connCanWrite === 'true';
  const items = [{heading: row.dataset.connName}];
  items.push({label: 'Verbindungsseite öffnen', icon: 'ti-layout-dashboard', onClick: function(){
    window.location = '/' + direction + '/connections/' + row.dataset.connId;
  }});
  if(canWrite){
    items.push({label: 'Bearbeiten', icon: 'ti-edit', onClick: function(){ editConnFromRow(row); }});
    items.push({label: 'Aktivieren/Deaktivieren', icon: 'ti-power', onClick: function(){ toggleConnFromRow(row, direction); }});
  }
  if(typeof connPageItems === 'function') connPageItems(row).forEach(function(it){ items.push(it); });
  if(canWrite){
    items.push({separator: true});
    items.push({label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){ deleteConnFromRow(row, direction); }});
  }
  return items;
}

// Aufruf von der Verbindungsseite: /<richtung>?edit=<id> oeffnet das Formular und kehrt danach dorthin zurueck
(function(){
  const id = new URLSearchParams(location.search).get('edit');
  if(!id) return;
  const run = function(){
    const row = document.querySelector('tr[data-conn-id="' + id + '"]');
    if(!row) return;
    editConnFromRow(row);
    const ret = document.getElementById('conn-return'); if(ret) ret.value = 'detail';
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else setTimeout(run, 0);
})();
if(document.getElementById('conn-form')) connSync();
</script>
{{end}}
