{{template "base" .}}
{{define "head"}}
<style>
.orgchart-tree{display:flex;flex-direction:column;align-items:center;padding:24px 10px 10px;min-width:min-content}
.orgchart-tier-connector{width:2px;height:22px;background:var(--border)}
.orgchart-tier-row{display:flex;gap:36px;width:fit-content;margin:0 auto;position:relative}
.orgchart-tier-row.multi{border-top:2px solid var(--border);padding-top:22px}
.orgchart-tier-row:not(.multi){padding-top:22px}
.orgchart-role-node{position:relative;display:flex;flex-direction:column;align-items:center;flex:0 0 auto}
.orgchart-role-node::before{content:'';position:absolute;top:-22px;left:calc(50% - 1px);width:2px;height:22px;background:var(--border)}
.orgchart-role-box{min-width:180px;border:1px solid var(--border);border-top:3px solid var(--accent);border-radius:10px;background:var(--bg2);padding:12px 16px;text-align:center;transition:outline .1s,background .1s;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.orgchart-role-box .orgchart-role-label{font-size:14.5px;font-weight:700;letter-spacing:.2px}
.orgchart-role-box .orgchart-role-meta{font-size:10.5px;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.4px}
.orgchart-role-stem{width:2px;height:22px;background:var(--border)}
.orgchart-user-row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;max-width:280px;padding-top:2px}
.orgchart-card{display:flex;align-items:center;gap:6px;padding:4px 9px 4px 4px;border:1px solid var(--border);border-radius:20px;background:var(--bg3);font-size:11.5px;color:var(--muted);white-space:nowrap}
.orgchart-empty{font-size:11px;color:var(--muted);padding-top:2px;font-style:italic}
.od-tree{display:flex;gap:28px;flex-wrap:wrap;justify-content:center;padding:14px 6px}
.od-node{display:flex;flex-direction:column;align-items:center}
.od-box{min-width:170px;border:1px solid var(--border);border-top:3px solid var(--muted);border-radius:10px;background:var(--bg2);padding:10px 14px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.od-box.global{border-top-color:var(--accent)}
.od-name{font-weight:700;font-size:14px}
.od-meta{font-size:11px;color:var(--muted);margin-top:3px}
.od-kids{display:flex;gap:18px;flex-wrap:wrap;justify-content:center;border-top:2px solid var(--border);padding-top:14px;margin-top:0}
.od-stem{width:2px;height:14px;background:var(--border)}
@media(max-width:900px){.orgchart-tree{align-items:flex-start}.orgchart-tier-row{width:auto;flex-wrap:wrap;justify-content:flex-start;margin:0}.orgchart-tier-row.multi{border-top:none;padding-top:0}.orgchart-role-node::before{display:none}.orgchart-tier-connector{display:none}}
</style>
{{end}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Organigramm</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Rollen-Hierarchie mit zugeordneten Benutzern · Karte auf eine andere Rolle ziehen, um sie umzustufen</p>
</div>

<p id="orgchart-error" style="display:none;color:var(--red);font-size:12px;margin-bottom:10px"></p>

<div class="card" style="overflow-x:auto">
  <div class="orgchart-tree">
    {{range $ti, $tier := .Tiers}}
    {{if gt $ti 0}}<div class="orgchart-tier-connector"></div>{{end}}
    <div class="orgchart-tier-row{{if gt (len $tier.Roles) 1}} multi{{end}}">
      {{range $tier.Roles}}
      <div class="orgchart-role-node">
        <div class="orgchart-role-box" data-role-key="{{.Key}}" data-can-assign="{{.CanAssign}}"
             style="{{if not .CanAssign}}opacity:.55{{end}};cursor:pointer" title="Klicken, um die Berechtigungen dieser Rolle zu bearbeiten"
             onclick="location.href='/admin/roles'" oncontextmenu="showContextMenu(event, roleBoxContextItems('{{.Label}}')); return false;"
             ondragover="orgchartDragOver(event, this)" ondragleave="orgchartDragLeave(event, this)" ondrop="orgchartDrop(event, this)">
          <div class="orgchart-role-label">{{.Label}}</div>
          <div class="orgchart-role-meta" title="Rangstufe in der Hierarchie">Rang {{.Level}} · {{len .Users}} Benutzer</div>
          {{if .Dept}}<div style="margin-top:4px"><span class="badge b-gray" title="Abteilung der Rolle"><i class="ti ti-building"></i> {{.Dept}}</span></div>{{end}}
        </div>
        {{if .Users}}
        <div class="orgchart-role-stem"></div>
        <div class="orgchart-user-row">
          {{range .Users}}
          <div class="orgchart-card" {{if .CanManage}}draggable="true" ondragstart="orgchartDragStart(event,'{{.ID}}')" ondragend="orgchartDragEnd(event)"{{end}}
               style="cursor:pointer" onclick="location.href='/users?edit={{.ID}}'"
               oncontextmenu="showContextMenu(event, userCardContextItems('{{.ID}}','{{.FullName}}')); return false;"
               title="{{.FullName}} · klicken zum Bearbeiten{{if .CanManage}} · ziehen, um die Rolle zu ändern{{end}}">
            <div style="width:22px;height:22px;border-radius:50%;background:{{.AvatarBg}};display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:#fff;flex-shrink:0;overflow:hidden">{{if .AvatarURL}}<img src="{{.AvatarURL}}" alt="" style="width:100%;height:100%;border-radius:50%;object-fit:cover">{{else}}{{.Initials}}{{end}}</div>
            <span style="max-width:130px;overflow:hidden;text-overflow:ellipsis">{{.FullName}}</span>
            {{if $.CanManageRoles}}<a href="/users?permissions={{.ID}}" title="Einzelrechte bearbeiten" style="color:var(--muted);display:flex;margin-left:2px" onclick="event.stopPropagation()"><i class="ti ti-shield-lock" style="font-size:13px"></i></a>{{end}}
          </div>
          {{end}}
        </div>
        {{else}}
        <div class="orgchart-role-stem"></div>
        <div class="orgchart-empty">Keine Benutzer</div>
        {{end}}
      </div>
      {{end}}
    </div>
    {{end}}
  </div>
</div>

<div class="card" style="overflow-x:auto;margin-top:14px">
  <div class="card-title"><span><i class="ti ti-building"></i> Abteilungen</span><a href="/admin/org-units" style="font-size:12px;color:var(--accent)">bearbeiten</a></div>
  <p class="rec-sub">Die Abteilung einer Anlage bestimmt, wer ihre Vorgänge sieht: Rollen einer Abteilung sehen ihre Vorgänge und die der Unterabteilungen. <span class="badge b-blue">übergeordnet</span> = sieht alle Abteilungen.</p>
  {{if .Departments}}<div class="od-tree">{{range .Departments}}{{template "orgchart-dept" .}}{{end}}</div>
  {{else}}<p class="rec-sub" style="padding:10px 0">Noch keine Abteilungen.</p>{{end}}
</div>
{{end}}

{{define "scripts"}}
<script>
const PDH_CAN_MANAGE_ROLES = {{if .CanManageRoles}}true{{else}}false{{end}};

function roleBoxContextItems(roleLabel){
  return [
    {heading: roleLabel},
    {label: 'Berechtigungen bearbeiten', icon: 'ti-shield-lock', onClick: function(){ location.href = '/admin/roles'; }},
    {label: 'Rang ändern', icon: 'ti-arrows-sort', onClick: function(){ location.href = '/admin/roles'; }}
  ];
}

function userCardContextItems(userID, fullName){
  const items = [
    {heading: fullName},
    {label: 'Bearbeiten', icon: 'ti-edit', onClick: function(){ location.href = '/users?edit=' + userID; }}
  ];
  if(PDH_CAN_MANAGE_ROLES){
    items.push({label: 'Einzelrechte', icon: 'ti-shield-lock', onClick: function(){ location.href = '/users?permissions=' + userID; }});
  }
  return items;
}

let orgchartDraggedUserID = null;

function orgchartDragStart(event, userID){
  orgchartDraggedUserID = userID;
  event.dataTransfer.effectAllowed = 'move';
  event.currentTarget.style.opacity = '.4';
}
function orgchartDragEnd(event){
  event.currentTarget.style.opacity = '';
  orgchartDraggedUserID = null;
}
function orgchartDragOver(event, box){
  if(box.dataset.canAssign !== 'true' || !orgchartDraggedUserID) return;
  event.preventDefault();
  box.style.outline = '2px solid var(--accent)';
  box.style.background = 'var(--bg3)';
}
function orgchartDragLeave(event, box){
  box.style.outline = '';
  box.style.background = '';
}
async function orgchartDrop(event, box){
  event.preventDefault();
  box.style.outline = '';
  box.style.background = '';
  const roleKey = box.dataset.roleKey;
  const userID = orgchartDraggedUserID;
  if(!userID || box.dataset.canAssign !== 'true') return;
  const errorBox = document.getElementById('orgchart-error');
  errorBox.style.display = 'none';
  try{
    const response = await fetch('/users/' + userID + '/role-web', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'role=' + encodeURIComponent(roleKey)
    });
    if(!response.ok) throw new Error((await response.text()) || ('HTTP ' + response.status));
    location.reload();
  }catch(error){
    errorBox.textContent = 'Zuweisung fehlgeschlagen: ' + error.message;
    errorBox.style.display = 'block';
  }
}
</script>
{{end}}


{{define "orgchart-dept"}}
<div class="od-node">
  <div class="od-box{{if .IsGlobal}} global{{end}}">
    <div class="od-name">{{.Name}}</div>
    {{if .IsGlobal}}<div style="margin-top:3px"><span class="badge b-blue">übergeordnet</span></div>{{end}}
    <div class="od-meta">{{if .ManagerName}}Leitung: {{.ManagerName}} · {{end}}{{.MemberCount}} Mitarbeitende</div>
    {{if .Roles}}<div class="od-meta"><i class="ti ti-shield-lock"></i> {{join .Roles ", "}}</div>{{end}}
  </div>
  {{if .Children}}
  <div class="od-stem"></div>
  <div class="od-kids">{{range .Children}}{{template "orgchart-dept" .}}{{end}}</div>
  {{end}}
</div>
{{end}}
