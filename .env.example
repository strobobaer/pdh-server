# PDH – Umgebungsvariablen
# Kopieren: cp .env.example .env
# Dann .env mit echten Werten befüllen – ODER einfach ohne .env starten:
# Beim ersten Start öffnet sich im Browser der Einrichtungsassistent
# (/setup), der die Datenbank abfragt bzw. automatisch anlegt, den ersten
# Administrator anlegt und die Werte hier speichert. Alles Weitere unter
# Verwaltung → Server-Einstellungen.

# ── Server ──────────────────────────────────────
PDH_SERVER_HOST=0.0.0.0
PDH_SERVER_PORT=8090
PDH_SERVER_ENV=development

# ── Datenbank ────────────────────────────────────
PDH_DATABASE_HOST=localhost
PDH_DATABASE_PORT=5432
PDH_DATABASE_USER=pdh
PDH_DATABASE_PASSWORD=SicheresPasswort!
PDH_DATABASE_NAME=pdh
PDH_DATABASE_SSLMODE=disable

# ── Auth ─────────────────────────────────────────
# JWT Secret: mind. 32 Zeichen, zufällig!
# Generieren: openssl rand -hex 32
PDH_AUTH_JWTSECRET=AENDERN-min32zeichen-openssl-rand-hex-32
PDH_AUTH_TOKENDURATION=24

# ── Copilot ──────────────────────────────────────
# Backend: "ollama" (lokal) oder "anthropic" (cloud)
PDH_COPILOT_BACKEND=ollama
PDH_COPILOT_OLLAMAURL=http://localhost:11434
PDH_COPILOT_MODEL=llama3.2
# Nur nötig wenn backend=anthropic:
PDH_COPILOT_ANTHROPICKEY=

# ── E-Mail (täglicher Bestellvorschlag) ──────────
# TLS: starttls (Port 587), tls (Port 465) oder none
PDH_SMTP_HOST=
PDH_SMTP_PORT=587
PDH_SMTP_USER=
PDH_SMTP_PASSWORD=
PDH_SMTP_FROM=pdh@example.com
PDH_SMTP_TLS=starttls
# Öffentliche Adresse des PDH für Links in E-Mails
PDH_PUBLIC_URL=https://pdh.example.com

# ── Portal-/Shop-Zugangsdaten ────────────────────
# Schlüssel für die Verschlüsselung gespeicherter Passwörter.
# Leer = aus PDH_AUTH_JWTSECRET abgeleitet. Nach dem ersten Speichern
# NICHT mehr ändern (sonst sind gespeicherte Passwörter unlesbar).
PDH_CREDENTIALS_KEY=

# ── Datensicherung ───────────────────────────────
# Ordner für Sicherungen (Verwaltung → Datensicherung). In Docker: Volume pdh_backups.
# Tipp: Sicherungen zusätzlich extern aufbewahren (herunterladen oder Ordner mitsichern).
PDH_BACKUP_DIR=backups
