{{template "base" .}}

{{define "content"}}
{{/* Wartung v2 (maintenance_web.go): Anstehend · Jahresplan · Pläne · Erledigt · Checklisten.
     Durchgeführt wird immer im Abschluss-Assistenten: pdhComplete('maintenance', id). */}}
<div class="mt-head">
  <div>
    <h1>Wartung</h1>
    <p>{{if eq .View "due"}}{{.OpenCount}} anstehend{{if .LaterCount}} · {{.LaterCount}} später geplant{{end}}{{else if eq .View "year"}}Jahresplan {{.Year}}{{else if eq .View "plans"}}{{len .Plans}} Pläne{{else if eq .View "rounds"}}{{len .Plans}} Kontrollrundgänge{{else if eq .View "done"}}zuletzt erledigt{{else}}Checklisten-Vorlagen{{end}}</p>
  </div>
  <div class="widget-icon-toolbar compact">
    <button type="button" class="btn" onclick="pdhCreate('maintenance')"><i class="ti ti-plus"></i> Einzelauftrag</button>
    {{if eq .View "rounds"}}<a class="btn btn-primary" href="/maintenance/plans/new?round=1"><i class="ti ti-route"></i> Neuer Rundgang</a>
    {{else}}<a class="btn btn-primary" href="/maintenance/plans/new"><i class="ti ti-calendar-plus"></i> Neuer Plan</a>{{end}}
  </div>
</div>

<nav class="rec-tabs mt-tabs" aria-label="Ansicht">
  <a class="rec-tab {{if eq .View "due"}}active{{end}}" href="/maintenance"><i class="ti ti-player-play"></i> Anstehend</a>
  <a class="rec-tab {{if eq .View "year"}}active{{end}}" href="/maintenance?view=year"><i class="ti ti-calendar-month"></i> Jahresplan</a>
  <a class="rec-tab {{if eq .View "plans"}}active{{end}}" href="/maintenance?view=plans"><i class="ti ti-repeat"></i> Pläne</a>
  <a class="rec-tab {{if eq .View "rounds"}}active{{end}}" href="/maintenance?view=rounds"><i class="ti ti-route"></i> Rundgänge</a>
  <a class="rec-tab {{if eq .View "done"}}active{{end}}" href="/maintenance?view=done"><i class="ti ti-circle-check"></i> Erledigt</a>
  <a class="rec-tab {{if eq .View "checklists"}}active{{end}}" href="/maintenance?view=checklists"><i class="ti ti-list-check"></i> Checklisten</a>
</nav>

{{if eq .View "due"}}
<form class="mt-filter" method="get" action="/maintenance">
  <label class="mt-chip {{if .Mine}}on{{end}}"><input type="checkbox" name="mine" value="1" {{if .Mine}}checked{{end}} onchange="this.form.submit()"> Nur meine</label>
  <select name="infra" class="form-input" onchange="this.form.submit()" aria-label="Anlage">
    <option value="">Alle Anlagen</option>
    {{range .InfraOptions}}<option value="{{.ID}}" {{if eq .ID $.InfraFilter}}selected{{end}}>{{.Name}}</option>{{end}}
  </select>
</form>
{{range .Groups}}
<section class="mt-group mt-{{.Key}}">
  <h2><i class="ti {{.Icon}}"></i> {{.Label}} <span>{{len .Cards}}</span></h2>
  <div class="mt-cards">
    {{range .Cards}}
    <article class="mt-card {{if .Overdue}}overdue{{end}}">
      <a class="mt-card-main" href="/maintenance/tasks/{{.ID}}">
        <div class="mt-card-title"><span class="act-dot {{.PriorityDot}}"></span>{{.Title}}</div>
        <div class="mt-card-sub"><i class="ti ti-building-factory-2"></i> {{.InfraName}}</div>
        <div class="mt-card-meta">
          <span class="{{if .Overdue}}mt-red{{end}}"><i class="ti ti-calendar"></i> {{.Due}}</span>
          {{if .Who}}<span><i class="ti ti-user"></i> {{.Who}}</span>{{end}}
          {{if .Points}}<span title="Checklistenpunkte"><i class="ti ti-list-check"></i> {{if gt .Lists 1}}{{.Lists}} Listen · {{end}}{{.Filled}}/{{.Points}}</span>{{end}}
          {{if ne .Status "open"}}<span class="badge {{.StatusClass}}">{{.StatusLabel}}</span>{{end}}
        </div>
      </a>
      <button type="button" class="btn cw-finish mt-go" onclick="pdhComplete('maintenance','{{.ID}}')"><i class="ti ti-player-play"></i> Durchführen</button>
    </article>
    {{end}}
  </div>
</section>
{{else}}
<div class="mt-empty"><i class="ti ti-mood-happy"></i><div>Keine Wartung anstehend.</div>{{if .LaterCount}}<a href="/maintenance?view=year">{{.LaterCount}} später geplante im Jahresplan</a>{{end}}</div>
{{end}}
{{end}}

{{if eq .View "year"}}
<div class="mt-yearnav">
  <a class="btn" href="/maintenance?view=year&year={{.PrevYear}}"><i class="ti ti-chevron-left"></i> {{.PrevYear}}</a>
  <b>{{.Year}}</b>
  <a class="btn" href="/maintenance?view=year&year={{.NextYear}}">{{.NextYear}} <i class="ti ti-chevron-right"></i></a>
  <span class="mt-legend"><i class="mk done"></i> erledigt <i class="mk open"></i> offen <i class="mk overdue"></i> überfällig <i class="mk planned"></i> geplant <i class="mk skipped"></i> übersprungen</span>
</div>
{{if .YearRows}}
<div class="mt-year-wrap">
<table class="mt-year">
  <thead><tr><th>Plan</th>{{range .Months}}<th>{{.}}</th>{{end}}</tr></thead>
  <tbody>
  {{range .YearRows}}
  <tr>
    <th><a href="/maintenance/plans/{{.PlanID}}">{{.Name}}</a><small>{{.InfraName}} · {{.IntervalLabel}}</small></th>
    {{range .Months}}<td>{{range .}}{{if .TaskID}}<a class="mk {{.Kind}}" href="/maintenance/tasks/{{.TaskID}}" title="{{.Date}}"></a>{{else}}<i class="mk {{.Kind}}" title="{{.Date}} (geplant)"></i>{{end}}{{end}}</td>{{end}}
  </tr>
  {{end}}
  </tbody>
</table>
</div>
{{else}}<div class="mt-empty"><i class="ti ti-calendar-off"></i><div>Noch keine Wartungspläne.</div><a href="/maintenance/plans/new">Ersten Plan anlegen</a></div>{{end}}
{{end}}

{{if eq .View "plans"}}
<div class="mt-filter">
  <a class="mt-chip {{if .ShowInactive}}on{{end}}" href="/maintenance?view=plans{{if not .ShowInactive}}&inactive=1{{end}}"><i class="ti ti-eye"></i> Ruhende Pläne zeigen</a>
  <button type="button" class="btn" hx-post="/maintenance/generate" hx-target="#generate-result" title="Normalerweise unnötig – PDH legt Aufträge selbst an"><i class="ti ti-refresh"></i> Fehlende Aufträge anlegen</button>
  <span id="generate-result"></span>
</div>
{{if .Plans}}
<div class="mt-plans">
  {{range .Plans}}
  <a class="mt-plan {{if not .Plan.Active}}inactive{{end}}" href="/maintenance/plans/{{.Plan.ID}}">
    <div class="mt-plan-head"><b>{{.Plan.Name}}</b>{{if .Plan.IsRound}}<span class="badge b-blue"><i class="ti ti-route"></i> Rundgang</span>{{end}}{{if not .Plan.Active}}<span class="badge b-gray">ruht</span>{{end}}</div>
    <div class="mt-card-sub"><i class="ti ti-building-factory-2"></i> {{.Plan.InfraName}}</div>
    <div class="mt-card-meta">
      <span><i class="ti ti-repeat"></i> {{.IntervalLabel}} · {{.ModeLabel}}</span>
      <span class="{{if .Overdue}}mt-red{{end}}"><i class="ti ti-calendar"></i> nächste {{.NextDue}}</span>
      {{if .Plan.AssigneeName}}<span><i class="ti ti-user"></i> {{.Plan.AssigneeName}}</span>{{else if .Plan.GroupName}}<span><i class="ti ti-users"></i> {{.Plan.GroupName}}</span>{{end}}
    </div>
    {{if .Checklists}}<div class="mt-plan-lists"><i class="ti ti-list-check"></i> {{.Checklists}}</div>{{else}}<div class="mt-plan-lists mt-muted">ohne Checkliste</div>{{end}}
  </a>
  {{end}}
</div>
{{else}}<div class="mt-empty"><i class="ti ti-repeat-off"></i><div>Noch keine Wartungspläne.</div><a href="/maintenance/plans/new">Ersten Plan anlegen</a></div>{{end}}
{{end}}

{{if eq .View "rounds"}}
<p class="mt-intro"><i class="ti ti-route"></i> Ein Kontrollrundgang führt nacheinander über mehrere Anlagen (Stationen) – je Station eine kurze Checkliste, mit Foto und „Mangel melden“. Termine, Leitstand und Protokoll laufen wie bei jedem Wartungsplan.</p>
<div class="mt-filter">
  <a class="mt-chip {{if .ShowInactive}}on{{end}}" href="/maintenance?view=rounds{{if not .ShowInactive}}&inactive=1{{end}}"><i class="ti ti-eye"></i> Ruhende zeigen</a>
</div>
{{if .Plans}}
<div class="mt-plans">
  {{range .Plans}}
  <article class="mt-plan mt-round {{if not .Plan.Active}}inactive{{end}}">
    <a class="mt-round-main" href="/maintenance/plans/{{.Plan.ID}}">
      <div class="mt-plan-head"><b>{{.Plan.Name}}</b>{{if not .Plan.Active}}<span class="badge b-gray">ruht</span>{{end}}</div>
      <div class="mt-card-sub"><i class="ti ti-building-factory-2"></i> {{.Plan.InfraName}}</div>
      <div class="mt-card-meta">
        <span><i class="ti ti-repeat"></i> {{.IntervalLabel}}</span>
        <span class="{{if .Overdue}}mt-red{{end}}"><i class="ti ti-calendar"></i> nächster {{.NextDue}}</span>
        {{if .Plan.AssigneeName}}<span><i class="ti ti-user"></i> {{.Plan.AssigneeName}}</span>{{else if .Plan.GroupName}}<span><i class="ti ti-users"></i> {{.Plan.GroupName}}</span>{{end}}
      </div>
      <ol class="mt-stations">{{range .Stations}}<li>{{.}}</li>{{end}}</ol>
    </a>
    {{if .Plan.OpenTaskID}}
    <div class="mt-round-go">
      {{if .Total}}<span class="mt-round-prog" title="erfasste Punkte"><i style="width:{{.Percent}}%"></i></span><span class="mt-muted">{{.Filled}}/{{.Total}}</span>{{end}}
      <button type="button" class="btn cw-finish mt-go" onclick="pdhComplete('maintenance','{{.Plan.OpenTaskID}}')"><i class="ti ti-player-play"></i> {{if .Filled}}Rundgang fortsetzen{{else}}Rundgang starten{{end}}</button>
    </div>
    {{end}}
  </article>
  {{end}}
</div>
{{else}}<div class="mt-empty"><i class="ti ti-route"></i><div>Noch keine Kontrollrundgänge.</div><a href="/maintenance/plans/new?round=1">Ersten Rundgang anlegen</a></div>{{end}}
{{end}}

{{if eq .View "done"}}
{{if .Done}}
<div class="card" style="padding:0">
  {{range .Done}}
  <div class="mt-done">
    <a href="/maintenance/tasks/{{.Task.ID}}" class="mt-done-main">
      <b>{{.Task.Title}}</b>
      <small>{{.Task.InfraName}} · {{if eq .Task.Status "skipped"}}übersprungen{{else}}erledigt{{end}} {{.Completed}}{{if .Duration}} · {{.Duration}}{{end}}</small>
    </a>
    <div class="mt-done-flags">
      {{if .OutOfRange}}<span class="badge b-red" title="Messwerte außerhalb von Min/Max"><i class="ti ti-alert-triangle"></i> {{.OutOfRange}} außerhalb</span>{{end}}
      {{if .Unchecked}}<span class="badge b-amber" title="nicht abgehakte Punkte">{{.Unchecked}} offen</span>{{end}}
      {{if .Points}}<span class="badge b-gray">{{.Points}} Punkte</span>{{end}}
      {{if .ProtocolURL}}<a class="btn" href="{{.ProtocolURL}}" target="_blank" rel="noopener" title="Wartungsprotokoll (PDF)"><i class="ti ti-file-type-pdf"></i></a>{{end}}
    </div>
  </div>
  {{end}}
</div>
{{else}}<div class="mt-empty"><i class="ti ti-history"></i><div>Noch nichts erledigt.</div></div>{{end}}
{{end}}

{{if eq .View "checklists"}}
<div class="mt-filter">
  <form onsubmit="return mtNewList(this)" class="mt-newlist">
    <input name="name" class="form-input" placeholder="Neue Checkliste, z. B. „Presse – monatlich“" required maxlength="120">
    <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Anlegen</button>
  </form>
</div>
<p class="mt-hint">Checklisten sind Vorlagen. Im Wartungsplan legst du fest, welche Checkliste wie oft drankommt (z. B. „bei jedem Termin“, „14-tägig“, „monatlich“) – fällige Listen werden bei der Durchführung zusammengeführt.</p>
<div id="mt-lists">Lädt…</div>
{{end}}
{{end}}

{{define "context-list"}}{{end}}

{{block "scripts" .}}
<style>
.mt-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.mt-head h1{font-size:19px;font-weight:600}
.mt-head p{font-size:12px;color:var(--muted);margin-top:3px}
.mt-tabs{margin-bottom:14px;overflow-x:auto}
.mt-filter{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.mt-filter .form-input{max-width:260px}
.mt-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:999px;padding:6px 12px;font-size:12.5px;cursor:pointer;color:var(--text);text-decoration:none;background:var(--bg2)}
.mt-chip.on{border-color:var(--accent);background:rgba(var(--accent-rgb),.12)}
.mt-chip input{display:none}
.mt-group{margin-bottom:18px}
.mt-group h2{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:8px;display:flex;gap:6px;align-items:center}
.mt-group h2 span{background:var(--bg3);border-radius:999px;padding:0 8px;font-size:11px}
.mt-overdue h2{color:var(--red)}
.mt-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}
.mt-card{border:1px solid var(--border);border-radius:12px;background:var(--bg2);display:flex;flex-direction:column}
.mt-card.overdue{border-color:rgba(239,68,68,.55)}
.mt-card-main{padding:12px 14px;color:var(--text);text-decoration:none;flex:1}
.mt-card-title{font-weight:600;font-size:14px;display:flex;gap:8px;align-items:center}
.mt-card-sub{font-size:12px;color:var(--muted);margin-top:3px}
.mt-card-meta{display:flex;flex-wrap:wrap;gap:6px 12px;font-size:12px;color:var(--muted);margin-top:8px;align-items:center}
.mt-red{color:var(--red);font-weight:600}
.mt-muted{color:var(--muted)}
.mt-go{margin:0 12px 12px;justify-content:center;min-height:42px}
.mt-empty{text-align:center;color:var(--muted);padding:40px 10px;display:grid;gap:8px;justify-items:center}
.mt-empty i{font-size:34px;opacity:.5}
.mt-empty a{color:var(--accent)}
.mt-yearnav{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.mt-legend{margin-left:auto;font-size:11.5px;color:var(--muted);display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.mt-year-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:var(--bg2)}
.mt-year{border-collapse:collapse;width:100%;min-width:760px;font-size:12px}
.mt-year th,.mt-year td{border-bottom:1px solid var(--border);padding:6px 4px;text-align:center;vertical-align:middle}
.mt-year thead th{font-size:11px;color:var(--muted);font-weight:600;background:var(--bg3)}
.mt-year tbody th{text-align:left;padding-left:12px;min-width:200px;font-weight:500}
.mt-year tbody th a{color:var(--text);text-decoration:none;font-weight:600}
.mt-year tbody th small{display:block;color:var(--muted);font-weight:400}
.mk{display:inline-block;width:12px;height:12px;border-radius:50%;margin:1px;vertical-align:middle;border:2px solid transparent}
.mk.done{background:var(--green)}
.mk.open{background:var(--accent)}
.mk.overdue{background:var(--red)}
.mk.planned{border-color:var(--accent);background:transparent}
.mk.skipped{background:var(--bg3);border-color:var(--border)}
.mt-plans{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px}
.mt-plan{border:1px solid var(--border);border-radius:12px;background:var(--bg2);padding:12px 14px;color:var(--text);text-decoration:none}
.mt-plan:hover,.mt-card-main:hover{background:var(--bg3)}
.mt-plan.inactive{opacity:.6}
.mt-intro{font-size:12.5px;color:var(--muted);margin:0 0 10px;display:flex;gap:6px;align-items:flex-start}
.mt-round{display:flex;flex-direction:column;gap:10px}
.mt-round-main{color:var(--text);text-decoration:none;display:block}
.mt-stations{margin:8px 0 0;padding-left:20px;font-size:12.5px;columns:2;column-gap:18px}
.mt-stations li{break-inside:avoid;padding:1px 0}
.mt-round-go{display:flex;align-items:center;gap:8px;border-top:1px solid var(--border);padding-top:10px}
.mt-round-go .mt-go{margin-left:auto}
.mt-round-prog{flex:0 0 90px;height:6px;border-radius:3px;background:var(--bg3);overflow:hidden}
.mt-round-prog i{display:block;height:100%;background:var(--green)}
.mt-plan-head{display:flex;gap:8px;align-items:center;justify-content:space-between;font-size:14px}
.mt-plan-lists{font-size:12px;margin-top:8px;color:var(--text)}
.mt-done{display:flex;gap:10px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--border)}
.mt-done:last-child{border-bottom:0}
.mt-done-main{flex:1;min-width:0;color:var(--text);text-decoration:none}
.mt-done-main small{display:block;color:var(--muted);font-size:12px}
.mt-done-flags{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.mt-hint{font-size:12px;color:var(--muted);margin:-4px 0 12px}
.mt-newlist{display:flex;gap:8px;flex:1}
.mt-newlist .form-input{max-width:420px}
.mt-list{border:1px solid var(--border);border-radius:12px;background:var(--bg2);margin-bottom:12px}
.mt-list-head{display:flex;gap:8px;align-items:center;padding:10px 12px;border-bottom:1px solid var(--border)}
.mt-list-head input{flex:1;font-weight:600}
.mt-item{display:grid;grid-template-columns:24px 1fr auto;gap:8px;align-items:start;padding:8px 12px;border-bottom:1px solid var(--border)}
.mt-item:last-child{border-bottom:0}
.mt-item .grip{color:var(--muted);display:flex;flex-direction:column;gap:2px}
.mt-item .grip button{border:0;background:none;color:var(--muted);cursor:pointer;padding:0;line-height:1}
.mt-item-sub{font-size:11.5px;color:var(--muted)}
.mt-item-imgs{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;align-items:center}
.mt-item-imgs img{width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid var(--border)}
.mt-item-edit{display:grid;grid-template-columns:1fr 140px 90px;gap:6px;margin-top:6px}
.mt-item-edit .wide{grid-column:1/-1}
.mt-add{padding:10px 12px;display:grid;grid-template-columns:1fr 150px auto;gap:6px}
@media(max-width:700px){.mt-cards,.mt-plans{grid-template-columns:1fr}.mt-item-edit,.mt-add{grid-template-columns:1fr}}
</style>
{{if eq .View "checklists"}}
<script>
// Checklisten-Vorlagen (API /api/v1/maintenance/checklists)
const MT_API = '/api/v1/maintenance';
const mtEsc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const MT_TYPES = {checkbox: 'Abhaken', number: 'Messwert', text: 'Freitext'};
async function mtJSON(url, opts){
  const res = await fetch(url, Object.assign({credentials:'same-origin'}, opts || {}));
  const json = await res.json().catch(() => ({}));
  if(!res.ok || json.success === false) throw new Error(json.error || ('HTTP ' + res.status));
  return json.data !== undefined ? json.data : json;
}
const mtSend = (url, method, body) => mtJSON(url, {method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body || {})});
const num = v => { v = String(v || '').trim().replace(',', '.'); return v === '' ? null : Number(v); };
const fmt = v => v === null || v === undefined ? '' : String(v).replace('.', ',');
function mtSpec(i){
  if(i.item_type !== 'number') return '';
  const u = i.unit ? ' ' + i.unit : '', p = [];
  if(i.target_value != null) p.push('Soll ' + fmt(i.target_value) + u);
  if(i.min_value != null) p.push('Min ' + fmt(i.min_value) + u);
  if(i.max_value != null) p.push('Max ' + fmt(i.max_value) + u);
  return p.length ? ' · ' + p.join(' · ') : (i.unit ? ' · ' + i.unit : '');
}
function mtItemHTML(t, i, k, n){
  const imgs = (i.images || []).map(im => '<a href="' + mtEsc(im.url) + '" target="_blank" rel="noopener"><img src="' + mtEsc(im.url) + '" alt=""></a>').join('');
  return '<div class="mt-item" data-item="' + mtEsc(i.id) + '">'
    + '<div class="grip"><button type="button" title="nach oben" ' + (k === 0 ? 'disabled' : '') + ' onclick="mtMove(\'' + t.id + '\',' + k + ',-1)"><i class="ti ti-chevron-up"></i></button><button type="button" title="nach unten" ' + (k === n - 1 ? 'disabled' : '') + ' onclick="mtMove(\'' + t.id + '\',' + k + ',1)"><i class="ti ti-chevron-down"></i></button></div>'
    + '<div><div>' + (i.required ? '<span style="color:var(--red)" title="Pflichtpunkt">✱</span> ' : '') + mtEsc(i.label) + '</div>'
    + '<div class="mt-item-sub">' + MT_TYPES[i.item_type] + mtEsc(mtSpec(i)) + (i.description ? ' · ' + mtEsc(i.description) : '') + '</div>'
    + '<div class="mt-item-imgs">' + imgs + '<label class="btn" style="font-size:11px;padding:3px 8px;cursor:pointer" title="Bild zur Darstellung (z. B. wo der Messpunkt sitzt)"><i class="ti ti-photo-plus"></i><input type="file" accept="image/*" multiple hidden onchange="mtUpload(\'' + i.id + '\',this)"></label></div>'
    + '<div class="mt-item-edit" hidden>'
    + '<input class="form-input wide" data-f="label" value="' + mtEsc(i.label) + '">'
    + '<select class="form-input" data-f="item_type">' + Object.keys(MT_TYPES).map(k => '<option value="' + k + '"' + (k === i.item_type ? ' selected' : '') + '>' + MT_TYPES[k] + '</option>').join('') + '</select>'
    + '<input class="form-input" data-f="unit" placeholder="Einheit" value="' + mtEsc(i.unit) + '">'
    + '<label style="display:flex;gap:6px;align-items:center;font-size:12px"><input type="checkbox" data-f="required"' + (i.required ? ' checked' : '') + '> Pflicht</label>'
    + '<input class="form-input" data-f="target_value" placeholder="Soll" value="' + fmt(i.target_value) + '">'
    + '<input class="form-input" data-f="min_value" placeholder="Min" value="' + fmt(i.min_value) + '">'
    + '<input class="form-input" data-f="max_value" placeholder="Max" value="' + fmt(i.max_value) + '">'
    + '<input class="form-input wide" data-f="description" placeholder="Hinweis (optional)" value="' + mtEsc(i.description) + '">'
    + '<div class="wide" style="display:flex;gap:6px;justify-content:flex-end"><button type="button" class="btn" onclick="this.closest(\'.mt-item-edit\').hidden=true">Abbrechen</button><button type="button" class="btn btn-primary" onclick="mtSaveItem(\'' + t.id + '\',\'' + i.id + '\',this)">Speichern</button></div>'
    + '</div></div>'
    + '<div style="display:flex;gap:4px"><button type="button" class="btn" title="Bearbeiten" onclick="this.closest(\'.mt-item\').querySelector(\'.mt-item-edit\').hidden=false"><i class="ti ti-edit"></i></button><button type="button" class="btn btn-danger" title="Entfernen" onclick="mtDelItem(\'' + t.id + '\',\'' + i.id + '\')"><i class="ti ti-trash"></i></button></div>'
    + '</div>';
}
function mtListHTML(t){
  const items = t.items || [];
  return '<div class="mt-list" id="list-' + t.id + '">'
    + '<div class="mt-list-head"><i class="ti ti-list-check" style="color:var(--accent)"></i><input class="form-input" value="' + mtEsc(t.name) + '" onchange="mtRename(\'' + t.id + '\',this.value)" aria-label="Name">'
    + '<span class="badge b-gray" title="in aktiven Plänen">' + (t.plan_count || 0) + ' Pläne</span>'
    + '<button type="button" class="btn btn-danger" title="Checkliste löschen" onclick="mtDelList(\'' + t.id + '\',' + (t.plan_count || 0) + ')"><i class="ti ti-trash"></i></button></div>'
    + (items.length ? items.map((i, k) => mtItemHTML(t, i, k, items.length)).join('') : '<div class="mt-item-sub" style="padding:10px 12px">Noch keine Punkte.</div>')
    + '<form class="mt-add" onsubmit="return mtAddItem(\'' + t.id + '\',this)"><input name="label" class="form-input" placeholder="Neuer Punkt, z. B. „Ölstand prüfen“" required>'
    + '<select name="item_type" class="form-input">' + Object.keys(MT_TYPES).map(k => '<option value="' + k + '">' + MT_TYPES[k] + '</option>').join('') + '</select>'
    + '<button type="submit" class="btn"><i class="ti ti-plus"></i> Punkt</button></form></div>';
}
let mtCache = {};
async function mtLoad(){
  const box = document.getElementById('mt-lists');
  try{
    const lists = await mtJSON(MT_API + '/checklists');
    if(!lists.length){ box.innerHTML = '<div class="mt-empty"><i class="ti ti-list-check"></i><div>Noch keine Checklisten.</div></div>'; return; }
    const full = await Promise.all(lists.map(l => mtJSON(MT_API + '/checklists/' + l.id).then(t => Object.assign(t, {plan_count: l.plan_count}))));
    mtCache = {}; full.forEach(t => mtCache[t.id] = t);
    box.innerHTML = full.map(mtListHTML).join('');
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">' + mtEsc(e.message) + '</span>'; }
}
function mtRedraw(t){ t.plan_count = (mtCache[t.id] || {}).plan_count; mtCache[t.id] = t; const el = document.getElementById('list-' + t.id); if(el) el.outerHTML = mtListHTML(t); }
async function mtNewList(f){
  try{ await mtSend(MT_API + '/checklists', 'POST', {name: f.name.value}); f.reset(); mtLoad(); }catch(e){ alert(e.message); }
  return false;
}
async function mtRename(id, name){ try{ mtRedraw(await mtSend(MT_API + '/checklists/' + id, 'PUT', {name})); }catch(e){ alert(e.message); } }
async function mtDelList(id, plans){
  if(!confirm(plans ? 'Diese Checkliste hängt an ' + plans + ' Plan/Plänen und wird dort entfernt. Löschen?' : 'Checkliste löschen?')) return;
  try{ await mtJSON(MT_API + '/checklists/' + id, {method:'DELETE'}); mtLoad(); }catch(e){ alert(e.message); }
}
async function mtAddItem(id, f){
  try{ mtRedraw(await mtSend(MT_API + '/checklists/' + id + '/items', 'POST', {label: f.label.value, item_type: f.item_type.value, required: true})); }catch(e){ alert(e.message); }
  return false;
}
async function mtSaveItem(tid, iid, btn){
  const box = btn.closest('.mt-item-edit'), v = f => box.querySelector('[data-f="' + f + '"]');
  const body = {label: v('label').value, item_type: v('item_type').value, unit: v('unit').value, required: v('required').checked, description: v('description').value,
    target_value: num(v('target_value').value), min_value: num(v('min_value').value), max_value: num(v('max_value').value)};
  try{ await mtSend(MT_API + '/checklist-items/' + iid, 'PUT', body); mtRedraw(await mtJSON(MT_API + '/checklists/' + tid)); }catch(e){ alert(e.message); }
}
async function mtDelItem(tid, iid){
  if(!confirm('Punkt entfernen? Bereits erfasste Ergebnisse bleiben erhalten.')) return;
  try{ await mtJSON(MT_API + '/checklist-items/' + iid, {method:'DELETE'}); mtRedraw(await mtJSON(MT_API + '/checklists/' + tid)); }catch(e){ alert(e.message); }
}
async function mtMove(tid, k, d){
  const ids = (mtCache[tid].items || []).map(i => i.id);
  const j = k + d; if(j < 0 || j >= ids.length) return;
  [ids[k], ids[j]] = [ids[j], ids[k]];
  try{ mtRedraw(await mtSend(MT_API + '/checklists/' + tid + '/order', 'POST', {ids})); }catch(e){ alert(e.message); }
}
async function mtUpload(iid, input){
  if(!input.files || !input.files.length) return;
  const fd = new FormData(); [...input.files].forEach(f => fd.append('files', f));
  try{
    await mtJSON('/api/v1/attachments/maint_check_item/' + encodeURIComponent(iid), {method:'POST', body: fd});
    const tid = Object.keys(mtCache).find(k => (mtCache[k].items || []).some(i => i.id === iid));
    if(tid) mtRedraw(await mtJSON(MT_API + '/checklists/' + tid));
  }catch(e){ alert('Bild konnte nicht gespeichert werden: ' + e.message); }
}
mtLoad();
</script>
{{end}}
{{end}}
