{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Projektplanung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Total}} Projekte</p>
  </div>
  <button type="button" class="btn btn-primary" onclick="document.getElementById('new-project-form').style.display='block'"><i class="ti ti-plus"></i> Neues Projekt</button>
</div>

<div id="new-project-form" style="display:none" class="card">
  <div class="card-title">Projekt erstellen</div>
  <form onsubmit="return submitProjectForm(this)">
    <div class="grid2">
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Name</label><input name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Start</label><input name="start_date" type="date" class="form-input"></div>
      <div class="form-group"><label class="form-label">Ende</label><input name="end_date" type="date" class="form-input"></div>
      <div class="form-group"><label class="form-label">Verantwortlich</label>
        <select name="responsible_to" class="form-input">
          <option value="">Nicht gesetzt</option>
          {{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Beschreibung</label>
      <input name="description" class="form-input" placeholder="Kurzbeschreibung">
    </div>
    <div id="project-create-result" style="font-size:12px;margin-bottom:8px"></div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button type="button" class="btn" onclick="document.getElementById('new-project-form').style.display='none'">Abbrechen</button>
      <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Erstellen</button>
    </div>
  </form>
</div>

<div class="grid2">
{{range .Projects}}
<div class="card" style="cursor:pointer" onclick="window.location='/projects/{{.ID}}'">
  <div class="card-title">
    {{.Name}}
    <span class="badge {{.StatusClass}}">{{.StatusLabel}}</span>
  </div>
  <p style="font-size:12px;color:var(--muted);margin-bottom:8px">{{.Description}}</p>
  <div style="font-size:11px;color:var(--muted)">
    {{if .StartDate}}{{.StartDate}} – {{.EndDate}}{{end}} · {{.TaskCount}} Aufgaben
  </div>
</div>
{{else}}
<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--muted)">
  <i class="ti ti-timeline" style="font-size:40px;display:block;margin-bottom:12px"></i>
  Noch keine Projekte vorhanden
</div>
{{end}}
</div>
{{end}}

{{define "context-list"}}
{{range .Projects}}
<div class="act-item">
  <div class="act-text">{{.Name}}</div>
  <span class="badge {{.StatusClass}}" style="font-size:9px">{{.StatusLabel}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
async function submitProjectForm(form){
  const fd=new FormData(form);
  const payload={name:fd.get('name'),description:fd.get('description'),start_date:fd.get('start_date'),end_date:fd.get('end_date')};
  if(fd.get('responsible_to')) payload.responsible_to=fd.get('responsible_to');
  const result=document.getElementById('project-create-result'); result.textContent='Speichere...';
  try{
    const res=await fetch('/api/v1/projects/',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+pdhToken()},body:JSON.stringify(payload)});
    const json=await res.json(); if(!res.ok||!json.success) throw new Error(json.error||'Fehler');
    window.location.href='/projects';
  }catch(e){result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>'}
  return false;
}
</script>
{{end}}


