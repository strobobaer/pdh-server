{{template "base" .}}

{{define "content"}}
{{/* Wartungsauftrag (maintenance_web.go MaintenanceTaskDetail). „Wartung durchführen“ öffnet den
     Abschluss-Assistenten: Checkliste → Material → Zeit → wer war dabei → Kommentar → Fertig. */}}
<div class="md-head">
  {{template "icon-button" (dict "Action" "back" "Href" "/maintenance")}}
  <div style="flex:1;min-width:0">
    <h1>{{.Task.Title}}</h1>
    <p>{{.Task.TypeLabel}} · fällig <span class="{{if .Task.Overdue}}md-red{{end}}">{{.Task.DueDate}}</span>{{if .Task.InfraName}} · {{.Task.InfraName}}{{end}}</p>
  </div>
  <span class="badge {{.Task.PriorityClass}}">{{.Task.Priority}}</span>
  <span class="badge {{.Task.StatusClass}}">{{.Task.StatusLabel}}</span>
  <div class="widget-icon-toolbar compact">
    {{template "icon-button" (dict "Action" "edit" "OnClick" "mdToggleEdit()")}}
    <form method="POST" action="/maintenance/tasks/{{.Task.ID}}/delete-web" onsubmit="return confirm('Auftrag löschen?')" style="display:inline">
      {{template "icon-button" (dict "Action" "delete" "Type" "submit" "Label" "Löschen")}}
    </form>
  </div>
</div>
{{template "record-meta-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Historie</a>
</div>

<div class="rec-pane" data-pane="overview">
<div id="md-edit" class="card" style="display:none">
  <div class="card-title">Auftrag bearbeiten</div>
  <form hx-post="/maintenance/tasks/{{.Task.ID}}/edit-web" hx-target="#md-edit-result" hx-swap="innerHTML">
    <div class="grid2">
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Titel</label><input name="title" class="form-input" value="{{.Task.Title}}" required></div>
      <div class="form-group"><label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low" {{if eq .Task.Priority "low"}}selected{{end}}>niedrig</option>
          <option value="medium" {{if eq .Task.Priority "medium"}}selected{{end}}>mittel</option>
          <option value="high" {{if eq .Task.Priority "high"}}selected{{end}}>hoch</option>
          <option value="critical" {{if eq .Task.Priority "critical"}}selected{{end}}>kritisch</option>
        </select></div>
      <div class="form-group"><label class="form-label">Fällig am</label><input name="due_date" type="date" class="form-input" value="{{.Task.DueDateISO}}"></div>
      {{template "infra-tree-picker" (dict "TargetID" "md-infra" "SelectedLabelID" "md-infra-label" "Label" "Anlage" "Value" .Task.InfraID "SelectedLabel" .Task.InfraName)}}
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><textarea name="description" class="form-input" rows="3">{{.Task.Description}}</textarea></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Bemerkung</label><textarea name="notes" class="form-input" rows="2">{{.Task.Notes}}</textarea></div>
    </div>
    <div id="md-edit-result" style="margin-bottom:8px"></div>
    <div style="display:flex;gap:8px;justify-content:flex-end"><button type="button" class="btn" onclick="mdToggleEdit()">Abbrechen</button><button type="submit" class="btn btn-primary">Speichern</button></div>
  </form>
</div>

<div class="md-grid">
  <div>
    {{if .Task.IsOpen}}
    <div class="card md-do">
      <div class="md-do-text">
        <b>Wartung durchführen</b>
        <span>{{if .StepCount}}{{.FilledCount}} von {{.StepCount}} Checklistenpunkten erfasst · {{end}}Checkliste → Material → Zeit → wer war dabei → Kommentar → Fertig</span>
        {{if .StepCount}}<div class="md-bar"><i style="width:{{.Progress}}%"></i></div>{{end}}
      </div>
      <button type="button" class="btn cw-finish md-do-btn" onclick="pdhComplete('maintenance','{{.Task.ID}}')"><i class="ti ti-player-play"></i> {{if .FilledCount}}Weiter durchführen{{else}}Wartung durchführen{{end}}</button>
    </div>
    {{else}}
    <div class="card md-done">
      <div class="md-done-head"><i class="ti ti-{{if eq .Task.Status "skipped"}}player-skip-forward{{else}}circle-check{{end}}"></i>
        <div><b>{{if eq .Task.Status "skipped"}}Übersprungen{{else}}Erledigt {{.Task.CompletedAt}}{{end}}</b>
        <span>{{if .Task.DurationStr}}Dauer {{.Task.DurationStr}}{{end}}{{if .NextTaskID}}{{if .Task.DurationStr}} · {{end}}nächster Termin <a href="/maintenance/tasks/{{.NextTaskID}}">{{.NextTaskDue}}</a>{{end}}</span></div>
        {{if .ProtocolURL}}<a class="btn" href="{{.ProtocolURL}}" target="_blank" rel="noopener"><i class="ti ti-file-type-pdf"></i> Protokoll</a>{{end}}
      </div>
      {{if .Task.Notes}}<p class="md-notes">{{.Task.Notes}}</p>{{end}}
      {{if .Actions}}<div class="md-sub">Maßnahmen</div>{{range .Actions}}<div class="md-line"><span>{{.Description}}</span><small>{{.CreatedByName}} · {{.CreatedAt.Format "02.01. 15:04"}}</small></div>{{end}}{{end}}
      {{if .PartsUsed}}<div class="md-sub">Verwendetes Material</div>{{range .PartsUsed}}<div class="md-line"><span>{{.PartName}} <small>{{.PartNumber}}</small></span><b>{{.Qty}}</b></div>{{end}}{{end}}
    </div>
    {{end}}

    <div class="card">
      <div class="card-title"><i class="ti ti-list-check"></i> Checkliste
        {{if .StepCount}}<span class="badge b-gray" style="margin-left:auto">{{.FilledCount}}/{{.StepCount}}</span>{{end}}</div>
      {{range .StepGroups}}
      <div class="md-group">{{if .Name}}<div class="md-group-name">{{.Name}}</div>{{end}}
        {{range .Steps}}
        <div class="md-step">
          <i class="ti ti-{{if .Filled}}circle-check md-ok{{else if .Required}}circle-dashed md-req{{else}}circle-dashed md-muted{{end}}"></i>
          <div class="md-step-text">
            <div>{{if .Required}}<span class="md-red" title="Pflichtpunkt">✱</span> {{end}}{{.Label}}</div>
            {{if .CheckedBy}}<small>{{.CheckedBy}}{{if .CheckedAt}} · {{.CheckedAt.Format "02.01. 15:04"}}{{end}}</small>{{end}}
            {{if .DocImages}}<div class="md-imgs">{{range .DocImages}}<a href="{{.URL}}" target="_blank" rel="noopener"><img src="{{.URL}}" alt="{{.Filename}}" loading="lazy"></a>{{end}}</div>{{end}}
          </div>
          <div class="md-step-val">
            {{if eq .ItemType "checkbox"}}{{if .Done}}erledigt{{else}}–{{end}}
            {{else if .Value}}<b>{{.Value}}</b>{{if .Unit}} {{.Unit}}{{end}}{{with .InRange}}{{if .}} <i class="ti ti-circle-check md-ok" title="im Bereich"></i>{{else}} <i class="ti ti-alert-triangle md-red" title="außerhalb von Min/Max"></i>{{end}}{{end}}
            {{else}}–{{end}}
          </div>
        </div>
        {{end}}
      </div>
      {{else}}
      <p class="md-muted" style="font-size:12.5px">Keine Checkliste an diesem Auftrag.</p>
      {{end}}
      {{if and .Task.IsOpen .Templates}}
      <div class="md-addlist">
        <select id="md-add-tpl" class="form-input" aria-label="Checkliste ergänzen">{{range .Templates}}<option value="{{.ID}}">{{.Name}} ({{.ItemCount}} Punkte)</option>{{end}}</select>
        <button type="button" class="btn" onclick="mdAddList()"><i class="ti ti-plus"></i> Checkliste ergänzen</button>
      </div>
      {{end}}
    </div>

    {{if .Task.Description}}
    <div class="card"><div class="card-title"><i class="ti ti-file-description"></i> Beschreibung</div><p class="md-notes">{{.Task.Description}}</p></div>
    {{end}}

    {{if and .Task.IsOpen .Pending}}
    <div class="card"><div class="card-title"><i class="ti ti-package"></i> Reserviertes Material</div>
      {{range .Pending}}<div class="md-line"><span>{{.PartName}} <small>{{.PartNumber}} · {{.StorageName}}</small></span><b>{{.Qty}}</b></div>{{end}}
    </div>
    {{end}}

    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos &amp; Dokumente</div>
      <div id="attachments-{{.Task.ID}}" data-attach-ref="maintenance_task:{{.Task.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label class="md-upload"><i class="ti ti-photo"></i>Galerie<input type="file" accept="image/*" multiple hidden onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
        <label class="md-upload"><i class="ti ti-camera"></i>Kamera<input type="file" accept="image/*" capture="environment" hidden onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-title">Details</div>
      {{if .Task.RecordImageURL}}<img src="{{.Task.RecordImageURL}}" alt="Datensatzbild" class="md-recimg">{{end}}
      {{if .Task.InfraName}}<div class="li"><div class="li-text"><div class="li-sub">Anlage</div><div class="li-title"><a href="/infrastructure/{{.Task.InfraID}}">{{.Task.InfraName}}</a></div></div></div>{{end}}
      {{if .Task.PlanID}}<div class="li"><div class="li-text"><div class="li-sub">Wartungsplan</div><div class="li-title"><a href="/maintenance/plans/{{.Task.PlanID}}">{{.Task.PlanName}}</a>{{if .Task.PlanInterval}} <small class="md-muted">· {{.Task.PlanInterval}}</small>{{end}}</div></div></div>
      {{else}}<div class="li"><div class="li-text"><div class="li-sub">Wartungsplan</div><div class="li-title md-muted">Einzelauftrag</div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Fällig am</div><div class="li-title {{if .Task.Overdue}}md-red{{end}}">{{.Task.DueDate}}</div></div></div>
      {{if .Task.StartedAt}}<div class="li"><div class="li-text"><div class="li-sub">Begonnen</div><div class="li-title">{{.Task.StartedAt}}</div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Angelegt</div><div class="li-title md-muted" style="font-size:12px">{{.Task.CreatedAt}}</div></div></div>
      <form hx-post="/records/maintenance_task/{{.Task.ID}}/people" hx-target="#md-people-result" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div class="form-group"><label class="form-label">Zugewiesen</label>
          <select name="assigned_to" class="form-input"><option value="">Nicht zugewiesen</option>{{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
        <div class="form-group"><label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input"><option value="">Nicht gesetzt</option>{{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
        <div class="form-group"><label class="form-label">Zugewiesene Gruppe</label>
          <select name="assigned_group_id" class="form-input" hx-get="/records/maintenance_task/{{.Task.ID}}/group-options" hx-trigger="load" hx-swap="innerHTML"><option value="__keep__">Lädt…</option></select></div>
        <div id="md-people-result" style="font-size:12px;margin-bottom:8px"></div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
    </div>
    <div class="card"><div class="card-title">Beteiligte</div>
      <div hx-get="/records/maintenance_task/{{.Task.ID}}/parties" hx-trigger="load" hx-swap="innerHTML"></div></div>
  </div>
</div>
</div>

<div class="rec-pane" data-pane="fields"><div class="card">{{template "record-fields-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div></div>
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div>
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:6px">Auftrag</div>
<div class="act-item"><div class="act-dot {{.Task.PriorityDot}}"></div><div class="act-text">{{.Task.Title}}</div><span class="badge {{.Task.StatusClass}}" style="font-size:9px">{{.Task.StatusLabel}}</span></div>
{{end}}

{{block "scripts" .}}
<style>
.md-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.md-head h1{font-size:18px;font-weight:600}
.md-head p{font-size:12px;color:var(--muted);margin-top:2px}
.md-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:start}
.md-red{color:var(--red);font-weight:600}
.md-ok{color:var(--green)}
.md-req{color:var(--amber)}
.md-muted{color:var(--muted)}
.md-do{display:flex;gap:14px;align-items:center;border-color:rgba(16,185,129,.4)}
.md-do-text{flex:1;display:grid;gap:4px}
.md-do-text b{font-size:15px}
.md-do-text span{font-size:12px;color:var(--muted)}
.md-do-btn{min-height:48px;font-size:15px;padding:0 20px;justify-content:center}
.md-bar{height:6px;border-radius:999px;background:var(--bg3);overflow:hidden;border:1px solid var(--border)}
.md-bar i{display:block;height:100%;background:var(--green)}
.md-done{border-color:rgba(16,185,129,.3)}
.md-done-head{display:flex;gap:10px;align-items:center}
.md-done-head > i{font-size:22px;color:var(--green)}
.md-done-head > div{flex:1;display:grid;gap:2px}
.md-done-head span{font-size:12px;color:var(--muted)}
.md-done-head a{color:var(--accent)}
.md-notes{font-size:13px;color:var(--muted);line-height:1.6;white-space:pre-wrap;margin-top:8px}
.md-sub{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin:12px 0 4px}
.md-line{display:flex;gap:8px;justify-content:space-between;align-items:center;font-size:13px;padding:6px 0;border-bottom:1px solid var(--border)}
.md-line:last-child{border-bottom:0}
.md-line small{color:var(--muted);font-size:11.5px}
.md-group{margin-bottom:8px}
.md-group-name{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--accent);margin:8px 0 2px}
.md-step{display:grid;grid-template-columns:20px minmax(0,1fr) auto;gap:8px;align-items:start;padding:7px 0;border-bottom:1px solid var(--border);font-size:13px}
.md-step:last-child{border-bottom:0}
.md-step small{color:var(--muted);font-size:11.5px}
.md-step-val{text-align:right;color:var(--muted)}
.md-step-val b{color:var(--text)}
.md-imgs{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.md-imgs img{width:56px;height:56px;object-fit:cover;border-radius:6px;border:1px solid var(--border)}
.md-addlist{display:flex;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border)}
.md-addlist .form-input{max-width:340px}
.md-upload{cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)}
.md-recimg{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px;border:1px solid var(--border);margin-bottom:12px}
@media(max-width:900px){.md-grid{grid-template-columns:1fr}.md-do{flex-direction:column;align-items:stretch}}
</style>
<script>
function mdToggleEdit(){ const f = document.getElementById('md-edit'); f.style.display = f.style.display === 'none' ? 'block' : 'none'; }
async function mdAddList(){
  const id = document.getElementById('md-add-tpl').value; if(!id) return;
  try{
    const res = await fetch('/api/v1/maintenance/tasks/{{.Task.ID}}/checklists', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body: JSON.stringify({template_id: id})});
    const json = await res.json().catch(() => ({}));
    if(!res.ok || json.success === false) throw new Error(json.error || ('HTTP ' + res.status));
    location.reload();
  }catch(e){ alert(e.message); }
}
</script>
{{end}}
