DATA_BLOCK "Daten"
TITLE = Prozessdaten Linie 1 (Werte für PDH)
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : Strobl
FAMILY : Linie1
VERSION : 0.1
//Datenbaustein mit allen unterstützten Typen
   VAR RETAIN
      Zaehler { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Real;   // Stückzähler
   END_VAR
   VAR
      Takt : Int := 5;   // Taktzeit in s
      Motor { S7_SetPoint := 'False'} : Struct
         Drehzahl : Real;   (* Umdrehungen
                               pro Minute *)
         Ein : Bool;
      END_STRUCT;
      Feld : Array[1..10] of Int;
      Text : String[20] := 'abc';
      Name : String;
      Zeit : DTL;
      Wort : Word := 16#00FF;
      Doppelwort : DWord;
      Ganz : DInt := -7;
      Vorzeichenlos : UInt;
      Gross : UDInt;
      Genau : LReal := 1.5E+3;
      Zeitstempel : Date_And_Time;
   END_VAR


BEGIN
   Feld[1] := 3;
   Motor.Drehzahl := 1450.0;

END_DATA_BLOCK

