{{/* Rüsten an der Anlage (setup_easy.go): Rüsttasten, laufendes Rüsten mit „Fertig“
     und der Hinweis „Störung durch Rüsten“. Gleicher Baustein im Easy-Modus
     (easy.gohtml) und auf der Anlagenseite für Angemeldete (asset_info.gohtml).
     Dot = setupBarView. Ohne Rüsttaste und ohne laufendes Rüsten erscheint nichts.
     Farben nur über die Variablen der Seite; die Fiori-Regeln stehen unten. */}}
{{define "setup-bar"}}{{if .Show}}
<style>
.rz{margin:0 0 22px}
.rz-h{font-size:13px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
.rz-note{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:10px 12px;font-size:14px;margin-bottom:10px;color:var(--text)}
.rz-run{background:var(--bg2);border:1px solid var(--border);border-left:5px solid var(--amber);border-radius:12px;padding:12px;margin-bottom:12px;color:var(--text)}
.rz-run.fault{border-left-color:var(--red)}
.rz-run b{display:block;font-size:16px;font-weight:700}
.rz-over{display:inline-block;margin-top:4px;font-size:13px;font-weight:700;color:var(--amber)}
.rz-fin{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.rz-in{flex:1;min-width:140px;font-size:16px;padding:12px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:inherit}
.rz-btns{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.rz-btn{border:1px solid var(--border);border-radius:12px;padding:16px 10px;min-height:56px;font-size:16px;font-weight:600;background:var(--bg2);color:var(--text);cursor:pointer;font-family:inherit;touch-action:manipulation}
.rz-btn:active{transform:scale(.98)}
.rz-btn.cur{border-color:var(--amber);box-shadow:inset 0 0 0 1px var(--amber)}
.rz-btn.go{background:var(--accent);border-color:var(--accent);color:var(--on-accent,#fff)}
html[data-style="fiori"] .rz-run,html[data-style="fiori"] .rz-note,html[data-style="fiori"] .rz-btn{border-color:transparent;border-radius:8px;box-shadow:0 0 2px rgba(34,53,72,.2),0 2px 4px rgba(34,53,72,.2)}
html[data-style="fiori"] .rz-run{border-left:5px solid var(--amber)}
html[data-style="fiori"] .rz-run.fault{border-left-color:var(--red)}
html[data-style="fiori"] .rz-btn.cur{border-color:var(--amber)}
html[data-style="fiori"] .rz-btn.go{background:var(--accent);color:var(--on-accent,#fff)}
html[data-style="fiori"] .rz-h{text-transform:none;letter-spacing:0;font-size:15px;color:var(--text)}
html[data-style="fiori"] .rz-in{border-radius:4px;border-color:var(--muted)}
</style>
<section class="rz" aria-label="{{t "Rüsten"}}">
  <h2 class="rz-h">{{t "Rüsten"}}</h2>
  {{if .Notice}}<div class="rz-note" role="alert">{{.Notice}}</div>{{end}}
  {{if .Running}}
  <div class="rz-run">
    <b>{{.Text}}</b>
    {{if .Overrun}}<span class="rz-over"><i class="ti ti-alert-triangle"></i> {{t "Höchstdauer überschritten"}}</span>{{end}}
    <form class="rz-fin" method="post" action="{{.Action}}/finish">
      {{if .Back}}<input type="hidden" name="back" value="{{.Back}}">{{end}}{{if .Test}}<input type="hidden" name="test" value="1">{{end}}
      <input class="rz-in" type="text" name="note" maxlength="1000" placeholder="{{t "Notiz (freiwillig)"}}" aria-label="{{t "Notiz (freiwillig)"}}">
      <button type="submit" class="rz-btn go"><i class="ti ti-check"></i> {{t "Fertig"}}</button>
    </form>
  </div>
  {{else if .Fault}}
  <div class="rz-run fault"><b><i class="ti ti-alert-triangle"></i> {{.Text}}</b></div>
  {{end}}
  {{if .Buttons}}
  <form class="rz-btns" method="post" action="{{.Action}}/start">
    {{if .Back}}<input type="hidden" name="back" value="{{.Back}}">{{end}}{{if .Test}}<input type="hidden" name="test" value="1">{{end}}
    {{range .Buttons}}<button type="submit" class="rz-btn{{if .Current}} cur{{end}}" name="button_id" value="{{.ID}}"{{if .Current}} aria-current="true"{{end}}>{{.Name}}</button>
    {{end}}
  </form>
  {{end}}
</section>
{{end}}{{end}}
