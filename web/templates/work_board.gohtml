{{template "base" .}}

{{define "content"}}
{{/* Arbeitsbereich (work_board.go) fuer Tickets, Stoerungen und Aufgaben – wie der KVP:
     Dashboard · Vorgaenge (Chips) · Board · Regeln. Bausteine in widgets/work_board.gohtml.
     Bearbeitet und abgeschlossen wird im Abschluss-Assistenten: pdhComplete(art, id). */}}
{{$a := .Area}}{{$k := $a.Kind}}
<div class="mt-head">
  <div>
    <h1><i class="ti {{$k.Icon}}"></i> {{$k.Title}}{{if $a.ProjectName}} · {{$a.ProjectName}}{{end}}</h1>
    <p>{{$a.OpenCount}} offen{{if $a.OverdueCount}} · <span class="mt-red">{{$a.OverdueCount}} überfällig</span>{{end}}{{if $a.UnassignedCount}} · {{$a.UnassignedCount}} ohne Zuweisung{{end}}</p>
  </div>
  <div class="widget-icon-toolbar compact">
    <button type="button" class="btn btn-primary" onclick="pdhCreate('{{$k.Key}}')"><i class="ti ti-plus"></i> {{if eq $k.Key "fault"}}Störung melden{{else}}Neu{{end}}</button>
  </div>
</div>
{{template "wa-nav" $a}}
{{template "wa-pane" $a}}
{{end}}

{{define "context-list"}}
{{range .Area.Dash.Attention}}
<div class="act-item"><div class="act-dot d-red"></div><div class="act-text">{{.Title}}</div></div>
{{end}}
{{end}}

{{define "scripts"}}
{{template "kvp-style"}}
{{template "work-style"}}
{{end}}
