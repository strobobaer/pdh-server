{{template "base" .}}
{{define "content"}}
<style>
.ih-comment-form{margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.ih-comment-row,.ih-filter-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px}
.ih-comment-row select{flex:1;min-width:180px;width:auto}
.ih-check{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);cursor:pointer;user-select:none}
.ih-mod{padding:5px 9px;border:1px solid var(--border);border-radius:999px;background:var(--bg3)}
.ih-mod:has(input:checked){color:var(--text);border-color:var(--accent)}
.ih-date{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
.ih-date input{width:auto}
.ih-filter{margin-bottom:12px}
.ih-chips{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 12px}
.ih-chip{font-size:11px;color:var(--muted);padding:3px 8px;border-radius:999px;background:var(--bg3);opacity:.55}
.ih-chip.on{opacity:1}
.ih-chip b{color:var(--text);margin-left:2px}
.ih-section{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:10px 0 6px}
.ih-pinned{margin-bottom:12px}
.ih-entry{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:12px}
.ih-entry:last-child{border-bottom:0}
.ih-icon{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:13px}
.ih-body{flex:1;min-width:0}
.ih-head{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.ih-title{font-weight:500;color:var(--text);text-decoration:none;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
.ih-title:hover{color:var(--accent)}
.ih-text{margin-top:4px;white-space:pre-wrap;word-break:break-word;color:var(--text);opacity:.85;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.ih-comment .ih-text{-webkit-line-clamp:unset;display:block}
.ih-comment.pinned{background:rgba(var(--accent-rgb),.06);border-radius:8px;padding:9px 8px}
.ih-actions{display:flex;gap:2px;flex-shrink:0;align-items:flex-start}
.ih-act{width:30px;height:30px;border:0;background:none;color:var(--muted);border-radius:6px;cursor:pointer}
.ih-act:hover{background:var(--bg3);color:var(--text)}
.ih-parts th,.ih-parts td{padding:6px 8px;font-size:12px}
.ob-row .ob-ic{font-size:18px;color:var(--green)}.ob-overdue .ob-ic{color:var(--red)}.ob-soon .ob-ic{color:var(--amber)}.ob-none .ob-ic{color:var(--muted)}
.ob-sub,.ob-new{flex-basis:100%;border-top:1px dashed var(--border);padding-top:10px;margin-top:4px}
.ob-form .cols{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
</style>
{{$n := .Node}}
<div class="rec-head">
  {{template "icon-button" (dict "Action" "back" "Href" (or (and .Parent (printf "/infrastructure/%s" .Parent.ID)) "/infrastructure"))}}
  <div class="rec-img" style="display:flex;align-items:center;justify-content:center;font-size:24px;background:{{css $n.TypeBg}}" title="{{$n.TypeLabel}}"><i class="ti {{$n.TypeIcon}}"></i></div>
  <div class="t">
    <h1>{{$n.Name}}</h1>
    <div class="sub">
      <a href="/infrastructure" style="color:var(--accent)">Infrastruktur</a>{{if .Parent}} › <a href="/infrastructure/{{.Parent.ID}}" style="color:var(--accent)">{{.Parent.Name}}</a>{{end}}
      · {{$n.TypeLabel}}{{if $n.Location}} · {{$n.Location}}{{end}}
    </div>
  </div>
  <a class="btn btn-small" href="/a/{{$n.ID}}" title="Infoseite mit offenen Vorgängen – Ziel des QR-Codes"><i class="ti ti-qrcode"></i> QR &amp; Vorgänge</a>
  {{if .CanManageRoles}}<a class="btn btn-small" href="/e/{{$n.ID}}?test=1" target="_blank" rel="noopener" title="Öffnet die Meldeseite, die Nicht-Angemeldete nach dem QR-Scan sehen (Testmeldungen beginnen mit „TEST:“)"><i class="ti ti-hand-finger"></i> Easy-Mode testen</a>{{end}}
  <a class="btn btn-small" href="/a/labels?infra={{$n.ID}}" target="_blank" rel="noopener" title="QR-Etikett drucken"><i class="ti ti-printer"></i></a>
  <div style="position:relative" oncontextmenu="toggleMenu('infra-menu'); return false;">
    {{template "icon-button" (dict "Action" "more" "OnClick" "toggleMenu('infra-menu')")}}
    <div id="infra-menu" class="win11-menu" style="display:none;position:absolute;right:0;top:36px;min-width:160px;z-index:100">
      <a class="btn btn-small" href="/a/labels?infra={{$n.ID}}&amp;sub=1" target="_blank" rel="noopener" style="width:100%;justify-content:flex-start;margin-bottom:4px"><i class="ti ti-qrcode"></i> QR-Etiketten inkl. Unteranlagen</a>
      {{if $.CanEditInfra}}{{template "icon-button" (dict "Action" "new" "ShowLabel" true "Label" "Unteranlage hinzufügen" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "OnClick" "openAddChild();closeMenu('infra-menu')")}}{{end}}
      {{template "icon-button" (dict "Action" "delete" "ShowLabel" true "Label" "Zum Löschen vormerken" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "HxPost" (printf "/records/state/infrastructure/%s" $n.ID) "HxVals" "{\"action\":\"mark\"}" "HxTarget" (printf "#rmeta-%s" $n.ID) "HxConfirm" "Element zum Löschen vormerken? Es wird sofort deaktiviert; der Bereinigungslauf löscht es oder blendet es aus, falls es noch verwendet wird." "OnClick" "closeMenu('infra-menu')")}}
    </div>
  </div>
</div>

{{if .Message}}<div class="rec-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="rec-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

{{template "record-meta-slot" (dict "Module" "infrastructure" "ID" $n.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  {{if .CanEditInfra}}<a class="rec-tab" data-tab="master" href="?tab=master"><i class="ti ti-edit"></i> Stammdaten</a>{{end}}
  <a class="rec-tab" data-tab="checks" href="?tab=checks"><i class="ti ti-clipboard-check"></i> Prüfungen &amp; GBU{{if .ObligationDue}} <b style="background:var(--amber);color:#000">{{.ObligationDue}}</b>{{else if .Obligations}} <b>{{len .Obligations}}</b>{{end}}</a>
  <a class="rec-tab" data-tab="easy" href="?tab=easy"><i class="ti ti-hand-finger"></i> Meldetexte{{if .EasyTextCount}} <b>{{.EasyTextCount}}</b>{{end}}</a>
  <a class="rec-tab" data-tab="events" href="?tab=events"><i class="ti ti-timeline"></i> Anlagen-Historie</a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="docs" href="?tab=docs"><i class="ti ti-paperclip"></i> Dokumente</a>
  {{if or .HMI.View .HMI.Manage}}<a class="rec-tab" data-tab="hmi" href="?tab=hmi"><i class="ti ti-device-desktop-analytics"></i> HMI</a>{{end}}
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Änderungen</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">
  {{if .CanEditInfra}}
  <!-- Unteranlage anlegen: danach öffnet sich die neue Anlage im Reiter „Stammdaten“ -->
  <div id="add-child" style="display:none" class="card">
    <div class="card-title"><span><i class="ti ti-plus"></i> Unteranlage hinzufügen</span></div>
    <form class="rec-form" method="post" action="/infrastructure">
      <input type="hidden" name="parent_id" value="{{$n.ID}}">
      <input type="hidden" name="from" value="detail">
      <div class="cols">
        <div class="form-group"><label class="form-label">Name *</label><input name="name" class="form-input" required maxlength="255"></div>
        <div class="form-group"><label class="form-label">Typ *</label>
          <select name="type" class="form-input">{{range .Types}}<option value="{{.Key}}" {{if eq .Key "device"}}selected{{end}}>{{.Label}}</option>{{end}}</select></div>
        <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input" maxlength="255" value="{{$n.Location}}"></div>
      </div>
      <p class="rec-sub" style="margin:2px 0 10px"><i class="ti ti-info-circle"></i> Alle weiteren Angaben ergänzt du direkt danach im Reiter „Stammdaten“ der neuen Unteranlage.</p>
      <div style="display:flex;justify-content:flex-end;gap:8px">
        <button type="button" class="btn" onclick="document.getElementById('add-child').style.display='none'">Abbrechen</button>
        <button class="btn btn-primary" type="submit"><i class="ti ti-arrow-right"></i> Anlegen &amp; weiter</button>
      </div>
    </form>
  </div>
  {{end}}

  <div class="rec-grid">
    <div class="card" style="margin:0">
      <div class="card-title"><span><i class="ti ti-info-circle"></i> Stammdaten</span>
        {{if .CanEditInfra}}<a class="btn btn-small" href="?tab=master" onclick="recTab('master');return false"><i class="ti ti-edit"></i> Bearbeiten</a>{{end}}</div>
      <div class="rec-f"><div class="rec-l">Typ</div><div class="rec-v"><i class="ti {{$n.TypeIcon}}"></i> {{$n.TypeLabel}}</div></div>
      {{if .Parent}}<div class="rec-f"><div class="rec-l">Übergeordnet</div><div class="rec-v"><a href="/infrastructure/{{.Parent.ID}}"><i class="ti {{.Parent.TypeIcon}}"></i> {{.Parent.Name}}</a></div></div>{{end}}
      {{if $n.Location}}<div class="rec-f"><div class="rec-l">Standort</div><div class="rec-v">{{$n.Location}}</div></div>{{end}}
      {{if $n.ManufacturerName}}<div class="rec-f"><div class="rec-l">Hersteller</div><div class="rec-v"><a href="/directory/{{$n.ManufacturerID}}" data-frame data-frame-title="{{$n.ManufacturerName}}">{{$n.ManufacturerName}}</a></div></div>
      {{else if $n.Manufacturer}}<div class="rec-f"><div class="rec-l">Hersteller</div><div class="rec-v">{{$n.Manufacturer}}</div></div>{{end}}
      {{if $n.Model}}<div class="rec-f"><div class="rec-l">Modell</div><div class="rec-v">{{$n.Model}}</div></div>{{end}}
      {{if $n.SerialNo}}<div class="rec-f"><div class="rec-l">Seriennummer</div><div class="rec-v" style="font-family:monospace">{{$n.SerialNo}}</div></div>{{end}}
      {{if $n.InstalledAt}}<div class="rec-f"><div class="rec-l">In Betrieb seit</div><div class="rec-v">{{$n.InstalledLabel}}</div></div>{{end}}
      {{range .PartnerLinks}}{{if ne .Role "manufacturer"}}<div class="rec-f"><div class="rec-l">{{.RoleLabel}}</div><div class="rec-v"><a href="/directory/{{.ID}}" data-frame data-frame-title="{{.Name}}"><i class="ti ti-building-factory-2"></i> {{.Name}}</a></div></div>{{end}}{{end}}
      {{if $n.CostCenterName}}<div class="rec-f"><div class="rec-l">Kostenstelle</div><div class="rec-v">{{$n.CostCenterNumber}} - {{$n.CostCenterName}}</div></div>{{end}}
      {{if .EffectiveDept}}<div class="rec-f"><div class="rec-l">Abteilung</div><div class="rec-v">{{.EffectiveDept}}{{if .DeptInherited}} <span class="rec-sub">(geerbt)</span>{{end}}</div></div>{{end}}
      {{if $n.Description}}<div class="rec-f"><div class="rec-l">Beschreibung</div><div class="rec-v">{{$n.Description}}</div></div>{{end}}
    </div>

    <div class="card" style="margin:0">
      <div class="card-title">
        <span><i class="ti ti-sitemap"></i> Untergeordnete Anlagen</span>
        {{if $.CanEditInfra}}{{template "icon-button" (dict "Action" "new" "ShowLabel" true "Label" "Hinzufügen" "Class" "btn-small" "OnClick" "openAddChild()")}}{{end}}
      </div>
      <div id="children-list">
        {{range .Children}}
        <div class="rec-row" data-rx data-rx-view="/infrastructure/{{.ID}}" data-rx-edit="/infrastructure/{{.ID}}">
          <div style="width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;background:{{css .TypeBg}};flex-shrink:0"><i class="ti {{.TypeIcon}}"></i></div>
          <div class="grow">{{.Name}}<div class="rec-sub">{{.TypeLabel}}{{if .Location}} · {{.Location}}{{end}}{{if .ManufacturerName}} · {{.ManufacturerName}}{{else if .Manufacturer}} · {{.Manufacturer}}{{end}}{{if .CostCenterName}} · {{.CostCenterNumber}} - {{.CostCenterName}}{{end}}</div></div>
          <i class="ti ti-chevron-right" style="color:var(--muted)"></i>
        </div>
        {{else}}
        <div class="rec-sub" style="padding:10px 0">Keine untergeordneten Elemente</div>
        {{end}}
      </div>
    </div>
  </div>
</div>

<!-- ── Stammdaten (alles in einem Formular) ── -->
{{if .CanEditInfra}}
<div class="rec-pane" data-pane="master">
  <form class="card rec-form" method="post" action="/infrastructure/{{$n.ID}}/edit">
    <div class="rec-sec" style="margin-top:0">Allgemein</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Name *</label><input name="name" class="form-input" value="{{$n.Name}}" required maxlength="255"></div>
      <div class="form-group"><label class="form-label">Typ *</label>
        <select name="type" class="form-input">{{range .Types}}<option value="{{.Key}}" {{if eq .Key $n.Type}}selected{{end}}>{{.Label}}</option>{{end}}</select></div>
      <div class="form-group"><label class="form-label">Übergeordnet</label>
        <select name="parent_id" class="form-input">
          <option value="">– oberste Ebene –</option>
          {{range .ParentOptions}}<option value="{{.ID}}" {{if eq .ID $n.ParentID}}selected{{end}}>{{.Path}}</option>{{end}}
        </select></div>
      <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input" value="{{$n.Location}}" maxlength="255" placeholder="z. B. Halle A"></div>
    </div>
    <div class="form-group"><label class="form-label">Beschreibung</label><textarea name="description" class="form-input" rows="3" placeholder="Zweck, Besonderheiten, Hinweise für die Instandhaltung …">{{$n.Description}}</textarea></div>

    <div class="rec-sec">Technik</div>
    <input type="hidden" name="manufacturer" value="{{$n.Manufacturer}}">
    {{template "directory-picker" (dict "Label" "Hersteller" "TargetID" "infra-edit-manufacturer-id" "Kind" "manufacturer" "Value" $n.ManufacturerID "LegacyValue" $n.Manufacturer)}}
    <div class="cols">
      <div class="form-group"><label class="form-label">Modell / Typbezeichnung</label><input name="model" class="form-input" value="{{$n.Model}}" maxlength="100"></div>
      <div class="form-group"><label class="form-label">Seriennummer</label><input name="serial_no" class="form-input" value="{{$n.SerialNo}}" maxlength="100"></div>
      <div class="form-group"><label class="form-label">In Betrieb seit</label><input type="date" name="installed_at" class="form-input" value="{{$n.InstalledAt}}"></div>
    </div>

    <div class="rec-sec">Partner</div>
    <div class="rec-compare">
      <div>{{template "directory-picker" (dict "Label" "Lieferant" "TargetID" "infra-edit-supplier-id" "Name" "supplier_id" "Kind" "supplier" "Value" .SupplierID)}}</div>
      <div>{{template "directory-picker" (dict "Label" "Servicepartner" "TargetID" "infra-edit-service-id" "Name" "service_partner_id" "Kind" "all" "Value" .ServiceID)}}</div>
    </div>

    <div class="rec-sec">Zuordnung</div>
    {{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "infra-edit-cost-center-id" "Value" $n.CostCenterID)}}
    <div class="form-group"><label class="form-label">Abteilung</label>
      <select name="department_id" class="form-input"><option value="">– von übergeordneter Anlage erben –</option>{{range .Departments}}<option value="{{.ID}}" {{if eq .ID $.DepartmentID}}selected{{end}}>{{.Name}}</option>{{end}}</select>
      <div class="rec-sub" style="margin-top:3px">Bestimmt, welche Abteilung die Vorgänge dieser Anlage sieht. Gilt auch für alle Unteranlagen ohne eigene Abteilung.</div></div>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
      <a class="btn" href="?tab=overview">Abbrechen</a>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </form>
</div>
{{end}}

<!-- ── Prüfungen & Gefährdungsbeurteilungen (infra_obligations.go) ── -->
<div class="rec-pane" data-pane="checks">
  {{range $kind := (list "inspection" "risk_assessment")}}
  <div class="card">
    <div class="card-title"><span><i class="ti {{if eq $kind "inspection"}}ti-clipboard-check{{else}}ti-shield-check{{end}}"></i> {{if eq $kind "inspection"}}Prüfpflichten{{else}}Gefährdungsbeurteilungen{{end}}</span>
      {{if $.CanEditInfra}}<button type="button" class="btn btn-small" onclick="obNew('{{$kind}}')"><i class="ti ti-plus"></i> Hinzufügen</button>{{end}}</div>
    {{$any := false}}
    {{range $.Obligations}}{{if eq .Kind $kind}}{{$any = true}}
    <div class="rec-row ob-row ob-{{.State}}" data-rx data-rx-title="{{.Title}}">
      <i class="ti {{if eq .State "overdue"}}ti-alert-octagon{{else if eq .State "soon"}}ti-bell-ringing{{else}}ti-circle-check{{end}} ob-ic"></i>
      <div class="grow"><b>{{.Title}}</b>
        <div class="rec-sub">{{if .Basis}}{{.Basis}} · {{end}}{{if .IntervalMonths}}alle {{.IntervalMonths}} Monate{{else}}einmalig{{end}}{{if .Inspector}} · {{.Inspector}}{{end}}{{if .ResponsibleName}} · <i class="ti ti-user"></i> {{.ResponsibleName}}{{end}}</div></div>
      <div style="text-align:right;white-space:nowrap"><span class="badge {{.StateClass}}">{{.StateLabel}}</span>
        <div class="rec-sub">{{if .NextDue}}fällig {{.NextDue}}{{end}}{{if .LastDone}} · zuletzt {{.LastDone}}{{end}}</div></div>
      <template class="rx-more">
        {{if .Notes}}<div class="rec-sub" style="flex-basis:100%;white-space:pre-wrap">{{.Notes}}</div>{{end}}
        {{if $.CanEditInfra}}
        <button type="button" class="btn btn-small cw-finish" onclick="obToggle(this,'.ob-done')"><i class="ti ti-circle-check"></i> Erledigt erfassen</button>
        <button type="button" class="btn btn-small" onclick="obToggle(this,'.ob-edit')"><i class="ti ti-edit"></i> Bearbeiten</button>
        {{end}}
        {{if .Log}}<button type="button" class="btn btn-small" onclick="obToggle(this,'.ob-log')"><i class="ti ti-history"></i> Nachweise ({{len .Log}})</button>{{end}}
        {{if $.CanEditInfra}}
        <form method="post" action="/infrastructure/{{$.Node.ID}}/obligations/{{.ID}}/delete" onsubmit="return confirm('„{{.Title}}“ mit allen Nachweisen löschen?')" style="margin-left:auto"><button class="btn btn-small" style="color:var(--red)"><i class="ti ti-trash"></i> Löschen</button></form>
        <form class="ob-sub ob-done rec-form" method="post" action="/infrastructure/{{$.Node.ID}}/obligations/{{.ID}}/done" hidden>
          <div class="cols">
            <div class="form-group"><label class="form-label">Durchgeführt am *</label><input type="date" name="done_on" class="form-input" value="{{$.Today}}" max="{{$.Today}}" required></div>
            <div class="form-group"><label class="form-label">Ergebnis</label><select name="result" class="form-input"><option value="ok">ohne Mängel</option><option value="defects">mit Mängeln</option></select></div>
          </div>
          <div class="form-group"><label class="form-label">Bemerkung / Prüfbericht-Nr.</label><input name="note" class="form-input" maxlength="1000"></div>
          <p class="rec-sub" style="margin:-4px 0 8px">{{if .IntervalMonths}}Nächste Fälligkeit: Datum + {{.IntervalMonths}} Monate.{{else}}Einmalig – danach ohne neue Fälligkeit.{{end}} Den Prüfbericht unter <b>Dokumente</b> ablegen.</p>
          <button class="btn btn-primary btn-small" type="submit"><i class="ti ti-device-floppy"></i> Durchführung speichern</button>
        </form>
        <div class="ob-sub ob-edit" hidden>{{template "obligation-form" (dict "O" . "Users" $.Users "Action" (printf "/infrastructure/%s/obligations/%s" $.Node.ID .ID) "Kind" .Kind)}}</div>
        {{end}}
        {{if .Log}}<div class="ob-sub ob-log" hidden>{{range .Log}}<div class="rec-f"><div class="rec-l">{{.DoneOn}}</div><div class="rec-v"><span class="badge {{if .Defects}}b-amber{{else}}b-green{{end}}">{{if .Defects}}mit Mängeln{{else}}ohne Mängel{{end}}</span> {{.Note}}{{if .DoneBy}} <span class="rec-sub">· {{.DoneBy}}</span>{{end}}</div></div>{{end}}</div>{{end}}
      </template>
    </div>
    {{end}}{{end}}
    {{if not $any}}<div class="rec-sub" style="padding:10px 0">{{if eq $kind "inspection"}}Noch keine Prüfpflichten – z. B. DGUV V3, UVV-Prüfung, Druckbehälter, Leitern und Tritte.{{else}}Noch keine Gefährdungsbeurteilung – nach ArbSchG §5 für jede Anlage bzw. jeden Arbeitsplatz.{{end}}</div>{{end}}
    {{if $.CanEditInfra}}<div id="ob-new-{{$kind}}" class="ob-new" hidden>{{template "obligation-form" (dict "O" nil "Users" $.Users "Action" (printf "/infrastructure/%s/obligations" $.Node.ID) "Kind" $kind)}}</div>{{end}}
  </div>
  {{end}}
  <p class="rec-sub"><i class="ti ti-bell"></i> Erinnerung: Die verantwortliche Person (sonst die Admins) bekommt eine Chat-Nachricht von „Service“ – zu Beginn des Vorlaufs und noch einmal, wenn die Fälligkeit überschritten ist.</p>
</div>

<!-- ── Easy-Mode-Meldetexte: Zuordnung aus dem Katalog (easy_texts.go) ── -->
<div class="rec-pane" data-pane="easy">
  <div class="card">
    <div class="card-title"><span><i class="ti ti-hand-finger"></i> Meldetexte für den Easy-Mode</span><a class="card-action" href="/infrastructure#easy-texts">Katalog →</a></div>
    <p class="rec-sub" style="margin-bottom:10px">Angehakte Texte erscheinen nach dem QR-Scan als Tasten – in der Sprache des Handys. Sie gelten auch für alle Unteranlagen. Texte mit <span class="badge b-blue">über …</span> gelten hier schon, weil sie an einer übergeordneten Anlage hängen.</p>
    {{if .EasyTexts}}
    <form method="post" action="/infrastructure/{{.Node.ID}}/easy-texts">
      {{range .EasyTexts}}
      <label class="rec-row" style="cursor:{{if $.CanEditInfra}}pointer{{else}}default{{end}}">
        <input type="checkbox" name="text_id" value="{{.ID}}"{{if .Assigned}} checked{{end}}{{if not $.CanEditInfra}} disabled{{end}} style="width:20px;height:20px;flex-shrink:0">
        <div class="grow"><b>{{.Text}}</b><div class="rec-sub">{{.TypeLabel}} · elektrisch/mechanisch: {{.KindLabel}}</div></div>
        {{if .InheritedFrom}}<span class="badge b-blue" title="Gilt hier schon, weil er an „{{.InheritedFrom}}“ zugeordnet ist">über {{.InheritedFrom}}</span>{{end}}
      </label>
      {{end}}
      {{if $.CanEditInfra}}<button class="btn btn-primary btn-small" type="submit" style="margin-top:10px"><i class="ti ti-device-floppy"></i> Zuordnung speichern</button>{{end}}
    </form>
    {{else}}<div class="rec-sub" style="padding:6px 0 10px">Im Katalog gibt es noch keine Meldetexte.</div>{{end}}
    {{if .CanEditInfra}}<div class="ih-section" style="margin-top:16px">Neuer Meldetext – kommt in den Katalog und gilt gleich hier</div>
    {{template "easy-text-form" (dict "T" nil "Action" "/infrastructure/easy-texts" "Back" (printf "/infrastructure/%s?tab=easy" .Node.ID) "Assign" .Node.ID "Label" "Anlegen und zuordnen")}}{{end}}
  </div>
</div>

<!-- ── Anlagen-Historie (Vorgänge, Kommentare, Ersatzteile) ── -->
<div class="rec-pane" data-pane="events">
    <!-- Historie -->
    <div class="card" id="infra-history">
      <div class="card-title"><span><i class="ti ti-history"></i> Anlagen-Historie</span></div>

      <!-- Kommentar erfassen -->
      <form id="infra-comment-form" class="ih-comment-form"
            hx-post="/infrastructure/{{.Node.ID}}/comments" hx-target="#infra-comment-result" hx-swap="innerHTML"
            hx-on::after-request="if(event.detail.successful && !event.detail.xhr.getResponseHeader('HX-Retarget')) this.reset()">
        <textarea name="text" class="form-input" rows="2" placeholder="Kommentar, Hinweis oder Beobachtung zur Anlage …" required></textarea>
        <div class="ih-comment-row">
          <select name="ref" class="form-input" title="Optional: Bezug zu einem Vorgang">
            <option value="">Ohne Bezug (allgemein zur Anlage)</option>
            {{range .CommentRefs}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
          </select>
          <label class="ih-check"><input type="checkbox" name="pinned"> <i class="ti ti-pin"></i> Anheften</label>
          <button type="submit" class="btn btn-small btn-primary"><i class="ti ti-send"></i> Kommentieren</button>
        </div>
        <div id="infra-comment-result"></div>
      </form>

      <!-- Filter & Suche -->
      <form id="infra-history-filter" class="ih-filter"
            hx-get="/infrastructure/{{.Node.ID}}/history" hx-target="#infra-history-results" hx-swap="innerHTML"
            hx-trigger="load, input delay:350ms, submit, infra-history-refresh from:body"
            hx-indicator="#infra-history-loading">
        <input type="hidden" name="filtered" value="1">
        <div class="ih-filter-row">
          <div class="search-box" style="flex:1;min-width:200px">
            <i class="ti ti-search" style="color:var(--muted)"></i>
            <input type="search" name="q" placeholder="Suche in Titel, Text, Maßnahmen, Ersatzteilen, Personen …" style="flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)">
          </div>
          <label class="ih-date">Von <input type="date" name="from" class="form-input"></label>
          <label class="ih-date">Bis <input type="date" name="to" class="form-input"></label>
          <select name="state" class="form-input" style="width:auto" title="Status der Vorgänge">
            <option value="">Alle Status</option>
            <option value="open">Offen</option>
            <option value="closed">Abgeschlossen</option>
          </select>
        </div>
        <div class="ih-filter-row">
          {{range .HistoryModules}}
          <label class="ih-check ih-mod"><input type="checkbox" name="module" value="{{.Key}}" checked> <i class="ti {{.Icon}}"></i> {{.Label}}</label>
          {{end}}
        </div>
        <div class="ih-filter-row" style="justify-content:space-between">
          <label class="ih-check"><input type="checkbox" name="children" value="1" checked> <i class="ti ti-subtask"></i> Unteranlagen einbeziehen</label>
          <div style="display:flex;gap:6px;align-items:center">
            <span id="infra-history-loading" class="htmx-indicator" style="font-size:11px;color:var(--muted)"><i class="ti ti-loader-2"></i> lädt …</span>
            <button type="button" class="btn btn-small" onclick="infraHistoryPreset(30)">30 Tage</button>
            <button type="button" class="btn btn-small" onclick="infraHistoryPreset(365)">12 Monate</button>
            <button type="button" class="btn btn-small" onclick="infraHistoryReset()"><i class="ti ti-filter-off"></i> Zurücksetzen</button>
          </div>
        </div>
      </form>

      <div id="infra-history-results">
        <div style="font-size:12px;color:var(--muted);padding:14px 0;text-align:center">Historie wird geladen …</div>
      </div>
    </div>

</div>

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>
</div>

<!-- ── Dokumente ── -->
<div class="rec-pane" data-pane="docs">
  <div class="card">
    <div class="card-title"><span><i class="ti ti-paperclip"></i> Fotos & Dokumente</span></div>
    <div id="attachments-{{.Node.ID}}" data-attach-ref="infrastructure:{{.Node.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <label class="btn btn-small" style="cursor:pointer"><i class="ti ti-photo"></i> Galerie<input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')"></label>
      <label class="btn btn-small" style="cursor:pointer"><i class="ti ti-camera"></i> Kamera<input type="file" accept="image/*" capture="environment" style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')"></label>
      <label class="btn btn-small" style="cursor:pointer"><i class="ti ti-file-upload"></i> Dokument<input type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" multiple style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')"></label>
    </div>
  </div>
</div>

<!-- ── HMI-Fernzugriff (VNC) ── -->
{{if or .HMI.View .HMI.Manage}}
<div class="rec-pane" data-pane="hmi">
  <div class="card">
    <div class="card-title" style="display:flex;align-items:center;gap:8px">
      <i class="ti ti-device-desktop-analytics" style="color:var(--accent)"></i> HMI-Fernzugriff
      {{if .HMI.Manage}}<button type="button" class="btn" style="margin-left:auto;font-size:12px" onclick="hmiEdit()"><i class="ti ti-plus"></i> HMI hinzufügen</button>{{end}}
    </div>
    <p style="font-size:12px;color:var(--muted);margin:-4px 0 12px">
      {{if .HMI.Control}}Du darfst HMIs ansehen und – wo freigegeben – bedienen.{{else if .HMI.View}}Du darfst HMIs nur ansehen; Tastatur und Maus werden nicht übertragen.{{else}}Du darfst HMIs einrichten, aber nicht öffnen.{{end}}
      Jeder Zugriff wird protokolliert.
    </p>
    {{if .HMI.Manage}}
    <form id="hmi-form" style="display:none;border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:12px;background:var(--bg3)" onsubmit="hmiSave(this); return false">
      <input type="hidden" name="id">
      <div class="grid2">
        <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" maxlength="120" required placeholder="z. B. Bedienpanel Presse 1"></div>
        <div class="form-group"><label class="form-label">Adresse (IP oder Rechnername)</label><input name="host" class="form-input" required placeholder="192.168.10.21" autocomplete="off"></div>
        <div class="form-group"><label class="form-label">Port</label><input name="port" type="number" min="1" max="65535" class="form-input" value="5900"></div>
        <div class="form-group"><label class="form-label">VNC-Passwort</label><input name="password" type="password" class="form-input" maxlength="64" autocomplete="new-password" placeholder="leer = ohne Passwort">
          <label id="hmi-clear-pw" style="display:none;gap:6px;align-items:center;font-size:11.5px;color:var(--muted);margin-top:4px"><input type="checkbox" name="clear_password"> gespeichertes Passwort entfernen</label></div>
        <div class="form-group" style="grid-column:1/-1"><label class="form-label">Hinweis</label><input name="notes" class="form-input" maxlength="500" placeholder="optional, z. B. nur bei Stillstand bedienen"></div>
        <label style="grid-column:1/-1;display:flex;gap:8px;align-items:center;font-size:13px"><input type="checkbox" name="allow_control" checked style="width:18px;height:18px"> Bedienen erlaubt (sonst für alle nur ansehen)</label>
      </div>
      <div id="hmi-form-msg" style="font-size:12px;margin:8px 0"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn" onclick="document.getElementById('hmi-form').style.display='none'">Abbrechen</button>
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Speichern</button>
      </div>
    </form>
    {{end}}
    <div id="hmi-list" style="font-size:12px;color:var(--muted)">Lade HMIs…</div>
  </div>
</div>
{{end}}

<!-- ── Verknüpfungen ── -->
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>

<!-- ── Änderungen ── -->
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>
{{end}}

{{/* Prüfpflicht / Gefährdungsbeurteilung anlegen oder ändern: O = obligationView oder nil */}}
{{define "obligation-form"}}{{$o := .O}}
<form class="rec-form ob-form" method="post" action="{{.Action}}">
  <div class="cols">
    <div class="form-group"><label class="form-label">Art</label>
      <select name="kind" class="form-input"><option value="inspection" {{if eq .Kind "inspection"}}selected{{end}}>Prüfpflicht</option><option value="risk_assessment" {{if eq .Kind "risk_assessment"}}selected{{end}}>Gefährdungsbeurteilung</option></select></div>
    <div class="form-group" style="grid-column:span 2"><label class="form-label">Bezeichnung *</label><input name="title" class="form-input" required maxlength="200" value="{{if $o}}{{$o.Title}}{{end}}" placeholder="{{if eq .Kind "inspection"}}z. B. Prüfung elektrischer Anlagen (DGUV V3){{else}}z. B. GBU Bandsäge – Schnitt- und Lärmgefährdung{{end}}"></div>
    <div class="form-group"><label class="form-label">Grundlage</label><input name="basis" class="form-input" maxlength="200" value="{{if $o}}{{$o.Basis}}{{end}}" placeholder="{{if eq .Kind "inspection"}}BetrSichV, DGUV V3 …{{else}}ArbSchG §5, BetrSichV §3{{end}}"></div>
    <div class="form-group"><label class="form-label">{{if eq .Kind "inspection"}}Prüfer / Firma{{else}}Erstellt von{{end}}</label><input name="inspector" class="form-input" maxlength="200" value="{{if $o}}{{$o.Inspector}}{{end}}"></div>
    <div class="form-group"><label class="form-label">Intervall (Monate, 0 = einmalig)</label><input type="number" name="interval_months" min="0" max="240" class="form-input" value="{{if $o}}{{$o.IntervalMonths}}{{else}}{{if eq .Kind "inspection"}}12{{else}}24{{end}}{{end}}"></div>
    <div class="form-group"><label class="form-label">Zuletzt erledigt</label><input type="date" name="last_done" class="form-input" value="{{if $o}}{{$o.LastDoneISO}}{{end}}"></div>
    <div class="form-group"><label class="form-label">Nächste Fälligkeit</label><input type="date" name="next_due" class="form-input" value="{{if $o}}{{$o.NextDueISO}}{{end}}" title="leer = zuletzt erledigt + Intervall"></div>
    <div class="form-group"><label class="form-label">Erinnern (Tage vorher)</label><input type="number" name="remind_days" min="0" max="365" class="form-input" value="{{if $o}}{{$o.RemindDays}}{{else}}30{{end}}"></div>
    <div class="form-group"><label class="form-label">Verantwortlich (bekommt die Erinnerung)</label>
      <select name="responsible_to" class="form-input"><option value="">– Admins –</option>{{range .Users}}<option value="{{.ID}}" {{if and $o (eq .ID $o.ResponsibleID)}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
  </div>
  <div class="form-group"><label class="form-label">Notiz</label><textarea name="notes" class="form-input" rows="2">{{if $o}}{{$o.Notes}}{{end}}</textarea></div>
  <div style="display:flex;justify-content:flex-end;gap:8px">
    <button type="button" class="btn btn-small" onclick="this.closest('.ob-new,.ob-sub').hidden=true">Abbrechen</button>
    <button class="btn btn-primary btn-small" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
  </div>
</form>
{{end}}

{{define "context-list"}}
{{range .Children}}
<div class="act-item" onclick="window.location='/infrastructure/{{.ID}}'" style="cursor:pointer">
  <div style="font-size:13px"><i class="ti {{.TypeIcon}}"></i></div>
  <div class="act-text">{{.Name}}</div>
  <i class="ti ti-chevron-right" style="font-size:12px;color:var(--muted)"></i>
</div>
{{end}}
{{end}}

{{block "scripts" .}}
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){document.getElementById(id).style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id$="-menu"]'))document.querySelectorAll('[id$="-menu"]').forEach(m=>m.style.display='none');});
// Prüfungen & GBU: Unterformulare im aufgeklappten Bereich, neues Formular je Art
function obToggle(btn, sel) {
  const box = btn.closest('.rx-box');
  box.querySelectorAll('.ob-sub').forEach(f => { if(!f.matches(sel)) f.hidden = true; });
  const f = box.querySelector(sel);
  if(f){ f.hidden = !f.hidden; if(!f.hidden){ const i = f.querySelector('input,select'); if(i) i.focus(); } }
}
function obNew(kind) {
  const f = document.getElementById('ob-new-' + kind);
  if(!f) return;
  f.hidden = !f.hidden;
  if(!f.hidden) f.querySelector('input[name="title"]').focus();
}
function openAddChild() {
  recTab('overview');
  const box = document.getElementById('add-child');
  if(!box) return;
  box.style.display = 'block';
  box.scrollIntoView({behavior:'smooth', block:'start'});
  box.querySelector('input[name="name"]').focus({preventScroll:true});
}
// Anlagen-Historie: Kommentar inline bearbeiten und Filter-Schnellwahl
function infraCommentEdit(btn, show) {
  const entry = btn.closest('.ih-comment');
  entry.querySelector('.ih-comment-edit').style.display = show ? 'block' : 'none';
  entry.querySelector('.ih-comment-text').style.display = show ? 'none' : 'block';
  if (show) entry.querySelector('.ih-comment-edit textarea').focus();
}
function infraHistoryPreset(days) {
  const f = document.getElementById('infra-history-filter');
  const from = new Date(Date.now() - days * 86400000);
  f.elements['from'].value = from.toISOString().slice(0, 10);
  f.elements['to'].value = '';
  htmx.trigger(f, 'submit');
}
function infraHistoryReset() {
  const f = document.getElementById('infra-history-filter');
  f.reset();
  htmx.trigger(f, 'submit');
}
// ── HMI-Fernzugriff: Liste, Einrichten, letzte Zugriffe ──
const HMI_INFRA = '{{.Node.ID}}';
let hmiItems = [];
async function hmiJSON(url, opts){
  const res = await fetch(url, Object.assign({credentials:'same-origin'}, opts||{}));
  const json = await res.json().catch(()=>({}));
  if(!res.ok) throw new Error(json.error || ('HTTP ' + res.status));
  return json;
}
function hmiEsc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
async function hmiLoad(){
  const box = document.getElementById('hmi-list'); if(!box) return;
  try{
    const data = await hmiJSON('/infrastructure/' + HMI_INFRA + '/hmis');
    hmiItems = data.hmis || []; const p = data.perms || {};
    if(!hmiItems.length){ box.innerHTML = '<div style="padding:10px;border:1px dashed var(--border);border-radius:8px">Für diese Anlage ist noch kein HMI eingerichtet.</div>'; return; }
    box.innerHTML = hmiItems.map(x => {
      const base = '/infrastructure/' + HMI_INFRA + '/hmi/' + encodeURIComponent(x.id);
      const btns = (p.View ? '<a class="btn" href="' + base + '?mode=view" target="_blank" rel="noopener"><i class="ti ti-eye"></i> Ansehen</a>' : '')
        + (x.can_control ? '<a class="btn btn-primary" href="' + base + '?mode=control" target="_blank" rel="noopener"><i class="ti ti-hand-click"></i> Bedienen</a>' : '')
        + (p.Manage ? '<button type="button" class="btn" data-hmi-edit="' + hmiEsc(x.id) + '" title="Bearbeiten"><i class="ti ti-edit"></i></button><button type="button" class="btn btn-danger" data-hmi-del="' + hmiEsc(x.id) + '" title="Löschen"><i class="ti ti-trash"></i></button>' : '');
      const meta = [p.Manage ? hmiEsc(x.host + ':' + x.port) : '', x.allow_control ? '' : 'nur ansehen', p.Manage && !x.has_password ? 'ohne Passwort' : ''].filter(Boolean).join(' · ');
      return '<div style="border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:8px;background:var(--bg2)">'
        + '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><i class="ti ti-device-desktop" style="color:var(--accent);font-size:18px"></i>'
        + '<div style="flex:1;min-width:160px"><div style="font-weight:600;font-size:13px;color:var(--text)">' + hmiEsc(x.name) + '</div>'
        + (meta ? '<div style="font-size:11.5px;color:var(--muted)">' + meta + '</div>' : '')
        + (x.notes ? '<div style="font-size:11.5px;color:var(--muted)">' + hmiEsc(x.notes) + '</div>' : '') + '</div>'
        + '<div style="display:flex;gap:6px;flex-wrap:wrap">' + btns + '</div></div>'
        + '<details data-hmi-log="' + hmiEsc(x.id) + '" style="margin-top:6px"><summary style="font-size:11.5px;color:var(--muted);cursor:pointer">Letzte Zugriffe</summary><div style="font-size:11.5px;color:var(--muted);padding-top:4px">Lade…</div></details></div>';
    }).join('');
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">' + hmiEsc(e.message) + '</span>'; }
}
document.addEventListener('click', async e => {
  const ed = e.target.closest('[data-hmi-edit]'); if(ed){ hmiEdit(ed.dataset.hmiEdit); return; }
  const del = e.target.closest('[data-hmi-del]');
  if(del){
    const x = hmiItems.find(i => i.id === del.dataset.hmiDel);
    if(!x || !confirm('HMI „' + x.name + '“ löschen? Das Zugriffsprotokoll wird mitgelöscht.')) return;
    try{ await hmiJSON('/infrastructure/' + HMI_INFRA + '/hmis/' + encodeURIComponent(x.id) + '/delete', {method:'POST'}); hmiLoad(); }
    catch(err){ alert(err.message); }
  }
});
document.addEventListener('toggle', async e => {
  const d = e.target; if(!d.matches || !d.matches('details[data-hmi-log]') || !d.open) return;
  const out = d.querySelector('div');
  try{
    const rows = await hmiJSON('/infrastructure/' + HMI_INFRA + '/hmis/' + encodeURIComponent(d.dataset.hmiLog) + '/sessions');
    const fmt = s => new Date(s).toLocaleString('de-DE', {dateStyle:'short', timeStyle:'short'});
    out.innerHTML = rows.length ? rows.map(s => '<div>' + fmt(s.started_at) + ' · ' + hmiEsc(s.user || '–') + ' · ' + (s.mode === 'control' ? 'bedient' : 'angesehen')
      + (s.ended_at ? ' · ' + Math.max(1, Math.round((new Date(s.ended_at) - new Date(s.started_at)) / 60000)) + ' min' : ' · läuft')
      + (s.error ? ' · <span style="color:var(--red)">' + hmiEsc(s.error) + '</span>' : '') + '</div>').join('') : 'Noch keine Zugriffe.';
  }catch(err){ out.textContent = err.message; }
}, true);
function hmiEdit(id){
  const f = document.getElementById('hmi-form'); if(!f) return;
  const x = hmiItems.find(i => i.id === id) || {port: 5900, allow_control: true};
  f.reset();
  f.elements.id.value = x.id || '';
  f.elements.name.value = x.name || '';
  f.elements.host.value = x.host || '';
  f.elements.port.value = x.port || 5900;
  f.elements.notes.value = x.notes || '';
  f.elements.allow_control.checked = x.allow_control !== false;
  f.elements.password.placeholder = x.has_password ? 'unverändert lassen' : 'leer = ohne Passwort';
  document.getElementById('hmi-clear-pw').style.display = x.has_password ? 'flex' : 'none';
  document.getElementById('hmi-form-msg').textContent = '';
  f.style.display = 'block'; f.elements.name.focus();
}
async function hmiSave(f){
  const msg = document.getElementById('hmi-form-msg');
  const id = f.elements.id.value;
  const body = {name: f.elements.name.value, host: f.elements.host.value, port: parseInt(f.elements.port.value, 10) || 5900,
    password: f.elements.password.value, clear_password: f.elements.clear_password.checked,
    allow_control: f.elements.allow_control.checked, notes: f.elements.notes.value};
  try{
    await hmiJSON('/infrastructure/' + HMI_INFRA + '/hmis' + (id ? '/' + encodeURIComponent(id) : ''), {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)});
    f.style.display = 'none'; hmiLoad();
  }catch(e){ msg.innerHTML = '<span style="color:var(--red)">' + hmiEsc(e.message) + '</span>'; }
  return false;
}
if(document.getElementById('hmi-list')){
  if(document.readyState !== 'loading') hmiLoad(); else document.addEventListener('DOMContentLoaded', hmiLoad);
}
</script>
{{end}}
