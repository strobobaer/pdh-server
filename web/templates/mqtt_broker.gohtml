{{template "base" .}}
{{define "copy-btn"}}<button type="button" class="btn-icon" style="width:22px;height:22px;min-width:22px;vertical-align:middle" onclick="copyValue('{{.}}')" title="Kopieren"><i class="ti ti-copy" style="font-size:12px"></i></button>{{end}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Broker-Status · {{.ConnectionName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a></p>
</div>

{{if not .Applicable}}
<div class="card" role="status">
  Diese Verbindung nutzt keinen integrierten Broker (kein MQTT-Konnektor mit "Integrierter Broker").
</div>
{{else}}

{{if .CanWrite}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Client-Einstellungen</div>
  <p style="font-size:11px;color:var(--muted);margin:0 0 10px">Diese Werte in einem MQTT-Client/Gerät eintragen, um sich mit diesem Broker zu verbinden.</p>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0">
    {{if .PublicHost}}
    <dt style="color:var(--muted)">Im Haus (ohne TLS)</dt><dd style="margin:0"><code id="cs-a-plain" class="mq-addr">mqtt://{{.PublicHost}}:{{.ListenPort}}</code> {{template "copy-btn" "cs-a-plain"}} <span class="mq-sub">für Steuerungen und Geräte ohne TLS</span></dd>
    {{if .TLSPort}}<dt style="color:var(--muted)">Im Haus und über VPN</dt><dd style="margin:0"><code id="cs-a-tls" class="mq-addr">mqtts://{{.PublicHost}}:{{.TLSPort}}</code> {{template "copy-btn" "cs-a-tls"}} <span class="mq-sub">verschlüsselt, mit gültigem Zertifikat</span></dd>{{end}}
    <dt style="color:var(--muted)">Im Haus und von außen</dt><dd style="margin:0"><code id="cs-a-wss" class="mq-addr">wss://{{.PublicHost}}/</code> {{template "copy-btn" "cs-a-wss"}} <span class="mq-sub">WebSocket über Port 443, für Apps und Dienste. Keep-Alive höchstens 60 s einstellen – Cloudflare trennt stille Verbindungen nach 100 s.</span></dd>
    {{end}}
    <dt style="color:var(--muted)">Host</dt><dd style="margin:0"><code id="cs-host">{{if .PublicHost}}{{.PublicHost}}{{else}}{{.SuggestedHost}}{{end}}</code> {{template "copy-btn" "cs-host"}} <span style="font-size:11px;color:var(--muted)">(Adresse, unter der dieser PDH-Server erreichbar ist - bei eigener Portweiterleitung ggf. abweichend)</span></dd>
    <dt style="color:var(--muted)">Port (TCP)</dt><dd style="margin:0"><code id="cs-port">{{.ListenPort}}</code> {{template "copy-btn" "cs-port"}}</dd>
    {{if .WebsocketPort}}<dt style="color:var(--muted)">Port (WebSocket)</dt><dd style="margin:0"><code id="cs-ws-port">{{.WebsocketPort}}</code> {{template "copy-btn" "cs-ws-port"}}</dd>{{end}}
    {{if .TLSPort}}<dt style="color:var(--muted)">Port (TLS)</dt><dd style="margin:0"><code id="cs-tls-port">{{.TLSPort}}</code> {{template "copy-btn" "cs-tls-port"}}</dd>{{end}}
    <dt style="color:var(--muted)">Verschlüsselung</dt><dd style="margin:0">{{if .PublicHost}}{{if .TLSPort}}TLS auf Port {{.TLSPort}} (mqtts) und über 443 (wss); Port {{.ListenPort}} ohne TLS{{else}}über 443 (wss); Port {{.ListenPort}} ohne TLS{{end}}{{else if .TLSEnabled}}TLS aktiv (mqtts/wss){{else}}Keine (mqtt/ws){{end}}</dd>
    <dt style="color:var(--muted)">Anmeldung</dt>
    {{if .AllowAnonymous}}
    <dd style="margin:0">Anonym erlaubt - kein Benutzername/Passwort nötig</dd>
    {{else}}
    <dd style="margin:0">
      Benutzername <code id="cs-user">{{.BrokerUsername}}</code> {{template "copy-btn" "cs-user"}}
      · Passwort: in der Verbindung hinterlegt (wird aus Sicherheitsgründen nicht angezeigt)
    </dd>
    {{end}}
    {{if .TopicFilter}}<dt style="color:var(--muted)">Empfohlenes Topic</dt><dd style="margin:0"><code id="cs-topic">{{.TopicFilter}}</code> {{template "copy-btn" "cs-topic"}}</dd>{{end}}
    <dt style="color:var(--muted)">QoS</dt><dd style="margin:0">{{if .QoS}}{{.QoS}}{{else}}0{{end}}</dd>
    <dt style="color:var(--muted)">Retained Messages</dt><dd style="margin:0">{{if .RetainEnabled}}erlaubt{{else}}nicht erlaubt{{end}}</dd>
  </dl>
</div>
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Prüfliste{{if .PublicHost}} · {{.PublicHost}}{{end}}</div>
  {{if .PublicHost}}<p style="font-size:11px;color:var(--muted);margin:0 0 10px">Was noch fehlt, damit der Broker unter seinem Namen erreichbar ist. Reines MQTT (ohne WebSocket) geht von außen nur über VPN – es wird kein Port ins Internet geöffnet.</p>
  {{else}}<p style="font-size:11px;color:var(--muted);margin:0 0 10px">Ob Geräte im Haus den Broker erreichen. Mit einem „Name des Brokers“ in der Verbindung kommen Zertifikat, Name im Haus und Tunnel dazu.</p>{{end}}
  <div id="mqtt-checklist" hx-get="/import/connections/{{.ConnectionID}}/broker/checklist" hx-trigger="load, mqtt-check" hx-swap="innerHTML">
    <span style="font-size:12px;color:var(--muted)"><i class="ti ti-loader-2"></i> Prüfe {{if .PublicHost}}Zertifikat, Namen im Haus, Tunnel und Firewall{{else}}Firewall{{end}} …</span>
  </div>
</div>
{{end}}

{{if not .Enabled}}
<div class="card" role="status">
  Diese Verbindung ist deaktiviert, der integrierte Broker läuft daher nicht. Über den Import-Bereich (Rechtsklick → Aktivieren/Deaktivieren) aktivieren.
</div>
{{else if not .Running}}
<div class="card" role="alert">
  Der Broker sollte laufen, ist aber aktuell nicht aktiv. Verbindung bearbeiten und erneut speichern, um einen Neustart auszulösen.
  {{if .StartError}}<p style="margin:8px 0 0;font-size:12px;color:var(--red);font-family:monospace">{{.StartError}}</p>{{else}}<p style="margin:8px 0 0;font-size:12px;color:var(--muted)">Keine Fehlermeldung hinterlegt - PDH wurde vermutlich seit dem letzten Aktivieren neu gestartet und der Broker noch nicht erneut versucht.</p>{{end}}
</div>
{{else}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Broker</div>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0" id="broker-info">
    <dt style="color:var(--muted)">Status</dt><dd style="margin:0" id="info-status"><span class="badge" style="background:var(--green)">Aktiv</span></dd>
    <dt style="color:var(--muted)">TCP-Listener</dt><dd style="margin:0">{{.ListenAddr}}</dd>
    {{if .WebsocketAddr}}<dt style="color:var(--muted)">WebSocket-Listener</dt><dd style="margin:0">{{.WebsocketAddr}}</dd>{{end}}
    {{if .TLSAddr}}<dt style="color:var(--muted)">TLS-Listener (mqtts)</dt><dd style="margin:0">{{.TLSAddr}}</dd>{{end}}
    <dt style="color:var(--muted)">Gestartet</dt><dd style="margin:0">{{.StartedAt}}</dd>
  </dl>
</div>

<div class="stats" style="margin-bottom:14px">
  <div class="stat s-blue">
    <div class="stat-label">Clients verbunden</div>
    <div class="stat-val" id="stat-clients">{{.ClientsConnected}}</div>
    <div class="stat-sub">Maximum <span id="stat-clients-max">{{.ClientsMaximum}}</span></div>
  </div>
  <div class="stat s-green">
    <div class="stat-label">Nachrichten empfangen</div>
    <div class="stat-val" id="stat-msg-recv">{{.MessagesReceived}}</div>
  </div>
  <div class="stat s-amber">
    <div class="stat-label">Nachrichten gesendet</div>
    <div class="stat-val" id="stat-msg-sent">{{.MessagesSent}}</div>
  </div>
  <div class="stat s-red">
    <div class="stat-label">Abonnements</div>
    <div class="stat-val" id="stat-subs">{{.Subscriptions}}</div>
    <div class="stat-sub"><span id="stat-bytes">{{.BytesReceived}}</span> B empfangen</div>
  </div>
</div>

<div class="card" style="overflow-x:auto">
  <div class="card-title">Aktivität (live) <span id="activity-live-indicator" style="font-size:10px;color:var(--muted)">verbinde …</span></div>
  <table style="border-collapse:collapse;width:100%;font-size:12px">
    <thead>
      <tr>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Zeit</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Ereignis</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Client</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Topic / Details</th>
      </tr>
    </thead>
    <tbody id="activity-log"></tbody>
  </table>
  <div id="activity-empty" style="font-size:12px;color:var(--muted);padding:10px 0">Noch keine Aktivität.</div>
</div>
{{end}}
{{end}}
{{end}}

{{define "scripts"}}
<style>
.mq-addr{word-break:break-all}
.mq-sub{font-size:11px;color:var(--muted)}
.mq-rows{display:grid;gap:8px}
.mq-row{display:grid;grid-template-columns:minmax(120px,190px) 1fr auto;gap:6px 12px;align-items:start;font-size:13px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg2)}
.mq-row .mq-label{color:var(--muted)}
.mq-row .mq-hint{grid-column:2/-1;font-size:11.5px;color:var(--muted);overflow-wrap:anywhere}
.mq-row .mq-state{overflow-wrap:anywhere}
.mq-msg{font-size:12px;margin-top:8px;overflow-wrap:anywhere}
@media (max-width:560px){.mq-row{grid-template-columns:1fr}.mq-row .mq-hint{grid-column:1}}
</style>
<script>
// Prüfliste: die Knöpfe rufen die vorhandenen Aktionen der Server-Einstellungen auf.
// Deren Antwort (die Karte des Reiters) wird nur nach einer Meldung durchsucht, danach lädt die Prüfliste neu.
async function mqttCheckPost(path, fields){
  const body = new URLSearchParams(fields);
  const res = await fetch(path, {method:'POST', headers: Object.assign({'Content-Type':'application/x-www-form-urlencoded'}, csrfHeaders()), body: body, credentials:'same-origin'});
  const text = await res.text();
  if(res.status === 403) return {err: 'Dafür fehlt dir das Recht.'};
  const doc = new DOMParser().parseFromString(text, 'text/html');
  const bad = doc.querySelector('.ti-alert-circle');
  if(bad && bad.parentElement) return {err: bad.parentElement.textContent.trim()};
  if(!res.ok) return {err: 'Fehler ' + res.status};
  const ok = doc.querySelector('.ti-check');
  return {msg: ok && ok.parentElement ? ok.parentElement.textContent.trim() : ''};
}
async function mqttCheckAct(btn){
  const d = btn.dataset, box = document.getElementById('mqtt-checklist');
  if(d.confirm && !confirm(d.confirm)) return;
  btn.disabled = true;
  let out = {};
  try{
    if(d.act === 'cert'){
      await mqttCheckPost('/admin/server-config/certs/add', {name: d.host}); // „schon eingetragen“ ist in Ordnung
      out = await mqttCheckPost('/admin/server-config/certs/issue', {name: d.host});
    } else if(d.act === 'lan'){
      out = await mqttCheckPost('/admin/server-config/certs/lan', {name: d.host});
    } else if(d.act === 'tunnel'){
      const f = {action:'save', hostname: d.host, old_hostname: d.host, service: d.service};
      if(d.notls === '1') f.no_tls_verify = 'on';
      if(d.replace === '1') f.replace_dns = 'on';
      out = await mqttCheckPost('/admin/server-config/cloudflare/tunnel', f);
    } else if(d.act === 'firewall'){
      out = await mqttCheckPost('/import/connections/' + encodeURIComponent(d.conn) + '/broker/firewall', {});
    }
  }catch(e){ out = {err: 'Der Server antwortet nicht.'}; }
  window.mqttCheckNote = out;
  if(window.htmx) htmx.trigger(box, 'mqtt-check');
}
document.body.addEventListener('htmx:afterSwap', function(ev){
  if(!ev.target || ev.target.id !== 'mqtt-checklist' || !window.mqttCheckNote) return;
  const n = window.mqttCheckNote; window.mqttCheckNote = null;
  const text = n.err || n.msg; if(!text) return;
  const el = document.createElement('div');
  el.className = 'mq-msg'; el.setAttribute('role', n.err ? 'alert' : 'status');
  el.style.color = n.err ? 'var(--red)' : 'var(--green)';
  el.textContent = text;
  ev.target.appendChild(el);
});
function copyValue(elementId){
  const el = document.getElementById(elementId);
  if(!el) return;
  const text = el.textContent || '';
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).catch(function(){});
  }
}

(function(){
  if(!{{if .Running}}true{{else}}false{{end}}) return;

  const recent = JSON.parse({{.RecentJSON}});
  const logBody = document.getElementById('activity-log');
  const emptyEl = document.getElementById('activity-empty');
  const liveIndicator = document.getElementById('activity-live-indicator');
  const MAX_ROWS = 300;
  let count = 0;

  const kindLabels = {connect: 'Verbunden', disconnect: 'Getrennt', subscribe: 'Abonniert', publish: 'Publiziert', error: 'Fehler'};

  function escapeHTML(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function addActivity(event){
    count++;
    emptyEl.hidden = true;
    const row = document.createElement('tr');
    const label = kindLabels[event.kind] || event.kind;
    row.innerHTML =
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);white-space:nowrap">' + escapeHTML(event.time) + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border)">' + escapeHTML(label) + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">' + escapeHTML(event.client_id || '') + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">' + escapeHTML(event.topic || event.detail || '') + '</td>';
    logBody.insertBefore(row, logBody.firstChild);
    while(logBody.children.length > MAX_ROWS) logBody.removeChild(logBody.lastChild);
  }

  recent.slice().reverse().forEach(addActivity);

  function updateStats(status){
    document.getElementById('stat-clients').textContent = status.clients_connected;
    document.getElementById('stat-clients-max').textContent = status.clients_maximum;
    document.getElementById('stat-msg-recv').textContent = status.messages_received;
    document.getElementById('stat-msg-sent').textContent = status.messages_sent;
    document.getElementById('stat-subs').textContent = status.subscriptions;
    document.getElementById('stat-bytes').textContent = status.bytes_received;
  }

  function markStopped(message){
    liveIndicator.textContent = message || 'getrennt';
    document.getElementById('info-status').innerHTML = '<span class="badge" style="background:var(--muted)">Gestoppt</span>';
  }

  const source = new EventSource('/import/connections/{{.ConnectionID}}/broker/stream');
  source.addEventListener('status', function(event){
    liveIndicator.textContent = 'live';
    updateStats(JSON.parse(event.data));
  });
  source.addEventListener('activity', function(event){
    addActivity(JSON.parse(event.data));
  });
  source.addEventListener('stopped', function(event){
    let message = 'gestoppt';
    try{ message = JSON.parse(event.data).message || message; }catch(e){}
    markStopped(message);
    source.close();
  });
  source.onerror = function(){
    if(source.readyState === EventSource.CLOSED) markStopped('Verbindung getrennt');
  };
  window.addEventListener('beforeunload', function(){ source.close(); });
})();
</script>
{{end}}
