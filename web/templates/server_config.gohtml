{{template "base" .}}
{{define "content"}}
<style>
.sc-msg{font-size:12px;padding:8px 12px;border-radius:8px;margin-bottom:12px}
.sc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px 16px}
.sc-f label{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;margin-bottom:4px}
.sc-f .help{font-size:11px;color:var(--muted);margin-top:3px}
.sc-src{font-size:10px;font-weight:500;border-radius:999px;padding:0 6px;border:1px solid var(--border);color:var(--muted)}
.sc-src.env{border-color:transparent;background:rgba(99,102,241,.15);color:#6366f1}
.sc-src.db{border-color:transparent;background:rgba(59,130,246,.15);color:var(--accent)}
.sc-src.file{border-color:transparent;background:rgba(16,185,129,.15);color:var(--green,#16a34a)}
.sc-restart{color:var(--amber,#f59e0b)}
.sc-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:14px;padding-top:12px;border-top:1px solid var(--border)}
.sc-sub{font-size:11px;color:var(--muted)}
.sc-steps{margin:0 0 10px 18px;font-size:13px;line-height:1.55}
.sc-steps li{margin-bottom:8px}
.sc-cmd{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:4px}
.sc-cmd code{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:4px 8px;font-size:12px;overflow-wrap:anywhere}
</style>

<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap">
  {{template "icon-button" (dict "Action" "back" "Href" "/core/settings")}}
  <div style="flex:1;min-width:220px">
    <h1 style="font-size:18px;font-weight:600">Server-Einstellungen</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">Gespeichert in der <b>Datenbank</b> (Geheimnisse verschlüsselt). Nur Datenbank-Zugang und Schlüssel stehen in <code>{{.EnvFile}}</code>.{{if .ImportedAt}} · {{.ImportedCount}} Wert(e) am {{.ImportedAt}} aus der <code>.env</code> übernommen.{{end}}</p>
  </div>
  {{if .CanRestart}}
  <form method="post" action="/admin/server-config/restart" onsubmit="return confirm('PDH jetzt neu starten? Alle Benutzer sind für einige Sekunden getrennt; laufende Eingaben gehen nicht verloren, wenn sie gespeichert sind.')">
    <button class="btn {{if .RestartPending}}btn-primary{{end}}" type="submit"><i class="ti ti-refresh"></i> Server neu starten</button>
  </form>
  {{end}}
</div>

{{if .Msg}}<div class="sc-msg" style="background:rgba(16,185,129,.12);color:var(--green)"><i class="ti ti-check"></i> {{.Msg}}</div>{{end}}
{{if .Err}}<div class="sc-msg" style="background:rgba(239,68,68,.12);color:var(--red)"><i class="ti ti-alert-circle"></i> {{.Err}}</div>{{end}}
{{if .RestartPending}}<div class="sc-msg" style="background:rgba(245,158,11,.12);color:var(--amber)"><i class="ti ti-refresh-alert"></i> Geändert, wirkt erst nach einem <b>Neustart</b>: {{range $i, $l := .RestartPending}}{{if $i}}, {{end}}{{$l}}{{end}}</div>{{end}}
{{if .PendingImport}}<div class="sc-msg" style="background:rgba(59,130,246,.12);color:var(--accent)"><i class="ti ti-database-import"></i> In der Einstellungsdatei stehen {{len .PendingImport}} Wert(e), die noch nicht in der Datenbank sind: <code>{{range $i, $k := .PendingImport}}{{if $i}}, {{end}}{{$k}}{{end}}</code>. Sie werden beim nächsten Start automatisch übernommen –
  <form method="post" action="/admin/server-config/import" style="display:inline;margin:0"><button class="btn btn-small" type="submit"><i class="ti ti-arrow-right"></i> jetzt übernehmen</button></form></div>{{end}}
{{if .Undecryptable}}<div class="sc-msg" style="background:rgba(239,68,68,.12);color:var(--red)"><i class="ti ti-key-off"></i> Nicht entschlüsselbar (anderer <code>PDH_SETTINGS_KEY</code>, z. B. nach Wiederherstellung auf einem anderen Server): <code>{{range $i, $k := .Undecryptable}}{{if $i}}, {{end}}{{$k}}{{end}}</code> – bitte neu eingeben.</div>{{end}}
{{if not .FileWritable}}<div class="sc-msg" style="background:rgba(239,68,68,.12);color:var(--red)"><i class="ti ti-lock"></i> Die Einstellungsdatei ist für den PDH-Dienst nicht beschreibbar – Änderungen können nicht gespeichert werden. Dateirechte prüfen (Eigentümer = Dienstbenutzer) oder <code>PDH_ENV_FILE</code> auf einen beschreibbaren Ort setzen.</div>{{end}}

<div class="rec-tabs" role="tablist">
  {{range .Groups}}<a class="rec-tab" data-tab="{{.Key}}" href="?tab={{.Key}}"><i class="ti {{.Icon}}"></i> {{.Label}}</a>{{end}}
  <a class="rec-tab" data-tab="branding" href="?tab=branding"><i class="ti ti-palette"></i> Erscheinungsbild</a>
  <a class="rec-tab" data-tab="passwords" href="?tab=passwords"><i class="ti ti-password"></i> Passwörter</a>
  {{if .CanLogs}}<a class="rec-tab" href="/admin/server-config/logs" style="margin-left:auto"><i class="ti ti-file-analytics"></i> Protokoll ansehen</a>{{end}}
</div>

{{range .Groups}}{{$g := .}}
<div class="rec-pane" data-pane="{{.Key}}">
<form class="card" method="post" action="/admin/server-config/save" id="sc-{{.Key}}" autocomplete="off">
  <input type="hidden" name="group" value="{{.Key}}">
  <div class="card-title"><span><i class="ti {{.Icon}}"></i> {{.Label}}</span><span class="sc-sub">{{.Intro}}</span></div>
  {{if .External}}<div class="sc-sub" style="margin-bottom:10px"><span class="sc-src env">Umgebung</span> {{.External}} Wert(e) kommen von außen (Docker <code>.env.docker</code>, systemd oder Shell) und haben Vorrang – sie lassen sich nur dort ändern.</div>{{end}}
  <div class="sc-grid">
  {{range .Fields}}
    <div class="sc-f">
      <label for="f-{{.Key}}">{{.Label}}
        {{if eq .Source "env"}}<span class="sc-src env" title="von außen gesetzt">Umgebung</span>{{else if eq .Source "db"}}<span class="sc-src db" title="in der Datenbank gespeichert">Datenbank</span>{{else if eq .Source "file"}}<span class="sc-src file" title="in der Einstellungsdatei">Datei</span>{{else}}<span class="sc-src" title="Standardwert">Standard</span>{{end}}
        {{if .Restart}}<i class="ti ti-refresh sc-restart" title="wirkt nach Neustart"></i>{{end}}
      </label>
      {{if .Secret}}
        <input class="form-input" id="f-{{.Key}}" type="password" name="{{.Key}}" autocomplete="new-password" {{if .ReadOnly}}disabled{{end}}
               placeholder="{{if .IsSet}}•••••••• gesetzt – leer lassen = unverändert{{else}}nicht gesetzt{{end}}">
        {{if and .IsSet (not .ReadOnly)}}<label style="font-weight:400;font-size:11px;margin-top:3px"><input type="checkbox" name="clear_{{.Key}}" value="1"> Wert entfernen</label>{{end}}
      {{else if eq .Type "select"}}
        <select class="form-input" id="f-{{.Key}}" name="{{.Key}}" {{if .ReadOnly}}disabled{{end}}>
          {{$v := .Value}}{{range .Options}}<option value="{{.}}" {{if eq . $v}}selected{{end}}>{{.}}</option>{{end}}
        </select>
      {{else if eq .Type "bool"}}
        <label style="font-weight:400"><input type="checkbox" id="f-{{.Key}}" name="{{.Key}}" value="true" {{if or (eq .Value "true") (eq .Value "1")}}checked{{end}} {{if .ReadOnly}}disabled{{end}}> aktiv</label>
      {{else}}
        <input class="form-input" id="f-{{.Key}}" name="{{.Key}}" value="{{.Value}}" {{if eq .Type "number"}}inputmode="numeric"{{end}} {{if .ReadOnly}}disabled{{end}} placeholder="{{.Default}}">
      {{end}}
      <div class="help"><code>{{.Key}}</code>{{if .Help}} – {{.Help}}{{end}}</div>
    </div>
  {{end}}
  </div>
  <div class="sc-actions">
    <button class="btn btn-primary" type="submit" {{if not $.FileWritable}}disabled{{end}}><i class="ti ti-device-floppy"></i> Speichern</button>
    {{if eq .Key "database"}}
      <button class="btn" type="button" hx-post="/admin/server-config/test?what=database" hx-include="#sc-database" hx-target="#test-database"><i class="ti ti-plug-connected"></i> Verbindung testen</button>
      <label class="sc-sub"><input type="checkbox" name="force" value="1"> Trotzdem speichern, auch wenn der Test fehlschlägt</label>
      <span id="test-database" class="sc-sub"></span>
    {{end}}
    {{if eq .Key "copilot"}}
      <button class="btn" type="button" hx-post="/admin/server-config/test?what=copilot" hx-target="#test-copilot"><i class="ti ti-plug-connected"></i> Verbindung testen</button>
      <span id="test-copilot" class="sc-sub" style="width:100%"></span>
    {{end}}
    {{if eq .Key "cloudflare"}}
      <button class="btn" type="button" hx-post="/admin/server-config/test?what=cloudflared" hx-target="#test-cloudflared"><i class="ti ti-plug-connected"></i> Tunnel prüfen</button>
      <span id="test-cloudflared" class="sc-sub" style="width:100%"></span>
    {{end}}
    {{if eq .Key "mail"}}
      <button class="btn" type="button" hx-post="/admin/server-config/test?what=mail" hx-target="#test-mail"><i class="ti ti-send"></i> Testmail an mich</button>
      <span id="test-mail" class="sc-sub"></span>
    {{end}}
    {{if eq .Key "security"}}
      <label class="sc-sub"><input type="checkbox" name="new_jwt" value="1" onchange="if(this.checked&&!confirm('Neuen Anmelde-Schlüssel erzeugen? Nach dem Neustart müssen sich alle neu anmelden.'))this.checked=false"> Neuen Anmelde-Schlüssel erzeugen</label>
    {{end}}
  </div>
</form>
{{if and (eq .Key "cloudflare") $.CF}}{{template "sc-cloudflare" $.CF}}{{end}}
</div>
{{end}}

<!-- ── Passwoerter: Richtlinie und Wechselzwang (password_policy.go) ── -->
<div class="rec-pane" data-pane="passwords">
{{with .Policy}}
<form class="card" method="post" action="/admin/server-config/password-policy" autocomplete="off">
  <div class="card-title"><span><i class="ti ti-password"></i> Passwort-Richtlinie</span><span class="sc-sub">gilt sofort für jedes neue Passwort – Anmeldeseite, „Passwort vergessen“, Mein Konto und Benutzerstamm</span></div>
  <div class="sc-grid">
    <div class="sc-f"><label for="pp-min">Mindestlänge</label><input class="form-input" id="pp-min" type="number" name="min_length" min="8" max="72" value="{{.MinLength}}"><div class="help">8 bis 72 Zeichen</div></div>
    <div class="sc-f"><label for="pp-age">Höchstalter (Tage)</label><input class="form-input" id="pp-age" type="number" name="max_age_days" min="0" max="3650" value="{{.MaxAgeDays}}"><div class="help">danach muss das Passwort bei der Anmeldung geändert werden; 0 = läuft nie ab</div></div>
    <div class="sc-f"><label for="pp-hist">Wiederverwendung sperren</label><input class="form-input" id="pp-hist" type="number" name="history" min="0" max="24" value="{{.History}}"><div class="help">die letzten N Passwörter sind gesperrt; 0 = aus</div></div>
  </div>
  <div class="sc-f" style="margin-top:12px"><label>Das Passwort braucht</label>
    <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:13px">
      <label style="font-weight:400"><input type="checkbox" name="require_upper" {{if .RequireUpper}}checked{{end}}> Großbuchstaben</label>
      <label style="font-weight:400"><input type="checkbox" name="require_lower" {{if .RequireLower}}checked{{end}}> Kleinbuchstaben</label>
      <label style="font-weight:400"><input type="checkbox" name="require_digit" {{if .RequireDigit}}checked{{end}}> Ziffer</label>
      <label style="font-weight:400"><input type="checkbox" name="require_special" {{if .RequireSpecial}}checked{{end}}> Sonderzeichen</label>
    </div></div>
  <div class="sc-f" style="margin-top:12px"><label>Passwort ändern müssen</label>
    <div style="display:grid;gap:6px;font-size:13px">
      <label style="font-weight:400"><input type="checkbox" name="change_on_first_login" {{if .ChangeOnFirstLogin}}checked{{end}}> bei der <b>Erstanmeldung</b> – wenn ein Administrator das Konto mit Passwort anlegt</label>
      <label style="font-weight:400"><input type="checkbox" name="change_after_admin_reset" {{if .ChangeAfterAdminReset}}checked{{end}}> nachdem ein <b>Administrator das Passwort</b> im Benutzerstamm geändert hat</label>
      <label style="font-weight:400;color:var(--amber)"><input type="checkbox" name="expire_all"> jetzt <b>alle</b> Benutzer mit Passwort beim nächsten Anmelden zum Wechsel zwingen (einmalig)</label>
    </div>
    <div class="help">Gilt für die Anmeldung mit Passwort. Karte, Microsoft und Nextcloud brauchen kein Passwort; Systemnutzer (Terminals) sind ausgenommen.</div></div>
  <div style="display:flex;gap:10px;align-items:center;margin-top:14px;flex-wrap:wrap">
    <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    <span class="sc-sub">{{if $.PasswordPending}}{{$.PasswordPending}} Benutzer müssen ihr Passwort bei der nächsten Anmeldung ändern.{{else}}Zurzeit muss niemand sein Passwort ändern.{{end}}</span>
  </div>
</form>
{{end}}
</div>

<!-- ── Erscheinungsbild (Logos) ── -->
<div class="rec-pane" data-pane="branding">
<style>
.br-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.br-slot{border:1px solid var(--border);border-radius:10px;padding:12px}
.br-prev{height:90px;border-radius:8px;background:repeating-conic-gradient(var(--bg3) 0 25%,transparent 0 50%) 0 0/16px 16px;display:flex;align-items:center;justify-content:center;margin:8px 0}
.br-prev img{max-height:76px;max-width:90%;object-fit:contain}
.br-prev .none{font-size:12px;color:var(--muted)}
.th-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px;margin-bottom:12px}
.th-opt{display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:10px;padding:8px 10px;cursor:pointer;font-size:13px;font-weight:400!important;margin:0!important}
.th-opt:has(input:checked){border-color:var(--accent);background:rgba(var(--accent-rgb),.08)}
.th-opt input[type=radio]{accent-color:var(--accent)}
.th-sw{width:26px;height:26px;border-radius:50%;flex-shrink:0;border:1px solid var(--border)}
.th-opt small{display:block;font-size:10.5px;color:var(--muted)}
.th-opt input[type=color]{width:30px;height:26px;border:0;background:none;padding:0;cursor:pointer}
.th-demo{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px;border:1px dashed var(--border);border-radius:10px;margin-bottom:12px;font-size:12px;color:var(--muted)}
.th-list{display:grid;gap:6px;margin-top:12px}
.th-row{display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:13px}
.th-row .grow{flex:1}
.th-fam{border:1px solid var(--border);border-radius:10px;padding:8px 12px;margin-top:8px}
.th-fam summary{cursor:pointer;font-size:13px;padding:2px 0}
.th-fam summary a{color:var(--accent)}
.th-gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin:10px 0 4px}
.th-gitem{border:1px solid var(--border);border-radius:10px;padding:8px;display:flex;flex-direction:column;gap:6px;font-size:12.5px}
.th-gitem .acts{display:flex;gap:6px;flex-wrap:wrap}
.th-prev{display:flex;height:46px;border-radius:8px;overflow:hidden;border:1px solid var(--border)}
.th-prev span{flex:1;position:relative;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600}
.th-prev .d{background:var(--db);color:var(--dt)}.th-prev .l{background:var(--lb);color:var(--lt)}
.th-prev span::before{content:"";position:absolute;inset:8px 10px 8px 10px;border-radius:5px}
.th-prev .d::before{background:var(--dc);border-left:4px solid var(--da)}.th-prev .l::before{background:var(--lc);border-left:4px solid var(--la)}
.th-prev b{position:relative}
</style>
<div class="card" style="margin-bottom:14px">
  <div class="card-title"><span><i class="ti ti-color-swatch"></i> Farbschema &amp; Schrift</span><span class="sc-sub">Firmenstandard für alle – jeder kann im Benutzermenü abweichen; Hell/Dunkel stellt jeder selbst ein</span></div>
  <form method="post" action="/admin/branding/theme" id="th-form">
    <div class="th-grid">
      {{range .Brand.Palettes}}{{if ne .ID "eigen"}}
      <label class="th-opt"><input type="radio" name="theme" value="{{.ID}}" {{if eq .ID $.Brand.ThemeID}}checked{{end}}><span class="th-sw" style="background:{{.Swatch}}"></span><span>{{.Name}}{{if eq .Source "ha"}}<small>aus Home Assistant</small>{{end}}</span></label>
      {{end}}{{end}}
      <label class="th-opt"><input type="radio" name="theme" value="eigen" {{if eq .Brand.ThemeID "eigen"}}checked{{end}}><input type="color" name="theme_color" id="th-color" value="{{or .Brand.ThemeColor "#0a7cc1"}}" title="Firmenfarbe wählen"><span>Firmenfarbe<small>wird für Hell und Dunkel lesbar angepasst</small></span></label>
    </div>
    <div class="th-demo"><span>Vorschau:</span><button type="button" class="btn btn-primary btn-small"><i class="ti ti-check"></i> Schaltfläche</button><span class="badge" style="background:rgba(var(--accent-rgb),.15);color:var(--accent)">Hervorhebung</span><a style="color:var(--accent)">Verknüpfung</a><span>– wirkt sofort auf dieser Seite, gespeichert wird erst mit „Speichern“.</span></div>
    <div class="sc-grid" style="margin-bottom:10px">
      <div class="sc-f"><label>Schriftart</label>
        <select class="form-input" name="font" id="th-font">{{range .Brand.Fonts}}<option value="{{.ID}}" {{if eq .ID $.Brand.FontID}}selected{{end}}>{{.Name}}</option>{{end}}</select>
        <div class="help">Webschriften werden von Google Fonts geladen; „System“ und „Verdana“ nutzen die Schrift des Geräts.</div></div>
      <div class="sc-f"><label>Größe</label>
        <select class="form-input" name="scale" id="th-scale">{{range .Brand.ScaleSteps}}<option value="{{.}}" {{if eq . $.Brand.ScaleValue}}selected{{end}}>{{.}} %{{if eq . 100}} (normal){{end}}</option>{{end}}</select>
        <div class="help">vergrößert oder verkleinert die ganze Oberfläche – z. B. 120 % für Terminals in der Halle</div></div>
    </div>
    <label style="font-weight:400;font-size:13px"><input type="checkbox" name="theme_user" value="1" {{if .Brand.ThemeUserChoice}}checked{{end}}> Benutzer dürfen im Benutzermenü ein eigenes Farbschema und eine eigene Schrift wählen <span class="sc-sub">(die Größe darf jeder anpassen)</span></label>
    <div class="sc-actions"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
  </form>
</div>
{{with .Brand.Timeline.Safe}}
<style>
.tl-form .tl-colors{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin-bottom:12px}
.tl-form .tl-colors label{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:10px;font-size:13px;font-weight:400}
.tl-form .tl-colors input[type=color]{width:38px;height:30px;border:0;background:none;padding:0;cursor:pointer}
.tl-form .tl-colors small{display:block;color:var(--muted);font-size:11px}
.tl-form output{font-weight:600;margin-left:6px}
.tl-prev{border:1px solid var(--border);border-radius:10px;padding:8px 10px;margin:4px 0 12px;background:var(--bg3)}
.tl-prev svg{width:100%;display:block}
.tl-prev text{fill:var(--text);font-size:11px}
</style>
<div class="card tl-form" style="margin-bottom:14px">
  <div class="card-title"><span><i class="ti ti-timeline"></i> Zeitstrahl</span><span class="sc-sub">Rand der Balken je Zustand – Dashboard, Leitstand und Projekte</span></div>
  <form method="post" action="/admin/branding/timeline" id="tl-form">
    <div class="tl-colors">
      {{$s := .}}{{range .States}}
      <label><input type="color" name="{{.Key}}" value="{{$s.Color .Key}}" data-tl="{{.Key}}"><span>{{.Label}}<small>{{.Hint}}</small></span></label>
      {{end}}
      <label><input type="color" name="done_fill" value="{{.DoneFill}}" data-tl="done-fill"><span>Beendet – Balken<small>Farbe zum Ausgrauen</small></span></label>
    </div>
    <div class="sc-grid" style="margin-bottom:6px">
      <div class="sc-f"><label>Randstärke <output id="tl-w-out">{{.WidthStr}} px</output></label>
        <input type="range" name="width" min="0.5" max="6" step="0.5" value="{{.WidthStr}}" id="tl-w" style="width:100%"></div>
      <div class="sc-f"><label>Randhelligkeit <output id="tl-b-out">{{.Brightness}} %</output></label>
        <input type="range" name="brightness" min="-50" max="50" step="5" value="{{.Brightness}}" id="tl-b" style="width:100%">
        <div class="help">minus = dunkler, plus = heller</div></div>
      <div class="sc-f"><label>Balkenhöhe <output id="tl-h-out">{{.BarHeight}} px</output></label>
        <input type="range" name="bar_height" min="12" max="48" step="2" value="{{.BarHeight}}" id="tl-h" style="width:100%"></div>
      <div class="sc-f"><label>„Fällig“ ab</label>
        <select class="form-input" name="due_days">{{$d := .DueDays}}{{range $i := .DueDayOptions}}<option value="{{$i}}" {{if eq $i $d}}selected{{end}}>{{if eq $i 0}}am Termin selbst{{else if eq $i 1}}1 Tag vorher (heute und morgen){{else}}{{$i}} Tage vorher{{end}}</option>{{end}}</select>
        <div class="help">ab wann ein Vorgang rot umrandet wird; danach blinkt er als überfällig</div></div>
    </div>
    <div class="tl-prev" id="tl-prev"><svg class="gantt" id="tl-prev-svg" viewBox="0 0 520 210" preserveAspectRatio="xMinYMin meet"></svg></div>
    <div class="sc-actions">
      <button class="btn" type="submit" name="reset" value="1" onclick="return confirm('Zeitstrahl-Darstellung auf Standard zurücksetzen?')"><i class="ti ti-restore"></i> Standard</button>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </form>
</div>
<script>
// Live-Vorschau der Zeitstrahl-Raender (nur diese Seite, bis gespeichert)
(function(){
  const form = document.getElementById('tl-form'); if(!form) return;
  const svg = document.getElementById('tl-prev-svg'), box = document.getElementById('tl-prev');
  const rows = [['running', 'Laufend', '#4b9fc4'], ['due', 'Fällig', '#3fae86'], ['overdue', 'Überfällig', '#c99a3c'],
    ['unassigned', 'Nicht zugewiesen', '#9d7fc9'], ['done', 'Beendet', '#4b9fc4'], ['', 'Ohne Zustand', '#3fae86']];
  const mix = (hex, to, t) => {
    const a = parseInt(hex.slice(1), 16), b = parseInt(to.slice(1), 16);
    const c = [16, 8, 0].map(s => Math.round(((a >> s) & 255) * (1 - t) + ((b >> s) & 255) * t));
    return '#' + c.map(v => v.toString(16).padStart(2, '0')).join('');
  };
  function draw(){
    const w = form.width.value, b = +form.brightness.value, h = +form.bar_height.value;
    document.getElementById('tl-w-out').textContent = w + ' px';
    document.getElementById('tl-b-out').textContent = b + ' %';
    document.getElementById('tl-h-out').textContent = h + ' px';
    box.style.setProperty('--tl-w', w + 'px');
    form.querySelectorAll('[data-tl]').forEach(i => {
      const k = i.dataset.tl;
      const v = k === 'done-fill' ? i.value : (b > 0 ? mix(i.value, '#ffffff', b / 100) : b < 0 ? mix(i.value, '#000000', -b / 100) : i.value);
      box.style.setProperty('--tl-' + k, v);
    });
    const gap = h + 12;
    svg.setAttribute('viewBox', '0 0 520 ' + (rows.length * gap + 8));
    svg.innerHTML = rows.map((r, i) => {
      const y = 6 + i * gap;
      return '<g class="bar-wrapper' + (r[0] ? ' tl-' + r[0] : '') + '"><g class="bar-group"><rect class="bar" x="150" y="' + y + '" width="' + (190 + (i % 3) * 50) + '" height="' + h + '" rx="3" style="fill:' + r[2] + ';stroke:' + r[2] + '"></rect></g></g>'
        + '<text x="0" y="' + (y + h / 2 + 4) + '">' + r[1] + '</text>';
    }).join('');
  }
  form.addEventListener('input', draw);
  draw();
})();
</script>
{{end}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title"><span><i class="ti ti-home"></i> Theme aus Home Assistant übernehmen</span><span class="sc-sub">z. B. Nordic, Caule, iOS Dark Mode, Metro</span></div>
  <p class="sc-sub" style="margin-bottom:10px">Theme-Datei aus dem Home-Assistant-Ordner <code>themes/</code> hochladen oder ihren Inhalt einfügen. Übernommen werden Akzent-, Hintergrund-, Karten-, Text-, Rahmen- und Statusfarben – getrennt für Hell und Dunkel, wenn das Theme <code>modes: light/dark</code> hat. Schriften, Rundungen und card-mod werden ignoriert. Eine Datei mit mehreren Themes ergibt mehrere Farbschemata.</p>
  <form method="post" action="/admin/branding/ha-import" enctype="multipart/form-data">
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
      <input type="file" name="file" accept=".yaml,.yml,text/yaml" style="font-size:12px;max-width:100%">
      <span class="sc-sub">oder einfügen:</span>
    </div>
    <textarea class="form-input" name="yaml" rows="6" style="width:100%;font-family:monospace;font-size:12px" placeholder='Nordic Dark:&#10;  accent-color: "#8fbcbb"&#10;  primary-color: "var(--accent-color)"&#10;  primary-background-color: "#2e3440"&#10;  card-background-color: "#3b4252"&#10;  primary-text-color: "#eceff4"'></textarea>
    <div class="sc-actions"><button class="btn btn-primary" type="submit"><i class="ti ti-file-import"></i> Übernehmen</button></div>
  </form>
  {{with .Brand.ImportedThemes}}<div class="th-list">
    {{range .}}<div class="th-row"><span class="th-sw" style="background:{{.Swatch}}"></span><span class="grow">{{.Name}}{{if eq .ID $.Brand.ThemeID}} <span class="badge b-green">Firmenstandard</span>{{end}}</span>
      <form method="post" action="/admin/branding/ha/{{.ID}}/delete" onsubmit="return confirm('Theme „{{.Name}}“ entfernen?')"><button class="btn btn-small" type="submit"><i class="ti ti-trash"></i> Entfernen</button></form></div>{{end}}
  </div>{{end}}
</div>
<div class="card" style="margin-bottom:14px">
  <div class="card-title"><span><i class="ti ti-layout-grid"></i> Theme-Galerie aus Home Assistant</span><span class="sc-sub">{{.Brand.GalleryCount}} bekannte Community-Themes, Farben schon ausgelesen</span></div>
  <p class="sc-sub" style="margin-bottom:6px">Ohne Datei-Upload: <b>Übernehmen</b> legt das Theme oben bei den Farbschemata ab, <b>Als Standard</b> setzt es zusätzlich gleich für alle. Kachel links = Dunkel, rechts = Hell.</p>
  {{range .Brand.Gallery}}{{$imp := .Imported}}
  <details class="th-fam">
    <summary><b>{{.Name}}</b> · {{len .Themes}} Themes · von <a href="{{.URL}}" target="_blank" rel="noopener">{{.Author}}</a></summary>
    <div class="th-gal">{{range .Themes}}
      <div class="th-gitem">
        <div class="th-prev" style="{{.Preview}}"><span class="d"><b>Aa</b></span><span class="l"><b>Aa</b></span></div>
        <div>{{.Name}}{{if index $imp .ID}} <span class="badge b-green">übernommen</span>{{end}}</div>
        <div class="acts">
          {{if not (index $imp .ID)}}<form method="post" action="/admin/branding/gallery/{{.ID}}"><button class="btn btn-small" type="submit"><i class="ti ti-download"></i> Übernehmen</button></form>{{end}}
          <form method="post" action="/admin/branding/gallery/{{.ID}}"><input type="hidden" name="default" value="1"><button class="btn btn-small btn-primary" type="submit"><i class="ti ti-star"></i> Als Standard</button></form>
        </div>
      </div>{{end}}
    </div>
  </details>{{end}}
</div>
<script>
// Live-Vorschau des gewaehlten Farbschemas (nur diese Seite, bis gespeichert)
(function(){
  const form = document.getElementById('th-form'); if(!form) return;
  const color = document.getElementById('th-color');
  const root = document.documentElement;
  const props = ['--accent','--accent2','--accent-rgb'];
  function preview(){
    const sel = form.querySelector('input[name=theme]:checked'); if(!sel) return;
    props.forEach(p => root.style.removeProperty(p));
    if(sel.value === 'eigen'){
      const v = color.value, n = parseInt(v.slice(1), 16);
      root.style.setProperty('--accent', v); root.style.setProperty('--accent2', v);
      root.style.setProperty('--accent-rgb', [(n>>16)&255,(n>>8)&255,n&255].join(','));
    } else root.dataset.palette = sel.value;
  }
  form.addEventListener('change', preview);
  // Schrift und Groesse zur Probe (PDH_FONTS aus dem Seitenkopf)
  const fontSel = document.getElementById('th-font'), scaleSel = document.getElementById('th-scale');
  function previewText(){
    const f = (typeof PDH_FONTS !== 'undefined') && PDH_FONTS[fontSel.value];
    if(f){
      root.style.setProperty('--font', f[0]);
      if(f[1]){ let l = document.getElementById('pdh-font'); if(!l){ l = document.createElement('link'); l.rel = 'stylesheet'; l.id = 'pdh-font'; document.head.appendChild(l); } l.href = f[1]; }
    }
    root.style.setProperty('--ui-scale', (parseInt(scaleSel.value, 10) / 100).toFixed(2));
  }
  fontSel.addEventListener('change', previewText);
  scaleSel.addEventListener('change', previewText);
  color.addEventListener('input', () => { form.querySelector('input[value=eigen]').checked = true; preview(); });
  // Firmenfarbe nur mitsenden, wenn sie gewaehlt ist
  form.addEventListener('submit', () => { const sel = form.querySelector('input[name=theme]:checked'); color.disabled = !sel || sel.value !== 'eigen'; });
  preview();
})();
</script>
<div class="card">
  <div class="card-title"><span><i class="ti ti-palette"></i> Erscheinungsbild</span><span class="sc-sub">Name und Logos für App, Exporte und Druck</span></div>
  <form method="post" action="/admin/branding/settings" style="margin-bottom:14px">
    <div class="sc-grid">
      <div class="sc-f"><label>Anzeigename</label><input class="form-input" name="app_name" maxlength="40" value="{{or .Brand.AppName "PDH"}}"><div class="help">erscheint in der Seitenleiste, auf der Anmeldeseite, im Browser-Tab und auf Ausdrucken</div></div>
      <div class="sc-f"><label>Optionen</label>
        <label style="font-weight:400"><input type="checkbox" name="export_same" value="1" {{if .Brand.ExportSame}}checked{{end}}> Exporte verwenden das App-Logo</label>
        <label style="font-weight:400"><input type="checkbox" name="print_same" value="1" {{if .Brand.PrintSame}}checked{{end}}> Druck verwendet das App-Logo</label>
        <label style="font-weight:400"><input type="checkbox" name="label_logo" value="1" {{if .Brand.LabelLogo}}checked{{end}}> Logo auch auf Lagerplatz-Etiketten (nicht bei Mini-Formaten)</label>
      </div>
    </div>
    <div class="sc-actions"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
  </form>
  <div class="br-grid">
    {{template "br-slot" (dict "Slot" "app" "Title" "App-Logo" "Help" "Seitenleiste, Anmeldung, Browser-Symbol. Am besten quadratisch, z. B. 256×256 px." "URL" .Brand.AppLogo "Same" false)}}
    {{template "br-slot" (dict "Slot" "export" "Title" "Logo für Exporte" "Help" "PDF-Exporte (oben rechts) und Excel-Exporte (neben der Tabelle). Querformat eignet sich gut." "URL" .Brand.ExportLogo "Same" .Brand.ExportSame)}}
    {{template "br-slot" (dict "Slot" "print" "Title" "Logo für Druck" "Help" "Kopfzeile jeder gedruckten Seite, Bestellvorschlag-E-Mail, optional Etiketten. Für Schwarzweißdruck kontrastreich wählen." "URL" .Brand.PrintLogo "Same" .Brand.PrintSame)}}
  </div>
  <div class="sc-sub" style="margin-top:10px">PNG, JPG oder GIF, höchstens 2 MB. SVG wird aus Sicherheitsgründen nicht angenommen. Transparenter Hintergrund (PNG) sieht in hellem und dunklem Design am besten aus.</div>
</div>
</div>
{{end}}

{{define "sc-cloudflare"}}
<div class="card" style="margin-top:12px">
  <div class="card-title"><span><i class="ti ti-list-numbers"></i> Anleitung: Tunnel einrichten</span><span class="sc-sub">einmalig, ca. 10 Minuten</span></div>
  <ol class="sc-steps">
    <li>Im <a href="https://one.dash.cloudflare.com/" target="_blank" rel="noopener">Cloudflare-Zero-Trust-Dashboard</a> → <b>Networks → Tunnels → Create a tunnel</b> → <b>Cloudflared</b> wählen, Name z. B. <code>PDH</code>.</li>
    <li>Auf der nächsten Seite steht ein Installationsbefehl mit einem langen Token (beginnt mit <code>eyJ</code>). Den Befehl oder nur den Token kopieren, oben bei <b>Tunnel-Token</b> einfügen und <b>Speichern</b>. Den Befehl dort <b>nicht</b> ausführen – das erledigt das Skript.</li>
    <li>Im Dashboard weiter zu <b>Public Hostname</b>: Subdomain und Domain wählen (z. B. <code>pdh</code> · <code>firma.de</code>), <b>Service Type</b> <code>{{.OriginScheme}}</code>, <b>URL</b> <code>{{.OriginAddr}}</code>. Speichern. Den Hostnamen oben bei <b>Öffentlicher Hostname</b> eintragen.</li>
    <li>Installationsskript herunterladen und auf den Server kopieren, auf dem das PDH läuft (bei Docker: auf den Host):
      <div class="sc-actions" style="border:0;margin-top:6px;padding-top:0">
        {{if .TokenSet}}
        <a class="btn btn-primary" href="/admin/server-config/cloudflared/script?os=linux"><i class="ti ti-brand-ubuntu"></i> Skript für Linux</a>
        <a class="btn" href="/admin/server-config/cloudflared/script?os=windows"><i class="ti ti-brand-windows"></i> Skript für Windows</a>
        {{else}}
        <span class="sc-sub" style="color:var(--amber)"><i class="ti ti-alert-triangle"></i> Erst den Tunnel-Token speichern – dann gibt es hier die Skripte.</span>
        {{end}}
      </div>
    </li>
    <li>Skript ausführen:
      <div class="sc-cmd"><code>sudo bash pdh-cloudflared.sh</code><button type="button" class="btn btn-small" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)" title="Kopieren"><i class="ti ti-copy"></i></button></div>
      <div class="sc-sub" style="margin:4px 0">Windows: PowerShell <b>als Administrator</b> öffnen:</div>
      <div class="sc-cmd"><code>powershell -ExecutionPolicy Bypass -File .\pdh-cloudflared.ps1</code><button type="button" class="btn btn-small" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)" title="Kopieren"><i class="ti ti-copy"></i></button></div>
      <div class="sc-sub" style="margin-top:4px">Das Skript installiert <code>cloudflared</code>, richtet den Tunnel als Dienst ein (startet automatisch mit dem Server), ersetzt einen vorhandenen Tunnel-Dienst und prüft, ob das PDH erreichbar ist. Es enthält den Token – danach löschen.</div>
    </li>
    <li>Im Reiter <b>Server</b> die <b>Öffentliche Adresse</b> auf <code>https://{{or .Host "pdh.firma.de"}}</code> setzen{{if and .Host .PublicURLDifferent}} <span style="color:var(--amber)"><i class="ti ti-alert-triangle"></i> steht noch anders</span>{{end}}. Dann oben <b>Tunnel prüfen</b>.</li>
  </ol>
  <div class="sc-sub"><i class="ti ti-shield-lock"></i> Tipp: Mit <b>Cloudflare Access</b> (Zero Trust → Access → Applications) lässt sich vor das PDH zusätzlich eine Anmeldung schalten, z. B. nur Firmen-E-Mail-Adressen. Terminals und Etiketten-Links brauchen dann eine Ausnahme.</div>
</div>
{{end}}

{{define "br-slot"}}
<div class="br-slot">
  <b style="font-size:13px">{{.Title}}</b>
  <div class="br-prev">{{if .URL}}<img src="{{.URL}}" alt="{{.Title}}">{{else}}<span class="none">kein Logo – es wird „P“ bzw. nur der Name gezeigt</span>{{end}}</div>
  {{if .Same}}<div class="sc-sub" style="margin-bottom:6px"><i class="ti ti-link"></i> wie App-Logo – eigenes Logo hochladen hebt das auf</div>{{end}}
  <div class="sc-sub" style="margin-bottom:8px">{{.Help}}</div>
  <form method="post" action="/admin/branding/{{.Slot}}/upload" enctype="multipart/form-data" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
    <input type="file" name="logo" accept="image/png,image/jpeg,image/gif" required style="font-size:12px;max-width:100%">
    <button class="btn btn-small btn-primary" type="submit"><i class="ti ti-upload"></i> Hochladen</button>
  </form>
  {{if and .URL (not .Same)}}<form method="post" action="/admin/branding/{{.Slot}}/delete" style="margin-top:6px" onsubmit="return confirm('Logo entfernen?')"><button class="btn btn-small" type="submit"><i class="ti ti-trash"></i> Entfernen</button></form>{{end}}
</div>
{{end}}
