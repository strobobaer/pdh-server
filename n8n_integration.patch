diff --git a/internal/core/integrations/integrations.go b/internal/core/integrations/integrations.go
new file mode 100644
index 0000000..d31c28d
--- /dev/null
+++ b/internal/core/integrations/integrations.go
@@ -0,0 +1,319 @@
+// Package integrations stellt die generische Infrastruktur für externe
+// Systeme (z.B. n8n) bereit:
+//   - API-Schlüssel für eingehende Aufrufe (n8n -> PDH, per X-API-Key-Header)
+//   - Webhooks für ausgehende Ereignisse (PDH -> n8n, signiert per HMAC)
+//
+// Ist bewusst nicht an ein einzelnes Modul gebunden - jede Stelle im Code
+// kann Dispatch() aufrufen, um ein Ereignis an alle passenden Webhooks zu
+// senden.
+package integrations
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/rs/zerolog/log"
+)
+
+type APIKey struct {
+	ID         string     `json:"id"`
+	Name       string     `json:"name"`
+	KeyPrefix  string     `json:"key_prefix"`
+	Active     bool       `json:"active"`
+	CreatedBy  *string    `json:"created_by,omitempty"`
+	LastUsedAt *time.Time `json:"last_used_at,omitempty"`
+	CreatedAt  time.Time  `json:"created_at"`
+}
+
+type Webhook struct {
+	ID              string     `json:"id"`
+	Name            string     `json:"name"`
+	TargetURL       string     `json:"target_url"`
+	Secret          string     `json:"secret,omitempty"`
+	Events          []string   `json:"events"`
+	Active          bool       `json:"active"`
+	CreatedBy       *string    `json:"created_by,omitempty"`
+	LastTriggeredAt *time.Time `json:"last_triggered_at,omitempty"`
+	LastStatus      string     `json:"last_status,omitempty"`
+	LastError       string     `json:"last_error,omitempty"`
+	CreatedAt       time.Time  `json:"created_at"`
+}
+
+// Bekannte Ereignis-Schlüssel, an die sich Webhooks abonnieren können.
+// Nicht abschliessend - siehe README-Hinweis im Patch dazu, an welchen
+// Stellen Dispatch() aktuell aufgerufen wird.
+const (
+	EventProductionRecorded = "production.recorded"
+	EventFaultCreated       = "fault.created"
+)
+
+// ── Repository ────────────────────────────────────────────────
+
+type Repository struct{ db *pgxpool.Pool }
+
+func NewRepository(db *pgxpool.Pool) *Repository { return &Repository{db: db} }
+
+func (r *Repository) CreateAPIKey(ctx context.Context, name, keyHash, keyPrefix string, createdBy *string) (*APIKey, error) {
+	k := &APIKey{}
+	err := r.db.QueryRow(ctx, `
+		INSERT INTO integration_api_keys (name, key_hash, key_prefix, created_by)
+		VALUES ($1,$2,$3,$4)
+		RETURNING id, name, key_prefix, active, created_by, last_used_at, created_at`,
+		name, keyHash, keyPrefix, createdBy,
+	).Scan(&k.ID, &k.Name, &k.KeyPrefix, &k.Active, &k.CreatedBy, &k.LastUsedAt, &k.CreatedAt)
+	return k, err
+}
+
+func (r *Repository) ListAPIKeys(ctx context.Context) ([]*APIKey, error) {
+	rows, err := r.db.Query(ctx, `SELECT id, name, key_prefix, active, created_by, last_used_at, created_at
+		FROM integration_api_keys ORDER BY created_at DESC`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var keys []*APIKey
+	for rows.Next() {
+		k := &APIKey{}
+		if err := rows.Scan(&k.ID, &k.Name, &k.KeyPrefix, &k.Active, &k.CreatedBy, &k.LastUsedAt, &k.CreatedAt); err != nil {
+			return nil, err
+		}
+		keys = append(keys, k)
+	}
+	return keys, nil
+}
+
+func (r *Repository) RevokeAPIKey(ctx context.Context, id string) error {
+	_, err := r.db.Exec(ctx, `UPDATE integration_api_keys SET active=false WHERE id=$1`, id)
+	return err
+}
+
+func (r *Repository) FindActiveAPIKeyByHash(ctx context.Context, hash string) (*APIKey, error) {
+	k := &APIKey{}
+	err := r.db.QueryRow(ctx, `SELECT id, name, key_prefix, active, created_by, last_used_at, created_at
+		FROM integration_api_keys WHERE key_hash=$1 AND active=true`, hash,
+	).Scan(&k.ID, &k.Name, &k.KeyPrefix, &k.Active, &k.CreatedBy, &k.LastUsedAt, &k.CreatedAt)
+	return k, err
+}
+
+func (r *Repository) TouchAPIKey(ctx context.Context, id string) {
+	r.db.Exec(ctx, `UPDATE integration_api_keys SET last_used_at=NOW() WHERE id=$1`, id)
+}
+
+func (r *Repository) CreateWebhook(ctx context.Context, name, targetURL, secret string, events []string, createdBy *string) (*Webhook, error) {
+	eventsJSON, _ := json.Marshal(events)
+	w := &Webhook{}
+	err := r.db.QueryRow(ctx, `
+		INSERT INTO integration_webhooks (name, target_url, secret, events, created_by)
+		VALUES ($1,$2,$3,$4,$5)
+		RETURNING id, name, target_url, secret, events, active, created_by, last_triggered_at, COALESCE(last_status,''), COALESCE(last_error,''), created_at`,
+		name, targetURL, secret, eventsJSON, createdBy,
+	).Scan(&w.ID, &w.Name, &w.TargetURL, &w.Secret, jsonEventsScanner{&w.Events}, &w.Active, &w.CreatedBy, &w.LastTriggeredAt, &w.LastStatus, &w.LastError, &w.CreatedAt)
+	return w, err
+}
+
+func (r *Repository) ListWebhooks(ctx context.Context) ([]*Webhook, error) {
+	rows, err := r.db.Query(ctx, `SELECT id, name, target_url, secret, events, active, created_by, last_triggered_at, COALESCE(last_status,''), COALESCE(last_error,''), created_at
+		FROM integration_webhooks ORDER BY created_at DESC`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var hooks []*Webhook
+	for rows.Next() {
+		w := &Webhook{}
+		if err := rows.Scan(&w.ID, &w.Name, &w.TargetURL, &w.Secret, jsonEventsScanner{&w.Events}, &w.Active, &w.CreatedBy, &w.LastTriggeredAt, &w.LastStatus, &w.LastError, &w.CreatedAt); err != nil {
+			return nil, err
+		}
+		hooks = append(hooks, w)
+	}
+	return hooks, nil
+}
+
+func (r *Repository) ListActiveWebhooksForEvent(ctx context.Context, event string) ([]*Webhook, error) {
+	all, err := r.ListWebhooks(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var matched []*Webhook
+	for _, w := range all {
+		if !w.Active {
+			continue
+		}
+		for _, e := range w.Events {
+			if e == event {
+				matched = append(matched, w)
+				break
+			}
+		}
+	}
+	return matched, nil
+}
+
+func (r *Repository) DeleteWebhook(ctx context.Context, id string) error {
+	_, err := r.db.Exec(ctx, `DELETE FROM integration_webhooks WHERE id=$1`, id)
+	return err
+}
+
+func (r *Repository) RecordWebhookResult(ctx context.Context, id string, status string, errMsg string) {
+	r.db.Exec(ctx, `UPDATE integration_webhooks SET last_triggered_at=NOW(), last_status=$1, last_error=$2 WHERE id=$3`, status, errMsg, id)
+}
+
+// jsonEventsScanner erlaubt pgx, die JSONB-Spalte "events" direkt in ein
+// []string zu scannen, ohne an jeder Aufrufstelle manuell json.Unmarshal
+// aufzurufen.
+type jsonEventsScanner struct{ dest *[]string }
+
+func (s jsonEventsScanner) Scan(src interface{}) error {
+	var raw []byte
+	switch v := src.(type) {
+	case []byte:
+		raw = v
+	case string:
+		raw = []byte(v)
+	default:
+		*s.dest = nil
+		return nil
+	}
+	return json.Unmarshal(raw, s.dest)
+}
+
+// ── Service ───────────────────────────────────────────────────
+
+type Service struct {
+	repo *Repository
+}
+
+func NewService(repo *Repository) *Service { return &Service{repo: repo} }
+
+// GenerateAPIKey erzeugt einen neuen, hochentropischen Schlüssel. Der
+// Rohschlüssel wird NUR hier zurückgegeben (einmalig sichtbar) - in der DB
+// landet nur sein SHA-256-Hash.
+func (s *Service) GenerateAPIKey(ctx context.Context, name string, createdBy *string) (rawKey string, key *APIKey, err error) {
+	raw := make([]byte, 32)
+	if _, err := rand.Read(raw); err != nil {
+		return "", nil, err
+	}
+	rawKey = "pdh_" + hex.EncodeToString(raw)
+	hash := sha256.Sum256([]byte(rawKey))
+	hashHex := hex.EncodeToString(hash[:])
+	prefix := rawKey[:12]
+	key, err = s.repo.CreateAPIKey(ctx, name, hashHex, prefix, createdBy)
+	return rawKey, key, err
+}
+
+func (s *Service) ValidateAPIKey(ctx context.Context, rawKey string) (*APIKey, error) {
+	hash := sha256.Sum256([]byte(rawKey))
+	hashHex := hex.EncodeToString(hash[:])
+	key, err := s.repo.FindActiveAPIKeyByHash(ctx, hashHex)
+	if err != nil {
+		return nil, err
+	}
+	s.repo.TouchAPIKey(ctx, key.ID)
+	return key, nil
+}
+
+func (s *Service) ListAPIKeys(ctx context.Context) ([]*APIKey, error) { return s.repo.ListAPIKeys(ctx) }
+func (s *Service) RevokeAPIKey(ctx context.Context, id string) error {
+	return s.repo.RevokeAPIKey(ctx, id)
+}
+
+type ctxKey string
+
+const apiKeyCtxKey ctxKey = "integration_api_key"
+
+// AuthMiddleware prüft den "X-API-Key"-Header gegen die gespeicherten,
+// aktiven Integrations-Schlüssel. Für die /api/v1/integration/*-Routen
+// gedacht - komplett getrennt von der normalen JWT-Session-Auth, weil n8n
+// (oder ein anderes externes System) kein Nutzerkonto ist.
+func (s *Service) AuthMiddleware(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		key := r.Header.Get("X-API-Key")
+		if key == "" {
+			http.Error(w, `{"error":"X-API-Key Header fehlt"}`, http.StatusUnauthorized)
+			return
+		}
+		apiKey, err := s.ValidateAPIKey(r.Context(), key)
+		if err != nil {
+			http.Error(w, `{"error":"ungueltiger API-Key"}`, http.StatusUnauthorized)
+			return
+		}
+		ctx := context.WithValue(r.Context(), apiKeyCtxKey, apiKey)
+		next.ServeHTTP(w, r.WithContext(ctx))
+	})
+}
+
+// APIKeyFromContext liefert den validierten API-Schlüssel-Datensatz der
+// aktuellen Anfrage (gesetzt von AuthMiddleware).
+func APIKeyFromContext(ctx context.Context) *APIKey {
+	k, _ := ctx.Value(apiKeyCtxKey).(*APIKey)
+	return k
+}
+
+func (s *Service) CreateWebhook(ctx context.Context, name, targetURL, secret string, events []string, createdBy *string) (*Webhook, error) {
+	return s.repo.CreateWebhook(ctx, name, targetURL, secret, events, createdBy)
+}
+func (s *Service) ListWebhooks(ctx context.Context) ([]*Webhook, error) {
+	return s.repo.ListWebhooks(ctx)
+}
+func (s *Service) DeleteWebhook(ctx context.Context, id string) error {
+	return s.repo.DeleteWebhook(ctx, id)
+}
+
+// Dispatch sendet ein Ereignis an alle aktiven, dafür abonnierten Webhooks.
+// Läuft asynchron (eigene Goroutine pro Webhook) und blockiert damit nie
+// den eigentlichen Request, der das Ereignis ausgelöst hat.
+func (s *Service) Dispatch(ctx context.Context, event string, payload interface{}) {
+	hooks, err := s.repo.ListActiveWebhooksForEvent(ctx, event)
+	if err != nil || len(hooks) == 0 {
+		return
+	}
+	body, err := json.Marshal(map[string]interface{}{
+		"event":     event,
+		"data":      payload,
+		"timestamp": time.Now().UTC().Format(time.RFC3339),
+	})
+	if err != nil {
+		return
+	}
+	for _, hook := range hooks {
+		go s.send(hook, body)
+	}
+}
+
+func (s *Service) send(hook *Webhook, body []byte) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	mac := hmac.New(sha256.New, []byte(hook.Secret))
+	mac.Write(body)
+	signature := hex.EncodeToString(mac.Sum(nil))
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, hook.TargetURL, bytes.NewReader(body))
+	if err != nil {
+		s.repo.RecordWebhookResult(ctx, hook.ID, "error", err.Error())
+		return
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-PDH-Signature", "sha256="+signature)
+
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		log.Warn().Err(err).Str("webhook", hook.Name).Msg("webhook-versand fehlgeschlagen")
+		s.repo.RecordWebhookResult(ctx, hook.ID, "error", err.Error())
+		return
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		s.repo.RecordWebhookResult(ctx, hook.ID, "ok", "")
+	} else {
+		s.repo.RecordWebhookResult(ctx, hook.ID, "error", "HTTP "+http.StatusText(resp.StatusCode))
+	}
+}
diff --git a/internal/modules/production/production.go b/internal/modules/production/production.go
new file mode 100644
index 0000000..5547c70
--- /dev/null
+++ b/internal/modules/production/production.go
@@ -0,0 +1,143 @@
+// Package production verwaltet Produktionsdaten (Stückzahlen, Ausschuss,
+// Zykluszeit) pro Maschine/Anlage. Datensätze können manuell im Web-UI
+// erfasst oder über die Integrations-API (z.B. per n8n aus einem
+// externen MES) importiert werden - das Feld "Source" unterscheidet
+// beides.
+package production
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+type Record struct {
+	ID               string    `json:"id"`
+	InfrastructureID *string   `json:"infrastructure_id,omitempty"`
+	InfraName        string    `json:"infrastructure_name,omitempty"`
+	RecordedAt       time.Time `json:"recorded_at"`
+	QuantityGood     int       `json:"quantity_good"`
+	QuantityScrap    int       `json:"quantity_scrap"`
+	CycleTimeSeconds *float64  `json:"cycle_time_seconds,omitempty"`
+	Notes            string    `json:"notes,omitempty"`
+	Source           string    `json:"source"` // manual | import | api
+	ExternalRef      *string   `json:"external_ref,omitempty"`
+	CreatedBy        *string   `json:"created_by,omitempty"`
+	CreatedByName    string    `json:"created_by_name,omitempty"`
+	CreatedAt        time.Time `json:"created_at"`
+}
+
+type CreateInput struct {
+	InfrastructureID *string
+	RecordedAt       *time.Time
+	QuantityGood     int
+	QuantityScrap    int
+	CycleTimeSeconds *float64
+	Notes            string
+	Source           string
+	ExternalRef      *string
+	CreatedBy        *string
+}
+
+type Filter struct {
+	InfrastructureID string
+	From             *time.Time
+	To               *time.Time
+	Limit            int
+}
+
+// ── Repository ────────────────────────────────────────────────
+
+type Repository struct{ db *pgxpool.Pool }
+
+func NewRepository(db *pgxpool.Pool) *Repository { return &Repository{db: db} }
+
+func (r *Repository) Create(ctx context.Context, in *CreateInput) (*Record, error) {
+	recordedAt := time.Now()
+	if in.RecordedAt != nil {
+		recordedAt = *in.RecordedAt
+	}
+	source := in.Source
+	if source == "" {
+		source = "manual"
+	}
+	rec := &Record{}
+	err := r.db.QueryRow(ctx, `
+		INSERT INTO production_records
+			(infrastructure_id, recorded_at, quantity_good, quantity_scrap, cycle_time_seconds, notes, source, external_ref, created_by)
+		VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)
+		RETURNING id, infrastructure_id, recorded_at, quantity_good, quantity_scrap, cycle_time_seconds, COALESCE(notes,''), source, external_ref, created_by, created_at`,
+		in.InfrastructureID, recordedAt, in.QuantityGood, in.QuantityScrap, in.CycleTimeSeconds, in.Notes, source, in.ExternalRef, in.CreatedBy,
+	).Scan(&rec.ID, &rec.InfrastructureID, &rec.RecordedAt, &rec.QuantityGood, &rec.QuantityScrap,
+		&rec.CycleTimeSeconds, &rec.Notes, &rec.Source, &rec.ExternalRef, &rec.CreatedBy, &rec.CreatedAt)
+	return rec, err
+}
+
+func (r *Repository) List(ctx context.Context, f Filter) ([]*Record, error) {
+	query := `SELECT pr.id, pr.infrastructure_id, COALESCE(i.name,''), pr.recorded_at,
+		pr.quantity_good, pr.quantity_scrap, pr.cycle_time_seconds, COALESCE(pr.notes,''),
+		pr.source, pr.external_ref, pr.created_by, COALESCE(u.first_name||' '||u.last_name,''), pr.created_at
+		FROM production_records pr
+		LEFT JOIN infrastructure i ON pr.infrastructure_id = i.id
+		LEFT JOIN users u ON pr.created_by = u.id
+		WHERE 1=1`
+	args := []interface{}{}
+	n := 0
+	if f.InfrastructureID != "" {
+		n++
+		query += " AND pr.infrastructure_id = $" + strconv.Itoa(n)
+		args = append(args, f.InfrastructureID)
+	}
+	if f.From != nil {
+		n++
+		query += " AND pr.recorded_at >= $" + strconv.Itoa(n)
+		args = append(args, *f.From)
+	}
+	if f.To != nil {
+		n++
+		query += " AND pr.recorded_at <= $" + strconv.Itoa(n)
+		args = append(args, *f.To)
+	}
+	query += " ORDER BY pr.recorded_at DESC"
+	limit := f.Limit
+	if limit <= 0 || limit > 5000 {
+		limit = 500
+	}
+	n++
+	query += " LIMIT $" + strconv.Itoa(n)
+	args = append(args, limit)
+
+	rows, err := r.db.Query(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var records []*Record
+	for rows.Next() {
+		rec := &Record{}
+		if err := rows.Scan(&rec.ID, &rec.InfrastructureID, &rec.InfraName, &rec.RecordedAt,
+			&rec.QuantityGood, &rec.QuantityScrap, &rec.CycleTimeSeconds, &rec.Notes,
+			&rec.Source, &rec.ExternalRef, &rec.CreatedBy, &rec.CreatedByName, &rec.CreatedAt); err != nil {
+			return nil, err
+		}
+		records = append(records, rec)
+	}
+	return records, nil
+}
+
+// ── Service ───────────────────────────────────────────────────
+
+type Service struct{ repo *Repository }
+
+func NewService(repo *Repository) *Service { return &Service{repo: repo} }
+
+func (s *Service) Create(ctx context.Context, in *CreateInput) (*Record, error) {
+	return s.repo.Create(ctx, in)
+}
+
+func (s *Service) List(ctx context.Context, f Filter) ([]*Record, error) {
+	return s.repo.List(ctx, f)
+}
