{{template "base" .}}
{{define "content"}}
{{$t := .Task}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
  {{template "icon-button" (dict "Action" "back" "Href" (or (and $t.ProjectID (printf "/projects/%s" $t.ProjectID)) "/tasks"))}}
  <div style="flex:1;min-width:200px">
    <h1 style="font-size:18px;font-weight:600">{{$t.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">{{$t.CreatedAgo}}{{if $t.ProjectName}} · Projekt: {{$t.ProjectName}}{{end}}</p>
  </div>
  <span class="badge {{$t.PriorityClass}}" style="font-size:12px;padding:4px 12px">{{$t.Priority}}</span>
  <span class="badge {{$t.StatusClass}}" style="font-size:12px;padding:4px 12px">{{$t.StatusLabel}}</span>
</div>

{{template "record-meta-slot" (dict "Module" "task" "ID" $t.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  <a class="rec-tab" data-tab="edit" href="?tab=edit"><i class="ti ti-edit"></i> Bearbeiten</a>
  <a class="rec-tab" data-tab="work" href="?tab=work"><i class="ti ti-tool"></i> Maßnahmen & Ersatzteile</a>
  <a class="rec-tab" data-tab="time" href="?tab=time"><i class="ti ti-clock"></i> Zeit <b>{{len .TimeEntries}}</b></a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="docs" href="?tab=docs"><i class="ti ti-paperclip"></i> Dokumente</a>
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Historie</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">
{{template "work-do" (dict "Kind" "task" "ID" $t.ID "Open" $t.CanResolve "Title" "Aufgabe erledigen" "Label" "Erledigen" "Icon" "ti-circle-check" "Due" $t.DueDate "DoneTitle" $t.StatusLabel "ArchiveURL" "/tasks?view=archive")}}
<div class="grid2" style="grid-template-columns:1fr 320px;gap:14px;align-items:start">
  <div>
    <div class="card">
      <div class="card-title">Beschreibung</div>
      <p style="font-size:13px;line-height:1.7;color:var(--muted)">{{if $t.Description}}{{$t.Description}}{{else}}Keine Beschreibung{{end}}</p>
    </div>

    {{if $t.Resolution}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div class="card-title"><i class="ti ti-check" style="color:var(--green)"></i> Gelöst</div>
      <p style="font-size:13px;margin-bottom:8px"><strong>Maßnahme:</strong> {{$t.Resolution}}</p>
      {{if $t.RootCause}}<p style="font-size:13px;color:var(--muted)"><strong>Grundursache:</strong> {{$t.RootCause}}</p>{{end}}
    </div>
    {{end}}
  </div>

  <div>
    <div class="card">
      <div class="card-title"><span>Details</span><a class="card-action rec-tab" data-tab="edit" href="?tab=edit" style="padding:0"><i class="ti ti-edit"></i> Bearbeiten</a></div>
      <dl class="w11-props">
        <dt>Status</dt><dd><span class="badge {{$t.StatusClass}}">{{$t.StatusLabel}}</span></dd>
        <dt>Priorität</dt><dd><span class="badge {{$t.PriorityClass}}">{{$t.Priority}}</span></dd>
        {{if $t.StartDate}}<dt>Start</dt><dd>{{$t.StartDate}}</dd>{{end}}
        <dt>Termin</dt><dd>{{if $t.DueDate}}{{$t.DueDate}}{{else}}–{{end}}</dd>
        <dt>Zugewiesen</dt><dd>{{if $t.AssigneeNames}}{{$t.AssigneeNames}}{{else}}–{{end}}</dd>
        {{if $t.ResponsibleName}}<dt>Verantwortlich</dt><dd>{{$t.ResponsibleName}}</dd>{{end}}
        {{if $t.ProjectName}}<dt>Projekt</dt><dd><a href="/projects/{{$t.ProjectID}}" style="color:var(--accent)">{{$t.ProjectName}}</a></dd>{{end}}
        <dt>Infrastruktur</dt><dd>{{if $t.InfraName}}{{$t.InfraName}}{{else}}–{{end}}</dd>
      </dl>
    </div>
    <div class="card">
      <div class="card-title">Beteiligte</div>
      <div id="record-parties" hx-get="/records/task/{{$t.ID}}/parties" hx-trigger="load" hx-swap="innerHTML"></div>
    </div>
  </div>
</div>
</div>

<!-- ── Bearbeiten (Einstellungs-Zeilen wie in Windows 11) ── -->
<div class="rec-pane" data-pane="edit">
  <div class="rec-edit">
    <div class="w11-group">Zuständigkeit</div>
    <div class="w11-row" data-save="/api/v1/tasks/{{$t.ID}}/edit" data-json data-label="Zugewiesen">
      <i class="ti ti-users w11-row-icon"></i>
      <div class="w11-row-text"><b>Zugewiesen</b><span>Wer die Aufgabe macht. Mehrere mit Strg bzw. lange antippen.</span></div>
      <div class="w11-row-ctl">
        <select name="assigned_to_ids" class="form-input" multiple size="5" aria-label="Zugewiesen">
          {{range $.Users}}<option value="{{.ID}}" {{if index $t.AssignedIDSet .ID}}selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </div>
    </div>
    <div class="w11-row" data-save="/records/task/{{$t.ID}}/group" data-label="Gruppe">
      <i class="ti ti-users-group w11-row-icon"></i>
      <div class="w11-row-text"><b>Zugewiesene Gruppe</b><span>Alle Mitglieder sehen die Aufgabe unter „Mir zugewiesen“.</span></div>
      <div class="w11-row-ctl"><select name="assigned_group_id" class="form-input" aria-label="Zugewiesene Gruppe" hx-get="/records/task/{{$t.ID}}/group-options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><option value="__keep__">Lädt…</option></select></div>
    </div>
    <div class="w11-group">Zuordnung</div>
    <div class="w11-row" data-save="/api/v1/tasks/{{$t.ID}}/edit" data-json data-label="Termin">
      <i class="ti ti-calendar w11-row-icon"></i>
      <div class="w11-row-text"><b>Termin</b><span>Bis wann die Aufgabe erledigt sein soll.</span></div>
      <div class="w11-row-ctl"><input type="date" name="due_date" class="form-input" value="{{$t.DueDateISO}}" aria-label="Termin"></div>
    </div>
    <div class="w11-row" data-save="/api/v1/tasks/{{$t.ID}}/edit" data-json data-clear="infrastructure_id:clear_infrastructure" data-label="Infrastruktur">
      <i class="ti ti-building-factory-2 w11-row-icon"></i>
      <div class="w11-row-text"><b>Infrastruktur</b><span>Optional: Anlage oder Bereich, zu der die Aufgabe gehört.</span></div>
      <div class="w11-row-ctl">{{template "infra-tree-picker" (dict "TargetID" "task-infra-id" "SelectedLabelID" "task-infra-selected" "Label" "Anlage / Bereich" "Value" $t.InfraID "SelectedLabel" $t.InfraName)}}</div>
    </div>
    {{if $t.CanResolve}}
    <div class="w11-row" data-save="/api/v1/tasks/{{$t.ID}}/edit" data-json data-label="Farbe">
      <i class="ti ti-palette w11-row-icon"></i>
      <div class="w11-row-text"><b>Farbe im Gantt</b><span>Optional: so erscheint die Aufgabe im Zeitplan des Projekts.</span></div>
      <div class="w11-row-ctl"><input type="color" name="color" class="form-input" aria-label="Farbe" style="width:60px;height:36px;padding:2px" value="{{if $t.Color}}{{$t.Color}}{{else}}#4f6ef7{{end}}"></div>
    </div>
    {{end}}
    <div class="w11-actions">
      <div class="w11-infobar" role="status"></div>
      <button class="btn btn-primary" type="button" onclick="pdhRecSave(this)"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </div>
</div>

<!-- ── Maßnahmen & Ersatzteile ── -->
<div class="rec-pane" data-pane="work">
  <div class="card">
    <div class="card-title">Durchgeführte Maßnahmen</div>
    <div id="task-actions-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
    {{if $t.CanResolve}}
    <div style="display:flex;gap:8px">
      <input data-suggest="action" id="ta-new-action" class="form-input" placeholder="z.B. Ursache behoben" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addTaskAction();}">
      <button type="button" class="btn" onclick="addTaskAction()"><i class="ti ti-plus"></i> Maßnahme</button>
    </div>
    {{end}}
  </div>

  {{if $t.CanResolve}}
  <div class="card">
    <div class="card-title">Ersatzteile</div>
    <div id="task-parts-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
    <button type="button" class="btn" onclick="openTaskPartModal()"><i class="ti ti-package"></i> Ersatzteil reservieren</button>
  </div>

  {{template "work-part-dialog" (dict "ID" "task-part-modal" "P" "ta" "Filter" "filterTaskParts" "Book" "bookTaskPart" "Close" "closeTaskPartModal")}}
  {{end}}
</div>

<!-- ── Zeit ── -->
<div class="rec-pane" data-pane="time">
  <div class="rec-edit">
    <div class="w11-row">
      <i class="ti ti-clock w11-row-icon"></i>
      <div class="w11-row-text"><b>Zeiterfassung</b><span>{{if .RunningTime}}Läuft seit {{.RunningTime.StartedAt.Format "15:04"}}{{if .RunningTime.Description}} · {{.RunningTime.Description}}{{end}}{{else}}Startet deine Zeit für diese Aufgabe.{{end}}</span></div>
      {{if .RunningTime}}
      <button type="button" class="btn" onclick="stopTaskTime('{{.RunningTime.ID}}')"><i class="ti ti-player-stop"></i> Zeit stoppen</button>
      {{else}}
      <button type="button" class="btn btn-primary" onclick="startTaskTime()"><i class="ti ti-player-play"></i> Zeit erfassen</button>
      {{end}}
    </div>
    <div id="task-time-result" style="font-size:12px"></div>
    <div class="w11-group">Zeiteinträge</div>
    {{range .TimeEntries}}
    <div class="w11-row"><i class="ti ti-clock-hour-4 w11-row-icon"></i><div class="w11-row-text"><b>{{if .Description}}{{.Description}}{{else}}Zeiteintrag{{end}}</b><span>{{.UserName}}</span></div><span style="font-size:13px">{{if .DurationMin}}{{.DurationMin}} min{{else}}läuft …{{end}}</span></div>
    {{else}}
    <div class="w11-infobar">Noch keine Zeiteinträge.</div>
    {{end}}
  </div>
</div>

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "task" "ID" .Task.ID)}}</div>
</div>

<!-- ── Dokumente ── -->
<div class="rec-pane" data-pane="docs">
  <div class="card">
    <div class="card-title"><span><i class="ti ti-paperclip"></i> Fotos & Dokumente</span></div>
    <div id="attachments-{{.Task.ID}}" data-attach-ref="task:{{.Task.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
    {{template "work-upload-buttons" (dict "Module" "task" "ID" .Task.ID)}}
  </div>
</div>

<!-- ── Verknüpfungen ── -->
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "task" "ID" .Task.ID)}}</div>

<!-- ── Historie ── -->
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "task" "ID" .Task.ID)}}</div>
{{end}}

{{define "scripts"}}
{{template "work-style"}}
{{template "work-edit-script"}}
<script>
var TASK_ID = '{{.Task.ID}}';
var taPartsCache = null;
function escTa(s){return String(s||'').replace(/[&<>'"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]);});}

async function loadTaskActions(){
  var box = document.getElementById('task-actions-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/actions', {credentials:'same-origin'});
    var json = await res.json();
    var actions = json.data || json || [];
    box.innerHTML = actions.length ? actions.map(function(a){
      var t = new Date(a.created_at);
      var timeStr = t.toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escTa(a.description)+'</div><div class="li-sub">'+timeStr+' · '+escTa(a.created_by_name)+'</div></div></div>';
    }).join('') : '<div style="padding:4px 0">Noch keine Maßnahmen erfasst</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function addTaskAction(){
  var input = document.getElementById('ta-new-action');
  var description = input.value.trim();
  if(!description) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/actions', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({description:description})
    });
    var json = await res.json();
    if(!res.ok) throw new Error(json.error||'Fehler');
    input.value='';
    loadTaskActions();
  }catch(e){ alert('Fehler: '+e.message); }
}

async function loadTaskPartsList(){
  var box = document.getElementById('task-parts-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts', {credentials:'same-origin'});
    var json = await res.json();
    var pending = json.data || json || [];
    box.innerHTML = pending.length ? pending.map(function(p){
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escTa(p.part_name)+' <span style="color:var(--muted)">('+escTa(p.part_number)+')</span></div><div class="li-sub">'+p.qty+' Stk · '+escTa(p.storage_name)+''+pdhReservedTag(p,'task',TASK_ID,'loadTaskPartsList')+'</div></div><button type="button" class="btn" style="font-size:11px;color:var(--red)" onclick="removeTaskPendingPart(THISID)"><i class="ti ti-x"></i></button></div>'.replace('THISID', "'"+p.id+"'");
    }).join('') : '<div style="padding:4px 0">Noch keine Ersatzteile reserviert</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function removeTaskPendingPart(id){
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts/'+id, {method:'DELETE', credentials:'same-origin'});
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    loadTaskPartsList();
  }catch(e){ alert('Fehler beim Entfernen: '+e.message); }
}

async function loadTaskPartsCache(){
  if(taPartsCache) return taPartsCache;
  var res = await fetch('/api/v1/inventory/', {credentials:'same-origin'});
  var json = await res.json();
  taPartsCache = json.data || json || [];
  return taPartsCache;
}
async function loadTaskStorageOptions(selectEl){
  try{
    var res = await fetch('/api/v1/storage/', {credentials:'same-origin'});
    var json = await res.json();
    var tree = json.data || json;
    var options = [];
    function walk(nodes, prefix){
      (nodes||[]).forEach(function(n){
        var label = prefix ? prefix+' > '+n.name : n.name;
        options.push({id:n.id, label:label});
        if(n.children && n.children.length) walk(n.children, label);
      });
    }
    walk(Array.isArray(tree) ? tree : (tree.children||[]), '');
    selectEl.innerHTML = '<option value="">Lagerort wählen...</option>' + options.map(function(o){return '<option value="'+o.id+'">'+escTa(o.label)+'</option>';}).join('');
  }catch(e){
    selectEl.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}
function openTaskPartModal(){
  document.getElementById('task-part-modal').style.display='flex';
  document.getElementById('ta-part-search').value='';
  document.getElementById('ta-part-id').value='';
  document.getElementById('ta-part-selected').textContent='';
  document.getElementById('ta-part-results').style.display='none';
  document.getElementById('ta-part-error').style.display='none';
  document.getElementById('ta-part-qty').value='1';
  loadTaskStorageOptions(document.getElementById('ta-part-location'));
}
function closeTaskPartModal(){ document.getElementById('task-part-modal').style.display='none'; }
async function filterTaskParts(){
  var q = document.getElementById('ta-part-search').value.trim().toLowerCase();
  var box = document.getElementById('ta-part-results');
  if(!q){ box.style.display='none'; return; }
  var parts = await loadTaskPartsCache();
  var matches = parts.filter(function(p){
    return (p.name||'').toLowerCase().indexOf(q)!==-1 || (p.part_number||'').toLowerCase().indexOf(q)!==-1;
  }).slice(0,20);
  var html = '';
  for(var i=0;i<matches.length;i++){
    var p = matches[i];
    var row = document.createElement('div');
    row.style.padding='6px 8px';
    row.style.cursor='pointer';
    row.style.fontSize='12px';
    row.style.borderBottom='1px solid var(--border)';
    row.textContent = p.name + ' (' + p.part_number + ')';
    row.addEventListener('click', (function(part){ return function(){ selectTaskPart(part.id, part.name); }; })(p));
    box.appendChild(row);
  }
  box.innerHTML = '';
  if(matches.length === 0){
    box.innerHTML = '<div style="padding:6px 8px;font-size:12px;color:var(--muted)">Keine Treffer</div>';
  } else {
    for(var j=0;j<matches.length;j++){
      var mp = matches[j];
      var el = document.createElement('div');
      el.style.padding='6px 8px';
      el.style.cursor='pointer';
      el.style.fontSize='12px';
      el.style.borderBottom='1px solid #333';
      el.textContent = mp.name + ' (' + mp.part_number + ')';
      el.addEventListener('click', (function(part){ return function(){ selectTaskPart(part.id, part.name); }; })(mp));
      box.appendChild(el);
    }
  }
  box.style.display='block';
}
function selectTaskPart(id,label){
  document.getElementById('ta-part-id').value=id;
  document.getElementById('ta-part-selected').textContent='Ausgewählt: '+label;
  document.getElementById('ta-part-results').style.display='none';
  document.getElementById('ta-part-search').value='';
}
async function bookTaskPart(){
  var partId = document.getElementById('ta-part-id').value;
  var locationId = document.getElementById('ta-part-location').value;
  var qty = parseFloat(document.getElementById('ta-part-qty').value);
  var errEl = document.getElementById('ta-part-error');
  errEl.style.display='none';
  if(!partId){ errEl.textContent='Bitte ein Ersatzteil auswählen'; errEl.style.display='block'; return; }
  if(!locationId){ errEl.textContent='Bitte einen Lagerort auswählen'; errEl.style.display='block'; return; }
  if(!qty || qty<=0){ errEl.textContent='Bitte eine gültige Menge angeben'; errEl.style.display='block'; return; }
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({part_id:partId, storage_node_id:locationId, qty:qty})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    closeTaskPartModal();
    loadTaskPartsList();
  }catch(e){ errEl.textContent='Fehler: '+e.message; errEl.style.display='block'; }
}


async function startTaskTime(){
  var result = document.getElementById('task-time-result');
  result.textContent = 'Starte...';
  try{
    var res = await fetch('/tasks/'+TASK_ID+'/time/start', {method:'POST', credentials:'same-origin'});
    var text = await res.text();
    result.innerHTML = text;
    setTimeout(function(){ location.reload(); }, 800);
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}
async function stopTaskTime(entryID){
  var result = document.getElementById('task-time-result');
  result.textContent = 'Stoppe...';
  try{
    var res = await fetch('/time/'+entryID+'/stop-web', {method:'POST', credentials:'same-origin'});
    var text = await res.text();
    result.innerHTML = text;
    setTimeout(function(){ location.reload(); }, 800);
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}

if(document.readyState !== 'loading'){ loadTaskActions(); loadTaskPartsList(); }
else document.addEventListener('DOMContentLoaded', function(){ loadTaskActions(); loadTaskPartsList(); });
</script>
{{end}}


