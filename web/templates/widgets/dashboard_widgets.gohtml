{{/*
  Dashboard-Widgets (dashboard_widgets.go). "dw-grid" ist das Raster auf dem
  Dashboard samt Anpassen-Modus und Katalog; "dw-body" ist der per htmx
  nachgeladene Inhalt eines Widgets (GET /dashboard/w/{id}).
*/}}

{{define "dw-grid"}}
<style>
.dw-bar{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.dw-bar .grow{flex:1}
.dw-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px;min-height:60px}
.dw{background:var(--bg2);border:1px solid var(--border);border-radius:12px;display:flex;flex-direction:column;min-width:0;min-height:110px;overflow:hidden}
.dw[data-size="1"]{grid-column:span 1}.dw[data-size="2"]{grid-column:span 2}.dw[data-size="3"]{grid-column:span 3}.dw[data-size="4"]{grid-column:span 4}
.dw-head{display:flex;align-items:center;gap:8px;padding:10px 12px 0;font-size:12px;font-weight:600;color:var(--muted)}
.dw-head > i{font-size:15px;color:var(--accent)}
.dw-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dw-tools{display:none;gap:4px}
.dw-tools button{width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:var(--bg3);color:var(--text);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:14px}
.dw-tools button:hover{border-color:var(--accent)}
.dw-body{flex:1;padding:10px 12px 12px;min-width:0;font-size:12.5px}
.dw-loading{color:var(--muted);font-size:12px}
.dw-cfg{display:none;padding:0 12px 12px;gap:6px;flex-direction:column}
.dw-cfg label{font-size:11px;color:var(--muted)}
.dw-cfg textarea{min-height:80px;font-family:inherit}
/* Anpassen-Modus */
.dw-edit .dw{outline:2px dashed rgba(var(--accent-rgb),.45);outline-offset:-2px;cursor:grab}
.dw-edit .dw-tools{display:flex}
.dw-edit .dw.cfg-open .dw-cfg{display:flex}
.dw-ghost{opacity:.35}
.dw-empty{grid-column:1/-1;border:2px dashed var(--border);border-radius:12px;padding:24px;text-align:center;color:var(--muted);font-size:13px}
.dw-cat{display:none;border:1px solid var(--border);background:var(--bg2);border-radius:12px;padding:12px;margin-bottom:12px}
.dw-edit-on .dw-cat{display:block}
.dw-cat h4{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin:10px 0 6px}
.dw-cat-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px}
.dw-cat-item{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--border);border-radius:10px;padding:8px 10px;background:var(--bg3);cursor:grab;user-select:none}
.dw-cat-item i{font-size:18px;color:var(--accent);margin-top:2px}
.dw-cat-item b{font-size:12.5px;display:block}
.dw-cat-item small{font-size:11px;color:var(--muted);line-height:1.35;display:block}
.dw-cat-item .add{margin-left:auto;flex-shrink:0;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:var(--bg2);color:var(--accent);cursor:pointer}
/* Inhalte */
.dw-stat{display:flex;flex-direction:column;gap:2px;text-decoration:none;color:inherit}
.dw-stat .v{font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.1}
.dw-stat .s{font-size:12px;color:var(--muted)}
.dw-stat .s.alert{color:var(--red);font-weight:600}
.dw-stat.c-blue .v{color:#60a5fa}.dw-stat.c-red .v{color:var(--red)}.dw-stat.c-amber .v{color:var(--amber)}.dw-stat.c-green .v{color:var(--green)}.dw-stat.c-accent .v{color:var(--accent)}
html[data-theme="light"] .dw-stat.c-blue .v{color:#2563eb}
.dw-list{display:flex;flex-direction:column}
.dw-li{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border);color:inherit;text-decoration:none;min-width:0}
.dw-li:last-child{border-bottom:0}
.dw-li:hover .t{color:var(--accent)}
.dw-li > i{font-size:16px;color:var(--muted);flex-shrink:0}
.dw-li .tx{flex:1;min-width:0}
.dw-li .t,.dw-li .s{display:block}
.dw-li .t{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dw-li .s{font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dw-none{color:var(--muted);font-size:12px;padding:8px 0}
.dw-qa{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}
.dw-qa a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:12px 6px;border-radius:10px;border:1px solid var(--border);background:var(--bg3);color:var(--text);text-decoration:none;font-size:12px;text-align:center;min-height:74px}
.dw-qa a:hover{border-color:var(--accent)}
.dw-qa a i{font-size:22px}
.dw-qa .q-accent i{color:var(--accent)}.dw-qa .q-red i{color:var(--red)}.dw-qa .q-blue i{color:#60a5fa}.dw-qa .q-green i{color:var(--green)}.dw-qa .q-amber i{color:var(--amber)}.dw-qa .q-muted i{color:var(--muted)}
.dw-links a{display:flex;align-items:center;gap:8px;padding:6px 0;color:var(--accent);text-decoration:none;border-bottom:1px solid var(--border);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dw-links a:last-child{border-bottom:0}
.dw-note{display:block;width:100%;box-sizing:border-box;resize:vertical;font:inherit;color:var(--text);line-height:1.5;background:rgba(245,158,11,.10);border:0;border-left:3px solid var(--amber);border-radius:6px;padding:8px 10px;min-height:90px}
.dw-note:focus{outline:2px solid var(--amber);outline-offset:1px}
.dw-note-st{font-size:10.5px;color:var(--muted);text-align:right;min-height:14px;margin-top:2px}
.dw-chart{display:flex;align-items:flex-end;gap:4px;height:110px;padding-top:6px}
.dw-chart .d{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0;height:100%}
.dw-chart .bars{flex:1;width:100%;display:flex;align-items:flex-end;justify-content:center;gap:2px}
.dw-chart .b{width:45%;border-radius:3px 3px 0 0;min-height:2px}
.dw-chart .bt{background:#60a5fa}.dw-chart .bf{background:var(--red)}
.dw-chart .l{font-size:9px;color:var(--muted);white-space:nowrap}
.dw-legend{display:flex;gap:12px;font-size:11px;color:var(--muted);margin-top:6px}
.dw-legend span::before{content:"";display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:-1px}
.dw-legend .lt::before{background:#60a5fa}.dw-legend .lf::before{background:var(--red)}
.dw-shifts{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
.dw-shifts .d{border:1px solid var(--border);border-radius:8px;padding:6px 2px;text-align:center;font-size:11px;background:var(--bg3)}
.dw-shifts .d.today{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.dw-shifts .sh{font-size:15px;font-weight:700;margin:3px 0}
.dw-shifts .tm{font-size:9.5px;color:var(--muted)}
@media (max-width:1180px){
  .dw-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .dw[data-size="3"],.dw[data-size="4"]{grid-column:span 2}
}
@media (max-width:760px){
  /* Handy: kleine Kennzahlen zu zweit, alles andere ueber die volle Breite */
  .dw-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .dw[data-size]{grid-column:span 2}
  .dw[data-size="1"]{grid-column:span 1}
  .dw-stat .v{font-size:26px}
  .dw-shifts{grid-template-columns:repeat(4,minmax(0,1fr))}
}
</style>

<div id="dw-root">
  <div class="dw-bar">
    <span class="grow"></span>
    <span id="dw-hint" class="sc-sub" style="display:none;font-size:12px;color:var(--muted)">Widgets aus dem Katalog ins Raster ziehen (oder <b>+</b>), im Raster verschieben · <i class="ti ti-arrows-horizontal"></i> Breite · <i class="ti ti-settings"></i> Einstellungen · <i class="ti ti-x"></i> entfernen</span>
    <button type="button" class="btn btn-small" id="dw-edit-btn" onclick="dwEdit(true)"><i class="ti ti-layout-dashboard"></i> Dashboard anpassen</button>
    <button type="button" class="btn btn-small" id="dw-reset-btn" style="display:none" onclick="dwReset()" title="Standard-Zusammenstellung wiederherstellen"><i class="ti ti-restore"></i> Standard</button>
    <button type="button" class="btn btn-small" id="dw-cancel-btn" style="display:none" onclick="location.reload()">Abbrechen</button>
    <button type="button" class="btn btn-small btn-primary" id="dw-save-btn" style="display:none" onclick="dwSave()"><i class="ti ti-check"></i> Fertig</button>
  </div>

  <div class="dw-cat" id="dw-cat">
    <div style="font-size:13px;font-weight:600"><i class="ti ti-apps"></i> Widget-Katalog</div>
    {{range .WidgetCatalog}}
    <h4>{{.Name}}</h4>
    <div class="dw-cat-list" data-dw-catalog>
      {{range .Items}}<div class="dw-cat-item" data-type="{{.Type}}" data-name="{{.Name}}" data-icon="{{.Icon}}" data-size="{{.Size}}" data-refresh="{{.Refresh}}" data-config="{{.Config}}">
        <i class="ti {{.Icon}}"></i><div><b>{{.Name}}</b><small>{{.Desc}}</small></div>
        <button type="button" class="add" onclick="dwAddFromCatalog(this.closest('.dw-cat-item'))" title="Hinzufügen" aria-label="{{.Name}} hinzufügen"><i class="ti ti-plus" style="font-size:15px;margin:0"></i></button>
      </div>{{end}}
    </div>
    {{end}}
  </div>

  <div class="dw-grid" id="dw-grid">
    {{range .Widgets}}{{template "dw-card" .}}{{else}}<div class="dw-empty" id="dw-empty">Noch keine Widgets. Über <b>Dashboard anpassen</b> stellst du dir dein Dashboard zusammen.</div>{{end}}
  </div>
</div>

<template id="dw-tpl">{{template "dw-card" (dict "ID" "" "Type" "" "Size" 1 "Title" "" "Def" (dict "Name" "" "Icon" "" "Refresh" 0 "Config" "") "Config" nil)}}</template>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
(function(){
  const root = document.getElementById('dw-root');
  const grid = document.getElementById('dw-grid');
  let sortGrid = null, sortCats = [];
  function body(el){ return el.querySelector('.dw-body'); }
  // Inhalt laden (gespeicherte Widgets per ID, neue als Vorschau per Typ)
  function load(el){
    const b = body(el);
    const id = el.dataset.id, type = el.dataset.type;
    const url = el.dataset.saved === '1' ? '/dashboard/w/' + encodeURIComponent(id) : '/dashboard/w/new?type=' + encodeURIComponent(type);
    b.setAttribute('hx-get', url);
    b.setAttribute('hx-trigger', 'load' + (+el.dataset.refresh > 0 ? ', every ' + el.dataset.refresh + 's' : ''));
    if(window.htmx) htmx.process(b);
  }
  function newId(){ return 'w' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }
  function makeCard(item){
    const el = document.getElementById('dw-tpl').content.firstElementChild.cloneNode(true);
    el.dataset.id = newId(); el.dataset.type = item.dataset.type; el.dataset.size = item.dataset.size;
    el.dataset.refresh = item.dataset.refresh; el.dataset.cfgkind = item.dataset.config; el.dataset.saved = '0';
    el.querySelector('.dw-head > i').className = 'ti ' + item.dataset.icon;
    el.querySelector('.dw-title').textContent = item.dataset.name;
    el.querySelector('.dw-title').dataset.default = item.dataset.name;
    prepCfg(el);
    return el;
  }
  // Einstellungsfelder je nach Widget-Art
  function prepCfg(el){
    const kind = el.dataset.cfgkind;
    el.querySelectorAll('[data-cfg-kind]').forEach(x => x.style.display = x.dataset.cfgKind === kind ? '' : 'none');
  }
  window.dwAddFromCatalog = function(item){
    const el = makeCard(item);
    const empty = document.getElementById('dw-empty'); if(empty) empty.remove();
    grid.appendChild(el); load(el);
    el.scrollIntoView({behavior: 'smooth', block: 'nearest'});
  };
  window.dwEdit = function(on){
    root.classList.toggle('dw-edit-on', on); grid.classList.toggle('dw-edit', on);
    ['dw-reset-btn','dw-cancel-btn','dw-save-btn','dw-hint'].forEach(id => document.getElementById(id).style.display = on ? '' : 'none');
    document.getElementById('dw-edit-btn').style.display = on ? 'none' : '';
    if(!on || !window.Sortable) return;
    sortGrid = Sortable.create(grid, {group: {name: 'dw', pull: false, put: true}, animation: 150, ghostClass: 'dw-ghost', delay: 180, delayOnTouchOnly: true, filter: '.dw-tools button, .dw-cfg, .dw-note', preventOnFilter: false,
      onAdd: function(e){
        const el = makeCard(e.item); e.item.replaceWith(el); load(el);
        const empty = document.getElementById('dw-empty'); if(empty) empty.remove();
      }});
    document.querySelectorAll('[data-dw-catalog]').forEach(list => sortCats.push(Sortable.create(list, {group: {name: 'dw', pull: 'clone', put: false}, sort: false, animation: 150, delay: 180, delayOnTouchOnly: true, filter: '.add', preventOnFilter: false})));
  };
  // Werkzeuge im Widget
  grid.addEventListener('click', function(e){
    const btn = e.target.closest('[data-dw-act]'); if(!btn) return;
    const el = btn.closest('.dw'); const act = btn.dataset.dwAct;
    if(act === 'remove') el.remove();
    if(act === 'size') el.dataset.size = String((+el.dataset.size % 4) + 1);
    if(act === 'cfg') el.classList.toggle('cfg-open');
  });
  // Notizzettel: immer beschreibbar, speichert kurz nach der letzten Eingabe
  function saveNote(el, ta){
    const st = el.querySelector('.dw-note-st');
    if(el.dataset.saved !== '1'){ if(st) st.textContent = 'Wird mit „Fertig“ gespeichert'; return; }
    if(st) st.textContent = 'Speichert…';
    fetch('/dashboard/w/' + encodeURIComponent(el.dataset.id) + '/note', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({note: ta.value}), credentials: 'same-origin'})
      .then(r => r.json().then(j => { if(!r.ok || !j.success) throw new Error(j.error || 'Speichern fehlgeschlagen'); }))
      .then(() => { if(st) st.textContent = 'Gespeichert'; })
      .catch(err => { if(st) st.textContent = '⚠ ' + err.message; });
  }
  // beim Verlassen des Feldes sofort speichern, statt auf den Timer zu warten
  grid.addEventListener('focusout', function(e){
    const ta = e.target; if(!ta.matches || !ta.matches('.dw-note') || !ta._t) return;
    clearTimeout(ta._t); ta._t = null; saveNote(ta.closest('.dw'), ta);
  });
  grid.addEventListener('input', function(e){
    if(e.target.matches('.dw-note')){
      const el = e.target.closest('.dw'), ta = e.target;
      const store = el.querySelector('[data-cfg="note"]'); if(store) store.value = ta.value;
      const st = el.querySelector('.dw-note-st'); if(st) st.textContent = '';
      clearTimeout(ta._t); ta._t = setTimeout(() => { ta._t = null; saveNote(el, ta); }, 800);
      return;
    }
    if(e.target.matches('[data-cfg="title"]')){
      const t = e.target.closest('.dw').querySelector('.dw-title');
      t.textContent = e.target.value.trim() || t.dataset.default;
    }
  });
  function collect(){
    return [...grid.querySelectorAll('.dw')].map(el => {
      const cfg = {};
      el.querySelectorAll('[data-cfg]').forEach(f => {
        const box = f.closest('[data-cfg-kind]');
        if(box && box.style.display === 'none') return; // gehoert zu einer anderen Widget-Art
        if(f.value.trim() !== '') cfg[f.dataset.cfg] = f.value;
      });
      return {id: el.dataset.id, type: el.dataset.type, size: +el.dataset.size, config: cfg};
    });
  }
  async function post(payload){
    const res = await fetch('/dashboard/widgets', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload), credentials: 'same-origin'});
    const json = await res.json().catch(() => ({}));
    if(!res.ok || !json.success) throw new Error(json.error || 'Speichern fehlgeschlagen');
  }
  window.dwSave = async function(){
    try { await post({widgets: collect()}); location.reload(); }
    catch(e){ alert(e.message); }
  };
  window.dwReset = async function(){
    if(!confirm('Eigene Zusammenstellung verwerfen und die Standard-Widgets anzeigen?')) return;
    try { await post({reset: true}); location.reload(); }
    catch(e){ alert(e.message); }
  };
  grid.querySelectorAll('.dw').forEach(el => { prepCfg(el); load(el); });
})();
</script>
{{end}}

{{define "dw-card"}}
<div class="dw" data-id="{{.ID}}" data-type="{{.Type}}" data-size="{{.Size}}" data-refresh="{{.Def.Refresh}}" data-cfgkind="{{.Def.Config}}" data-saved="1">
  <div class="dw-head">
    <i class="ti {{.Def.Icon}}"></i><span class="dw-title" data-default="{{.Def.Name}}">{{.Title}}</span>
    <span class="dw-tools">
      <button type="button" data-dw-act="size" title="Breite ändern" aria-label="Breite ändern"><i class="ti ti-arrows-horizontal"></i></button>
      <button type="button" data-dw-act="cfg" title="Einstellungen" aria-label="Einstellungen"><i class="ti ti-settings"></i></button>
      <button type="button" data-dw-act="remove" title="Entfernen" aria-label="Entfernen"><i class="ti ti-x"></i></button>
    </span>
  </div>
  <div class="dw-cfg">
    <label>Überschrift (leer = Standard)</label><input class="form-input" data-cfg="title" maxlength="40" value="{{with .Config}}{{index . "title"}}{{end}}">
    <div data-cfg-kind="links" style="display:flex;flex-direction:column;gap:4px"><label>Links – je Zeile <code>Name | Adresse</code>, z. B. <code>Presse 2 | /infrastructure/…</code> oder <code>Wetter | https://…</code></label><textarea class="form-input" data-cfg="links">{{with .Config}}{{index . "links"}}{{end}}</textarea></div>
    <div data-cfg-kind="note" class="dw-note-store"><textarea data-cfg="note" maxlength="2000" hidden>{{with .Config}}{{index . "note"}}{{end}}</textarea></div>
  </div>
  <div class="dw-body"><span class="dw-loading">Lädt…</span></div>
</div>
{{end}}

{{define "dw-body"}}
{{if .Err}}<div class="dw-none"><i class="ti ti-alert-circle"></i> {{.Err}}</div>
{{else if eq .Def.Type "stat_tickets" "stat_faults" "stat_maintenance" "stat_stock" "stat_my_tasks" "stat_my_hours"}}
  {{with .Data}}<a class="dw-stat c-{{.Color}}" href="{{.URL}}"><span class="v">{{.Value}}</span><span class="s{{if .Alert}} alert{{end}}">{{.Sub}}</span></a>{{end}}
{{else if eq .Def.Type "list_mine" "list_faults" "list_maintenance" "list_stock"}}
  <div class="dw-list">{{range .Data}}
    <a class="dw-li" href="{{.URL}}"><i class="ti {{.Icon}}"></i><span class="tx"><span class="t">{{.Title}}</span>{{if .Sub}}<span class="s">{{.Sub}}</span>{{end}}</span>{{if .Badge}}<span class="badge {{.BadgeClass}}">{{.Badge}}</span>{{end}}</a>
  {{else}}<div class="dw-none"><i class="ti ti-circle-check" style="color:var(--green)"></i> Nichts offen – alles erledigt.</div>{{end}}</div>
{{else if eq .Def.Type "quick_actions"}}
  <div class="dw-qa">{{range .Data}}<a class="q-{{.Color}}" href="{{.URL}}"><i class="ti {{.Icon}}"></i>{{.Name}}</a>{{end}}</div>
{{else if eq .Def.Type "quick_links"}}
  <div class="dw-links">{{range .Data}}<a href="{{.URL}}"{{if not (hasPrefix .URL "/")}} target="_blank" rel="noopener"{{end}}><i class="ti {{if hasPrefix .URL "/"}}ti-arrow-right{{else}}ti-external-link{{end}}"></i>{{.Name}}</a>
  {{else}}<div class="dw-none">Noch keine Links – unter <b>Dashboard anpassen</b> → <i class="ti ti-settings"></i> eintragen.</div>{{end}}</div>
{{else if eq .Def.Type "note"}}
  <textarea class="dw-note" maxlength="2000" placeholder="Hier schreiben – wird automatisch gespeichert" aria-label="Notizzettel">{{.Data}}</textarea><div class="dw-note-st"></div>
{{else if eq .Def.Type "chart_trend"}}
  {{with .Data}}<div class="dw-chart">{{range .Days}}<div class="d" title="{{.Label}}: {{.Tickets}} Tickets, {{.Faults}} Störungen"><div class="bars">{{if $.Data.ShowTickets}}<span class="b bt" style="height:{{.HT}}%"></span>{{end}}{{if $.Data.ShowFaults}}<span class="b bf" style="height:{{.HF}}%"></span>{{end}}</div><span class="l">{{.Label}}</span></div>{{end}}</div>
  <div class="dw-legend">{{if .ShowTickets}}<span class="lt">Tickets ({{.SumTickets}})</span>{{end}}{{if .ShowFaults}}<span class="lf">Störungen ({{.SumFaults}})</span>{{end}}</div>{{end}}
{{else if eq .Def.Type "my_shifts"}}
  <div class="dw-shifts">{{range .Data}}<div class="d{{if .Today}} today{{end}}"><div>{{.Day}} {{.Date}}</div><div class="sh" {{if .Color}}style="color:{{css .Color}}"{{end}} title="{{.Name}}">{{if .Short}}{{.Short}}{{else}}–{{end}}</div><div class="tm">{{if .Time}}{{.Time}}{{else}}frei{{end}}</div></div>{{end}}</div>
{{end}}
{{end}}
