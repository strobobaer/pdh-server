{{/* Server-Einstellungen → Ausfallschutz → Betriebsart (internal/web/ha.go). Stil: vpn-style (in dr-admin geladen). */}}
{{/* Wartungsfenster: Formular für Verbund (ha-admin) und Einzelserver (dr-admin). Daten: Action, Window, Can, Faulty, FaultyAction, FaultyField, Next, Last (internal/web/maint_window.go). */}}
{{define "maint-window-form"}}{{$w := .Window}}
<div class="card-title" style="margin-top:14px" id="maint-window"><span><i class="ti ti-calendar-time"></i> {{t "Wartungsfenster"}}</span>
  <span class="vp-state {{if eq $w.Mode "off"}}off{{else}}ok{{end}}"><span class="vp-dot{{if ne $w.Mode "off"}} on{{end}}"></span> {{if eq $w.Mode "off"}}{{t "aus"}}{{else if eq $w.Mode "daily"}}{{t "täglich"}}{{else}}{{t "wöchentlich"}}{{end}}</span></div>
<p class="vp-hint">{{t "In diesem Zeitfenster holt sich das PDH den neuesten Stand von GitHub und spielt ihn ein – mit Abmeldung der Anwender nur für kurze Zeit. Vorher laufen die Sicherungen."}}</p>
{{if .Next.IsZero}}{{else}}<p class="vp-hint"><i class="ti ti-clock-play"></i> {{t "Nächster möglicher Beginn"}}: <b>{{.Next.Local.Format "02.01.2006 15:04"}}</b></p>{{end}}
{{if .Last}}<p class="vp-hint"><i class="ti ti-history"></i> {{t "Letztes Ergebnis"}}: {{.Last}}</p>{{end}}
{{if .Can}}
<form method="post" action="{{.Action}}" class="vp-form">
  <div><label class="form-label">{{t "Wartungsfenster"}}</label><select class="form-input" name="mode">
    <option value="off"{{if eq $w.Mode "off"}} selected{{end}}>{{t "aus"}}</option>
    <option value="daily"{{if eq $w.Mode "daily"}} selected{{end}}>{{t "täglich"}}</option>
    <option value="weekly"{{if eq $w.Mode "weekly"}} selected{{end}}>{{t "wöchentlich"}}</option></select></div>
  <div><label class="form-label">{{t "Wochentag (nur wöchentlich)"}}</label><select class="form-input" name="weekday">
    <option value="1"{{if eq $w.Weekday 1}} selected{{end}}>{{t "Montag"}}</option>
    <option value="2"{{if eq $w.Weekday 2}} selected{{end}}>{{t "Dienstag"}}</option>
    <option value="3"{{if eq $w.Weekday 3}} selected{{end}}>{{t "Mittwoch"}}</option>
    <option value="4"{{if eq $w.Weekday 4}} selected{{end}}>{{t "Donnerstag"}}</option>
    <option value="5"{{if eq $w.Weekday 5}} selected{{end}}>{{t "Freitag"}}</option>
    <option value="6"{{if eq $w.Weekday 6}} selected{{end}}>{{t "Samstag"}}</option>
    <option value="0"{{if eq $w.Weekday 0}} selected{{end}}>{{t "Sonntag"}}</option></select></div>
  <div><label class="form-label">{{t "Beginn"}}</label><select class="form-input" name="begin">
    <option value="after_files"{{if eq $w.Begin "after_files"}} selected{{end}}>{{t "nach dem Abgleich der Dateien"}}</option>
    <option value="before_files"{{if eq $w.Begin "before_files"}} selected{{end}}>{{t "vor dem Abgleich der Dateien"}}</option></select></div>
  <div><label class="form-label">{{t "Uhrzeit (nur ohne Ausfallschutz-Sicherung)"}}</label><input class="form-input" type="time" name="clock" value="{{$w.Clock}}"></div>
  <div><label class="form-label">{{t "Spätestens beginnen bis"}}</label><input class="form-input" type="time" name="latest" value="{{$w.Latest}}"></div>
  <div><label class="form-label"><input type="checkbox" name="install" value="1"{{if $w.Install}} checked{{end}}> {{t "Neue Version einspielen"}}</label></div>
  {{if .Cluster}}{{/* nur im Verbund: Update-Art und Rollentausch (Einzelserver speichert die Standardwerte) */}}
  <div><label class="form-label">{{t "Update-Art"}}</label><select class="form-input" name="kind">
    <option value="rolling"{{if eq $w.Kind "rolling"}} selected{{end}}>{{t "ohne Unterbrechung (Rollentausch)"}}</option>
    <option value="sequential"{{if eq $w.Kind "sequential"}} selected{{end}}>{{t "alle nacheinander (kurze Unterbrechung)"}}</option></select></div>
  <div><label class="form-label"><input type="checkbox" name="swap" value="1"{{if $w.Swap}} checked{{end}}> {{t "Rollen im Fenster tauschen"}}</label></div>
  {{end}}
  <div><label class="form-label">{{t "Countdown vor der Sperre (min)"}}</label><input class="form-input" type="number" name="countdown_min" min="1" max="15" value="{{$w.CountdownMin}}"></div>
  <div><label class="form-label">{{t "Höchstdauer der Sperre (min)"}}</label><input class="form-input" type="number" name="lock_max_min" min="10" max="120" value="{{$w.LockMaxMin}}"></div>
  <div><button class="btn" type="submit"><i class="ti ti-device-floppy"></i> {{t "Speichern"}}</button></div>
</form>
<p class="vp-hint">{{t "Mit Ausfallschutz-Sicherung beginnt das Fenster nach der Grundsicherung des Tages, sonst zur eingestellten Uhrzeit. Ist „spätestens bis“ überschritten, fällt das Fenster aus und das PDH meldet es."}}</p>
{{else}}
<p class="vp-hint">{{t "Das Wartungsfenster darf nur ändern, wer das Recht „Wartungsfenster einstellen“ hat – im Verbund am aktiven oder am ersten Server."}}</p>
{{end}}
{{if .Faulty}}
<div class="vp-msg err"><i class="ti ti-bug"></i> <b>{{t "Als fehlerhaft gemerkte Versionen"}}</b> – {{t "sie werden nicht mehr automatisch eingespielt."}}
  {{range .Faulty}}
  <form method="post" action="{{$.FaultyAction}}" style="display:inline-flex;gap:6px;align-items:center;margin:4px 8px 0 0">
    <code>{{.}}</code><input type="hidden" name="{{$.FaultyField}}" value="{{.}}">
    {{if $.Can}}<button class="btn btn-small" type="submit"><i class="ti ti-restore"></i> {{t "Wieder zulassen"}}</button>{{end}}
  </form>
  {{end}}
</div>
{{end}}
{{end}}

{{/* Fortschritt eines laufenden Auftrags (Daten: ha.UpdateView). Lädt sich alle 5 s selbst nach. */}}
{{define "maint-progress"}}
<div id="ha-update-progress" class="vp-msg" role="status" hx-get="/admin/server-config?tab=dr" hx-trigger="every 5s" hx-select="#ha-update-progress" hx-target="this" hx-swap="outerHTML">
  <i class="ti ti-loader"></i> <b>{{if .RollingBack}}{{t "Update wird zurückgesetzt"}}{{else}}{{t "Update läuft"}}{{end}}</b>{{if .ToVersion}} – {{.FromVersion}} → {{.ToVersion}}{{end}}
  <div class="vp-meta">{{.Text}}</div>
  <progress value="{{.Percent}}" max="100" style="width:100%;accent-color:var(--accent)">{{.Percent}} %</progress>
  {{if .Steps}}<ol class="vp-hint" style="padding-left:18px;margin:6px 0 0">{{$s := .Step}}{{range $i, $n := .Steps}}<li{{if eq $i $s}} style="font-weight:600;color:var(--text)"{{end}}>{{$n}}</li>{{end}}</ol>{{end}}
  {{if .Locked}}<div class="vp-meta"><i class="ti ti-lock"></i> {{t "Das PDH ist gesperrt – noch höchstens"}} {{.RemainingS}} s</div>{{end}}
</div>
{{end}}

{{define "ha-admin"}}{{$v := .}}
<div class="card" id="ha-mode">
  <div class="card-title"><span><i class="ti ti-server-2"></i> Betriebsart: {{if and .Installed .Status.Configured}}{{.ModeText}}{{else}}Einzel{{end}}</span>
    {{if and .Installed .Status.Configured (not .Err)}}<span class="vp-state {{if .Status.Maint}}off{{else}}ok{{end}}"><span class="vp-dot{{if not .Status.Maint}} on{{end}}"></span> {{if .Status.Maint}}Wartung – Automatik aus{{else}}Automatik an{{end}}</span>{{end}}</div>

  {{if .JoinCode}}
  <div class="vp-show">
    <b><i class="ti ti-key"></i> Beitrittscode</b> – wird nur jetzt angezeigt, einmal verwendbar, gültig bis {{.JoinUntil}}.
    <ol class="vp-hint" style="padding-left:18px;margin:8px 0 0">
      <li><a class="btn btn-small btn-primary" href="/admin/server-config/ha/join-script"><i class="ti ti-download"></i> pdh-ha-join.sh</a> auf den neuen Server (frisches Ubuntu) kopieren.</li>
      <li>Dort ausführen:<div class="vp-cmd"><code class="vp-key">{{.JoinCmd}}</code></div></li>
    </ol>
  </div>
  {{end}}

  {{if .Err}}
  <div class="vp-msg err"><i class="ti ti-alert-triangle"></i> {{.Err}}</div>
  <p class="vp-hint">Der Dienst <code>pdh-ha</code> ist installiert, antwortet aber nicht richtig. Auf dem Server prüfen: <code>sudo systemctl status pdh-ha</code></p>
  {{end}}

  {{if .NeedsSetup}}
  <p class="vp-hint">Dieser Server läuft allein. Mit einem zweiten Server (und einem Zeugen) übernimmt der zweite, wenn dieser ausfällt. Zuerst wird hier der Dienst <code>pdh-ha</code> eingerichtet – dann gibt es Beitrittscodes für die weiteren Server.</p>
  {{if .InstallErr}}<div class="vp-msg err"><i class="ti ti-alert-triangle"></i> {{.InstallErr}}</div>{{end}}
  {{if .Install.Running}}<div class="vp-msg"><i class="ti ti-loader"></i> Installation läuft … (Seite neu laden für den Fortschritt)</div>{{end}}
  {{if .Install.Error}}<div class="vp-msg err"><i class="ti ti-alert-triangle"></i> {{.Install.Error}}</div>{{end}}
  {{if .Install.Log}}<pre class="vp-hint" style="background:var(--bg3);border-radius:8px;padding:8px;overflow:auto;max-height:240px">{{.Install.Log}}</pre>{{end}}
  {{if not .Install.Running}}
  <form method="post" action="/admin/server-config/ha/setup" class="vp-form">
    <div><label class="form-label">Adressen dieses Servers (LAN, WireGuard)</label><input class="form-input" name="addrs" value="{{.SuggestText}}" placeholder="z. B. 192.168.1.10, 10.66.0.1"></div>
    <div><button class="btn btn-primary" type="submit"><i class="ti ti-shield-plus"></i> Ausfallschutz einrichten</button></div>
  </form>
  <p class="vp-hint">Die Adressen nutzen die Server untereinander (Port 7480). Mehrere mit Komma trennen.</p>
  {{end}}
  {{else if not .Err}}
  {{if .Update.Active}}{{template "maint-progress" .Update}}{{end}}
  {{if .Status.Observe}}<div class="vp-msg err"><i class="ti ti-eye"></i> <b>Automatische Umschaltung: Beobachtung.</b> Fällt ein Server aus, meldet der Dienst nur, was er tun würde. „Rollen tauschen“ und „Übernahme erzwingen“ wirken echt{{if .HasMirror}}, der Datenbank-Spiegel läuft{{end}}.</div>{{else}}<div class="vp-msg err"><i class="ti ti-bolt"></i> <b>Automatische Umschaltung: echt.</b> Zugangsweg wird erst mit Teil 5 umgeschaltet – nach einer Übernahme ist das PDH nur unter der Adresse des neuen aktiven Knotens erreichbar.</div>{{end}}
  {{if and .HasMirror (not .Status.SwapTested)}}<div class="vp-msg"><i class="ti ti-list-check"></i> <b>Pflicht-Testumschaltung offen:</b> einmal „Rollen tauschen“ und zurück. Erst danach lässt sich die automatische Umschaltung auf „echt“ stellen.</div>{{else if .HasMirror}}<p class="vp-hint"><i class="ti ti-circle-check"></i> Pflicht-Testumschaltung erledigt.</p>{{end}}
  {{range .Status.Warnings}}<div class="vp-msg err"><i class="ti ti-alert-triangle"></i> {{.}}</div>{{end}}
  {{if .WitnessStale}}<div class="vp-msg err"><i class="ti ti-alert-triangle"></i> <b>{{.WitnessStale}}</b> – {{t "Der Zeuge hat das Update nicht mitgemacht. Befehl auf dem Zeugen-Rechner ausführen:"}}<span class="vp-cmd"><code class="vp-key">{{.WitnessCmd}}</code></span></div>{{end}}
  {{if .VersionDiff}}<p class="vp-hint">Nach einem PDH-Update auf dem zweiten Server und dem Zeugen-Rechner ausführen:{{if .UpdateCmd}}<span class="vp-cmd"><code class="vp-key">{{.UpdateCmd}}</code></span>{{else}} <code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt;</code> – den Commit zeigt <code>pdh-ha version</code> auf dem ersten Server.{{end}} Zeuge als Container: siehe Handbuch.</p>{{end}}
  {{if .Status.Blocked}}<div class="vp-msg err"><i class="ti ti-lock"></i> <b>Übernahme gesperrt: {{.Status.Blocked}}</b><br>Die Automatik übernimmt solange nicht. Fällt der aktive Server sicher aus, hilft „Übernahme erzwingen“.</div>{{end}}

  <table class="table" style="margin-top:8px">
    <tr><th>Kennung</th><th>Art</th><th>Rolle</th><th>Amtszeit</th><th>Version</th>{{if .HasMirror}}<th>Datenbank</th>{{end}}<th>Gateway</th><th>Zuletzt gesehen</th><th>Wege</th></tr>
    {{range .Nodes}}
    <tr><td><b>{{.ID}}</b>{{if .Self}} <span class="rec-sub">(hier)</span>{{end}}</td><td>{{.KindText}}</td><td><span class="vp-conn{{if eq .Role "aktiv"}} on{{else if eq .Role "abgeschaltet"}} revoked{{end}}">{{.Role}}</span></td>
      <td>{{if .Term}}{{.Term}}{{else}}–{{end}}</td><td>{{.Version}}{{if .Commit}} <span class="rec-sub">({{.ShortCommit}})</span>{{end}}</td>
      {{if $v.HasMirror}}<td>{{if eq .Kind "witness"}}–{{else}}<span class="vp-conn{{if eq .PG "primary"}} on{{else if eq .PG "error"}} revoked{{end}}">{{.PGText}}</span>{{if eq .PG "primary"}}<br><span class="vp-meta">{{if .Sync}}synchron{{else}}asynchron{{end}} · Rückstand {{.LagText}}</span>{{if .Stale}}<br><span class="vp-conn lost">Partner nicht aktuell</span>{{end}}{{else if eq .PG "standby"}}<br><span class="vp-meta">{{if .DataCurrent}}aktuell{{else}}<b>nicht aktuell</b>{{end}}</span>{{end}}{{end}}</td>{{end}}
      <td>{{if eq .Kind "witness"}}–{{else if .Gateway}}erreichbar{{else}}<b>nein</b>{{end}}</td>
      <td>{{.SeenText}}{{if .SkewWarn}}<br><span class="vp-conn lost">Uhrzeit prüfen ({{printf "%.0f" .ClockSkew}} s)</span>{{end}}</td>
      <td>{{range .Paths}}<div><span class="vp-conn{{if .Alive}} on{{else}} revoked{{end}}">{{.Addr}}</span> <span class="vp-meta">{{.Age}}{{if .Err}} · {{.Err}}{{end}}</span></div>{{else}}{{if not .Self}}<span class="vp-meta">–</span>{{end}}{{end}}</td></tr>
    {{end}}
  </table>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
    {{if .CanJoinNode}}<form method="post" action="/admin/server-config/ha/join-code"><input type="hidden" name="role" value="node"><button class="btn btn-small btn-primary" type="submit"><i class="ti ti-key"></i> Beitrittscode: zweiter Server</button></form>{{end}}
    {{if .CanJoinWitness}}<form method="post" action="/admin/server-config/ha/join-code"><input type="hidden" name="role" value="witness"><button class="btn btn-small btn-primary" type="submit"><i class="ti ti-key"></i> Beitrittscode: Zeuge</button></form>{{end}}
    {{if .CanCommand}}<form method="post" action="/admin/server-config/ha/maintenance">{{if .Status.Maint}}<input type="hidden" name="on" value="0"><button class="btn btn-small" type="submit"><i class="ti ti-player-play"></i> Automatik an</button>{{else}}<input type="hidden" name="on" value="1"><button class="btn btn-small" type="submit"><i class="ti ti-player-pause"></i> Automatik aus (Wartung)</button>{{end}}</form>{{end}}
    {{if .CanSwap}}<form method="post" action="/admin/server-config/ha/command"{{if .HasMirror}} onsubmit="return confirm('Rollen tauschen? Dateien werden erst mit Teil 6 gespiegelt – auf dem anderen Knoten fehlen neue Anhänge.')"{{end}}><input type="hidden" name="cmd" value="swap"><button class="btn btn-small" type="submit"><i class="ti ti-arrows-exchange"></i> Rollen tauschen</button></form>{{end}}
  </div>

  {{if .HasPeers}}
  {{if .CanForce}}
  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-alert-octagon"></i> Übernahme erzwingen</span></div>
  <p class="vp-hint">Nur wenn der aktive Server sicher aus ist. Laufen beide als aktiv, können Daten verloren gehen. Zur Bestätigung <b>ÜBERNEHMEN</b> eintippen.</p>
  <form method="post" action="/admin/server-config/ha/command" class="vp-form">
    <input type="hidden" name="cmd" value="force_takeover">
    <div><label class="form-label">Bestätigung</label><input class="form-input" name="confirm" autocomplete="off" placeholder="ÜBERNEHMEN"></div>
    <div><button class="btn btn-small btn-danger" type="submit"><i class="ti ti-bolt"></i> Übernahme erzwingen</button></div>
  </form>
  {{end}}
  {{if .Status.CAHolder}}
  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-trash"></i> Knoten entfernen</span></div>
  <form method="post" action="/admin/server-config/ha/remove" class="vp-form">
    <div><label class="form-label">Server oder Zeuge</label><select class="form-input" name="id">{{range .Status.Peers}}<option value="{{.ID}}">{{.ID}} ({{.KindText}})</option>{{end}}</select></div>
    <div><label class="form-label"><input type="checkbox" name="gone" value="1"> dauerhaft weg (nicht erreichbar)</label></div>
    <div><button class="btn btn-small" type="submit"><i class="ti ti-trash"></i> Entfernen</button></div>
  </form>
  <p class="vp-hint">Den Zeugen zuerst entfernen. Den aktiven Server vorher per „Rollen tauschen“ abgeben.</p>
  {{end}}
  {{end}}

  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-clock"></i> Zeiten</span></div>
  {{if .CanEditSettings}}{{$f := .Form}}
  <form method="post" action="/admin/server-config/ha/settings" class="vp-form">
    <div><label class="form-label">Takt (s)</label><input class="form-input" type="number" name="tick_s" min="1" max="5" value="{{index $f "tick_s"}}"></div>
    <div><label class="form-label">Selbst-Abschaltung nach (s)</label><input class="form-input" type="number" name="fence_s" min="3" max="300" value="{{index $f "fence_s"}}"></div>
    <div><label class="form-label">Übernahme mit Zeuge nach (s)</label><input class="form-input" type="number" name="takeover_trio_s" min="10" max="600" value="{{index $f "takeover_trio_s"}}"></div>
    <div><label class="form-label">Übernahme ohne Zeuge nach (s)</label><input class="form-input" type="number" name="takeover_duo_s" min="10" max="600" value="{{index $f "takeover_duo_s"}}"></div>
    <div><label class="form-label">Wartezeit nach Umschaltung (min)</label><input class="form-input" type="number" name="cooldown_min" min="0" max="1440" value="{{index $f "cooldown_min"}}"></div>
    <div><label class="form-label">Umschaltungen je Tag</label><input class="form-input" type="number" name="max_per_day" min="1" max="20" value="{{index $f "max_per_day"}}"></div>
    <div><label class="form-label">Gateway-Ziele (Komma)</label><input class="form-input" name="gateway_targets" value="{{.TargetsText}}" placeholder="z. B. 192.168.1.1"></div>
    <div><label class="form-label">Asynchron nach (s)</label><input class="form-input" type="number" name="async_after_s" min="3" max="300" value="{{index $f "async_after_s"}}"></div>
    <div><label class="form-label">Verzögerungsgrenze (MB)</label><input class="form-input" type="number" name="lag_limit_mb" min="1" max="1024" value="{{index $f "lag_limit_mb"}}"></div>
    <div><label class="form-label">Höchstmenge zurückgehaltener Änderungen (GB)</label><input class="form-input" type="number" name="slot_keep_gb" min="1" max="1000" value="{{index $f "slot_keep_gb"}}"></div>
    <div><label class="form-label">Automatische Umschaltung</label><select class="form-input" name="auto_mode">
      <option value="observe"{{if not .AutoReal}} selected{{end}}>Beobachtung (nur melden)</option>
      <option value="real"{{if .AutoReal}} selected{{end}}{{if not .Status.SwapTested}} disabled{{end}}>echt{{if not .Status.SwapTested}} – Erst einmal Rollen tauschen – hin und zurück{{end}}</option>
    </select></div>
    <div><button class="btn" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
  </form>
  <p class="vp-hint">Übernahmezeit mindestens Selbst-Abschaltung + 2 × Takt + 5 s.</p>
  {{else}}
  <p class="vp-hint">Einstellungen bitte am aktiven Server ändern.</p>
  {{end}}

  {{if .IsCluster}}
  {{template "maint-window-form" (dict "Action" "/admin/server-config/ha/window" "Window" .Window "Can" (and .CanEditSettings (not .NoWindowPerm)) "Faulty" .Faulty "FaultyAction" "/admin/server-config/ha/faulty-allow" "FaultyField" "commit" "Next" .NextWindow "Last" .LastResult "Cluster" true)}}
  <details style="margin-top:10px"><summary>{{t "Notweg: von Hand aktualisieren"}}</summary>
    <p class="vp-hint">{{t "Nur wenn das automatische Update nicht möglich ist: auf dem zweiten Server und auf dem Zeugen-Rechner ausführen."}}</p>
    {{if .WitnessCmd}}<div class="vp-cmd"><code class="vp-key">{{.WitnessCmd}}</code></div>{{else if .UpdateCmd}}<div class="vp-cmd"><code class="vp-key">{{.UpdateCmd}}</code></div>{{else}}<p class="vp-hint"><code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt;</code></p>{{end}}
  </details>
  {{end}}

  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-route"></i> Zugangsweg</span></div>
  <p class="vp-hint">Wie Anwender nach einer Umschaltung den neuen aktiven Server erreichen.</p>
  {{range .AccessRows}}
  <div class="vp-show">
    <i class="ti {{.Icon}}"{{if eq .Level "ok"}} style="color:var(--accent)"{{else if eq .Level "warn"}} style="color:var(--amber)"{{else if eq .Level "err"}} style="color:var(--red)"{{else}} style="color:var(--muted)"{{end}}></i>
    <b>{{.Title}}</b>: {{.State}}
    {{if .Detail}}<div class="vp-meta"{{if eq .Level "err"}} style="color:var(--red)"{{else if eq .Level "warn"}} style="color:var(--amber)"{{end}}>{{.Detail}}</div>{{end}}
  </div>
  {{end}}
  <p class="vp-hint">Tunnel: Der Cloudflare-Tunnel läuft nur auf dem aktiven Server. Die pdhadmin-Seiten folgen mit Teil 6.</p>

  {{if .CanEditSettings}}
  <form method="post" action="/admin/server-config/ha/access" class="vp-form">
    <div><label class="form-label">Mitwandernde Adresse (z. B. 10.77.1.50/24)</label><input class="form-input" name="vip" value="{{.Status.Access.VIP}}" placeholder="10.77.1.50/24"></div>
    <div><label class="form-label"><input type="hidden" name="vip_on" value="0"><input type="checkbox" name="vip_on" value="1"{{if .Status.Access.VIPOn}} checked{{end}}> Adresse mitwandern lassen</label></div>
    <div><button class="btn btn-small" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
  </form>
  <form method="post" action="/admin/server-config/ha/vip-test" class="vp-form" hx-post="/admin/server-config/ha/vip-test" hx-target="#ha-vip-result" hx-indicator="#ha-vip-wait">
    <div><label class="form-label">Testadresse (leer = gespeicherte Adresse)</label><input class="form-input" name="addr" placeholder="{{if .Status.Access.VIP}}{{.Status.Access.VIP}}{{else}}10.77.1.50/24{{end}}"></div>
    <div><button class="btn btn-small" type="submit"><i class="ti ti-plug-connected"></i> Testen</button> <span id="ha-vip-wait" class="htmx-indicator vp-meta">Test läuft, das dauert bis zu 45 s …</span></div>
  </form>
  <div id="ha-vip-result" aria-live="polite"></div>
  <p class="vp-hint">Der Test legt die Adresse nacheinander auf jeden Server und prüft vom anderen aus, ob sie antwortet.</p>

  <form method="post" action="/admin/server-config/ha/access" class="vp-form">
    <div><label class="form-label"><input type="hidden" name="hooks_on" value="0"><input type="checkbox" name="hooks_on" value="1"{{if .Status.Access.HooksOn}} checked{{end}}> Skripte bei Umschaltung ausführen</label></div>
    <div><button class="btn btn-small" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
  </form>
  {{end}}
  {{if .Status.Access.Hooks.Names}}
  {{range .FailedHooks}}<div class="vp-meta" style="color:var(--red)"><b>{{.Name}}</b>: {{.Out}}</div>{{end}}
  <form method="post" action="/admin/server-config/ha/hooks-run" class="vp-form">
    <div><button class="btn btn-small" type="submit"><i class="ti ti-player-play"></i> Jetzt ausführen</button> <span class="vp-meta">Dauert je Skript bis zu 30 s.</span></div>
  </form>
  {{end}}

  {{with .Diverged}}
  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-git-fork"></i> Abgezweigte Daten</span></div>
  <p class="vp-hint">Speicherungen, die nur auf einem Server lagen, als dieser wieder eingegliedert wurde. Sie wurden vollständig gesichert und nicht übernommen. Prüfen und gewünschte Einträge von Hand übernehmen (siehe Handbuch), dann löschen.</p>
  {{range .}}
  <div class="vp-show">
    <b>{{.TimeText}}</b> · Server <b>{{.Node}}</b> · Amtszeit {{.Term}} · {{.SizeText}}
    <div class="vp-meta">{{range .Tables}}{{.Table}}: {{.Insert}} neu, {{.Update}} geändert, {{.Delete}} gelöscht<br>{{else}}keine Tabellenänderungen erkannt{{end}}</div>
    <div class="vp-meta">Abzug: <code>/var/lib/pdh-ha/abgezweigt/{{.ID}}/dump.sql.gz</code> auf {{.Node}}</div>
    <form method="post" action="/admin/server-config/ha/diverged-delete" class="vp-form">
      <input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="node" value="{{.Node}}">
      <div><input class="form-input" name="confirm" autocomplete="off" placeholder="GEPRÜFT"></div>
      <div><button class="btn btn-small" type="submit"><i class="ti ti-trash"></i> Geprüft – löschen</button></div>
    </form>
  </div>
  {{end}}
  {{end}}

  <div class="card-title" style="margin-top:14px"><span><i class="ti ti-list"></i> Ereignisse</span></div>
  {{range .Events}}<div class="vp-ev"><span>{{$v.EventTime .At}}</span><span>{{if eq .Kind "alarm"}}<span class="vp-conn revoked">Alarm</span>{{else if eq .Kind "action"}}<span class="vp-conn lost">würde jetzt</span>{{else if eq .Kind "role"}}<span class="vp-conn on">Rolle</span>{{else if eq .Kind "warn"}}<span class="vp-conn lost">Warnung</span>{{else}}<span class="vp-conn">Info</span>{{end}}</span><span>{{.Text}}</span></div>{{else}}<p class="vp-hint">Noch keine Ereignisse.</p>{{end}}
  {{end}}
</div>
{{end}}
