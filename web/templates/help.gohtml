{{template "base" .}}
{{define "content"}}
<style>
.hb{display:grid;grid-template-columns:240px 1fr;gap:18px;align-items:start}
.hb-toc{position:sticky;top:0;max-height:calc(100vh - 140px);overflow-y:auto;background:var(--bg2);border:1px solid var(--stroke,var(--border));border-radius:8px;padding:8px;box-shadow:var(--shadow-card,none)}
.hb-toc a{display:block;position:relative;padding:6px 10px;border-radius:4px;font-size:12.5px;color:var(--text);opacity:.85}
.hb-toc a:hover{background:var(--fill-hover,var(--bg3));opacity:1}
.hb-toc a.active{background:var(--fill-hover,var(--bg3));opacity:1;font-weight:600}
.hb-toc a.active::before{content:"";position:absolute;left:0;top:50%;width:3px;height:14px;margin-top:-7px;border-radius:2px;background:var(--accent)}
.hb-toc .n{display:inline-block;width:22px;color:var(--muted)}
.hb-body{min-width:0}
.hb-ch{background:var(--bg2);border:1px solid var(--stroke,var(--border));border-radius:8px;box-shadow:var(--shadow-card,none);padding:18px 22px;margin-bottom:14px;scroll-margin-top:12px}
.hb-ch h2{font-size:17px;font-weight:600;margin-bottom:10px;display:flex;gap:8px;align-items:center}
.hb-ch h2 i{color:var(--accent)}
.hb-ch h3{font-size:13.5px;font-weight:600;margin:16px 0 6px;display:flex;gap:6px;align-items:center}
.hb-ch p,.hb-ch li{font-size:13px;line-height:1.6}
.hb-ch p{margin:6px 0}
.hb-ch ul,.hb-ch ol{margin:6px 0 6px 20px}
.hb-ch li{margin:2px 0}
.hb-ch code{font-family:monospace;background:var(--bg3);padding:1px 5px;border-radius:4px;font-size:12px}
.hb-ch kbd{font-family:monospace;font-size:11.5px;border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:0 5px;background:var(--bg3)}
.hb-ch table{font-size:12.5px;margin:8px 0}
.hb-ch td,.hb-ch th{padding:5px 8px;vertical-align:top}
.hb-hide{display:none}
mark{background:rgba(245,158,11,.35);color:inherit;border-radius:3px}
@media (max-width:900px){.hb{grid-template-columns:1fr}.hb-toc{position:static;max-height:none}}
@media print{
  .sidebar,.context,.topbar,.hb-toc,.hb-tools,.global-footer,.hb-shot-tools{display:none!important}
  .app{display:block!important}.main{overflow:visible!important;padding:0!important}
  body{height:auto!important;overflow:visible!important;background:#fff;color:#000}
  .hb{display:block}.hb-ch{border:0;padding:0 0 12px}
  .hb-fig,.hb-howto{break-inside:avoid}
  .hb-hide{display:block!important}
}
</style>

<div class="rec-head hb-tools">
  <div class="t">
    <h1><i class="ti ti-book"></i> PDH-Handbuch</h1>
    <div class="sub">Schritt für Schritt durch alle Module{{if .Version}} · Stand Version {{.Version}}{{end}} · Abschnitte mit <i class="ti ti-refresh"></i> erzeugt das System automatisch</div>
  </div>
  <div class="search-box" style="min-width:260px">
    <i class="ti ti-search" style="color:var(--muted)"></i>
    <input id="hb-q" type="search" placeholder="Im Handbuch suchen …" style="flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)">
  </div>
  <button type="button" class="btn btn-small" onclick="window.print()"><i class="ti ti-printer"></i> Drucken / PDF</button>
</div>

<div class="hb">
  <nav class="hb-toc hb-tools" id="hb-toc" aria-label="Inhaltsverzeichnis"></nav>
  <div class="hb-body" id="hb-body">
    {{template "help-chapters" .}}
    <div id="hb-none" class="hb-ch" style="display:none;text-align:center;color:var(--muted)">Keine Treffer.</div>
  </div>
</div>
{{end}}

{{/* Eigene Bildschirmfotos je Kapitel (Anhaenge mit fester Kapitel-UUID) */}}
{{define "hb-shots"}}
<div class="hb-shots">
  <div data-attach-ref="help:{{.Ref}}" style="display:flex;flex-wrap:wrap;gap:8px;min-height:0"></div>
  {{if .Can}}
  <label class="btn btn-small hb-shot-tools" style="cursor:pointer;margin-top:6px"><i class="ti ti-photo-plus"></i> Bildschirmfoto zu diesem Kapitel hinzufügen
    <input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'help','{{.Ref}}')"></label>
  {{end}}
</div>
{{end}}

{{define "help-chapters"}}
{{template "hb-fig-style"}}
{{$s := .Shots}}{{$can := .CanShots}}

<section class="hb-ch" id="start" data-title="Erste Schritte" data-pages="dashboard account">
  <h2><i class="ti ti-rocket"></i> Erste Schritte</h2>
  <p>Der <b>PDH – Prozess Data Hub</b> ist das gemeinsame Werkzeug für Instandhaltung, Lager und Einkauf: Hier werden Störungen gemeldet und gelöst, Wartungen geplant, Ersatzteile verwaltet und im Team gechattet.</p>
  <div class="hb-howto"><b><i class="ti ti-map-2"></i> Rundgang durch PDH</b>Ein geführter Rundgang zeigt dir in zwei Minuten das Wichtigste – Sprechblasen erklären Navigation, Dashboard, Melden, Seitenleiste und dein Konto.
    <ol class="hb-steps">
      <li>Starten: <button type="button" class="btn btn-small btn-primary" onclick="pdhTour.start('basics')"><i class="ti ti-map-2"></i> Rundgang starten</button> – oder oben im Benutzermenü <b>Rundgang durch PDH</b>. Beim ersten Besuch bietet das Dashboard ihn einmal von selbst an.</li>
      <li><b>Weiter</b> (oder Pfeil rechts) führt zum nächsten Schritt, <b>Zurück</b> (Pfeil links) zum vorigen. <b>Beenden</b> oder Esc bricht jederzeit ab.</li>
      <li>Für einzelne Seiten gibt es eigene Rundgänge – <b>Dashboard</b>, <b>Störungen</b> und <b>Wartung</b>: rechts im Hilfe-Reiter <b>Rundgang für diese Seite</b>. Auf Seiten ohne eigenen Rundgang startet dort der allgemeine.</li>
    </ol></div>
  {{template "hb-fig-layout"}}
  <h3><i class="ti ti-map"></i> So findest du dich zurecht</h3>
  <ul>
    <li><b>Links</b> wählst du das Modul, z. B. Störungen oder Ersatzteile. Die Einträge sind in Gruppen sortiert (Instandhaltung, Material &amp; Anlagen, Personal, Verwaltung, Daten, Hilfe &amp; Links); offen ist immer nur die Gruppe der geöffneten Seite – ein Klick auf eine andere Überschrift klappt diese auf und die übrigen zu.</li>
    <li><b>Navigation anpassen</b> (oben im Benutzermenü): Einträge per Ziehen in andere Gruppen oder eine andere Reihenfolge bringen, Gruppennamen anklicken zum Umbenennen, mit <b>Gruppe</b> eigene Gruppen anlegen, mit <i class="ti ti-trash"></i> löschen (die Einträge wandern nach oben). <b>Fertig</b> speichert die Anordnung an deinem Konto – sie gilt auf jedem Gerät; <b>Standard</b> stellt die Vorgabe wieder her. Neue Funktionen erscheinen automatisch in ihrer Vorgabe-Gruppe.</li>
    <li><b>Oben</b> findest du die <b>Uhr</b> mit Wochentag und Datum, daneben kleine Symbolknöpfe in Gruppen: <i class="ti ti-share"></i> Im Chat teilen, <i class="ti ti-messages"></i> Chat und <i class="ti ti-brain"></i> Copilot, dann <i class="ti ti-device-desktop"></i> Hell/Dunkel und die Sprache, ganz rechts dein Konto. Was ein Knopf tut, zeigt ein kurzer Hinweis, wenn du mit der Maus darauf zeigst. Auf dem Smartphone findest du Copilot in der rechten Seitenleiste (Knopf <i class="ti ti-layout-sidebar-right"></i>). Ein Klick auf die Uhr öffnet die <b>Zeiterfassung</b>; fährst du mit der Maus darüber, siehst du auch die Kalenderwoche.</li>
    <li><b>Rechts</b> liegen senkrechte Reiter (Chat, Suche, Copilot, Aktivität, Hilfe). Ein Klick klappt die Leiste auf, ein zweiter wieder zu.</li>
    <li><b>Wer ist online?</b> Der Reiter <b>Aktivität</b> zeigt oben alle, die PDH gerade geöffnet haben (grüner Punkt), darunter aufklappbar die übrigen mit „zuletzt gesehen“ (z. B. „vor 20 Min.“, „gestern 14:10“). Die Liste aktualisiert sich alle 30 Sekunden; Terminals (Systembenutzer) erscheinen nicht.</li>
    <li><b>Breite ändern:</b> Mit der Maus an den Innenrand der Navigation oder der aufgeklappten rechten Seitenleiste fahren – der Rand färbt sich, der Mauszeiger wird zu <b>↔</b>. Dann ziehen. Dein Browser merkt sich die Breite. <b>Doppelklick</b> auf den Rand stellt die Standardbreite wieder her. Mit der Tastatur: Rand mit Tab anwählen, dann Pfeiltasten. Auf Smartphone und Tablet entfällt das, dort fahren die Leisten über den Inhalt.</li>
    <li>Der <b>Hilfe-Reiter</b> rechts zeigt dir immer das passende Kapitel zur Seite, auf der du gerade bist.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-palette"></i> So stellst du Farben, Design-Stil, Schrift, Größe, Zeilenhöhe und Hell/Dunkel ein</b>
    {{template "hb-fig-look"}}
    <ol class="hb-steps">
      <li>Oben rechts der Knopf <b>Hell/Dunkel</b> (<i class="ti ti-device-desktop"></i> / <i class="ti ti-sun"></i> / <i class="ti ti-moon"></i>) schaltet bei jedem Klick weiter: System, Hell, Dunkel. „System“ folgt der Einstellung deines Geräts.</li>
      <li>Oben rechts auf deinen Namen → Bereich <b>Darstellung</b>: einen Farbkreis antippen, bei <i class="ti ti-layout-grid"></i> den <b>Design-Stil</b> wählen – <b>Fiori</b> (Standard) sieht aus wie SAP, <b>Fluent</b> wie Windows 11 –, eine <b>Schriftart</b> wählen und mit <b>−</b> / <b>+</b> alles kleiner oder größer machen (70 bis 160 %). Du siehst die Änderung sofort.</li>
      <li>Darunter bei <i class="ti ti-line-height"></i> <b>Zeilenhöhe</b> mit <b>−</b> / <b>+</b> die Zeilen in Tabellen und Listen niedriger oder höher machen (70 bis 150 %). Die Schrift in den Zeilen wird dabei automatisch mit kleiner oder größer – niedrig zeigt mehr Zeilen auf einen Blick, hoch ist am Touchscreen leichter zu treffen.</li>
      <li><b>Speichern</b> – dann gilt deine Darstellung ab jetzt immer, auf allen Geräten, an denen du dich anmeldest. Ohne Speichern ist beim nächsten Seitenaufruf wieder die gespeicherte Einstellung da.</li>
      <li><b>Standard</b> (dann Speichern) stellt alles auf den Firmenstandard zurück. Das Gebäude-Symbol <i class="ti ti-building"></i> setzt nur das Farbschema zurück.</li>
    </ol>
    Hell/Dunkel merkt sich nur dein Browser. Fehlen Farbkreise, Design-Stil und Schriftart im Menü, hat der Administrator die eigene Wahl abgeschaltet – Größe und Zeilenhöhe kannst du trotzdem ändern. Am Terminal gilt die Einstellung für alle, die das Terminal benutzen.</div>
  <h3><i class="ti ti-layout-dashboard"></i> Dein Dashboard mit Widgets</h3>
  <p>Die Startseite stellst du dir selbst zusammen – aus <b>Widgets</b> für Schnellzugriffe, Kennzahlen, Listen und Persönliches. Jedes Widget aktualisiert sich von selbst; ein Klick auf eine Zahl oder einen Eintrag führt direkt dorthin.</p>
  {{template "hb-fig-widgets"}}
  <div class="hb-howto"><b><i class="ti ti-layout-dashboard"></i> So stellst du dein Dashboard zusammen</b>
    <ol class="hb-steps">
      <li>Oben im Benutzermenü <b>Dashboard anpassen</b> (von jeder Seite aus – PDH wechselt dafür aufs Dashboard). Der <b>Widget-Katalog</b> öffnet sich, die Widgets bekommen einen gestrichelten Rahmen.</li>
      <li>Ein Widget aus dem Katalog <b>ins Raster ziehen</b> – oder auf <b>+</b> tippen, dann landet es am Ende.</li>
      <li>Widgets im Raster an die gewünschte Stelle <b>ziehen</b> (am Handy kurz halten, dann ziehen). <i class="ti ti-arrows-horizontal"></i> ändert die Breite (1 bis 4 Spalten), <i class="ti ti-x"></i> entfernt das Widget.</li>
      <li><i class="ti ti-settings"></i> öffnet die Einstellungen: eigene Überschrift, bei <b>Eigene Links</b> je Zeile <code>Name | Adresse</code>, bei <b>Anlagen-Schnellübersicht</b> welche Übersicht und ob nur Auffälliges erscheint.</li>
      <li><b>Fertig</b> speichert – deine Zusammenstellung gilt an deinem Konto auf allen Geräten. <b>Abbrechen</b> verwirft die Änderungen, <b>Standard</b> stellt die Grundausstattung wieder her.</li>
    </ol></div>
  <table>
    <tr><td><b>Schnellzugriff</b></td><td><b>Schnellaktionen</b> (große Knöpfe: Neu anlegen, Störung melden, Ticket, Zeit erfassen, Ersatzteil suchen …), <b>Eigene Links</b>, <b>Scannen</b> (QR-Code oder Barcode mit der Handy-Kamera – siehe unten)</td></tr>
    <tr><td><b>Tabelle und Zeitstrahl</b></td><td>Unter den Kacheln stehen die offenen Vorgänge als <b>Tabelle</b> und darunter im <b>Zeitstrahl</b>. Über beiden wählst du wie im Leitstand, was angezeigt wird (Störungen, Tickets, Wartung, Aufgaben, nur überfällige, nur ohne Zuständigen) – dein Browser merkt sich die Auswahl. Eine Zeile antippen öffnet den Vorgang. Der Knopf <i class="ti ti-timeline"></i> <b>Zeitstrahl</b> oben rechts blendet den Zeitstrahl aus und wieder ein; auch das merkt sich der Browser.</td></tr>
    <tr><td><b>Kennzahlen</b></td><td>Offene Tickets, Aktive Störungen, Wartung fällig, Nachbestellen, Meine Aufgaben, Meine Stunden, Verlauf 14 Tage (Tickets und Störungen pro Tag)</td></tr>
    <tr><td><b>Listen</b></td><td><b>Mir zugewiesen</b> (das Dringendste zuerst, Überfälliges rot), Aktuelle Störungen, Wartungen nächste 7 Tage, Bestellliste, <b>Anlagen-Schnellübersicht</b> (Ampel einer <a href="#watch">Schnellübersicht</a> mit NOK-Bauteilen und Störungen)</td></tr>
    <tr><td><b>Persönlich</b></td><td>Meine Schichten (7 Tage), Notizzettel (nur für dich sichtbar; einfach hineinschreiben – wird automatisch gespeichert, auch ohne <b>Dashboard anpassen</b>)</td></tr>
  </table>
  <p>Du siehst im Katalog nur Widgets, für die du die Berechtigung hast – z. B. „Bestellliste“ nur mit <i>Lager ansehen</i>. Am Handy stehen kleine Kennzahlen zu zweit nebeneinander, alles andere über die volle Breite.</p>
  <div class="hb-howto" id="hb-scan"><b><i class="ti ti-scan"></i> So scannst du mit dem Handy</b>
    <ol class="hb-steps">
      <li>Einmalig das Widget <b>Scannen</b> (Katalog → Schnellzugriff) aufs Dashboard legen.</li>
      <li><b>Code scannen</b> antippen und den Kamerazugriff erlauben. QR-Code oder Barcode in den Rahmen halten – PDH erkennt ihn von selbst und öffnet das Passende.</li>
      <li>Kann der Browser nicht live scannen (z. B. iPhone), öffnet sich stattdessen die Kamera für ein Foto; PDH liest den Code daraus. Klappt auch das nicht, die Nummer unter dem Strichcode eintippen.</li>
    </ol>
    Der QR-Code einer Anlage öffnet ihre Infoseite mit den offenen Vorgängen, ein Etikett oder eine Kanban-Karte die Buchung, eine EAN oder Teilenummer das Ersatzteil. Ein <b>Handscanner</b> (Tastatur-Modus) schreibt einfach ins Feld darunter – mit Enter geht es weiter.</div>
  <h3><i class="ti ti-device-mobile"></i> Am Smartphone und Tablet</h3>
  {{template "hb-fig-mobile"}}
  <p>Das PDH passt sich der Bildschirmgröße an – es gibt keine eigene App, der Browser genügt.</p>
  <div class="hb-howto"><b><i class="ti ti-device-mobile"></i> So bedienst du das PDH am Smartphone</b>
    <ol class="hb-steps">
      <li><b>☰</b> oben links öffnet die Navigation. Ein Modul antippen – oder daneben auf die abgedunkelte Fläche tippen, um sie zu schließen.</li>
      <li>Oben rechts: <i class="ti ti-messages"></i> Chat, <i class="ti ti-device-desktop"></i> Hell/Dunkel, <i class="ti ti-layout-sidebar-right"></i> Suche, Copilot, Aktivität und Hilfe, <i class="ti ti-user"></i> dein Menü (dort auch <b>Im Chat teilen</b> und die Darstellung). Die <b>Flagge</b> daneben stellt die Sprache um: Deutsch, Englisch, Rumänisch, Türkisch oder Mazedonisch.</li>
      <li>Breite Tabellen kannst du <b>seitlich wischen</b>. Reiter auf Detailseiten ebenso.</li>
      <li>Wo es am PC ein Rechtsklick-Menü gibt, <b>lange drücken</b> (etwa eine halbe Sekunde).</li>
      <li>Ist dir alles zu klein: Menü → Darstellung → <b>+</b> und <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-device-tablet"></i> Am Tablet</b>
    Die Navigation bleibt links. Chat, Suche und Hilfe öffnen sich als Leiste von rechts über dem Inhalt (Knopf <i class="ti ti-layout-sidebar-right"></i> oder Chat), damit genug Platz bleibt. Neue Chat-Nachrichten öffnen die Leiste dort nicht von selbst – du siehst die Zahl am Chat-Knopf.</div>
  <div class="hb-howto"><b><i class="ti ti-apps"></i> So legst du das PDH wie eine App auf den Startbildschirm</b>
    <ol class="hb-steps">
      <li>PDH im Browser öffnen und anmelden.</li>
      <li><b>iPhone/iPad (Safari):</b> Teilen-Symbol → <b>Zum Home-Bildschirm</b>. <b>Android (Chrome):</b> Menü ⋮ → <b>App installieren</b> bzw. <b>Zum Startbildschirm hinzufügen</b>.</li>
      <li>Das PDH-Symbol startet jetzt ohne Adressleiste, wie eine App.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-arrow-back-up"></i> Zurück zur vorherigen Seite</b>
    Der Pfeil <i class="ti ti-arrow-left"></i> oben links bringt dich immer dorthin zurück, woher du gekommen bist. Fährst du mit der Maus darüber, siehst du das Ziel.</div>
  <div class="hb-howto"><b><i class="ti ti-app-window"></i> Verknüpfungen öffnen, ohne die Seite zu verlassen</b>
    Klickst du z. B. in einem Ticket auf die Anlage, öffnet sie sich rechts im <b>PDH-Viewer</b>. Mit <kbd>Esc</kbd> schließt du ihn wieder. <kbd>Strg</kbd>+Klick öffnet stattdessen einen neuen Tab.</div>
  <div class="hb-howto" id="hb-statusbar"><b><i class="ti ti-progress"></i> Die Statusleiste unten</b>
    Ganz unten siehst du, was PDH gerade macht – im Balken steht die Tätigkeit und der Fortschritt in Prozent, z. B. „Speichere: Anlegen … 62 %“. Bei Uploads und Downloads ist es der echte Fortschritt, sonst läuft der Balken gleichmäßig bis 90 % und springt bei Abschluss auf <b>Fertig 100 %</b>. Blau = arbeitet, grün = fertig, gelb = Hinweis, rot = Fehler (rechts steht, was schiefging). Hintergrund-Aktualisierungen, z. B. von Widgets, zeigt die Leiste nicht an.</div>
  {{template "hb-shots" (dict "Ref" (index $s "start") "Can" $can)}}
</section>

<section class="hb-ch" id="records" data-title="Arbeiten mit Datensätzen" data-pages="">
  <h2><i class="ti ti-layout-dashboard"></i> Arbeiten mit Datensätzen</h2>
  <p>Egal ob Störung, Ersatzteil oder Anlage – jeder Datensatz ist gleich aufgebaut. Wer ein Modul kennt, kennt alle.</p>
  {{template "hb-fig-rows"}}
  <div class="hb-howto"><b><i class="ti ti-list-details"></i> So arbeitest du mit Listen und Tabellen</b>
    <ol class="hb-steps">
      <li><b>Zeile anklicken</b> (oder mit Tab anwählen und Enter). Die Zeile klappt auf, darunter erscheinen die Knöpfe.</li>
      <li><b>Ansehen</b> zeigt den Datensatz in der Schnellansicht über der Liste – die Liste bleibt, wo sie ist. <b>Bearbeiten</b> öffnet ihn. <b>Fertigstellen</b> (je nach Modul <b>Beheben</b>, <b>Abschließen</b>, <b>Erledigen</b> oder <b>Durchführen</b>) startet den Abschluss-Assistenten.</li>
      <li>Weitere Knöpfe des Moduls stehen rechts daneben, z. B. Status bei IT-Assets oder Bestätigen und Löschen in der Zeiterfassung.</li>
      <li>Nochmal klicken klappt die Zeile wieder zu. Ein <b>Doppelklick</b> öffnet den Datensatz direkt.</li>
    </ol>
    Im Anlagenbaum klappt der kleine <b>Pfeil</b> die Unteranlagen auf, ein Klick auf die Zeile zeigt die Knöpfe.</div>
  <div class="hb-howto"><b><i class="ti ti-keyboard"></i> Text-Vorschläge beim Tippen</b>In Titeln, Beschreibungen, Maßnahmen, Ursachen, Lösungen, Kommentaren, Schulungsinhalten und Freitext-Punkten von Checklisten schlägt PDH vor, wie es weitergehen könnte – gelernt aus allem, was im Betrieb schon geschrieben wurde. Grau angezeigt wird die Ergänzung der aktuellen Zeile (ganze Formulierung, nächstes Wort oder Wortende), darunter weitere passende Formulierungen.
    <ul>
      <li><b>Tab</b> übernimmt den markierten Vorschlag, <b>↑ ↓</b> wählen, <b>Esc</b> schließt; ein Klick geht auch. <b>Enter</b> bleibt Enter (außer du hast mit den Pfeilen gewählt).</li>
      <li>Was übernommen wird, rückt künftig weiter nach oben; neue Texte lernt PDH spätestens nach 10 Minuten dazu.</li>
    </ul></div>
  {{template "hb-fig-detail"}}
  <table>
    <tr><td><b>Übersicht</b></td><td>das Wichtigste auf einen Blick</td></tr>
    <tr><td><b>Stammdaten</b></td><td>hier wird bearbeitet – alles in einem Formular, unten rechts <b>Speichern</b></td></tr>
    <tr><td><b>Feldsätze</b></td><td>zusätzliche Felder, die eure Administration festlegt (<a href="#fieldsets">mehr</a>)</td></tr>
    <tr><td><b>Dokumente</b></td><td>Fotos (Galerie oder Kamera) und Dateien – bei Ersatzteilen auch Datenblatt und Benutzerhandbuch aus dem Internet (<a href="#part-docs">siehe Ersatzteile</a>)</td></tr>
    <tr><td><b>Verknüpfungen</b></td><td>alles, was mit dem Datensatz zusammenhängt – Anlage, Vorgänge, Ersatzteile, Firmen, Chat</td></tr>
    <tr><td><b>Historie</b></td><td>wer hat wann was geändert</td></tr>
  </table>
  <p><b>Listen</b> haben oben ebenfalls Reiter (z. B. nach Status oder Kategorie) mit der Anzahl der Einträge. Die Kennzahl-Kacheln sind anklickbar und filtern die Liste. Darunter filtern die <b>#-Schlagworte</b> nach <a href="#categories">Kategorie</a>.</p>
  <h3><i class="ti ti-hash"></i> Kopfleiste: Kategorien und Status</h3>
  {{template "hb-fig-meta"}}
  <p>Direkt über den Reitern stehen die <a href="#categories">Kategorien</a> (#Energie, #Optimierung …) – antippen setzt oder entfernt sie. Bei <b>Stammdaten</b> (Anlagen, Ersatzteile, Lagerplätze, Hersteller &amp; Lieferanten) zeigt die Leiste außerdem, ob der Datensatz <b>gesperrt</b>, <b>deaktiviert</b> oder <b>zum Löschen vorgemerkt</b> ist. Über <b>Status</b> änderst du das (<a href="#cleanup">mehr</a>).</p>
  <h3 id="creation"><i class="ti ti-circle-plus"></i> Vorgänge anlegen: der Erstellungs-Assistent</h3>
  <p>Neue Tickets, Störungen, Aufgaben und Wartungsaufträge legst du überall im gleichen Stil wie beim Abschließen Schritt für Schritt an. Jeder Weg zum Anlegen öffnet diesen Assistenten:</p>
  <ul>
    <li><b>Neu anlegen</b> in der Navigation und als Schnellaktion auf dem Dashboard (im Auswahlschritt auch „KVP-Idee“ für alle, öffnet den <a href="#kvp">Einreich-Assistenten</a>) – Aufgaben und Wartungen legen dort nur <b>Administratoren und Manager</b> an, alle anderen Tickets und Störungen,</li>
    <li>die Schnellaktionen <b>Störung melden</b> und <b>Ticket anlegen</b>,</li>
    <li><b>Neu</b> in der Ticket- und Störungsliste, <b>Neue Aufgabe</b>, in der Wartung <b>Einzelauftrag</b>,</li>
    <li>auf einer Projektseite das <b>+</b> bei den Aufgaben – die Aufgabe gehört dann gleich zum Projekt, danach bleibst du auf der Projektseite,</li>
    <li>im <a href="#dashboard">Leitstand</a> die Kacheln – dort ohne Zuweisung, siehe unten.</li>
  </ul>
  <p>Die <b>Kostenstelle</b> übernimmt PDH bei Tickets und Störungen wie bisher aus der gewählten Anlage.</p>
  <div class="hb-howto"><b><i class="ti ti-circle-plus"></i> So legst du einen Vorgang an</b>
    <ol class="hb-steps">
      <li><b>Art</b> wählen (entfällt, wenn du aus einer Liste startest).</li>
      <li><b>Was?</b> Titel, Beschreibung und Priorität (bei Störungen Schweregrad und Symptome, bei Wartungen die Art). Bei einer Störung zeigt PDH schon beim Tippen <b>ähnliche gelöste Fälle</b> mit ihrer Lösung. Mit <b>Foto aufnehmen</b> oder <b>Bild wählen</b> hängst du bis zu fünf Fotos an – sie stehen danach unter <b>Dokumente</b> am Vorgang (auch im Leitstand).</li>
      <li><b>Wo?</b> die Anlage – sie bestimmt auch, welche Abteilung den Vorgang sieht; bei Wartungsaufträgen Pflicht.</li>
      <li><b>Wer?</b> eine Person oder eine ganze <b>Gruppe</b> zuweisen, „Ich selbst“ oder offen lassen; optional Verantwortliche/n.</li>
      <li><b>Wann?</b> Fälligkeit per Schnellwahl (heute, morgen, 3 Tage, 1–2 Wochen, Standardfrist) oder Datum; bei Aufgaben auch der Start.</li>
      <li>Zusammenfassung prüfen – <b>Anlegen</b> öffnet den neuen Vorgang, <b>Anlegen &amp; nächster</b> beginnt gleich den nächsten derselben Art.</li>
    </ol></div>
  <h3 id="completion"><i class="ti ti-circle-check"></i> Vorgänge abschließen: der Abschluss-Assistent</h3>
  <p>Tickets, Störungen, Aufgaben und Wartungen schließt du immer mit dem <b>grünen Haken</b> ab – auf der Detailseite oder in der Liste: Zeile anklicken → <b>Fertigstellen</b> (bzw. <b>Beheben</b>, <b>Abschließen</b>, <b>Erledigen</b>, <b>Durchführen</b>). Ein Assistent führt dich in fünf kurzen Schritten durch; erst wenn alles da ist, geht es weiter.</p>
  {{template "hb-fig-completion"}}
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du einen Vorgang ab</b>
    <ol class="hb-steps">
      <li><b>Material:</b> Verwendete Ersatzteile suchen, Lagerort und Menge wählen, <b>Reservieren</b> – die Menge wird sofort vom Lagerplatz abgebucht (<a href="#reservation">Reservierung</a>). Zu viel reserviert? <b>Zurückbuchen</b> an der Position. Ohne Teile: <b>Kein Material verwendet</b> ankreuzen. <b>OK – weiter</b>.</li>
      <li><b>Zeit:</b> Beginn und Dauer angeben (Schnellwahl 15 min bis 8 h). Läuft dein Timer für diesen Vorgang, wird er automatisch gestoppt. Hast du schon Zeit erfasst, ist weitere Zeit freiwillig.</li>
      <li><b>Wer war dabei?</b> Mitarbeitende ankreuzen, die mitgearbeitet haben. Vorgeschlagen werden die Abteilungen aus den Core-Einstellungen (z. B. Instandhaltung, Elektro); <b>Alle Abteilungen anzeigen</b> zeigt alle. Niemand? Einfach weiter.</li>
      <li><b>Kommentar:</b> kurz, was gemacht wurde – erscheint als Maßnahme im Verlauf. Bei Tickets, Störungen und Aufgaben optional die <b>Ursache</b>.</li>
      <li><b>Fertig</b> macht die Reservierungen zum Verbrauch und schließt ab. <b>Geht noch weiter</b> speichert Zeit, Reservierung und Kommentar – der Vorgang bleibt <i>in Bearbeitung</i>, z. B. bei Schichtende oder wenn Teile fehlen.</li>
    </ol>
    Die Ausgewählten bekommen denselben Zeitraum als <b style="color:var(--amber)">gelben Eintrag</b> in ihre Zeiterfassung und einen Chat-Hinweis von „Service“. Erst wenn sie ihn mit dem <b style="color:var(--green)">grünen Haken</b> bestätigen, zählt die Zeit (<a href="#time">mehr</a>).</div>
  <ul>
    <li>Bei <b>Wartungen</b> mit Checkliste ist die <b>Checkliste der erste Schritt</b> des Assistenten – Punkt für Punkt mit Foto je Punkt, auch am Leitstand. Beim Abschluss entsteht das Wartungsprotokoll als PDF an Auftrag und Anlage (<a href="#maintenance">mehr</a>).</li>
    <li>Kann der Vorgang nicht geschlossen werden (z. B. fehlt dir die Berechtigung zum Abschließen), wird das Erfasste trotzdem gespeichert und der Grund angezeigt.</li>
    <li><b>Administration:</b> Die vorgeschlagenen Abteilungen stellst du unter <b>Core-Einstellungen → Abschluss-Assistent: Wer war dabei?</b> ein (Teilwort genügt, „Elektro“ passt auf „Elektrowerkstatt“).</li>
  </ul>
  {{template "hb-shots" (dict "Ref" (index $s "records") "Can" $can)}}
</section>

<section class="hb-ch" id="categories" data-title="Kategorien (#)" data-pages="categories">
  <h2><i class="ti ti-hash"></i> Kategorien (#)</h2>
  <p>Kategorien sind Schlagworte, die quer über alle Module gelten – zum Beispiel <b>#Energie</b>, <b>#Optimierung</b>, <b>#Zufriedenheit</b>, <b>#Versuch</b>, <b>#Produktiv</b> und <b>#Efficio</b>. So findest du z. B. alle Energie-Themen auf einen Blick: Tickets, Störungen, Aufgaben, Projekte, Wartungen, Anlagen, Ersatzteile, Lagerplätze und Firmen.</p>
  <div class="hb-howto"><b><i class="ti ti-hash"></i> So vergibst du eine Kategorie</b>
    <ol class="hb-steps">
      <li>Datensatz öffnen (z. B. ein Ticket).</li>
      <li>Oben über den Reitern auf das graue Schlagwort tippen – es wird farbig und ist gesetzt.</li>
      <li>Nochmal antippen entfernt es wieder. Mehrere Kategorien gleichzeitig sind möglich.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-search"></i> So findest du alles zu einer Kategorie</b>
    <ol class="hb-steps">
      <li>Navigation → <b>Kategorien</b>.</li>
      <li>Links die Kategorie wählen – rechts erscheinen alle Datensätze, sortiert nach Modul.</li>
      <li>Ein Klick öffnet den Datensatz im PDH-Viewer.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So filterst du eine Liste nach Kategorie</b>
    <ol class="hb-steps">
      <li>Jede Liste (Tickets, Störungen, Aufgaben, Projekte, Wartung, Ersatzteile, Hersteller &amp; Lieferanten) und die Bäume von Infrastruktur und Lager zeigen oben eine Zeile mit <b>#-Schlagworten</b> und der Anzahl der Treffer.</li>
      <li>Schlagwort antippen – die Liste zeigt nur noch diese Kategorie. Status- und Suchfilter bleiben erhalten; im Baum bleibt der Weg zu den Treffern sichtbar.</li>
      <li>Nochmal antippen oder <b>× alle</b> hebt den Filter auf.</li>
    </ol></div>
  <p>Mit der Berechtigung <i>Kategorien verwalten</i> legst du auf derselben Seite neue Kategorien an, änderst Name, Farbe und Symbol oder deaktivierst eine Kategorie. Deaktivierte Kategorien können nicht mehr neu vergeben werden, bestehende Zuordnungen bleiben sichtbar. Jede Änderung steht in der Historie des Datensatzes.</p>
  {{template "hb-shots" (dict "Ref" (index $s "categories") "Can" $can)}}
</section>

<section class="hb-ch" id="dashboard" data-title="Leitstand &amp; Meldungen" data-pages="assignments-new assignments">
  <h2><i class="ti ti-layout-dashboard"></i> Leitstand &amp; Meldungen</h2>
  <p>Am <b>Leitstand</b> (z. B. am Terminal in der Halle) meldet jede und jeder schnell ein Problem – ohne sich lange durchzuklicken.</p>
  <p>Der Leitstand sieht aus wie das übrige PDH: dasselbe Farbschema aus dem <b>Erscheinungsbild</b> (Firmenfarbe), Hell und Dunkel wie eingestellt. Die Arten haben überall dieselbe Farbe – <span style="color:#f97316">■</span> Störung, <span style="color:#0ea5e9">■</span> Ticket, <span style="color:#c99a3c">■</span> Wartung, <span style="color:#8b5cf6">■</span> Aufgabe; Rot bleibt für <b>überfällig</b> reserviert.</p>
  <p>Auch hier legst du mit dem <a href="#creation">Erstellungs-Assistenten</a> an, groß und fingerfreundlich – nur <b>ohne Zuweisung</b>: Statt „Wer kümmert sich?“ fragt der Leitstand <b>Wer meldet?</b>. Den Vorgang verteilen danach die Broker.</p>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So meldest du eine Störung am Leitstand</b>
    <ol class="hb-steps">
      <li>Die Kachel <b>Neue Störung</b> oder <b>Neues Ticket</b> antippen. Administratoren und Manager sehen auch <b>Neue Aufgabe</b> und <b>Neue Wartung</b>; bei Wartungen zeigt der Leitstand zuerst die geplanten zum Starten, „+ Neue Wartung anlegen“ öffnet den Assistenten.</li>
      <li><b>Was?</b> Kurzen <b>Titel</b> und eine <b>Beschreibung</b> mit mehr als drei Wörtern, Priorität bzw. Schweregrad (bei Störungen auch Symptome, bei Wartungen die Art).</li>
      <li><b>Wo?</b> Die <b>Anlage</b> suchen und antippen – Pflicht, nur bei Aufgaben optional.</li>
      <li><b>Wer meldet?</b> Dich selbst auswählen. Meldet jemand ohne PDH-Konto (z. B. Besucher), zusätzlich den Namen unter „Abweichender Melder“ eintragen.</li>
      <li><b>Wann?</b> (nicht bei Störungen) Fälligkeit per Schnellwahl oder Datum.</li>
      <li><b>Anlegen</b> – der Assistent zeigt, an welche Broker die Meldung ging, und schließt sich. <b>Anlegen &amp; nächster</b> beginnt gleich die nächste Meldung derselben Art.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So wählst du aus, was der Leitstand zeigt</b>
    <ol class="hb-steps">
      <li>Oben stehen die offenen Vorgänge als große <b>Kacheln</b> – je Vorgang Art, Titel, Priorität, Fälligkeit, <b>Ersteller</b> (wer gemeldet bzw. angelegt hat), Zuständiger und Status –, darunter der <b>Zeitstrahl</b>. Beide haben eine eigene Auswahl. Eine Kachel antippen öffnet darunter die Knöpfe zum Bearbeiten, nochmal antippen schließt sie.</li>
      <li>Die Knöpfe <b>Störungen</b>, <b>Tickets</b>, <b>Wartung</b> und <b>Aufgaben</b> antippen, um eine Art ein- oder auszublenden.</li>
      <li><b>Nur überfällig</b> bzw. <b>Nur ohne Zuständigen</b> zeigt nur diese Vorgänge.</li>
      <li>Wartungen, die noch nicht anstehen (Fälligkeit minus Vorlauf des Plans liegt nach heute), blendet die Tabelle aus – z. B. den nächsten Auftrag, den ein Wartungsplan direkt nach dem Fertigmelden anlegt. <b>Geplante Wartungen</b> zeigt sie an; im Zeitstrahl und unter „Neue Wartung“ stehen sie immer.</li>
      <li>Rechts über den Vorgängen steht, wie viele Vorgänge gerade angezeigt werden (z. B. „4 von 9“); im Zeitstrahl steht die Zahl der ausgeblendeten. Die Auswahl merkt sich der Browser am Leitstand.</li>
      <li>In der Kopfzeile schaltet <b>☰ Tabelle</b> / <b>▦ Kacheln</b> zwischen Kacheln und Tabelle um, <b>📅 Zeitstrahl</b> blendet den Zeitstrahl aus und wieder ein. Ohne Zeitstrahl füllen die Vorgänge den ganzen restlichen Bildschirm.</li>
      <li>Bei <b>Aa Größe</b> mit <b>−</b> / <b>+</b> die Kacheln bzw. die Tabellenzeilen und die Wartungsliste kleiner oder größer machen (70 bis 150 %). Die Schrift passt sich dabei an: klein zeigt mehr Vorgänge auf einen Blick, groß ist von weitem besser lesbar. Ohne gespeicherten Wert gilt die Zeilenhöhe aus deinem Konto, wenn du angemeldet bist, sonst 100 %.</li>
      <li>Ansicht, Zeitstrahl und Größe merkt sich der Leitstand an diesem Gerät.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-id-badge-2"></i> So öffnest du einen Vorgang am Leitstand</b>
    <ol class="hb-steps">
      <li>Einen Balken im Zeitstrahl doppelt antippen.</li>
      <li>Ist am Leitstand niemand angemeldet, fragt er nach der <b>RFID-Karte</b>. Karte scannen, die Seite öffnet sich mit deinen Rechten.</li>
      <li>Das ist <b>keine dauerhafte Anmeldung</b>: Oben rechts steht <b>Zurück zum Leitstand</b>. Der Zugang endet damit, bei Inaktivität (Override-Zeit unter <b>Rollen &amp; Berechtigungen</b>), beim Schließen des Browsers oder sobald jemand den Leitstand wieder aufruft.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So meldest du am Leitstand fertig</b>
    <ol class="hb-steps">
      <li>Den Vorgang antippen – darunter erscheinen die Werkzeuge (<b>Annehmen</b>, <b>Fertig</b>, für Administratoren und Manager auch <b>Verwerfen</b>). Nochmal antippen klappt sie wieder zu. Ein Balken im Zeitstrahl öffnet dieselben Werkzeuge. <b>Fertig</b> wählen.</li>
      <li>Bei <b>Wer führt aus?</b> deinen Namen wählen und <b>Fertigmeldung starten</b>. In der Liste stehen die Mitarbeitenden aus Instandhaltung und IT. Ein Kommentar ist hier nicht nötig.</li>
      <li>Der <a href="#completion">Abschluss-Assistent</a> führt durch Material, Zeit, wer dabei war, und Kommentar – genau wie im PDH, nur im Namen der gewählten Person. Oben steht, für wen die Fertigmeldung läuft.</li>
      <li><b>Fertig</b> schließt den Vorgang ab (Status „Gelöst“ bzw. „Erledigt“). <b>Geht noch weiter</b> speichert Zeit und Kommentar, der Vorgang steht dann auf <i>In Arbeit</i>.</li>
    </ol>
    Die Freigabe gilt nur für diesen einen Vorgang und höchstens 20 Minuten. Wer am Leitstand fertig melden darf (Instandhaltung und IT), darf dort auch abschließen – unabhängig vom Bearbeiten- und Abschluss-Recht seiner Rolle.<br>
    <b>Nur am Terminal:</b> Ist unter <b>Core-Einstellungen → Leitstand: Wer führt aus?</b> „Personenauswahl nur am Terminal“ eingeschaltet, gibt es die Namensliste nur an angemeldeten Terminals. An allen anderen Geräten steht stattdessen das Feld <b>RFID-Karte</b> – dann wie früher die Karte scannen.</div>
  <div class="hb-howto"><b><i class="ti ti-hourglass"></i> Was die Leitstand-Aktionen am Status ändern</b>
    <ul>
      <li><b>Annehmen</b> – Vorgang wird zugewiesen und steht auf <i>In Arbeit</i>. Als Zuständiger ist die Person vorgeschlagen, die ausführt.</li>
      <li><b>Geht noch weiter</b> (im Assistenten) bzw. erneutes <b>Annehmen</b> – zurück auf <i>In Arbeit</i>.</li>
      <li><b>Fertig</b> – <i>Gelöst</i> (Störung, Ticket, Aufgabe) bzw. <i>Erledigt</i> (Wartung); der Vorgang verschwindet vom Leitstand.</li>
      <li><b>Verwerfen</b> – Störungen und Tickets werden ohne Maßnahme geschlossen, Wartungen übersprungen, Aufgaben geschlossen.</li>
    </ul></div>
  <h3><i class="ti ti-inbox"></i> Was danach passiert: Broker</h3>
  {{template "hb-fig-broker"}}
  <p>Meldungen aus dem Leitstand sind nie zugewiesen. Auch sonst kann jeder Vorgang ohne Zuständigen angelegt werden, egal ob über <b>Neu anlegen</b>, die Modulseite oder die Schnittstelle. Das gilt für Störungen, Tickets, Aufgaben und Wartungen. Jeder <b>Broker</b> der jeweiligen Art bekommt dann eine Chat-Nachricht vom Melder und kann den Vorgang übernehmen oder jemandem zuweisen. Im Verlauf des Vorgangs steht, an wen er verteilt wurde. Wer Broker ist (für Tickets, Störungen, Aufgaben und/oder Wartungen), legt die Benutzerverwaltung im <a href="#users">Benutzerstamm</a> fest. Ist für eine Art kein Broker hinterlegt, bleibt der Vorgang offen. Der Leitstand und die Bestätigung im Chat weisen darauf hin.</p>
  <p>Aus Wartungsplänen automatisch erzeugte Aufträge lösen keine Chat-Nachricht aus. Sie erscheinen auf der Seite <b>Zuweisung</b>, sobald ihr Vorlauf begonnen hat.</p>
  <h3 id="push"><i class="ti ti-bell-ringing"></i> Push-Alarm aufs Handy</h3>
  <p>Neue Störungen und Tickets kommen als Nachricht aufs Handy der Bereitschaft – mit Inhalt und den Knöpfen <b>Annehmen</b> und <b>Ansehen</b>. Wer zuerst annimmt, wird zuständig, der Vorgang steht auf <i>In Arbeit</i>, und bei allen anderen verschwindet die Nachricht. Ist beim Anlegen <b>Anlage steht</b> angehakt (im Assistenten bei „Wo?“, im Easy-Mode „Anlage steht“), meldet sich das Handy immer wieder, bis jemand annimmt; in der geöffneten PDH-App liegt der Alarm bildschirmfüllend über allem.</p>
  <div class="hb-howto"><b><i class="ti ti-device-mobile"></i> So bekommst du Push-Alarme aufs Handy</b>
    <ol class="hb-steps">
      <li><b>iPhone</b> (ab iOS 16.4): PDH in Safari öffnen → Teilen → <b>Zum Home-Bildschirm</b>, dann PDH vom Home-Bildschirm aus starten. <b>Android</b>: PDH in Chrome öffnen.</li>
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> → Karte <b>Push-Benachrichtigungen aufs Handy</b> → <b>Auf diesem Gerät einschalten</b> → Benachrichtigungen <b>erlauben</b>. Steht dort „Push ist im PDH noch ausgeschaltet“, muss es erst ein Administrator einschalten.</li>
      <li><b>Probe senden</b> – die Nachricht sollte gleich ankommen. Für Alarme die Benachrichtigungen von Chrome bzw. PDH in den Handy-Einstellungen auf „Mit Ton“ bzw. „Wichtig“ stellen.</li>
      <li>Kommt ein Alarm: <b>Annehmen</b> direkt in der Nachricht antippen – oder die Nachricht antippen, dann öffnet sich der Alarm bildschirmfüllend mit großem <b>Annehmen</b>-Knopf. Steht dort „Angenommen von …“, kümmert sich schon jemand.</li>
    </ol>
    Benachrichtigt wirst du nur, wenn du in einer der gewählten Benutzergruppen bist; eigene Meldungen lösen bei dir keine Nachricht aus. Am iPhone gibt es keine Knöpfe in der Nachricht – dort antippen und auf der Alarmseite annehmen. Ganz über dem Sperrbildschirm wie ein Anruf kann eine Web-App den Alarm nicht zeigen; er bleibt aber stehen und meldet sich erneut.</div>
  <div class="hb-howto"><b><i class="ti ti-settings"></i> So richtest du Push ein (Administratoren)</b>
    <ol class="hb-steps">
      <li>Unter <b>Abteilungen &amp; Gruppen</b> eine Gruppe anlegen, z. B. „Bereitschaft Instandhaltung“, und die Personen eintragen.</li>
      <li><b>Core-Einstellungen → Push-Benachrichtigungen aufs Handy</b>: einschalten und je Gruppe anhaken, ob sie bei <b>Störungen</b> und/oder <b>Tickets</b> benachrichtigt wird.</li>
      <li>Für „Anlage steht“ festlegen, wie oft der Alarm wiederholt wird (Standard alle 60 Sekunden) und wie lange höchstens (Standard 120 Minuten). <b>Speichern</b>.</li>
    </ol>
    Push braucht eine <b>https</b>-Adresse (z. B. über den Cloudflare-Tunnel). Benachrichtigt werden nur Vorgänge, die nach dem Einschalten angelegt werden. Der Alarm endet, sobald jemand annimmt, der Vorgang erledigt oder anderweitig zugewiesen ist oder die Höchstdauer um ist. In der Historie des Vorgangs steht, dass benachrichtigt wurde und wer angenommen hat.</div>
  {{template "hb-shots" (dict "Ref" (index $s "dashboard") "Can" $can)}}
  <div class="hb-howto"><b><i class="ti ti-user-check"></i> So weist du als Broker zu</b>Bist du Broker (Benutzerstamm) oder Administrator, steht in der Navigation oben <b>Zuweisung</b>. Andere sehen diese Seite nicht. Dort laufen <b>alle</b> offenen Vorgänge <b>ohne Zuweisung</b> auf – Störungen, Tickets, Aufgaben und Wartungen. Zuweisen kannst du die Arten, für die du Broker bist (Administratoren alle); bei den übrigen steht, wer zuweist. Sie sind nach Art sortiert, die neuesten zuerst. Zu jedem Vorgang stehen Priorität, Anlage, Ersteller und Wartezeit dabei. Wartungen erscheinen, sobald ihr Vorlauf begonnen hat.
    <ol class="hb-steps">
      <li><b>Zuweisung</b> in der Navigation öffnen.</li>
      <li>Beim Vorgang unter <b>Zuweisen an …</b> eine Person, eine Gruppe oder <b>Mir selbst</b> wählen.</li>
      <li><b>Zuweisen</b> – die Zeile zeigt „Zugewiesen an …“. Der neue Zuständige bekommt einen Hinweis im Chat.</li>
      <li>War ein anderer Broker schneller, steht dort „Schon vergeben“. Es wird dann nichts überschrieben.</li>
      <li>Ein Klick auf den Titel öffnet den Vorgang. Dort kannst du auch Verantwortliche und weitere Angaben setzen.</li>
    </ol>
    Unter <b>Neu anlegen</b> stehen dieselben Vorgänge kurz als Schnelleinstieg. <b>Zur Zuweisung</b> führt von dort auf die Seite.</div>
</section>

<section class="hb-ch" id="faults" data-title="Störungen" data-pages="faults">
  <h2><i class="ti ti-alert-triangle"></i> Störungen</h2>
  <p>Eine Störung ist ein technisches Problem an einer Anlage. Die Seite <b>Störungen</b> ist aufgebaut wie der KVP – mit <b>Dashboard</b>, <b>Störungen</b>, <b>Board</b> und <b>Regeln &amp; Einstellungen</b> (siehe <a href="#work-views">Tickets</a>); frisch gemeldete Störungen sind gelb markiert. Sie durchläuft fünf Schritte:</p>
  {{template "hb-fig-fault"}}
  <div class="hb-howto"><b><i class="ti ti-check"></i> So löst du eine Störung</b>
    <ol class="hb-steps">
      <li>Störung öffnen, im Reiter <b>Copilot</b> bei Bedarf eine Analyse starten oder Fragen stellen.</li>
      <li>Im Reiter <b>Maßnahmen &amp; Ersatzteile</b> zwischendurch festhalten, was gemacht wurde, und benötigte Teile <b>reservieren</b> – sie sind damit sofort für dich aus dem Lager gebucht.</li>
      <li><b>Beheben &amp; abschließen</b> (Karte oben in der Übersicht, in der Liste oder auf dem Board): Der <a href="#completion">Abschluss-Assistent</a> fragt Material, Zeit, wer dabei war und den Kommentar ab.</li>
      <li><b>Fertig</b> – die reservierten Teile werden zum Verbrauch der Störung, die Störung wandert ins Archiv. Oder <b>Geht noch weiter</b>, wenn die Arbeit noch nicht beendet ist.</li>
    </ol></div>
  <p>Die Übersicht zeigt Verantwortliche, Zuständige (auch externe Firmen), Termin, Anlage und Kostenstelle. Ändern geht im Reiter <b>Bearbeiten</b>, die Zeit erfasst du im Reiter <b>Zeit</b> (siehe <a href="#work-views">Detailseite</a>).</p>
  <p><b>Automatisches Ticket zur Störung:</b> Standardmäßig bekommt eine Störung <b>kein</b> eigenes Ticket. Ein Administrator kann das unter <b>Server-Einstellungen → Störungen → Ticket zu jeder Störung anlegen</b> einschalten (wirkt sofort). Dann entsteht das Ticket erst, wenn die Störung einer <b>Person oder Gruppe zugewiesen</b> ist – auf der Störung steht bis dahin „Ticket wird angelegt, sobald …“. Das Ticket übernimmt Zuweisung, Gruppe, Anlage und Kostenstelle. Wird die Störung vorher erledigt, entfällt es.</p>
  <div class="hb-howto"><b><i class="ti ti-brain"></i> Copilot und ähnliche Fälle</b>PDH vergleicht jede Störung mit allen bereits gelösten: Titel, Beschreibung und Symptome werden inhaltlich verglichen (Wortformen und Umlaute egal, seltene Fachbegriffe zählen mehr); dieselbe Anlage zählt deutlich, eine Anlage an derselben Linie etwas mehr. Die passendsten Fälle stehen rechts in der Leiste mit ihrer <b>Ähnlichkeit in Prozent</b> – auch ohne Analyse; ein Klick öffnet den Fall, die Lösung steht im Tooltip.
    Die <b>Copilot-Analyse</b> bekommt diese Fälle samt Ursache, Lösung und durchgeführten Maßnahmen sowie den Anlagenpfad mit und stützt sich zuerst darauf. Die <b>Konfidenz</b> ist nur hoch, wenn ähnliche Fälle die Einschätzung tragen. Je mehr Störungen sauber mit Ursache, Lösung und Maßnahmen abgeschlossen werden, desto besser werden die Vorschläge.
    <br>Klappt die Analyse oder der Chat nicht, steht der genaue Grund direkt darunter (z. B. Modell unbekannt, API-Schlüssel ungültig, Ollama nicht erreichbar) – das Modell und den Schlüssel trägt ein Administrator unter <b>Server-Einstellungen → Copilot</b> ein (Standard für Anthropic: <code>claude-opus-5-5</code>). Dort prüft <b>Verbindung testen</b>, welcher Schlüssel aktiv ist und ob Anthropic ihn annimmt. Meldet Anthropic, der Schlüssel sei <i>keinem Workspace zugeordnet</i> („anthropic-workspace-id header“), dort zusätzlich die <b>Anthropic-Workspace-ID</b> eintragen. Sie steht in der Claude Console unter <i>Settings → Workspaces</i>. Danach den Server neu starten.</div>
  <div class="hb-howto"><b><i class="ti ti-bulb"></i> Automatische Vorschläge bei Störungen und Tickets</b>Sobald du eine offene Störung oder ein offenes Ticket öffnest oder mit <b>Beheben</b> bzw. <b>Abschließen</b> den Assistenten startest, sucht der Copilot selbst in euren Daten. Findet er etwas, <b>blinkt der Copilot-Reiter rechts gelb</b> – im Assistenten zusätzlich der gelbe Knopf <b>„Copilot: … Vorschläge“</b>.
    <ol class="hb-steps">
      <li>Gelb blinkenden <b>Copilot</b>-Reiter (oder den gelben Knopf im Assistenten) anklicken – die Leiste klappt auf, das Blinken hört auf.</li>
      <li><b>⚠ Mögliche Dopplung</b>: Diese offenen Störungen oder Tickets beschreiben vermutlich dasselbe. Vorher hineinschauen – vielleicht kümmert sich schon jemand darum.</li>
      <li><b>💡 Bewährte Lösungen</b>: gelöste Störungen <i>und</i> Tickets mit Ursache, Lösung, Maßnahmen und verbauten Teilen, die ähnlichsten zuerst (Prozent). Gleiche Lösungen stehen nur einmal da – mit „2× so gelöst“ und den weiteren Fällen unter „auch“.</li>
      <li><b>📦 Oft benötigte Ersatzteile</b>: was bei diesen Fällen verbaut wurde, mit aktuellem Bestand (rot = nichts da). Ein Klick öffnet Teil oder Fall in der Schnellansicht – auch über dem Assistenten.</li>
    </ol>
    Die Vorschläge kommen direkt aus der Datensammlung, ohne KI und sofort. Eine Störung und das daraus erstellte Ticket gelten als ein Vorgang – sie erscheinen nicht als Dopplung voneinander und gelöste Fälle nur einmal. Für Rückfragen unten im Copilot fragen. Du siehst nur Fälle, die du sehen darfst.</div>
  <div class="hb-howto"><b><i class="ti ti-message-question"></i> Den Copilot nach euren Daten fragen</b>Den Copilot in der rechten Seitenleiste kannst du auf jeder Seite fragen – z. B. „Welche Störungen hatte Presse 3 in den letzten 30 Tagen?“, „Haben wir noch Lager 6205 und wo liegen sie?“ oder „Welche Wartungen sind diese Woche fällig?“. Er sucht dafür selbst in Störungen, Tickets, Aufgaben, Wartungen, Projekten, Anlagen, Ersatzteilen und den Messwerten aus dem Import. Links in der Antwort öffnen den Vorgang; darunter steht, welche PDH-Daten er benutzt hat. Auf einer Störung bezieht er deren Kontext mit ein. Eine Störung und das daraus erstellte Ticket behandelt er als <b>einen</b> Vorgang – er zählt sie nicht doppelt und nennt beide Links.
    <br>Der Copilot sieht nur, was du auch sehen darfst (deine Rechte und Abteilungs-Sicht), und ändert nichts. Er hat keinen Internetzugang; allgemeines Fachwissen kennzeichnet er als solches. Das selbstständige Nachschlagen gibt es mit Claude (Anthropic-Schlüssel); mit Ollama bekommt er vorab die Suchtreffer zur Frage.</div>
  <div class="hb-howto"><b><i class="ti ti-users"></i> Verantwortlich und Zugewiesen</b>Jeder Vorgang hat zwei Zuständigkeiten: <b>Verantwortlich</b> – wer dafür geradesteht und den Überblick behält – und <b>Zugewiesen</b> – wer die Arbeit macht. Das gilt einheitlich für Tickets, Störungen, Wartungspläne und -aufträge, Aufgaben (hier auch mehrere Zugewiesene), Projekte und IT-Assets. Aufträge aus einem Wartungsplan übernehmen beide Personen und die Gruppe aus dem Plan. Zusätzlich lässt sich eine <b>Gruppe</b> zuweisen (Feld „Zugewiesene Gruppe“): Alle Mitglieder sehen den Vorgang im Dashboard unter <b>Mir zugewiesen</b> und bekommen die Änderungshinweise im Chat. Auf der Seite <b>Neu anlegen</b> stehen im Feld „Zugewiesen an“ unter den Personen auch die <b>Gruppen</b> – so landet ein neuer Auftrag direkt bei einem Team.</div>
  {{template "hb-shots" (dict "Ref" (index $s "faults") "Can" $can)}}
</section>

<section class="hb-ch" id="tickets" data-title="Tickets" data-pages="tickets">
  <h2><i class="ti ti-ticket"></i> Tickets</h2>
  <p>Tickets sind Aufträge und Anfragen, z. B. „Tür klemmt“ oder „Neuer Arbeitsplatz einrichten“. Sie haben Priorität, Status, Termin und Beteiligte. Wie bei Störungen schlägt der Copilot bei offenen Tickets selbst Dopplungen, bewährte Lösungen und Ersatzteile vor – der Copilot-Reiter blinkt dann gelb (siehe <a href="#faults">Störungen → Automatische Vorschläge</a>).</p>
  <p id="work-views">Tickets, Störungen, Aufgaben und Wartungen sind aufgebaut wie der <a href="#kvp">KVP</a> – mit diesen Reitern oben auf der Seite:</p>
  {{template "hb-fig-workboard"}}
  <ul>
    <li><b>Dashboard</b> (Start): Kennzahlen des Jahres – offen, überfällig, ohne Zuweisung, angelegt, erledigt (mit Anteil termingerecht) und Ø Durchlaufzeit. Dazu der <b>Ablauf</b> nach Status, die <b>letzten 12 Monate</b> (angelegt/erledigt), die Anlagen mit den meisten Vorgängen, wer am meisten erledigt hat und <b>Braucht Aufmerksamkeit</b> (Überfälliges und Dringendes ohne Zuständigen). Mit den Pfeilen wechselst du das Jahr. Jede Kennzahl führt in die passende Liste.</li>
    <li><b>Tickets</b> (bzw. Störungen, Aufgaben, Aufträge): die Liste mit <b>Filter-Chips</b> und Anzahl – <b>Alle offenen</b>, <b>Meine</b>, <b>Ohne Zuweisung</b>, je Status, <b>Überfällig</b> (Aufgaben: <b>Ohne Projekt</b>, Wartung: <b>Fällig</b> – bis einschließlich heute – und <b>Geplant</b>) und <b>Archiv</b>. Dazu Suche, Priorität, Anlage (bei Aufgaben auch Projekt) und Kategorien. Zeile antippen – sie klappt auf mit <b>Ansehen</b>, <b>Bearbeiten</b> und <b>Abschließen</b>, <b>Beheben</b>, <b>Erledigen</b> bzw. <b>Durchführen</b> (siehe <a href="#records">Arbeiten mit Datensätzen</a>).</li>
    <li><b>Board</b>: eine Spalte je Status, Überfälliges und Wichtiges oben, rechts die in den letzten 7 Tagen erledigten. Jede Karte hat den Knopf zum <a href="#completion">Abschluss-Assistenten</a>.</li>
    <li><b>Archiv</b> (Chip): alles Abgeschlossene mit Suche (auch in der Lösung), Anlage und Zeitraum, seitenweise; <b>Lösung &amp; Ursache</b> klappt direkt auf.</li>
    <li><b>Regeln &amp; Einstellungen</b>: die Regeln des Moduls, die <b>Standard-Frist</b> (Tage nach Anlage, wenn kein Termin angegeben ist – ändern darf, wer Rollen &amp; Rechte verwaltet) und die <b>Broker</b>.</li>
  </ul>
  <p>Angelegt wird weiterhin mit dem <a href="#creation">Erstellungs-Assistenten</a> (<b>Neu</b>), abgeschlossen mit dem <a href="#completion">Abschluss-Assistenten</a>.</p>
  <p>Die <b>Detailseite</b> eines Tickets, einer Störung oder Aufgabe ist aufgebaut wie ein KVP-Vorschlag. In der <b>Übersicht</b> steht oben die Karte <b>Ticket bearbeiten</b> (bei Störungen <b>Störung beheben</b>, bei Aufgaben <b>Aufgabe erledigen</b>). Daneben steht die Karte <b>Details</b> zum Nachlesen. Ist der Vorgang abgeschlossen, zeigt die Karte das an und führt ins Archiv. Alles Änderbare liegt in eigenen Reitern:</p>
  <ul>
    <li><b>Bearbeiten</b> – Zuständigkeit (Verantwortlich, Zugewiesen, Gruppe), Termin, Anlage und Kostenstelle. Bei Tickets auch der Status, bei Aufgaben die Farbe im Gantt.</li>
    <li><b>Maßnahmen &amp; Ersatzteile</b> – festhalten, was gemacht wurde, und Teile reservieren.</li>
    <li><b>Zeit</b> – Zeit starten und stoppen, darunter alle Zeiteinträge.</li>
    <li><b>Kommentare</b> (Tickets) – für die Abstimmung im Team.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-edit"></i> So änderst du Zuständigkeit, Termin oder Anlage</b>
    <ol class="hb-steps">
      <li>Reiter <b>Bearbeiten</b> öffnen. Oder in der Karte <b>Details</b> auf <i class="ti ti-edit"></i> <b>Bearbeiten</b> tippen.</li>
      <li>Felder ändern – auch mehrere auf einmal. Jede Einstellung steht wie in den Windows-Einstellungen in einer eigenen Zeile: links, worum es geht, rechts das Feld.</li>
      <li>Unten rechts <b>Speichern</b> antippen. Links daneben erscheint die Meldung, ob es geklappt hat. Gespeichert wird nur, was du geändert hast. Jede Änderung steht danach in der <b>Historie</b>.</li>
    </ol>
    Den Status <b>Gelöst</b> oder <b>Geschlossen</b> setzt du nicht hier, sondern mit dem Abschluss-Assistenten.</div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du ein Ticket ab</b>
    <b>Bearbeiten &amp; abschließen</b> antippen – in der Karte oben in der Übersicht oder in der Liste (Zeile aufklappen → <b>Abschließen</b>). Der <a href="#completion">Abschluss-Assistent</a> fragt nacheinander Material, Zeit, wer dabei war und den Kommentar ab. Am Ende <b>Fertig</b> oder <b>Geht noch weiter</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-inbox"></i> Tipp für Broker</b>
    Dein Eingang ist die Seite <b>Zuweisung</b> (Navigation oben). Dort weist du direkt zu (<a href="#dashboard">mehr</a>). In der Ticketliste zeigt der Filter <b>Ohne Zuweisung</b> dieselben Tickets.</div>
  {{template "hb-shots" (dict "Ref" (index $s "tickets") "Can" $can)}}
</section>

<section class="hb-ch" id="tasks" data-title="Aufgaben &amp; Projekte" data-pages="tasks projects">
  <h2><i class="ti ti-list-check"></i> Aufgaben &amp; Projekte</h2>
  <p><b>Aufgaben</b> sind To-dos mit Zuständigen, Termin und Priorität. Sie können zu einem Projekt oder einer Anlage gehören oder aus einer Störung entstehen – der Reiter <b>Verknüpfungen</b> zeigt die Zusammenhänge. Die Seite <b>Aufgaben</b> hat dieselben Reiter wie Tickets (siehe <a href="#work-views">Tickets</a>); jede Zeile zeigt auch das Projekt, der Reiter <b>Projekte</b> führt zur Projektübersicht.</p>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du eine Aufgabe ab</b>
    <b>Erledigen</b> (in der Liste, auf dem Board, im Projekt oder oben in der Aufgabe) – der <a href="#completion">Abschluss-Assistent</a> fragt nacheinander Material, Zeit, wer dabei war und den Kommentar ab. Am Ende <b>Fertig</b> oder <b>Geht noch weiter</b>.</div>
  <p><b>Projekte</b> sind das übergeordnete Aufgabenmanagement – so wie ein Wartungsplan seine Aufträge bündelt. Die Projektübersicht zeigt je Projekt eine Karte mit <b>Fortschrittsbalken</b> (erledigte von allen Aufgaben), überfälligen Aufgaben und dem nächsten Termin.</p>
  <div class="hb-howto"><b><i class="ti ti-timeline"></i> So arbeitest du mit einem Projekt</b>
    <ol class="hb-steps">
      <li>Projekt öffnen: oben steht <b>Aufgaben im Projekt</b> mit Fortschritt. <b>Neue Aufgabe</b> legt eine Aufgabe direkt im Projekt an; unter <b>Bestehende Aufgabe zuordnen</b> holst du vorhandene dazu.</li>
      <li>Die Aufgaben stehen darunter als Karten, gruppiert nach <b>Überfällig</b>, <b>In Arbeit</b>, <b>Offen</b>, <b>Wartet</b> und <b>Erledigt</b> – jede mit <b>Erledigen</b>.</li>
      <li><b>Anstehend</b> öffnet die Aufgaben-Liste gefiltert auf dieses Projekt.</li>
    </ol></div>
  <p>Zusätzlich zeigt das Projekt seine Aufgaben im <b>Zeitstrahl</b>. Ein Doppelklick auf eine Aufgabe im Zeitstrahl öffnet sie zur Bearbeitung. Der Rand der Balken zeigt, ob eine Aufgabe läuft, fällig, überfällig, nicht zugewiesen oder beendet ist (<a href="#timeline-style">Zeitstrahl-Darstellung</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "tasks") "Can" $can)}}
</section>

<section class="hb-ch" id="kvp" data-title="KVP – Verbesserungen" data-pages="kvp">
  <h2><i class="ti ti-bulb"></i> KVP – Kontinuierliche Verbesserung</h2>
  <p>Im <b>KVP</b> reicht jede/r Verbesserungsideen ein – vom wackeligen Regal bis zur schnelleren Rüstzeit. Alle sehen alle Vorschläge. Jede Idee bekommt innerhalb der <b>Rückmeldefrist</b> (Vorgabe 14 Tage) eine begründete Entscheidung und wird danach im <b>PDCA-Zyklus</b> umgesetzt: <b>Plan</b> → <b>Do</b> → <b>Check</b> → <b>Act</b>.</p>
  {{template "hb-fig-kvp"}}
  <div class="hb-howto"><b><i class="ti ti-bulb"></i> So reichst du eine Idee ein</b>
    <ol class="hb-steps">
      <li><b>KVP</b> → <b>Idee einreichen</b> – oder <b>Neu anlegen</b> → Kachel <b>KVP-Idee</b>, oder die Schnellaktion „Idee einreichen“ im Dashboard. Es öffnet sich der Einreich-Assistent; mit <b>OK – weiter</b> geht es Schritt für Schritt.</li>
      <li><b>Thema</b> antippen.</li>
      <li><b>Was stört?</b> Titel und Ist-Zustand – beides Pflicht.</li>
      <li><b>Vorschlag</b>: wie geht es besser (Pflicht) und was bringt es (Nutzen).</li>
      <li><b>Wo?</b> Anlage oder Bereich – freiwillig. <b>Team</b>: Miteinreichende ankreuzen. Mit dem Recht „KVP steuern“ kannst du hier für jemand anderen einreichen.</li>
      <li><b>Einreichen</b> öffnet den Vorschlag; <b>Einreichen &amp; nächste</b> beginnt gleich die nächste Idee. Im Reiter <b>Vorher/Nachher</b> ein Foto vom Ist-Zustand anhängen. Jede Entscheidung bekommst du per Chat von „Service“.</li>
    </ol>
    Solange der Vorschlag noch nicht bewertet wird, kannst du ihn unter <b>Vorschlag bearbeiten</b> ändern.</div>
  <div class="hb-howto"><b><i class="ti ti-scale"></i> So wird bewertet und entschieden</b> (Recht „KVP steuern“)
    <ol class="hb-steps">
      <li>Im Vorschlag oben bei <b>Nächster Schritt</b> auf <b>Weiter</b> tippen. Der Assistent fragt zuerst die <b>Bewertung</b> ab: Nutzen und Aufwand (je 1–5), geschätzte Einsparung und Kosten sowie <b>Setzt um</b>. PDH ordnet den Vorschlag in die Matrix ein: <b>Quick Win</b>, <b>Großprojekt</b>, <b>Lückenfüller</b> oder <b>Fragwürdig</b>.</li>
      <li>Dann <b>Wie geht es weiter?</b> – <b>Bewertung beginnen</b>, <b>Annehmen</b>, <b>Zurückstellen</b> oder <b>Ablehnen</b>, immer mit Begründung – und <b>Fertig</b>. <b>Nur speichern</b> hält die Bewertung fest, ohne zu entscheiden. Die Einreichenden werden benachrichtigt; bei Annahme auch die/der Umsetzungsverantwortliche.</li>
    </ol>
    Ist die Frist überschritten, steht der Vorschlag rot im Dashboard und PDH erinnert die Bewertenden täglich.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> So wird umgesetzt (PDCA)</b> – mit dem Assistenten unter <b>Nächster Schritt</b> → <b>Weiter</b>
    <ol class="hb-steps">
      <li><b>Plan:</b> Ursache (5×Warum), messbares Ziel und Termin, dann Maßnahmen – jede mit <b>wer</b> und <b>bis wann</b>. Zum Schluss <b>Umsetzung starten</b>.</li>
      <li><b>Do:</b> erledigte Maßnahmen abhaken (das darf auch, wer für die Maßnahme eingetragen ist). Erst wenn alle erledigt sind, geht es zu <b>Wirksamkeit prüfen</b>.</li>
      <li><b>Check:</b> <b>wirksam</b> oder <b>nicht wirksam</b> mit Ergebnis festhalten. Wirksam → <b>Standardisieren</b>; nicht wirksam → <b>neuer PDCA-Zyklus</b> zurück in Plan.</li>
      <li><b>Act:</b> beschreiben, was zum Standard wurde (Arbeitsanweisung, Checkliste, Schulung …), tatsächliche Einsparung und ggf. Prämie – dann <b>Abschließen</b>.</li>
    </ol>
    Wie im Abschluss-Assistenten: <b>Fertig</b> schaltet weiter, <b>Nur speichern – geht noch weiter</b> sichert nur die Angaben. Fehlt für einen Schritt noch etwas, nennt PDH es bei der Auswahl und schaltet nicht weiter; das bereits Eingegebene bleibt gespeichert. Einzelne Angaben lassen sich auch direkt in den Reitern <b>Bewertung</b> und <b>PDCA &amp; Maßnahmen</b> ändern. <b>A3-Report</b> druckt den ganzen Vorschlag auf einer Seite zum Aushängen.</div>
  <p>Das <b>Dashboard</b> zeigt Kennzahlen des Jahres (Vorschläge je Mitarbeitende/n, Annahmequote, Ø Zeit bis zur Entscheidung, Beteiligung, Einsparungen und Prämien), den Ablauf, die letzten 12 Monate, die Themen, die Nutzen-Aufwand-Matrix und alles Überfällige. Das <b>PDCA-Board</b> zeigt die Vorschläge in Umsetzung als Karten. Unter <b>Regeln &amp; Vorlagen</b> stehen die KVP-Regeln; dort stellt die KVP-Steuerung die Rückmeldefrist ein.</p>
  {{template "hb-shots" (dict "Ref" (index $s "kvp") "Can" $can)}}
</section>

<section class="hb-ch" id="maintenance" data-title="Wartung" data-pages="maintenance checklists">
  <h2><i class="ti ti-tool"></i> Wartung</h2>
  <p>Ein <b>Wartungsplan</b> sagt, was wie oft an welcher Anlage gemacht wird – z. B. „alle 2 Wochen“ oder „alle 6 Monate“. Zu jedem aktiven Plan gibt es immer <b>genau einen offenen Auftrag</b>: den nächsten Termin. PDH legt ihn selbst an – beim Anlegen des Plans, nach jedem Abschluss oder Überspringen und stündlich für Pläne, denen einer fehlt. Doppelte Aufträge entstehen nicht.</p>
  <p>Die Wartung ist aufgebaut wie Tickets und der KVP (siehe <a href="#work-views">Tickets</a>):</p>
  <ul>
    <li><b>Dashboard</b>, <b>Aufträge</b> und <b>Board</b> – Kennzahlen, Liste mit Filter-Chips und Status-Spalten. Unter <b>Alle offenen</b> stehen die Aufträge, deren Vorlauf begonnen hat oder die in den nächsten 7 Tagen fällig sind; der Chip <b>Geplant</b> zeigt die späteren.</li>
    <li><b>Jahresplan</b> – je Plan eine Zeile, je Monat eine Spalte: ✓ erledigt, ● offen (rot, wenn überfällig), ○ geplant. Ein Klick öffnet den Auftrag bzw. den Plan.</li>
    <li><b>Pläne</b> – alle Pläne mit Intervall, Checklisten samt Takt und nächstem Termin.</li>
    <li><b>Rundgänge</b> – die Kontrollrundgänge mit ihren Stationen und dem Knopf <b>Rundgang starten</b> (siehe unten).</li>
    <li><b>Checklisten</b> – die Vorlagen bearbeiten.</li>
    <li><b>Regeln &amp; Einstellungen</b> – Regeln, Standard-Frist und Broker für Wartungen.</li>
  </ul>
  <p>Das <b>Archiv</b> ist der Chip <b>Archiv</b> unter <b>Aufträge</b> – mit den erledigten Checklisten, siehe unten.</p>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So führst du eine Wartung durch</b>
    <ol class="hb-steps">
      <li>Unter <b>Aufträge</b> oder auf dem <b>Board</b> bei der Wartung <b>Durchführen</b> antippen – oder im Auftrag den großen Knopf <b>Wartung durchführen</b>. Am <a href="#dashboard">Leitstand</a> geht es genauso über <b>Fertig</b> und die Karte.</li>
      <li>Zuerst kommt die <b>Checkliste</b>: ein Punkt nach dem anderen, darüber der Name der Checkliste. Abhaken, Messwert eintragen (PDH zeigt sofort, ob er zwischen Min und Max liegt) oder Text schreiben. Jeder Punkt wird beim <b>Weiter</b> sofort gespeichert – wirst du unterbrochen, geht es später am offenen Punkt weiter.</li>
      <li>Mit <i class="ti ti-camera-plus"></i> <b>Foto</b> hängst du Bilder direkt an den Punkt – am Handy öffnet sich die Kamera. Das geht überall gleich, auch am Leitstand.</li>
      <li>Danach Material (oder „kein Material“), Zeit (vorgeschlagen ist die geplante Dauer), wer dabei war und ein Kommentar – er wird als Maßnahme gespeichert. Ohne ausgefüllte Pflichtpunkte (✱) lässt sich nicht abschließen.</li>
      <li><b>Fertig</b>: PDH zeigt „Nächster Termin: …“ und legt den Folgeauftrag an. <b>Geht noch weiter</b> speichert alles und lässt den Auftrag offen.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-file-check"></i> Was nach dem Fertigmelden passiert</b>
    <ul>
      <li><b>Wartungsprotokoll als PDF</b> – am Auftrag und als Kopie an der Anlage (Reiter <b>Dokumente</b>): Firmenlogo, Datum, Ausführende(r) und Beteiligte, die Checklisten mit Werten, Vorgaben und Fotos, Maßnahmen, Ersatzteile und Bemerkung.</li>
      <li><b>Rückmeldung im Chat</b> an Verantwortliche, Zugewiesene und wer den Auftrag angelegt hat: wer erledigt hat, ob alles in Ordnung war (⚠ bei Abweichungen), nächster Termin und Links. Wer selbst erledigt hat, bekommt keine Nachricht.</li>
      <li>Der Auftrag zeigt danach das Ergebnis je Checkliste mit Werten, Fotos, Protokoll und dem Link zum Folgeauftrag.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock-open"></i> Wer darf eine Wartung fertig melden?</b>Wer dem Auftrag <b>zugewiesen</b> ist, ihn <b>verantwortet</b> oder zur <b>zugewiesenen Gruppe</b> gehört – auch ohne die Rollenrechte „Wartung bearbeiten/abschließen“. Ist niemand zugewiesen, darf ihn jeder übernehmen (außer Betrachtern). Andere brauchen die Rollenrechte. Am Leitstand genügt die Karte (Instandhaltung/IT). Die Arbeitszeit fragt der Assistent ab – eine eigene Zeiterfassung im Auftrag gibt es nicht.</div>
  {{template "hb-fig-maintenance"}}
  <div class="hb-howto"><b><i class="ti ti-calendar-plus"></i> So legst du einen Wartungsplan an</b>
    <ol class="hb-steps">
      <li><b>Neuer Plan</b> antippen (oder in einem Plan <i class="ti ti-copy"></i> zum Kopieren).</li>
      <li><b>Was</b>: Anlage, Name und Art.</li>
      <li><b>Wann</b>: „alle N Tage / Wochen / Monate / Jahre“ und der <b>nächste Termin</b>. Der <b>Vorlauf (Tage)</b> legt fest, ab wann der Auftrag unter Aufträge („Alle offenen“) und am Leitstand erscheint – bei 0 erst am Fälligkeitstag.</li>
      <li><b>Nach der Durchführung</b>: <b>ab Durchführung</b> (Erledigt-Datum + Intervall) oder <b>fester Rhythmus</b> (die Termine bleiben im Takt, z. B. für Prüffristen; nach langer Überfälligkeit rechnet PDH bis heute weiter). Monate und Jahre rechnet PDH kalendergenau (15.01. → 15.02.).</li>
      <li><b>Wer</b>: Zugewiesen, Gruppe, Verantwortlich (bekommt die Rückmeldung) und die geplante Dauer.</li>
      <li><b>Checklisten</b> hinzufügen und je Checkliste den <b>Takt</b> wählen – „bei jedem Termin“ oder z. B. „alle 1 Monate“. Darunter steht, wann sie zuletzt abgefragt wurde. Die Vorschau zeigt die nächsten Termine.</li>
      <li><b>Speichern</b>. Der erste Auftrag ist sofort da. Änderungen am Plan übernimmt der offene Auftrag, solange daran noch nichts erfasst ist.</li>
    </ol>
    Ein Plan, der eine Zeit nicht gebraucht wird, lässt sich <b>ruhen lassen</b> – sein offener Auftrag verschwindet, beim <b>Aktivieren</b> kommt er wieder. Aufträge ohne Plan legst du mit <b>Einzelauftrag</b> an.</div>
  <div class="hb-howto"><b><i class="ti ti-archive"></i> Erledigte Checklisten im Archiv ansehen</b>
    <ol class="hb-steps">
      <li>Unter <b>Aufträge</b> den Chip <b>Archiv</b> öffnen. Die neuesten Wartungen stehen oben, je Seite 50 – mit „Ältere“ blätterst du weiter.</li>
      <li>Eingrenzen mit <b>Suche</b> (Titel, Anlage, Plan, Bemerkung), <b>Anlage</b> (inklusive Unteranlagen und Rundgang-Stationen), <b>Plan</b>, Zeitraum <b>von/bis</b>, <b>erledigt/übersprungen</b> und <b>nur mit Abweichungen</b> – dann <b>Filtern</b>.</li>
      <li>Jede Zeile zeigt, wer die Wartung ausgeführt hat, Abweichungen (⚠ außerhalb Min/Max, nicht abgehakt), die Zahl der Fotos und das Protokoll-PDF.</li>
      <li>Auf <i class="ti ti-chevron-right"></i> oder <b>Punkte</b> tippen: Die Checkliste klappt auf – jeder Punkt mit Wert, Vorgabe, wer ihn wann erfasst hat und den Fotos. Bei Rundgängen nach Stationen gegliedert.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-route"></i> Kontrollrundgang</b>Ein Kontrollrundgang führt nacheinander über mehrere Anlagen – z. B. der Schichtrundgang durch Halle 2. Jede <b>Station</b> ist eine Anlage mit einer kurzen Checkliste. Termine, Anstehend, Jahresplan, Leitstand, Protokoll-PDF und Rückmeldung laufen wie bei jedem Wartungsplan.
    <ol class="hb-steps">
      <li>Reiter <b>Rundgänge</b> → <b>Neuer Rundgang</b>.</li>
      <li>Name und <b>Bereich</b> wählen (Halle, Linie …) – die Stationen liegen darunter. Intervall, Vorlauf und Zuständige wie bei einem Plan.</li>
      <li>Stationen hinzufügen: <b>Anlage</b> und <b>Checkliste</b> wählen, <b>Station hinzufügen</b>. <b>Alle Unteranlagen</b> übernimmt alle Anlagen direkt unter dem Bereich mit der gewählten Checkliste auf einmal. Die gleiche Checkliste darf an vielen Anlagen stehen.</li>
      <li>Mit den Pfeilen die <b>Reihenfolge</b> festlegen – so wird der Rundgang abgefragt. Jede Station kann ihren eigenen Takt haben (z. B. der Kran nur monatlich); nicht fällige Stationen fallen beim Termin weg.</li>
      <li>Durchführen: im Reiter <b>Rundgänge</b> auf <b>Rundgang starten</b> (oder unter Aufträge, am Leitstand). Oben steht <b>Station 2 von 5</b> mit dem Namen der Anlage.</li>
      <li>Ist an einer Station etwas nicht in Ordnung: <i class="ti ti-alert-triangle"></i> <b>Mangel melden</b>. Die Störung wird mit dieser Anlage angelegt, danach geht es im Rundgang weiter.</li>
      <li>Unterbrochen? Alles Erfasste ist gespeichert – <b>Rundgang fortsetzen</b> macht beim offenen Punkt weiter. Im Protokoll und im Auftrag stehen die Ergebnisse je Station.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-check"></i> Checklisten einrichten</b>
    <ol class="hb-steps">
      <li>Reiter <b>Checklisten</b> öffnen und eine Checkliste anlegen – am besten je Takt eine eigene, z. B. „Säge – jedes Mal“ und „Säge – monatlich“.</li>
      <li>Punkte hinzufügen: Name eintragen, Art wählen und <b>+ Punkt</b>. Du bleibst danach im Anlegen – Art, Pflicht und Einheit bleiben stehen, der Cursor steht wieder im Namensfeld, so legst du mehrere Punkte hintereinander an. Die Arten:
        <ul>
          <li><b>Abhaken</b> – erledigt / nicht erledigt.</li>
          <li><b>Messwert</b> – mit Einheit und den Vorgaben <b>Soll</b>, <b>Min</b> und <b>Max</b>; die Felder erscheinen beim Anlegen direkt, sobald „Messwert“ gewählt ist.</li>
          <li><b>Freitext</b> – Beobachtungen, Zählerstände o. Ä.</li>
        </ul>
        <b>Pflicht</b> (✱) heißt: ohne diesen Punkt kein Abschluss.</li>
      <li>Mit <i class="ti ti-photo-plus"></i> <b>Bild</b> Fotos oder Skizzen zur <b>Darstellung</b> hinterlegen (z. B. wo der Messpunkt sitzt). Sie erscheinen bei der Durchführung über dem Eingabefeld.</li>
      <li>Die Reihenfolge der Punkte lässt sich ändern. Eine Checkliste kann in mehreren Plänen stecken.</li>
    </ol></div>
  {{template "hb-shots" (dict "Ref" (index $s "maintenance") "Can" $can)}}
</section>

<section class="hb-ch" id="infrastructure" data-title="Infrastruktur &amp; IT" data-pages="infrastructure it hmi">
  <h2><i class="ti ti-hierarchy-2"></i> Infrastruktur &amp; IT</h2>
  <p>Der Anlagenbaum bildet euren Betrieb ab: Gebäude → Linien → Anlagen → Geräte. Er startet zugeklappt; mit dem Pfeil klappst du einen Ast auf, die übrigen Äste klappen dabei zu. Kommst du zurück, ist der zuletzt geöffnete Ast wieder offen. <b>Alle aufklappen</b> zeigt den ganzen Baum. In der Anlagenauswahl (z. B. beim Melden) gilt das genauso; beim Suchen werden alle Treffer aufgeklappt.</p>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer darf was bei der Infrastruktur?</b>Unter <b>Rollen &amp; Rechte</b> (Gruppe „Infrastruktur“) gibt es drei Rechte:
    <ul>
      <li><b>Infrastruktur ansehen</b> – Anlagenbaum, Stammkarte, Historie und Kommentare. Ohne dieses Recht fehlt der Menüpunkt. Die Anlagenauswahl beim Melden von Tickets oder Störungen funktioniert trotzdem.</li>
      <li><b>Infrastruktur anlegen, bearbeiten &amp; deaktivieren</b> – Stammdaten, Unteranlagen, Kopieren, Massenbearbeitung, Bauteile und Meldetexte. Schließt Ansehen und Prüfpflichten ein.</li>
      <li><b>Prüfpflichten &amp; Gefährdungsbeurteilungen pflegen und erledigen</b> – im Reiter <b>Prüfungen &amp; GBU</b> anlegen, ändern und Durchführungen erfassen, ohne die Stammdaten der Anlage zu ändern.</li>
    </ul>
    Die Rolle <b>Anlagenverantwortliche/r</b> hat alle drei Rechte und dazu alles, was Techniker dürfen, außerdem Tickets, Störungen und Wartung bearbeiten und abschließen. Sie steht im Rang zwischen Techniker und Manager. Rechte und Rolle lassen sich unter <b>Rollen &amp; Rechte</b> anpassen, einzelne Personen über <b>Einzelrechte</b> im Benutzerstamm.</div>
  <div class="hb-howto"><b><i class="ti ti-stack-push"></i> So legst du viele Anlagen auf einmal an</b>
    <ol class="hb-steps">
      <li>Oben auf <b>Sammelanlegen</b> tippen – oder eine Anlage antippen und unten <b>Sammelanlegen</b> wählen, dann ist sie schon als übergeordnetes Element gewählt.</li>
      <li><b>Ebene 1</b>: Typ wählen (z. B. Anlage), dazu Präfix, von und bis – z. B. „Presse “ von 1 bis 6.</li>
      <li><b>Ebene 2</b> (optional): z. B. Geräte „Motor “ von 1 bis 3 unter jeder Presse. Mit „Namen der Ebene 1 voranstellen“ heißen sie „Presse 1 Motor 1“ usw.</li>
      <li><b>Anlegen</b>. Neue Elemente übernehmen Standort, Kostenstelle und Abteilung des übergeordneten Elements; den Rest ergänzt du in den Stammdaten.</li>
    </ol>
    Elemente gleichen Namens werden nicht doppelt angelegt.</div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> So kopierst du eine Anlage</b>
    <ol class="hb-steps">
      <li>Die Anlage im Baum antippen und unten <b>Kopieren</b> wählen.</li>
      <li><b>Ziel</b> (übergeordnetes Element) und <b>Name</b> wählen – für mehrere Kopien Präfix, von und bis, z. B. „Linie “ von 2 bis 4.</li>
      <li>„mit allen Unteranlagen“ kopiert den ganzen Ast mit.</li>
    </ol>
    Kopiert werden Typ, Beschreibung, Standort, Hersteller, Modell, Partner, Kostenstelle, Abteilung und bei Trockenkammern die Bauteil-Positionen. Seriennummer, Inbetriebnahme, Vorgänge und Historie bleiben leer.</div>
  <p>Zu jeder Anlage gibt es:</p>
  <ul>
    <li><b>Übersicht</b> – die wichtigsten Stammdaten auf einen Blick und die Unteranlagen (anklickbar).</li>
    <li><b>Stammdaten</b> – alle Angaben in einem Formular: Name, Typ, übergeordnetes Element, Standort, Beschreibung, Hersteller, Modell, Seriennummer, „In Betrieb seit“, Lieferant, Servicepartner (Auswahl aus den Lieferanten), Kostenstelle, Abteilung und <b>Verantwortlich</b>. Ohne eigene Angabe gelten Abteilung und Verantwortliche/r des übergeordneten Elements – die Stammkarte zeigt dann „geerbt von …“. Neue Tickets, Störungen, Wartungsaufträge und Aufgaben an der Anlage ohne eigene Angabe bekommen diese Person als <b>Verantwortlich</b> (abschaltbar unter Core-Einstellungen → „Verantwortliche aus der Infrastruktur“).</li>
    <li><b>Anlagen-Historie</b> – das „Lebenslauf-Buch“ der Anlage: alle Störungen, Tickets, Wartungen, Maßnahmen, verbrauchten Ersatzteile und Kommentare. Mit Filter, Suche und <b>CSV-Export</b>. Wichtige Hinweise lassen sich als Kommentar <b>anheften</b>.</li>
    <li><b>Verknüpfungen</b> – offene Vorgänge, passende Ersatzteile, Firmen.</li>
    <li><b>HMI</b> – Fernzugriff auf die Bediengeräte der Anlage (VNC), je nach Berechtigung nur ansehen oder bedienen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Anlage an</b>
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> → <b>Hinzufügen</b>. Für eine Unteranlage geht es schneller über das <b>+</b> in der Zeile im Baum oder auf der Anlage über <b>Untergeordnete Anlagen → Hinzufügen</b>.</li>
      <li><b>Name</b>, <b>Typ</b> und – falls nötig – <b>Übergeordnet</b> und <b>Standort</b> eintragen → <b>Anlegen &amp; weiter</b>.</li>
      <li>Die neue Anlage öffnet sich im Reiter <b>Stammdaten</b>. Hersteller, Modell, Seriennummer, Partner, Kostenstelle und Abteilung ergänzen → <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-edit"></i> So änderst du eine Anlage</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>Stammdaten</b> (oder auf der Übersicht <b>Bearbeiten</b>).</li>
      <li>Felder ändern. Über <b>Typ</b> und <b>Übergeordnet</b> lässt sich eine Anlage auch umordnen, z. B. an eine andere Linie hängen – mit allen Unteranlagen.</li>
      <li><b>Speichern</b>. Die Änderung steht im Reiter <b>Änderungen</b>.</li>
    </ol>
    Eine Anlage kann nicht unter sich selbst oder unter eine ihrer eigenen Unteranlagen gehängt werden.</div>
  <h3 id="obligations"><i class="ti ti-clipboard-check"></i> Prüfpflichten &amp; Gefährdungsbeurteilungen</h3>
  <p>Im Reiter <b>Prüfungen &amp; GBU</b> jeder Anlage stehen wiederkehrende <b>Prüfpflichten</b> (z. B. DGUV V3, UVV, Druckbehälter, Leitern) und <b>Gefährdungsbeurteilungen</b> nach ArbSchG §5. Bald Fälliges ist gelb, Überfälliges rot; die Zahl am Reiter zeigt, wie viele anstehen. Oben auf der Seite <b>Infrastruktur</b> stehen alle fälligen Einträge über alle Anlagen.</p>
  <p>Im Reiter <b>Meldetexte</b> legst du fest, welche vorformulierten Meldungen der <a href="#hb-easy-texts">Easy-Mode</a> an dieser Anlage als Tasten anbietet.</p>
  <div class="hb-howto" id="hb-chamber"><b><i class="ti ti-temperature"></i> So pflegst du eine Trockenkammer</b>
    <ol class="hb-steps">
      <li>Trockenkammer anlegen wie ein Gebäude: <b>Hinzufügen</b> bzw. <b>Unteranlage hinzufügen</b> → Typ <b>Trockenkammer</b>. Eine bestehende Anlage stellst du unter <b>Stammdaten</b> → Typ um.</li>
      <li>Reiter <b>Bauteile</b> öffnen. Dort gibt es je eine Karte für <b>Motoren</b>, <b>Klappenmotoren</b>, <b>Heizungsstellventile</b>, <b>Heizungspumpen</b>, <b>Torrollen</b> und <b>Tordichtungen</b>.</li>
      <li>Je Karte rechts die <b>Anzahl</b> eintragen und <b>Übernehmen</b> – es entsteht je Stück eine Kachel (Motor 1, Motor 2 …), von links nach rechts.</li>
      <li>In jeder Kachel: <b>Typ (Ersatzteil)</b> – Teilenummer oder Bezeichnung tippen und aus der Liste wählen –, <b>NOK</b> anhaken, wenn das Bauteil defekt ist, <b>Letzter Wechsel</b> und <b>Ursache</b> eintragen. Dann <b>… speichern</b> unter der Karte.</li>
    </ol>
    NOK-Kacheln sind rot; am Reiter steht, wie viele Bauteile NOK sind. Wird die Anzahl verringert, fallen die hinteren Kacheln mit ihren Angaben weg (PDH fragt vorher nach). Jede Änderung steht in der Historie der Anlage, z. B. „Motor 2: NOK, Wechsel 01.10.2026, Ursache: Lagerschaden“.</div>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Prüfpflicht oder GBU an</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>Prüfungen &amp; GBU</b> → bei Prüfpflichten bzw. Gefährdungsbeurteilungen <b>Hinzufügen</b>.</li>
      <li>Bezeichnung, Grundlage, Prüfer/Firma und <b>Intervall</b> in Monaten eintragen (0 = einmalig).</li>
      <li><b>Zuletzt erledigt</b> eintragen – die nächste Fälligkeit rechnet PDH selbst aus – oder die <b>nächste Fälligkeit</b> direkt angeben.</li>
      <li><b>Erinnern (Tage vorher)</b> und die <b>verantwortliche Person</b> wählen → <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So erfasst du eine Durchführung</b>
    <ol class="hb-steps">
      <li>Eintrag anklicken → <b>Erledigt erfassen</b>.</li>
      <li>Datum, Ergebnis (<b>ohne</b> oder <b>mit Mängeln</b>) und Bemerkung, z. B. Prüfbericht-Nr. → <b>Durchführung speichern</b>.</li>
      <li>Die nächste Fälligkeit ist neu gesetzt; unter <b>Nachweise</b> stehen alle Durchführungen. Den Prüfbericht unter <b>Dokumente</b> ablegen.</li>
    </ol>
    <b>Erinnerung:</b> Die verantwortliche Person – ohne Eintrag alle Admins – bekommt im Chat eine Nachricht von „Service“, sobald der Vorlauf beginnt, und noch einmal, wenn die Fälligkeit überschritten ist. Neu anlegen, Durchführungen und Löschen stehen im Reiter <b>Änderungen</b>.</div>
  <p><b>IT-Assets</b> (PCs, Netzwerk, Steuerungen) haben Hersteller und Lieferant und können einer Anlage zugeordnet werden.</p>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> Wer darf den Anlagenbaum ändern?</b>Anlegen, Bearbeiten und Deaktivieren von Gebäuden, Linien, Anlagen und Geräten braucht die Berechtigung <b>Infrastruktur anlegen, bearbeiten &amp; deaktivieren</b> (Kategorie „Infrastruktur“). Standardmäßig haben sie Administratoren und Manager; weiteren Rollen gibst du sie unter <b>Rollen &amp; Berechtigungen</b>. Ohne sie fehlen die Knöpfe „Hinzufügen“ und „Bearbeiten“ – ansehen, kommentieren und Vorgänge zuordnen geht weiterhin.</div>
  <h3 id="hmi"><i class="ti ti-device-desktop-analytics"></i> HMI-Fernzugriff</h3>
  <p>Über den Reiter <b>HMI</b> einer Anlage siehst du den Bildschirm ihrer Bediengeräte direkt im Browser – ohne eigenes VNC-Programm. Die Verbindung läuft immer über den PDH-Server; das VNC-Passwort bleibt dort und wird nie an den Browser gegeben. Jeder Zugriff wird mit Name, Zeit, Art und Dauer protokolliert („Letzte Zugriffe“).</p>
  <ul>
    <li><b>HMI ansehen</b> – nur zuschauen. Tastatur, Maus und Zwischenablage verwirft der Server, auch wenn der Browser sie schicken würde.</li>
    <li><b>HMI bedienen</b> – mit Tastatur und Maus arbeiten, sofern am HMI „Bedienen erlaubt“ ist. Deine Eingaben wirken direkt auf die Anlage.</li>
    <li><b>HMI-Verbindungen einrichten</b> – HMIs anlegen, ändern, löschen.</li>
  </ul>
  <p>Standardmäßig dürfen Administratoren, Manager und Techniker ansehen; bedienen und einrichten nur Administratoren. Weitere Rollen bekommen die Rechte unter <b>Rollen &amp; Berechtigungen</b> (Kategorie „Infrastruktur“).</p>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So richtest du ein HMI ein</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>HMI</b> → <b>HMI hinzufügen</b>.</li>
      <li><b>Name</b>, <b>Adresse</b> (IP oder Rechnername im Anlagennetz), <b>Port</b> (meist 5900) und das <b>VNC-Passwort</b> des Panels eintragen. Der PDH-Server muss das HMI im Netz erreichen können.</li>
      <li><b>Bedienen erlaubt</b> abwählen, wenn an diesem HMI niemand aus der Ferne eingreifen soll – dann ist für alle nur Ansehen möglich.</li>
      <li><b>Speichern</b>. Beim Ändern bleibt das Passwort, wenn du das Feld leer lässt.</li>
    </ol>
    Unterstützt werden VNC ohne Anmeldung und mit VNC-Passwort. Verlangt das HMI ein anderes Verfahren (z. B. VeNCrypt/TLS oder Benutzer + Passwort), meldet der Viewer das.</div>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> So greifst du auf ein HMI zu</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>HMI</b> → <b>Ansehen</b> oder <b>Bedienen</b>. Der Viewer öffnet sich in einem neuen Tab.</li>
      <li>Oben stehen Modus und Verbindungsstatus. <b>Anpassen</b> schaltet zwischen Fenstergröße und Originalgröße um, <b>Vollbild</b> nutzt den ganzen Bildschirm, <b>Strg+Alt+Entf</b> (nur beim Bedienen) sendet die Tastenkombination ans HMI.</li>
      <li>Mit <b>Bedienen</b> bzw. <b>Nur ansehen</b> wechselst du den Modus; die Verbindung wird dafür neu aufgebaut.</li>
      <li>Tab schließen oder Zurück beendet die Verbindung. Auch die automatische Abmeldung bei Inaktivität trennt sie.</li>
    </ol>
    Am HMI bleibt eine laufende Sitzung bestehen – der Zugriff aus PDH verbindet immer „geteilt“.</div>
  <div class="hb-howto"><b><i class="ti ti-building-bank"></i> So suchst du eine Anlage nach Kostenstelle</b>
    <ol class="hb-steps">
      <li>In der Infrastruktur-Auswahl (z. B. beim Anlegen eines Tickets) rechts neben dem Suchfeld <b>Nach Kostenstelle</b> wählen.</li>
      <li>Die Kostenstelle aufklappen. Darunter steht ihre Infrastruktur mit dem gewohnten Baum. Die Zahl neben der Kostenstelle zeigt, wie viele Teile dazugehören.</li>
      <li>Die Anlage anklicken. <b>Nach Standort</b> schaltet zurück auf den Baum Gebäude → Linie → Anlage → Gerät.</li>
    </ol>
    Hat ein Teil keine eigene Kostenstelle, gehört es zur Kostenstelle darüber. Hat ein Teil eine andere Kostenstelle als sein Gebäude, steht es bei seiner eigenen Kostenstelle, mit dem Hinweis, wo es steht („in Halle 1 › Linie A“). Teile ganz ohne Kostenstelle stehen unter <b>Ohne Kostenstelle</b>. Die Suche findet auch Kostenstellen. Der Browser merkt sich die gewählte Ansicht.</div>
  <h3><i class="ti ti-device-desktop-pin"></i> Terminal-Standort: Auswahl öffnet sich am richtigen Ort</h3>
  {{template "hb-fig-terminal"}}
  <p>Steht ein Terminal (Systembenutzer) fest in einer Halle oder an einer Linie, kannst du ihm diesen Standort geben. Wer dort ein Ticket, eine Störung oder eine Wartung anlegt, sieht die Infrastruktur-Auswahl schon bis zu diesem Standort aufgeklappt und hervorgehoben – die genaue Anlage wählt man dann mit einem Klick. Das gilt auch, wenn sich jemand kurz mit dem eigenen Konto am Terminal anmeldet.</p>
  <div class="hb-howto"><b><i class="ti ti-map-pin"></i> So stellst du den Standort eines Terminals ein</b>
    <ol class="hb-steps">
      <li><b>Benutzer</b> → den Systembenutzer des Terminals öffnen → Reiter <b>Stammdaten</b> (Berechtigung <i>Benutzer verwalten</i>).</li>
      <li>Unter <b>Systemnutzer</b> erscheint <b>Standort des Terminals</b>: im Baum Gebäude, Linie oder Anlage antippen.</li>
      <li><b>Speichern</b>. Auf der Übersicht steht jetzt „Terminal-Standort“; die Änderung erscheint in der Historie.</li>
    </ol>
    Wird die Anlage später gelöscht, ist der Standort automatisch wieder leer – dann klappt der Baum wie gewohnt ganz auf.</div>
  {{template "hb-shots" (dict "Ref" (index $s "infrastructure") "Can" $can)}}
</section>

<section class="hb-ch" id="watch" data-title="Anlagen-Schnellübersicht" data-pages="plant-watch">
  <h2><i class="ti ti-eye"></i> Anlagen-Schnellübersicht</h2>
  <p>Die <b>Anlagen-Schnellübersicht</b> (Navigation → Material &amp; Anlagen) zeigt Anlagen, auf die ihr ein besonderes Augenmerk legt, auf einen Blick – z. B. alle Trockenkammern mit ihren Motoren, Klappenmotoren, Heizungsventilen und -pumpen. Je Anlage gibt es eine Karte mit Ampel:</p>
  <ul>
    <li><b>Rot – Handlungsbedarf:</b> eine kritische Störung ist offen oder ein Bauteil steht auf NOK.</li>
    <li><b>Gelb – beobachten:</b> eine Störung ist offen, eine Wartung oder eine Prüfpflicht ist überfällig.</li>
    <li><b>Grün – alles OK.</b></li>
  </ul>
  <p>Gezählt wird immer die Anlage mit allen Unteranlagen. Bei Trockenkammern steht je Bauteilgruppe eine Reihe nummerierter Kästchen: grün = OK, rot = NOK, grün ist der Standard. Mit der Maus darauf (oder lange tippen) siehst du Typ, letzten Wechsel und Ursache. Mit dem Recht <b>Infrastruktur bearbeiten</b> schaltet <b>ein Klick</b> das Bauteil von grün (OK) auf rot (NOK) und wieder zurück – die Änderung steht in der Historie der Anlage. Ohne das Recht öffnet der Klick den Reiter <b>Bauteile</b>. Bei anderen Anlagen stehen die Unteranlagen und Geräte mit eigenem Ampelpunkt darunter. Sind der Anlage oder ihren Unteranlagen <b>Energiewerte</b> zugeordnet (Import-Zuordnungen aus MQTT, Modbus, OPC-UA … mit Bezeichnungen wie Energie, kWh, Leistung, Strom, Verbrauch, Gas, Wärme, Druckluft), zeigt die Karte den letzten Messwert mit <i class="ti ti-bolt"></i>; Werte älter als ein Tag sind grau. Die Karten aktualisieren sich jede Minute von selbst. <b>Nur Auffälliges</b> blendet alle grünen Karten aus.</p>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Schnellübersicht an</b>
    <ol class="hb-steps">
      <li><b>Anlagen-Schnellübersicht</b> öffnen → <b>Neue Übersicht</b>.</li>
      <li><b>Name</b> eintragen, z. B. „Trockenkammern“, und optional ein Symbol (z. B. <code>ti-temperature</code>).</li>
      <li>Unter <b>Ganze Anlagentypen</b> z. B. „alle Trockenkammer“ anhaken – dann erscheinen auch später angelegte Trockenkammern automatisch. Oder unter <b>Einzelne Anlagen &amp; Geräte</b> gezielt Anlagen wählen (das Suchfeld filtert die Liste).</li>
      <li>Mit dem Recht zum Einrichten: unter <b>Freigeben für Gruppen</b> bzw. <b>für einzelne Benutzer</b> festlegen, wer die Übersicht sieht.</li>
      <li><b>Speichern</b>. Die Übersicht steht oben als Reiter; mehrere Übersichten wechselst du dort.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer sieht und ändert was?</b>
    <ul>
      <li>Die Seite braucht das Recht <b>Infrastruktur ansehen</b>.</li>
      <li>Jede/r kann eigene Übersichten anlegen – sie sind nur für sie/ihn selbst sichtbar.</li>
      <li>Mit dem Recht <b>Anlagen-Schnellübersichten einrichten und für Benutzer/Gruppen freigeben</b> (Administratoren, Manager, Anlagenverantwortliche) gibst du Übersichten für Gruppen oder einzelne Personen frei und kannst alle Übersichten bearbeiten und löschen. Wer in einer freigegebenen Gruppe ist, sieht die Übersicht automatisch.</li>
    </ul>
    Löschen entfernt nur die Übersicht – die Anlagen und ihre Daten bleiben unverändert.</div>
  {{template "hb-shots" (dict "Ref" (index $s "watch") "Can" $can)}}
</section>

<section class="hb-ch" id="qrcodes" data-title="QR-Codes an Anlagen &amp; Geräten" data-pages="asset-info">
  <h2><i class="ti ti-qrcode"></i> QR-Codes an Anlagen &amp; Geräten</h2>
  <p>Jede Anlage der Infrastruktur und jedes IT-Asset hat einen eigenen QR-Code. Er führt auf eine <b>Infoseite</b>, die fürs Handy gebaut ist: Stammdaten, alle <b>offenen Störungen, Tickets, Aufträge/Aufgaben und Wartungen</b> und große Knöpfe zum Neuanlegen.</p>
  <div class="hb-howto"><b><i class="ti ti-scan"></i> So arbeitest du mit dem QR-Code an der Maschine</b>
    <ol class="hb-steps">
      <li>QR-Code mit der Handy-Kamera scannen. Bist du nicht angemeldet, öffnet sich bei Anlagen der <b>Easy-Mode</b> (siehe unten) – oben rechts <b>Anmelden</b>, danach geht es direkt auf die Infoseite.</li>
      <li>Einen offenen Vorgang antippen: Er klappt auf – <b>Ansehen</b>, <b>Bearbeiten</b> oder <b>Beheben</b>/<b>Abschließen</b>/<b>Erledigen</b>/<b>Durchführen</b> startet den gewohnten Abschluss-Assistenten Schritt für Schritt.</li>
      <li>Hilfen dazu: oben in der Kopfleiste <i class="ti ti-brain"></i> <b>Copilot</b> klappt die Vorschläge auf und zu (blinkt gelb, wenn es welche gibt), <i class="ti ti-messages"></i> <b>Chat</b> genauso.</li>
      <li>Oder oben <b>Störung melden</b>, <b>Ticket</b>, <b>Aufgabe</b> bzw. <b>Wartung</b> antippen. Anlage (und beim IT-Asset das Gerät) sind schon eingetragen. Nach dem Speichern kommst du zurück auf die Infoseite.</li>
    </ol></div>
  <p>Bei Anlagen mit Unteranlagen zeigt die Seite auch die Vorgänge der Unteranlagen (mit deren Namen); „nur diese Anlage“ blendet sie aus. Über <b>Unteranlagen</b> und den Pfeil zur übergeordneten Anlage wechselst du direkt zur nächsten Infoseite. Ein IT-Asset zeigt die Vorgänge, die diesem Gerät zugeordnet sind, und verweist auf die Anlage, bei der es steht. Wartungen für ein IT-Asset gehen nur, wenn es einer Anlage zugeordnet ist.</p>
  <h3 id="easy-mode"><i class="ti ti-hand-finger"></i> Easy-Mode: melden ohne Anmeldung</h3>
  <p>Damit wirklich jeder eine Störung melden kann – auch ohne Konto und in der eigenen Sprache –, öffnet der QR-Code einer Anlage für Nicht-Angemeldete eine einfache Meldeseite. Sie erscheint in der <b>Sprache des Handys</b> (Deutsch, Englisch, Rumänisch, Türkisch, Mazedonisch; oben umschaltbar) und zeigt die <b>letzten 5 Meldungen</b> der Anlage sowie zwei große Tasten <b>Störung +</b> und <b>Ticket +</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So meldest du im Easy-Mode</b>
    <ol class="hb-steps">
      <li>QR-Code scannen → <b>Störung +</b> (etwas ist kaputt) oder <b>Ticket +</b> (etwas wird gebraucht).</li>
      <li><b>Was ist zu melden?</b> – einen der vorgegebenen <b>Meldetexte</b> antippen (falls für die Anlage hinterlegt) und/oder in der eigenen Sprache schreiben. Mit Meldetext ist der eigene Text freiwillig. Darunter mit <b>Foto aufnehmen</b> oder <b>Bild wählen</b> bis zu drei Fotos vom Problem anhängen (freiwillig).</li>
      <li><b>Elektrisch</b> oder <b>Mechanisch</b> antippen. Gibt der Meldetext das schon vor, entfällt dieser Schritt.</li>
      <li><b>Anlage läuft</b> oder <b>Anlage steht</b> antippen – fertig, die Meldung ist da.</li>
    </ol>
    Die Meldung wird automatisch ins Deutsche übersetzt (Copilot). In der Störung bzw. im Ticket steht der <b>deutsche Text immer oben</b>, darunter das Original, dann die Art und ob die Anlage steht. „Anlage steht“ bekommt hohe Priorität. Ersteller ist „Service“, in der Historie steht „QR-Code (Easy-Mode)“. Nach dem Namen fragt der Easy-Mode nicht. Mit Meldetext ist dieser der Titel der Meldung, ein eigener Text steht als Ergänzung darunter. Ohne eingerichteten Copilot bleibt der Text in der Originalsprache mit Hinweis.</div>
  <div class="hb-howto" id="hb-easy-texts"><b><i class="ti ti-message-2"></i> So hinterlegst du Meldetexte für den Easy-Mode</b>
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> öffnen → unten <b>Easy-Mode: Meldetexte</b> → bei <b>Neuer Meldetext</b> den Text auf Deutsch eintragen, z. B. „Band steht“ oder „Öl tritt aus“.</li>
      <li>Wählen, ob der Text für <b>Störung &amp; Ticket</b>, nur Störung oder nur Ticket gilt, und ob er <b>immer elektrisch</b> bzw. <b>immer mechanisch</b> ist – dann fragt der Easy-Mode das nicht mehr. <b>Anlegen</b>.</li>
      <li>Anlage öffnen → Reiter <b>Meldetexte</b> → passende Texte anhaken → <b>Zuordnung speichern</b>. Einen Text an einer Halle oder Linie zuordnen, dann gilt er für alle Anlagen darunter (dort steht „über …“).</li>
      <li>Fehlt ein Text, im Reiter unten direkt <b>Anlegen und zuordnen</b> – er kommt in den Katalog und gilt gleich an dieser Anlage.</li>
      <li>Die <b>Reihenfolge</b> der Tasten legst du im Katalog mit <i class="ti ti-chevron-up"></i> / <i class="ti ti-chevron-down"></i> fest – sie gilt für alle Anlagen. Neue Texte kommen ans Ende.</li>
    </ol>
    Im Easy-Mode erscheinen die Texte als große Tasten in der <b>Sprache des Handys</b> (automatisch übersetzt, wenn unter Server-Einstellungen → Übersetzung ein Dienst eingerichtet ist, sonst auf Deutsch). In der Meldung steht immer der deutsche Text. Ändern oder Löschen geht im Katalog; gelöschte Texte verschwinden von allen Anlagen.</div>
  <div class="hb-howto"><b><i class="ti ti-hand-finger"></i> So testest du den Easy-Mode (Admins)</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → oben <b>Easy-Mode testen</b>. Die Meldeseite öffnet sich in einem neuen Tab – genau so, wie sie nach dem QR-Scan aussieht.</li>
      <li>Oben steht gelb <b>Testansicht (Admin)</b>. Sprache oben umschalten, um die Seite in anderen Sprachen zu sehen.</li>
      <li>Eine Testmeldung durchspielen. Sie wird echt angelegt, der Titel beginnt aber mit <b>„TEST:“</b> – danach in Störungen bzw. Tickets wiederfinden und löschen.</li>
    </ol>
    Der Knopf funktioniert auch, wenn der Easy-Mode ausgeschaltet ist – so lässt er sich vor dem Einschalten ausprobieren.</div>
  <p>Der Easy-Mode lässt sich unter <b>Core-Einstellungen → Easy-Mode</b> abschalten; dann führen QR-Codes wie früher zur Anmeldung. Zum Schutz vor Missbrauch nimmt PDH je Gerät höchstens 6 Meldungen in 10 Minuten und je Anlage 30 in der Stunde an. Im Easy-Mode sieht man nur Titel, Zeitpunkt und Status der letzten Meldungen – keine Namen und keine anderen Seiten.</p>
  <div class="hb-howto"><b><i class="ti ti-printer"></i> So druckst du QR-Etiketten</b>
    <ol class="hb-steps">
      <li>Einzeln: in der Anlage bzw. im IT-Asset oben auf <i class="ti ti-printer"></i> – oder auf der Infoseite unter <b>QR-Code dieser Seite → Etikett drucken</b>.</li>
      <li>Für eine Anlage samt allen Unteranlagen: im Menü <i class="ti ti-dots"></i> der Anlage <b>QR-Etiketten inkl. Unteranlagen</b>. Für den ganzen Bestand: in der Liste Infrastruktur bzw. IT oben <b>QR-Etiketten</b>.</li>
      <li>Format wählen und <b>Drucken</b> – oder ohne Druckdialog <b>Direkt drucken</b> auf einen eingerichteten Drucker (<a href="#printers">Drucker</a>). Die Formate sind dieselben wie bei den <a href="#storage">Lager-Etiketten</a>.</li>
    </ol></div>
  <p>Auf der Infoseite und auf dem Etikett erscheint nur, was die Person sehen darf (Modulrechte und Abteilungs-Sicht). Der Link im QR-Code nutzt die <b>öffentliche Adresse</b> aus den Server-Einstellungen – damit er auch vom Handy aus funktioniert.</p>
  {{template "hb-shots" (dict "Ref" (index $s "qrcodes") "Can" $can)}}
</section>

<section class="hb-ch" id="inventory" data-title="Ersatzteile" data-pages="inventory inventory-scan">
  <h2><i class="ti ti-package"></i> Ersatzteile</h2>
  <p>Die Ersatzteilliste hat oben Reiter je <b>Kategorie</b> und Kacheln für „unter Mindestbestand“, „kritisch“, „leer“ und „ohne Lieferant“.</p>
  <h3><i class="ti ti-building-factory-2"></i> Hersteller und Lieferant sind zwei verschiedene Dinge</h3>
  {{template "hb-fig-partner"}}
  <div class="hb-howto"><b><i class="ti ti-photo"></i> So bekommt ein Teil ein Bild</b>
    <ol class="hb-steps">
      <li>Teil öffnen → Reiter <b>Stammdaten</b> → <b>Bild im Internet suchen</b>.</li>
      <li>Der Suchbegriff ist schon ausgefüllt (Hersteller + Teilenummer) – bei Bedarf anpassen.</li>
      <li>Auf das passende Bild klicken – es wird übernommen und im PDH gespeichert.</li>
    </ol>
    Alternativ: Bild-URL einfügen, Datei hochladen oder mit der Kamera fotografieren.</div>
  <h3 id="part-docs"><i class="ti ti-file-search"></i> Datenblatt und Benutzerhandbuch</h3>
  <p>Zu jedem Teil kann PDH das <b>aktuelle Datenblatt</b> und das <b>Benutzerhandbuch</b> aus dem Internet holen und unter <b>Dokumente</b> ablegen. Die Dateien liegen danach im PDH – sie sind auch dann da, wenn der Hersteller seine Seite umbaut.</p>
  {{template "hb-fig-partdocs"}}
  <div class="hb-howto"><b><i class="ti ti-file-search"></i> So holst du Datenblatt und Handbuch</b>
    <ol class="hb-steps">
      <li>Teil öffnen → Reiter <b>Dokumente</b> → <b>Datenblatt &amp; Handbuch suchen</b>.</li>
      <li>Hersteller und Typ sind schon eingetragen (aus den Stammdaten). Am besten findet PDH mit <b>Hersteller + Hersteller-Teilenummer</b> – bei Bedarf anpassen und <b>Suchen</b>. Die Suche dauert bis zu einer Minute.</li>
      <li>Die Treffer stehen getrennt nach <b>Datenblatt</b> und <b>Benutzerhandbuch</b>. <span class="badge b-green">Hersteller</span> heißt: direkt vom Hersteller. Mit <b>Ansehen</b> öffnest du das PDF vorher im Browser.</li>
      <li><b>Übernehmen</b> lädt das PDF herunter. Es erscheint unter Dokumente mit dem Etikett <b>Datenblatt</b> oder <b>Benutzerhandbuch</b>, dem Stand und einem Link zur Quelle.</li>
    </ol>
    Du hast das PDF schon selbst gefunden? Die Adresse unten im Fenster einfügen, Art wählen, <b>Übernehmen</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> So bleibt es aktuell</b>
    <ol class="hb-steps">
      <li>Beim Dokument auf <b>Aktualisieren</b> – oder oben auf <b>Alle aktualisieren</b> für alle Dokumente des Teils.</li>
      <li>PDH lädt das Dokument erneut von der Quelle. Hat der Anbieter eine <b>neue Fassung</b>, wird die alte Datei ersetzt und im Verlauf vermerkt. Sonst ändert sich nur das Datum bei „Stand“.</li>
    </ol></div>
  <p><b>Wie wird gesucht?</b> Ist unter Server-Einstellungen → Copilot ein Anthropic-Schlüssel hinterlegt, sucht <b>Claude</b> im Internet – zuerst beim Hersteller, dann bei seriösen Händlern. Sonst sucht PDH über DuckDuckGo. Angezeigt werden in beiden Fällen nur Adressen, hinter denen PDH wirklich ein PDF gefunden hat. Manche Anbieter geben Dokumente nur nach Anmeldung heraus – dann das PDF selbst herunterladen und über <b>Dokument</b> hochladen. Nutzungsrechte des Anbieters beachten. Suchen und übernehmen kann, wer Ersatzteile bearbeiten darf.</p>
  <div class="hb-howto"><b><i class="ti ti-qrcode"></i> So buchst du per QR-Code am Lagerplatz</b>
    <ol class="hb-steps">
      <li>Den QR-Code auf dem Lagerplatz-Etikett mit dem Smartphone scannen – oder im Teil oben auf <b>Buchen</b>. Es öffnet sich die <b>Buchungserfassung</b> mit Bild, Beschreibung und Bestand. Der Lagerplatz des Etiketts ist schon gewählt.</li>
      <li>Buchungsart antippen:
        <b>Einbuchung</b> (Wareneingang),
        <b>Ausbuchung</b> (Entnahme),
        <b>Reservierung</b> (zurücklegen),
        <b>Sonstiges</b> (Zugang oder Abgang mit Grund, z. B. Ausschuss, Rücksendung) oder
        <b>Korrektur</b> (gezählten Bestand eintragen, PDH bucht die Differenz).</li>
      <li>Bei <b>Ausbuchung</b> und <b>Reservierung</b> wählst du, wofür: einen offenen <b>Vorgang</b> (Störung, Ticket, Aufgabe, Wartung – deine eigenen stehen oben, tippen zum Suchen) oder eine <b>Anlage</b> aus dem Infrastruktur-Baum. Ohne Zuordnung bucht PDH nicht.</li>
      <li>Menge eingeben – <b>Buchen</b>. Mehr als am Lagerplatz liegt, lässt sich nicht ausbuchen.</li>
    </ol>
    Eine Reservierung auf eine Anlage steht beim Teil unter <b>Reservierungen</b>: <b>Verbraucht</b> bucht sie als Entnahme, <b>Zurückbuchen</b> legt sie zurück. Etiketten, die vor dieser Version gedruckt wurden, öffnen noch das Teil – dort führt <b>Buchen</b> zur Erfassung.
    Rechte: „Ersatzteile ein-/ausbuchen und reservieren“ für Einbuchung, Ausbuchung, Reservierung; „Bestandskorrekturen und sonstige Buchungen“ für Sonstiges und Korrektur.</div>
  <h3 id="reservation"><i class="ti ti-bookmark"></i> Ersatzteile reservieren</h3>
  <p>Teile für eine Störung, ein Ticket, eine Aufgabe oder eine Wartung werden <b>reserviert</b>: Die Menge wird sofort vom gewählten Lagerplatz <b>abgebucht</b>. So kann sie niemand anderes mehr verplanen. Der Bestand zeigt dann nur noch die freie Menge, die reservierte steht <b>in Klammern</b> daneben – z. B. <b>6 <span class="res-q">(4)</span></b> / 2 Stk: 6 frei, 4 reserviert, Mindestbestand 2. Das gilt in der Ersatzteilliste, beim Teil, je Lagerplatz und bei der Teilesuche im Abschluss-Assistenten.</p>
  <div class="hb-howto"><b><i class="ti ti-bookmark"></i> So reservierst du und buchst zurück</b>
    <ol class="hb-steps">
      <li>Im Vorgang bei <b>Ersatzteile</b> auf <b>Ersatzteil reservieren</b> (oder im Abschluss-Assistenten beim Schritt Material): Teil suchen, Lagerplatz und Menge wählen, <b>Reservieren</b>. Liegt dort nicht genug, lehnt PDH ab und nennt die freie Menge.</li>
      <li>Die Position trägt jetzt die Kennzeichnung <span class="res-q">reserviert</span>.</li>
      <li>Nicht alles gebraucht? An der Position <b>Zurückbuchen</b> und die Menge angeben – auch teilweise. Das <i class="ti ti-x"></i> bucht die ganze Position zurück.</li>
      <li>Beim <b>Fertig</b> im Abschluss-Assistenten wird der Rest zum <b>Verbrauch</b> des Vorgangs. Doppelt abgebucht wird nichts.</li>
    </ol>
    Wird ein Vorgang <b>verworfen, archiviert oder gelöscht</b>, ohne dass das Material verbucht wurde, gehen offene Reservierungen automatisch an ihren Lagerplatz zurück.</div>
  <p>Beim Teil zeigt der Reiter <b>Lager &amp; Bewegungen</b> die Karte <b>Reservierungen</b>: für welchen Vorgang, an welchem Lagerplatz, von wem. Mit <b>Zurückbuchen</b> lässt sich dort direkt zurückbuchen. In den Bewegungen erscheinen <span class="badge b-amber">Reservierung</span> und <span class="badge b-blue">Rückbuchung Reservierung</span>. Nach dem Abschluss wird daraus <i>Abgang</i>, eine vorherige Teil-Rückbuchung zählt als <i>Zugang</i>. Reservierungen entstehen nur über Vorgänge, nicht über die manuelle Buchung. Vor dieser Version vorgemerkte Teile sind noch nicht abgebucht und werden wie bisher erst beim Abschluss gebucht.</p>
  <div class="hb-howto"><b><i class="ti ti-truck-delivery"></i> So buchst du einen Lieferschein mit dem Smartphone</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Scannen</b> → Reiter <b>Lieferschein</b>.</li>
      <li><b>Seite fotografieren</b> – jede Seite einzeln, gerade von oben und gut ausgeleuchtet. Ein PDF vom Lieferanten geht über <b>Fotos / PDF wählen</b>.</li>
      <li><b>Lieferschein erkennen</b>. Nach 20 bis 60 Sekunden steht jede Position mit Vorschlag da: <b>Zugang buchen</b> zu einem gefundenen Teil (grün: über Teile-, Hersteller- oder Lieferanten-Nummer gefunden) oder <b>Neu anlegen + buchen</b>.</li>
      <li>Oben Lieferant und <b>Lagerort für alle</b> prüfen, bei Bedarf je Position Menge, Teil oder Lagerort ändern, Unpassendes auf <b>Überspringen</b> stellen.</li>
      <li><b>Zugänge buchen</b> – alle Positionen werden zusammen gebucht, mit der Lieferschein-Nr. als Beleg.</li>
    </ol>
    Mit gewähltem Lieferanten merkt sich PDH dessen Artikelnummern am Teil – der nächste Lieferschein findet die Teile dann direkt. Fotos und Ergebnis bleiben unter <b>Scannen → Letzte Scans</b> erhalten.</div>
  <div class="hb-howto"><b><i class="ti ti-camera-search"></i> So erkennst du ein Bauteil per Foto</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Scannen</b> → Reiter <b>Bauteil erkennen</b>.</li>
      <li>Das Teil fotografieren, am besten zusätzlich das Typenschild bzw. Etikett (bis zu drei Fotos).</li>
      <li><b>Bauteil erkennen</b>. PDH zeigt Bezeichnung, Hersteller, Typ und Merkmale – und darunter passende Teile <b>im Lager</b> mit Bestand.</li>
      <li>Passt ein Teil: <b>Öffnen</b> oder <b>Buchen</b>. Sonst unten <b>Als neues Teil anlegen</b> – die Felder sind vorausgefüllt.</li>
      <li>Unter <b>Teilebild</b> zeigt PDH passende Bilder aus dem Internet (gesucht nach Hersteller und Teilenummer). Das erste ist ausgewählt, ein Klick wählt ein anderes, <b>Suchen</b> mit anderem Begriff sucht neu. Statt dessen geht auch <b>Eigenes Foto</b> oder <b>Kein Bild</b>.</li>
      <li><b>Teil anlegen</b>. Lässt sich das Internet-Bild nicht laden, nimmt PDH dein Foto.</li>
    </ol>
    Große Handyfotos sind kein Problem: PDH verkleinert sie vor der Erkennung selbst.
    „Unsicher“ heißt: lieber ein weiteres Foto vom Typenschild machen. Nummern übernimmt PDH nur, wenn sie im Bild lesbar sind. Für beides braucht es das Recht „Lager bearbeiten“ und Claude als Copilot (Server-Einstellungen → Copilot).</div>
  <div class="hb-howto"><b><i class="ti ti-truck-off"></i> Rückstand und Bestellvorschlag beim Lieferschein</b>Steht auf dem Lieferschein eine bestellte Menge oder ein Rückstand, zeigt die Position <b>Rückstand …</b> (rot), und oben steht, wie viele Positionen nicht vollständig geliefert sind. Gebucht wird immer nur die gelieferte Menge. Lag ein gefundenes Teil unter Mindestbestand, steht <b>im Bestellvorschlag</b> daneben. Nach dem Buchen listet die Seite die Teile dieses Lieferanten, die <b>noch unter Mindestbestand</b> liegen – mit Link zum Bestellvorschlag.</div>
  <div class="hb-howto"><b><i class="ti ti-barcode"></i> So findest du ein Teil per Barcode</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Barcode</b> und den Strichcode auf Teil oder Verpackung fotografieren.</li>
      <li>Ist die Nummer eindeutig einem Teil zugeordnet – EAN, Teilenummer, Hersteller- oder Lieferanten-Artikelnummer –, öffnet sich das Teil direkt im Reiter <b>Lager &amp; Bewegungen</b> zum Buchen. Sonst zeigt die Liste alle Treffer. Ein QR-Code von einem PDH-Etikett oder einer Kanban-Karte öffnet direkt die Buchungserfassung bzw. die Karte.</li>
    </ol>
    Die EAN trägst du in den <b>Stammdaten</b> des Teils ein – auch per Barcode-Knopf neben dem Feld. PDH prüft die Prüfziffer. Beim Lieferschein- und Bauteil-Scan wird eine erkannte EAN bei neuen Teilen übernommen und bei vorhandenen ohne EAN ergänzt. Kann der Browser keine Barcodes lesen (z. B. Safari auf dem iPhone), fragt PDH nach der Nummer zum Eintippen.</div>
  {{template "hb-shots" (dict "Ref" (index $s "inventory") "Can" $can)}}
</section>

<section class="hb-ch" id="storage" data-title="Lager, Lagerplätze &amp; Etiketten" data-pages="storage labels-designer">
  <h2><i class="ti ti-building-warehouse"></i> Lager, Lagerplätze &amp; Etiketten</h2>
  <p>Das Lager ist gegliedert in Lagerort → Regal → Fach → Platz. Über <i class="ti ti-external-link"></i> öffnest du einen Platz mit Bestand, Bewegungen und Dokumenten.</p>
  <h3><i class="ti ti-printer"></i> Etiketten</h3>
  <p>So sieht ein Etikett im Standard aus – der QR-Code öffnet mit dem Handy direkt die <b>Buchungserfassung</b> des Teils an diesem Lagerplatz:</p>
  <figure class="hb-fig" style="display:flex;justify-content:center">
    <div style="width:62mm;height:29mm;background:#fff;color:#111;display:flex;gap:1.5mm;padding:1.5mm 2mm;border:1px solid #ccc;border-radius:2px;text-align:left;font-family:Arial,sans-serif">
      <div style="height:100%;aspect-ratio:1/1;flex-shrink:0">{{.SampleQR}}</div>
      <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;line-height:1.12">
        <div style="font-weight:700;font-size:9pt;border-bottom:.3mm solid #000">Fach 3</div>
        <div style="font-size:7pt;font-weight:600">Rillenkugellager 6205</div>
        <div style="display:flex;justify-content:space-between;align-items:flex-end">
          <div style="min-width:0;flex:1"><div style="font-size:5pt;color:#555">TEILE-NR.</div><div style="font-family:monospace;font-weight:700;font-size:8pt;word-break:break-all">4711-6205-2RSH-C3</div><div style="font-size:6pt;font-weight:700">SKF</div></div>
          <div style="text-align:right;font-size:6.5pt"><div style="font-size:5pt;color:#555">MINDESTMENGE</div><b style="font-size:8pt">4</b> Stück</div>
        </div>
      </div>
    </div>
  </figure>
  <div class="hb-howto"><b><i class="ti ti-printer"></i> So druckst du Etiketten</b>
    <ol class="hb-steps">
      <li>Im Teil auf <b>Etiketten</b> (alle Lagerplätze) oder auf das Drucker-Symbol an einem Lagerplatz – oder in der Etikettenansicht oben <b>📦 Lagerort wählen</b>: Lager, Regal, Fach oder Platz anhaken (gilt mit allen Unterplätzen, die Zahl nennt die Etiketten), „nur mit Bestand“ nach Bedarf, <b>Übernehmen</b>.</li>
      <li>Oben das <b>Format</b> deines Etikettendruckers wählen, ggf. Kopien.</li>
      <li><b>Drucken</b>: im Druckdialog Skalierung 100 % und keine Ränder einstellen.</li>
      <li>Oder ohne Druckdialog: rechts oben einen eingerichteten Drucker wählen und <b>Direkt drucken</b> (<a href="#printers">Drucker einrichten</a>).</li>
    </ol></div>
  <p>Verfügbare Formate <i class="ti ti-refresh" title="automatisch aus dem System"></i>:</p>
  <ul>{{range .LabelSizes}}<li>{{.Label}}</li>{{end}}</ul>
  <p>Bei A4-Bögen kannst du mit „Start bei Feld“ bereits benutzte Etiketten überspringen.</p>
  <div class="hb-howto"><b><i class="ti ti-layout-board-split"></i> So gestaltest du deine Etiketten (Designer)</b>
    <ol class="hb-steps">
      <li>In der Etikettenansicht oben <b>✎ Designer</b> (Recht „Lager bearbeiten“ oder „Drucker verwalten“). Oben rechts die <b>Etikettengröße</b> wählen – jede Größe hat ihr eigenes Layout.</li>
      <li>Rechts unter <b>Felder</b> anhaken, was aufs Etikett soll: QR-Code, Logo, Lagerplatz, Lagerpfad, Bezeichnung, Kategorie, Teilenummer, Hersteller, Hersteller-Teilenr., Mindestmenge, EAN oder ein Freitext.</li>
      <li>Felder auf dem Etikett mit der Maus <b>verschieben</b>, an der Ecke unten rechts die <b>Größe</b> ändern. Pfeiltasten verschieben um 0,1 mm (mit Umschalt um 1 mm).</li>
      <li>Für das gewählte Feld rechts genau einstellen: Position und Größe in mm, <b>Schriftgröße</b>, fett, Festbreite, Ausrichtung, <b>maximale Zeichenzahl</b> (längere Texte enden mit „…“), maximale <b>Zeilen</b>, Präfix (z. B. „Min “) und Linie darunter.</li>
      <li><b>Speichern</b>. Ab jetzt drucken Browser, Netzwerkdrucker, Zebra und Dymo nach diesem Layout. <b>Standard</b> stellt die ursprüngliche Gestaltung wieder her.</li>
    </ol>
    Die Vorschau zeigt ein echtes Teil aus dem Lager. Zebra und Dymo drucken das Logo nicht. Hat der Drucker ein anderes Etikettenmaß eingestellt, wird das Layout maßstäblich angepasst.</div>
  <div class="hb-howto"><b><i class="ti ti-stack-push"></i> So legst du viele Fächer und Plätze auf einmal an</b>
    <ol class="hb-steps">
      <li>Oben auf <b>Sammelanlegen</b> tippen – oder am Lagerort, Regal oder Fach auf <i class="ti ti-stack-push"></i>, dann ist das Ziel schon gewählt.</li>
      <li><b>Ziel</b> wählen: den Lagerort, das Regal oder das Fach, in das die neuen Einträge kommen.</li>
      <li><b>Ebene 1</b>: Art wählen (z. B. Fächer), dazu <b>Präfix</b>, <b>von</b> und <b>bis</b>. Beispiel: Präfix „A“, von „01“, bis „12“ ergibt A01 bis A12. Buchstaben gehen auch: von „A“ bis „F“.</li>
      <li><b>Ebene 2</b> (optional): z. B. Plätze von 1 bis 10 – sie entstehen in <b>jedem</b> Eintrag der Ebene 1. Mit „Namen der Ebene 1 voranstellen“ heißen die Plätze z. B. A01-1, A01-2 …</li>
      <li>Unter den Feldern siehst du, was entsteht und wie viele es sind. <b>Anlegen</b> und bestätigen.</li>
      <li>Der Dialog bleibt offen und zeigt das Ergebnis, z. B. „Sammelanlegen: 18 angelegt“; das Ziel ist im Baum grün markiert und aufgeklappt. <b>Weitere anlegen</b> für die nächste Reihe – oder <b>Fertig</b>.</li>
    </ol>
    Was es unter dem Ziel schon gibt, wird nicht doppelt angelegt, sondern übernommen. So ergänzt du z. B. nachträglich Plätze in bestehenden Fächern: Ziel = Regal, Ebene 1 = die vorhandenen Fächer, Ebene 2 = die neuen Plätze. Höchstens 500 je Reihe und 2000 auf einmal.</div>
  <div class="hb-howto" id="hb-storage-edit"><b><i class="ti ti-edit"></i> So änderst du die Lagerstruktur</b>
    <ol class="hb-steps">
      <li>Am Lagerort, Regal, Fach oder Platz auf <i class="ti ti-edit"></i> <b>Bearbeiten</b> tippen.</li>
      <li><b>Art</b> ändern, z. B. ein Fach zum Platz oder ein Regal zum Fach. Angeboten wird nur, was zur Lage und zu den Unterknoten passt: Lagerort → Regal → Fach → Platz (Ebenen dürfen übersprungen werden).</li>
      <li><b>Liegt in</b> ändern, um den Knoten zu verschieben – alles darunter wandert mit, auch der Bestand. „ganz oben“ macht ihn zum Lagerort.</li>
      <li>Name, Standort bzw. Kapazität und Beschreibung anpassen → <b>Speichern</b>.</li>
    </ol>
    Geht etwas nicht (z. B. ein Fach mit Plätzen darunter soll selbst ein Platz werden), steht der Grund direkt unter der Zeile. Jede Änderung steht in der Historie des Knotens.</div>
  <div class="hb-howto" id="hb-storage-delete"><b><i class="ti ti-trash"></i> So löschst du einen Lagerort, ein Regal, Fach oder einen Platz</b>
    <ol class="hb-steps">
      <li>In der Zeile auf <i class="ti ti-trash"></i> tippen – oder unter <b>Bearbeiten</b> auf <b>Löschen</b> – und bestätigen.</li>
      <li>Liegt dort oder darunter noch <b>Bestand</b>, löscht PDH nichts und nennt die Teile. Zuerst umlagern oder ausbuchen.</li>
      <li>Ohne Bestand wird der Knoten mit allen Unterknoten <b>sofort gelöscht</b>. Verweisen alte Buchungen darauf, wird er stattdessen <b>ausgeblendet</b>, damit die Lagerhistorie vollständig bleibt.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> So kopierst du ein Regal oder Fach</b>
    <ol class="hb-steps">
      <li>Am Eintrag auf <i class="ti ti-copy"></i> <b>Kopieren</b> tippen.</li>
      <li><b>Ziel</b> wählen – angeboten werden nur passende Ebenen.</li>
      <li><b>Name</b> der Kopie eintragen. Für mehrere Kopien Präfix, von und bis ausfüllen, z. B. „Regal “ von 2 bis 5.</li>
      <li>„mit allen Unterknoten“ kopiert Fächer und Plätze mit. Bestand und Buchungen werden nicht kopiert.</li>
    </ol></div>
  {{template "hb-shots" (dict "Ref" (index $s "storage") "Can" $can)}}
</section>

<section class="hb-ch" id="printers" data-title="Drucker" data-pages="printers">
  <h2><i class="ti ti-printer"></i> Drucker</h2>
  <p>Unter <b>Navigation → Drucker</b> richtet ein Administrator Etiketten- und Netzwerkdrucker ein. Eingerichtete, aktive Drucker erscheinen danach in der Etiketten-Druckansicht unter <b>Direkt drucken</b> – ohne Druckdialog und ohne Skalierungsprobleme.</p>
  <ul>
    <li><b>Zebra ZT4xx</b> (ZT410/411/420/421) – im Netzwerk. PDH schickt die Etiketten als ZPL an Port 9100 und fragt den Druckerzustand ab.</li>
    <li><b>Dymo LabelWriter</b> – meist per USB am PC. Gedruckt wird über <b>DYMO Connect</b> auf dem PC, an dem du gerade sitzt.</li>
    <li><b>Netzwerkdrucker</b> – Büro- und Multifunktionsgeräte über IPP (empfohlen, mit Zustand und Tonerstand) oder RAW 9100, z. B. für Etiketten auf A4-Bögen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So richtest du einen Drucker ein</b>
    <ol class="hb-steps">
      <li><b>Navigation → Drucker</b>, beim passenden Typ auf <b>… hinzufügen</b>.</li>
      <li>Name und Standort eintragen. Zebra und Netzwerkdrucker: IP-Adresse (am besten fest vergeben). Zebra zusätzlich Etikettengröße, Auflösung (Typenschild, z. B. 203 dpi) und Material. Dymo: den Druckernamen genau wie in DYMO Connect und den Etikettentyp.</li>
      <li><b>Speichern</b>, dann <b>Prüfen</b>. Die Prüfung zeigt, ob der Drucker erreichbar ist, seinen Zustand (z. B. Papier oder Farbband leer, Kopf offen) und beim Netzwerkdrucker den Tonerstand.</li>
      <li><b>Testdruck</b> – passt das Etikett, ist der Drucker fertig.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-tag"></i> Dymo: an welchem PC?</b>Dymo-Drucker hängen am PC, nicht im Netz. „Prüfen“ und „Testdruck“ laufen deshalb an dem PC, an dem du die Seite geöffnet hast – dort muss DYMO Connect installiert sein und laufen. „Prüfen“ listet die angeschlossenen Dymo-Drucker mit ihrem genauen Namen.</div>
  <div class="hb-howto"><b><i class="ti ti-adjustments"></i> Druckbild stimmt nicht?</b>Zebra: blasser Druck → <b>Schwärzung</b> erhöhen; verschmiert → Schwärzung senken oder <b>Geschwindigkeit</b> verringern. Beides setzt PDH bei jedem Druck neu. Der Stern <i class="ti ti-star"></i> macht einen Drucker zum Standard seines Typs; ein Standard-Etikettendrucker (Zebra oder Dymo) ist in der Druckansicht vorausgewählt.</div>
  <p>Rechte: Einrichten und prüfen dürfen Personen mit <code>printers.manage</code> (Administratoren). Direkt drucken dürfen alle mit <code>printers.use</code> – das haben alle Rollen.</p>
  {{template "hb-shots" (dict "Ref" (index $s "printers") "Can" $can)}}
</section>

<section class="hb-ch" id="purchasing" data-title="Beschaffung, Kanban &amp; Einkauf" data-pages="procurement">
  <h2><i class="ti ti-shopping-cart"></i> Beschaffung, Kanban &amp; Einkauf</h2>
  {{template "hb-fig-purchase"}}
  <p>Unter <b>Material &amp; Anlagen → Beschaffung &amp; Einkauf</b> (auch über Core-Einstellungen) findest du die <b>Kanban-Tafel</b>, den <b>Bestellvorschlag</b>, die offenen <b>Bestellungen</b> und die <b>Rahmenverträge</b>.</p>
  <h3><i class="ti ti-layout-kanban"></i> Kanban</h3>
  <p>Mit Kanban wird ein Teil über eine feste Zahl <b>Karten</b> mit fester Menge nachbestellt – z. B. 2 Karten à 50 Stück (Zwei-Behälter-Prinzip). Jede Karte ist <span class="badge b-green">voll</span>, <span class="badge b-red">leer – zu bestellen</span> oder <span class="badge b-amber">bestellt</span>.</p>
  <div class="hb-howto"><b><i class="ti ti-toggle-right"></i> So aktivierst du Kanban für ein Teil</b>
    <ol class="hb-steps">
      <li>Ersatzteil öffnen → Reiter <b>Kanban</b>.</li>
      <li><b>Anzahl Karten</b>, <b>Menge je Karte</b>, Lieferzeit und den <b>Kanban-Lagerplatz</b> (dort wird geliefert) eintragen. Lieferant und <b>Rahmenvertrag</b> wählen, falls vorhanden.</li>
      <li><b>Kanban aktivieren</b>. PDH legt die Karten an – so viele voll, wie der Bestand hergibt.</li>
      <li><b>Karten drucken</b> und je eine an jeden Behälter hängen.</li>
    </ol>
    Mit „automatisch leer melden“ meldet PDH volle Karten selbst leer, sobald der Bestand nicht mehr für sie reicht. Ohne diesen Haken scannt man die Karte am leeren Behälter und tippt <b>Karte leer melden</b>. <b>Abschalten</b> stoppt den Kreislauf, Karten und Einstellungen bleiben.</div>
  <div class="hb-howto"><b><i class="ti ti-shopping-cart-check"></i> So bestellst du</b>
    <ol class="hb-steps">
      <li>Reiter <b>Bestellvorschlag</b>: Leere Karten stehen dort nach Lieferant – mit Menge, Vertragspreis und Wert. Mit <b>E-Mail</b> öffnet sich eine fertige Bestellung an den Lieferanten.</li>
      <li>Positionen auswählen, <b>Bestellnummer</b> und ggf. Liefertermin eintragen – <b>Als bestellt melden</b>. Ohne Termin rechnet PDH mit der Lieferzeit.</li>
      <li>Kommt die Ware: im Reiter <b>Bestellungen</b> auf <b>Geliefert</b>, die Kanban-Karte scannen oder die Ware ganz normal einbuchen. Die Karte ist wieder voll, die Menge am Kanban-Lagerplatz gebucht.</li>
    </ol>
    Überfällige Bestellungen sind rot markiert. Teile ohne Kanban stehen weiter unter „Unter Mindestbestand“ und im täglichen Bestellvorschlag per E-Mail – Kanban-Teile nicht, die bestellt der Kreislauf.</div>
  <h3><i class="ti ti-file-certificate"></i> Rahmenverträge</h3>
  <p>Reiter <b>Rahmenverträge</b> → <b>Neuer Rahmenvertrag</b>: Vertragsnummer, Lieferant, Laufzeit und ggf. Vertragsvolumen. Danach die <b>Positionen</b> mit Teilenummer, Vertragspreis und Rahmenmenge. Ein Kanban-Regelkreis mit Vertrag bestellt zum Vertragspreis und zählt die abgerufene Menge hoch. Der Status zeigt <b>läuft bald ab</b> (unter 31 Tagen), <b>abgelaufen</b> und <b>(fast) ausgeschöpft</b>.</p>
  <h3><i class="ti ti-mail"></i> Täglicher Bestellvorschlag</h3>
  <p>Sinkt der Bestand eines Teils ohne Kanban auf oder unter den Mindestbestand, erscheint es im <b>Bestellvorschlag</b> (Ersatzteile → Bestellvorschlag) – sortiert nach Einkäufer und Lieferant, mit Menge und Wert. Jeder Einkäufer bekommt ihn zusätzlich jeden Morgen per E-Mail.</p>
  <ul>
    <li>Den <b>Einkäufer</b> legst du im Teil fest (Reiter Lieferanten &amp; Einkauf).</li>
    <li>Die Menge ist die Nachbestellmenge, aufgerundet auf die Mindestabnahme des Lieferanten.</li>
    <li>Gesperrte Lieferanten werden übersprungen.</li>
  </ul>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Beschaffung“): <b>ansehen</b>, <b>Kanban-Regelkreise einrichten</b>, <b>bestellen</b> und <b>Rahmenverträge pflegen</b> lassen sich je Rolle getrennt vergeben.</p>
  {{template "hb-shots" (dict "Ref" (index $s "purchasing") "Can" $can)}}
</section>

<section class="hb-ch" id="partners" data-title="Hersteller &amp; Lieferanten" data-pages="directory">
  <h2><i class="ti ti-building-factory-2"></i> Hersteller &amp; Lieferanten</h2>
  <p>Hier stehen alle Firmen, mit denen ihr arbeitet – mit Ansprechpartnern, Telefonnummern und Verträgen.</p>
  <ul>
    <li><b>Übersicht</b> – alle Nummern auf einen Blick: Zentrale, <b>Support-Hotline</b> (mit Zeiten), Service, <b>Ersatzteile</b>, Notfall.</li>
    <li><b>Portale &amp; Shop</b> – Links zu Kundenportalen und Onlineshops. Mit „Einbetten“ öffnen sie sich im PDH. Hinterlegte Zugangsdaten sieht nur, wer die Berechtigung hat.</li>
    <li><b>Anlagen, Ersatzteile, IT</b> – wofür die Firma Hersteller, Lieferant oder Servicepartner ist.</li>
    <li><b>Vorgänge</b> – wo die Firma als externe Firma beteiligt ist.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-phone"></i> Schnell die richtige Nummer finden</b>
    Firma öffnen → <b>Übersicht</b> → Karte „Erreichbarkeit“. Für Ersatzteile gibt es eine eigene Telefonnummer und E-Mail.</div>
  {{template "hb-shots" (dict "Ref" (index $s "partners") "Can" $can)}}
</section>

<section class="hb-ch" id="chat" data-title="Chat &amp; Teams" data-pages="chat">
  <h2><i class="ti ti-messages"></i> Chat &amp; Teams</h2>
  {{template "hb-fig-chat"}}
  <p>Chatten kannst du auf jeder Seite über den <b>Chat-Reiter</b> rechts. Kommt eine neue Nachricht, öffnet sich die Leiste von selbst – außer du tippst gerade etwas oder hast den Chat stummgeschaltet.</p>
  <ul>
    <li><b>Chats</b> – mit einer Person oder einer Gruppe. <b>Teams</b> haben Kanäle mit Beiträgen und Antworten.</li>
    <li><b>@Name</b> erwähnt jemanden, <kbd>Enter</kbd> sendet, <kbd>Shift</kbd>+<kbd>Enter</kbd> macht eine neue Zeile, <kbd>↑</kbd> bearbeitet deine letzte Nachricht.</li>
    <li>Dateien und Fotos per Büroklammer oder einfach ins Fenster ziehen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-share"></i> Eine Seite mit Kollegen teilen</b>
    <ol class="hb-steps">
      <li>Auf der Seite (z. B. einer Störung) oben <b>Im Chat teilen</b> klicken.</li>
      <li>Rechts die Unterhaltung wählen – Titel und Link sind schon eingetragen.</li>
      <li>Absenden. Die anderen sehen eine Karte, die den Datensatz öffnet.</li>
    </ol></div>
  <h3><i class="ti ti-bell"></i> Hinweise von „Service“</h3>
  <p><b>Beim Anlegen</b> eines Tickets, einer Störung, einer Aufgabe, eines Projekts, einer Wartung oder eines KVP-Vorschlags bestätigt „Service“ dir das im Chat. Die Nachricht nennt, wer zuständig ist oder an welche Broker der Vorgang ging. Wer als Zuständige/r, Verantwortliche/r oder über eine Gruppe eingetragen wurde, bekommt „Neu für dich“. Aus Wartungsplänen automatisch erzeugte Aufträge melden sich nicht.</p>
  <p>Ändert jemand ein <b>Ticket</b>, eine <b>Störung</b>, eine <b>Aufgabe</b>, ein <b>Projekt</b> oder eine <b>Wartung</b>, schickt der Absender <b>Service</b> (mit dem PDH-Logo) einen kurzen Hinweis an alle Beteiligten: Ersteller/in, Verantwortliche/n und Zugewiesene. Wer die Änderung selbst gemacht hat, bekommt keinen Hinweis. Der Hinweis nennt, was sich geändert hat (z. B. „Status: offen → in Arbeit“, neuer Kommentar) und enthält eine Karte zum Vorgang. Mehrere Änderungen kurz hintereinander werden zu einer Nachricht zusammengefasst.</p>
  <p>Die Hinweise sind nur zur Information – auf „Service“ zu antworten ist nicht nötig. Abschalten kannst du sie unter <b>Mein Konto → Konto &amp; Dienste</b>. „Service“ informiert Administratoren außerdem über <a href="#cleanup">Bereinigungsläufe</a> und <a href="#backup">Datensicherungen</a>.</p>
  {{template "hb-shots" (dict "Ref" (index $s "chat") "Can" $can)}}
</section>

<section class="hb-ch" id="time" data-title="Zeiterfassung" data-pages="time">
  <h2><i class="ti ti-clock"></i> Zeiterfassung</h2>
  <p>In Störungen, Tickets und Aufgaben startest und stoppst du deine Zeit mit <b>Zeit erfassen</b>; bei Wartungen fragt der Assistent die Zeit ab. Vergessene Zeiten trägst du in der Zeiterfassung nach. Schichten, Urlaub und Wartungstermine plant der <a href="#planner">Planer</a>.</p>
  <div class="hb-howto"><b><i class="ti ti-clock-exclamation" style="color:var(--amber)"></i> So bestätigst du Zeiten, die Kollegen für dich eingetragen haben</b>
    <ol class="hb-steps">
      <li>Hat dich jemand beim Abschluss eines Vorgangs als „dabei“ eingetragen, bekommst du einen Chat-Hinweis von „Service“.</li>
      <li>In der <b>Zeiterfassung</b> steht oben die gelbe Karte <b>Zu bestätigen</b>; in der Liste ist der Eintrag gelb hinterlegt.</li>
      <li>Stimmt die Zeit: grüner Haken <b>Bestätigen</b>. Passt sie nicht: <i class="ti ti-edit"></i> korrigieren und dann bestätigen. Warst du nicht dabei: <i class="ti ti-trash"></i> löschen.</li>
    </ol>
    Unbestätigte Zeiten zählen noch nicht – weder in den Wochen- und Monatssummen noch im Export.</div>
  <p><i class="ti ti-tool"></i> <b>Tätigkeit</b>: Beim Starten, beim manuellen Erfassen und beim Bearbeiten wählst du optional eine Tätigkeit (z. B. Rüsten, Reinigung). Die Zeit zählt dann auf die Kostenstelle der Tätigkeit; in der Liste steht die Tätigkeit unter der Beschreibung. Die Tätigkeiten pflegt die Verwaltung unter <a href="#costcenters">Kostenstellen</a>.</p>
  {{template "hb-shots" (dict "Ref" (index $s "time") "Can" $can)}}
</section>

<section class="hb-ch" id="planner" data-title="Planer: Schichten, Urlaub &amp; Wartung" data-pages="planner">
  <h2><i class="ti ti-calendar-time"></i> Planer: Schichten, Urlaub &amp; Wartung</h2>
  <p>Unter <b>Instandhaltung → Planer</b> planst du Schichten, Urlaub und Wartungstermine an einer Stelle. Feiertage (Bundesland in den Einstellungen) und Betriebsruhe sind überall markiert.</p>
  <h3><i class="ti ti-calendar-week"></i> Schichtplan</h3>
  <p>Eine Woche: oben die Tage, links die Schichten des Schichtmodells. Das Modell wählst du rechts. In jedem Feld stehen die eingeteilten Mitarbeiter. Ein rot umrandetes Feld hat weniger Leute als die Mindestbesetzung.</p>
  <div class="hb-howto"><b><i class="ti ti-hand-click"></i> So teilst du Mitarbeiter ein</b>
    <ol class="hb-steps">
      <li>Woche mit den Pfeilen wählen, rechts das <b>Schichtmodell</b>.</li>
      <li>Auf das Feld klicken (Schicht × Tag). Die Liste zeigt alle Mitarbeiter: wer Urlaub hat (rot) und wer schon in einer anderen Schicht steht (gelb).</li>
      <li>Haken setzen oder entfernen – <b>Übernehmen</b>. Wer schon in einer anderen Schicht steht, wechselt in diese.</li>
    </ol>
    <b>Vorwoche übernehmen</b> kopiert die Einteilung der Vorwoche – vorhandene Einträge und Urlaubstage bleiben. Mit Abteilung und Gruppe oben filterst du die Anzeige.</div>
  <h3><i class="ti ti-beach"></i> Urlaub &amp; Abwesenheit</h3>
  <div class="hb-howto"><b><i class="ti ti-send"></i> So beantragst du Urlaub</b>
    <ol class="hb-steps">
      <li>Reiter <b>Urlaub &amp; Abwesenheit</b> → Art, von, bis, ggf. halber erster oder letzter Tag und Vertretung.</li>
      <li><b>Absenden</b>. Deine Führungskraft (sonst alle mit Genehmigungsrecht) bekommt eine Nachricht.</li>
      <li>Du wirst über die Entscheidung benachrichtigt. Oben siehst du Anspruch, genommen, beantragt und Rest.</li>
    </ol>
    Gezählt werden Arbeitstage Mo–Fr ohne Feiertage und Betriebsruhe. Krankmeldungen gelten sofort. Beantragte Einträge kannst du selbst stornieren.</div>
  <p>Wer genehmigt, sieht <b>Offene Anträge</b> mit Hinweisen: eingeteilte Schichten im Zeitraum und Kollegen der Abteilung, die gleichzeitig fehlen. Beim Genehmigen können die Schichten im Zeitraum gleich entfernt werden. Darunter: Teamkalender je Monat und die <b>Urlaubsansprüche</b> je Person (Anspruch und Übertrag). Ohne das Recht „Abwesenheitsgrund aller sehen“ zeigt PDH bei Kollegen nur „abwesend“.</p>
  <h3><i class="ti ti-tool"></i> Wartungsplanung</h3>
  <p>Monatskalender mit offenen Wartungen und Prüfpflichten. Je Tag steht, wie viele Leute im Dienst sind (<i class="ti ti-users"></i>) und wie viele Stunden Wartung geplant sind. <span style="color:var(--red)">Rot</span>: Die zugewiesene Person ist abwesend. <span style="color:var(--amber)">Gelb</span>: Sie hat an dem Tag keine Schicht oder niemand ist zugewiesen. Ein Klick öffnet den Dialog zum <b>Verschieben</b> und <b>Zuweisen</b> – oben in der Auswahl stehen die Leute, die an dem Tag Dienst haben.</p>
  <h3><i class="ti ti-template"></i> Schichtmodelle &amp; Vorlagen</h3>
  <div class="hb-howto"><b><i class="ti ti-wand"></i> So legst du ein Schichtmodell aus einer Vorlage an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Schichtmodelle &amp; Vorlagen</b> → Vorlage wählen, z. B. <b>3-Schicht</b>, <b>4-Schicht Kontischicht</b> oder <b>12-Stunden Tag/Nacht</b> – <b>Übernehmen</b>.</li>
      <li>PDH legt die Schichten (Zeiten, Farben) und das Rotationsmuster mit Mannschaften an. Zeiten, Mindestbesetzung und Pausen kannst du danach ändern.</li>
      <li>Unter <b>Plan erzeugen</b> Zeitraum wählen, Mitarbeiter anhaken und jeder eine <b>Mannschaft</b> (M1, M2 …) geben – <b>Plan erzeugen</b>.</li>
      <li>Der Plan ist zuerst ein <b>Entwurf</b> (gestrichelt, nur für Planende sichtbar). Passt er, unten <b>Veröffentlichen</b>.</li>
    </ol>
    Ein Rotationsmuster legt für jeden Tag des Zyklus die Schicht fest. Mannschaft 2 läuft um den Versatz verschoben, Mannschaft 3 um den doppelten. Vorhandene Einteilungen und genehmigter Urlaub werden beim Erzeugen nie überschrieben.</div>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Schichtplanung“): <b>Planer ansehen</b>, <b>Schichten planen</b>, <b>eigene Abwesenheit beantragen</b>, <b>Abwesenheiten genehmigen</b>, <b>Abwesenheitsgrund aller sehen</b>. Verschieben und Zuweisen von Wartungen braucht „Wartung bearbeiten“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "planner") "Can" $can)}}
</section>

<section class="hb-ch" id="calendar" data-title="Kalender" data-pages="calendar">
  <h2><i class="ti ti-calendar-event"></i> Kalender</h2>
  <p>Unter <b>Instandhaltung → Kalender</b> siehst du auf einen Blick, wer wann was hat: je Mitarbeiter eine Zeile, je Tag eine Spalte – Urlaub und Abwesenheit, Schichten, fällige Wartungen, Prüfpflichten, Tickets, Störungen, Aufgaben und laufende Projekte (als Balken). Vorgänge stehen bei der zugewiesenen Person (Aufgaben bei allen Zuständigen), sonst bei der verantwortlichen; ohne beides unten in <b>Ohne Person</b>. Vorgänge stehen am Tag ihrer Fälligkeit, ohne Fälligkeit am Tag ihrer Anlage. Überfällige (mit ⚠) und ältere ohne Fälligkeit stehen in der Spalte <b>heute</b>, solange sie offen sind.</p>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So stellst du den Kalender ein</b>
    <ol class="hb-steps">
      <li>Zeitraum: Standard sind <b>14 Tage ab heute</b>. Mit den Pfeilen blätterst du, oben wählst du Start und Länge (7 bis 42 Tage).</li>
      <li>Was angezeigt wird: die runden Schalter (Urlaub, Schichten, Wartungen …) an- oder abwählen. Die Zahl daneben zeigt, wie viele Einträge es gibt.</li>
      <li>Wen: Abteilung, Gruppe oder eine Person wählen. „nur Personen mit Einträgen“ blendet leere Zeilen aus.</li>
    </ol>
    PDH merkt sich deine Auswahl. <i class="ti ti-restore"></i> setzt sie zurück. Ein Klick auf einen Eintrag öffnet ihn.</div>
  <p><span style="box-shadow:inset 0 0 0 2px var(--red);padding:0 6px;border-radius:3px">Rot umrandet</span> sind <b>Überschneidungen</b>: Die Person ist abwesend (genehmigt oder beantragt), hat am selben Tag aber eine Schicht oder einen fälligen Auftrag. <span style="box-shadow:inset 0 0 0 2px var(--amber);padding:0 6px;border-radius:3px">Gelb</span>: ein fälliger Auftrag an einem Tag, an dem die Person keine Schicht hat. Den Grund zeigt der Hinweis beim Darüberfahren. Ohne das Recht „Abwesenheitsgrund aller sehen“ steht bei Kollegen nur „abwesend“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "calendar") "Can" $can)}}
</section>

<section class="hb-ch" id="ms" data-title="Managementsysteme" data-pages="ms ms-doc ms-handbook ms-process ms-instruction ms-form">
  <h2><i class="ti ti-certificate-2"></i> Managementsysteme</h2>
  <p>Unter <b>Managementsysteme</b> in der Navigation stehen eure gelenkten Dokumente: <b>Handbücher</b>, <b>Prozessbeschreibungen</b>, <b>Verfahrens-</b> und <b>Arbeitsanweisungen</b>, <b>Formblätter &amp; Vorlagen</b> sowie <b>Leitlinien</b> – je Managementsystem (Qualität ISO 9001, Umwelt 14001, Arbeitsschutz 45001, Energie 50001, Informationssicherheit 27001, integriertes System). Gültig ist immer die <b>freigegebene Fassung</b>. Ältere Fassungen bleiben mit Änderungsgrund und Freigabe erhalten.</p>
  <div class="hb-howto"><b><i class="ti ti-file-plus"></i> So legst du ein Dokument an und gibst es frei</b>
    <ol class="hb-steps">
      <li><b>Neues Dokument</b> → Art, Managementsystem und Titel. Die Nummer vergibt PDH (z. B. <b>QM-PB-004</b>), das Dokument startet als <b>Entwurf</b> mit passender Gliederung (z. B. Zweck, Geltungsbereich, Verantwortlichkeiten, Ablauf).</li>
      <li>Reiter <b>Bearbeiten &amp; Freigabe</b>: Inhalt schreiben – rechts steht die Vorschau. <code>## Überschrift</code>, <code>- Liste</code>, <code>1. Schritt</code>, <code>**fett**</code>, Tabellen mit <code>| Spalte | Spalte |</code>. Normbezug und <b>Änderungsgrund</b> eintragen, <b>Speichern</b>.</li>
      <li><b>Zur Prüfung geben</b> – alle mit Freigaberecht bekommen eine Nachricht.</li>
      <li>Die prüfende Person liest und <b>gibt frei</b> oder schickt es mit Anmerkung <b>zur Überarbeitung zurück</b>. Die eigene Fassung kann niemand selbst freigeben (Vier-Augen-Prinzip).</li>
    </ol>
    Ändern heißt immer: <b>Neue Fassung beginnen</b>. Sie startet mit dem gültigen Inhalt; bis zur Freigabe bleibt die alte Fassung gültig. Vorlagen, Original-Dateien oder Prozessgrafiken hängst du unter <b>Dateien</b> an.</div>
  <div class="hb-howto"><b><i class="ti ti-eye-check"></i> Kenntnisnahme und Überprüfung</b>
    Unter <b>Stammdaten</b> legst du fest, wer die Fassung lesen muss (<b>alle</b> oder eine <b>Abteilung</b>) und alle wie viele Monate das Dokument überprüft wird. Nach jeder Freigabe bekommen die Betroffenen eine Nachricht; oben im Dokument steht <b>Gelesen und verstanden</b>. Der Reiter <b>Kenntnisnahme</b> zeigt, wer schon bestätigt hat. Ist die Überprüfung fällig, ist das Dokument in der Liste rot markiert – prüfen und eine neue Fassung freigeben lassen (auch ohne inhaltliche Änderung, Grund „Überprüft“). <b>Mitgeltende Dokumente</b> verknüpfst du ebenfalls in den Stammdaten.</div>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Managementsysteme“): <b>lesen</b> (alle), <b>anlegen und bearbeiten</b>, <b>prüfen, freigeben und zurückziehen</b>, <b>Systeme verwalten</b> (Knopf <b>Systeme</b>: eigene Systeme wie Lebensmittelsicherheit ergänzen). Wer nur lesen darf, sieht ausschließlich freigegebene Dokumente.</p>
  {{template "hb-shots" (dict "Ref" (index $s "ms") "Can" $can)}}
</section>

<section class="hb-ch" id="costcenters" data-title="Kostenstellen &amp; Tätigkeiten" data-pages="costcenters">
  <h2><i class="ti ti-building-bank"></i> Kostenstellen &amp; Tätigkeiten</h2>
  <p>Unter <b>Navigation → Kostenstellen</b> (oder Core-Einstellungen → Kostenstellen &amp; Tätigkeiten) pflegst du Kostenstellen, ihre Unterstellen und die Tätigkeiten für die Zeiterfassung. Dafür brauchst du das Recht <i>Kostenstellen, Unterstellen &amp; Tätigkeiten verwalten</i>.</p>
  <p>Das <b>Dashboard</b> zeigt für das gewählte Jahr: Anzahl der Kostenstellen und Tätigkeiten, die gebuchten Stunden, die Stunden je Kostenstelle und je Tätigkeit sowie offene Tickets und Störungen je Kostenstelle. Unterstellen zählen bei ihrer Hauptkostenstelle mit.</p>
  <div class="hb-howto"><b><i class="ti ti-building-bank"></i> So legst du eine Unterstelle an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Kostenstellen</b> → <b>Kostenstelle oder Unterstelle anlegen</b>.</li>
      <li>Nummer und Name eintragen, z. B. „4110“ und „Elektrowerkstatt“.</li>
      <li>Bei <b>Gehört zu</b> die Hauptkostenstelle wählen, z. B. „4100 Instandhaltung“. Leer lassen = Hauptkostenstelle.</li>
      <li>Optional Verantwortliche/n und Beschreibung, dann <b>Anlegen</b>.</li>
    </ol>
    Eine Unterstelle gehört immer direkt zu einer Hauptkostenstelle. Wer eine Hauptkostenstelle deaktiviert, deaktiviert ihre Unterstellen mit.</div>
  <div class="hb-howto"><b><i class="ti ti-tool"></i> So legst du Tätigkeiten an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Tätigkeiten</b> → <b>Tätigkeit anlegen</b>.</li>
      <li>Name eintragen (z. B. „Rüsten“), optional eine Nummer.</li>
      <li><b>Kostenstelle</b>: leer = die Tätigkeit gilt für alle. Mit Kostenstelle wird jede Zeit mit dieser Tätigkeit dort gebucht.</li>
      <li>Mit <i class="ti ti-chevron-up"></i>/<i class="ti ti-chevron-down"></i> die Reihenfolge in der Zeiterfassung festlegen; <i class="ti ti-eye-off"></i> blendet eine Tätigkeit aus, ohne gebuchte Zeiten zu verlieren.</li>
    </ol></div>
  <p>Auf welche Kostenstelle eine Zeit zählt: zuerst die der Tätigkeit, sonst die der gebuchten Anlage.</p>
  {{template "hb-shots" (dict "Ref" (index $s "costcenters") "Can" $can)}}
</section>

<section class="hb-ch" id="users" data-title="Benutzer &amp; Mein Konto" data-pages="users account orgchart org_units">
  <h2><i class="ti ti-users"></i> Benutzer &amp; Mein Konto</h2>
  <div class="hb-howto"><b><i class="ti ti-user-circle"></i> So stellst du dein Profilbild ein</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> (oder im eigenen Benutzerstamm auf das runde Bild oben links).</li>
      <li>Auf das runde Bild tippen <i class="ti ti-camera"></i> und ein Foto wählen – am Handy geht auch direkt die Kamera. JPG, PNG oder GIF, höchstens 8 MB.</li>
      <li>Fertig: Das Bild wird quadratisch zugeschnitten und erscheint im Chat, in der Kopfleiste, in der Benutzerliste, im Organigramm und bei „Aktivität“. <b>×</b> am Bild entfernt es wieder; dann stehen wieder die Initialen da.</li>
    </ol>
    Mit dem Recht <i>Benutzer verwalten</i> kannst du im Benutzerstamm auch das Bild anderer Personen setzen oder entfernen. Beim Speichern entfernt PDH Zusatzdaten aus dem Foto (z. B. den Aufnahmeort).</div>
  <p><i class="ti ti-bell-ringing"></i> Unter <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> schaltest du auch <a href="#push">Push-Alarme aufs Handy</a> ein.</p>
  <div class="hb-howto"><b><i class="ti ti-user-cog"></i> Eigene Daten pflegen</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b>.</li>
      <li>Reiter <b>Privat</b>: Anschrift, private Telefonnummer, Notfallkontakt – das sehen nur du und berechtigte Personen.</li>
      <li>Reiter <b>Nachweise</b>: Führerschein, Qualifikationen und Lehrgänge mit Ablaufdatum – das PDH warnt 60 Tage vorher.</li>
      <li>Reiter <b>Konto &amp; Dienste</b>: Chat-Hinweise zu Änderungen an deinen Vorgängen ein- oder ausschalten, Passwort und verbundene Dienste.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-key"></i> So änderst du dein Passwort</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b>.</li>
      <li>In der Karte <b>Passwort ändern</b> das aktuelle Passwort und zweimal das neue eingeben. Unter dem Feld steht, was das Passwort braucht (Richtlinie, siehe unten).</li>
      <li><b>Passwort speichern</b>. Ab der nächsten Anmeldung gilt das neue Passwort.</li>
    </ol>
    Meldest du dich bisher nur per Karte oder Microsoft an, heißt die Karte <b>Passwort festlegen</b> – dann ist kein aktuelles Passwort nötig.</div>
  <div class="hb-howto"><b><i class="ti ti-password"></i> Passwort ändern müssen</b>In diesen Fällen fragt PDH bei der Anmeldung mit Passwort zuerst nach einem neuen Passwort:
    <ul>
      <li><b>Erstanmeldung</b> – ein Administrator hat dein Konto mit einem Passwort angelegt.</li>
      <li>Ein Administrator hat dein Passwort im <b>Benutzerstamm</b> geändert oder den Wechsel verlangt.</li>
      <li>Dein Passwort ist <b>abgelaufen</b> (Höchstalter der Richtlinie).</li>
    </ul>
    <ol class="hb-steps">
      <li>Wie gewohnt mit Benutzername und Passwort anmelden.</li>
      <li>Es erscheint <b>Passwort ändern</b>. Zweimal das neue Passwort eingeben – es muss sich vom bisherigen unterscheiden und die angezeigten Regeln erfüllen.</li>
      <li><b>Passwort speichern</b> – du bist angemeldet und landest dort, wo du hinwolltest.</li>
    </ol>
    Bis dahin gibt es keine Anmeldung, auch nicht über die Schnittstelle oder die Override-Anmeldung am Terminal. Für die Seite hast du 15 Minuten, sonst einfach neu anmelden. Karte, Microsoft und Nextcloud funktionieren weiter; Systembenutzer (Terminals) sind ausgenommen.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud-plus"></i> Für Administratoren: Nextcloud-Konto anlegen</b>
    <ol class="hb-steps">
      <li>Im <b>Benutzerstamm</b> die Person öffnen, Reiter <b>Stammdaten</b>.</li>
      <li>Beim Feld <b>Nextcloud-Benutzer</b> auf <b>Nextcloud-Konto anlegen</b> tippen und bestätigen.</li>
      <li>PDH legt in Nextcloud ein Konto mit dem Benutzernamen, Namen und der E-Mail der Person an und trägt es ins Feld ein. Das <b>Startpasswort</b> steht einmalig daneben – an die Person weitergeben, sie ändert es in Nextcloud.</li>
    </ol>
    Den Knopf gibt es nur, wenn unter <a href="#server">Server-Einstellungen → Nextcloud</a> Adresse und Zugang eingetragen sind und die Person noch kein Nextcloud-Konto hat. Der dort eingetragene Nextcloud-Benutzer braucht Admin-Rechte in Nextcloud. Gibt es das Konto in Nextcloud schon, wird es nur verknüpft.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> Für Administratoren: Nextcloud mit Microsoft 365</b>
    <ol class="hb-steps">
      <li><b>Einmalig in Nextcloud:</b> <b>Core-Einstellungen → Microsoft 365</b> → Karte <b>Nextcloud</b> → <b>In Nextcloud einrichten</b>. PDH nimmt Tenant, Client-ID und Secret aus den Server-Einstellungen. Danach zeigt die Nextcloud-Anmeldung den Knopf <b>Mit Microsoft anmelden</b>. Das braucht den Update-Agenten und Nextcloud auf demselben Server; sonst auf dem Nextcloud-Server <code>sudo bash scripts/configure-nextcloud-microsoft-login.sh</code> ausführen.</li>
      <li><b>Einmalig in Entra:</b> In der App-Registrierung die Redirect-URI eintragen, die die Karte anzeigt (<code>…/apps/user_oidc/code</code>). Unter <b>Tokenkonfiguration</b> den optionalen Anspruch <b>email</b> fürs ID-Token hinzufügen.</li>
      <li><b>Core-Einstellungen → Microsoft 365</b> → Karte <b>Nextcloud</b>: <b>Nextcloud-Konten anlegen</b> anhaken.</li>
      <li><b>Jetzt abgleichen</b>. Jede zugeordnete Person ohne Nextcloud-Konto bekommt eines. Die Meldung oben zeigt, wie viele.</li>
    </ol>
    Die Nextcloud-Benutzer-ID ist dann die Microsoft-E-Mail. So findet die Microsoft-Anmeldung das Konto, und es braucht kein Startpasswort. Auch der Knopf <b>Nextcloud-Konto anlegen</b> im Benutzerstamm nimmt dann die Microsoft-E-Mail. Vorhandene Nextcloud-Konten bleiben, wie sie sind. In Microsoft deaktivierte Personen und Gastkonten bekommen kein Konto. Wer in Nextcloud noch kein Konto hat, kann sich dort auch mit Microsoft nicht anmelden. So entscheidet PDH, wer Nextcloud bekommt.</div>
  <div class="hb-howto"><b><i class="ti ti-user-cog"></i> Für Administratoren: Passwort im Benutzerstamm setzen</b>
    <ol class="hb-steps">
      <li>Benutzer öffnen (oder neu anlegen) und unter <b>Neues Passwort</b> ein vorläufiges Passwort eintragen – es muss die Richtlinie erfüllen.</li>
      <li>Speichern und das Passwort der Person mitteilen. Sie muss es bei der nächsten Anmeldung ändern (abschaltbar in der Richtlinie).</li>
      <li>Ohne neues Passwort geht es mit <b>Passwortwechsel verlangen</b>; <b>Erlassen</b> nimmt den Wechselzwang wieder weg. Den Stand zeigt das Schild „Wechsel bei nächster Anmeldung“ bzw. „Passwort abgelaufen“.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-lock-question"></i> Passwort vergessen?</b>
    <ol class="hb-steps">
      <li>Auf der Anmeldeseite unter dem Anmelden-Knopf auf <b>Passwort vergessen?</b>.</li>
      <li>E-Mail-Adresse oder Benutzernamen eingeben und <b>Link anfordern</b>.</li>
      <li>In der E-Mail auf <b>Neues Passwort vergeben</b> klicken, das neue Passwort zweimal eingeben und speichern. Danach wie gewohnt anmelden.</li>
    </ol>
    Der Link gilt eine Stunde und nur einmal. Keine E-Mail bekommen? Spam-Ordner prüfen. Im Konto muss eine E-Mail-Adresse stehen – sonst vergibt ein Administrator im Benutzerstamm ein neues Passwort. Systembenutzer (Terminals) können ihr Passwort nicht selbst zurücksetzen.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> So verbindest du Microsoft 365 (geschäftlich und privat)</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b>. Dort gibt es zwei Karten: <b>Microsoft 365 · Geschäftlich</b> und <b>Microsoft 365 · Privat</b>.</li>
      <li><b>Geschäftskonto verbinden</b> für dein Firmen-/Schulkonto, <b>Privates Konto verbinden</b> für Outlook.com, Hotmail, Live oder Microsoft 365 Single/Family. Du kannst beide gleichzeitig verbinden.</li>
      <li>Bei Microsoft anmelden und die Freigabe bestätigen – danach kommst du automatisch zurück ins PDH.</li>
      <li>Je Konto unter <b>Outlook-Kalender</b> anhaken, was in diesen Kalender geschrieben wird (Schichten, Aufgaben, Wartungen, Tickets &amp; Störungen), und ob Termine als <b>Busy-Blocker</b> ins PDH geholt werden. <b>Kalenderauswahl speichern</b>, dann <b>Jetzt synchronisieren</b>.</li>
    </ol></div>
  <p>Busy-Blocker aus beiden Konten erscheinen im Schichtwochenplan als <b>O</b> („Outlook belegt“). Betreffzeilen werden nie übernommen, und eine Zuweisung bleibt trotzdem möglich. <b>Teams</b> gibt es nur über das Geschäftskonto. <b>Konto trennen</b> löscht die importierten Blocker dieses Kontos; bereits in Outlook eingetragene Termine bleiben dort stehen.</p>
  <p>In der <b>Benutzerliste</b> öffnet <i class="ti ti-dots"></i> direkt die Bearbeitung. Der Benutzerstamm hat die Reiter Übersicht, Stammdaten, Privat, Nachweise, Einzelrechte, Zuständigkeiten, Feldsätze und Historie. <b>Einzelrechte</b> erlauben oder verbieten einzelne Funktionen abweichend von der Rolle; „Admin machen“ sehen nur Administratoren. <b>Zuständigkeiten</b> listet alle offenen Vorgänge, in denen die Person zugewiesen oder verantwortlich ist – auch über eine zugewiesene Gruppe (Rolle „Gruppe“). Ist die Person Broker, steht darunter <b>Wartet auf Zuweisung (als Broker)</b>: offene Vorgänge ihrer Arten, die noch niemandem gehören. Die gelbe Zahl am Reiter zeigt, wie viele. Zugewiesen wird über <b>Zur Zuweisung</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-mail"></i> So prüfst du den E-Mail-Versand und schaltest Statusmeldungen per E-Mail ein</b>
    <ol class="hb-steps">
      <li>Den Benutzerstamm der Person öffnen (oder <b>Mein Konto</b>), Reiter <b>Übersicht</b>, Karte <b>E-Mail</b>.</li>
      <li><b>Testmail senden</b> – daneben steht, ob die Mail rausging oder was nicht stimmt.</li>
      <li><b>Statusmeldungen auch per E-Mail</b> anhaken. Ab dann kommen die Hinweise von PDH-System (neu angelegt, geändert, zugewiesen) zusätzlich per E-Mail, mit Link zum Vorgang.</li>
    </ol>
    Die Karte sieht die Person selbst und wer ihre Stammdaten bearbeiten darf. Die E-Mail kommt nur, solange auch die Chat-Hinweise eingeschaltet sind (<b>Konto &amp; Dienste</b>). Der Versand muss unter <a href="#server">Server-Einstellungen → E-Mail</a> eingerichtet sein.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> So richtest du die Nextcloud-App mit Zertifikat ein</b>
    <ol class="hb-steps">
      <li><b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> → Karte <b>Zertifikat für die Nextcloud-App</b>.</li>
      <li>Bei <b>Gerät</b> z. B. „Handy“ eintragen → <b>Zertifikat ausstellen</b>. Das <b>Passwort</b> erscheint direkt darunter.</li>
      <li><b>.p12</b> herunterladen, am besten gleich auf dem Gerät.</li>
      <li><b>Android:</b> Datei antippen bzw. Einstellungen → Sicherheit → Verschlüsselung &amp; Anmeldedaten → Zertifikat installieren → <b>VPN- und App-Nutzerzertifikat</b>, Passwort eingeben. Beim Anmelden in der Nextcloud-App das Zertifikat auswählen.<br><b>iPhone:</b> in der Nextcloud-App beim Anmelden das Client-Zertifikat aus „Dateien“ importieren. Über die iOS-Einstellungen installierte Zertifikate nutzt die App nicht.<br><b>Windows/Mac:</b> der Nextcloud-Desktop-Client fragt beim Einrichten nach dem Zertifikat → Datei und Passwort angeben.</li>
    </ol>
    Für jedes Gerät ein eigenes Zertifikat. Geht ein Gerät verloren: dort <b>Sperren</b>. Das Passwort zeigt <b>Passwort</b> jederzeit wieder an. Fehlt die Karte, hat die Administration die Selbstbedienung ausgeschaltet; dann stellt sie das Zertifikat aus.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> Sprache</b>PDH gibt es auf Deutsch, Englisch, Rumänisch, Türkisch und Mazedonisch. Jede Person wählt ihre Sprache über die <b>Flagge</b> oben rechts (auf der Anmeldeseite oben in der Karte); die Wahl wird im Benutzerstamm gespeichert und gilt bei der nächsten Anmeldung auf jedem Gerät. Die <b>Vorwahl</b> trägt die Benutzerverwaltung im Benutzerstamm unter <b>Stammdaten → Sprache</b> ein. Ohne Eintrag nimmt PDH die Sprache des Browsers. Die Umstellung erfolgt schrittweise. Übersetzt sind bisher: Navigation, Kopfzeile, Menüs, Seitenleiste, Anmeldung, das <b>Dashboard</b> mit allen Widgets sowie der <b>Erstellungs-Assistent</b> (auch im Leitstand) und der <b>Abschluss-Assistent</b> samt ihren Meldungen. Der Leitstand folgt der Sprache des Browsers bzw. der zuletzt gewählten Flagge. Noch nicht übersetzte Seiten und dieses Handbuch erscheinen vorerst auf Deutsch; was du selbst eingibst (Titel, Kommentare) und der Verlauf bleiben in der Sprache, in der sie geschrieben wurden.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> So schaltest du die Live-Übersetzung ein</b>Die Live-Übersetzung übersetzt <b>alles auf der Seite</b> in deine Sprache – auch Seiten, die noch nicht übersetzt sind, und Inhalte wie Titel, Beschreibungen, Maßnahmen, Kommentare und Chat. Auch was später nachgeladen wird, wird übersetzt.
    <ol class="hb-steps">
      <li><b>Mein Konto</b> (bzw. als Benutzerverwaltung den Benutzer) öffnen → <b>Stammdaten</b>.</li>
      <li>Bei <b>Live-Übersetzung</b> „Alle Texte automatisch übersetzen“ anhaken.</li>
      <li>Unter <b>Übersetzen in</b> die Sprache wählen – z. B. Polnisch, Kroatisch oder Arabisch. Ohne Auswahl gilt die Sprache der Oberfläche.</li>
      <li><b>Speichern</b>. Ab der nächsten Seite wird übersetzt.</li>
    </ol>
    Schneller geht das An- und Ausschalten im Benutzermenü oben rechts: <b>Live-Übersetzung einschalten/ausschalten</b>. Beim ersten Aufruf einer Seite dauert es einen Moment (unten steht „Übersetze …“); danach kommen die Texte aus dem Zwischenspeicher sofort. Eingabefelder und was du gerade schreibst, bleiben unverändert – gespeichert wird immer der Originaltext. Die Texte gehen zum Übersetzen an den eingestellten Dienst (DeepL oder Copilot). Steht im Menü ein ⚠, hat ein Administrator noch keinen Dienst eingerichtet (<b>Server-Einstellungen → Übersetzung</b>).</div>
  <div class="hb-howto"><b><i class="ti ti-users-group"></i> Abteilungen &amp; Gruppen</b>Unter <b>Abteilungen &amp; Gruppen</b> (Navigation, Recht „Benutzer verwalten“) pflegst du beide zentral:
    <ul>
      <li><b>Abteilungen</b> mit Leitung. Jede Person gehört zu höchstens einer – im Benutzerstamm unter <b>Stammdaten → Abteilung</b> auswählen. Umbenennen wirkt sofort bei allen Mitarbeitenden. Kommt aus dem Microsoft-Abgleich eine neue Abteilung, legt PDH sie automatisch an.</li>
      <li><b>Gruppen</b> bündeln Personen quer zu Abteilungen (z. B. „Elektro Frühschicht“, „Ersthelfer“), optional mit Abteilung und Leitung. Mitglieder wählst du in der Gruppe oder im Benutzerstamm unter <b>Stammdaten → Gruppen</b>; eine Person kann in mehreren Gruppen sein. Vorgänge lassen sich einer Gruppe zuweisen; in der <b>Benutzerliste</b> filterst du nach Abteilung und Gruppe.</li>
      <li>Abteilungen bilden eine <b>Hierarchie</b>: Jede kann eine <b>übergeordnete Abteilung</b> haben. Die Struktur steht im <b>Organigramm</b> unter den Rollen.</li>
      <li><b>Rollen</b> ordnest du unter <b>Rollen &amp; Rechte</b> einer Abteilung zu (Auswahl im Kopf jeder Rollenspalte).</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock-access"></i> Rechte je Abteilung</b>Die Abteilung eines Vorgangs ergibt sich aus seiner <b>Anlage</b>: Im Anlagenbaum trägst du unter <b>Bearbeiten → Abteilung</b> ein, zu welcher Abteilung eine Anlage gehört. Unteranlagen ohne eigene Angabe <b>erben</b> sie von oben (in der Übersicht als „geerbt“ markiert).
    <ul>
      <li>Hat eine <b>Rolle eine Abteilung</b>, sehen ihre Benutzer nur Tickets, Störungen, Wartungen, Aufgaben, Projekte und IT-Assets dieser Abteilung und ihrer Unterabteilungen – in Listen, Detailseiten, im Dashboard (Kennzahlen, Verlauf, Listen, Zeitstrahl), in der Anlagen-Historie und über die Schnittstelle. Am <b>Leitstand</b> gilt das, sobald eine eingeschränkte Person angemeldet ist; die öffentliche Tafel ohne Anmeldung zeigt alles.</li>
      <li>Nicht eingeschränkt sind die vom Administrator eingerichteten <b>Datenexporte</b> (sie laufen auch ohne angemeldete Person nach Zeitplan); der <b>Outlook-Kalender</b> enthält ohnehin nur eigene Vorgänge.</li>
      <li>Immer sichtbar bleiben Vorgänge <b>ohne Anlage</b> oder ohne Abteilung sowie alles, woran man <b>selbst beteiligt</b> ist (erstellt, verantwortlich, zugewiesen – auch über eine Gruppe).</li>
      <li><b>Übergeordnete</b> Abteilungen – vorbelegt Instandhaltung, IT, Office und GL – und Rollen <b>ohne Abteilung</b> (z. B. Administrator) sehen alles. Das Kennzeichen setzt du unter <b>Abteilungen &amp; Gruppen</b>.</li>
    </ul></div>
  {{template "hb-shots" (dict "Ref" (index $s "users") "Can" $can)}}
</section>

<section class="hb-ch" id="templates" data-title="Vorlagen &amp; Signaturen" data-pages="m365">
  <h2><i class="ti ti-brand-office"></i> Vorlagen &amp; Signaturen</h2>
  <p>Unter <b>Navigation → Vorlagen &amp; Signaturen</b> liegen die Firmenvorlagen für Word, Excel und PowerPoint. Jede Person kann sie dort herunterladen. Ist eine SharePoint-Bibliothek eingerichtet, stehen sie auch direkt in Word, Excel und PowerPoint unter <b>Neu</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-upload"></i> So stellst du eine Vorlage bereit</b>
    <ol class="hb-steps">
      <li>Reiter <b>Vorlagen</b> → <b>Vorlage hochladen</b>: Datei wählen (.dotx, .docx, .xltx, .xlsx, .potx, .pptx), Kategorie und Beschreibung eintragen, <b>Hochladen</b>.</li>
      <li>Neue Fassung: bei der Vorlage <b>Bearbeiten</b>, Datei unter <b>Neue Version</b> wählen, <b>Speichern</b>. Die Versionsnummer zählt hoch.</li>
      <li>Mit SharePoint: <b>Mit SharePoint abgleichen</b>. Neue und geänderte Vorlagen werden hochgeladen, ausgeblendete und gelöschte dort entfernt.</li>
    </ol>
    <b>Ausblenden</b> nimmt eine Vorlage aus der Liste, ohne sie zu löschen. Das Recht „Microsoft-365-Vorlagen &amp; E-Mail-Signaturen verwalten“ braucht man zum Hochladen und Ändern; Herunterladen darf jede Person.</div>
  <div class="hb-howto"><b><i class="ti ti-signature"></i> So richtest du E-Mail-Signaturen ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Signaturen</b> → <b>Neue Signatur</b>. Bei <b>Gilt für</b> eine Abteilung wählen oder „alle“ lassen.</li>
      <li>Das HTML anpassen. Die Knöpfe fügen Platzhalter ein, z. B. <code>{Name}</code>, <code>{Position}</code>, <code>{Telefon}</code>, <code>{Mobil}</code>, <code>{E-Mail}</code>, <code>{Firma}</code>. Rechts siehst du die Vorschau für eine ausgewählte Person.</li>
      <li><b>Speichern</b>. Unten im Reiter zuerst <b>Werte nach Microsoft 365 übertragen</b>, dann <b>Exchange-Skript herunterladen</b>.</li>
      <li>Das Skript in PowerShell ausführen: <code>Connect-ExchangeOnline</code>, dann <code>.\pdh-signaturen.ps1</code>. Ab dann hängt Exchange die Signatur an jede ausgehende Mail.</li>
    </ol>
    Die Werte kommen aus dem Benutzerstamm. Was dort leer ist, nimmt PDH aus Microsoft 365. Den Firmennamen für <code>{Firma}</code> trägst du im Reiter <b>Einstellungen</b> ein. Nach Änderungen an einer Signatur das Skript neu herunterladen und ausführen. Nach Änderungen im Benutzerstamm genügt <b>Werte nach Microsoft 365 übertragen</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Für Administratoren: einmalige Einrichtung</b>
    <ul>
      <li>In der Entra-App-Registrierung des PDH unter <b>API-Berechtigungen → Microsoft Graph → Anwendungsberechtigungen</b> diese Rechte hinzufügen und die <b>Administratorzustimmung erteilen</b>: <b>Sites.ReadWrite.All</b> (für SharePoint) und <b>User.ReadWrite.All</b> (für Werte nach Microsoft 365).</li>
      <li>Reiter <b>Einstellungen</b>: SharePoint-Site und Bibliothek eintragen, <b>Speichern &amp; prüfen</b>. Den dort angezeigten Befehl <code>Add-SPOOrgAssetsLibrary</code> einmalig in der SharePoint-Online-PowerShell ausführen. Bis die Vorlagen in Office erscheinen, kann es bis zu 24 Stunden dauern.</li>
      <li>Vor dem Übertragen unter <b>Core-Einstellungen → Microsoft 365</b> einmal <b>Jetzt abgleichen</b>. Nur zugeordnete Personen werden übertragen.</li>
      <li>Personen, die aus einem lokalen Active Directory synchronisiert werden, kann PDH in Microsoft 365 nicht ändern. Diese Werte im lokalen AD pflegen.</li>
    </ul></div>
  <p>Exchange erlaubt höchstens 5000 Zeichen je Signatur. Die Liste zeigt, wie viele eine Signatur braucht. Bilder wie das Logo nur als Link auf eine öffentlich erreichbare Adresse einbinden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "templates") "Can" $can)}}
</section>

<section class="hb-ch" id="trainings" data-title="Schulungen &amp; Qualifikationen" data-pages="trainings">
  <h2><i class="ti ti-school"></i> Schulungen &amp; Qualifikationen</h2>
  <p>Die <b>Schulungsmatrix</b> zeigt je Person, welche Schulungen und Qualifikationen sie braucht und ob ein gültiger, unterschriebener Nachweis vorliegt: <span style="color:var(--green)">gültig</span>, <span style="color:var(--amber)">läuft bald ab</span>, <span style="color:var(--red)">abgelaufen</span> bzw. <span style="color:var(--red)">fehlt</span>, oder <b>Termin geplant</b>. Pflichtfelder sind umrandet; in der Zelle steht, bis wann der Nachweis gilt. Jede Person sieht ihren eigenen Stand unter <b>Meine Schulungen</b> und im Benutzerstamm im Reiter <b>Schulungen</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-books"></i> Katalog einrichten</b> (Recht „Schulungen &amp; Qualifikationen verwalten“)
    <ol class="hb-steps">
      <li><b>Schulungen</b> → Reiter <b>Katalog</b> → <b>Neu im Katalog</b>: Bezeichnung, Art (Schulung/Unterweisung oder Qualifikation), <b>Verantwortlich</b>, Wiederholung in Monaten (0 = einmalig) und wie viele Tage vor Ablauf sie fällig wird.</li>
      <li>Unter <b>Pflicht für</b> ankreuzen, wer sie braucht: Rollen, Abteilungen, Gruppen oder einzelne Personen. Die Pflichtschulungen einer Rolle stehen auch unter <b>Rollen &amp; Rechte</b> im Kopf der Rollenspalte.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-signature"></i> So entsteht ein Nachweis</b>
    <ol class="hb-steps">
      <li><b>Automatisch bei Fälligkeit:</b> Braucht jemand die Schulung und hat keinen gültigen Nachweis mehr (oder bald nicht mehr), legt PDH einen offenen Nachweis mit allen Fälligen an und schreibt dem/der Verantwortlichen im Chat. Ist schon ein offener Nachweis da, kommen neu Fällige dazu. Ohne Verantwortliche/n geht der Hinweis an die Administratoren. Manuell geht es über <b>Neuer Nachweis</b>.</li>
      <li>Im Nachweis <b>Datum</b>, <b>Schulende/n</b> und den <b>Inhalt in Stichpunkten</b> eintragen (eine Zeile je Punkt) und speichern. Teilnehmende einzeln, als ganze Gruppe oder Abteilung hinzufügen; wer nicht da war, mit <i class="ti ti-user-minus"></i> entfernen.</li>
      <li>Jede/r Teilnehmende <b>unterschreibt am Bildschirm</b> (Finger, Stift oder Maus) – am gemeinsamen Tablet der/des Schulenden oder am eigenen Gerät. Zum Schluss unterschreibt die/der Schulende.</li>
      <li><b>Abschließen &amp; archivieren</b> erscheint erst, wenn alles vollständig ist. Danach ist der Nachweis unveränderlich und zählt in der Matrix. <b>Drucken</b> erzeugt das Nachweisblatt mit allen Unterschriften.</li>
    </ol></div>
  <p>Ändern sich nach dem Unterschreiben Datum, Inhalt oder Schulende/r, verfallen die Unterschriften – unterschrieben wird immer genau das, was geschult wurde. Für den nächsten Termin legt <b>Wiedervorlage (leeres Formular)</b> einen neuen Nachweis mit gleicher Schulung, Ort, Schulende/r und Teilnehmenden an; Datum, Inhalt und Unterschriften sind leer. Mit <b>vom letzten Termin</b> übernimmst du bei Bedarf die Stichpunkte des letzten archivierten Termins.</p>
  <p>Die Ja/Nein-Fähigkeiten für den Schichtplan (Rufbereitschaft, Schlüsseldienst usw.) und die Nachweise im Benutzerstamm (Führerschein, externe Zertifikate) bleiben davon unabhängig.</p>
  {{template "hb-shots" (dict "Ref" (index $s "trainings") "Can" $can)}}
</section>

<section class="hb-ch" id="fieldsets" data-title="Feldsätze" data-pages="">
  <h2><i class="ti ti-forms"></i> Feldsätze</h2>
  <p>Feldsätze sind Zusatzfelder, die eure Administration festlegt – z. B. bei Motoren „Leistung“ und „Schutzart“. Sie erscheinen im Reiter <b>Feldsätze</b>; dort auf <b>Bearbeiten</b> klicken, ausfüllen, speichern.</p>
  <p>Ein Feldsatz gilt entweder für einzelne ausgewählte Datensätze oder automatisch (für alle oder eine bestimmte Kategorie).</p>
  <h3>Module <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <ul>{{range .FieldModules}}<li>{{.Label}}{{if .MatchLabel}} – automatisch nach {{.MatchLabel}}{{end}}</li>{{end}}</ul>
  <h3>Feldtypen <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <p>{{$tl := .TypeLabels}}{{range $i, $t := .FieldTypes}}{{if $i}}, {{end}}{{index $tl $t}}{{end}}</p>
  {{template "hb-shots" (dict "Ref" (index $s "fieldsets") "Can" $can)}}
</section>

<section class="hb-ch" id="cleanup" data-title="Sperren, Deaktivieren &amp; Löschen" data-pages="cleanup">
  <h2><i class="ti ti-trash-x"></i> Sperren, Deaktivieren &amp; Löschen</h2>
  <p>Stammdaten – <b>Anlagen, Ersatzteile, Lagerplätze, Hersteller &amp; Lieferanten</b> – werden im PDH <b>nie direkt gelöscht</b>. Sonst würden Störungen, Buchungen und Historien plötzlich ins Leere zeigen. Stattdessen gibt es drei Stufen, alle über <b>Status</b> oben auf der Detailseite:</p>
  <table>
    <tr><td><b><i class="ti ti-lock"></i> Sperren</b></td><td>Der Datensatz bleibt sichtbar, kann aber nicht mehr geändert werden (z. B. Anlage während eines Umbaus). Kommentare sind weiter möglich. Auf gesperrte Ersatzteile und Lagerplätze kann <b>nichts gebucht</b> werden – weder in der Ersatzteilliste noch bei der Materialentnahme in Vorgängen oder über Schnittstellen.</td></tr>
    <tr><td><b><i class="ti ti-circle-off"></i> Deaktivieren</b></td><td>Verschwindet aus Listen und Auswahlfeldern, bleibt aber vollständig erhalten und kann jederzeit wieder aktiviert werden.</td></tr>
    <tr><td><b><i class="ti ti-trash-x"></i> Zum Löschen vormerken</b></td><td>Wird sofort deaktiviert. Beim nächsten <b>Bereinigungslauf</b> prüft PDH, ob er noch verwendet wird.</td></tr>
  </table>
  {{template "hb-fig-cleanup"}}
  <div class="hb-howto"><b><i class="ti ti-trash-x"></i> So merkst du einen Datensatz zum Löschen vor</b>
    <ol class="hb-steps">
      <li>Datensatz öffnen → oben rechts <b>Status</b>.</li>
      <li>Optional einen <b>Grund</b> eintragen (z. B. „Anlage verschrottet“) – er steht später in der Historie.</li>
      <li><b>Zum Löschen vormerken</b> und bestätigen. Rückgängig machst du es über <b>Status → Löschvormerkung aufheben</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So startest du den Bereinigungslauf (Administration)</b>
    <ol class="hb-steps">
      <li>Navigation → <b>Bereinigung</b>. Im Reiter <b>Vormerkungen</b> steht bei jedem Datensatz schon vorab, was passieren wird: <i>wird gelöscht</i> oder <i>wird ausgeblendet</i> – mit Grund, z. B. „3 × Störungen, Lagerbestand 5“.</li>
      <li>Einzelne Vormerkungen bei Bedarf <b>aufheben</b>.</li>
      <li><b>Bereinigungslauf starten</b>. Unbenutzte Datensätze werden endgültig gelöscht, noch verwendete <b>ausgeblendet</b>.</li>
      <li>Alle Administratoren bekommen von <b>„Service“</b> eine Chat-Nachricht mit dem Ergebnis.</li>
    </ol></div>
  <p>Die Reiter <b>Gesperrt</b>, <b>Deaktiviert</b> und <b>Ausgeblendet</b> zeigen alle betroffenen Stammdaten – dort lassen sie sich mit einem Klick entsperren, aktivieren oder wieder einblenden. Der <b>Verlauf</b> zeigt jeden Bereinigungslauf mit Details. Ersatzteile findest du außerdem über den Listenfilter „Deaktiviert“ bzw. „Gesperrt“, Firmen über den Reiter „Inaktiv“.</p>
  <p>Auch Schnittstellen können keine Stammdaten löschen: Eine Löschanforderung über die API wird automatisch zur Löschvormerkung.</p>
  {{template "hb-shots" (dict "Ref" (index $s "cleanup") "Can" $can)}}
</section>

<section class="hb-ch" id="backup" data-title="Datensicherung &amp; Wiederherstellung" data-pages="backup">
  <h2><i class="ti ti-database-export"></i> Datensicherung &amp; Wiederherstellung</h2>
  <p>Unter <b>Navigation → Datensicherung</b> (Berechtigung <i>Datensicherung &amp; Wiederherstellung</i>, standardmäßig nur Administratoren) sicherst du das PDH und spielst Sicherungen zurück.</p>
  {{template "hb-fig-backup"}}
  <table>
    <tr><td><b>Datenbank</b></td><td>alle Stammdaten, Vorgänge, Benutzer, Rechte, Einstellungen und Chat-Nachrichten</td></tr>
    <tr><td><b>Anhänge &amp; Bilder</b></td><td>Dokumente, Datensatz- und Ersatzteilbilder, Handbuch-Bildschirmfotos</td></tr>
    <tr><td><b>Chat-Dateien</b></td><td>im Chat geteilte Dateien</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So erstellst du eine Sicherung</b>
    <ol class="hb-steps">
      <li>Reiter <b>Sicherungen</b> → unter „Jetzt sichern“ die Bestandteile anhaken.</li>
      <li><b>Sicherung erstellen</b>. Sie läuft im Hintergrund; der Fortschritt steht im <b>Protokoll</b>.</li>
      <li>Fertige Sicherungen kannst du <b>herunterladen</b> und extern aufbewahren (z. B. auf einem anderen Server).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-calendar-time"></i> So richtest du eine automatische Sicherung ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Zeitpläne</b> → „Neuer Zeitplan“.</li>
      <li>Name, <b>Häufigkeit</b> (täglich, wöchentlich mit Wochentag, monatlich mit Tag 1–28) und <b>Uhrzeit</b> wählen.</li>
      <li>Bestandteile anhaken und festlegen, wie viele Sicherungen <b>aufbewahrt</b> werden – ältere werden automatisch entfernt.</li>
      <li>Speichern. Mit <b>Jetzt ausführen</b> testest du den Zeitplan sofort. Schlägt eine geplante Sicherung fehl, meldet sich „Service“ per Chat bei allen Administratoren.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-restore"></i> So stellst du eine Sicherung wieder her</b>
    <ol class="hb-steps">
      <li>Bei der gewünschten Sicherung auf <b>Wiederherstellen</b> (fremde Sicherung vorher mit <b>Sicherung hochladen</b> einspielen).</li>
      <li>Bestandteile wählen – z. B. nur die Anhänge.</li>
      <li><b>WIEDERHERSTELLEN</b> eintippen und bestätigen.</li>
    </ol>
    PDH legt vorher automatisch eine <b>Sicherheitskopie</b> des aktuellen Stands an. Die Datenbank wird in einem Schritt zurückgespielt – geht etwas schief, bleibt der bisherige Stand unverändert. Alle Administratoren werden per Chat über Beginn und Ergebnis informiert.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> Automatische Vollsicherung bei jedem Update</b>
    Startet das PDH nach einem Update zum ersten Mal, sichert es <b>vor</b> allen Datenbank-Änderungen den kompletten bisherigen Stand (Datenbank, Anhänge, Chat-Dateien) – egal ob über <b>Core-Einstellungen → Update installieren</b>, den Installer oder von Hand aktualisiert wurde. Die Sicherung erscheint in der Liste als <b>Vor Update</b>; aufbewahrt werden die letzten 5 (einstellbar unter <b>Zeitpläne → Automatisch bei jedem Update</b>, dort auch abschaltbar). Schlägt die Sicherung fehl (z. B. Speicher voll), wird das Update <b>nicht</b> angewendet und im Server-Protokoll steht der Grund. Nur im Notfall lässt sich das mit der Umgebungsvariablen <code>PDH_SKIP_UPDATE_BACKUP=1</code> übergehen.</div>
  <p><b>Wichtig:</b> Eine Sicherung aus einer <b>neueren</b> PDH-Version kann erst nach einem Update eingespielt werden. Ältere Sicherungen werden beim Einspielen automatisch auf den aktuellen Stand gebracht. Sicherungsprotokoll und Zeitpläne selbst werden nicht überschrieben.</p>
  {{template "hb-shots" (dict "Ref" (index $s "backup") "Can" $can)}}
</section>

<section class="hb-ch" id="drives" data-title="Netzlaufwerke" data-pages="core-settings">
  <h2><i class="ti ti-server-2"></i> Netzlaufwerke</h2>
  <p>Unter <b>Core-Einstellungen → Netzlaufwerke</b> bindet PDH Freigaben aus dem Firmennetz ein – Windows-Freigaben und NAS (<b>SMB/CIFS</b>), <b>NFS</b> oder ein Verzeichnis, das der Server schon eingebunden hat (<b>Lokaler Pfad</b>). Jedes Laufwerk liegt danach unter <code>/mnt/pdh/&lt;name&gt;</code>.</p>
  {{template "hb-fig-drives"}}
  <div class="hb-howto"><b><i class="ti ti-plug"></i> So bindest du ein Laufwerk ein</b> (Recht „Rollen &amp; Rechte verwalten“)
    <ol class="hb-steps">
      <li><b>Laufwerk hinzufügen</b>: Name, Art und Freigabe eintragen – z. B. <code>\\nas\instandhaltung</code> oder <code>nas:/export/pdh</code>.</li>
      <li>Bei SMB Benutzername, Passwort und ggf. Domäne angeben. Das Passwort wird verschlüsselt gespeichert. Klappt es nicht, unter Optionen z. B. <code>vers=3.0</code> oder <code>vers=2.1</code> eintragen.</li>
      <li>Ankreuzen, wofür das Laufwerk dient (siehe unten), dann <b>Speichern &amp; einbinden</b>. <b>Testen</b> prüft, ob PDH lesen und schreiben darf; <b>Durchsuchen</b> zeigt die Ordner und kopiert Pfade.</li>
    </ol>
    Mit „automatisch einbinden“ verbindet PDH das Laufwerk nach jedem Neustart und alle 5 Minuten wieder, falls die Verbindung abbricht. Fällt ein Laufwerk aus, bekommen die Administratoren eine Chat-Nachricht und PDH arbeitet lokal weiter.</div>
  <table>
    <tr><td><b><i class="ti ti-database"></i> Globaler Datenspeicher</b></td><td>Die Standardablage: Import- und Export-Pfade <b>ohne</b> führenden Schrägstrich (z. B. <code>Exporte/zaehler.xlsx</code>) liegen hier. Sicherungen und Dokumente landen ebenfalls hier, wenn dafür kein eigenes Laufwerk gewählt ist.</td></tr>
    <tr><td><b><i class="ti ti-database-import"></i> Import &amp; Export</b></td><td>Das Laufwerk erscheint als Vorschlag in den Feldern <b>Quellpfad</b> und <b>Zielpfad</b> der Import- und Export-Verbindungen.</td></tr>
    <tr><td><b><i class="ti ti-database-export"></i> Datensicherung</b></td><td>Neue Sicherungen werden im Ordner <code>PDH-Sicherungen</code> des Laufwerks gespeichert. Ältere Sicherungen bleiben im lokalen Ordner.</td></tr>
    <tr><td><b><i class="ti ti-files"></i> Dokumentenablage</b></td><td>Jeder neue Anhang (Foto, Dokument) wird zusätzlich nach Vorgang sortiert abgelegt: <code>PDH-Dokumente/Tickets/Tür klemmt (a1b2c3d4)/Foto.jpg</code>. <b>Vorhandene Dokumente übertragen</b> legt einmalig alle bisherigen Anhänge ab. PDH behält seine eigene Kopie.</td></tr>
  </table>
  <p>Datenspeicher, Datensicherung und Dokumentenablage gibt es je einmal. Ein schreibgeschütztes Laufwerk eignet sich nur für Import &amp; Export. Eingebunden wird über den Update-Agenten: bei Docker-Installationen ist das ab dieser Version eingerichtet (nach dem Update einmal <code>docker compose up -d</code>); bei Installationen ohne Docker <code>sudo ./install-update-agent.sh</code> erneut ausführen, damit die Mount-Werkzeuge installiert werden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "drives") "Can" $can)}}
</section>

<section class="hb-ch" id="server" data-title="Server-Einstellungen &amp; Ersteinrichtung" data-pages="server-config server-logs">
  <h2><i class="ti ti-adjustments-cog"></i> Server-Einstellungen &amp; Ersteinrichtung</h2>
  <p>Im Reiter <b>VPN</b> richtest du das WireGuard-VPN ins Maschinennetz ein (Dienst auf dem Server, Gateways, ausgehende Tunnel, alle Geräte) – siehe <a href="#hb-vpn-setup">VPN ins Maschinennetz</a>.</p>
  <h3><i class="ti ti-rocket"></i> Ersteinrichtung</h3>
  {{template "hb-fig-setup"}}
  <p>Beim allerersten Start braucht das PDH keine vorbereitete <code>.env</code>-Datei. Der Anmelde-Schlüssel wird automatisch erzeugt. Findet das PDH keine Datenbank oder noch keinen Benutzer, öffnet sich im Browser unter <code>http://&lt;server&gt;:8090/setup</code> der <b>Einrichtungsassistent</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-list-numbers"></i> So richtest du das PDH ein</b>
    <ol class="hb-steps">
      <li><b>Einrichtungscode</b> eingeben. Er schützt die Einrichtung vor Unbefugten und steht im Server-Protokoll (<code>docker compose logs app</code> bzw. <code>journalctl -u pdh</code>) und in der Datei <code>setup-code.txt</code>.</li>
      <li><b>Datenbank</b> (nur wenn keine erreichbar ist): <i>Automatisch anlegen</i> – mit dem PostgreSQL-Administrator (meist <code>postgres</code>) legt das PDH einen eigenen Datenbank-Benutzer mit sicherem Zufallspasswort und die Datenbank an. Oder <i>vorhandene Zugangsdaten</i> eintragen; fehlt nur die Datenbank, legt das PDH sie an. <b>Verbindung testen</b> prüft die Angaben vorab.</li>
      <li><b>Administrator</b> anlegen (Passwort mindestens 10 Zeichen) und die <b>öffentliche Adresse</b> bestätigen.</li>
      <li><b>Einrichtung abschließen</b> – das PDH legt die Datenbankstruktur an, startet und leitet zur Anmeldung weiter.</li>
    </ol></div>
  <p>Startet die Datenbank nur etwas später (z. B. nach einem Neustart des Servers), wartet der Assistent und macht von selbst weiter.</p>
  <h3><i class="ti ti-adjustments-cog"></i> Server-Einstellungen im Betrieb</h3>
  <p>Unter <b>Navigation → Server-Einstellungen</b> (nur Administratoren) stehen alle Werte, die früher von Hand in der <code>.env</code> gepflegt wurden – in Reitern: Server, Datenbank, Sicherheit, E-Mail, Copilot, Übersetzung, Microsoft 365, Nextcloud, Störungen, Cloudflare-Tunnel, Protokoll, Updates &amp; Sicherung.</p>
  <p><b>Gespeichert wird in der Datenbank</b> – Passwörter, Schlüssel und Tokens verschlüsselt. In der <code>.env</code> bleiben nur der <b>Datenbank-Zugang</b> und der Schlüssel <code>PDH_SETTINGS_KEY</code>, ohne die das PDH die Datenbank nicht erreichen bzw. die Geheimnisse nicht entschlüsseln kann. <b>Diese Datei deshalb unbedingt mitsichern</b> – eine Datenbank-Sicherung allein genügt für die verschlüsselten Werte nicht.</p>
  <div class="hb-howto"><b><i class="ti ti-database-import"></i> Übernahme einer bestehenden .env</b>
    Beim Start überträgt das PDH alle Werte der <code>.env</code>, die noch nicht in der Datenbank stehen, automatisch dorthin und kommentiert sie in der Datei aus (daneben liegt eine Sicherungskopie <code>.env.bak-…</code>, die die alten Werte im Klartext enthält – nach Prüfung löschen). Trägt jemand später wieder einen Wert in die <code>.env</code> ein, zeigt die Seite einen Hinweis mit <b>jetzt übernehmen</b>. Werte, die Docker (<code>.env.docker</code>) oder systemd von außen setzen, haben Vorrang, bis du sie übernimmst (siehe unten).</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> So holst du Microsoft-, Nextcloud- und andere Zugangsdaten aus der .env.docker</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> öffnen. Stehen noch sicherheitsrelevante Werte in <code>.env.docker</code>, erscheint oben ein gelber Hinweis; die betroffenen Reiter haben einen gelben Punkt.</li>
      <li><b>Alle in die Datenbank übernehmen</b> – oder im Reiter (z. B. <b>Microsoft 365</b>) <b>In die Datenbank übernehmen</b>. Die Werte werden verschlüsselt gespeichert und gelten ab sofort aus der Datenbank; die Felder sind jetzt bearbeitbar.</li>
      <li>Im Reiter <b>Verbindung testen</b> (Microsoft 365, Nextcloud, Übersetzung, E-Mail, Datenbank, Copilot). Der Punkt am Reiter wird <span style="color:var(--green)">grün</span>.</li>
      <li>Bei Grün erscheint <b>Aus .env.docker entfernen</b>: Der Update-Agent kommentiert die Zeilen in <code>.env.docker</code> aus – ohne den Wert. Ohne Update-Agent die Zeilen von Hand löschen.</li>
    </ol>
    In <code>.env.docker</code> bleiben nur Werte, die Docker selbst braucht: Datenbank-Zugang, Update-Agent-Token, Grafana-Passwörter, Port und Projektname. Den Schlüssel <code>PDH_SETTINGS_KEY</code> (in <code>pdh.env</code> bzw. <code>.env</code>) unbedingt mitsichern – ohne ihn sind die verschlüsselten Werte nach einer Wiederherstellung nicht lesbar.</div>
  <table>
    <tr><td><span class="rec-sub">Datenbank</span></td><td>in der Datenbank gespeichert – hier änderbar</td></tr>
    <tr><td><span class="rec-sub">Datei</span></td><td>steht (noch) in der Einstellungsdatei – beim Datenbank-Zugang immer so</td></tr>
    <tr><td><span class="rec-sub">Standard</span></td><td>nicht gesetzt, es gilt der Standardwert</td></tr>
    <tr><td><span class="rec-sub">Umgebung</span></td><td>von außen vorgegeben (Docker <code>.env.docker</code>, systemd) – hat Vorrang vor der Datenbank und ist hier nur lesbar. Leere Einträge wie <code>PDH_COPILOT_ANTHROPICKEY=</code> zählen nicht, dann gilt der Wert aus der Datenbank</td></tr>
    <tr><td><i class="ti ti-refresh"></i></td><td>wirkt erst nach einem <b>Neustart</b> – der Knopf <b>Server neu starten</b> erledigt das in wenigen Sekunden</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-user-shield"></i> So richtest du den PDH-Administrator in Nextcloud ein</b>
    <ol class="hb-steps">
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b>: oben die <b>Nextcloud-Adresse</b> eintragen und speichern.</li>
      <li>Karte <b>PDH-Administrator in Nextcloud</b> → Benutzername (Vorgabe <b>pdhNCadmin</b>) → <b>In Nextcloud einrichten</b>. Das PDH legt das Konto als Nextcloud-Admin an, erzeugt ein zufälliges Passwort und trägt Benutzer und Passwort selbst bei <b>Benutzer</b> / <b>App-Passwort</b> ein.</li>
      <li>Oben <b>Neu starten</b>, damit Ablage und Deck das Konto übernehmen.</li>
    </ol>
    Klappt das Einrichten nicht, steht der Grund rot in der Karte unter <b>Letzter Versuch</b>. Häufig hängt Nextcloud im Wartungsmodus (Meldung „503“): Dann auf dem Server <code>sudo -u www-data php /var/www/nextcloud/occ maintenance:mode --off</code> ausführen und erneut einrichten.
    Das Passwort kennt nur das PDH. Alle 6 Stunden prüft es die Anmeldung. Hat jemand das Passwort in Nextcloud geändert oder das Konto aus der Gruppe <b>admin</b> genommen, setzt das PDH sein Passwort und die Rechte wieder und meldet das allen Administratoren. <b>Neues Passwort</b> tauscht es jederzeit aus. <b>Nicht mehr verwalten</b> beendet den Abgleich, Konto und Passwort bleiben. Braucht den Update-Agenten und Nextcloud auf demselben Server. Gilt in Nextcloud Zwei-Faktor-Pflicht für Admins, das Konto davon ausnehmen.</div>
  <div class="hb-howto"><b><i class="ti ti-palette"></i> So bekommt Nextcloud den PDH-Look</b>
    <ol class="hb-steps">
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b>. Unten zeigt die Karte <b>Nextcloud im PDH-Look</b> die Vorschau: Name, Firmenfarbe und Logo aus dem Reiter <b>Erscheinungsbild</b>.</li>
      <li><b>An Nextcloud übertragen</b> – dafür braucht der eingetragene Nextcloud-Benutzer Admin-Rechte in Nextcloud.</li>
      <li>Klappt das bei eurer Nextcloud-Version nicht: <b>occ-Skript herunterladen</b>, auf den Nextcloud-Server kopieren und dort <code>sudo bash nextcloud-theming-pdh.sh /var/www/nextcloud</code> ausführen.</li>
      <li>Nextcloud im Browser neu laden (Strg+F5).</li>
    </ol>
    Ändert sich das Erscheinungsbild des PDH (Farbe, Logo, Name), einfach erneut übertragen.</div>
  <div class="hb-howto"><b><i class="ti ti-mail"></i> Beispiel: E-Mail-Versand einrichten</b>
    <ol class="hb-steps">
      <li>Reiter <b>E-Mail</b>: SMTP-Server, Port, Verschlüsselung, Benutzer, Passwort und Absender eintragen.</li>
      <li><b>Speichern</b> – E-Mail-Einstellungen gelten sofort.</li>
      <li><b>Testmail an mich</b> schickt eine Nachricht an deine eigene Adresse.</li>
    </ol>
    „Passwort vergessen?“ verschickt seine Links nur, wenn E-Mail eingerichtet ist und im Reiter <b>Server</b> die <b>Öffentliche Adresse</b> steht. Der Link wird bewusst nur daraus gebaut, nie aus der Adresse der Anfrage.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> So versendest du E-Mails über Microsoft 365</b>
    <ol class="hb-steps">
      <li>Im Microsoft Entra Admin Center die App-Registrierung des PDH öffnen → <b>API-Berechtigungen</b> → <b>Microsoft Graph</b> → <b>Anwendungsberechtigungen</b> → <b>Mail.Send</b> hinzufügen und <b>Administratorzustimmung erteilen</b>.</li>
      <li>Im Reiter <b>Microsoft 365</b> müssen Tenant-ID, Client-ID und Client-Secret dieser App stehen.</li>
      <li>Reiter <b>E-Mail</b>: <b>Versandweg</b> auf <code>graph</code> stellen und als <b>Absender</b> das Postfach eintragen, aus dem der PDH sendet (z. B. <code>pdh@firma.de</code>). SMTP-Server, Benutzer und Passwort bleiben leer.</li>
      <li><b>Speichern</b> und <b>Testmail an mich</b> schicken.</li>
    </ol>
    Dafür muss „Authentifiziertes SMTP“ im Tenant nicht eingeschaltet sein. Mail.Send erlaubt der App zunächst das Senden aus jedem Postfach – deine Microsoft-Administration kann das per Zugriffsrichtlinie auf das PDH-Postfach beschränken.</div>
  <div class="hb-howto"><b><i class="ti ti-password"></i> So stellst du die Passwort-Richtlinie ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Passwörter</b> öffnen.</li>
      <li><b>Mindestlänge</b> (8–72), <b>Höchstalter</b> in Tagen (0 = läuft nie ab) und <b>Wiederverwendung sperren</b> (die letzten N Passwörter, 0 = aus) eintragen.</li>
      <li>Ankreuzen, was das Passwort braucht: <b>Großbuchstaben</b>, <b>Kleinbuchstaben</b>, <b>Ziffer</b>, <b>Sonderzeichen</b>.</li>
      <li>Festlegen, wann gewechselt werden muss: bei der <b>Erstanmeldung</b> und/oder nachdem ein <b>Administrator das Passwort</b> geändert hat. Mit <b>jetzt alle Benutzer … zum Wechsel zwingen</b> müssen einmalig alle mit Passwort beim nächsten Anmelden ein neues vergeben.</li>
      <li><b>Speichern</b> – die Richtlinie gilt sofort für jedes neue Passwort, ein Neustart ist nicht nötig. Bestehende Passwörter bleiben gültig, bis sie geändert werden oder ablaufen.</li>
    </ol>
    Unter dem Knopf steht, wie viele Benutzer ihr Passwort gerade ändern müssen.</div>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So prüfst du den Copilot-Zugang</b>
    <ol class="hb-steps">
      <li>Reiter <b>Copilot</b> → <b>Verbindung testen</b>.</li>
      <li>Oben steht, mit welchem Schlüssel der Server <b>gerade läuft</b> und welcher <b>eingestellt</b> ist, mit Quelle (Datenbank oder Umgebung). Angezeigt werden nur Anfang, Ende und Länge des Schlüssels.</li>
      <li>Darunter steht, ob Anthropic den Schlüssel annimmt und ob das eingestellte Modell verfügbar ist. Der Test kostet nichts.</li>
    </ol>
    Typische Ursachen für <i>„API key is invalid“</i>: Der neue Schlüssel ist gespeichert, aber der Server wurde <b>nicht neu gestartet</b>. Oder in <code>.env.docker</code> steht noch ein <b>alter Schlüssel</b>, der Vorrang vor der Datenbank hat – der Test zeigt das an. Oder der Schlüssel wurde in der Claude Console widerrufen bzw. unvollständig kopiert – dann einen neuen erzeugen und eintragen.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> So richtest du den Dienst für die Live-Übersetzung ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Übersetzung</b>: Bei <b>Dienst</b> „auto“ lassen (empfohlen) oder „deepl“ bzw. „copilot“ wählen.</li>
      <li>Für DeepL den <b>DeepL-API-Schlüssel</b> aus dem DeepL-Konto eintragen (kostenlose Schlüssel enden auf <code>:fx</code>). Ohne Schlüssel übersetzt der Copilot-Anbieter (Reiter Copilot).</li>
      <li><b>Speichern</b> – wirkt sofort.</li>
    </ol>
    Bei „auto“ übersetzt DeepL alle Sprachen, die es kann; Mazedonisch, Kroatisch, Serbisch, Bosnisch, Albanisch, Persisch und Vietnamesisch übernimmt der Copilot. Fällt DeepL aus, springt der Copilot ein. Jeder Text wird je Sprache nur einmal übersetzt und für alle Benutzer zwischengespeichert; ein halbes Jahr nicht mehr gebrauchte Übersetzungen werden gelöscht.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud-lock"></i> So machst du das PDH über einen Cloudflare-Tunnel erreichbar</b>
    Der Tunnel macht das PDH aus dem Internet erreichbar, ohne dass in der Firewall ein Port geöffnet wird. Du brauchst ein Cloudflare-Konto mit eurer Domain.
    <ol class="hb-steps">
      <li>Im Cloudflare-Zero-Trust-Dashboard <b>Networks → Tunnels → Create a tunnel → Cloudflared</b>, Name z. B. „PDH“.</li>
      <li>Den angezeigten Installationsbefehl (oder nur den langen Token) kopieren und im Reiter <b>Cloudflare-Tunnel</b> bei <b>Tunnel-Token</b> einfügen. <b>Speichern</b>.</li>
      <li>Im Dashboard unter <b>Public Hostname</b> die Adresse festlegen (z. B. <code>pdh.firma.de</code>) und als Service das <b>Ziel im Tunnel</b> eintragen (Standard: HTTP, <code>localhost:8090</code>). Den Hostnamen auch im PDH eintragen.</li>
      <li><b>Skript für Linux</b> bzw. <b>Skript für Windows</b> herunterladen, auf den PDH-Server kopieren (bei Docker auf den Host) und ausführen: <code>sudo bash pdh-cloudflared.sh</code> bzw. in einer PowerShell als Administrator <code>powershell -ExecutionPolicy Bypass -File .\pdh-cloudflared.ps1</code>.</li>
      <li>Im Reiter <b>Server</b> die <b>Öffentliche Adresse</b> auf <code>https://pdh.firma.de</code> setzen und im Reiter Cloudflare-Tunnel <b>Tunnel prüfen</b>.</li>
    </ol>
    Das Skript installiert <code>cloudflared</code>, richtet es als Dienst ein (startet mit dem Server) und ersetzt einen vorhandenen Tunnel-Dienst. Es enthält den Token – nach der Einrichtung löschen. Ein neuer Token (z. B. nach „Refresh token“ im Dashboard): eintragen, Skript neu herunterladen und erneut ausführen.</div>
  <ul>
    <li><b>Passwörter und Schlüssel</b> werden nie angezeigt. Feld leer lassen = unverändert; „Wert entfernen“ löscht ihn.</li>
    <li><b>Datenbank</b>: Änderungen werden vor dem Speichern getestet. Nur wenn du sicher bist, „Trotzdem speichern“ anhaken.</li>
    <li><b>Sicherheit</b>: „Neuen Anmelde-Schlüssel erzeugen“ meldet nach dem Neustart alle Benutzer ab. Den Schlüssel für Portal-Passwörter nach dem ersten Gebrauch nicht mehr ändern.</li>
    <li>Jede Änderung meldet „Service“ per Chat an alle Administratoren (ohne die Werte selbst).</li>
  </ul>
  <h3><i class="ti ti-color-swatch"></i> Erscheinungsbild: Farbschema, Design-Stil, Schrift &amp; Größe</h3>
  <p>Im Reiter <b>Erscheinungsbild</b> legst du oben den <b>Firmenstandard</b> fest: Farbschema, Design-Stil, Schriftart und Größe. Jeder Benutzer kann im Benutzermenü davon abweichen und das an seinem Konto speichern; Hell oder Dunkel wählt ohnehin jeder selbst – jedes Schema hat Farben für beide.</p>
  {{template "hb-fig-theme"}}
  <table>
    <tr><td><b>Vorlagen</b></td><td>PDH-Blau (Standard), Petrol, Industriegrün, Signalorange, Bordeaux, Violett, Anthrazit – geprüft gut lesbar in Hell und Dunkel</td></tr>
    <tr><td><b>Firmenfarbe</b></td><td>eine eigene Farbe (z. B. aus dem Firmenlogo). Das PDH passt die Helligkeit je Modus automatisch an, damit Schrift und Schaltflächen lesbar bleiben.</td></tr>
    <tr><td><b>Home Assistant</b></td><td>aus der Theme-Galerie oder per Datei übernommene Themes (z. B. Nordic, Metro, iOS) – mit Hintergrund-, Karten-, Text- und Rahmenfarben</td></tr>
    <tr><td><b>Design-Stil</b></td><td><b>Fiori</b> (Standard) wie SAP: weiße Kopfleiste und Navigation, Karten mit Schatten, Knöpfe mit blauer Schrift, durchgehend unterstrichene Reiter. <b>Fluent</b> wie Windows 11: Navigation und Kopfzeile auf grauem Grund, feine Linien, kleine Ecken. Das Farbschema gilt in beiden Stilen. Der Stil wirkt auch auf Anmeldeseite, Easy-Mode und Leitstand.</td></tr>
    <tr><td><b>Schriftart</b></td><td>DM Sans (Standard), System, Inter, Roboto (wie Home Assistant), Atkinson Hyperlegible (besonders gut lesbar), Source Sans 3, Verdana</td></tr>
    <tr><td><b>Größe</b></td><td>70 bis 160 % – vergrößert die ganze Oberfläche, z. B. 120 % für Terminals oder Tablets in der Halle</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-color-swatch"></i> So stellst du das Firmen-Farbschema ein</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>, Karte <b>Farbschema, Design-Stil &amp; Schrift</b>.</li>
      <li>Ein Schema antippen – oder bei <b>Firmenfarbe</b> auf das Farbfeld klicken und eine Farbe wählen. Darunter <b>Design-Stil</b>, <b>Schriftart</b> und <b>Größe</b> wählen. Die Seite zeigt alles sofort zur Probe.</li>
      <li>Mit <b>Benutzer dürfen … ein eigenes Farbschema, einen eigenen Design-Stil und eine eigene Schrift wählen</b> legst du fest, ob jeder im Benutzermenü umstellen darf. Die Größe darf jeder anpassen.</li>
      <li><b>Speichern</b> – ab dem nächsten Seitenaufruf sehen alle, die nichts Eigenes gespeichert haben, den neuen Standard (auch auf der Anmeldeseite).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-layout-grid"></i> So nimmst du ein Theme aus der Galerie (am einfachsten)</b>
    <ol class="hb-steps">
      <li><b>Erscheinungsbild</b> → Karte <b>Theme-Galerie aus Home Assistant</b>. Dort liegen bekannte Community-Themes bereit: <b>Nordic</b>, <b>Caule Themes Pack</b>, <b>iOS Themes</b> und <b>Metro &amp; Fluent</b>.</li>
      <li>Eine Familie aufklappen. Jede Kachel zeigt links die dunkle, rechts die helle Variante.</li>
      <li><b>Übernehmen</b> legt das Theme oben bei den Farbschemata ab (für die Auswahl der Benutzer). <b>Als Standard</b> übernimmt es und macht es sofort zum Firmenstandard.</li>
    </ol>
    Die Farben sind bereits ausgelesen – es wird nichts aus dem Internet geladen. Urheber und Quelle stehen bei jeder Familie.</div>
  <div class="hb-howto"><b><i class="ti ti-home"></i> So übernimmst du ein eigenes Theme aus Home Assistant</b>
    <ol class="hb-steps">
      <li>In Home Assistant die Theme-Datei holen: im Konfigurationsordner unter <code>themes/</code>, z. B. <code>themes/nordic/nordic.yaml</code> (per Datei-Editor, Samba oder Studio Code Server).</li>
      <li>Im PDH unter <b>Erscheinungsbild → Theme aus Home Assistant übernehmen</b> die Datei wählen – oder ihren Inhalt in das Textfeld einfügen – und <b>Übernehmen</b>.</li>
      <li>Das Theme erscheint oben bei den Farbschemata (Hinweis „aus Home Assistant“). Antippen und <b>Speichern</b>, um es zum Firmenstandard zu machen.</li>
    </ol>
    Hat das Theme getrennte Farben für Hell und Dunkel (<code>modes: light/dark</code>), werden beide übernommen. Hat es nur einen Satz Farben, gilt er für den passenden Modus; im anderen Modus kommen nur die Akzentfarben mit. Schriften, Rundungen, Zustandsfarben und card-mod werden nicht übernommen. Eine erneute Übernahme mit gleichem Namen ersetzt das Theme; <b>Entfernen</b> löscht es (war es Firmenstandard, gilt wieder PDH-Blau).</div>
  <h3 id="timeline-style"><i class="ti ti-timeline"></i> Erscheinungsbild: Zeitstrahl</h3>
  <p>In allen Zeitstrahlen – <b>Dashboard</b>, <b>Leitstand</b> und <b>Projekte</b> – stehen offene und laufende Vorgänge als einzelne Balken. Erledigte fasst ein <b>Sammler „✓ Erledigt (Anzahl)“</b> ganz oben zusammen; ein Klick darauf zeigt sie einzeln, ein weiterer Klick klappt sie wieder zu (der Browser merkt sich das je Zeitstrahl).</p>
  <p>Der Rand eines Balkens zeigt, wie es um den Vorgang steht. Die Füllfarbe bleibt die Farbe der Vorgangsart bzw. der Aufgabe.</p>
  <div class="tl-legend" style="margin:6px 0 10px">
    <span class="tl-running"><i></i>läuft (in Bearbeitung) – gelb</span><span class="tl-due"><i></i>fällig – rot</span><span class="tl-overdue"><i></i>überfällig – roter, blinkender Rand</span>
    <span class="tl-unassigned"><i></i>nicht zugewiesen – lila</span><span class="tl-done"><i></i>beendet – grüner Rand, Balken ausgegraut</span>
  </div>
  <p>Treffen mehrere Zustände zu, gilt der wichtigste: <b>beendet</b> vor <b>überfällig</b> vor <b>fällig</b> vor <b>nicht zugewiesen</b> vor <b>läuft</b>. „Nicht zugewiesen“ heißt: weder eine Person noch eine Gruppe (bei Aufgaben: keine Beteiligten). Balken ohne echten Termin (geschätzt, blass) werden nie fällig oder überfällig. Wer Bewegung nicht verträgt (Systemeinstellung „Bewegung reduzieren“), sieht den überfälligen Rand ohne Blinken.</p>
  <div class="hb-howto"><b><i class="ti ti-timeline"></i> So stellst du den Zeitstrahl ein</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>, Karte <b>Zeitstrahl</b>.</li>
      <li>Je Zustand die <b>Farbe</b> wählen, dazu die Farbe, mit der beendete Balken <b>ausgegraut</b> werden.</li>
      <li><b>Randstärke</b> (0,5 – 6 px), <b>Randhelligkeit</b> (dunkler bis heller, wirkt auf alle Ränder) und <b>Balkenhöhe</b> (12 – 48 px) mit den Schiebern einstellen.</li>
      <li>Bei <b>„Fällig“ ab</b> festlegen, wie viele Tage vor dem Termin der rote Rand beginnt (Standard: heute und morgen).</li>
      <li>Die <b>Vorschau</b> zeigt sofort, wie es aussieht. <b>Speichern</b> – gilt für alle Benutzer und den Leitstand. <b>Standard</b> stellt die Vorgabe wieder her.</li>
    </ol></div>
  <h3><i class="ti ti-palette"></i> Erscheinungsbild: Name und Logos</h3>
  <p>Darunter legst du den Anzeigenamen und drei Logos fest:</p>
  <table>
    <tr><td><b>App-Logo</b></td><td>Seitenleiste, Anmeldeseite und Symbol im Browser-Tab (ohne eigenes Logo erscheint dort das blaue PDH-Symbol <img src="/favicon.svg" alt="" width="16" height="16" style="vertical-align:-3px">)</td></tr>
    <tr><td><b>Logo für Exporte</b></td><td>PDF-Exporte (oben rechts) und Excel-Exporte (neben der Tabelle)</td></tr>
    <tr><td><b>Logo für Druck</b></td><td>Kopfzeile jeder gedruckten Seite (mit Name, Seitentitel und Druckdatum), Bestellvorschlag-E-Mail und – wenn eingeschaltet – Lagerplatz-Etiketten</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-upload"></i> So setzt du das Firmenlogo</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>.</li>
      <li>Beim <b>App-Logo</b> eine PNG-, JPG- oder GIF-Datei wählen (max. 2 MB, am besten quadratisch mit transparentem Hintergrund) und <b>Hochladen</b>.</li>
      <li>Exporte und Druck verwenden es automatisch mit („wie App-Logo“). Für einen anderen Ausdruck – z. B. ein breites Schwarzweiß-Logo – dort ein eigenes Logo hochladen.</li>
    </ol>
    SVG-Dateien werden aus Sicherheitsgründen nicht angenommen. Die Logos gehören zur Datensicherung (Bestandteil „Anhänge &amp; Bilder“).</div>
  <h3><i class="ti ti-file-analytics"></i> Protokoll ansehen und filtern</h3>
  <p>Das PDH protokolliert ausführlich: jeden Seitenaufruf mit Benutzer, Dauer und Status, An- und Abmeldungen (auch fehlgeschlagene), Fehler sowie Datensicherung, Bereinigung, Einstellungsänderungen und Benachrichtigungen. Passwörter und Tokens in Adressen werden dabei unkenntlich gemacht, von RFID-Karten stehen nur die letzten 4 Zeichen im Protokoll.</p>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So findest du einen Fehler</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Protokoll ansehen</b> (Berechtigung <i>Server-Protokoll ansehen</i>, standardmäßig nur Administratoren).</li>
      <li>Oben die Kachel <b>Fehler (24 h)</b> antippen – oder Zeitraum, Stufe, Bereich, Benutzer, Pfad, HTTP-Status, Request-ID oder einen Suchbegriff wählen und <b>Filtern</b>.</li>
      <li>Eine Zeile antippen zeigt alle Details (IP, Browser, Abfrage, Fehlermeldung …). <b>Alle Einträge dieser Anfrage</b> zeigt, was während genau dieses Aufrufs passiert ist.</li>
      <li>Bereich oder Benutzer in einer Zeile antippen filtert direkt danach. <b>Live</b> aktualisiert die Liste alle 5 Sekunden.</li>
    </ol></div>
  <ul>
    <li><b>Bereiche:</b> <code>http</code> (Seitenaufrufe), <code>auth</code> (Anmeldungen), <code>backup</code>, <code>bereinigung</code>, <code>konfiguration</code>, <code>benachrichtigung</code>, <code>einrichtung</code>, <code>system</code> (Rest).</li>
    <li><b>Herunterladen:</b> die gefilterte Liste als CSV (für Excel) oder JSON, oder eine ganze Tagesdatei.</li>
    <li><b>Einstellungen</b> im Reiter <b>Protokoll</b>: Stufe (debug/info/warn/error), ob alle oder nur fehlerhafte Seitenaufrufe protokolliert werden, Aufbewahrung in Tagen und Ordner – sofort wirksam.</li>
  </ul>
  {{template "hb-shots" (dict "Ref" (index $s "server") "Can" $can)}}
</section>

<section class="hb-ch" id="versions" data-title="Versionen &amp; Updates" data-pages="core-settings">
  <h2><i class="ti ti-versions"></i> Versionen &amp; Updates</h2>
  <p>Die installierte Version steht links oben unter dem Namen (z. B. <b>v{{.CurrentVersion}}</b>). Jede Version hat eine Nummer <b>Haupt.Neben.Korrektur</b>: Die mittlere Zahl steigt mit neuen Funktionen, die letzte bei reinen Fehlerkorrekturen.</p>
  {{template "hb-fig-update"}}
  <div class="hb-howto"><b><i class="ti ti-download"></i> So installierst du ein Update</b>
    <ol class="hb-steps">
      <li><b>Core-Einstellungen</b> öffnen. Im Kasten <b>GitHub-Updates</b> siehst du die <b>installierte Version</b> und die <b>Version auf GitHub</b>. PDH prüft regelmäßig selbst (einstellbar); sofort geht es mit <b>Commit-Vergleich</b>.</li>
      <li>Ist ein Update da, listet <b>Neu in … Version(en)</b> alle Änderungen seit deiner Version – lies sie vor dem Installieren.</li>
      <li><b>Update installieren</b> klicken und bestätigen. Der Dienst startet neu; nach einer Minute die Seite neu laden.</li>
    </ol>
    Vor den Datenbank-Änderungen legt PDH automatisch eine Vollsicherung an (<a href="#backup">mehr</a>). Danach steht die neue Nummer in der Kopfzeile.<br>
    <b>Am Server von Hand:</b> nicht nur <code>git pull</code> – das holt die Dateien, baut das Programm aber nicht neu, und neue Seiten passen dann nicht zum alten Programm (z. B. „Template-Fehler … can't evaluate field …“). Richtig ist im PDH-Verzeichnis <code>sudo PDH_UPDATE_MODE=systemd bash install_update.sh</code> (bei Docker <code>PDH_UPDATE_MODE=docker</code>) – holt, baut und startet neu.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud"></i> So aktualisierst du Nextcloud</b>
    <ol class="hb-steps">
      <li><b>Core-Einstellungen</b> → Kachel <b>Nextcloud-Updates</b> (neben „GitHub-Updates“) → <b>Updates prüfen</b>. Die Kachel zeigt die installierte Version, ein verfügbares System-Update und alle App-Updates.</li>
      <li><b>Alle Apps aktualisieren</b> spielt die App-Updates ein – Nextcloud bleibt dabei erreichbar.</li>
      <li><b>System-Update (inkl. Apps)</b> aktualisiert Nextcloud selbst mit dem offiziellen Updater und danach die Apps. Nextcloud ist dabei einige Minuten im Wartungsmodus; vorher sollte eine Sicherung von Nextcloud bestehen.</li>
      <li>Den Fortschritt zeigt die Kachel nach dem Neuladen der Seite; danach erneut <b>Updates prüfen</b>.</li>
    </ol>
    Das klappt, wenn Nextcloud auf demselben Server wie das PDH läuft und der Update-Agent eingerichtet ist. Liegt Nextcloud woanders als in <code>/var/www/nextcloud</code>, das Verzeichnis in der Kachel eintragen.</div>
  <p><b>Ohne Versionsnummer auf GitHub:</b> Zeigt <b>Version auf GitHub</b> „nicht angegeben“, stammt der Stand auf GitHub aus der Zeit vor der Versionierung. Ob ein Update da ist, entscheidet dann weiter der Commit-Vergleich.</p>
  <h3>Änderungsprotokoll <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <p class="rec-sub">Was sich in welcher Version geändert hat – neueste zuerst. {{if .CurrentVersion}}Installiert ist Version {{.CurrentVersion}}.{{end}}</p>
  {{range $i, $r := .Releases}}
  <details class="hb-release"{{if lt $i 2}} open{{end}}>
    <summary><b>Version {{$r.Version}}</b>{{if $r.Date}} <span class="rec-sub">· {{$r.Date}}</span>{{end}}{{if eq $r.Version $.CurrentVersion}} <span class="hb-badge">installiert</span>{{end}}</summary>
    {{range $r.Sections}}<p style="margin:6px 0 2px"><b>{{.Title}}</b></p><ul>{{range .Items}}<li>{{.}}</li>{{end}}</ul>{{end}}
  </details>
  {{else}}<p class="rec-sub">Kein Änderungsprotokoll vorhanden.</p>{{end}}
  {{template "hb-shots" (dict "Ref" (index $s "versions") "Can" $can)}}
</section>

<section class="hb-ch" id="admin" data-title="Administration" data-pages="roles icons pki">
  <h2><i class="ti ti-settings"></i> Administration</h2>
  <ul>
    <li><b>Rollen &amp; Rechte</b> – was welche Rolle darf; Ausnahmen je Person unter Einzelrechte im Benutzerstamm.</li>
    <li><b>Core-Einstellungen</b> – Fristen, Updates (<a href="#versions">mehr</a>), Microsoft-365-Abgleich samt Nextcloud-Konten (<a href="#users">mehr</a>), Hersteller &amp; Lieferanten, Feldsätze.</li>
    <li><b>Import / Export</b> – Daten aus Maschinen und Systemen (MQTT, OPC UA, Modbus, SQL, Excel, Web) übernehmen und Exporte planen (<a href="#connections">mehr</a>).</li>
    <li><b>Drucker</b> – Etiketten- und Netzwerkdrucker einrichten, prüfen und testen (<a href="#printers">mehr</a>).</li>
    <li><b>Datensicherung</b> – Sicherungen, Zeitpläne und Wiederherstellung (<a href="#backup">mehr</a>).</li>
    <li><b>Bereinigung</b> – Löschvormerkungen prüfen und den Bereinigungslauf starten (<a href="#cleanup">mehr</a>).</li>
    <li><b>Kategorien</b> – Schlagworte für alle Module anlegen und pflegen (<a href="#categories">mehr</a>).</li>
  </ul>
  <p>Server-Einstellungen wie Datenbank, E-Mail, Microsoft 365 oder Nextcloud pflegst du unter <b>Server-Einstellungen</b> (<a href="#server">mehr</a>) – die <code>.env</code>-Datei muss dafür niemand mehr von Hand bearbeiten.</p>
  <h3>Berechtigungen <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  {{range .PermGroups}}
  <p style="margin-top:8px"><b>{{.Category}}</b></p>
  <ul>{{range .Items}}<li>{{.Label}} <code>{{.Key}}</code></li>{{end}}</ul>
  {{else}}<p class="rec-sub">Berechtigungen konnten nicht geladen werden.</p>{{end}}
  {{if $can}}<p class="rec-sub hb-shot-tools"><i class="ti ti-photo-plus"></i> Als Administrator kannst du unter jedem Kapitel eigene Bildschirmfotos hinzufügen – so wird das Handbuch zu eurem Handbuch.</p>{{end}}
  <h3 id="icons"><i class="ti ti-icons"></i> Symbole anpassen</h3>
  <p>Alle Symbole kommen aus einer Bibliothek mit rund 5.900 Symbolen (Tabler Icons), die der PDH-Server selbst ausliefert – es wird nichts aus dem Internet nachgeladen, PDH sieht also auch ohne Internetzugang vollständig aus. Unter <b>Verwaltung → Symbole</b> legst du fest, welches Symbol wofür steht: Navigation, Vorgangsarten und Datensätze, Anlagentypen, Lagertypen, IT-Typen und Knöpfe.</p>
  <div class="hb-howto"><b><i class="ti ti-icons"></i> So tauschst du ein Symbol aus</b>
    <ol class="hb-steps">
      <li><b>Verwaltung → Symbole</b> öffnen (nur Administratoren).</li>
      <li>Auf das Symbol links neben dem Eintrag klicken – die Auswahl öffnet sich. Suchbegriff eintippen (englisch, z. B. <i>tool</i>, <i>factory</i>, <i>plug</i>) und das passende Symbol anklicken. Wer den Namen kennt, trägt ihn direkt ins Feld ein.</li>
      <li><b>Speichern</b> – die Änderung gilt sofort für alle. <i class="ti ti-restore"></i> setzt einen Eintrag auf die Vorgabe zurück, <b>Alles zurücksetzen</b> alle.</li>
    </ol>
    Geänderte Einträge sind farbig umrandet. In Auswahllisten (Ausklapplisten) zeigen Browser keine Symbole – dort steht nur der Name.</div>
  <div class="hb-howto"><b><i class="ti ti-code"></i> Für Administratoren: Code-Editor (code-server)</b>Unter <b>Core-Einstellungen → Code-Editor</b> öffnet sich VS Code im Browser mit dem PDH-Quellcode, unter derselben Adresse wie das PDH: <code>…/code/</code>, z. B. <code>https://pdh.strobl-home.net/code/</code>.
    <ol class="hb-steps">
      <li>Als Administrator im PDH anmelden. Ein eigenes Passwort für den Editor gibt es nicht – die PDH-Anmeldung gilt.</li>
      <li><b>Core-Einstellungen → Code-Editor (code-server)</b>. Der Editor öffnet sich in einem neuen Tab mit dem Ordner <code>/workspace/pdh</code>.</li>
      <li>Dateien bearbeiten wie in VS Code. Unter <b>Terminal → Neues Terminal</b> stehen <code>go</code>, <code>git</code> und <code>make</code> bereit, z. B. <code>go test ./...</code>.</li>
    </ol>
    Andere Rollen kommen nicht hinein. Das Terminal läuft mit vollen Rechten im Container und sieht den Quellcode des Servers – Änderungen wirken erst nach einem Update bzw. Neubau. Git: Name und E-Mail einmalig im Terminal setzen (<code>git config --global user.name …</code>). <b>Einrichten:</b> bei der Docker-Installation automatisch mit dem Update; bei der Installation ohne Docker (systemd) einmalig auf dem Server im PDH-Verzeichnis <code>sudo bash scripts/install-code-server.sh</code> ausführen – danach baut jedes Update den Editor mit. Abschalten: <code>sudo bash scripts/install-code-server.sh --remove</code>. Steht nginx vor dem PDH und meldet der Editor <i>„WebSocket close with status code 1006“</i>, einmalig <code>sudo bash scripts/configure-pdh-nginx-websockets.sh</code> ausführen.</div>
  <div class="hb-howto"><b><i class="ti ti-route"></i> Für Administratoren: n8n und pgAdmin unter der PDH-Adresse</b>n8n (Automatisierung) und pgAdmin (Datenbank) laufen auf dem Server als eigene Container und sind über das PDH erreichbar: <code>…/n8n/</code> und <code>…/pgadmin/</code>, verlinkt unter <b>Core-Einstellungen</b>.
    <ol class="hb-steps">
      <li>Auf dem Server im PDH-Verzeichnis <code>sudo bash scripts/configure-pdh-admin-tools.sh</code> ausführen. Das Skript findet die Container, trägt sie im PDH ein, richtet die WebSockets in nginx ein und startet das PDH neu.</li>
      <li>Meldet es, dass n8n noch nicht für <code>/n8n/</code> eingestellt ist: die angezeigten Zeilen (<code>N8N_PATH</code>, <code>WEBHOOK_URL</code> …) in die Compose-Datei von n8n übernehmen und dort <code>docker compose up -d</code>.</li>
      <li>Die alte Seite „code-server“ in nginx macht den Code-Editor <b>ohne PDH-Anmeldung</b> erreichbar. Abschalten mit <code>sudo bash scripts/configure-pdh-admin-tools.sh --disable-old-code-site</code> und im Cloudflare-Tunnel den alten Hostnamen entfernen.</li>
    </ol>
    Nur Administratoren kommen hinein. pgAdmin und n8n behalten zusätzlich ihre eigene Anmeldung. Solange Code-Editor, n8n oder pgAdmin in einem Tab offen sind, meldet das PDH Administratoren <b>nicht wegen Inaktivität ab</b> – auch wenn der PDH-Tab daneben unberührt bleibt. Erst etwa 10 Minuten nach dem Schließen der Werkzeug-Tabs gilt wieder die normale Abmeldezeit. Ausnahme sind die <b>Webhooks</b> von n8n (<code>…/n8n/webhook/…</code>): Sie sind ohne Anmeldung erreichbar, damit externe Dienste n8n aufrufen können.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> Für Administratoren: Zertifikate für Nextcloud</b>Unter <b>Core-Einstellungen → Zertifikate (Nextcloud)</b> stellt die eigene Zertifizierungsstelle des PDH drei Arten aus, jeweils als passwortgeschützte <b>.p12</b>:
    <ul>
      <li><b>Persönlich (Nextcloud-App)</b> – je Person und Gerät. Mit eingeschalteter <b>Selbstbedienung</b> stellen die Mitarbeitenden sie unter Mein Konto selbst aus.</li>
      <li><b>Gerät / Firma</b> – ein Zertifikat für mehrere Geräte. Sperren trifft alle zugleich.</li>
      <li><b>Server (Nextcloud)</b> – für Nextcloud unter eigenem Namen oder eigener IP im Firmennetz. <b>Kette</b> und <b>Schlüssel</b> in nginx eintragen; auf den Geräten einmal die CA installieren (<code>…/pki/ca.crt</code>).</li>
    </ul>
    <ol class="hb-steps">
      <li>Damit nginx nur Geräte mit Zertifikat hereinlässt, auf dem Nextcloud-Server einmalig <code>sudo bash scripts/configure-nextcloud-client-certs.sh --site /etc/nginx/sites-available/nextcloud</code> ausführen. Zugriffe über den Cloudflare-Tunnel und vom PDH selbst sind ausgenommen.</li>
      <li>Zertifikate ausstellen bzw. ausstellen lassen, auf den Geräten einrichten (siehe „So richtest du die Nextcloud-App mit Zertifikat ein“ im Kapitel <a href="#users">Benutzer</a>).</li>
      <li>Verlorene Geräte: Zertifikat <b>sperren</b>. nginx holt die Sperrliste alle 6 Stunden, sofort mit <code>sudo systemctl start pdh-pki-crl</code>.</li>
    </ol>
    Die ausführliche Anleitung mit Cloudflare, Server-Zertifikat und Fehlersuche steht in <code>docs/nextcloud-zertifikate.md</code>. Achtung: Die Zertifizierungsstelle hängt am Geheimnis <code>PDH_AUTH_JWTSECRET</code>; wird es geändert, müssen alle Zertifikate neu ausgestellt werden.</div>
  {{template "hb-shots" (dict "Ref" (index $s "admin") "Can" $can)}}
</section>

<section class="hb-ch" id="statistics" data-title="Statistik (Grafana)" data-pages="statistics">
  <h2><i class="ti ti-chart-histogram"></i> Statistik (Grafana)</h2>
  <p>Unter <b>Navigation → Statistik</b> stehen große Kacheln. Jede öffnet ein Auswertungs-Dashboard aus Grafana – direkt im PDH oder in einem neuen Tab. Oben wechselst du mit den Schaltflächen zwischen den Dashboards; <i class="ti ti-maximize"></i> schaltet auf Vollbild. Dafür brauchst du das Recht <i>Statistik (Grafana-Dashboards) ansehen</i>.</p>
  <p>Mitgeliefert ist das Dashboard <b>PDH Übersicht</b>: offene Störungen und Tickets, neue Störungen je Woche, Störungen je Anlage, gebuchte Stunden je Kostenstelle, Tätigkeit und Art.</p>
  <div class="hb-howto"><b><i class="ti ti-layout-grid"></i> So fügst du eine Kachel hinzu (Administratoren)</b>
    <ol class="hb-steps">
      <li>In Grafana das gewünschte Dashboard öffnen und die Adresse aus der Browserzeile kopieren.</li>
      <li>Im PDH: <b>Core-Einstellungen → Grafana &amp; Statistik → Dashboard hinzufügen</b>.</li>
      <li><b>Titel</b>, optional Untertitel, und die <b>Adresse</b> einfügen. Ein Pfad wie <code>/d/abc123/name</code> genügt, wenn oben die Grafana-Adresse stimmt.</li>
      <li><b>Symbol</b> und <b>Farbe</b> antippen – die Vorschau zeigt die Kachel. <b>Kiosk-Ansicht</b> blendet die Grafana-Menüs aus; <b>Automatisch aktualisieren</b> lädt die Werte z. B. alle 5 Minuten neu.</li>
      <li><b>Speichern</b>. Mit <i class="ti ti-chevron-up"></i>/<i class="ti ti-chevron-down"></i> die Reihenfolge der Kacheln ändern, mit <i class="ti ti-eye-off"></i> ausblenden.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> Grafana-Adresse und Anmeldung</b>
    Bei der Docker-Installation läuft Grafana <b>hinter dem PDH</b> unter <code>/grafana/</code> – gleiche Adresse und gleiches HTTPS wie das PDH, auch über den Cloudflare-Tunnel. Angemeldet ist man automatisch mit dem PDH-Konto: PDH-Administratoren sind in Grafana Admin, wer Kostenstellen verwaltet ist Editor, alle anderen dürfen nur ansehen. Unter Core → Grafana bleibt die Adresse deshalb leer; der grüne Punkt zeigt, ob Grafana läuft. Ein separates Grafana lässt sich dort als Adresse eintragen.<br><b>Installation ohne Docker (systemd):</b> Grafana einmalig auf dem Server einrichten – im PDH-Verzeichnis <code>sudo bash scripts/install-grafana.sh</code>. Das Skript startet Grafana als lokalen Container, legt den Nur-Lese-Benutzer an und verbindet es mit dem PDH.</div>
  <p>Notfall-Zugang direkt am Server: <code>http://127.0.0.1:3000/grafana/</code>, Benutzer <code>admin</code>, Passwort <code>PDH_GRAFANA_ADMIN_PASSWORD</code> aus <code>.env.docker</code>. Von außen ist Port 3000 bewusst nicht erreichbar. Grafana liest die PDH-Daten nur und sieht keine Passwörter oder Schlüssel.</p>
  {{template "hb-shots" (dict "Ref" (index $s "statistics") "Can" $can)}}
</section>

<section class="hb-ch" id="connections" data-title="Import, Export &amp; Verbindungsseite" data-pages="import export">
  <h2><i class="ti ti-database-import"></i> Import, Export &amp; Verbindungsseite</h2>
  <p>Eine <b>Verbindung</b> ist der Zugang zu einer Maschine oder einem System (MQTT, OPC UA, Modbus, SQL, Excel/CSV, Web/REST). Ein Klick auf den Namen in der Liste unter <b>Import</b> bzw. <b>Export</b> öffnet ihre eigene Seite mit den Reitern:</p>
  <ul>
    <li><b>Übersicht</b> – Einstellungen (Passwörter und Schlüssel werden nie angezeigt), Zustand der letzten Prüfung und was im Hintergrund läuft.</li>
    <li><b>Prüfungen</b> – <b>Jetzt prüfen</b> testet Pflichtangaben, Erreichbarkeit im Netz, TLS-Zertifikat, Anmeldung bzw. Datei, jede Abfrage, Zuordnungen ohne oder mit veraltetem Wert und ob die Hintergrund-Abrufe laufen. Fehler stehen mit Grund in der Tabelle.</li>
    <li><b>Abfragen</b> (nur Import) – beliebig viele benannte Abfragen je Verbindung: ein SQL-SELECT, ein Web-Endpunkt, ein Modbus-Registerblock, eine OPC-UA-Knotenliste oder eine Excel-/CSV-Zeile. Jede kann <b>automatisch alle … Minuten</b> laufen. MQTT liefert Werte von selbst und braucht keine Abfragen.</li>
    <li><b>Zuordnungen</b> bzw. <b>Felder</b> – welcher Wert zu welcher Anlage gehört, mit letztem Wert und Zeitpunkt.</li>
    <li><b>Vorlagen</b> – Abfragen und Zuordnungen einer Verbindung als Vorlage speichern und auf eine andere Verbindung desselben Typs anwenden.</li>
    <li><b>Werkzeuge</b> – Vorschau, Sniffer, Knoten-Browser usw. der Verbindung.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-database-search"></i> So holst du einen Wert per Abfrage</b>
    <ol class="hb-steps">
      <li>Verbindung öffnen, Reiter <b>Abfragen</b>.</li>
      <li>Unten eine <b>Vorlage</b> „Übernehmen“ oder die Abfrage selbst eintragen. Platzhalter in &lt;spitzen Klammern&gt; durch eure Namen ersetzen.</li>
      <li>Ein Intervall eintragen (0 = nur von Hand) und <b>Speichern &amp; ausführen</b>. Das Ergebnis erscheint als Tabelle.</li>
      <li>Neben der gewünschten Spalte auf <i class="ti ti-map-pin"></i> klicken und die Anlage wählen. Zugeordnet wird die erste bzw. letzte Zeile des Ergebnisses.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> Mehrere gleiche Maschinen</b>Eine Maschine fertig einrichten, im Reiter <b>Vorlagen</b> als Vorlage speichern und auf der Verbindungsseite der nächsten Maschine <b>anwenden</b>. Abfragen und Zuordnungen entstehen dort genauso; schon Vorhandenes wird nicht doppelt angelegt.</div>
  <p>Ansehen darf, wer Import bzw. Export sehen darf; prüfen und ausführen, wer ausführen darf; ändern, wer bearbeiten darf.</p>
  {{template "hb-shots" (dict "Ref" (index $s "connections") "Can" $can)}}
</section>

<section class="hb-ch" id="vpn" data-title="VPN ins Maschinennetz" data-pages="vpn">
  <h2><i class="ti ti-shield-lock"></i> VPN ins Maschinennetz</h2>
  <p>Über <b>VPN Maschinennetz</b> (Navigation → Material &amp; Anlagen) kommst du mit Laptop oder Handy von unterwegs ins Maschinennetz – z. B. um mit dem TIA-Portal auf eine Steuerung zu schauen. PDH nutzt dafür <b>WireGuard</b>, das direkt auf dem Server läuft. PDH kann dabei beides sein:</p>
  <ul>
    <li><b>Einwahl-Server:</b> Deine Geräte und die <b>Standort-Gateways</b> (Router im Maschinennetz, z. B. Teltonika, mGuard, eWON) wählen sich bei PDH ein. PDH verbindet beide – am Router muss kein Port offen sein.</li>
    <li><b>Client:</b> Ist im Maschinennetz schon ein WireGuard-Server, verbindet sich PDH als <b>ausgehender Tunnel</b> dorthin. Eingewählte Geräte erreichen die Netze dahinter ebenfalls.</li>
  </ul>
  <p>Eingewählte Geräte erreichen nur die Netze der Gateways und Tunnel, nicht einander. Oben rechts siehst du, ob das VPN läuft.</p>
  <div class="hb-howto" id="hb-vpn-status"><b><i class="ti ti-activity"></i> Steht die Verbindung?</b>
    Jedes Gerät, jedes Gateway und jeder Tunnel zeigt seinen Zustand – die Anzeige aktualisiert sich alle 10 Sekunden von selbst:
    <ul>
      <li><b style="color:var(--green)">verbunden</b> – in den letzten 3 Minuten Kontakt, dazu Absender-Adresse und Datenmenge.</li>
      <li><b style="color:var(--amber)">getrennt – letzter Kontakt vor …</b> – war verbunden, meldet sich aber nicht mehr (Gerät aus, Tunnel in der App beendet, Router nicht erreichbar).</li>
      <li><b style="color:var(--amber)">keine Antwort vom Server</b> – ein Tunnel zum Maschinennetz kommt nicht zustande: Endpunkt, Schlüssel und Freigabe am entfernten Server prüfen.</li>
      <li><b>noch nie verbunden</b> · <b>deaktiviert</b> · <b style="color:var(--red)">gesperrt</b>.</li>
    </ul>
    Oben steht die Zusammenfassung, z. B. „Tunnel 1/1 verbunden · Geräte 3/12 verbunden“. WireGuard meldet einen Abbruch nicht sofort: Erst nach etwa 3 Minuten ohne Kontakt gilt eine Verbindung als getrennt.</div>
  <div class="hb-howto" id="hb-vpn-toggle"><b><i class="ti ti-player-pause"></i> So aktivierst bzw. deaktivierst du eine Verbindung</b>
    <ol class="hb-steps">
      <li>Am Gerät, Gateway oder Tunnel auf <b>Deaktivieren</b> tippen – die Verbindung wird sofort getrennt, der Eintrag ist grau.</li>
      <li>Zum Wiederherstellen <b>Aktivieren</b> – nach wenigen Sekunden steht die Verbindung wieder.</li>
    </ol>
    Anders als <b>Sperren</b> bleiben Schlüssel und Konfiguration gültig; auf den Geräten und am Router muss nichts geändert werden. Eigene Geräte kann jede/r selbst (de)aktivieren, alles andere die Administration unter <b>Server-Einstellungen → VPN</b>. Jede Änderung steht im Protokoll.</div>
  <div class="hb-howto"><b><i class="ti ti-device-laptop"></i> So richtest du dein Gerät ein</b>
    <ol class="hb-steps">
      <li><b>VPN Maschinennetz</b> öffnen → unter <b>Meine Geräte</b> einen Namen eintragen, z. B. „Laptop Service“ → <b>Zugang anlegen</b>.</li>
      <li>Die App <b>WireGuard</b> installieren (App Store, Play Store oder wireguard.com).</li>
      <li>Handy: in der App <b>+</b> → <b>QR-Code scannen</b>. Laptop: <b>.conf herunterladen</b> und in der App <b>Tunnel aus Datei importieren</b>.</li>
      <li>Tunnel aktivieren. Die Steuerungen erreichst du jetzt unter ihren normalen Adressen im Maschinennetz.</li>
    </ol>
    Für jedes Gerät einen eigenen Zugang anlegen (höchstens 5). Geht ein Gerät verloren, den Zugang sofort <b>sperren</b> – die Verbindung bricht sofort ab. Kommen neue Netze dazu, die Konfiguration neu laden.</div>
  <div class="hb-howto" id="hb-vpn-setup"><b><i class="ti ti-settings"></i> So richtest du das VPN ein (nur Administratoren)</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → Reiter <b>VPN</b> öffnen. Den <b>öffentlichen Namen oder die IP</b> des Servers eintragen, UDP-Port (Standard 51820) und VPN-Netz prüfen → <b>Speichern</b> (noch ausgeschaltet lassen).</li>
      <li><b>Installationsskript für Linux</b> herunterladen, auf den Server kopieren und dort <code>sudo bash pdh-wireguard.sh</code> ausführen. Es installiert <code>wireguard-tools</code>, richtet den systemd-Dienst <code>pdh-wireguard</code> ein und öffnet den Port in ufw bzw. firewalld.</li>
      <li>Im Internet-Router den <b>UDP-Port</b> auf den Server weiterleiten und im Reiter <b>VPN</b> auf <b>eingeschaltet</b> stellen.</li>
      <li><b>Standort-Gateway</b> anlegen: Name und <b>Netze dahinter</b> (z. B. 192.168.10.0/24). Die angezeigte Konfiguration am Router als WireGuard-Schnittstelle einspielen, Weiterleitung ins LAN ohne NAT erlauben.</li>
      <li>Oder einen <b>Tunnel zum Maschinennetz</b> anlegen (siehe unten).</li>
    </ol>
    Nach einem PDH-Update oder einer Änderung des Ports das Installationsskript erneut ausführen. Unter <b>Alle Geräte</b> legst du Zugänge für andere an und sperrst sie; gesperrte Einträge lassen sich danach löschen. Das <b>Protokoll</b> zeigt, wer wann einen Zugang angelegt, angezeigt, heruntergeladen, gesperrt oder die Einstellungen geändert hat.</div>
  <div class="hb-howto" id="hb-vpn-import"><b><i class="ti ti-file-import"></i> So importierst du den Tunnel zum Maschinennetz</b>
    <ol class="hb-steps">
      <li>Am Router bzw. WireGuard-Server im Maschinennetz (mGuard, Teltonika, FRITZ!Box …) einen WireGuard-Zugang für PDH anlegen und dessen Konfiguration als <b>.conf</b> exportieren.</li>
      <li>Einmal das <b>Installationsskript</b> auf dem Server ausführen (siehe oben, Schritt 2). Den Rest der Einrichtung – öffentlicher Name, Port, <b>eingeschaltet</b> – braucht ein Tunnel <b>nicht</b>; das ist nur für Geräte und Gateways nötig, die sich bei PDH einwählen.</li>
      <li><b>Server-Einstellungen</b> → <b>VPN</b> → <b>Tunnel zum Maschinennetz</b> → <b>WireGuard-Konfiguration importieren</b>.</li>
      <li>Namen eintragen und die <b>.conf-Datei wählen</b> (oder ins Feld ziehen bzw. den Inhalt einfügen). <b>Prüfen</b> zeigt Endpunkt, Tunneladresse und Netze.</li>
      <li>Leitet die Konfiguration alles durch den Tunnel (<code>0.0.0.0/0</code>), unter <b>Netze dahinter</b> die Netze im Maschinennetz angeben, z. B. 192.168.20.0/24 → <b>Tunnel anlegen</b>.</li>
    </ol>
    PDH verbindet sich sofort. Erzeugt der Router später neue Schlüssel, am Tunnel <b>Neue Konfiguration einspielen</b> – Name und Protokoll bleiben. Eine DNS-Angabe in der Datei wird nicht übernommen.</div>
  <div class="hb-howto" id="hb-vpn-users"><b><i class="ti ti-users-plus"></i> So erstellst du Konfigurationen für die Benutzer</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → <b>VPN</b> → <b>Alle Geräte</b> → <b>Konfigurationen für Benutzer erstellen</b>.</li>
      <li>Gerätenamen eintragen (z. B. „Laptop“) und die <b>Personen anhaken</b> – das Suchfeld filtert, „alle angezeigten wählen“ hakt alle Treffer an.</li>
      <li><b>Zugänge erstellen</b>. Jede Person bekommt einen eigenen Zugang mit eigener Adresse und eigenen Schlüsseln.</li>
      <li><b>Alle als ZIP herunterladen</b>: je Person ein Ordner mit der .conf-Datei. Einzeln geht es über <b>Konfiguration</b> am Gerät, mit QR-Code fürs Handy.</li>
    </ol>
    Die Konfigurationen enthalten die privaten Schlüssel – nur auf sicherem Weg weitergeben. Wer das Recht „VPN nutzen“ hat, kann seine Konfiguration auch selbst unter <b>VPN Maschinennetz</b> laden. Die Netze der Gateways und Tunnel stehen in jeder Konfiguration; kommen neue dazu, die Konfiguration neu laden.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer darf was?</b>
    <ul>
      <li><b>VPN: eigene Zugänge ins Maschinennetz anlegen und nutzen</b> – eigene Geräte auf der Seite <b>VPN Maschinennetz</b> anlegen, Konfiguration laden, sperren. Anfangs nur Administratoren und Anlagenverantwortliche; weitere Rollen unter <b>Rollen &amp; Rechte</b>.</li>
      <li><b>Einrichtung</b> (Einstellungen, Gateways, ausgehende Tunnel, alle Geräte, Protokoll) – nur Administratoren mit dem Recht auf die <b>Server-Einstellungen</b>.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn das VPN nicht läuft</b>
    <ul>
      <li><b>„Dienst pdh-wireguard meldet sich nicht“:</b> Das Installationsskript wurde noch nicht ausgeführt oder der Dienst ist gestoppt – auf dem Server <code>systemctl status pdh-wireguard</code> und <code>journalctl -u pdh-wireguard</code> prüfen.</li>
      <li><b>„Ordner … nicht beschreibbar“:</b> Das Installationsskript (erneut) ausführen – es legt den Austauschordner mit den richtigen Rechten an.</li>
      <li><b>„WireGuard fehlt im Kernel“:</b> Der Server braucht Linux ab 5.6 (z. B. Ubuntu 22.04/24.04, Debian 12).</li>
      <li><b>„… überschneidet das Netz des Servers“:</b> Ein Netz hinter einem Gateway oder Tunnel (oder das VPN-Netz) liegt im LAN oder in einem Docker-Netz des Servers. Anderes VPN-Netz wählen bzw. die Netze genauer angeben. Das PDH-Docker-Netz liegt fest auf <code>172.31.254.0/24</code>; kollidiert gerade das, in <code>.env.docker</code> z. B. <code>PDH_DOCKER_SUBNET=172.30.254.0/24</code> eintragen und das Update erneut ausführen. Das Docker-Standardnetz <code>docker0</code> (<code>172.17.0.0/16</code>) verlegt das Installationsskript nach <code>172.31.255.0/24</code> – bei Tunneln mit Adressen in 172.17.x das Skript einmal erneut ausführen (Docker und die PDH-Container starten dabei neu).</li>
      <li><b>Gerät verbindet sich nie:</b> UDP-Port im Internet-Router prüfen und ob der öffentliche Name auf die richtige Adresse zeigt.</li>
      <li><b>Verbunden, aber Steuerung nicht erreichbar:</b> Am Gateway die Weiterleitung ins LAN erlauben; die Geräte im Maschinennetz brauchen den Router als Gateway.</li>
    </ul></div>
  {{template "hb-shots" (dict "Ref" (index $s "vpn") "Can" $can)}}
</section>

<section class="hb-ch" id="ausfallschutz" data-title="Ausfallschutz &amp; Wiederaufbau" data-pages="server-config">
  <h2><i class="ti ti-shield-check"></i> Ausfallschutz &amp; Wiederaufbau</h2>
  <p>Fällt der Server aus, brennt ab oder wird versehentlich etwas gelöscht, lässt sich alles wiederherstellen. Der Server sichert dafür laufend auf ein <b>Netzlaufwerk</b>: die <b>Datenbank</b> (PDH und Nextcloud), alle <b>Dateien und Einstellungen</b> von PDH, Nextcloud und n8n. Das läuft im Hintergrund über den Update-Agenten – auch wenn das PDH selbst gerade nicht läuft.</p>
  {{template "hb-fig-ausfallschutz"}}
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So schaltest du den Ausfallschutz ein</b>
    <ol class="hb-steps">
      <li>Unter <b>Core-Einstellungen → Netzlaufwerke</b> eine Freigabe mit der Rolle <b>Datensicherung</b> anlegen – am besten auf einem anderen Gerät als dem Server.</li>
      <li><b>Server-Einstellungen → Ausfallschutz</b> öffnen, das Laufwerk wählen, <b>eingeschaltet</b> wählen und speichern.</li>
      <li>Beim ersten Einschalten startet die Datenbank einmal neu – das PDH ist wenige Sekunden nicht erreichbar.</li>
      <li>Nach wenigen Minuten zeigt der Reiter die erste Übertragung und die erste Grundsicherung.</li>
    </ol></div>
  <p><b>Wie aktuell ist die Sicherung?</b> Die Datenbank höchstens <b>5 Minuten</b> alt (einstellbar), Dateien höchstens so alt wie der Dateiabgleich (Standard 60 Minuten). Jede Nacht kommt eine Grundsicherung dazu; aufbewahrt wird 14 Tage (einstellbar). Gelöschte oder überschriebene Dateien landen so lange im <b>Papierkorb</b> auf dem Laufwerk. Nextcloud wird im laufenden Betrieb abgeglichen, n8n dafür kurz angehalten.</p>
  <p>Die Freigabe enthält Zugangsdaten (<code>.env</code>, Nextcloud-<code>config.php</code>) – nur Administratoren dürfen darauf zugreifen.</p>
  <p>Mit zwei Servern zeigt der Reiter auf dem passiven Server den Hinweis „Beobachtung: würde pausieren – …“. In dieser Version läuft die Sicherung trotzdem weiter (siehe <a href="#spiegelbetrieb">Ausfallschutz mit zwei Servern</a>).</p>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> So baust du den Server wieder auf</b>
    <ol class="hb-steps">
      <li>Frischen Ubuntu-Server oder eine neue VM bereitstellen.</li>
      <li><b>pdh-vm-prepare.sh</b> im Reiter herunterladen, auf die VM kopieren und ausführen: <code>sudo bash pdh-vm-prepare.sh --wiederaufbau --share //nas/sicherung --user BENUTZER</code>. Es setzt Zeitzone, Firewall und Gast-Agent (Proxmox, VMware, Hyper-V), fragt das Passwort ab und bindet die Freigabe dauerhaft unter <code>/mnt/sicherung</code> ein. Mit <code>--restore</code> startet es den Wiederaufbau gleich mit.</li>
      <li>Das Skript liegt im Sicherungsordner (oder im Reiter herunterladen): <code>sudo bash /mnt/sicherung/PDH-Ausfallschutz/&lt;server&gt;/pdh-restore.sh --from /mnt/sicherung/PDH-Ausfallschutz/&lt;server&gt;</code></li>
      <li>Für einen <b>früheren Stand</b> (z. B. vor einem versehentlichen Löschen) zusätzlich <code>--time "2026-10-24 14:30:00"</code> angeben.</li>
      <li>Danach VPN-Installationsskript erneut ausführen, Cloudflare-Tunnel prüfen und den Ausfallschutz auf dem neuen Server wieder einschalten. Den Ausfallschutz mit zwei Servern danach neu einrichten – seine Schlüssel werden nicht mitgesichert.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So richtest du einen ganz neuen Server ein</b>
    <ol class="hb-steps">
      <li>Frische Ubuntu-VM (22.04 oder 24.04) anlegen, <b>pdh-vm-prepare.sh</b> darauf kopieren.</li>
      <li><code>sudo bash pdh-vm-prepare.sh --neu --hostname pdh</code> – installiert Postgres, PDH und den Update-Agenten.</li>
      <li>Im Browser die angezeigte Adresse <code>http://…:8090/setup</code> öffnen und den Einrichtungscode eingeben.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-server"></i> VM-Sicherung</b>
    Läuft das PDH in einer VM, sollte zusätzlich der Hypervisor (z. B. Proxmox, Hyper-V) die ganze VM regelmäßig auf ein anderes Ziel sichern. Im Reiter das Datum der letzten VM-Sicherung eintragen – oder eine Datei auf dem Netzlaufwerk nennen, die die VM-Sicherung bei jedem Lauf aktualisiert. Ist sie älter als eingestellt (Standard 7 Tage), meldet das PDH es den Administratoren.</div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn etwas nicht stimmt</b>
    <ul>
      <li><b>„WAL-Dateien stauen sich“:</b> Das Netzlaufwerk ist nicht erreichbar oder voll. Die Änderungen warten auf dem Server und werden nachgeholt, sobald das Laufwerk wieder da ist.</li>
      <li><b>„Letzte Grundsicherung ist älter als 26 Stunden“:</b> Fehlermeldung im Reiter prüfen, „Grundsicherung jetzt“ anstoßen.</li>
      <li><b>„nur bei systemd-Installationen“:</b> Der Ausfallschutz läuft auf Produktivservern (systemd); im Docker-Testsystem ist er nicht verfügbar.</li>
      <li><b>„braucht die Datenbank auf diesem Server“:</b> Die Datenbank liegt auf einem anderen Rechner – dort muss sie gesichert werden.</li>
      <li><b>„Sicherungsordner … gehört einem anderen Server“:</b> Zwei Server mit gleichem Namen sichern auf dasselbe Laufwerk. Jeder Server braucht einen eigenen Namen (<code>sudo hostnamectl set-hostname …</code>), danach im Reiter „Speichern“ – er sichert dann in einen neuen Ordner und beginnt sofort mit einer Grundsicherung.</li>
      <li><b>„rsync endete mit Fehler 23“:</b> Einzelne Dateien ließen sich nicht sichern; dahinter steht die erste Datei samt Grund. Verweise, die auf ihren eigenen Ordner zeigen (z. B. <code>uploads/uploads</code>), lässt die Sicherung selbst aus.</li>
    </ul></div>
  {{template "hb-shots" (dict "Ref" (index $s "ausfallschutz") "Can" $can)}}
</section>

<section class="hb-ch" id="spiegelbetrieb" data-title="Ausfallschutz mit zwei Servern" data-pages="server-config">
  <h2><i class="ti ti-server-2"></i> Ausfallschutz mit zwei Servern</h2>
  <p>Ein zweiter Server und ein <b>Zeuge</b> beobachten sich gegenseitig. Der Dienst <code>pdh-ha</code> läuft auf jedem Server und prüft über das LAN und über WireGuard, ob der andere noch da ist. Der Zeuge ist ein kleiner dritter Teilnehmer ohne Daten – er hilft nur bei der Entscheidung, wer aktiv ist.</p>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> Was wirklich passiert – und was nur gemeldet wird</b>
    <ul>
      <li><b>Datenbank-Spiegel:</b> Ist er eingerichtet, schreibt der aktive Server jede Speicherung auch auf den passiven. Das läuft immer echt.</li>
      <li><b>Rollen tauschen</b> und <b>Übernahme erzwingen</b> wirken immer echt.</li>
      <li><b>Automatische Umschaltung</b> bei einem Ausfall: Standard ist <b>Beobachtung</b>. Der Dienst meldet dann nur „würde jetzt: …“, Rollen bleiben, wie sie sind. Auf <b>echt</b> lässt sie sich erst nach der Pflicht-Testumschaltung stellen.</li>
      <li>Der <b>Cloudflare-Tunnel</b> läuft nur auf dem aktiven Server und wechselt mit der Rolle – über die öffentliche Adresse erreichst du immer den aktiven Server. Die Adresse im LAN schaltet noch nicht mit um: Dort erreichst du das PDH nach einer Übernahme unter der Adresse des neuen aktiven Servers.</li>
    </ul></div>
  {{template "hb-fig-spiegelbetrieb"}}
  <p>Die <b>Betriebsart</b> ergibt sich aus der Zahl der Teilnehmer: <b>Einzel</b> (ein Server), <b>Duo</b> (zwei Server, „Eingeschränkter Ausfallschutz“) und <b>Trio</b> (zwei Server und ein Zeuge). Neue Verbünde starten mit <b>Automatik aus (Wartung)</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-network"></i> So stellst du feste IP-Adressen ein</b>
    <p>Die Server und der Zeuge kennen sich über ihre Adressen. Vergibt der Router per DHCP eine neue Adresse, finden sie sich nicht mehr. Deshalb jede Adresse fest einstellen – am besten, bevor der Verbund eingerichtet wird.</p>
    <ol class="hb-steps">
      <li>Auf jedem Server: <code>sudo bash /opt/pdh-server/scripts/pdh-static-ip.sh</code>. Das Skript zeigt die jetzige Adresse, das Gateway und die DNS-Server und fragt nach.</li>
      <li>Nach dem Bestätigen testet es die Einstellung: Ist die Verbindung noch da, <b>ENTER</b> drücken. Sonst geht nach 120 Sekunden alles automatisch zurück – auch über SSH ungefährlich.</li>
      <li>Im Router die Adresse aus dem DHCP-Bereich nehmen oder für den Server reservieren. Für den Zeugen-PC eine DHCP-Reservierung im Router anlegen.</li>
      <li>Netzlaufwerke (Freigaben) müssen von <b>beiden</b> Servern erreichbar sein – die Freigabe also für beide Adressen erlauben. Die Netzlaufwerk-Sicherung schaltet der neue aktive Server nach einer Übernahme nach etwa einer Minute selbst ein (eigener Ordner unter <code>PDH-Ausfallschutz/</code>, beginnend mit einer Grundsicherung).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-server-2"></i> So fügst du den zweiten Server hinzu</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Ausfallschutz</b> öffnen. Unter „Betriebsart“ die Adressen dieses Servers prüfen (LAN und WireGuard, du kannst sie ändern) und <b>Ausfallschutz einrichten</b> wählen. Beim ersten Einrichten startet das PDH dabei ggf. einmal kurz neu.</li>
      <li><b>Beitrittscode: zweiter Server</b> wählen. Der Code gilt 30 Minuten, nur einmal, und wird nur jetzt angezeigt.</li>
      <li><b>pdh-ha-join.sh</b> im Reiter herunterladen und auf den neuen Ubuntu-Server kopieren.</li>
      <li>Dort ausführen: <code>sudo bash pdh-ha-join.sh &lt;Code&gt;</code>. Das Skript holt den Quelltext von GitHub – der erste Server muss also eine dort veröffentlichte Version haben. Unter Ubuntu 22.04 ist das mitgelieferte Go zu alt (nötig: Go 1.21 oder neuer): vorher <code>sudo snap install go --classic</code> ausführen.</li>
      <li>Nach kurzer Zeit zeigt die Tabelle beide Server. Die Betriebsart steht auf <b>Duo</b>.</li>
      <li>Optional: <b>Automatik an</b> wählen. Dann trifft der Dienst Entscheidungen. Bei „Beobachtung“ zeigt er sie nur als Ereignis „würde jetzt: …“ an.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-database"></i> So richtest du den Datenbank-Spiegel ein</b>
    <ol class="hb-steps">
      <li>Den zweiten Server wie oben beitreten lassen – oder bei einem schon beigetretenen Server weitermachen.</li>
      <li>Auf dem zweiten Server ausführen: <code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt; --voll</code> (bei einem neuen Beitritt: <code>sudo bash pdh-ha-join.sh --voll &lt;Code&gt;</code>).</li>
      <li>Das Skript installiert PostgreSQL in derselben Version wie auf dem aktiven Server und das PDH-Programm. Dann kopiert es die Datenbank und die Einstellungen vom aktiven Server.</li>
      <li><b>Achtung:</b> Die Datenbank auf dem zweiten Server wird ersetzt. Liegen dort schon Datenbanken, zeigt das Skript sie an, sichert sie nach <code>/var/lib/pdh-ha/vorher</code> und fragt nach dem Hostnamen. Nur wer ihn eintippt, macht weiter.</li>
      <li>Im Reiter zeigt die Spalte <b>Datenbank</b> nun „schreibend“ und „Standby“, darunter „synchron“.</li>
      <li><b>Pflicht-Testumschaltung:</b> einmal <b>Rollen tauschen</b> und zurück. Prüfe dabei unter der Adresse des jeweils aktiven Servers, ob deine Daten da sind.</li>
    </ol>
    <p>Auf dem passiven Server läuft das PDH nicht. Das übernimmt <code>pdh-ha</code>: Es startet das PDH nur auf dem aktiven Server.</p></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-exchange"></i> So tauschst du die Rollen</b>
    <ol class="hb-steps">
      <li>Am <b>aktiven</b> Server <b>Rollen tauschen</b> wählen.</li>
      <li>Der aktive Server stellt die Datenbank auf „nur lesen“ und wartet, bis der passive alles hat (höchstens 60 Sekunden). Erst dann gibt er ab. Klappt das nicht, bricht der Tausch ab und nichts ändert sich.</li>
      <li>Das PDH ist für Sekunden nicht erreichbar und läuft danach auf dem anderen Server.</li>
    </ol>
    <p><b>Hinweis:</b> Hochgeladene Dateien werden noch nicht gespiegelt. Nach einem Tausch fehlen auf dem anderen Server neue Anhänge.</p></div>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> Synchron und asynchron</b>
    <ul>
      <li><b>Synchron</b> (Normalfall): Jede Speicherung liegt erst dann als gespeichert vor, wenn auch der passive Server sie hat. Es geht nichts verloren.</li>
      <li>Fällt der passive Server aus, <b>hängen Speicherungen</b> bis zu „asynchron nach“ (Standard 10 Sekunden). Dann schaltet der aktive Server auf <b>asynchron</b> und arbeitet weiter. Im Trio tut er das erst, wenn der Zeuge bestätigt hat, dass der passive Server jetzt <b>nicht aktuell</b> ist. Der Zeuge gibt ihm danach keine Stimme mehr.</li>
      <li>Kommt der passive Server zurück und hat aufgeholt, schaltet der aktive wieder auf synchron.</li>
      <li><b>Im Duo</b> (ohne Zeuge) bleibt ein Restrisiko: Fällt nur die Leitung zwischen den Servern aus und sehen beide noch das Gateway, können Speicherungen verloren gehen. Darum ist ein Zeuge empfohlen.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-git-fork"></i> Abgezweigte Daten prüfen</b>
    <p>Wurde eine Übernahme erzwungen, kann der alte Server Speicherungen haben, die der neue nicht kennt. Kommt er zurück, gliedert <code>pdh-ha</code> ihn als passiven Server ein – vorher sichert es diese Daten vollständig.</p>
    <ol class="hb-steps">
      <li>Im Reiter erscheint <b>Abgezweigte Daten</b> mit Zeitpunkt, Server und betroffenen Tabellen (z. B. „tickets: 3 neu“). Dazu kommt ein Alarm.</li>
      <li>Der Abzug liegt auf diesem Server unter <code>/var/lib/pdh-ha/abgezweigt/&lt;Eintrag&gt;/dump.sql.gz</code>.</li>
      <li>Zum Prüfen in eine eigene Datenbank einspielen, z. B. <code>sudo -u postgres createdb pruefung</code> und <code>zcat dump.sql.gz | sudo -u postgres psql pruefung</code>. Fehlende Einträge von Hand im PDH nachtragen.</li>
      <li>Danach im Reiter <b>GEPRÜFT</b> eintippen und <b>Geprüft – löschen</b> wählen. Automatisch wird nichts gelöscht.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-eye-check"></i> So fügst du einen Zeugen hinzu (Programm oder Container)</b>
    <ol class="hb-steps">
      <li>Erst den zweiten Server hinzufügen – ohne ihn wird der Zeuge abgelehnt („Zuerst den zweiten Server hinzufügen“).</li>
      <li><b>Beitrittscode: Zeuge</b> wählen.</li>
      <li><b>Als Programm</b> auf einem dritten Rechner: <code>sudo bash pdh-ha-join.sh --witness &lt;Code&gt;</code></li>
      <li><b>Als Container</b> (auf dem dritten Rechner, im PDH-Quelltext): im Ordner <code>deploy/ha-witness</code> ausführen: <code>PDH_HA_JOIN='&lt;Code&gt;' PDH_HA_ADDR=&lt;IP dieses Rechners&gt; docker compose up -d --build</code>. <code>PDH_HA_ADDR</code> ist die Adresse, unter der die Server den Zeugen erreichen (Port 7480) – ohne sie meldet der Container seine interne Adresse, die die Server nicht erreichen. Beide Angaben braucht nur der erste Start.<br><b>Unter Windows</b> (Docker Desktop, PowerShell) jeden Befehl einzeln eingeben: <code>$env:PDH_HA_JOIN='&lt;Code&gt;'</code>, <code>$env:PDH_HA_ADDR='&lt;IP dieses Rechners&gt;'</code>, <code>docker compose up -d --build</code>. Das Skript <code>pdh-ha-join.sh</code> ist nur für Linux. In der Windows-Firewall Port 7480 (TCP) für die Adressen beider Server freigeben.</li>
      <li>Die Betriebsart steht danach auf <b>Trio</b>, der Hinweis „kein Zeuge“ verschwindet.</li>
    </ol>
    <p><b>Wichtig:</b> Der Zeuge braucht <b>eigene Hardware und eigenen Strom</b>. Läuft er auf demselben Gerät oder an derselben Stromversorgung wie ein Server, fällt er mit aus – dann ist er wertlos. Erkennt das PDH gemeinsame Hardware, zeigt es eine Warnung.</p></div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> Nach einem PDH-Update</b>
    <p>Das Update des PDH bringt <code>pdh-ha</code> nur auf dem ersten Server auf den neuen Stand. Die Übersicht warnt dann „Versionen unterschiedlich“ und zeigt den passenden Befehl.</p>
    <ol class="hb-steps">
      <li>Den <b>Commit</b> des ersten Servers ablesen: in der Übersicht in Klammern hinter seiner Version, oder dort <code>pdh-ha version</code> ausführen.</li>
      <li><b>Zweiter Server</b> und <b>Zeugen-Rechner</b> (Programm): <code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt;</code></li>
      <li><b>Zeuge als Container</b>: im PDH-Quelltext auf denselben Stand gehen (<code>git fetch</code>, <code>git checkout &lt;Commit&gt;</code>), dann in <code>deploy/ha-witness</code> <code>PDH_HA_COMMIT=&lt;Commit&gt; docker compose up -d --build</code> (der Commit erscheint dann auch in der Übersicht). <code>PDH_HA_ADDR</code> und Code sind nicht nötig – sie liegen schon in den Volumes.</li>
      <li>Nach kurzer Zeit verschwindet die Warnung „Versionen unterschiedlich“.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-trash"></i> So entfernst du einen Server oder Zeugen</b>
    <ol class="hb-steps">
      <li>Das geht nur am ersten Server (dort, wo der Ausfallschutz eingerichtet wurde): Bereich <b>Knoten entfernen</b>.</li>
      <li>Den Zeugen <b>zuerst</b> entfernen. Solange ein Zeuge da ist, lässt sich kein Server entfernen.</li>
      <li>Der <b>aktive</b> Server lässt sich nicht entfernen. Erst <b>Rollen tauschen</b>, dann den bisherigen aktiven (jetzt passiven) Server entfernen.</li>
      <li>Ist der Server dauerhaft weg und nicht erreichbar, <b>dauerhaft weg</b> ankreuzen und <b>Entfernen</b> wählen.</li>
      <li>Einen entfernten Server wieder verwenden: dort <code>sudo pdh-ha reset --yes</code> ausführen und danach mit einem neuen Beitrittscode erneut beitreten. Bis dahin bleibt er inaktiv.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-details"></i> So liest du die Übersicht</b>
    <ul>
      <li><b>Rolle:</b> <i>aktiv</i> arbeitet, <i>passiv</i> wartet bereit, <i>abgeschaltet</i> hat sich selbst abgeschaltet, <i>wiedereingliederung</i> kommt gerade zurück, <i>zeuge</i> ist der Zeuge.</li>
      <li><b>Amtszeit:</b> Zähler, der bei jedem Wechsel des aktiven Servers steigt. Die höhere Amtszeit gilt.</li>
      <li><b>Wege:</b> Jeder Teilnehmer ist über LAN und WireGuard verbunden. Grün heißt: Nachrichten kommen an. Ist nur ein Weg rot, gilt der Partner noch als erreichbar.</li>
      <li><b>Gateway:</b> Zeigt, ob der Server sein Netz (Router) erreicht. „nein“ heißt: der Fehler liegt eher bei diesem Server als beim Partner.</li>
      <li><b>Zuletzt gesehen:</b> Wann zuletzt eine Nachricht kam. „Uhrzeit prüfen“ warnt, wenn die Uhren zu stark abweichen.</li>
      <li><b>Datenbank:</b> <i>schreibend</i> ist die Datenbank des aktiven Servers, darunter „synchron“ oder „asynchron“ und der Rückstand des Partners. <i>Standby</i> ist der Spiegel, „nicht aktuell“ heißt: ihm fehlen Speicherungen, er übernimmt nicht automatisch.</li>
      <li><b>Ereignisse:</b> „Rolle“ und „Info“ erklären, was passiert ist. <b>„würde jetzt: …“</b> ist eine automatische Entscheidung, die bei „Beobachtung“ nur gemeldet wird.</li>
      <li><b>Übernahme gesperrt: …</b> Die Automatik übernimmt solange nicht. Beispiel „Wartungsstand beim Partner noch nicht angekommen“: Der Partner hat das Ende der Wartung noch nicht gesehen, die Automatik wartet darauf. Ist der Partner wirklich weg, hilft <b>Übernahme erzwingen</b> (dazu <b>ÜBERNEHMEN</b> eintippen). Nur verwenden, wenn der aktive Server sicher aus ist – laufen beide als aktiv, können Daten verloren gehen.</li>
      <li><b>Knöpfe:</b> <i>Rollen tauschen</i> gibt es nur am aktiven Server, <i>Übernahme erzwingen</i> nur an einem nicht aktiven – und nur, solange der aktive Server nicht erreichbar ist. Ist er erreichbar, lehnt der Dienst ab: Dann am aktiven Server <i>Rollen tauschen</i> verwenden. Am Zeugen und an einem entfernten Server gibt es keine Befehle.</li>
      <li><b>Alarm „Aktiver Server abgelöst (neue Amtszeit …)“:</b> Der andere Server führt jetzt eine höhere Amtszeit – dieser gibt die Rolle ab und kommt als passiver Server zurück.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-clock"></i> Zeiten, Umschaltungen und Alarme</b>
    <ul>
      <li>Die <b>Zeiten</b> (Takt, Selbst-Abschaltung, Übernahme mit und ohne Zeuge, Wartezeit, Umschaltungen je Tag) und die <b>Automatische Umschaltung</b> (Beobachtung oder echt) ändert man am <b>aktiven Server</b> (oder am ersten Server) im Bereich <b>Zeiten</b> ganz unten, dann <b>Speichern</b>. Der <b>Takt</b> ist der Abstand, in dem sich die Server „Ich bin da“ melden (Standard 1 Sekunde). Die <b>Selbst-Abschaltung</b> ist die Zeit, nach der sich ein aktiver Server selbst stoppt, wenn er niemanden mehr erreicht – damit nie zwei Server gleichzeitig aktiv sind. Die Übernahmezeit muss mindestens Selbst-Abschaltung + 2 × Takt + 5 s sein.</li>
      <li><b>Umschaltungen je Tag:</b> Jeder Server übernimmt höchstens so oft automatisch pro Tag. Danach geht die Automatik aus und es kommt ein Alarm.</li>
      <li><b>Datenbank-Spiegel:</b> „Asynchron nach“ (Standard 10 s), „Verzögerungsgrenze“ (16 MB: so viel Rückstand gilt noch als aktuell) und „Höchstmenge zurückgehaltener Änderungen“ (20 GB: so viel hebt der aktive Server für einen fehlenden Partner auf – danach braucht dieser eine vollständige Neukopie).</li>
      <li><b>Automatische Umschaltung:</b> „Beobachtung“ (Standard) oder „echt“. „echt“ ist erst nach der Pflicht-Testumschaltung wählbar.</li>
      <li><b>Alarme</b> gehen an die Administratoren. Je Art kommt höchstens einer alle 15 Minuten.</li>
      <li><b>Netzlaufwerk-Sicherung:</b> Sie läuft nur auf dem aktiven Server mit schreibbarer Datenbank. Der passive Server zeigt „Sicherung pausiert: passiver Knoten“. Nach einer Übernahme macht der neue aktive Server sofort eine neue Grundsicherung. Ist <code>pdh-ha</code> nicht erreichbar, pausiert die Sicherung, und nach 15 Minuten kommt ein Fehler.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-flask"></i> Testlabor</b>
    Für Tests gibt es ein Docker-Testlabor. Es dient nur zum Ausprobieren – im Betrieb laufen die Server mit systemd.</div>
  {{template "hb-shots" (dict "Ref" (index $s "spiegelbetrieb") "Can" $can)}}
</section>

<section class="hb-ch" id="faq" data-title="Tipps &amp; häufige Fragen" data-pages="">
  <h2><i class="ti ti-help-circle"></i> Tipps &amp; häufige Fragen</h2>
  <h3>Ich sehe einen Reiter oder Knopf nicht.</h3>
  <p>Viele Funktionen hängen von Berechtigungen ab. Frag eure Administration.</p>
  <h3>Ein eingebettetes Portal bleibt leer.</h3>
  <p>Der Anbieter erlaubt das Einbetten nicht. Im Viewer über <i class="ti ti-external-link"></i> in einem neuen Tab öffnen.</p>
  <h3>Die Chat-Leiste geht zu oft auf.</h3>
  <p>Den Chat stummschalten (Glocke) – dann öffnet sie sich bei dieser Unterhaltung nicht mehr von selbst. Das gilt auch für die Unterhaltung mit <b>„Service“</b>; die Änderungshinweise lassen sich unter Mein Konto → Konto &amp; Dienste ganz abschalten.</p>
  <h3>Wie lösche ich eine Anlage, ein Ersatzteil oder einen Lagerplatz?</h3>
  <p>Gar nicht direkt: <b>Status → Zum Löschen vormerken</b>. Der Bereinigungslauf löscht den Datensatz oder blendet ihn aus, wenn er noch verwendet wird (<a href="#cleanup">mehr</a>).</p>
  <h3>Beim Speichern oder Buchen erscheint „gesperrt“.</h3>
  <p>Der Datensatz – bei Buchungen das Ersatzteil oder der Lagerplatz – wurde gesperrt. Wer bearbeiten darf, hebt die Sperre über <b>Status → Sperre aufheben</b> auf.</p>
  <h3>Wie lege ich PDH auf dem Handy oder Tablet als App ab?</h3>
  <p>PDH im Browser öffnen und <b>Zum Home-Bildschirm</b> (iPhone/iPad: Teilen-Symbol; Android: Menü ⋮) wählen. Es erscheint das PDH-Symbol, und PDH öffnet sich ohne Adressleiste wie eine App.</p>
  <h3>Etiketten werden zu groß oder zu klein gedruckt.</h3>
  <p>Das passende Format wählen und im Druckdialog 100 % Skalierung und keine Ränder einstellen.</p>
  {{template "hb-shots" (dict "Ref" (index $s "faq") "Can" $can)}}
</section>
{{end}}

{{define "context-list"}}{{end}}

{{define "scripts"}}
<script>
(function(){
  const body = document.getElementById('hb-body');
  const toc = document.getElementById('hb-toc');
  const sections = [...body.querySelectorAll('.hb-ch[id]')];
  toc.innerHTML = sections.map((s, i) => '<a href="#' + s.id + '"><span class="n">' + (i + 1) + '</span>' + s.dataset.title + '</a>').join('');
  const links = [...toc.querySelectorAll('a')];
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting) links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id)); });
  }, {rootMargin: '0px 0px -70% 0px'});
  sections.forEach(s => obs.observe(s));
  // Volltextsuche: Kapitel filtern und Treffer markieren (Bilder/Grafiken bleiben unveraendert)
  const q = document.getElementById('hb-q');
  let t;
  q.addEventListener('input', () => { clearTimeout(t); t = setTimeout(search, 200); });
  function unmark(root){ root.querySelectorAll('mark.hb-m').forEach(m => m.replaceWith(document.createTextNode(m.textContent))); root.normalize(); }
  function search(){
    const term = q.value.trim().toLowerCase();
    let hits = 0;
    sections.forEach(s => {
      unmark(s);
      const match = !term || s.textContent.toLowerCase().includes(term);
      s.classList.toggle('hb-hide', !match);
      if(match){ hits++; if(term) mark(s, term); }
    });
    links.forEach(a => { const s = document.querySelector(a.getAttribute('href')); a.style.display = s && s.classList.contains('hb-hide') ? 'none' : ''; });
    document.getElementById('hb-none').style.display = hits ? 'none' : '';
  }
  function mark(root, term){
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {acceptNode: n => n.parentElement.closest('svg,script,style') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT});
    const nodes = [];
    while(walker.nextNode()) if(walker.currentNode.nodeValue.toLowerCase().includes(term)) nodes.push(walker.currentNode);
    nodes.forEach(n => {
      const i = n.nodeValue.toLowerCase().indexOf(term);
      const m = document.createElement('mark'); m.className = 'hb-m';
      const hit = n.splitText(i); hit.splitText(term.length);
      m.textContent = hit.nodeValue; hit.replaceWith(m);
    });
  }
})();
</script>
{{end}}
