@@ -0,0 +1,278 @@
+package web
+
+// integration_handler.go
+//
+// HTTP-Endpunkte unter /api/v1/integration/* für externe Systeme wie n8n.
+// Abgesichert per X-API-Key-Header (integrations.Service.AuthMiddleware),
+// NICHT per JWT-Session - n8n ist kein Nutzerkonto. API-Schlüssel werden
+// unter "Schnittstellen" in der PDH-Oberfläche erzeugt/verwaltet.
+//
+// Zwei Richtungen:
+//   Export (GET)  - PDH-Daten für externe Systeme abrufbar machen
+//   Import (POST) - externe Systeme legen/aktualisieren Daten in PDH an
+//
+// Bewusste Grenze: nicht jedes PDH-Modul hat hier einen Endpunkt, siehe
+// Doku im Patch dazu. Die Struktur ist so angelegt, dass sich weitere
+// Module nach demselben Muster ergänzen lassen.
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+
+	"pdh/internal/core/integrations"
+	"pdh/internal/modules/faults"
+	"pdh/internal/modules/maintenance"
+	"pdh/internal/modules/production"
+	"pdh/internal/modules/tickets"
+)
+
+// IntegrationRoutes registriert alle /api/v1/integration/*-Endpunkte.
+// Wird in main.go mit integrations.Service.AuthMiddleware statt der
+// normalen JWT-Middleware verknüpft.
+func (h *Handler) IntegrationRoutes() chi.Router {
+	r := chi.NewRouter()
+
+	r.Get("/production", h.IntegrationExportProduction)
+	r.Post("/production", h.IntegrationImportProduction)
+
+	r.Get("/tasks", h.IntegrationExportTasks)
+	r.Get("/tickets", h.IntegrationExportTickets)
+	r.Get("/faults", h.IntegrationExportFaults)
+	r.Post("/faults", h.IntegrationImportFault)
+	r.Get("/maintenance", h.IntegrationExportMaintenance)
+	r.Get("/inventory", h.IntegrationExportInventory)
+
+	return r
+}
+
+func writeJSON(w http.ResponseWriter, status int, v interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+
+// parseTimeRange liest optionale "from"/"to" Query-Parameter (Format
+// YYYY-MM-DD oder RFC3339) für die Export-Endpunkte.
+func parseTimeRange(r *http.Request) (from, to *time.Time) {
+	parse := func(s string) *time.Time {
+		if s == "" {
+			return nil
+		}
+		if t, err := time.Parse(time.RFC3339, s); err == nil {
+			return &t
+		}
+		if t, err := time.Parse("2006-01-02", s); err == nil {
+			return &t
+		}
+		return nil
+	}
+	from = parse(r.URL.Query().Get("from"))
+	to = parse(r.URL.Query().Get("to"))
+	return
+}
+
+// ── Produktionsdaten ──────────────────────────────────────────
+
+func (h *Handler) IntegrationExportProduction(w http.ResponseWriter, r *http.Request) {
+	from, to := parseTimeRange(r)
+	limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
+	records, err := h.production.List(r.Context(), production.Filter{
+		InfrastructureID: r.URL.Query().Get("infrastructure_id"),
+		From:             from,
+		To:               to,
+		Limit:            limit,
+	})
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": records, "count": len(records)})
+}
+
+// productionImportItem entspricht einem einzelnen Datensatz beim Import;
+// wird sowohl fuer einzelne Objekte als auch fuer Arrays (Batch-Import aus
+// einem MES/einer Maschinensteuerung) verwendet.
+type productionImportItem struct {
+	InfrastructureID *string  `json:"infrastructure_id"`
+	RecordedAt       *string  `json:"recorded_at"` // RFC3339 oder YYYY-MM-DD, optional (Standard: jetzt)
+	QuantityGood     int      `json:"quantity_good"`
+	QuantityScrap    int      `json:"quantity_scrap"`
+	CycleTimeSeconds *float64 `json:"cycle_time_seconds"`
+	Notes            string   `json:"notes"`
+	ExternalRef      *string  `json:"external_ref"`
+}
+
+func (h *Handler) IntegrationImportProduction(w http.ResponseWriter, r *http.Request) {
+	body, err := readJSONArrayOrObject(r)
+	if err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "ungültiges JSON: " + err.Error()})
+		return
+	}
+	apiKey := integrations.APIKeyFromContext(r.Context())
+
+	var imported []*production.Record
+	var errs []string
+	for _, raw := range body {
+		var item productionImportItem
+		if err := json.Unmarshal(raw, &item); err != nil {
+			errs = append(errs, err.Error())
+			continue
+		}
+		in := &production.CreateInput{
+			InfrastructureID: item.InfrastructureID,
+			QuantityGood:     item.QuantityGood,
+			QuantityScrap:    item.QuantityScrap,
+			CycleTimeSeconds: item.CycleTimeSeconds,
+			Notes:            item.Notes,
+			Source:           "import",
+			ExternalRef:      item.ExternalRef,
+		}
+		if apiKey != nil {
+			in.CreatedBy = apiKey.CreatedBy
+		}
+		if item.RecordedAt != nil {
+			if t, err := time.Parse(time.RFC3339, *item.RecordedAt); err == nil {
+				in.RecordedAt = &t
+			} else if t, err := time.Parse("2006-01-02", *item.RecordedAt); err == nil {
+				in.RecordedAt = &t
+			}
+		}
+		rec, err := h.production.Create(r.Context(), in)
+		if err != nil {
+			errs = append(errs, err.Error())
+			continue
+		}
+		imported = append(imported, rec)
+		h.integrations.Dispatch(r.Context(), "production.recorded", rec)
+	}
+
+	status := http.StatusCreated
+	if len(errs) > 0 && len(imported) == 0 {
+		status = http.StatusBadRequest
+	}
+	writeJSON(w, status, map[string]interface{}{"imported": len(imported), "data": imported, "errors": errs})
+}
+
+// readJSONArrayOrObject akzeptiert sowohl ein einzelnes JSON-Objekt als
+// auch ein Array davon - praktisch fuer n8n, das je nach Workflow mal
+// einzelne Items, mal ganze Batches sendet.
+func readJSONArrayOrObject(r *http.Request) ([]json.RawMessage, error) {
+	var arr []json.RawMessage
+	dec := json.NewDecoder(r.Body)
+	raw := json.RawMessage{}
+	if err := dec.Decode(&raw); err != nil {
+		return nil, err
+	}
+	trimmed := trimLeadingSpace(raw)
+	if len(trimmed) > 0 && trimmed[0] == '[' {
+		if err := json.Unmarshal(raw, &arr); err != nil {
+			return nil, err
+		}
+		return arr, nil
+	}
+	return []json.RawMessage{raw}, nil
+}
+
+func trimLeadingSpace(b []byte) []byte {
+	i := 0
+	for i < len(b) && (b[i] == ' ' || b[i] == '\t' || b[i] == '\n' || b[i] == '\r') {
+		i++
+	}
+	return b[i:]
+}
+
+// ── Export bestehender Module ─────────────────────────────────
+
+func (h *Handler) IntegrationExportTasks(w http.ResponseWriter, r *http.Request) {
+	list, err := h.tasks.List(r.Context(), "", "", false)
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": list, "count": len(list)})
+}
+
+func (h *Handler) IntegrationExportTickets(w http.ResponseWriter, r *http.Request) {
+	list, err := h.tickets.List(r.Context(), tickets.Status(r.URL.Query().Get("status")))
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": list, "count": len(list)})
+}
+
+func (h *Handler) IntegrationExportFaults(w http.ResponseWriter, r *http.Request) {
+	list, err := h.faults.List(r.Context(), faults.FaultStatus(r.URL.Query().Get("status")))
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": list, "count": len(list)})
+}
+
+func (h *Handler) IntegrationExportMaintenance(w http.ResponseWriter, r *http.Request) {
+	list, err := h.maint.ListTasks(r.Context(), maintenance.TaskStatus(r.URL.Query().Get("status")), r.URL.Query().Get("infrastructure_id"))
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": list, "count": len(list)})
+}
+
+func (h *Handler) IntegrationExportInventory(w http.ResponseWriter, r *http.Request) {
+	list, err := h.inv.List(r.Context(), r.URL.Query().Get("category"), r.URL.Query().Get("status"), r.URL.Query().Get("q"))
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"data": list, "count": len(list)})
+}
+
+// ── Import: Störung von einem externen System anlegen ────────
+//
+// Konkretes Beispiel fuer die "Import"-Richtung: eine SPS/ein
+// Alarmsystem meldet per n8n einen Fehler, der als PDH-Stoerung
+// angelegt wird und normal im Stoerungsworkflow weiterlaeuft.
+
+type faultImportItem struct {
+	Title            string  `json:"title"`
+	Description      string  `json:"description"`
+	Severity         string  `json:"severity"`
+	InfrastructureID *string `json:"infrastructure_id"`
+}
+
+func (h *Handler) IntegrationImportFault(w http.ResponseWriter, r *http.Request) {
+	var in faultImportItem
+	if err := json.NewDecoder(r.Body).Decode(&in); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "ungültiges JSON: " + err.Error()})
+		return
+	}
+	if in.Title == "" {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "title ist erforderlich"})
+		return
+	}
+	if in.Severity == "" {
+		in.Severity = "medium"
+	}
+	apiKey := integrations.APIKeyFromContext(r.Context())
+	if apiKey == nil || apiKey.CreatedBy == nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": "API-Key ist keinem Ersteller zugeordnet"})
+		return
+	}
+	f, err := h.faults.Create(r.Context(), &faults.CreateFaultInput{
+		Title:            in.Title,
+		Description:      in.Description,
+		Severity:         faults.Severity(in.Severity),
+		InfrastructureID: in.InfrastructureID,
+	}, *apiKey.CreatedBy)
+	if err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]string{"error": err.Error()})
+		return
+	}
+	h.integrations.Dispatch(r.Context(), "fault.created", f)
+	writeJSON(w, http.StatusCreated, map[string]interface{}{"data": f})
+}
