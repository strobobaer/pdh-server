{{define "terminal-download-link"}}<div class="rec-sub" style="margin:6px 0 10px;font-size:12px"><a class="btn btn-small" href="{{terminalDownloadURL}}" target="_blank" rel="noopener" data-terminal-download><i class="ti ti-download"></i> {{t "Terminal-Software herunterladen"}}</a> <span style="margin-left:6px">{{t "Raspberry-Pi-Abbild, Windows-Setup (EXE/MSI) und Updates"}}</span></div>{{end}}
{{define "terminal-gear"}}{{if .AdminURL}}<a class="btn btn-small" href="{{.AdminURL}}" target="_blank" rel="noopener noreferrer" title="Verwaltung des Terminals öffnen" aria-label="Verwaltung des Terminals öffnen"><i class="ti ti-settings"></i></a>{{else}}<span class="btn btn-small" style="opacity:.4;cursor:not-allowed" title="Terminal meldet seine Adresse ab 0.4.5" aria-label="Terminal meldet seine Adresse ab 0.4.5" aria-disabled="true"><i class="ti ti-settings"></i></span>{{end}}{{end}}
