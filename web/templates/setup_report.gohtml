{{template "base" .}}
{{define "content"}}
<style>
.sr-kpis{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.sr-kpi{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 16px;min-width:140px}
.sr-kpi b{display:block;font-size:20px}.sr-kpi span{font-size:12px;color:var(--muted)}
.sr-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(260px,2fr);gap:14px;align-items:start}
@media(max-width:900px){.sr-grid{grid-template-columns:minmax(0,1fr)}}
.sr-plant td{background:var(--bg3);font-weight:600}
.sr-bar{height:8px;border-radius:4px;background:var(--bg3);overflow:hidden;min-width:60px;display:inline-block;width:70px;vertical-align:middle;margin-right:6px}
.sr-bar span{display:block;height:100%;background:var(--accent)}
.pie-set{display:flex;flex-direction:column;gap:10px}
.pie-box{display:flex;flex-direction:column;align-items:center;gap:8px}
.pie-svg{width:100%;max-width:320px;height:auto}
.pie-slice{stroke:var(--bg2);stroke-width:2}
.pie-pct{fill:#fff;font-size:20px;font-weight:700;text-anchor:middle;paint-order:stroke;stroke:rgba(0,0,0,.6);stroke-width:4px}
.pie-pick{cursor:pointer}
.pie-slice.pie-pick:hover{opacity:.85}
.pie-slice.pie-pick:focus-visible{outline:none;stroke:var(--text);stroke-width:4}
.pie-slice.pie-on{stroke:var(--text);stroke-width:4}
.pie-legend{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;font-size:13px;color:var(--muted);align-self:stretch}
.pie-legend li{padding:4px 6px;border-radius:6px}
.pie-legend li.pie-pick:hover,.pie-legend li.pie-on{background:var(--bg3);color:var(--text)}
.pie-legend li.pie-on{font-weight:600}
.pie-legend li:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.pie-hint{font-size:12px;color:var(--muted)}
.pie-detail-h{font-size:13px;font-weight:600;margin:4px 0 6px}
.pie-reasons{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:13px}
.pie-rbar{display:block;height:6px;border-radius:3px;background:var(--bg3);overflow:hidden;margin-bottom:2px}
.pie-rfill{display:block;height:100%}
.pie-legend .sw{display:inline-block;width:.9em;height:.9em;border-radius:3px;margin-right:.4em;vertical-align:-.1em}
.pie-none{color:var(--muted);padding:8px 0}
</style>
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap">
  <div style="flex:1;min-width:200px">
    <h1 style="font-size:18px;font-weight:600"><i class="ti ti-chart-pie"></i> Rüstzeiten – Auswertung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">Abgeschlossene Rüstzeiten je Anlage und Grund · {{.Period}} · <a href="/setup">zurück zu den Rüstzeiten</a></p>
  </div>
  <form method="get" action="/setup/report" style="display:flex;gap:8px;flex-wrap:wrap">
    <select name="days" class="form-input" aria-label="Zeitraum" onchange="this.form.submit()">{{range .DayOpts}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
    <noscript><button class="btn btn-small" type="submit">Anzeigen</button></noscript>
  </form>
</div>
<div class="sr-kpis">
  <div class="sr-kpi"><b>{{.Total}}</b><span>Rüstzeiten</span></div>
  <div class="sr-kpi"><b>{{if .Duration}}{{.Duration}}{{else}}–{{end}}</b><span>Gesamtdauer</span></div>
  <div class="sr-kpi"><b>{{.Running}}</b><span>laufend</span></div>
</div>
<div class="sr-grid">
  <div class="card">
    {{if .Plants}}
    <div style="overflow-x:auto"><table class="table">
      <thead><tr><th>Anlage / Grund</th><th>Anzahl</th><th>Gesamtdauer</th><th>Ø Dauer</th><th>Anteil</th></tr></thead>
      {{range .Plants}}<tbody>
        <tr class="sr-plant"><td>{{.Path}}</td><td>{{.Count}}</td><td>{{.Duration}}</td><td></td><td></td></tr>
        {{range .Reasons}}<tr><td style="padding-left:24px">{{.Name}}</td><td>{{.Count}}</td><td>{{.Duration}}</td><td>{{.Avg}}</td><td><span class="sr-bar" title="{{.Pct}} %"><span style="width:{{.Pct}}%"></span></span>{{.Pct}} %</td></tr>{{end}}
      </tbody>{{end}}
    </table></div>
    {{else}}<div class="rec-sub" style="padding:8px 0">Im gewählten Zeitraum wurden keine abgeschlossenen Rüstzeiten erfasst.</div>{{end}}
  </div>
  <div class="card" id="sr-pies" data-pies="{{.PiesJSON}}">
    <h2 style="font-size:14px;font-weight:600;margin-bottom:8px">Anteil der Anlagen an der Rüstdauer</h2>
    {{if not .HasPies}}<div class="pie-none">Keine abgeschlossenen Rüstzeiten</div>{{end}}
  </div>
</div>
<script>
(function () {
  'use strict';
  // Kreisdiagramm der Rüstzeiten nach Anlagen (Statistikfolie und Seite „Rüstzeiten – Auswertung“; derselbe Text steht
  // in setup_report.gohtml). Geometrie rein; Zeichnen nur über DOM-Methoden und textContent, nie HTML aus Daten.
  // slices: [{label, value, count, percent, color, duration, reasons}]. Rückgabe je Stück mit value > 0:
  // {d: Pfad, x, y: Ort der Prozentangabe, slice}.
  function pieGeometry(slices, cx, cy, r) {
    var out = [], total = 0;
    var list = Array.isArray(slices) ? slices : [];
    list.forEach(function (s) { var v = Number(s && s.value); if (v > 0) total += v; });
    if (!(total > 0)) return out;
    var rnd = function (n) { return Math.round(n * 10) / 10; };
    var pt = function (a, rr) { return rnd(cx + rr * Math.cos(a)) + ' ' + rnd(cy + rr * Math.sin(a)); };
    var a0 = -Math.PI / 2;
    list.forEach(function (s, idx) {
      var v = Number(s && s.value);
      if (!(v > 0)) return;
      var a1 = a0 + 2 * Math.PI * v / total, mid = (a0 + a1) / 2, d;
      if (v >= total) {
        d = 'M ' + (cx - r) + ' ' + cy + ' A ' + r + ' ' + r + ' 0 1 1 ' + (cx + r) + ' ' + cy + ' A ' + r + ' ' + r + ' 0 1 1 ' + (cx - r) + ' ' + cy + ' Z';
      } else {
        d = 'M ' + cx + ' ' + cy + ' L ' + pt(a0, r) + ' A ' + r + ' ' + r + ' 0 ' + (a1 - a0 > Math.PI ? 1 : 0) + ' 1 ' + pt(a1, r) + ' Z';
      }
      out.push({ d: d, x: rnd(cx + r * 0.62 * Math.cos(mid)), y: rnd(cy + r * 0.62 * Math.sin(mid)), slice: s, i: idx });
      a0 = a1;
    });
    return out;
  }
  // Text für den barrierefreien Titel: „Anlage A 60 %, Anlage B 40 %“.
  function pieText(pie) {
    var sl = pie && Array.isArray(pie.slices) ? pie.slices : [];
    return sl.map(function (s) { return String(s.label) + ' ' + Number(s.percent) + ' %'; }).join(', ');
  }
  // Farbe nur als Hexwert, sonst Grau.
  function pieColor(c) {
    return typeof c === 'string' && /^#[0-9a-fA-F]{6}$/.test(c) ? c : '#94a3b8';
  }
  // Beschriftungsfarbe nach Helligkeit des Stücks: dunkle Schrift auf hellen, weiße auf dunklen Farben; das Kontrastverhältnis
  // ist so immer mindestens 4,5 : 1, ohne auf einen Rand angewiesen zu sein.
  function pieTextColor(c) {
    var h = pieColor(c), lin = function (v) { v = v / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
    var lum = 0.2126 * lin(parseInt(h.slice(1, 3), 16)) + 0.7152 * lin(parseInt(h.slice(3, 5), 16)) + 0.0722 * lin(parseInt(h.slice(5, 7), 16));
    return lum > 0.179 ? '#000000' : '#ffffff';
  }
  // Eine Zeile der Legende: „Anlage – Dauer – Anteil % – Anzahl Rüstvorgänge“ (Dauer und Anzahl nur, wenn vorhanden).
  function pieLine(s) {
    var parts = [String(s.label)];
    if (s.duration) parts.push(String(s.duration));
    parts.push(Number(s.percent) + ' %');
    var n = Number(s.count);
    if (n > 0) parts.push(n === 1 ? '1 Rüstvorgang' : n + ' Rüstvorgänge');
    return parts.join(' – ');
  }
  // Ein Stück oder ein Legendeneintrag zum Antippen: Tastatur (Enter, Leertaste) und Maus/Finger.
  function pieBindPick(el, text, fn) {
    el.setAttribute('tabindex', '0');
    el.setAttribute('role', 'button');
    el.setAttribute('aria-pressed', 'false');
    el.setAttribute('aria-label', text);
    el.addEventListener('click', fn);
    el.addEventListener('keydown', function (ev) {
      if (ev && (ev.key === 'Enter' || ev.key === ' ')) {
        if (ev.preventDefault) ev.preventDefault();
        fn();
      }
    });
  }
  var pieSeq = 0;
  // Ein Kreisdiagramm samt Legende als DOM-Baum (div.pie-box). Mit onPick(Stück, Nummer) sind Stücke und
  // Legendeneinträge antippbar; box.setPicked(Nummer oder -1) markiert das gewählte Stück. Die Legende nennt alle
  // Einträge, auch solche ohne Stück (Anteil 0); mit maxLegend > 0 zeigt sie höchstens so viele und dann „+N weitere“.
  function drawPie(pie, onPick, maxLegend) {
    var NS = 'http://www.w3.org/2000/svg', n = ++pieSeq;
    var box = document.createElement('div');
    box.className = 'pie-box';
    var geo = pieGeometry(pie && pie.slices, 150, 150, 140);
    if (!geo.length) {
      var none = document.createElement('div');
      none.className = 'pie-none';
      none.textContent = 'Keine abgeschlossenen Rüstzeiten';
      box.appendChild(none);
      return box;
    }
    var pick = typeof onPick === 'function' ? onPick : null;
    var paths = {}, items = {};
    var svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 300 300');
    svg.setAttribute('class', 'pie-svg');
    if (pick) { // mit Schaltflächen darin: Gruppe mit Beschriftung statt Bild
      svg.setAttribute('role', 'group');
      svg.setAttribute('aria-label', 'Anteil der Anlagen an der Rüstdauer – ' + String((pie && pie.title) || '') + ': ' + pieText(pie));
    } else {
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-labelledby', 'pie-t' + n + ' pie-d' + n);
    }
    var t = document.createElementNS(NS, 'title');
    t.setAttribute('id', 'pie-t' + n);
    t.textContent = 'Anteil der Anlagen an der Rüstdauer – ' + String((pie && pie.title) || '');
    var ds = document.createElementNS(NS, 'desc');
    ds.setAttribute('id', 'pie-d' + n);
    ds.textContent = pieText(pie);
    svg.appendChild(t);
    svg.appendChild(ds);
    geo.forEach(function (g) {
      var p = document.createElementNS(NS, 'path');
      p.setAttribute('d', g.d);
      p.setAttribute('fill', pieColor(g.slice.color));
      p.setAttribute('class', 'pie-slice');
      if (pick) {
        pieBindPick(p, pieLine(g.slice), function () { pick(g.slice, g.i); });
        p.setAttribute('class', 'pie-slice pie-pick');
      }
      paths[g.i] = p;
      svg.appendChild(p);
    });
    geo.forEach(function (g) {
      if (!(Number(g.slice.percent) >= 4)) return; // kleine Stücke nur in der Legende
      var tx = document.createElementNS(NS, 'text');
      tx.setAttribute('x', g.x);
      tx.setAttribute('y', g.y + 7);
      tx.setAttribute('class', 'pie-pct');
      tx.setAttribute('pointer-events', 'none');
      tx.style.fill = pieTextColor(g.slice.color);
      tx.style.stroke = 'none';
      tx.textContent = Number(g.slice.percent) + ' %';
      svg.appendChild(tx);
    });
    box.appendChild(svg);
    var ul = document.createElement('ul');
    ul.className = 'pie-legend';
    var entries = Array.isArray(pie.slices) ? pie.slices : [];
    var shown = maxLegend > 0 ? Math.min(entries.length, maxLegend) : entries.length;
    entries.slice(0, shown).forEach(function (s, k) {
      var li = document.createElement('li');
      var sw = document.createElement('span');
      sw.className = 'sw';
      sw.style.backgroundColor = pieColor(s.color);
      li.appendChild(sw);
      li.appendChild(document.createTextNode(pieLine(s)));
      if (pick) {
        pieBindPick(li, pieLine(s), function () { pick(s, k); });
        li.setAttribute('class', 'pie-pick');
      }
      items[k] = li;
      ul.appendChild(li);
    });
    if (shown < entries.length) {
      var more = document.createElement('li');
      more.textContent = '+' + (entries.length - shown) + ' weitere';
      ul.appendChild(more);
    }
    box.appendChild(ul);
    box.setPicked = function (k) {
      Object.keys(paths).forEach(function (key) {
        var i = Number(key);
        paths[i].setAttribute('class', 'pie-slice' + (pick ? ' pie-pick' : '') + (i === k ? ' pie-on' : ''));
        paths[i].setAttribute('aria-pressed', i === k ? 'true' : 'false');
      });
      Object.keys(items).forEach(function (key) {
        var i = Number(key);
        items[i].setAttribute('class', (pick ? 'pie-pick' : '') + (i === k ? ' pie-on' : ''));
        items[i].setAttribute('aria-pressed', i === k ? 'true' : 'false');
      });
    };
    return box;
  }
  // Die Rüstgründe einer Anlage als Liste mit Balken in der Farbe der Anlage (div.pie-detail-body).
  function drawPieReasons(slice) {
    var wrap = document.createElement('div');
    wrap.className = 'pie-detail-body';
    var h = document.createElement('div');
    h.className = 'pie-detail-h';
    h.textContent = 'Rüstgründe – ' + String(slice.label);
    wrap.appendChild(h);
    var ul = document.createElement('ul');
    ul.className = 'pie-reasons';
    (Array.isArray(slice.reasons) ? slice.reasons : []).forEach(function (r) {
      var li = document.createElement('li');
      var bar = document.createElement('span');
      bar.className = 'pie-rbar';
      var fill = document.createElement('span');
      fill.className = 'pie-rfill';
      fill.style.width = Math.max(0, Math.min(100, Number(r.percent) || 0)) + '%';
      fill.style.backgroundColor = pieColor(slice.color);
      bar.appendChild(fill);
      li.appendChild(bar);
      li.appendChild(document.createTextNode(pieLine(r)));
      ul.appendChild(li);
    });
    wrap.appendChild(ul);
    return wrap;
  }
  // Das Kreisdiagramm nach Anlagen (div.pie-set); ohne Diagramm leer. Enthalten die Stücke Gründe (Seite), zeigt
  // Antippen eines Stücks oder Legendeneintrags darunter die Gründe der Anlage, nochmal Antippen blendet sie aus;
  // ohne Gründe (Folie) ist nichts antippbar.
  function drawPieSet(pies) {
    var set = document.createElement('div');
    set.className = 'pie-set';
    var list = Array.isArray(pies) ? pies : [];
    if (!list.length) return set;
    var pie = list[0];
    var slices = Array.isArray(pie.slices) ? pie.slices : [];
    var interactive = slices.some(function (s) { return Array.isArray(s.reasons) && s.reasons.length > 0; });
    var holder = document.createElement('div');
    holder.className = 'pie-holder';
    var detail = document.createElement('div');
    detail.className = 'pie-detail';
    var cur = -1, box = null;
    var onPick = function (slice, k) {
      while (detail.firstChild) detail.removeChild(detail.firstChild);
      cur = cur === k ? -1 : k;
      box.setPicked(cur);
      if (cur >= 0) detail.appendChild(drawPieReasons(slice));
    };
    box = drawPie(pie, interactive ? onPick : null, interactive ? 0 : 10); // Folie: höchstens 10 Legendenzeilen
    holder.appendChild(box);
    set.appendChild(holder);
    if (interactive && typeof box.setPicked === 'function') {
      var hint = document.createElement('div');
      hint.className = 'pie-hint';
      hint.textContent = 'Anlage antippen: Rüstgründe anzeigen';
      set.appendChild(hint);
      set.appendChild(detail);
    }
    return set;
  }
  var host = document.getElementById('sr-pies');
  if (!host) return;
  var pies = [];
  try { pies = JSON.parse(host.getAttribute('data-pies') || '[]'); } catch (e) { pies = []; }
  if (Array.isArray(pies) && pies.length) host.appendChild(drawPieSet(pies));
})();
</script>
{{end}}
