{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Wartungsplanung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.TotalPlans}} Pläne · {{.OpenTasks}} Aufträge offen</p>
  </div>
  {{template "icon-button-toolbar" (dict
  "Class" "end"
  "Label" "Wartungsaktionen"
  "Items" (list
      (dict "Action" "new" "ShowLabel" true "OnClick" "document.getElementById('new-plan-form').style.display='block'")
      (dict "Action" "refresh" "ShowLabel" true "HxPost" "/maintenance/generate" "HxTarget" "#generate-result")
  )
)}}
</div>
<div id="generate-result"></div>

<!-- Neuer Plan -->
<div id="new-plan-form" style="display:none" class="card">
  <div class="card-title">Wartungsplan anlegen</div>
  <form onsubmit="return submitMaintenancePlanForm(this)">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Typ</label>
        <select name="type" class="form-input">
          <option value="preventive">Vorbeugend</option>
          <option value="inspection">Inspektion</option>
          <option value="calibration">Kalibrierung</option>
          <option value="cleaning">Reinigung</option>
        </select>
      </div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Infrastruktur</label>
        <input type="hidden" id="maintenance-infra-id" name="infrastructure_id" required>
        <div class="infra-picker" data-infra-picker data-target="maintenance-infra-id" data-selected-label="maintenance-infra-selected">
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px">
            <div id="maintenance-infra-selected" style="flex:1;font-size:12px;color:var(--muted)">Keine Infrastruktur ausgewählt</div>
            {{template "icon-button-toolbar" (dict
              "Class" "compact"
              "Label" "Infrastruktur-Auswahl"
              "Items" (list
                (dict "Action" "refresh" "ShowLabel" true "Class" "btn-small" "OnClick" "loadInfraPicker(this.closest('[data-infra-picker]'))")
                (dict "Action" "cancel" "ShowLabel" true "Label" "Leeren" "Class" "btn-small" "OnClick" "clearInfraPicker(this.closest('[data-infra-picker]'))")
              )
            )}}
          </div>
          <input class="form-input" data-infra-filter placeholder="Suchen: Gebäude, Linie, Anlage, Gerät..." oninput="filterInfraPicker(this)" style="margin-bottom:8px">
          <div data-infra-tree style="border:1px solid var(--border);border-radius:8px;max-height:220px;overflow:auto;padding:8px;background:var(--bg3);font-size:12px;color:var(--muted)">Noch nicht geladen</div>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Intervall</label>
        <select name="interval" class="form-input">
          <option value="daily">Täglich</option>
          <option value="weekly">Wöchentlich</option>
          <option value="monthly" selected>Monatlich</option>
          <option value="quarterly">Quartalsweise</option>
          <option value="yearly">Jährlich</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Erstes Fälligkeitsdatum</label><input name="first_due_at" type="date" class="form-input" value="{{.Today}}"></div>
      <div class="form-group"><label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
    </div>
    <div id="maintenance-create-result" style="font-size:12px;margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Formularaktionen"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-plan-form').style.display='none'")
        (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Anlegen")
      )
    )}}
  </form>
</div>

<!-- Fällige Aufträge -->
{{if .DueTasks}}
<div class="card" style="border-color:rgba(245,158,11,.3);margin-bottom:14px">
  <div class="card-title"><i class="ti ti-alert-circle" style="color:var(--amber)"></i> Heute fällig</div>
  {{range .DueTasks}}
  <div class="li clickable" data-href="/maintenance/tasks/{{.ID}}">
    <div class="act-dot {{.PriorityDot}}"></div>
    <div class="li-text">
      <div class="li-title">{{.Title}}</div>
      <div class="li-sub">{{.InfraName}} · fällig {{.DueDate}}</div>
    </div>
    <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
  </div>
  {{end}}
</div>
{{end}}

<div class="grid2">
  <!-- Wartungspläne -->
  <div class="card" id="plans-list">
    <div class="card-title">Wartungspläne <span class="card-action">{{.TotalPlans}} aktiv</span></div>
    {{range .Plans}}
    <div class="li">
      <div class="act-dot {{.PriorityDot}}"></div>
      <div class="li-text">
        <div class="li-title">{{.Name}}</div>
        <div class="li-sub">{{.InfraName}} · {{.IntervalLabel}} · nächste: {{.NextDue}}</div>
      </div>
      <span class="badge b-gray" style="font-size:10px">{{.TypeLabel}}</span>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Pläne vorhanden</div>
    {{end}}
  </div>

  <!-- Offene Aufträge -->
  <div class="card">
    <div class="card-title">Offene Aufträge
      <div class="widget-icon-toolbar compact">
        {{if eq .Filter "open"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Offen" "Href" "/maintenance?status=open" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Offen" "Href" "/maintenance?status=open")}}{{end}}
        {{if eq .Filter "in_progress"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Arbeit" "Href" "/maintenance?status=in_progress" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Arbeit" "Href" "/maintenance?status=in_progress")}}{{end}}
      </div>
    </div>
    {{range .Tasks}}
    <div class="li clickable" data-href="/maintenance/tasks/{{.ID}}">
      <div class="act-dot {{.PriorityDot}}"></div>
      <div class="li-text">
        <div class="li-title">{{.Title}}</div>
        <div class="li-sub">{{.InfraName}} · fällig {{.DueDate}}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span class="badge {{.StatusClass}}">{{.StatusLabel}}</span>
        <span class="badge {{.PriorityClass}}" style="font-size:9px">{{.Priority}}</span>
      </div>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Aufträge offen</div>
    {{end}}
  </div>
</div>
{{end}}

{{define "context-list"}}
{{range .DueTasks}}
<div class="act-item">
  <div class="act-dot {{.PriorityDot}}"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge {{.StatusClass}}" style="font-size:9px">{{.StatusLabel}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
function pdhToken(){return document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1] || localStorage.getItem('pdh_token') || ''}
function infraIcon(type){return ({building:'🏭',line:'🔄',plant:'⚙️',device:'🔌'}[type]||'📍')}
function selectInfra(btn){const root=btn.closest('[data-infra-picker]'); document.getElementById(root.dataset.target).value=btn.dataset.infraId; document.getElementById(root.dataset.selectedLabel).textContent=btn.dataset.infraName}
function clearInfraPicker(root){document.getElementById(root.dataset.target).value=''; document.getElementById(root.dataset.selectedLabel).textContent='Keine Infrastruktur ausgewählt'}
function escapeHtml(s){return String(s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}
function collectInfraBranches(nodes, set){(nodes||[]).forEach(n=>{if((n.children||[]).length){set.add(n.id); collectInfraBranches(n.children,set)}})}
async function loadInfraPicker(root){
  if(!root) return;
  const box=root.querySelector('[data-infra-tree]'); box.innerHTML='Laedt...';
  try{
    const res=await fetch('/api/v1/infrastructure/tree',{headers:{Authorization:'Bearer '+pdhToken()}});
    const json=await res.json();
    root.__infraTree=json.data||[];
    root.__infraExpanded=new Set();
    collectInfraBranches(root.__infraTree, root.__infraExpanded);
    renderInfraPicker(root, root.__infraTree);
  }catch(e){box.innerHTML='<span style="color:var(--red)">Infrastruktur konnte nicht geladen werden</span>'}
}
function renderInfraPicker(root, nodes){
  const box=root.querySelector('[data-infra-tree]');
  if(!nodes.length){box.innerHTML='Keine Infrastruktur vorhanden'; return}
  box.innerHTML=renderInfraNodes(root, nodes, 0);
}
function renderInfraNodes(root, nodes, depth){
  const expanded=root.__infraExpanded||new Set();
  return (nodes||[]).map(n=>{
    const children=n.children||[];
    const hasChildren=children.length>0;
    const open=hasChildren && expanded.has(n.id);
    const toggle=hasChildren
      ? `<button type="button" aria-label="Ast ein- oder ausklappen" aria-expanded="${open}" onclick="toggleInfraBranch(event,this)" data-infra-toggle="${escapeHtml(n.id)}" style="width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;background:none;border:0;color:var(--muted);cursor:pointer;flex-shrink:0"><i class="ti ti-chevron-right" style="font-size:14px;transition:transform .15s;transform:${open?'rotate(90deg)':'rotate(0deg)'}"></i></button>`
      : `<span style="width:22px;height:22px;display:inline-block;flex-shrink:0"></span>`;
    return `<div data-infra-node="${escapeHtml(n.id)}" style="margin-left:${depth*12}px"><div style="display:flex;align-items:center;gap:4px">${toggle}<button type="button" data-infra-id="${escapeHtml(n.id)}" data-infra-name="${escapeHtml(n.name)}" onclick="selectInfra(this)" style="flex:1;text-align:left;background:none;border:0;color:var(--text);padding:5px 6px;border-radius:6px;cursor:pointer;min-width:0">${infraIcon(n.type)} ${escapeHtml(n.name)} <span style="color:var(--muted);font-size:10px">${escapeHtml(n.type)}</span></button></div>${hasChildren?`<div data-infra-children="${escapeHtml(n.id)}" style="display:${open?'block':'none'}">${renderInfraNodes(root, children, depth+1)}</div>`:''}</div>`;
  }).join('');
}
function toggleInfraBranch(event, btn){
  event.stopPropagation();
  const root=btn.closest('[data-infra-picker]');
  const id=btn.dataset.infraToggle;
  root.__infraExpanded=root.__infraExpanded||new Set();
  if(root.__infraExpanded.has(id)) root.__infraExpanded.delete(id); else root.__infraExpanded.add(id);
  const q=(root.querySelector('[data-infra-filter]')?.value||'').toLowerCase().trim();
  renderInfraPicker(root, q ? filterInfraTree(root.__infraTree||[], q) : (root.__infraTree||[]));
}
function filterInfraTree(nodes, q){return (nodes||[]).map(n=>{const children=filterInfraTree(n.children||[],q); const match=String(n.name||'').toLowerCase().includes(q)||String(n.type||'').toLowerCase().includes(q); return match||children.length?{...n,children}:null}).filter(Boolean)}
function filterInfraPicker(input){const root=input.closest('[data-infra-picker]'); const q=input.value.toLowerCase().trim(); renderInfraPicker(root, q ? filterInfraTree(root.__infraTree||[], q) : (root.__infraTree||[]))}
async function submitMaintenancePlanForm(form){
  const result=document.getElementById('maintenance-create-result');
  result.textContent='Speichere...';
  try{
    const res=await fetch('/maintenance/plans',{method:'POST',headers:{'HX-Request':'true'},body:new FormData(form)});
    const text=await res.text();
    if(!res.ok) throw new Error(text.replace(/<[^>]*>/g,'').trim()||'Fehler beim Anlegen');
    window.location.href='/maintenance';
  }catch(e){
    result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>';
  }
  return false;
}
document.addEventListener('DOMContentLoaded',()=>document.querySelectorAll('[data-infra-picker]').forEach(loadInfraPicker));
</script>
{{end}}
