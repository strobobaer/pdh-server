{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Neue Zuweisung</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Ticket, Aufgabe, Wartung oder Störung anlegen und direkt einem Mitarbeiter zuweisen</p>
</div>

{{if or .PresetITID .Back}}
<div class="card" style="max-width:720px;margin-bottom:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
  {{if .PresetITID}}<span><i class="ti ti-device-desktop" style="color:var(--accent)"></i> Gerät: <b>{{.ITName}}</b> – der neue Vorgang wird diesem IT-Asset zugeordnet.</span>{{end}}
  {{if .Back}}<a class="btn btn-small" href="{{.Back}}" style="margin-left:auto"><i class="ti ti-arrow-left"></i> Zurück zur Infoseite</a>{{end}}
</div>
{{end}}
<div class="card" style="max-width:720px">
  <div class="card-title">Art des Vorgangs</div>
  <div id="assign-type-tabs" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
    <button type="button" class="btn btn-primary" data-assign-type="ticket" onclick="setAssignType('ticket')"><i class="ti ti-ticket"></i> Ticket</button>
    {{if .CanCreateRestricted}}<button type="button" class="btn" data-assign-type="task" onclick="setAssignType('task')"><i class="ti ti-list-check"></i> Aufgabe</button>
    <button type="button" class="btn" data-assign-type="maintenance" onclick="setAssignType('maintenance')"><i class="ti ti-tool"></i> Wartung</button>{{end}}
    <button type="button" class="btn" data-assign-type="fault" onclick="setAssignType('fault')"><i class="ti ti-alert-triangle"></i> Störung</button>
  </div>

  <form id="assign-form" onsubmit="return submitAssignment(event)">
    <div class="grid2">
      <div class="form-group">
        <label class="form-label">Titel</label>
        <input id="assign-title" class="form-input" placeholder="Kurzbeschreibung" required>
      </div>
      <div class="form-group">
        <label class="form-label" id="assign-priority-label">Priorität</label>
        <select id="assign-priority" class="form-input">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Zugewiesen an</label>
        <select id="assign-assigned-to" class="form-input">
          <option value="">Nicht zugewiesen</option>
          <optgroup label="Personen">{{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</optgroup>
          {{if .Groups}}<optgroup label="Gruppen">{{range .Groups}}<option value="g:{{.ID}}">{{.Name}}{{if .DepartmentName}} ({{.DepartmentName}}){{end}} · {{len .MemberNames}} Mitglieder</option>{{end}}</optgroup>{{end}}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Fällig am <span id="assign-duedate-hint" style="color:var(--muted);font-weight:400"></span></label>
        <input id="assign-due-date" type="date" class="form-input">
      </div>
      <div class="form-group" id="assign-start-date-field" style="display:none">
        <label class="form-label">Start</label>
        <input id="assign-start-date" type="date" class="form-input">
      </div>
      <div class="form-group" id="assign-plan-type-field" style="display:none">
        <label class="form-label">Wartungstyp</label>
        <select id="assign-plan-type" class="form-input">
          <option value="preventive">Vorbeugend</option>
          <option value="inspection">Inspektion</option>
          <option value="calibration">Kalibrierung</option>
          <option value="cleaning">Reinigung</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Beschreibung</label>
      <input id="assign-description" class="form-input" placeholder="Details">
    </div>

    <div class="form-group" id="assign-symptoms-field" style="display:none">
      <label class="form-label">Symptome</label>
      <input id="assign-symptoms" class="form-input" placeholder="Kommagetrennt, z.B. Rauch, ungewöhnliches Geräusch">
    </div>

    {{template "infra-tree-picker" (dict "TargetID" "assign-infra-id" "SelectedLabelID" "assign-infra-selected" "Label" "Infrastruktur" "Value" .PresetInfraID "SelectedLabel" .InfraPath)}}

    <p id="assign-result" style="font-size:12px;margin:14px 0 0"></p>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
      <button type="submit" class="btn btn-primary" id="assign-submit"><i class="ti ti-device-floppy"></i> Anlegen und zuweisen</button>
    </div>
  </form>
  {{if not .CanCreateRestricted}}<p class="as-note"><i class="ti ti-lock"></i> Aufgaben und Wartungen legen hier nur Administratoren und Manager an.</p>{{end}}
</div>

{{if .Unassigned}}
<div class="card as-unassigned" style="max-width:720px;margin-top:12px">
  <div class="card-title"><i class="ti ti-inbox"></i> Noch nicht zugewiesen <span class="as-sub">– Schnelleinstieg für dich als Broker</span></div>
  {{range .Unassigned}}
  <div class="as-group">
    <div class="as-group-head"><i class="ti {{.Icon}}"></i> {{.Label}} <span class="badge {{if .Items}}b-amber{{else}}b-gray{{end}}">{{len .Items}}{{if .More}}+{{.More}}{{end}}</span>
      <a class="as-all" href="{{.ListURL}}">alle anzeigen <i class="ti ti-arrow-right"></i></a></div>
    {{if .Items}}
    <ul class="as-list">
      {{range .Items}}<li><a href="{{.Href}}">
        <span class="act-dot {{if eq .Priority "critical"}}d-red{{else if eq .Priority "high"}}d-amber{{else}}d-blue{{end}}" title="{{.PrioLabel}}"></span>
        <span class="as-title">{{.Title}}</span>
        <span class="as-meta">{{if .Infra}}{{.Infra}} · {{end}}{{.Age}}</span>
        <i class="ti ti-chevron-right"></i></a></li>{{end}}
    </ul>
    {{else}}<div class="as-empty"><i class="ti ti-check"></i> Alles zugewiesen.</div>{{end}}
  </div>
  {{end}}
</div>
{{end}}
<style>
.as-note{font-size:12px;color:var(--muted);margin:12px 0 0;display:flex;gap:6px;align-items:center}
.as-sub{font-weight:400;color:var(--muted);font-size:12px}
.as-group{margin-top:10px}
.as-group-head{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;margin-bottom:4px}
.as-group-head .as-all{margin-left:auto;font-size:12px;font-weight:400;color:var(--accent)}
.as-list{list-style:none;margin:0;padding:0;border:1px solid var(--border);border-radius:10px;overflow:hidden}
.as-list li + li{border-top:1px solid var(--border)}
.as-list a{display:flex;align-items:center;gap:8px;padding:8px 10px;color:var(--text);text-decoration:none;font-size:13px}
.as-list a:hover{background:var(--bg3)}
.as-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.as-meta{font-size:11.5px;color:var(--muted);white-space:nowrap}
.as-list .ti-chevron-right{color:var(--muted)}
.as-empty{font-size:12px;color:var(--muted);padding:2px 0}
@media(max-width:600px){.as-meta{display:none}}
</style>
{{end}}

{{define "scripts"}}
<script>
let assignType = 'ticket';
const assignDefaultDueDays = {
  ticket: {{.DefaultDueDaysTicket}},
  task: {{.DefaultDueDaysTask}},
  maintenance: {{.DefaultDueDaysMaintenance}},
  fault: {{.DefaultDueDaysFault}}
};

function setAssignType(type){
  assignType = type;
  document.querySelectorAll('#assign-type-tabs [data-assign-type]').forEach(function(btn){
    btn.className = btn.dataset.assignType === type ? 'btn btn-primary' : 'btn';
  });
  document.getElementById('assign-start-date-field').style.display = type === 'task' ? 'block' : 'none';
  document.getElementById('assign-plan-type-field').style.display = type === 'maintenance' ? 'block' : 'none';
  document.getElementById('assign-symptoms-field').style.display = type === 'fault' ? 'block' : 'none';
  document.getElementById('assign-priority-label').textContent = type === 'fault' ? 'Schweregrad' : 'Priorität';
  document.getElementById('assign-duedate-hint').textContent = 'leer = ' + assignDefaultDueDays[type] + ' Tage nach Anlage';
  const infraHidden = document.getElementById('assign-infra-id');
  if(infraHidden) infraHidden.required = type === 'maintenance';
  document.getElementById('assign-result').textContent = '';
}

const assignEndpoints = {
  ticket: '/api/v1/tickets/',
  task: '/api/v1/tasks/',
  maintenance: '/api/v1/maintenance/tasks',
  fault: '/api/v1/faults/'
};
const assignRedirects = {
  ticket: '/tickets',
  task: '/tasks',
  maintenance: '/maintenance',
  fault: '/faults'
};

function buildAssignPayload(){
  const title = document.getElementById('assign-title').value.trim();
  const description = document.getElementById('assign-description').value.trim();
  const priority = document.getElementById('assign-priority').value;
  // Auswahl: Person (ID) oder Gruppe ("g:" + ID) – die Gruppe wird nach dem Anlegen gesetzt
  const assignValue = document.getElementById('assign-assigned-to').value;
  const assignedTo = assignValue.startsWith('g:') ? '' : assignValue;
  const dueDate = document.getElementById('assign-due-date').value;
  const infraID = document.getElementById('assign-infra-id').value;

  if(assignType === 'ticket'){
    const payload = {title: title, description: description, priority: priority};
    if(assignedTo) payload.assigned_to = assignedTo;
    if(infraID) payload.infrastructure_id = infraID;
    if(dueDate) payload.due_date = dueDate + 'T00:00:00Z';
    return payload;
  }
  if(assignType === 'task'){
    const payload = {title: title, description: description, priority: priority, due_date: dueDate, start_date: document.getElementById('assign-start-date').value};
    if(assignedTo) payload.assigned_to_ids = [assignedTo];
    if(infraID) payload.infrastructure_id = infraID;
    return payload;
  }
  if(assignType === 'maintenance'){
    return {
      title: title, description: description, priority: priority,
      type: document.getElementById('assign-plan-type').value,
      infrastructure_id: infraID,
      due_date: dueDate,
      assigned_to: assignedTo || null
    };
  }
  const symptoms = String(document.getElementById('assign-symptoms').value || '').split(',').map(function(s){return s.trim();}).filter(Boolean);
  const payload = {title: title, description: description, severity: priority, symptoms: symptoms};
  if(assignedTo) payload.assigned_to = assignedTo;
  if(infraID) payload.infrastructure_id = infraID;
  return payload;
}

async function submitAssignment(event){
  event.preventDefault();
  if(assignType === 'maintenance' && !document.getElementById('assign-infra-id').value){
    document.getElementById('assign-result').innerHTML = '<span style="color:var(--red)">Für Wartungsaufträge ist eine Infrastruktur Pflicht.</span>';
    return false;
  }
  const button = document.getElementById('assign-submit');
  const result = document.getElementById('assign-result');
  button.disabled = true;
  result.textContent = 'Speichere...';
  try{
    const res = await fetch(assignEndpoints[assignType], {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pdhToken()},
      body: JSON.stringify(buildAssignPayload())
    });
    const json = await res.json().catch(function(){return {};});
    if(!res.ok || !json.success) throw new Error((json && json.error) || 'Anlegen fehlgeschlagen');
    const groupID = (document.getElementById('assign-assigned-to').value.match(/^g:(.+)$/) || [])[1];
    const newID = json.data && json.data.id;
    if(groupID && newID){
      const refType = {ticket: 'ticket', task: 'task', maintenance: 'maintenance_task', fault: 'fault'}[assignType];
      const gres = await fetch('/records/' + refType + '/' + encodeURIComponent(newID) + '/group', {
        method: 'POST', credentials: 'same-origin', body: new URLSearchParams({assigned_group_id: groupID})
      });
      if(!gres.ok) throw new Error('Angelegt, aber die Gruppe konnte nicht zugewiesen werden: ' + (await gres.text()));
    }
    if(itAssetID && newID){
      const refType = {ticket: 'ticket', task: 'task', maintenance: 'maintenance_task', fault: 'fault'}[assignType];
      const ires = await fetch('/records/' + refType + '/' + encodeURIComponent(newID) + '/it-asset', {
        method: 'POST', credentials: 'same-origin', body: new URLSearchParams({it_asset_id: itAssetID})
      });
      if(!ires.ok) throw new Error('Angelegt, aber das Gerät konnte nicht zugeordnet werden: ' + (await ires.text()));
    }
    window.location.href = assignBack || assignRedirects[assignType];
  }catch(error){
    result.innerHTML = '<span style="color:var(--red)">Fehler: ' + escapeHtml(error.message) + '</span>';
  }finally{
    button.disabled = false;
  }
  return false;
}

const itAssetID = {{.PresetITID}};
const assignBack = {{.Back}};
setAssignType({{or .PresetType "ticket"}});
</script>
{{end}}
