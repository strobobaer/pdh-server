{{template "base" .}}

{{define "content"}}
{{/* Anlagen-Schnellübersicht (plant_watch.go): Auswahl der Übersicht oben,
     Karten in widgets/plant_watch.gohtml (laden sich jede Minute neu),
     ?edit=new|ID zeigt das Formular. */}}
<style>
.pw-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.pw-head h1{font-size:19px;font-weight:600}
.pw-head p{font-size:12px;color:var(--muted);margin-top:3px}
.pw-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.pw-tab{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border:1px solid var(--border);border-radius:999px;font-size:13px;color:var(--text);background:var(--bg2);text-decoration:none}
.pw-tab.on{border-color:var(--accent);background:var(--accent);color:#fff}
.pw-tab .ti-users{font-size:12px;opacity:.75}
.pw-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.pw-bar .rec-sub{flex:1;min-width:200px;font-size:12.5px;color:var(--muted)}
.pw-msg{padding:9px 12px;border-radius:8px;margin-bottom:12px;font-size:13px}
.pw-msg.ok{background:rgba(16,185,129,.12);color:var(--green)}
.pw-msg.err{background:rgba(239,68,68,.12);color:var(--red)}
.pw-sum{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:13px;margin:4px 0 12px}
.pw-sum-note{color:var(--muted);font-size:12px}
.pw-empty{padding:18px;text-align:center;color:var(--muted)}
.pw-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px}
.pw-card{border:1px solid var(--border);border-left:5px solid var(--green);border-radius:12px;background:var(--bg2);padding:12px 14px;display:flex;flex-direction:column;gap:8px;min-width:0}
.pw-card.amber{border-left-color:var(--amber)}
.pw-card.red{border-left-color:var(--red);background:linear-gradient(90deg,rgba(239,68,68,.07),transparent 60%),var(--bg2)}
.pw-ch{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;min-width:0}
.pw-ch a{color:var(--text);text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pw-ch a:hover{color:var(--accent)}
.pw-path{font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pw-kpis{display:flex;gap:6px;flex-wrap:wrap}
.pw-kpis .badge{font-size:11.5px;gap:4px;align-items:center;text-decoration:none;padding:3px 8px}
.pw-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--green);flex:none}
.pw-dot.amber{background:var(--amber)}
.pw-dot.red{background:var(--red);box-shadow:0 0 0 3px rgba(239,68,68,.25)}
.pw-parts{display:flex;flex-direction:column;gap:7px;border-top:1px dashed var(--border);padding-top:8px}
.pw-gl{font-size:12px;color:var(--muted);margin-bottom:3px;display:flex;align-items:center;gap:5px}
.pw-nok{color:var(--red)}
.pw-slots{display:flex;flex-wrap:wrap;gap:4px}
.pw-slot{min-width:28px;height:26px;padding:0 5px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;text-decoration:none;
  background:rgba(16,185,129,.16);color:var(--green);border:1px solid rgba(16,185,129,.35)}
button.pw-slot{cursor:pointer;font-family:inherit;min-width:34px;height:32px}
button.pw-slot:hover{outline:2px solid var(--accent);outline-offset:1px}
.pw-slot.htmx-request{opacity:.5}
.pw-energy{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:4px 10px;border-top:1px dashed var(--border);padding-top:8px}
.pw-en{display:flex;align-items:center;gap:5px;font-size:12px;min-width:0}
.pw-en i{color:var(--amber)}
.pw-en .n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted)}
.pw-en b{white-space:nowrap}
.pw-en.stale b{color:var(--muted);font-weight:400}
.pw-slot.nok{background:var(--red);color:#fff;border-color:var(--red)}
.pw-kids{display:flex;flex-wrap:wrap;gap:5px;border-top:1px dashed var(--border);padding-top:8px}
.pw-kid{display:inline-flex;align-items:center;gap:5px;font-size:12px;padding:4px 8px;border-radius:7px;background:var(--bg3);color:var(--text);text-decoration:none;max-width:100%}
.pw-kid:hover{outline:1px solid var(--accent)}
.pw-form .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.pw-pick{max-height:320px;overflow:auto;border:1px solid var(--border);border-radius:8px;padding:6px;background:var(--bg3)}
.pw-pick label{display:flex;align-items:center;gap:8px;padding:5px 6px;border-radius:6px;font-size:13px;cursor:pointer}
.pw-pick label:hover{background:var(--bg2)}
.pw-pick input{width:18px;height:18px;flex:none}
.pw-pick small{color:var(--muted)}
.pw-types{display:flex;flex-wrap:wrap;gap:8px}
.pw-types label{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--border);border-radius:8px;font-size:13px;cursor:pointer}
.pw-sec{font-size:13px;font-weight:600;margin:16px 0 6px}
.pw-hint{font-size:12px;color:var(--muted);margin-bottom:6px}
</style>

<div class="pw-head">
  <div>
    <h1><i class="ti ti-eye"></i> Anlagen-Schnellübersicht</h1>
    <p>Anlagen mit besonderem Augenmerk – Status von Störungen, Wartungen, Prüfungen und Bauteilen auf einen Blick.</p>
  </div>
  {{if not .Edit}}<div style="display:flex;gap:8px">
    {{if and .Board .Board.CanEdit}}<a class="btn btn-small" href="/plant-watch?b={{.Board.ID}}&edit={{.Board.ID}}"><i class="ti ti-edit"></i> Bearbeiten</a>{{end}}
    <a class="btn btn-primary btn-small" href="/plant-watch?edit=new"><i class="ti ti-plus"></i> Neue Übersicht</a>
  </div>{{end}}
</div>
{{if .Message}}<div class="pw-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="pw-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

{{if .Edit}}{{$e := .Edit}}
<form class="card pw-form" method="post" action="/plant-watch{{if $e.ID}}/{{$e.ID}}{{end}}">
  <div class="card-title"><span><i class="ti {{$e.Icon}}"></i> {{if $e.ID}}Übersicht bearbeiten{{else}}Neue Übersicht{{end}}</span></div>
  <div class="cols">
    <div><label class="form-label">Name</label><input class="form-input" name="name" value="{{$e.Name}}" maxlength="80" required placeholder="z. B. Trockenkammern"></div>
    <div><label class="form-label">Symbol (Tabler-Name)</label><input class="form-input" name="icon" value="{{$e.Icon}}" maxlength="40" placeholder="ti-temperature"></div>
    <div><label class="form-label">Beschreibung</label><input class="form-input" name="description" value="{{$e.Description}}" maxlength="500" placeholder="optional"></div>
  </div>

  <div class="pw-sec"><i class="ti ti-category"></i> Ganze Anlagentypen</div>
  <div class="pw-hint">Zeigt immer alle aktiven Anlagen dieses Typs – auch später neu angelegte.</div>
  <div class="pw-types">
    {{range .TypeOpts}}<label><input type="checkbox" name="type" value="{{.Key}}"{{if index $e.Types .Key}} checked{{end}}> <i class="ti {{.Icon}}"></i> alle {{.Label}}</label>{{end}}
  </div>

  <div class="pw-sec"><i class="ti ti-hierarchy-2"></i> Einzelne Anlagen &amp; Geräte</div>
  <div class="pw-hint">Je gewählter Anlage erscheint eine Karte mit ihren Unteranlagen.</div>
  <input class="form-input" type="search" placeholder="Anlagen filtern …" oninput="pwFilter(this, 'pw-infra')" style="margin-bottom:6px">
  <div class="pw-pick" id="pw-infra">
    {{range .Nodes}}<label data-q="{{.Path}} {{.TypeLabel}}"><input type="checkbox" name="infra" value="{{.ID}}"{{if index $e.Items .ID}} checked{{end}}> <i class="ti {{.TypeIcon}}"></i> <span>{{.Path}} <small>· {{.TypeLabel}}</small></span></label>{{end}}
  </div>

  {{if .CanManage}}
  <div class="pw-sec"><i class="ti ti-users-group"></i> Freigeben für Gruppen</div>
  <div class="pw-pick" style="max-height:200px">
    {{range .Groups}}<label><input type="checkbox" name="group" value="{{.ID}}"{{if index $e.Groups .ID}} checked{{end}}> {{.Name}}{{if .DepartmentName}} <small>· {{.DepartmentName}}</small>{{end}}</label>{{else}}<div class="pw-hint">Noch keine Gruppen – unter „Abteilungen &amp; Gruppen“ anlegen.</div>{{end}}
  </div>
  <div class="pw-sec"><i class="ti ti-user"></i> Freigeben für einzelne Benutzer</div>
  <input class="form-input" type="search" placeholder="Benutzer filtern …" oninput="pwFilter(this, 'pw-users')" style="margin-bottom:6px">
  <div class="pw-pick" id="pw-users" style="max-height:200px">
    {{range .Users}}<label data-q="{{.Name}}"><input type="checkbox" name="user" value="{{.ID}}"{{if index $e.Users .ID}} checked{{end}}> {{.Name}}</label>{{end}}
  </div>
  {{else}}
  <div class="pw-hint" style="margin-top:14px"><i class="ti ti-lock"></i> Diese Übersicht siehst nur du{{if $e.Shares}} und wem sie freigegeben ist{{end}}. Freigeben für andere dürfen Personen mit dem Recht „Anlagen-Schnellübersichten einrichten“.</div>
  {{end}}

  <div style="display:flex;gap:8px;margin-top:16px;flex-wrap:wrap">
    <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    <a class="btn" href="/plant-watch{{if $e.ID}}?b={{$e.ID}}{{end}}">Abbrechen</a>
    {{if $e.ID}}<button class="btn" type="submit" formaction="/plant-watch/{{$e.ID}}/delete" formnovalidate style="margin-left:auto;color:var(--red)"
      onclick="return confirm('Übersicht „{{$e.Name}}“ löschen? Die Anlagen selbst bleiben unverändert.')"><i class="ti ti-trash"></i> Löschen</button>{{end}}
  </div>
</form>

{{else if .Boards}}
<div class="pw-tabs">
  {{range .Boards}}<a class="pw-tab{{if and $.Board (eq .ID $.Board.ID)}} on{{end}}" href="/plant-watch?b={{.ID}}" title="{{.Description}}{{if .OwnerName}} – angelegt von {{.OwnerName}}{{end}}"><i class="ti {{.Icon}}"></i> {{.Name}}{{if .Shares}} <i class="ti ti-users" title="freigegeben"></i>{{end}}</a>{{end}}
</div>
{{with .Board}}
<div class="pw-bar">
  <div class="rec-sub">{{if .Description}}{{.Description}} · {{end}}aktualisiert sich jede Minute{{if .OwnerName}} · angelegt von {{.OwnerName}}{{end}}</div>
  <label style="display:inline-flex;gap:6px;align-items:center;font-size:13px;cursor:pointer">
    <input type="checkbox" {{if $.Body.Only}}checked{{end}} onchange="location.href='/plant-watch?b={{.ID}}'+(this.checked?'&only=1':'')"> Nur Auffälliges
  </label>
</div>
<div id="pw-body" hx-get="/plant-watch/{{.ID}}/cards{{if $.Body.Only}}?only=1{{end}}" hx-trigger="every 60s" hx-swap="innerHTML">
  {{template "pw-cards" $.Body}}
</div>
{{end}}

{{else}}
<div class="card pw-empty" style="padding:28px">
  <i class="ti ti-eye" style="font-size:32px"></i>
  <p style="margin:8px 0 14px">Noch keine Schnellübersicht für dich. Lege eine an – z. B. „Trockenkammern“ mit allen Trockenkammern und ihren Motoren, Klappen und Heizungsteilen.</p>
  <a class="btn btn-primary" href="/plant-watch?edit=new"><i class="ti ti-plus"></i> Neue Übersicht</a>
</div>
{{end}}

<script>
function pwFilter(input, id) {
  const q = input.value.trim().toLowerCase();
  document.querySelectorAll('#' + id + ' label').forEach(function (l) {
    l.style.display = !q || (l.dataset.q || l.textContent).toLowerCase().includes(q) ? '' : 'none';
  });
}
</script>
{{end}}
