{{template "base" .}}
{{define "content"}}
<style>
.at-day td{vertical-align:top}
.at-flag{color:var(--amber, #d97706);font-weight:600}
.at-ev{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:3px 0}
.at-ev form{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0}
.at-ev .form-input{width:auto;min-width:0}
details.at-more summary{cursor:pointer;color:var(--muted);font-size:12px}
</style>
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap">
  <div style="flex:1;min-width:220px">
    <h1 style="font-size:18px;font-weight:600"><i class="ti ti-clock-check"></i> Anwesenheit &amp; Arbeitszeit</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">Kommen, Gehen, Pausen und Arbeit an Vorgängen und Anlagen je Person und Tag – aus den Terminals und aus Korrekturen. Personenbezogene Daten: Zugriff nur mit dem Recht „Anwesenheit &amp; Arbeitszeit ansehen“ in der Abteilung der Person; Abstimmung mit Betriebsrat und Datenschutz vorausgesetzt.</p>
  </div>
  <form method="get" action="/attendance" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <label>Von <input class="form-input" type="date" name="von" value="{{.From}}"></label>
    <label>Bis <input class="form-input" type="date" name="bis" value="{{.To}}"></label>
    <select name="person" class="form-input" aria-label="Person"><option value="">Alle Personen</option>{{$p := .Person}}{{range .People}}<option value="{{.ID}}"{{if eq .ID $p}} selected{{end}}>{{.Name}}</option>{{end}}</select>
    <button class="btn btn-small" type="submit">Anzeigen</button>
    <a class="btn btn-small" href="/attendance/export.csv?von={{.From}}&amp;bis={{.To}}&amp;person={{.Person}}"><i class="ti ti-download"></i> CSV</a>
  </form>
</div>
{{if .Notice}}<div class="card" role="status" style="margin-bottom:12px">{{.Notice}}</div>{{end}}
<div class="card">
  {{if .Rows}}
  <div style="overflow-x:auto"><table class="table">
    <thead><tr><th>Datum</th><th>Person</th><th>Kommen</th><th>Gehen</th><th>Pausen</th><th>Anwesenheit</th><th>Arbeit</th><th>Soll (Anlage)</th><th></th></tr></thead>
    <tbody>
    {{range .Rows}}{{$row := .}}
    <tr class="at-day">
      <td>{{.Day}}</td><td>{{.Person}}</td><td>{{if .Kommen}}{{.Kommen}}{{else}}–{{end}}</td>
      <td>{{if .Gehen}}{{.Gehen}}{{else if .Open}}<span class="at-flag">Gehen fehlt</span>{{else}}–{{end}}</td>
      <td>{{.PauseText}}</td><td>{{.PresentText}}</td><td>{{.WorkText}}</td>
      <td>{{if .Planned}}{{.Planned}} <small>({{.Diff}})</small>{{else}}–{{end}}</td>
      <td>
        <details class="at-more"><summary>Buchungen{{if .CanEdit}} &amp; Korrektur{{end}}</summary>
          {{range .Events}}<div class="at-ev"><b>{{.Label}}</b> {{.Time}} <small>({{.Via}})</small>
            {{if $row.CanEdit}}<form method="post" action="/attendance/event/{{.ID}}/edit">
              <select name="kind" class="form-input">{{$k := .Kind}}{{range $.Kinds}}<option value="{{.Key}}"{{if eq .Key $k}} selected{{end}}>{{.Label}}</option>{{end}}</select>
              <input class="form-input" type="datetime-local" name="at" value="{{.Input}}" required>
              <input class="form-input" name="reason" placeholder="Begründung" maxlength="200" required>
              <input type="hidden" name="back_von" value="{{$.From}}"><input type="hidden" name="back_bis" value="{{$.To}}"><input type="hidden" name="back_person" value="{{$.Person}}">
              <button class="btn btn-small" type="submit">Ändern</button>
              <button class="btn btn-small" type="submit" formaction="/attendance/event/{{.ID}}/delete">Löschen</button>
            </form>{{end}}</div>{{end}}
          {{range .Works}}<div class="at-ev"><b>Arbeit</b> {{.What}} {{.Start}}{{if .End}}–{{.End}} ({{.Minutes}} Min.){{else}} läuft{{end}} <small>({{.Via}})</small>
            {{if and $row.CanEdit .End}}<form method="post" action="/attendance/work/{{.ID}}/edit">
              <input class="form-input" type="datetime-local" name="start" value="{{.StartIn}}" required>
              <input class="form-input" type="datetime-local" name="end" value="{{.EndIn}}" required>
              <input class="form-input" name="reason" placeholder="Begründung" maxlength="200" required>
              <input type="hidden" name="back_von" value="{{$.From}}"><input type="hidden" name="back_bis" value="{{$.To}}"><input type="hidden" name="back_person" value="{{$.Person}}">
              <button class="btn btn-small" type="submit">Ändern</button>
              <button class="btn btn-small" type="submit" formaction="/attendance/work/{{.ID}}/delete">Löschen</button>
            </form>{{end}}</div>{{end}}
          {{if .CanEdit}}<div class="at-ev"><form method="post" action="/attendance/event">
            <input type="hidden" name="user" value="{{.PersonID}}">
            <select name="kind" class="form-input">{{range $.Kinds}}<option value="{{.Key}}">{{.Label}}</option>{{end}}</select>
            <input class="form-input" type="datetime-local" name="at" value="{{.DayKey}}T08:00" required>
            <input class="form-input" name="reason" placeholder="Begründung" maxlength="200" required>
            <input type="hidden" name="back_von" value="{{$.From}}"><input type="hidden" name="back_bis" value="{{$.To}}"><input type="hidden" name="back_person" value="{{$.Person}}">
            <button class="btn btn-small" type="submit">Nachtragen</button>
          </form></div>{{end}}
        </details>
      </td>
    </tr>{{end}}
    </tbody>
  </table></div>
  {{else}}<div class="rec-sub" style="padding:8px 0">Im gewählten Zeitraum gibt es keine Buchungen.</div>{{end}}
</div>
<div class="card" style="margin-top:14px">
  <h2 style="font-size:14px;font-weight:600;margin-bottom:8px">Verlauf der Korrekturen</h2>
  {{if .Hist}}<div style="overflow-x:auto"><table class="table"><thead><tr><th>Wann</th><th>Person</th><th>Art</th><th>Aktion</th><th>Vorher</th><th>Nachher</th><th>Begründung</th><th>Von</th></tr></thead><tbody>
    {{range .Hist}}<tr><td>{{.At}}</td><td>{{.Person}}</td><td>{{.Subject}}</td><td>{{.Action}}</td><td>{{.Old}}</td><td>{{.New}}</td><td>{{.Reason}}</td><td>{{.By}}</td></tr>{{end}}
  </tbody></table></div>{{else}}<div class="rec-sub">Noch keine Korrekturen.</div>{{end}}
</div>
{{end}}
