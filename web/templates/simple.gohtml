{{template "base" .}}
{{define "content"}}
<div style="padding:40px;text-align:center;color:var(--muted)">
  <i class="ti ti-tools" style="font-size:48px;display:block;margin-bottom:16px"></i>
  <h2 style="font-size:18px;font-weight:500;color:var(--text)">{{.Title}}</h2>
  <p style="margin-top:8px;font-size:13px">Seite wird gebaut...</p>
</div>
{{end}}
{{define "context-list"}}{{end}}
