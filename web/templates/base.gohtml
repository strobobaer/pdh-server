<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f1117">
<meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black">
<title>{{or .Brand.AppName "PDH"}} – {{.Title}}</title>
{{if .Brand.AppLogo}}<link rel="icon" href="{{.Brand.AppLogo}}"><link rel="manifest" href="/site.webmanifest">{{else}}<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">{{end}}
<script>
window.PDH_LOCALE = ({de:'de-DE', en:'en-GB', ro:'ro-RO', tr:'tr-TR', mk:'mk-MK'})[document.documentElement.lang] || 'de-DE';
(function(){
  const mode = localStorage.getItem('pdh_theme') || 'system';
  const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.dataset.theme = mode === 'system' ? (systemDark ? 'dark' : 'light') : mode;
  document.documentElement.dataset.themeMode = mode;
  window.PDH_TERMINAL_INFRA = {{.TerminalInfraID}}; // Standort dieses Terminals (Infra-Picker)
  // Darstellung: am Benutzerkonto gespeichert (leer/0 = Firmenstandard)
  window.PDH_LOOK_DEFAULT = {palette: {{.Brand.ThemeID}}, font: {{.Brand.FontID}}, scale: {{.Brand.ScaleValue}}};
  window.PDH_LOOK_SAVED = {palette: {{.Look.User.Palette}}, font: {{.Look.User.Font}}, scale: {{.Look.User.Scale}}};
  window.PDH_LOOK_ALLOW = {{.Look.Allow}};
  window.PDH_PALETTES = {{.Brand.PaletteIDs}};
  document.documentElement.dataset.palette = {{.Look.PaletteID}};
  try { localStorage.removeItem('pdh_palette'); } catch(e) {} // frueher im Browser gespeichert
  if(localStorage.getItem('pdh_sidebar_left') !== 'expanded' && !window.matchMedia('(max-width:760px)').matches) document.documentElement.classList.add('sidebar-left-collapsed');
  // per Ziehen eingestellte Breiten der Seitenleisten (pdhResizer)
  try {
    const wl = parseInt(localStorage.getItem('pdh_sidebar_left_w'), 10), wr = parseInt(localStorage.getItem('pdh_sidebar_right_w'), 10);
    if(wl >= 160 && wl <= 480) document.documentElement.style.setProperty('--left-open-w', wl + 'px');
    if(wr >= 220 && wr <= 760) document.documentElement.style.setProperty('--right-open-w', wr + 'px');
  } catch(e) {}
  // Rechte Seitenleiste startet immer eingeklappt (nur die senkrechten Reiter
  // sind sichtbar); sie oeffnet sich per Reiter, Chat-Anforderung oder neuer Nachricht.
  document.documentElement.classList.add('sidebar-right-collapsed');
  // Eingebettete Ansicht (PDH-Viewer): window.name bleibt bei Navigation
  // im iframe erhalten, daher bleiben auch Folgeseiten ohne Navigation.
  if(window.name === 'pdh-embed' || /[?&]embed=1(&|$)/.test(location.search)) document.documentElement.classList.add('pdh-embedded');
})();
</script>
<script src="https://unpkg.com/htmx.org@1.9.12/dist/htmx.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.30.0/dist/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0f1117;--bg2:#1a1d27;--bg3:#222536;
  --accent:#4f6ef7;--accent2:#7c3aed;--accent-rgb:79,110,247;--on-accent:#fff;
  --text:#e8eaf6;--muted:#6b7280;--border:#2a2d3e;
  --green:#10b981;--amber:#f59e0b;--red:#ef4444;
  --font:'DM Sans',system-ui,sans-serif;
  --left-open-w:200px;--right-open-w:260px;
  --left-sidebar-w:var(--left-open-w);--right-sidebar-w:var(--right-open-w)
}
html[data-theme="light"]{
  --bg:#f5f7fb;--bg2:#ffffff;--bg3:#eef2f7;
  --accent:#3457d5;--accent2:#6d28d9;--accent-rgb:52,87,213;--on-accent:#fff;
  --text:#111827;--muted:#64748b;--border:#d7dee8;
  --green:#059669;--amber:#d97706;--red:#dc2626
}
body{background:var(--bg);color:var(--text);font-family:var(--font);display:flex;flex-direction:column;height:100vh;overflow:hidden}
a{color:inherit;text-decoration:none}
.app{display:grid;grid-template-columns:var(--left-sidebar-w) 1fr var(--right-sidebar-w);flex:1;overflow:hidden;transition:grid-template-columns .18s ease;position:relative}
/* Breite der Seitenleisten per Ziehen (pdhResizer) */
.pdh-resizer{position:absolute;top:0;bottom:0;width:8px;z-index:60;cursor:col-resize;touch-action:none;outline:none}
.pdh-resizer::after{content:"";position:absolute;top:0;bottom:0;left:3px;width:2px;background:transparent;transition:background .12s}
.pdh-resizer:hover::after,.pdh-resizer:focus-visible::after,html.pdh-resizing .pdh-resizer.on::after{background:var(--accent)}
.pdh-resizer.left{left:calc(var(--left-sidebar-w) - 4px)}
.pdh-resizer.right{right:calc(var(--right-sidebar-w) - 4px)}
html.sidebar-left-collapsed .pdh-resizer.left,html.sidebar-right-collapsed .pdh-resizer.right,html.pdh-embedded .pdh-resizer{display:none}
html.pdh-resizing,html.pdh-resizing *{cursor:col-resize!important;user-select:none!important}
html.pdh-resizing .app{transition:none}
html.pdh-resizing iframe{pointer-events:none}
html.pdh-embedded .app{grid-template-columns:1fr}
html.pdh-embedded .sidebar,html.pdh-embedded .context,html.pdh-embedded .topbar{display:none}
html.pdh-embedded .main{padding:14px}
/* ── PDH-Viewer (iframe-Overlay) ── */
.pdh-frame{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.6);display:flex;align-items:stretch;justify-content:flex-end}
.pdh-frame-panel{background:var(--bg);border-left:1px solid var(--border);width:min(1100px,100%);display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.35)}
.pdh-frame-panel.wide{width:100%}
.pdh-frame-head{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--border);background:var(--bg2)}
.pdh-frame-title{flex:1;min-width:0;font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pdh-frame-hint{font-size:11px;color:var(--muted);padding:6px 12px;border-bottom:1px solid var(--border);background:var(--bg3)}
.pdh-frame iframe{flex:1;width:100%;border:0;background:var(--bg)}
/* ── Stammdaten-Detailseiten mit Reitern (gemeinsam fuer alle Module) ── */
.rec-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.rec-head .t{flex:1;min-width:200px}
.rec-head h1{font-size:18px;font-weight:600}
.rec-head .sub{font-size:12px;color:var(--muted);margin-top:3px}
.rec-img{width:54px;height:54px;border-radius:10px;object-fit:cover;border:1px solid var(--border);background:var(--bg3)}
.rec-tabs{display:flex;gap:2px;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-bottom:14px}
.rec-tab{padding:8px 12px;font-size:12.5px;color:var(--muted);border:0;background:none;border-bottom:2px solid transparent;cursor:pointer;font-family:var(--font);display:inline-flex;gap:6px;align-items:center;text-decoration:none}
.rec-tab:hover{color:var(--text)}
.rec-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.rec-tab b{font-weight:500;font-size:10px;background:var(--bg3);border-radius:999px;padding:1px 6px;color:var(--muted)}
.rec-pane{display:none}.rec-pane.active{display:block}
.rec-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;align-items:start}
.rec-f{display:flex;gap:10px;padding:5px 0;border-bottom:1px solid var(--border);font-size:12.5px}
.rec-f:last-child{border:0}
.rec-l{width:150px;flex-shrink:0;color:var(--muted);font-size:12px}
.rec-v{flex:1;min-width:0;word-break:break-word;white-space:pre-wrap}
.rec-v a{color:var(--accent)}
.rec-sec{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 8px}
.rec-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:12.5px}
.rec-row:last-child{border:0}
.rec-row .grow{flex:1;min-width:0}
.rec-sub{font-size:11px;color:var(--muted)}
.rec-msg{font-size:12px;padding:8px 12px;border-radius:8px;margin-bottom:12px}
.rec-msg.ok{background:rgba(16,185,129,.12);color:var(--green)}
.rec-msg.err{background:rgba(239,68,68,.12);color:var(--red)}
.rec-form .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 12px}
.rec-compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:700px){.rec-compare{grid-template-columns:1fr}.rec-l{width:120px}}
.list-tabs{display:flex;gap:2px;overflow-x:auto;border-bottom:1px solid var(--border);margin-bottom:12px;scrollbar-width:thin}
.list-tabs a{padding:8px 12px;font-size:12.5px;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap;display:inline-flex;gap:6px;align-items:center}
.list-tabs a.active{color:var(--accent);border-bottom-color:var(--accent)}
.list-tabs a b{font-weight:500;font-size:10px;background:var(--bg3);border-radius:999px;padding:1px 6px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:block}
a.kpi:hover{border-color:var(--accent)}
.kpi .v{font-size:22px;font-weight:600}
.kpi .l{font-size:11px;color:var(--muted);margin-top:2px}
/* ── Chat: Ungelesen-Zaehler & Hinweis ── */
.nav-badge{margin-left:auto;min-width:18px;height:18px;border-radius:9px;background:var(--red);color:#fff;font-size:10.5px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;padding:0 5px}
html.sidebar-left-collapsed .nav-badge{position:absolute;top:4px;right:6px;margin:0}
/* Zeitstrahl (frappe-gantt): dessen CSS wird erst spaeter auf der Seite geladen
   und ist fest hell - daher mit .gantt-container vorneweg, damit diese Regeln
   gewinnen und der Zeitstrahl Hell/Dunkel folgt. */
.gantt-container{background:transparent}
.gantt-container .gantt .grid-background{fill:none}
.gantt-container .gantt .grid-header{fill:var(--bg2);stroke:var(--border)}
.gantt-container .gantt .grid-row{fill:var(--bg2)}
.gantt-container .gantt .grid-row:nth-child(even){fill:var(--bg3)}
.gantt-container .gantt .row-line,.gantt-container .gantt .tick,.gantt-container .gantt .tick.thick{stroke:var(--border)}
.gantt-container .gantt .today-highlight{fill:var(--accent);opacity:.14}
.gantt-container .gantt .arrow{stroke:var(--muted)}
.gantt-container .gantt .bar-label{fill:#fff}
.gantt-container .gantt .bar-label.big{fill:var(--text)}
.gantt-container .gantt .upper-text{fill:var(--muted)}
.gantt-container .gantt .lower-text{fill:var(--text)}
.gantt-container .popup-wrapper{background:var(--bg2);border:1px solid var(--border);box-shadow:0 8px 24px rgba(0,0,0,.35)}
.gantt-container .popup-wrapper .title{border-bottom:2px solid var(--accent);color:var(--text)}
.gantt-container .popup-wrapper .subtitle{color:var(--muted)}
.gantt-container .popup-wrapper .pointer{border-top-color:var(--bg2)}
.chat-toast{position:fixed;right:18px;bottom:18px;z-index:550;width:min(340px,calc(100vw - 32px));background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:10px;padding:10px 12px;box-shadow:0 10px 30px rgba(0,0,0,.3);cursor:pointer;font-size:12.5px}
.chat-toast b{display:block;font-size:13px;margin-bottom:2px}
.chat-toast span{color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
html.sidebar-left-collapsed{--left-sidebar-w:54px}
html.sidebar-right-collapsed{--right-sidebar-w:54px}
/* ── Sidebar ── */
.sidebar{background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto}
.logo{padding:12px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border)}
.logo-icon{width:30px;height:30px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:var(--on-accent);flex-shrink:0}
.logo-text{font-size:14px;font-weight:600}
.logo-ver{font-size:10px;color:var(--muted)}
.sidebar-toggle{width:44px;min-width:44px;height:44px;border:1px solid var(--border);border-radius:8px;background:var(--bg3);color:var(--text);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.sidebar-toggle:hover{border-color:var(--muted);background:var(--bg2)}
.sidebar-toggle i{font-size:18px}
nav{padding:12px 0;flex:1}
.nav-section{padding:12px 16px 4px;font-size:10px;font-weight:600;letter-spacing:1.4px;color:var(--muted);text-transform:uppercase}
.nav-fold{display:flex;align-items:center;width:100%;background:none;border:0;cursor:pointer;font-family:inherit;text-align:left}
.nav-fold:hover{color:var(--text)}
.nav-fold i{margin-left:auto;font-size:13px;transition:transform .15s}
.nav-fold[aria-expanded="false"] i{transform:rotate(-90deg)}
.nav-group.folded{display:none}
.nav-edit-bar{padding:10px 12px 14px;border-top:1px solid var(--border);margin-top:8px}
.nav-edit-btn{display:flex;align-items:center;gap:8px;width:100%;background:none;border:0;color:var(--muted);font:inherit;font-size:12px;cursor:pointer;padding:4px}
.nav-edit-btn:hover{color:var(--text)}
.nav-edit-tools{display:flex;gap:4px;flex-wrap:wrap}
.nav-edit-tools button{flex:1;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font:inherit;font-size:11px;padding:5px 6px;cursor:pointer;white-space:nowrap}
.nav-edit-tools button.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent,#fff)}
.nav-edit-hint{font-size:10.5px;color:var(--muted);margin-top:6px}
html.nav-editing .nav-group{display:block!important;min-height:26px;border:1px dashed var(--border);border-radius:6px;margin:2px 8px 6px;padding:2px 0}
html.nav-editing .nav-group[data-fold-group="top"]{border-style:dotted}
html.nav-editing .nav-item{cursor:grab}
html.nav-editing .nav-fold i{display:none}
.nav-gl-input{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--text);font:inherit;font-size:11px;padding:2px 6px;text-transform:none;letter-spacing:0}
.nav-gdel{background:none;border:0;color:var(--muted);cursor:pointer;padding:0 0 0 6px}
.nav-ghost{opacity:.4}
html.sidebar-left-collapsed .nav-edit-bar{display:none}
html:not(.nav-editing) .nav-edit-bar{display:none}
html.sidebar-left-collapsed .nav-group.folded{display:block}
.nav-item{display:flex;align-items:center;gap:9px;padding:7px 16px;font-size:12.5px;color:var(--muted);border-left:2px solid transparent;transition:all .15s}
.nav-item:hover{color:var(--text);background:var(--bg3)}
.nav-item.active{color:var(--accent);background:rgba(var(--accent-rgb),.08);border-left-color:var(--accent)}
.nav-item i{font-size:16px;width:18px;text-align:center;flex-shrink:0}
html.sidebar-left-collapsed .sidebar{overflow:hidden}
html.sidebar-left-collapsed .logo{padding:5px;justify-content:center;flex-wrap:wrap}
html.sidebar-left-collapsed .logo > div:not(.logo-icon),html.sidebar-left-collapsed .nav-section,html.sidebar-left-collapsed .nav-label{display:none}
html.sidebar-left-collapsed .nav-item{justify-content:center;padding:10px 0;border-left-width:0;border-right:2px solid transparent}
html.sidebar-left-collapsed .nav-item.active{border-right-color:var(--accent)}
/* ── Topbar ── */
.topbar{height:46px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 22px;gap:8px;flex-shrink:0}
.topbar-path{font-size:12px;color:var(--muted)}
.topbar-cur{font-size:13px;font-weight:500}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);margin-left:auto;box-shadow:0 0 0 3px rgba(16,185,129,.2)}
.topbar-clock{display:inline-flex;align-items:center;gap:7px;height:44px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg3);color:var(--text);font-size:12.5px;white-space:nowrap;font-variant-numeric:tabular-nums}
.topbar-clock:hover{border-color:var(--accent)}
.topbar-clock i{font-size:16px;color:var(--accent)}
.topbar-clock .clk-day,.topbar-clock .clk-date{color:var(--muted)}
.topbar-clock .clk-time{font-weight:600;font-size:13.5px}
.topbar-user{height:44px;padding:0 14px;border:1px solid var(--border);border-radius:8px;background:var(--bg3);color:var(--text);display:inline-flex;align-items:center;gap:8px;font-size:13px;font-family:var(--font);cursor:pointer;white-space:nowrap}
.topbar-user:hover{border-color:var(--muted);background:var(--bg2)}
.topbar-user i{font-size:16px;color:var(--accent)}
/* ── Main ── */
.main-wrap{display:flex;flex-direction:column;overflow:hidden;min-width:0} /* min-width:0: breite Tabellen duerfen die Spalte nicht aufblaehen */
.main{flex:1;overflow-y:auto;padding:22px}
/* ── Context ── */
.context{background:var(--bg2);border-left:1px solid var(--border);display:grid;grid-template-columns:44px 1fr;overflow:hidden;min-width:0}
.ctx-tabs{border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;gap:6px;padding:6px 5px;background:var(--bg2)}
.ctx-tab{width:34px;height:34px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.ctx-tab:hover,.ctx-tab.active{color:var(--accent);background:var(--bg3);border-color:var(--border)}
.ctx-tab i{font-size:17px}
.ctx-panel-wrap{display:flex;flex-direction:column;min-width:0;overflow:hidden}
.ctx-section{border-bottom:1px solid var(--border);padding:14px;flex-shrink:0;display:none}
.ctx-section.active{display:block}
.ctx-section.grow.active{flex:1;overflow-y:auto}
html.sidebar-right-collapsed .context{grid-template-columns:54px}
html.sidebar-right-collapsed .ctx-tabs{padding:5px}
html.sidebar-right-collapsed .ctx-panel-wrap{display:none}
/* Senkrechte Reiter der rechten Seitenleiste (auch im eingeklappten Zustand sichtbar) */
.ctx-tab{height:auto;min-height:34px;flex-direction:column;gap:6px;padding:8px 0;position:relative}
.ctx-vlabel{writing-mode:vertical-rl;font-size:11px;letter-spacing:.4px;white-space:nowrap;max-height:120px;overflow:hidden;text-overflow:ellipsis}
.ctx-badge{position:absolute;top:-4px;right:-6px;min-width:17px;height:17px;border-radius:9px;background:var(--accent);color:var(--on-accent);font-size:10px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;padding:0 4px}
html.ctx-chat-open:not(.sidebar-right-collapsed){--right-sidebar-w:max(380px, var(--right-open-w))}
/* Chat in der Seitenleiste */
.ctx-section.sc-panel{padding:0}
.ctx-section.sc-panel.active{display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden}
.sc-head{display:flex;align-items:center;gap:6px;padding:10px 10px 8px;border-bottom:1px solid var(--border)}
.sc-htitle{flex:1;min-width:0;font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sc-btn{width:30px;height:30px;border:1px solid var(--border);border-radius:7px;background:var(--bg3);color:var(--text);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.sc-btn:hover{border-color:var(--accent);color:var(--accent)}
.sc-body{flex:1;overflow-y:auto;padding:8px 10px;display:flex;flex-direction:column;gap:2px;min-height:0}
.sc-empty{color:var(--muted);font-size:12px;text-align:center;padding:24px 8px}
.sc-item{display:flex;align-items:center;gap:8px;padding:7px 6px;border-radius:8px;cursor:pointer}
.sc-item:hover{background:var(--bg3)}
.sc-item.unread .sc-n{font-weight:700}
.sc-av{width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:600;flex-shrink:0}
.sc-t{flex:1;min-width:0}
.sc-n{font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sc-p{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sc-meta{display:flex;flex-direction:column;align-items:flex-end;gap:3px;font-size:10px;color:var(--muted)}
.sc-badge{min-width:17px;height:17px;border-radius:9px;background:var(--accent);color:var(--on-accent);font-size:10px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;padding:0 4px}
.sc-msg{max-width:88%;align-self:flex-start;margin:3px 0}
.sc-msg.mine{align-self:flex-end;text-align:right}
.sc-who{font-size:10.5px;color:var(--muted);margin-bottom:1px}
.sc-bubble{display:inline-block;text-align:left;background:var(--bg3);border:1px solid var(--border);border-radius:4px 10px 10px 10px;padding:6px 9px;font-size:12.5px;line-height:1.4;white-space:pre-wrap;overflow-wrap:anywhere}
.sc-msg.mine .sc-bubble{background:rgba(var(--accent-rgb),.16);border-color:rgba(var(--accent-rgb),.3);border-radius:10px 4px 10px 10px}
.sc-bubble a{color:var(--accent);text-decoration:underline}
.sc-mention{color:var(--accent)}
.sc-card{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:11.5px;border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:7px;padding:4px 8px;background:var(--bg2);text-align:left}
.sc-time{font-size:9.5px;color:var(--muted);margin-top:1px}
.sc-sys{align-self:center;font-size:10.5px;color:var(--muted);margin:6px 0;text-align:center}
.sc-compose{display:flex;gap:6px;align-items:flex-end;padding:8px 10px;border-top:1px solid var(--border)}
.sc-compose textarea{flex:1;resize:none;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:var(--font);font-size:12.5px;padding:6px 8px;max-height:120px}
.sc-compose textarea:focus{outline:0;border-color:var(--accent)}
.sc-send{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.sc-share{margin:8px 10px 0;padding:8px 10px;border-radius:8px;background:rgba(var(--accent-rgb),.12);color:var(--accent);font-size:11.5px;display:flex;gap:6px;align-items:flex-start}
/* Kontexthilfe (Handbuchkapitel in der Seitenleiste) */
.ctx-section[data-context-panel="help"].active{flex:1;overflow-y:auto}
.ctx-help{font-size:12px;line-height:1.55}
.ctx-help h2{font-size:13px;font-weight:600;margin:0 0 6px;display:flex;gap:6px;align-items:center}
.ctx-help h3{font-size:12px;font-weight:600;margin:10px 0 4px}
.ctx-help p{margin:4px 0}
.ctx-help ul,.ctx-help ol{margin:4px 0 4px 16px}
.ctx-help table{font-size:11.5px}
.ctx-help td{padding:3px 4px;vertical-align:top}
.ctx-help code,.ctx-help kbd{font-size:11px;background:var(--bg3);padding:0 4px;border-radius:3px}
.ctx-help .hb-tip,.ctx-help .hb-warn{border-left:3px solid var(--accent);background:rgba(var(--accent-rgb),.08);padding:6px 8px;border-radius:6px;margin:8px 0}
.ctx-help .hb-auto{font-size:10px;color:var(--muted);font-weight:400}
.ctx-title{font-size:10px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:flex;align-items:center;gap:6px}
.ctx-title i{font-size:14px}
/* ── Search ── */
.search-box{display:flex;align-items:center;gap:7px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:6px 10px}
.search-box input{background:none;border:0;outline:0;color:var(--text);font-size:12px;width:100%;font-family:var(--font)}
.search-box i{color:var(--muted);font-size:15px}
/* ── Copilot ── */
.copilot-msgs{background:var(--bg3);border:1px solid var(--border);border-radius:8px;min-height:70px;max-height:320px;overflow-y:auto;padding:10px;margin-bottom:8px;font-size:12px;line-height:1.5}
.cop-hint{color:var(--muted);font-style:italic;font-size:11px}
.cop-q{color:var(--accent);margin-bottom:4px}
.cop-a{color:var(--text);white-space:pre-wrap;margin-bottom:6px}
.copilot-input{display:flex;gap:6px}
.copilot-input input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:5px 9px;color:var(--text);font-size:11px;outline:0;font-family:var(--font)}
.cop-btn{background:var(--accent);border:0;border-radius:6px;padding:5px 10px;color:var(--on-accent);font-size:11px;cursor:pointer;font-family:var(--font);white-space:nowrap}
/* ── Activity ── */
.act-item{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border);font-size:12px}
.act-item:last-child{border:0;padding-bottom:0}
.act-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.d-red{background:var(--red)}.d-amber{background:var(--amber)}.d-green{background:var(--green)}.d-blue{background:var(--accent)}
.act-text{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted)}
.act-time{font-size:10px;color:var(--muted);flex-shrink:0}
/* ── Stats ── */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
.stat{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:13px}
.stat-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;margin-bottom:6px}
.stat-val{font-size:22px;font-weight:600;letter-spacing:-.5px}
.stat-sub{font-size:11px;color:var(--muted);margin-top:3px}
.s-blue .stat-val{color:var(--accent)}
.s-red .stat-val{color:var(--red)}
.s-amber .stat-val{color:var(--amber)}
.s-green .stat-val{color:var(--green)}
/* ── Cards ── */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:12px}
.card-title{font-size:12px;font-weight:600;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.card-action{color:var(--muted);font-size:11px;font-weight:400}
.card-action:hover{color:var(--accent)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
/* ── Badges ── */
.badge{display:inline-flex;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:500;white-space:nowrap}
.b-red{background:rgba(239,68,68,.15);color:#fca5a5}
.b-amber{background:rgba(245,158,11,.15);color:#fcd34d}
.res-q{color:var(--amber);font-weight:600;font-size:.92em}
.b-green{background:rgba(16,185,129,.15);color:#6ee7b7}
.b-blue{background:rgba(var(--accent-rgb),.15);color:#a5b4fc}
.b-gray{background:rgba(107,114,128,.15);color:#9ca3af}
/* ── List items ── */
.li{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px}
.li:last-child{border:0;padding-bottom:0}
.li-text{flex:1;min-width:0}
.li-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500}
.li-sub{font-size:10px;color:var(--muted);margin-top:1px}
/* ── Table ── */
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:8px 12px;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border)}
td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:middle}
tr:hover td{background:var(--bg3)}
tr:last-child td{border:0}
/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border-radius:8px;font-size:13px;font-family:var(--font);line-height:1;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text);transition:all .15s}
.btn:hover{background:var(--bg2);border-color:var(--muted)}
.btn-primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.btn-primary:hover{opacity:.9}
.btn-success{background:var(--green);border-color:var(--green);color:#fff}
.btn-warning{background:var(--amber);border-color:var(--amber);color:#111827}
.btn-danger{background:var(--red);border-color:var(--red);color:#fff}
.btn-success:hover,.btn-warning:hover,.btn-danger:hover{filter:brightness(.96)}
.btn-icon{width:44px;min-width:44px;height:44px;padding:0;justify-content:center;gap:0;flex-shrink:0}
.btn-icon i{font-size:18px}
.btn-icon-glyph{display:none;font-weight:700;font-size:13px;line-height:1;min-width:18px;text-align:center}
.btn-icon-labeled{width:auto;min-width:44px;padding:0 14px;gap:8px}
.btn-icon-label{font-size:13px;font-weight:600;line-height:1;white-space:nowrap}
.btn-small{min-height:40px;padding:0 12px;font-size:12px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.theme-toggle{height:44px;padding:0 14px;border:1px solid var(--border);border-radius:8px;background:var(--bg3);color:var(--text);display:inline-flex;align-items:center;gap:8px;font-size:13px;font-family:var(--font);cursor:pointer}
.theme-toggle:hover{border-color:var(--muted);background:var(--bg2)}
.theme-toggle i{font-size:16px;color:var(--accent)}
html.icons-fallback .ti::before{font-family:var(--font);font-weight:700;display:inline-block;line-height:1}
html.icons-fallback .ti-plus::before{content:"+"}
html.icons-fallback .ti-refresh::before{content:"R"}
html.icons-fallback .ti-x::before{content:"x"}
html.icons-fallback .ti-device-floppy::before{content:"S"}
html.icons-fallback .ti-arrow-left::before{content:"<"}
html.icons-fallback .ti-send::before{content:">"}
html.icons-fallback .ti-filter::before{content:"F"}
html.icons-fallback .ti-eye::before{content:"O"}
html.icons-fallback .ti-brain::before{content:"AI";font-size:.72em}
html.icons-fallback .ti-pencil::before{content:"E"}
html.icons-fallback .ti-copy::before{content:"C"}
html.icons-fallback .ti-circle-arrow-up::before{content:"^"}
html.icons-fallback .ti-circle-arrow-down::before{content:"v"}
html.icons-fallback .ti-check::before{content:"✓"}
html.icons-fallback .ti-circle-check::before{content:"✓"}
html.icons-fallback .ti-trash::before{content:"D"}
html.icons-fallback .ti-trash-x::before{content:"Dx";font-size:.72em}
html.icons-fallback .ti-player-play::before{content:">"}
html.icons-fallback .ti-player-stop::before{content:"[]";font-size:.72em}
html.icons-fallback .ti-device-desktop::before{content:"[]";font-size:.72em}
html.icons-fallback .ti-sun::before{content:"*"}
html.icons-fallback .ti-moon::before{content:"("}
html.icons-fallback .ti-menu-2::before{content:"="}
html.icons-fallback .ti-help::before{content:"?"}
html.icons-fallback .ti-photo-check::before{content:"P"}
html.icons-fallback .ti-file-description::before{content:"F"}
html.icons-fallback .btn .ti{display:none}
html.icons-fallback .btn-icon-glyph{display:inline-flex;align-items:center;justify-content:center}
.widget-icon-toolbar{display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap}
.widget-icon-toolbar.end{justify-content:flex-end}
.widget-icon-toolbar.compact{gap:4px}
.selectable-item{cursor:pointer}
.selectable-item.is-selected{background:rgba(var(--accent-rgb),.12);outline:2px solid rgba(var(--accent-rgb),.45);outline-offset:-2px;border-radius:8px}
.selectable-item.is-selected td{background:rgba(var(--accent-rgb),.12)}
/* Aufklappbare Listenzeilen (data-rx): Klick klappt auf, darunter Ansehen / Bearbeiten / Fertigstellen */
[data-rx]{cursor:pointer}
[data-rx]:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
[data-rx].rx-open,tr[data-rx].rx-open td{background:rgba(var(--accent-rgb),.08)}
tr.rx-panel td{padding:0!important;background:rgba(var(--accent-rgb),.05);border-bottom:1px solid var(--border)}
div.rx-panel{background:rgba(var(--accent-rgb),.05);border-bottom:1px solid var(--border);border-radius:0 0 8px 8px}
.rx-box{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 14px}
.rx-box .btn{font-size:12px}
.rx-desc{flex-basis:100%;font-size:12px;color:var(--muted);white-space:pre-wrap;word-break:break-word;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.rx-box .grow{flex:1}
.global-footer{height:34px;background:var(--bg2);border-top:1px solid var(--border);display:grid;grid-template-columns:minmax(180px,1fr) minmax(220px,420px) minmax(180px,1fr);align-items:center;gap:14px;padding:0 18px;font-size:12px;color:var(--muted);flex-shrink:0}
.footer-status-left,.footer-status-error{display:flex;align-items:center;gap:8px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.footer-status-error{justify-content:flex-end}
.footer-status-dot{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,.14);flex-shrink:0}
.footer-progress{height:8px;border-radius:999px;background:var(--bg3);border:1px solid var(--border);overflow:hidden}
.footer-progress-fill{height:100%;width:0%;border-radius:inherit;background:var(--green);transition:width .2s ease,background .2s ease}
.global-footer.busy .footer-status-dot,.global-footer.busy .footer-progress-fill{background:var(--accent)}
.global-footer.warn .footer-status-dot,.global-footer.warn .footer-progress-fill{background:var(--amber)}
.global-footer.error .footer-status-dot,.global-footer.error .footer-progress-fill{background:var(--red)}
.global-footer.ok .footer-status-dot,.global-footer.ok .footer-progress-fill{background:var(--green)}
.attachment-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:10px;margin-bottom:12px;min-height:20px;width:100%}
.attachment-card{border:1px solid var(--border);border-radius:8px;background:var(--bg3);overflow:hidden;min-width:0}
.attachment-preview{height:96px;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--muted);position:relative}
.attachment-preview img{width:100%;height:100%;object-fit:cover;display:block}
.attachment-preview i{font-size:30px}
.attachment-meta{padding:8px;display:flex;flex-direction:column;gap:7px}
.attachment-name{font-size:11px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.attachment-actions{display:flex;gap:6px;flex-wrap:wrap}
.attachment-actions .btn{min-height:34px;padding:0 9px;font-size:11px}
.attachment-badge{position:absolute;left:6px;top:6px;background:rgba(16,185,129,.92);color:#fff;border-radius:999px;padding:3px 7px;font-size:10px;font-weight:700}
.attachment-badge.doc{background:rgba(var(--accent-rgb),.92);color:var(--on-accent)}
.attachment-src{font-size:10.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.attachment-src a{color:var(--accent)}
.widget-field{margin-bottom:14px}
.infra-picker-widget{grid-column:1/-1}
.infra-picker{border:1px solid var(--border);border-radius:8px;background:var(--bg3);padding:8px}
.infra-picker-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.infra-picker-selected{flex:1;min-width:0;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.infra-picker-search{margin-bottom:8px}
.infra-picker-tree{max-height:230px;overflow:auto;font-size:12px;color:var(--muted)}
.infra-picker-empty{font-size:12px;color:var(--muted);padding:8px}
.infra-picker-node{margin-left:var(--depth,0)}
.infra-picker-row{display:flex;align-items:center;gap:4px}
.infra-picker-row.is-focus .infra-picker-select{background:rgba(var(--accent-rgb),.12);box-shadow:inset 3px 0 0 var(--accent);font-weight:600}
.infra-picker-toggle{width:24px;height:24px;border:0;background:transparent;color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.infra-picker-toggle i{font-size:14px;transition:transform .15s}
.infra-picker-toggle[aria-expanded="true"] i{transform:rotate(90deg)}
.infra-picker-spacer{width:24px;height:24px;display:inline-block;flex-shrink:0}
.infra-picker-select{flex:1;text-align:left;background:transparent;border:0;color:var(--text);padding:6px;border-radius:6px;cursor:pointer;min-width:0;font:inherit}
.infra-picker-select:hover{background:rgba(var(--accent-rgb),.1)}
.infra-picker-type{color:var(--muted);font-size:10px}
/* ── Forms ── */
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}
.form-input{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px 12px;color:var(--text);font-size:13px;font-family:var(--font);outline:0}
.form-input:focus{border-color:var(--accent)}
select.form-input option{background:var(--bg2)}
/* ── Shift ── */
.shift-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:6px}
.shift-day{text-align:center;font-size:10px}
.shift-day-name{color:var(--muted);margin-bottom:3px}
.shift-pill{padding:3px;border-radius:5px;font-size:10px;font-weight:500;text-align:center}
.sf{background:rgba(16,185,129,.2);color:#6ee7b7}
.outlook-busy{background:rgba(245,158,11,.18);color:#f5c451}
.ss{background:rgba(245,158,11,.2);color:#fcd34d}
.sn{background:rgba(99,102,241,.2);color:#a5b4fc}
.se{background:var(--bg3);color:var(--muted)}
/* ── HTMX loading ── */
.htmx-indicator{display:none}
.htmx-request .htmx-indicator{display:inline}
.htmx-request.htmx-indicator{display:inline}

@keyframes blink-red-anim { 0%,100%{background:rgba(239,68,68,.05)} 50%{background:rgba(239,68,68,.35)} }
@keyframes blink-yellow-anim { 0%,100%{background:rgba(245,158,11,.05)} 50%{background:rgba(245,158,11,.35)} }
@keyframes blink-purple-anim { 0%,100%{background:rgba(124,58,237,.05)} 50%{background:rgba(124,58,237,.35)} }
.blink-red{animation:blink-red-anim 1.2s ease-in-out infinite;border-radius:6px}
.blink-yellow{animation:blink-yellow-anim 1.2s ease-in-out infinite;border-radius:6px}
.blink-purple{animation:blink-purple-anim 1.2s ease-in-out infinite;border-radius:6px}

/* ── Rechtsklick-Kontextmenü (Win11-Stil): projektweite Komponente, ── */
/* ── siehe showContextMenu() im globalen Script weiter unten.       ── */
@keyframes win11-menu-in{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
.win11-menu{position:fixed;z-index:500;min-width:200px;max-width:280px;padding:4px;border-radius:8px;
  background:color-mix(in srgb, var(--bg2) 88%, transparent);backdrop-filter:blur(20px) saturate(1.3);-webkit-backdrop-filter:blur(20px) saturate(1.3);
  border:1px solid var(--border);box-shadow:0 8px 28px rgba(0,0,0,.32),0 1px 3px rgba(0,0,0,.22);
  font-size:13px;transform-origin:0 0;animation:win11-menu-in .12s ease-out}
.pal-menu{border-top:1px solid var(--border);margin-top:4px;padding:8px 10px 6px;min-width:230px;cursor:default}
.look-row{display:flex;align-items:center;gap:6px;margin:6px 0}
.look-row select{flex:1;min-width:0;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font:inherit;font-size:12px;padding:4px 6px}
.look-step{width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:var(--bg3);color:var(--text);cursor:pointer;font-size:15px;line-height:1}
.look-pct{min-width:48px;text-align:center;font-size:12.5px;font-weight:600}
.look-actions{display:flex;gap:6px;margin-top:8px}
.look-actions button{flex:1;font-size:12px;padding:5px 6px;border-radius:6px;border:1px solid var(--border);background:var(--bg3);color:var(--text);cursor:pointer;font-family:var(--font)}
.look-actions .look-save{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.look-actions .look-save:disabled{opacity:.45;cursor:default}
.look-msg{font-size:11px;color:var(--muted);margin-top:4px;min-height:14px}
.pal-menu-t{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:6px}
.pal-row{display:flex;flex-wrap:wrap;gap:6px;max-width:220px}
.pal-dot{width:22px;height:22px;border-radius:50%;border:2px solid var(--border);cursor:pointer;padding:0;display:inline-flex;align-items:center;justify-content:center;background:var(--bg3);color:var(--muted);font-size:12px}
.pal-dot:hover{transform:scale(1.12)}
.pal-dot.on{border-color:var(--text);box-shadow:0 0 0 2px var(--bg2) inset}
.win11-menu-item{display:flex;align-items:center;gap:10px;width:100%;padding:7px 10px;border-radius:5px;background:transparent;border:0;color:var(--text);text-align:left;cursor:pointer;line-height:1.3}
.win11-menu-item i{font-size:15px;width:16px;flex-shrink:0;color:var(--muted)}
.win11-menu-item span.win11-menu-shortcut{margin-left:auto;font-size:11px;color:var(--muted)}
.win11-menu-item:hover:not(:disabled),.win11-menu-item:focus-visible:not(:disabled){background:color-mix(in srgb, var(--text) 8%, transparent)}
.win11-menu-item:active:not(:disabled){background:color-mix(in srgb, var(--text) 13%, transparent)}
.win11-menu-item:disabled{color:var(--muted);cursor:default}
.win11-menu-item:disabled i{opacity:.5}
.win11-menu-item.danger{color:var(--red)}
.win11-menu-item.danger i{color:var(--red)}
.win11-menu-item.danger:hover:not(:disabled){background:color-mix(in srgb, var(--red) 12%, transparent)}
.win11-menu-separator{height:1px;margin:4px 6px;background:var(--border)}
.win11-menu-label{padding:6px 10px 4px;font-size:10px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--muted)}
/* Bestehende, ueber die Seite verteilte "..."-Dropdowns (Detail-Menues,
   Konto-Menue) bekommen dieselbe Win11-Optik, sobald sie zusaetzlich
   class="win11-menu" tragen - ohne ihre hx- und onclick-Logik anzufassen. */
.win11-menu > .btn,.win11-menu a.menu-item,.win11-menu button.menu-item{display:flex;min-height:32px;padding:6px 10px;border-radius:5px;border:0;background:transparent;color:var(--text);justify-content:flex-start;align-items:center;gap:10px;font-size:13px;margin-bottom:0!important;text-decoration:none}
.win11-menu > .btn:hover,.win11-menu a.menu-item:hover,.win11-menu button.menu-item:hover{background:color-mix(in srgb, var(--text) 8%, transparent);border-color:transparent;opacity:1}
.win11-menu > .btn-primary{color:var(--accent)}
.win11-menu > .btn-danger,.win11-menu > .btn-warning{color:var(--red)}
.win11-menu > .btn i,.win11-menu > .btn ui5-icon,.win11-menu a.menu-item i,.win11-menu button.menu-item i{font-size:15px;width:16px;height:16px;color:var(--muted);flex-shrink:0}
.win11-menu .sr-only{position:static;width:auto;height:auto;padding:0;margin:0;overflow:visible;clip:auto;white-space:nowrap;font-size:13px}
.logo-img{width:30px;height:30px;object-fit:contain;border-radius:6px;flex-shrink:0}
.print-brand{display:none}
@media print{
  .print-brand{display:flex;align-items:center;gap:12px;border-bottom:1px solid #999;padding-bottom:6px;margin-bottom:12px;font-size:12px;color:#333}
  .print-brand img{max-height:40px;max-width:180px;object-fit:contain}
  .print-brand .pb-date{margin-left:auto}
}
</style>
<style id="pdh-mobile">
/* ── Tablet & Smartphone ──────────────────────────────────────
   Tablet (≤1180px): Kontextleiste (Chat, Suche, Hilfe …) als Overlay von
   rechts, damit der Inhalt Platz hat. Smartphone (≤760px): zusaetzlich
   Navigation als ausfahrbares Menue (☰), kompakte Kopfzeile, einspaltige
   Raster, wischbare Tabellen. Touch-Geraete: groessere Tippflaechen. */
.topbar-burger,.topbar-ctx,.pdh-backdrop,.win11-menu a.tb-share-menu{display:none}
.pdh-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:440}
[oncontextmenu]{-webkit-touch-callout:none}
@media (max-width:1180px){
  .app{grid-template-columns:var(--left-sidebar-w) 1fr}
  .pdh-resizer.right{display:none}
  .context{position:fixed;top:0;right:0;bottom:0;width:min(400px,100vw);z-index:450;box-shadow:-12px 0 40px rgba(0,0,0,.35);transform:translateX(102%);transition:transform .2s ease}
  html:not(.sidebar-right-collapsed) .context{transform:none}
  html:not(.sidebar-right-collapsed) .pdh-backdrop{display:block}
  .topbar-ctx{display:inline-flex}
  .topbar-clock .clk-date{display:none}
}
@media (max-width:760px){
  .app{grid-template-columns:1fr}
  .sidebar{position:fixed;top:0;left:0;bottom:0;width:min(290px,86vw);z-index:450;transform:translateX(-102%);transition:transform .2s ease;box-shadow:12px 0 40px rgba(0,0,0,.35)}
  html.nav-open .sidebar{transform:none}
  html.nav-open .pdh-backdrop{display:block}
  .sidebar .logo .sidebar-toggle{display:none}
  .topbar-burger{display:inline-flex;width:40px;min-width:40px;height:40px}
  .topbar{padding:0 8px;gap:6px;height:52px}
  .topbar-path,.status-dot,.tb-label,.tu-name,.tb-share{display:none}
  .win11-menu a.tb-share-menu{display:flex}
  .topbar-cur{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:600}
  .topbar > div{gap:6px!important;margin-left:0!important}
  .theme-toggle{padding:0 10px;height:40px}
  .theme-toggle > span:not(.ctx-badge){display:none}
  .topbar-clock{height:40px;padding:0 8px;gap:4px}
  .topbar-clock i,.topbar-clock .clk-day{display:none}
  .topbar-clock .clk-time{font-size:13px}
  .topbar-user{padding:0 10px;height:40px}
  .main{padding:12px}
  .card{padding:12px}
  .card-title{flex-wrap:wrap;gap:4px 8px}
  .grid2,.rec-compare,.cat-layout,.cat-form,.chat-app,.chat-app.side-open,.hb,.lg-kv,.modes{grid-template-columns:1fr!important}
  .main [style*="grid-template-columns"]:not([style*="auto-fit"]):not([style*="auto-fill"]){grid-template-columns:1fr!important}
  .stats{grid-template-columns:repeat(2,1fr)}
  .global-footer{grid-template-columns:1fr}
  .main table{display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
  .rec-tabs{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:thin}
  /* Seitenkopf mit Aktionsknoepfen: Knoepfe umbrechen statt ueberlaufen */
  .main [style*="justify-content:space-between"],.main [style*="justify-content: space-between"]{flex-wrap:wrap;gap:8px}
  .widget-icon-toolbar{flex-wrap:wrap}
  .rec-tab{white-space:nowrap}
  .rec-head h1{font-size:16px}
  input,select,textarea{font-size:16px!important} /* iOS zoomt sonst beim Antippen */
  .win11-menu{max-width:calc(100vw - 16px)}
  #user-menu{position:fixed!important;right:8px!important;top:56px!important;max-height:calc(100dvh - 70px);overflow-y:auto}
  .context{width:100vw}
  .pdh-frame-panel{width:100%}
}
@media (pointer:coarse){
  .btn,.nav-item,.menu-item,.win11-menu-item{min-height:40px}
  .nav-item{padding-top:10px;padding-bottom:10px}
  .infra-picker-select{padding:9px 6px}
  .infra-picker-tree{max-height:45vh}
  .pal-dot{width:28px;height:28px}
  .look-step{width:36px;height:36px}
}
</style>
<style id="pdh-theme">{{.Brand.ThemeCSS}}</style>
{{template "timeline-style" .Brand.Timeline}}
{{with .Look.FontHref}}<link rel="stylesheet" id="pdh-font" href="{{.}}">{{end}}
<style id="pdh-ui">{{.Look.CSS}}
/* Groesse: zoom auf die ganze Seite; Hoehe ausgleichen, damit 100vh passt */
body{zoom:var(--ui-scale);height:calc(100vh / var(--ui-scale));height:calc(100dvh / var(--ui-scale))}</style>
{{block "head" .}}{{end}}
</head>
<body{{if and (eq .Page "dashboard") (not .IsSystemUser) (not .IsBoardVisit) (not .IsOverrideSession)}} data-tour-offer="1"{{end}}>
<div class="app">
<div class="pdh-resizer left" role="separator" aria-orientation="vertical" tabindex="0" aria-label="{{t "Breite der Navigation"}}" title="{{t "Ziehen ändert die Breite – Doppelklick: Standard"}}"></div>
<div class="pdh-resizer right" role="separator" aria-orientation="vertical" tabindex="0" aria-label="{{t "Breite der Seitenleiste"}}" title="{{t "Ziehen ändert die Breite – Doppelklick: Standard"}}"></div>

<!-- ── Sidebar ── -->
<aside class="sidebar">
  <div class="logo">
    {{if .Brand.AppLogo}}<img class="logo-img" src="{{.Brand.AppLogo}}" alt="{{or .Brand.AppName "PDH"}}">{{else}}<div class="logo-icon">P</div>{{end}}
    <div><div class="logo-text">{{or .Brand.AppName "PDH"}}</div><div class="logo-ver" title="{{t "Änderungen: Handbuch → Versionen"}}">v{{appVersion}}</div></div>
    <button type="button" class="sidebar-toggle" onclick="toggleSidebar('left')" aria-label="{{t "Navigation einklappen"}}" title="{{t "Navigation einklappen"}}"><i class="ti ti-menu-2"></i></button>
  </div>
  <nav id="pdh-nav">
    {{range .Nav}}
    {{if .Label}}<button type="button" class="nav-section nav-fold" data-fold="{{.Key}}" aria-expanded="true" onclick="pdhFold(this)"><span class="nav-gl">{{.Label}}</span><i class="ti ti-chevron-down" aria-hidden="true"></i></button>{{end}}
    <div class="nav-group" data-fold-group="{{.Key}}" data-label="{{.Label}}">
      {{range .Items}}<a href="{{.Href}}" class="nav-item{{if and .Page (eq .Page $.Page)}} active{{end}}" data-nav="{{.Key}}"{{if .External}} target="_blank" rel="noopener"{{end}}{{if eq .Key "chat"}} style="position:relative"{{end}}><i class="ti {{.Icon}}"></i><span class="nav-label">{{.Label}}</span>{{if eq .Key "chat"}}<span id="chat-nav-badge" class="nav-badge" style="display:none"></span>{{end}}</a>{{end}}
    </div>
    {{end}}
    <div class="nav-edit-bar">
      <div class="nav-edit-tools" style="display:none">
        <button type="button" onclick="pdhNavAddGroup()"><i class="ti ti-folder-plus"></i> {{t "Gruppe"}}</button>
        <button type="button" onclick="pdhNavReset()" title="{{t "Vorgabe wiederherstellen"}}"><i class="ti ti-restore"></i> {{t "Standard"}}</button>
        <button type="button" class="on" onclick="pdhNavSave()"><i class="ti ti-check"></i> {{t "Fertig"}}</button>
      </div>
      <div class="nav-edit-hint" style="display:none">{{t "Einträge ziehen, Gruppennamen anklicken zum Umbenennen."}}</div>
    </div>
  </nav>
  <script>
  // Einklappbare Navigationsgruppen: standardmaessig zu, Zustand je Browser;
  // die Gruppe mit der geoeffneten Seite bleibt immer offen.
  (function(){
    let st = {};
    try{ st = JSON.parse(localStorage.getItem('pdh_nav_fold') || '{}'); }catch(e){}
    document.querySelectorAll('.nav-fold').forEach(function(b){
      const g = document.querySelector('[data-fold-group="' + b.dataset.fold + '"]');
      // Standard: zugeklappt – bis man die Gruppe selbst aufklappt
      const folded = (b.dataset.fold in st ? !!st[b.dataset.fold] : true) && !(g && g.querySelector('.nav-item.active'));
      b.setAttribute('aria-expanded', folded ? 'false' : 'true');
      if(g) g.classList.toggle('folded', folded);
    });
  })();
  // Navigation anpassen: Gruppen umbenennen/anlegen/loeschen, Eintraege ziehen (nav.go)
  let pdhNavSortables = [];
  function pdhNavEdit(on){
    const html = document.documentElement;
    if(on && html.classList.contains('sidebar-left-collapsed')) toggleSidebar('left');
    if(on && typeof pdhNav === 'function') pdhNav(true); // schmale Ansicht: Navigation einblenden
    html.classList.toggle('nav-editing', on);
    document.querySelectorAll('.nav-edit-tools,.nav-edit-hint').forEach(e => e.style.display = on ? '' : 'none');
    if(!on){ pdhNavSortables.forEach(s => s.destroy()); pdhNavSortables = []; return; }
    document.querySelectorAll('#pdh-nav .nav-fold').forEach(pdhNavHeaderEdit);
    const start = () => document.querySelectorAll('#pdh-nav .nav-group').forEach(g => pdhNavSortables.push(Sortable.create(g, {group: 'pdh-nav', animation: 150, ghostClass: 'nav-ghost', draggable: '.nav-item'})));
    if(window.Sortable) start();
    else { const sc = document.createElement('script'); sc.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js'; sc.onload = start; document.head.appendChild(sc); }
    document.querySelectorAll('#pdh-nav .nav-item').forEach(a => a.addEventListener('click', pdhNavNoClick));
  }
  // Dashboard anpassen (Benutzermenue): auf dem Dashboard direkt, sonst dorthin wechseln
  function pdhDashboardEdit(){
    if(typeof window.dwEdit === 'function' && document.getElementById('dw-root')){ window.dwEdit(true); document.getElementById('dw-root').scrollIntoView({block: 'start'}); }
    else location.href = '/?dwedit=1';
  }
  function pdhNavNoClick(e){ if(document.documentElement.classList.contains('nav-editing')) e.preventDefault(); }
  function pdhNavHeaderEdit(btn){
    if(btn.querySelector('input')) return;
    const span = btn.querySelector('.nav-gl');
    const inp = document.createElement('input');
    inp.className = 'nav-gl-input'; inp.maxLength = 40; inp.value = span.textContent;
    inp.addEventListener('click', e => e.stopPropagation());
    inp.addEventListener('keydown', e => { if(e.key === ' ' || e.key === 'Enter') e.stopPropagation(); });
    span.style.display = 'none'; btn.insertBefore(inp, span);
    const del = document.createElement('span');
    del.className = 'nav-gdel'; del.title = {{t "Gruppe löschen (Einträge wandern nach oben)"}}; del.innerHTML = '<i class="ti ti-trash"></i>';
    del.addEventListener('click', e => {
      e.stopPropagation();
      const g = document.querySelector('[data-fold-group="' + btn.dataset.fold + '"]');
      const top = document.querySelector('[data-fold-group="top"]');
      if(g && top) g.querySelectorAll('.nav-item').forEach(a => top.appendChild(a));
      if(g) g.remove(); btn.remove();
    });
    btn.appendChild(del);
    btn.onclick = null;
  }
  function pdhNavAddGroup(){
    const key = 'g' + Date.now().toString(36);
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'nav-section nav-fold'; btn.dataset.fold = key; btn.setAttribute('aria-expanded', 'true');
    btn.innerHTML = '<span class="nav-gl"></span><i class="ti ti-chevron-down"></i>';
    btn.querySelector('.nav-gl').textContent = {{t "Neue Gruppe"}};
    const g = document.createElement('div');
    g.className = 'nav-group'; g.dataset.foldGroup = key;
    const bar = document.querySelector('#pdh-nav .nav-edit-bar');
    bar.parentNode.insertBefore(btn, bar); bar.parentNode.insertBefore(g, bar);
    pdhNavHeaderEdit(btn);
    pdhNavSortables.push(Sortable.create(g, {group: 'pdh-nav', animation: 150, ghostClass: 'nav-ghost', draggable: '.nav-item'}));
    btn.querySelector('input').select();
  }
  async function pdhNavPost(body){
    const res = await fetch('/account/nav-layout', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
    const j = await res.json().catch(() => ({}));
    if(!res.ok || !j.success) throw new Error(j.error || ('HTTP ' + res.status));
  }
  async function pdhNavSave(){
    const groups = [...document.querySelectorAll('#pdh-nav .nav-group')].map(g => {
      const key = g.dataset.foldGroup;
      const btn = document.querySelector('#pdh-nav .nav-fold[data-fold="' + key + '"]');
      const inp = btn && btn.querySelector('input');
      return {key, label: key === 'top' ? '' : (inp ? inp.value.trim() : (g.dataset.label || '')), items: [...g.querySelectorAll('.nav-item')].map(a => a.dataset.nav)};
    });
    try{ await pdhNavPost({groups}); location.reload(); }
    catch(e){ alert({{t "Navigation konnte nicht gespeichert werden:"}} + ' ' + e.message); }
  }
  async function pdhNavReset(){
    if(!confirm({{t "Eigene Anordnung verwerfen und die Vorgabe wiederherstellen?"}})) return;
    try{ await pdhNavPost({reset: true}); location.reload(); }
    catch(e){ alert(e.message); }
  }
  function pdhFold(b){
    const g = document.querySelector('[data-fold-group="' + b.dataset.fold + '"]');
    const fold = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', fold ? 'false' : 'true');
    if(g) g.classList.toggle('folded', fold);
    let st = {};
    try{ st = JSON.parse(localStorage.getItem('pdh_nav_fold') || '{}'); }catch(e){}
    st[b.dataset.fold] = fold;
    try{ localStorage.setItem('pdh_nav_fold', JSON.stringify(st)); }catch(e){}
  }
  </script>
</aside>

<!-- ── Hauptbereich ── -->
<div class="main-wrap">
  <div class="topbar">
    <button type="button" class="sidebar-toggle topbar-burger" onclick="pdhNav()" aria-label="{{t "Navigation öffnen"}}" title="{{t "Navigation"}}"><i class="ti ti-menu-2"></i></button>
    <span class="topbar-path">PDH /</span>
    <span class="topbar-cur">{{.Title}}</span>
    <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
      <a href="/time" class="topbar-clock" id="pdh-clock" data-server-ms="{{serverNowMs}}" title="{{t "Zeiterfassung öffnen"}}" aria-label="{{t "Uhrzeit – Zeiterfassung öffnen"}}">
        <i class="ti ti-clock"></i><span class="clk-day"></span><span class="clk-date"></span><span class="clk-time">--:--:--</span>
      </a>
      {{if and .CanChat (ne .Page "chat")}}
      <button type="button" class="theme-toggle tb-share" onclick="pdhShareToChat()" title="{{t "Diese Seite im Chat teilen"}}"><i class="ti ti-share"></i><span>{{t "Im Chat teilen"}}</span></button>
      <button type="button" class="theme-toggle" onclick="activateContextTab('chat')" title="{{t "Chat in der Seitenleiste"}}" style="position:relative"><i class="ti ti-messages"></i><span>{{t "Chat"}}</span><span class="ctx-badge" id="top-chat-badge" style="display:none;top:-6px;right:-6px"></span></button>
      {{end}}
      <button type="button" class="theme-toggle" id="theme-toggle" onclick="cycleThemeMode()" aria-label="{{t "Darstellung wechseln"}}" title="{{t "Darstellung wechseln"}}">
        <i class="ti ti-device-desktop" id="theme-toggle-icon"></i>
        <span id="theme-toggle-label">System</span>
      </button>
      {{if .IsBoardVisit}}
      <a class="btn btn-small" href="/logout" style="background:rgba(245,158,11,.15);border-color:var(--amber,#f59e0b);color:var(--amber,#f59e0b)" title="{{t "Kurzzugang beenden und zurück zum Leitstand"}}">
        <i class="ti ti-corner-up-left"></i><span class="tb-label"> {{t "Zurück zum Leitstand"}}</span>
      </a>
      {{else if .IsOverrideSession}}
      <button type="button" class="btn btn-small" style="background:rgba(245,158,11,.15);border-color:var(--amber,#f59e0b);color:var(--amber,#f59e0b)" onclick="document.getElementById('override-logout-form').submit()" title="{{t "Zurück zum Systemnutzer"}}">
        <i class="ti ti-corner-up-left"></i><span class="tb-label"> {{t "Zurück zum Systemnutzer"}}</span>
      </button>
      <form id="override-logout-form" method="POST" action="/override-logout" style="display:none"></form>
      {{else if .IsSystemUser}}
      <button type="button" class="btn btn-small" onclick="document.getElementById('override-login-modal').style.display='flex'" title="{{t "Kurz mit eigenem Konto anmelden"}}">
        <i class="ti ti-user-plus"></i><span class="tb-label"> {{t "Anmelden zur Erledigung"}}</span>
      </button>
      {{end}}
      <button type="button" class="theme-toggle topbar-ctx" onclick="toggleSidebar('right')" aria-label="{{t "Suche, Hilfe und mehr"}}" title="{{t "Suche, Hilfe & mehr"}}"><i class="ti ti-layout-sidebar-right"></i></button>
      {{template "lang-switch"}}
      <div style="position:relative">
        <button type="button" class="topbar-user" onclick="toggleMenu('user-menu')" aria-label="{{t "Benutzermenü"}}"><i class="ti ti-user"></i><span class="tu-name">{{.UserName}}</span><i class="ti ti-chevron-down" style="font-size:11px;margin-left:2px;color:var(--muted)"></i></button>
        <div id="user-menu" class="win11-menu" style="display:none;position:absolute;right:0;top:50px;min-width:160px;z-index:200">
          <a href="/users/me" class="menu-item"><i class="ti ti-user-cog"></i>{{t "Mein Konto"}}</a>
          <a href="/help" class="menu-item"><i class="ti ti-book"></i>{{t "Handbuch"}}</a>
          <a href="#" class="menu-item" onclick="pdhTour.start('basics'); return false;"><i class="ti ti-map-2"></i>{{t "Rundgang durch PDH"}}</a>
          <a href="#" class="menu-item" id="um-dw-edit" onclick="closeMenu('user-menu'); pdhDashboardEdit(); return false;"><i class="ti ti-layout-dashboard"></i>{{t "Dashboard anpassen"}}</a>
          <a href="#" class="menu-item" id="um-nav-edit" onclick="closeMenu('user-menu'); pdhNavEdit(true); return false;"><i class="ti ti-adjustments-horizontal"></i>{{t "Navigation anpassen"}}</a>
          {{if and .CanChat (ne .Page "chat")}}<a href="#" class="menu-item tb-share-menu" onclick="pdhShareToChat(); return false;"><i class="ti ti-share"></i>{{t "Im Chat teilen"}}</a>{{end}}
          <div class="pal-menu look-menu">
            <div class="pal-menu-t"><i class="ti ti-palette"></i>{{t "Darstellung"}}</div>
            {{if .Look.Allow}}<div class="pal-row">
              <button type="button" class="pal-dot pal-default" data-palette-pick="" onclick="lookSet('palette','')" title="{{t "Firmenstandard"}} ({{.Brand.ThemeName}})"><i class="ti ti-building"></i></button>
              {{range .Brand.Palettes}}<button type="button" class="pal-dot" data-palette-pick="{{.ID}}" onclick="lookSet('palette','{{.ID}}')" title="{{.Name}}" style="background:{{.Swatch}}"></button>{{end}}
            </div>
            <div class="look-row"><i class="ti ti-typography" title="{{t "Schriftart"}}"></i><select id="look-font" onchange="lookSet('font', this.value)" aria-label="{{t "Schriftart"}}">
              <option value="">{{t "Firmenstandard"}}</option>{{range .Brand.Fonts}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
            </select></div>{{end}}
            <div class="look-row"><i class="ti ti-text-size" title="{{t "Größe"}}"></i>
              <button type="button" class="look-step" onclick="lookStep(-10)" aria-label="{{t "Kleiner"}}">−</button>
              <span class="look-pct" id="look-pct">100 %</span>
              <button type="button" class="look-step" onclick="lookStep(10)" aria-label="{{t "Größer"}}">+</button>
            </div>
            <div class="look-actions">
              <button type="button" onclick="lookReset()" title="{{t "Firmenstandard verwenden"}}">{{t "Standard"}}</button>
              <button type="button" class="look-save" id="look-save" onclick="lookSave()" disabled>{{t "Speichern"}}</button>
            </div>
            <div class="look-msg" id="look-msg"></div>
          </div>
          <a href="/logout" class="menu-item"><i class="ti ti-logout"></i>{{t "Abmelden"}}</a>
        </div>
      </div>
      <div class="status-dot" title="{{t "API online"}}"></div>
    </div>
  </div>
  <div class="main">
    <div class="print-brand">{{if .Brand.PrintLogo}}<img src="{{.Brand.PrintLogo}}" alt="">{{end}}<span>{{or .Brand.AppName "PDH"}} · {{.Title}}</span><span class="pb-date" data-print-date></span></div>
    {{block "content" .}}{{end}}
  </div>
</div>

{{if .IsSystemUser}}{{if not .IsOverrideSession}}
<!-- Override-Anmeldung: kurzzeitig mit eigenem Konto an einem Systemnutzer-Terminal anmelden -->
<div id="override-login-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:300;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:380px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)">
    <div style="font-size:15px;font-weight:600;margin-bottom:6px">{{t "Anmelden zur Erledigung"}}</div>
    <p style="font-size:12px;color:var(--muted);margin-bottom:16px">{{t "Du meldest dich kurz mit deinem eigenen Konto an diesem Systemnutzer-Terminal an. Nach %d Minuten Inaktivität (oder per Klick auf „Zurück“) kehrt das Terminal automatisch zum Systemnutzer zurück." .OverrideTimeoutMinutes}}</p>
    <form method="POST" action="/override-login">
      <div class="form-group">
        <label class="form-label">{{t "E-Mail oder Benutzername"}}</label>
        <input type="text" name="email" class="form-input" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">{{t "Passwort"}}</label>
        <input type="password" name="password" class="form-input" required>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
        <button type="button" class="btn" onclick="document.getElementById('override-login-modal').style.display='none'">{{t "Abbrechen"}}</button>
        <button type="submit" class="btn btn-primary">{{t "Anmelden"}}</button>
      </div>
    </form>
    <div style="display:flex;align-items:center;gap:10px;margin:16px 0;color:var(--muted);font-size:11px">
      <div style="flex:1;height:1px;background:var(--border)"></div>{{t "ODER"}}<div style="flex:1;height:1px;background:var(--border)"></div>
    </div>
    <form method="POST" action="/override-login/rfid">
      <div class="form-group">
        <label class="form-label">{{t "RFID-Karte"}}</label>
        <input type="text" name="uid" class="form-input" placeholder="{{t "Karte an den Leser halten …"}}" autocomplete="off" onkeydown="if(event.key==='Enter'){event.preventDefault();this.form.submit();}">
      </div>
    </form>
  </div>
</div>
{{end}}{{end}}

<!-- ── Kontext-Spalte ── -->
<div class="pdh-backdrop" onclick="pdhCloseOverlays()" aria-hidden="true"></div>
{{template "completion-wizard"}}
{{template "create-wizard" (dict "Board" false)}}
{{template "kvp-wizard"}}
{{template "app-tour"}}
<aside class="context">
  <div class="ctx-tabs" aria-label="Kontextauswahl">
    {{if and .CanChat (ne .Page "chat")}}<button type="button" class="ctx-tab" data-context-tab="chat" onclick="activateContextTab('chat')" title="{{t "Chat"}}" aria-label="{{t "Chat"}}"><i class="ti ti-messages"></i><span class="ctx-vlabel">{{t "Chat"}}</span><span class="ctx-badge" id="ctx-chat-badge" style="display:none"></span></button>{{end}}
    <button type="button" class="ctx-tab" data-context-tab="search" onclick="activateContextTab('search')" title="{{t "Suche"}}" aria-label="{{t "Suche"}}"><i class="ti ti-search"></i><span class="ctx-vlabel">{{t "Suche"}}</span></button>
    <button type="button" class="ctx-tab" data-context-tab="copilot" onclick="activateContextTab('copilot')" title="{{t "Copilot"}}" aria-label="{{t "Copilot"}}"><i class="ti ti-brain"></i><span class="ctx-vlabel">{{t "Copilot"}}</span></button>
    <button type="button" class="ctx-tab" data-context-tab="activity" onclick="activateContextTab('activity')" title="{{t "Aktivität"}}" aria-label="{{t "Aktivität"}}"><i class="ti ti-bell"></i><span class="ctx-vlabel">{{t "Aktivität"}}</span></button>
    <button type="button" class="ctx-tab" data-context-tab="list" onclick="activateContextTab('list')" title="{{t "Auswahl"}}" aria-label="{{t "Auswahl"}}"><i class="ti ti-list"></i><span class="ctx-vlabel">{{if .ContextTitle}}{{.ContextTitle}}{{else}}{{t "Auswahl"}}{{end}}</span></button>
    <button type="button" class="ctx-tab" data-context-tab="help" onclick="activateContextTab('help')" title="{{t "Hilfe"}}" aria-label="{{t "Hilfe"}}"><i class="ti ti-help"></i><span class="ctx-vlabel">{{t "Hilfe"}}</span></button>
    <button type="button" class="sidebar-toggle" onclick="toggleSidebar('right')" aria-label="{{t "Kontext einklappen"}}" title="{{t "Kontext einklappen"}}" style="margin-top:auto"><i class="ti ti-menu-2"></i></button>
  </div>
  <div class="ctx-panel-wrap">
  {{if and .CanChat (ne .Page "chat")}}
  <!-- Chat -->
  <div class="ctx-section sc-panel" data-context-panel="chat">
    <div class="sc-head">
      <button type="button" class="sc-btn" id="sc-back" title="{{t "Alle Chats"}}" style="display:none"><i class="ti ti-arrow-left"></i></button>
      <div class="sc-htitle" id="sc-title">{{t "Chat"}}</div>
      <a class="sc-btn" id="sc-full" href="/chat" title="{{t "Im Vollbild öffnen"}}"><i class="ti ti-arrows-maximize"></i></a>
      <button type="button" class="sc-btn" onclick="setRightSidebar(false)" title="{{t "Seitenleiste schließen"}}"><i class="ti ti-x"></i></button>
    </div>
    <div class="sc-share" id="sc-share" style="display:none"></div>
    <div class="sc-body" id="sc-body"><div class="sc-empty">{{t "Wird geladen …"}}</div></div>
    <div class="sc-compose" id="sc-compose" style="display:none">
      <textarea id="sc-input" rows="2" placeholder="{{t "Nachricht … (Enter = senden)"}}"></textarea>
      <button type="button" class="sc-btn sc-send" id="sc-send" title="{{t "Senden"}}"><i class="ti ti-send"></i></button>
    </div>
  </div>
  {{end}}
  <!-- Suche -->
  <div class="ctx-section active" data-context-panel="search">
    <div class="ctx-title"><i class="ti ti-search"></i>{{t "Suche"}}</div>
    <div class="search-box">
      <i class="ti ti-search"></i>
      <input placeholder="{{t "Anlage, Ticket, Teil …"}}"
        hx-get="/api/search"
        hx-trigger="keyup changed delay:400ms"
        hx-target="#search-results"
        hx-include="this"
        name="q"
        id="search-input">
    </div>
    <div id="search-results" style="margin-top:8px;font-size:12px;color:var(--muted)"></div>
  </div>

  <!-- Copilot -->
  <div class="ctx-section" data-context-panel="copilot">
    <div class="ctx-title"><i class="ti ti-brain"></i>{{t "Copilot"}}</div>
    <div class="copilot-msgs" id="cop-msgs">
      <div class="cop-hint">{{t "Frag nach Störungen, Anlagen, Wartungen oder Ersatzteilen – der Copilot sucht in euren PDH-Daten …"}}</div>
    </div>
    <div class="copilot-input">
      <input placeholder="{{t "Frage stellen …"}}" id="cop-in"
        onkeydown="if(event.key==='Enter')sendCop()">
      <button class="cop-btn" onclick="sendCop()">{{t "Senden"}}</button>
    </div>
  </div>

  <!-- Aktivität -->
  <div class="ctx-section grow" data-context-panel="activity">
    <div class="ctx-title"><i class="ti ti-bell"></i>{{t "Aktivität"}}</div>
    {{template "presence-style"}}
    <div id="pres-box" hx-get="/api/presence" hx-trigger="load, every 30s" aria-live="polite">
      <div style="font-size:11px;color:var(--muted)">{{t "Lädt …"}}</div>
    </div>
    <div id="activity-feed"
      hx-get="/api/activity"
      hx-trigger="load, every 30s">
      <div style="font-size:11px;color:var(--muted)">{{t "Lädt …"}}</div>
    </div>
  </div>

  <!-- Kontext-Liste (seitenabhängig) -->
  <div class="ctx-section" data-context-panel="list">
    <div class="ctx-title"><i class="ti ti-list"></i>{{.ContextTitle}}</div>
    <div id="ctx-list">
      {{block "context-list" .}}
      <div style="font-size:11px;color:var(--muted)">{{t "Keine Einträge"}}</div>
      {{end}}
    </div>
  </div>
  <div class="ctx-section" data-context-panel="help">
    <div class="ctx-title"><i class="ti ti-help"></i>{{t "Hilfe"}}</div>
    <!-- Kontexthilfe: passendes Handbuchkapitel zur aktuellen Seite (geladen aus /help) -->
    <div id="ctx-help" class="ctx-help" data-page="{{.Page}}"><div style="color:var(--muted)">{{t "Hilfe wird geladen …"}}</div></div>
    <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
      <button type="button" class="btn btn-small btn-primary" id="ctx-help-tour" onclick="pdhTour.startPage()"><i class="ti ti-map-2"></i> {{t "Rundgang für diese Seite"}}</button>
      <a class="btn btn-small" id="ctx-help-chapter" href="/help"><i class="ti ti-book"></i> {{t "Im Handbuch öffnen"}}</a>
      <a class="btn btn-small" href="/help"><i class="ti ti-list"></i> Inhalt</a>
    </div>
  </div>
  </div>
</aside>

</div>

<footer class="global-footer ok" id="global-status-footer" aria-live="polite">
  <div class="footer-status-left">
    <span class="footer-status-dot" id="footer-status-dot"></span>
    <span id="footer-status-text">Bereit</span>
  </div>
  <div class="footer-progress" aria-label="Statusfortschritt">
    <div class="footer-progress-fill" id="footer-progress-fill"></div>
  </div>
  <div class="footer-status-error" id="footer-status-error">Keine Fehler</div>
</footer>

<script>
const API = '';
const TOKEN = localStorage.getItem('pdh_token') || '';

const THEME_MODES = ['system','light','dark'];
function resolveTheme(mode) {
  if(mode === 'light' || mode === 'dark') return mode;
  return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
}
function themeMeta(mode) {
  if(mode === 'light') return {label:'Hell', icon:'ti ti-sun'};
  if(mode === 'dark') return {label:'Dunkel', icon:'ti ti-moon'};
  return {label:'System', icon:'ti ti-device-desktop'};
}
function applyThemeMode(mode) {
  const selected = THEME_MODES.includes(mode) ? mode : 'system';
  localStorage.setItem('pdh_theme', selected);
  document.documentElement.dataset.themeMode = selected;
  document.documentElement.dataset.theme = resolveTheme(selected);
  const meta = themeMeta(selected);
  const icon = document.getElementById('theme-toggle-icon');
  const label = document.getElementById('theme-toggle-label');
  const btn = document.getElementById('theme-toggle');
  if(icon) icon.className = meta.icon;
  if(label) label.textContent = meta.label;
  if(btn) btn.title = 'Darstellung: ' + meta.label;
}
// Darstellung (Farbschema, Schrift, Groesse): sofort sichtbar, mit
// „Speichern“ am Konto abgelegt. Leer/0 = Firmenstandard.
const lookDraft = Object.assign({}, window.PDH_LOOK_SAVED);
const PDH_FONTS = {{.Look.FontsJS}};
function lookEffective(k) { return lookDraft[k] || window.PDH_LOOK_DEFAULT[k]; }
function lookApply() {
  const root = document.documentElement;
  const pal = window.PDH_LOOK_ALLOW && window.PDH_PALETTES.indexOf(lookDraft.palette) >= 0 ? lookDraft.palette : window.PDH_LOOK_DEFAULT.palette;
  root.dataset.palette = pal;
  const font = PDH_FONTS[window.PDH_LOOK_ALLOW && lookDraft.font ? lookDraft.font : window.PDH_LOOK_DEFAULT.font];
  if(font) {
    root.style.setProperty('--font', font[0]);
    let link = document.getElementById('pdh-font');
    if(font[1]) {
      if(!link) { link = document.createElement('link'); link.rel = 'stylesheet'; link.id = 'pdh-font'; document.head.appendChild(link); }
      if(link.href !== font[1]) link.href = font[1];
    }
  }
  const scale = lookEffective('scale');
  root.style.setProperty('--ui-scale', (scale / 100).toFixed(2));
  const pct = document.getElementById('look-pct'); if(pct) pct.textContent = scale + ' %';
  const sel = document.getElementById('look-font'); if(sel) sel.value = lookDraft.font || '';
  document.querySelectorAll('[data-palette-pick]').forEach(b => b.classList.toggle('on', b.dataset.palettePick === (lookDraft.palette || '')));
  const dirty = ['palette','font','scale'].some(k => (lookDraft[k] || '') !== (window.PDH_LOOK_SAVED[k] || ''));
  const save = document.getElementById('look-save'); if(save) save.disabled = !dirty;
  const msg = document.getElementById('look-msg'); if(msg && dirty) msg.textContent = 'Vorschau – zum Behalten speichern';
}
function lookSet(k, v) { lookDraft[k] = v; lookApply(); }
function lookStep(d) { lookDraft.scale = Math.max(70, Math.min(160, lookEffective('scale') + d)); lookApply(); }
function lookReset() { lookDraft.palette = ''; lookDraft.font = ''; lookDraft.scale = 0; lookApply(); }
async function lookSave() {
  const msg = document.getElementById('look-msg');
  const body = new URLSearchParams({palette: lookDraft.palette || '', font: lookDraft.font || '', scale: String(lookDraft.scale || 0)});
  try {
    const res = await fetch('/account/appearance', {method: 'POST', body, credentials: 'same-origin'});
    const json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Fehler');
    window.PDH_LOOK_SAVED = Object.assign({}, lookDraft);
    lookApply();
    if(msg) msg.textContent = 'Gespeichert – gilt jetzt auf allen Geräten';
  } catch(e) { if(msg) msg.textContent = 'Nicht gespeichert: ' + e.message; }
}
// ── Uhr in der Kopfleiste: Serverzeit, tickt genau zum Sekundenwechsel ──
(function(){
  const el = document.getElementById('pdh-clock');
  if(!el) return;
  // Abstand Geraeteuhr ↔ Serveruhr; so zeigen alle Terminals dieselbe Zeit
  const offset = (parseInt(el.dataset.serverMs, 10) || Date.now()) - Date.now();
  const fDay = new Intl.DateTimeFormat(PDH_LOCALE, {weekday: 'long'});
  const fDate = new Intl.DateTimeFormat(PDH_LOCALE, {day: '2-digit', month: '2-digit', year: 'numeric'});
  const fTime = new Intl.DateTimeFormat(PDH_LOCALE, {hour: '2-digit', minute: '2-digit', second: '2-digit'});
  const day = el.querySelector('.clk-day'), date = el.querySelector('.clk-date'), time = el.querySelector('.clk-time');
  function kw(d) { // ISO-Kalenderwoche
    const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    const n = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - n);
    return Math.ceil(((t - new Date(Date.UTC(t.getUTCFullYear(), 0, 1))) / 86400000 + 1) / 7);
  }
  function tick() {
    const now = new Date(Date.now() + offset);
    day.textContent = fDay.format(now) + ',';
    date.textContent = fDate.format(now);
    time.textContent = fTime.format(now);
    el.title = fDay.format(now) + ', ' + fDate.format(now) + ' · KW ' + kw(now) + ' – Zeiterfassung öffnen';
    setTimeout(tick, 1000 - ((Date.now() + offset) % 1000) + 5);
  }
  tick();
})();
// aktueller Zoom-Faktor (fuer pixelgenaue Positionierung von Menues)
function pdhZoom() { return parseFloat(getComputedStyle(document.body).zoom) || 1; }
document.addEventListener('DOMContentLoaded', lookApply);
function cycleThemeMode() {
  const current = localStorage.getItem('pdh_theme') || 'system';
  const index = THEME_MODES.indexOf(current);
  applyThemeMode(THEME_MODES[(index + 1) % THEME_MODES.length]);
}
document.addEventListener('DOMContentLoaded', () => applyThemeMode(localStorage.getItem('pdh_theme') || 'system'));
function ensureIconFont() {
  const probe = document.createElement('i');
  probe.className = 'ti ti-plus';
  probe.style.position = 'absolute';
  probe.style.left = '-9999px';
  document.body.appendChild(probe);
  const pseudo = getComputedStyle(probe, '::before');
  const content = pseudo.content;
  const family = (pseudo.fontFamily || '').toLowerCase();
  probe.remove();
  const hasIconCss = !!content && content !== 'none' && content !== 'normal' && content !== '""';
  let fontReady = true;
  if(document.fonts && family.includes('tabler')) {
    fontReady = document.fonts.check('16px "tabler-icons"') || document.fonts.check('16px tabler-icons');
  }
  if(!hasIconCss || !fontReady) {
    document.documentElement.classList.add('icons-fallback');
  } else {
    document.documentElement.classList.remove('icons-fallback');
  }
}
window.addEventListener('load', () => setTimeout(ensureIconFont, 300));
if(document.fonts && document.fonts.ready) document.fonts.ready.then(ensureIconFont);
if(window.matchMedia) {
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if((localStorage.getItem('pdh_theme') || 'system') === 'system') applyThemeMode('system');
  });
}

function applySidebarState() {
  // Auf dem Smartphone ist die Navigation ein ausfahrbares Menue – dort immer mit Beschriftung
  const left = localStorage.getItem('pdh_sidebar_left') !== 'expanded' && !window.matchMedia('(max-width:760px)').matches;
  document.documentElement.classList.toggle('sidebar-left-collapsed', left);
}
// Rechte Seitenleiste oeffnen/schliessen (Zustand wird bewusst nicht gespeichert).
function setRightSidebar(open) {
  document.documentElement.classList.toggle('sidebar-right-collapsed', !open);
  if(open && localStorage.getItem('pdh_context_tab') === 'chat' && window.pdhSideChat) window.pdhSideChat.shown();
}
// ── Smartphone/Tablet: Navigation (☰) und Kontextleiste als Overlay ──
const PDH_PHONE = window.matchMedia('(max-width:760px)');
const PDH_NARROW = window.matchMedia('(max-width:1180px)');
function pdhNav(open) {
  const h = document.documentElement;
  h.classList.toggle('nav-open', open === undefined ? !h.classList.contains('nav-open') : open);
}
function pdhCloseOverlays() {
  pdhNav(false);
  if(PDH_NARROW.matches) setRightSidebar(false);
}
document.addEventListener('keydown', e => {
  const h = document.documentElement;
  if(e.key === 'Escape' && (h.classList.contains('nav-open') || (PDH_NARROW.matches && !h.classList.contains('sidebar-right-collapsed')))) pdhCloseOverlays();
});
PDH_PHONE.addEventListener('change', () => { pdhNav(false); applySidebarState(); });
// Lange druecken = Rechtsklick (iPhone/iPad kennen kein contextmenu-Ereignis;
// Android liefert es selbst – dann wird hier nichts doppelt ausgeloest).
(function(){
  if(!('ontouchstart' in window)) return;
  let timer = null, start = null, nativeFired = false, suppressClick = false;
  document.addEventListener('contextmenu', e => { if(e.isTrusted) nativeFired = true; }, true);
  document.addEventListener('touchstart', e => {
    if(e.touches.length !== 1) { clearTimeout(timer); start = null; return; }
    const t = e.touches[0];
    start = {x: t.clientX, y: t.clientY, target: e.target};
    nativeFired = false;
    clearTimeout(timer);
    timer = setTimeout(() => {
      if(nativeFired || !start) return;
      const ev = new MouseEvent('contextmenu', {bubbles: true, cancelable: true, clientX: start.x, clientY: start.y, button: 2});
      if(!start.target.dispatchEvent(ev)) { suppressClick = true; if(navigator.vibrate) navigator.vibrate(15); }
      start = null;
    }, 550);
  }, {passive: true});
  document.addEventListener('touchmove', e => {
    if(!start) return;
    const t = e.touches[0];
    if(Math.hypot(t.clientX - start.x, t.clientY - start.y) > 10) { clearTimeout(timer); start = null; }
  }, {passive: true});
  document.addEventListener('touchend', () => { clearTimeout(timer); start = null; }, {passive: true});
  document.addEventListener('click', e => { if(suppressClick) { suppressClick = false; e.preventDefault(); e.stopPropagation(); } }, true);
})();
function toggleSidebar(side) {
  if(side === 'right') {
    setRightSidebar(document.documentElement.classList.contains('sidebar-right-collapsed'));
    return;
  }
  const collapsed = localStorage.getItem('pdh_sidebar_left') !== 'expanded';
  localStorage.setItem('pdh_sidebar_left', collapsed ? 'expanded' : 'collapsed');
  applySidebarState();
}
// ── Menü-Umschalter (globaler Fallback; einzelne Seiten dürfen das lokal
// überschreiben, z.B. für andere ID-Präfixe) ──────────────────────────
function toggleMenu(id){
  var m = document.getElementById(id);
  if(m) m.style.display = (m.style.display === 'none' || !m.style.display) ? 'block' : 'none';
}
function closeMenu(id){
  var m = document.getElementById(id);
  if(m) m.style.display = 'none';
}
document.addEventListener('click', function(e){
  if(!e.target.closest('[onclick*="toggleMenu"]') && !e.target.closest('.look-menu')){
    document.querySelectorAll('[id$="-menu"]').forEach(function(m){ m.style.display = 'none'; });
  }
});

// ── Auto-Logout nach Inaktivität, mit Systemnutzer-/Override-Ausnahme ──
(function(){
  var isSystemUser = {{if .IsSystemUser}}true{{else}}false{{end}};
  // Kurzzugang aus dem Leitstand verhaelt sich wie eine Override-Sitzung
  var isOverride    = {{if or .IsOverrideSession .IsBoardVisit}}true{{else}}false{{end}};
  var idleMinutes     = {{.IdleTimeoutMinutes}};
  var overrideMinutes = {{.OverrideTimeoutMinutes}};

  var logoutUrl = null, minutes = 0;
  if(isOverride){
    // Inaktivität beendet auch eine Override-Sitzung und führt zum Leitstand.
    logoutUrl = '/logout';
    minutes = overrideMinutes;
  } else if(!isSystemUser){
    logoutUrl = '/logout';
    minutes = idleMinutes;
  }
  // reiner Systemnutzer (kein Override aktiv): kein Timer, bleibt wie
  // gewünscht dauerhaft eingeloggt.

  if(logoutUrl && minutes > 0){
    var idleTimer;
    function resetIdleTimer(){
      clearTimeout(idleTimer);
      idleTimer = setTimeout(function(){ window.location = logoutUrl; }, minutes * 60 * 1000);
    }
    ['mousemove','keydown','click','touchstart','scroll'].forEach(function(evt){
      document.addEventListener(evt, resetIdleTimer, {passive:true});
    });
    resetIdleTimer();
  }

  var params = new URLSearchParams(location.search);
  var overrideErr = params.get('override_error');
  if(overrideErr){
    var messages = {
      'nur_am_systemnutzer': 'Override-Anmeldung ist nur an einem Systemnutzer-Terminal möglich.',
      'zugangsdaten': 'E-Mail/Benutzername oder Passwort falsch.',
      'unbekannte_karte': 'Diese RFID-Karte ist keinem Konto zugeordnet.',
      'keine_berechtigung': 'Dieses Konto hat keine Berechtigung für die Override-Anmeldung.',
      'passwort_aendern': 'Für dieses Konto muss zuerst das Passwort geändert werden – bitte einmal normal anmelden.',
      'token': 'Anmeldung fehlgeschlagen, bitte erneut versuchen.'
    };
    alert(messages[overrideErr] || 'Anmeldung fehlgeschlagen.');
    history.replaceState({}, '', location.pathname);
  }
})();

// Reiter der rechten Seitenleiste waehlen. Mit id: Leiste oeffnen - ein
// erneuter Klick auf den bereits offenen Reiter klappt sie wieder ein
// (ausser opts.keepOpen). Ohne id: nur den gespeicherten Reiter vorwaehlen.
function activateContextTab(id, opts) {
  const html = document.documentElement;
  const stored = localStorage.getItem('pdh_context_tab') || 'search';
  let selected = id || stored;
  if(!document.querySelector('[data-context-panel="' + selected + '"]')) selected = 'search';
  const isOpen = !html.classList.contains('sidebar-right-collapsed');
  if(id && isOpen && selected === stored && !(opts && opts.keepOpen)) { setRightSidebar(false); return; }
  document.querySelectorAll('[data-context-tab]').forEach(btn => btn.classList.toggle('active', btn.dataset.contextTab === selected));
  document.querySelectorAll('[data-context-panel]').forEach(panel => panel.classList.toggle('active', panel.dataset.contextPanel === selected));
  localStorage.setItem('pdh_context_tab', selected);
  html.classList.toggle('ctx-chat-open', selected === 'chat');
  if(id) setRightSidebar(true);
  if(selected === 'help' && id) pdhLoadContextHelp();
}
document.addEventListener('DOMContentLoaded', () => {
  applySidebarState();
  activateContextTab(null);
});

function pdhToken(){return document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1] || localStorage.getItem('pdh_token') || ''}
function escapeHtml(s){return String(s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}

/* ── Rechtsklick-Kontextmenü (Win11-Stil), projektweit nutzbar ──
   showContextMenu(event, items) öffnet direkt an der Mausposition.
   items: [{label, icon, onClick, danger, disabled, shortcut}] oder
   {separator:true} oder {heading:'...'}.
   bindContextMenu(el, event => items) hängt den Rechtsklick-Handler an
   ein Element, itemsFn wird bei jedem Rechtsklick neu ausgewertet. */
let win11ActiveMenu = null;
function closeContextMenu(){
  if(!win11ActiveMenu) return;
  win11ActiveMenu.remove();
  win11ActiveMenu = null;
  document.removeEventListener('click', closeContextMenu, true);
  document.removeEventListener('contextmenu', win11CloseOnOutsideContext, true);
  document.removeEventListener('keydown', win11CloseOnEscape, true);
  document.removeEventListener('scroll', closeContextMenu, true);
}
function win11CloseOnEscape(e){ if(e.key === 'Escape') closeContextMenu(); }
function win11CloseOnOutsideContext(e){ if(win11ActiveMenu && !win11ActiveMenu.contains(e.target)) closeContextMenu(); }

function showContextMenu(event, items){
  event.preventDefault();
  event.stopPropagation();
  closeContextMenu();
  const menu = document.createElement('div');
  menu.className = 'win11-menu';
  (items || []).forEach(function(item){
    if(item.separator){
      const sep = document.createElement('div');
      sep.className = 'win11-menu-separator';
      menu.appendChild(sep);
      return;
    }
    if(item.heading){
      const heading = document.createElement('div');
      heading.className = 'win11-menu-label';
      heading.textContent = item.heading;
      menu.appendChild(heading);
      return;
    }
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'win11-menu-item' + (item.danger ? ' danger' : '');
    btn.disabled = !!item.disabled;
    if(item.icon){
      const icon = document.createElement('i');
      icon.className = 'ti ' + item.icon;
      btn.appendChild(icon);
    }
    const label = document.createElement('span');
    label.textContent = item.label;
    btn.appendChild(label);
    if(item.shortcut){
      const sc = document.createElement('span');
      sc.className = 'win11-menu-shortcut';
      sc.textContent = item.shortcut;
      btn.appendChild(sc);
    }
    if(!item.disabled){
      btn.addEventListener('click', function(){
        closeContextMenu();
        if(item.onClick) item.onClick();
      });
    }
    menu.appendChild(btn);
  });
  document.body.appendChild(menu);
  win11ActiveMenu = menu;

  const menuRect = menu.getBoundingClientRect();
  let x = event.clientX, y = event.clientY;
  if(x + menuRect.width > window.innerWidth) x = window.innerWidth - menuRect.width - 6;
  if(y + menuRect.height > window.innerHeight) y = window.innerHeight - menuRect.height - 6;
  const z = pdhZoom();
  menu.style.left = Math.max(4, x) / z + 'px';
  menu.style.top = Math.max(4, y) / z + 'px';

  setTimeout(function(){
    document.addEventListener('click', closeContextMenu, true);
    document.addEventListener('contextmenu', win11CloseOnOutsideContext, true);
    document.addEventListener('keydown', win11CloseOnEscape, true);
    document.addEventListener('scroll', closeContextMenu, true);
  }, 0);
}

function bindContextMenu(el, itemsFn){
  if(!el) return;
  el.addEventListener('contextmenu', function(event){
    showContextMenu(event, itemsFn(event));
  });
}
function infraIcon(type){return ({building:'🏭',line:'🔄',plant:'⚙️',device:'🔌'}[type]||'📍')}
function collectInfraBranches(nodes, set){(nodes||[]).forEach(n=>{if((n.children||[]).length){set.add(n.id); collectInfraBranches(n.children,set)}})}
function selectInfra(btn){
  const root=btn.closest('[data-infra-picker]');
  if(!root) return;
  const target=document.getElementById(root.dataset.target);
  const label=document.getElementById(root.dataset.selectedLabel);
  if(target) target.value=btn.dataset.infraId || '';
  if(label) label.textContent=btn.dataset.infraName || 'Keine Infrastruktur ausgewählt';
  root.__infraFocus=btn.dataset.infraId || '';
  root.querySelectorAll('.infra-picker-row.is-focus').forEach(r=>r.classList.remove('is-focus'));
  btn.closest('.infra-picker-row')?.classList.add('is-focus');
}
function clearInfraPicker(root){
  if(!root) return;
  const target=document.getElementById(root.dataset.target);
  const label=document.getElementById(root.dataset.selectedLabel);
  if(target) target.value='';
  if(label) label.textContent='Keine Infrastruktur ausgewählt';
}
async function loadInfraPicker(root){
  if(!root) return;
  const box=root.querySelector('[data-infra-tree]');
  if(box) box.innerHTML='<div class="infra-picker-empty">Lade Baum...</div>';
  try{
    const res=await fetch('/api/v1/infrastructure/tree',{headers:{Authorization:'Bearer '+pdhToken()}});
    const json=await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Infrastruktur konnte nicht geladen werden');
    root.__infraTree=json.data||[];
    root.__infraExpanded=new Set();
    // Aufklappen bis zur aktuellen Auswahl, sonst bis zum Terminal-Standort;
    // ohne beides wie bisher alles aufgeklappt.
    const target=document.getElementById(root.dataset.target);
    const focus=(target && target.value) || window.PDH_TERMINAL_INFRA || '';
    const path=focus ? findInfraPath(root.__infraTree, focus) : null;
    if(path){ path.forEach(id=>root.__infraExpanded.add(id)); root.__infraFocus=focus; }
    else collectInfraBranches(root.__infraTree, root.__infraExpanded);
    renderInfraPicker(root, root.__infraTree);
    if(path) scrollInfraFocus(root);
  }catch(e){
    if(box) box.innerHTML='<div class="infra-picker-empty" style="color:var(--red)">Infrastruktur konnte nicht geladen werden</div>';
  }
}
function renderInfraPicker(root, nodes){
  const box=root.querySelector('[data-infra-tree]');
  if(!box) return;
  if(!nodes.length){box.innerHTML='<div class="infra-picker-empty">Keine Infrastruktur vorhanden</div>'; return}
  box.innerHTML=renderInfraNodes(root, nodes, 0);
}
function findInfraPath(nodes, id){
  for(const n of (nodes||[])){
    if(n.id===id) return [n.id];
    const sub=findInfraPath(n.children, id);
    if(sub) return [n.id, ...sub];
  }
  return null;
}
function scrollInfraFocus(root){
  const box=root.querySelector('[data-infra-tree]');
  const row=box && box.querySelector('.infra-picker-row.is-focus');
  if(row) box.scrollTop=Math.max(0, row.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop - 40);
}
function renderInfraNodes(root, nodes, depth){
  const expanded=root.__infraExpanded||new Set();
  return (nodes||[]).map(n=>{
    const children=n.children||[];
    const hasChildren=children.length>0;
    const open=hasChildren && expanded.has(n.id);
    const toggle=hasChildren
      ? `<button type="button" class="infra-picker-toggle" aria-label="Ast ein- oder ausklappen" aria-expanded="${open}" onclick="toggleInfraBranch(event,this)" data-infra-toggle="${escapeHtml(n.id)}"><i class="ti ti-chevron-right"></i></button>`
      : `<span class="infra-picker-spacer"></span>`;
    return `<div class="infra-picker-node" data-infra-node="${escapeHtml(n.id)}" style="--depth:${depth*12}px"><div class="infra-picker-row${root.__infraFocus===n.id?' is-focus':''}">${toggle}<button type="button" class="infra-picker-select" data-infra-id="${escapeHtml(n.id)}" data-infra-name="${escapeHtml(n.name)}" onclick="selectInfra(this)">${infraIcon(n.type)} ${escapeHtml(n.name)} <span class="infra-picker-type">${escapeHtml(n.type)}</span></button></div>${hasChildren?`<div data-infra-children="${escapeHtml(n.id)}" style="display:${open?'block':'none'}">${renderInfraNodes(root, children, depth+1)}</div>`:''}</div>`;
  }).join('');
}
function toggleInfraBranch(event, btn){
  event.stopPropagation();
  const root=btn.closest('[data-infra-picker]');
  const id=btn.dataset.infraToggle;
  root.__infraExpanded=root.__infraExpanded||new Set();
  if(root.__infraExpanded.has(id)) root.__infraExpanded.delete(id); else root.__infraExpanded.add(id);
  const q=(root.querySelector('[data-infra-filter]')?.value||'').toLowerCase().trim();
  renderInfraPicker(root, q ? filterInfraTree(root.__infraTree||[], q) : (root.__infraTree||[]));
}
function filterInfraTree(nodes, q){return (nodes||[]).map(n=>{const children=filterInfraTree(n.children||[],q); const match=String(n.name||'').toLowerCase().includes(q)||String(n.type||'').toLowerCase().includes(q); return match||children.length?{...n,children}:null}).filter(Boolean)}
function filterInfraPicker(input){const root=input.closest('[data-infra-picker]'); const q=input.value.toLowerCase().trim(); renderInfraPicker(root, q ? filterInfraTree(root.__infraTree||[], q) : (root.__infraTree||[]))}
document.addEventListener('input', event => {
  if(event.target.matches('[data-infra-filter]')) filterInfraPicker(event.target);
});
document.addEventListener('DOMContentLoaded',()=>document.querySelectorAll('[data-infra-picker]').forEach(loadInfraPicker));

let globalStatusTimer = null;
let selectedListItem = null;
function setGlobalStatus(state, message, progress, errorText) {
  const footer = document.getElementById('global-status-footer');
  if(!footer) return;
  const normalized = ['ok','busy','warn','error'].includes(state) ? state : 'ok';
  footer.className = 'global-footer ' + normalized;
  const text = document.getElementById('footer-status-text');
  const error = document.getElementById('footer-status-error');
  const fill = document.getElementById('footer-progress-fill');
  if(text) text.textContent = message || (normalized === 'busy' ? 'Arbeite...' : 'Bereit');
  if(error) error.textContent = errorText || (normalized === 'error' ? (message || 'Fehler') : 'Keine Fehler');
  if(fill) {
    let width = progress;
    if(width === undefined || width === null) width = normalized === 'busy' ? 45 : 100;
    fill.style.width = Math.max(0, Math.min(100, Number(width) || 0)) + '%';
  }
  if(globalStatusTimer) window.clearTimeout(globalStatusTimer);
  if(normalized === 'ok') {
    globalStatusTimer = window.setTimeout(() => {
      if(fill) fill.style.width = '0%';
    }, 1200);
  }
}
function showGlobalError(message, detail) {
  setGlobalStatus('error', message || 'Fehler', 100, detail || message || 'Fehler');
}
function csrfHeaders() {
  const token = document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1] || TOKEN;
  return token ? {'Authorization':'Bearer '+token} : {};
}
function markSelectedListItem(item) {
  if(!item) return;
  document.querySelectorAll('.selectable-item.is-selected').forEach(el => {
    if(el !== item) el.classList.remove('is-selected');
  });
  selectedListItem = item;
  item.classList.add('is-selected');
  const title = item.dataset.title || item.querySelector('.li-title')?.textContent || item.textContent || '';
  setGlobalStatus('ok', 'Ausgewaehlt: ' + title.trim().slice(0, 80), 100, 'Keine Fehler');
}
function getSelectedListItem() {
  if(selectedListItem && document.body.contains(selectedListItem)) return selectedListItem;
  selectedListItem = document.querySelector('.selectable-item.is-selected');
  if(selectedListItem) return selectedListItem;
  setGlobalStatus('warn', 'Bitte zuerst einen Listeneintrag auswaehlen', 100, 'Keine Auswahl');
  return null;
}
function resolveTargetElement(selectorOrId, root) {
  if(!selectorOrId) return null;
  const scope = root || document;
  if(selectorOrId.startsWith('#') || selectorOrId.startsWith('.') || selectorOrId.includes('[')) {
    return scope.querySelector(selectorOrId) || document.querySelector(selectorOrId);
  }
  return document.getElementById(selectorOrId) || scope.querySelector(selectorOrId);
}
async function postSelectedAction(item, action) {
  const url = item.dataset[action + 'Url'] || item.dataset.actionUrl;
  if(!url) return false;
  const method = item.dataset[action + 'Method'] || item.dataset.actionMethod || 'POST';
  const headers = csrfHeaders();
  let body = null;
  const bodyValue = item.dataset[action + 'Body'] || item.dataset.actionBody;
  if(bodyValue) {
    headers['Content-Type'] = 'application/x-www-form-urlencoded;charset=UTF-8';
    body = bodyValue;
  }
  setGlobalStatus('busy', 'Sende Aktion...', 45, '');
  const res = await fetch(url, {method, headers, body});
  if(!res.ok) throw new Error('HTTP ' + res.status + ' ' + res.statusText);
  setGlobalStatus('ok', 'Aktion ausgefuehrt', 100, 'Keine Fehler');
  window.setTimeout(() => location.reload(), 350);
  return true;
}
async function runSelectedItemAction(action) {
  const item = getSelectedListItem();
  if(!item) return false;
  try {
    if(action === 'view') {
      const href = item.dataset.viewHref || item.dataset.href || item.getAttribute('data-href') || item.querySelector('a[href]')?.getAttribute('href');
      if(href) location.href = href;
      else setGlobalStatus('warn', 'Keine Detailansicht hinterlegt', 100, 'Keine Detailansicht');
      return false;
    }
    if(action === 'edit') {
      const target = resolveTargetElement(item.dataset.editTarget, item);
      if(target) {
        target.style.display = target.style.display === 'none' || !target.style.display ? 'block' : 'none';
        setGlobalStatus('ok', 'Bearbeiten umgeschaltet', 100, 'Keine Fehler');
      } else if(item.dataset.editUrl) {
        location.href = item.dataset.editUrl;
      } else {
        setGlobalStatus('warn', 'Keine Bearbeiten-Aktion hinterlegt', 100, 'Keine Bearbeiten-Aktion');
      }
      return false;
    }
    if(action === 'save') {
      const form = resolveTargetElement(item.dataset.saveTarget, item) || resolveTargetElement(item.dataset.editTarget, item)?.querySelector('form');
      if(form && form.requestSubmit) form.requestSubmit();
      else if(form) form.submit();
      else setGlobalStatus('warn', 'Kein Formular zum Speichern gefunden', 100, 'Kein Formular');
      return false;
    }
    if(action === 'cancel') {
      const target = resolveTargetElement(item.dataset.cancelTarget || item.dataset.editTarget, item);
      if(target) {
        target.style.display = 'none';
        setGlobalStatus('ok', 'Abgebrochen', 100, 'Keine Fehler');
      } else {
        setGlobalStatus('warn', 'Keine Abbrechen-Aktion hinterlegt', 100, 'Keine Abbrechen-Aktion');
      }
      return false;
    }
    if(action === 'copy') {
      if(await postSelectedAction(item, 'copy')) return false;
      const text = item.dataset.copyText || item.dataset.title || item.textContent;
      if(navigator.clipboard && text) {
        await navigator.clipboard.writeText(text.trim());
        setGlobalStatus('ok', 'In Zwischenablage kopiert', 100, 'Keine Fehler');
      } else {
        setGlobalStatus('warn', 'Keine Kopieren-Aktion hinterlegt', 100, 'Keine Kopieren-Aktion');
      }
      return false;
    }
    if(action === 'refresh') {
      location.reload();
      return false;
    }
    // Erledigen von Vorgaengen: immer ueber den Abschluss-Assistenten
    if(action === 'done' && item.dataset.complete) {
      const [type, id] = item.dataset.complete.split(':');
      pdhComplete(type, id);
      return false;
    }
    if(['analyze','done','activate','deactivate','delete','start','stop'].includes(action)) {
      return await postSelectedAction(item, action);
    }
    setGlobalStatus('warn', 'Aktion nicht hinterlegt: ' + action, 100, 'Unbekannte Aktion');
  } catch(err) {
    showGlobalError('Aktion fehlgeschlagen', err.message || String(err));
  }
  return false;
}
document.addEventListener('click', (event) => {
  const item = event.target.closest('[data-selectable]');
  if(!item) return;
  if(event.target.closest('button,input,select,textarea,label,.widget-icon-toolbar,[data-ignore-select]')) return;
  const link = event.target.closest('a[href]');
  if(link && item.contains(link)) event.preventDefault();
  markSelectedListItem(item);
});
document.addEventListener('dblclick', (event) => {
  const item = event.target.closest('[data-selectable]');
  if(!item || event.target.closest('button,input,select,textarea,label,[data-ignore-select]')) return;
  const link = event.target.closest('a[href]');
  if(link && item.contains(link)) event.preventDefault();
  markSelectedListItem(item);
  runSelectedItemAction('view');
});
document.addEventListener('DOMContentLoaded', () => {
  setGlobalStatus('ok', 'Bereit', 100, 'Keine Fehler');
});
// ── Aufklappbare Listenzeilen ────────────────────────────
// Einheitliche Bedienung aller Listen und Tabellen: Klick (oder Enter) auf eine
// Zeile mit data-rx klappt sie auf, darunter erscheinen die Aktionen. Attribute:
//   data-rx-view="/url"   Ansehen (Schnellansicht im Overlay)
//   data-rx-edit="/url"   Bearbeiten (öffnet den Datensatz); Doppelklick ebenso
//   data-rx-done="art:id" Fertigstellen über den Abschluss-Assistenten
//                         (data-rx-done-label / data-rx-done-icon ändern Text/Symbol)
//   data-rx-title, data-rx-desc  Titel bzw. Kurztext im aufgeklappten Bereich
//   <template class="rx-more"> in der Zeile: weitere, seitenspezifische Knöpfe
(function(){
  const IGNORE = 'a,button,input,select,textarea,label,summary,[data-rx-ignore],.win11-menu';
  function close(row){
    const p = row && row.nextElementSibling;
    if(p && p.classList.contains('rx-panel')) p.remove();
    if(row){ row.classList.remove('rx-open'); row.setAttribute('aria-expanded', 'false'); }
  }
  function btn(tag, cls, icon, label){
    const b = document.createElement(tag);
    b.className = 'btn btn-small ' + cls;
    if(tag === 'button') b.type = 'button';
    const i = document.createElement('i'); i.className = 'ti ' + icon;
    b.append(i, ' ' + label);
    return b;
  }
  function build(row){
    const d = row.dataset, box = document.createElement('div');
    box.className = 'rx-box';
    const title = d.rxTitle || '';
    if(d.rxDesc){ const p = document.createElement('div'); p.className = 'rx-desc'; p.textContent = d.rxDesc; box.appendChild(p); }
    if(d.rxView){
      const b = btn('button', '', 'ti-eye', {{t "Ansehen"}});
      b.addEventListener('click', () => openPdhFrame(d.rxView, title));
      box.appendChild(b);
    }
    if(d.rxEdit){
      const a = btn('a', '', 'ti-edit', {{t "Bearbeiten"}});
      a.href = d.rxEdit;
      box.appendChild(a);
    }
    if(d.rxDone){
      const [kind, id] = d.rxDone.split(':');
      const b = btn('button', 'cw-finish', d.rxDoneIcon || 'ti-circle-check', d.rxDoneLabel || {{t "Fertigstellen"}});
      b.addEventListener('click', () => window.pdhComplete && window.pdhComplete(kind, id));
      box.appendChild(b);
    }
    const more = row.querySelector('template.rx-more');
    if(more){
      const g = document.createElement('span'); g.className = 'grow'; box.appendChild(g);
      box.appendChild(more.content.cloneNode(true));
    }
    if(row.tagName === 'TR'){
      const tr = document.createElement('tr'), td = document.createElement('td');
      tr.className = 'rx-panel';
      td.colSpan = [...row.cells].reduce((n, c) => n + (c.colSpan || 1), 0);
      td.appendChild(box); tr.appendChild(td);
      return tr;
    }
    const div = document.createElement('div');
    div.className = 'rx-panel'; div.appendChild(box);
    return div;
  }
  function toggle(row){
    const wasOpen = row.classList.contains('rx-open');
    document.querySelectorAll('[data-rx].rx-open').forEach(close);
    if(wasOpen) return;
    const panel = build(row);
    row.after(panel);
    row.classList.add('rx-open');
    row.setAttribute('aria-expanded', 'true');
    if(window.htmx) htmx.process(panel);
    const first = panel.querySelector('button,a');
    if(first && row.matches(':focus')) first.focus();
  }
  function prepare(root){
    (root || document).querySelectorAll('[data-rx]:not([tabindex])').forEach(r => {
      r.tabIndex = 0;
      r.setAttribute('aria-expanded', 'false');
      if(!r.title) r.title = {{t "Klicken zum Aufklappen"}} + (r.dataset.rxEdit ? {{t " · Doppelklick öffnet"}} : '');
    });
  }
  window.pdhRowsPrepare = prepare;
  document.addEventListener('click', e => {
    const row = e.target.closest('[data-rx]');
    if(!row || e.target.closest(IGNORE)) return;
    toggle(row);
  });
  document.addEventListener('dblclick', e => {
    const row = e.target.closest('[data-rx]');
    if(!row || e.target.closest(IGNORE) || !row.dataset.rxEdit) return;
    location.href = row.dataset.rxEdit;
  });
  document.addEventListener('keydown', e => {
    const row = e.target.closest && e.target.closest('[data-rx]');
    if(!row || e.target !== row || (e.key !== 'Enter' && e.key !== ' ')) return;
    e.preventDefault();
    toggle(row);
  });
  document.addEventListener('DOMContentLoaded', () => prepare());
  document.addEventListener('htmx:afterSwap', e => prepare(e.target));
})();
const pdhNativeFetch = window.fetch ? window.fetch.bind(window) : null;
if(pdhNativeFetch) {
  window.fetch = async function(input, init) {
    setGlobalStatus('busy', 'Laedt...', 35, '');
    try {
      const response = await pdhNativeFetch(input, init);
      if(response.ok) setGlobalStatus('ok', 'Bereit', 100, 'Keine Fehler');
      else showGlobalError('HTTP ' + response.status, response.statusText || 'Request fehlgeschlagen');
      return response;
    } catch(err) {
      showGlobalError('Netzwerkfehler', err.message || String(err));
      throw err;
    }
  };
}
document.body.addEventListener('htmx:beforeRequest', () => setGlobalStatus('busy', 'Sende Anfrage...', 35, ''));
document.body.addEventListener('htmx:afterRequest', (event) => {
  const xhr = event.detail && event.detail.xhr;
  if(xhr && xhr.status === 423) showGlobalError('Gesperrt', xhr.responseText || 'Datensatz gesperrt');
  else if(xhr && xhr.status >= 400) showGlobalError('HTTP ' + xhr.status, xhr.statusText || 'HTMX-Fehler');
  else setGlobalStatus('ok', 'Bereit', 100, 'Keine Fehler');
});
document.body.addEventListener('htmx:responseError', (event) => {
  const xhr = event.detail && event.detail.xhr;
  showGlobalError('HTMX-Fehler', xhr ? ('HTTP ' + xhr.status + ' ' + xhr.statusText) : 'Antwortfehler');
});
document.body.addEventListener('htmx:sendError', () => showGlobalError('HTMX-Sendefehler', 'Anfrage konnte nicht gesendet werden'));
window.addEventListener('error', (event) => showGlobalError('JavaScript-Fehler', event.message || 'Unbekannter Fehler'));
window.addEventListener('unhandledrejection', (event) => showGlobalError('Promise-Fehler', event.reason && event.reason.message ? event.reason.message : String(event.reason || 'Unbekannter Fehler')));

// Copilot in der Seitenleiste: auf einer Stoerung mit deren Kontext, sonst allgemein
async function sendCop() {
  const input = document.getElementById('cop-in');
  const q = input.value.trim();
  if(!q) return;
  const msgs = document.getElementById('cop-msgs');
  const add = (cls, text, style) => { const d = document.createElement('div'); d.className = cls; if(style) d.style.cssText = style; d.textContent = text; msgs.appendChild(d); msgs.scrollTop = msgs.scrollHeight; return d; };
  add('cop-q', 'Du: ' + q);
  input.value = '';
  const wait = add('cop-a', 'Copilot denkt nach …', 'color:var(--muted)');
  try{
    const res = await fetch('/copilot/ask', {method: 'POST', credentials: 'same-origin', body: new URLSearchParams({q, fault: '{{.FaultID}}'})});
    const raw = await res.text();
    let j = {};
    try{ j = JSON.parse(raw); }catch(e){}
    wait.remove();
    if(!j.reply){
      // keine JSON-Antwort: meist Zeitlimit oder Fehlerseite eines Proxys davor
      let why = j.error;
      if(!why) why = 'HTTP ' + res.status + (res.status === 502 || res.status === 504 || res.status === 524
        ? ' – die Antwort kam nicht durch (Zeitlimit oder Proxy vor PDH). Details im Server-Protokoll unter „copilot“.'
        : (raw ? ' – ' + raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160) : ''));
      add('cop-a', 'Copilot: ' + why, 'color:var(--red)');
    }
    else {
      // Antwort als Text; PDH-Pfade (/faults/…, /inventory/…) werden zu Links
      const a = add('cop-a', 'Copilot: ');
      String(j.reply).split(/(\/(?:faults|tickets|tasks|maintenance\/tasks|projects|infrastructure|inventory)\/[0-9a-fA-F-]{36})/).forEach(function(part, i){
        if(i % 2){ const l = document.createElement('a'); l.href = part; l.textContent = part; l.style.color = 'var(--accent)'; a.appendChild(l); }
        else a.appendChild(document.createTextNode(part));
      });
      if(j.sources && j.sources.length) add('cop-a', 'Aus dem PDH: ' + j.sources.filter((s, i, all) => all.indexOf(s) === i).join(', '), 'color:var(--muted);font-size:11px');
    }
  }catch(e){ wait.remove(); add('cop-a', 'Copilot nicht erreichbar: ' + e.message, 'color:var(--red)'); }
}
</script>
<script>
// PDH-Viewer: verknuepfte Datensaetze (data-frame) bzw. freigegebene
// externe Portale (data-frame-external) im Overlay statt Seitenwechsel.
// Strg/Cmd/Mittelklick oeffnen weiterhin normal im neuen Tab.
function openPdhFrame(href, title, external){
  closePdhFrame();
  const wrap = document.createElement('div');
  wrap.className = 'pdh-frame';
  wrap.id = 'pdh-frame';
  wrap.addEventListener('click', function(e){ if(e.target === wrap) closePdhFrame(); });
  const panel = document.createElement('div');
  panel.className = 'pdh-frame-panel';
  const head = document.createElement('div');
  head.className = 'pdh-frame-head';
  const t = document.createElement('div');
  t.className = 'pdh-frame-title';
  t.textContent = title || href;
  const btn = function(icon, label, fn){
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'btn btn-small'; b.title = label;
    b.innerHTML = '<i class="ti '+icon+'"></i>';
    b.addEventListener('click', fn);
    return b;
  };
  const frame = document.createElement('iframe');
  frame.name = external ? 'pdh-external' : 'pdh-embed';
  if(external){
    frame.setAttribute('sandbox', 'allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-downloads');
    frame.setAttribute('referrerpolicy', 'no-referrer');
  }
  frame.src = href;
  head.appendChild(t);
  head.appendChild(btn('ti-arrows-maximize', 'Breite umschalten', function(){ panel.classList.toggle('wide'); }));
  head.appendChild(btn('ti-external-link', 'In neuem Tab öffnen', function(){
    let url = href;
    try { if(!external && frame.contentWindow) url = frame.contentWindow.location.href; } catch(e) {}
    window.open(url, '_blank', 'noopener');
  }));
  head.appendChild(btn('ti-x', 'Schließen', closePdhFrame));
  panel.appendChild(head);
  if(external){
    const hint = document.createElement('div');
    hint.className = 'pdh-frame-hint';
    hint.innerHTML = '<i class="ti ti-info-circle"></i> Externes Portal. Bleibt die Ansicht leer, verbietet der Anbieter die Einbettung – dann über <i class="ti ti-external-link"></i> in neuem Tab öffnen.';
    panel.appendChild(hint);
  }
  panel.appendChild(frame);
  wrap.appendChild(panel);
  document.body.appendChild(wrap);
}
function closePdhFrame(){
  const f = document.getElementById('pdh-frame');
  if(f) f.remove();
}
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closePdhFrame(); });

// Reiter der Stammdaten-Detailseiten (.rec-tab[data-tab] / .rec-pane[data-pane]);
// der aktive Reiter steht in ?tab=, damit Links und Ruecksprung ihn behalten.
function recTab(tab){
  const tabs = document.querySelectorAll('.rec-tab[data-tab]');
  if(!tabs.length) return;
  if(!document.querySelector('.rec-pane[data-pane="'+tab+'"]')) tab = tabs[0].dataset.tab;
  tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.rec-pane').forEach(p => p.classList.toggle('active', p.dataset.pane === tab));
  const u = new URL(location.href);
  u.searchParams.set('tab', tab); u.searchParams.delete('msg'); u.searchParams.delete('err');
  history.replaceState(null, '', u);
}
document.addEventListener('click', function(e){
  const t = e.target.closest('.rec-tab[data-tab]');
  if(t){ e.preventDefault(); recTab(t.dataset.tab); }
});
document.addEventListener('DOMContentLoaded', function(){
  if(document.querySelector('.rec-tab[data-tab]')) recTab(new URL(location.href).searchParams.get('tab') || '');
});

// ── Kontexthilfe: Handbuchkapitel zur aktuellen Seite ────
// Kapitel in /help tragen data-pages="<BaseData.Page …>"; ohne Treffer
// wird das allgemeine Kapitel "Arbeiten mit Datensaetzen" gezeigt.
let pdhHelpLoaded = false;
async function pdhLoadContextHelp(){
  const box = document.getElementById('ctx-help');
  if(!box || pdhHelpLoaded) return;
  pdhHelpLoaded = true;
  try {
    const res = await fetch('/help?fragment=1', {credentials: 'same-origin'});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    const page = box.dataset.page;
    const sections = [...doc.querySelectorAll('section[data-pages]')];
    const sec = sections.find(s => (s.dataset.pages || '').split(/\s+/).includes(page)) || doc.getElementById('records') || sections[0];
    if(!sec) throw new Error('kein Kapitel');
    // Styles und SVG-Definitionen der Illustrationen mitnehmen
    const extras = [...doc.querySelectorAll('style'), ...doc.querySelectorAll('body > svg')].map(e => e.outerHTML).join('');
    box.innerHTML = extras + sec.innerHTML;
    if(typeof initAttachmentGalleries === 'function') initAttachmentGalleries();
    const link = document.getElementById('ctx-help-chapter');
    if(link) link.href = '/help#' + sec.id;
    // Kapitel-interne Links (#…) ins Handbuch umleiten
    box.querySelectorAll('a[href^="#"]').forEach(a => a.href = '/help' + a.getAttribute('href'));
  } catch(e){ pdhHelpLoaded = false; box.textContent = 'Hilfe konnte nicht geladen werden (' + e.message + ').'; }
}

// ── Zurueck zur vorherigen Seite ─────────────────────────
// Pro Browser-Tab (sessionStorage) wird der Seitenverlauf gefuehrt; Zurueck-
// Knoepfe (Pfeil links / "Zurück" / data-back) springen zur vorherigen ANDEREN
// Seite. Reiterwechsel, Speichern (Redirect auf dieselbe Seite) und Meldungen
// zaehlen nicht als eigener Schritt. Ohne Vorgaenger gilt das feste href.
(function(){
  if(document.documentElement.classList.contains('pdh-embedded')) return;
  const KEY = 'pdh_nav';
  let stack = [];
  try { stack = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch(e) { stack = []; }
  const clean = location.search.replace(/([?&])(msg|err)=[^&]*/g, '$1').replace(/[?&]+$/, '').replace('?&', '?');
  const here = {p: location.pathname, u: location.pathname + clean, t: document.title.replace(/^PDH – /, '')};
  const last = stack[stack.length - 1];
  if(last && last.p === here.p) { last.u = here.u; last.t = here.t; }
  else if(stack.length > 1 && stack[stack.length - 2].p === here.p) { stack.pop(); stack[stack.length - 1].u = here.u; } // Browser-Zurueck
  else { stack.push(here); if(stack.length > 40) stack = stack.slice(-40); }
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(stack)); } catch(e) {} };
  save();
  // aktuellen Reiter (?tab=) im Verlauf mitfuehren, damit "zurueck" dort landet
  window.addEventListener('pagehide', () => {
    const top = stack[stack.length - 1];
    if(top && top.p === location.pathname) { top.u = location.pathname + location.search.replace(/([?&])(msg|err)=[^&]*/g, '$1').replace(/[?&]+$/, '').replace('?&', '?'); save(); }
  });
  function previous(){
    for(let i = stack.length - 2; i >= 0; i--) if(stack[i].p !== here.p) return i;
    return -1;
  }
  const isBack = a => a && a.tagName === 'A' && (a.hasAttribute('data-back') || a.getAttribute('aria-label') === 'Zurück' ||
    (a.classList.contains('btn-icon') && a.querySelector('i.ti-arrow-left')));
  document.addEventListener('click', e => {
    const a = e.target.closest('a');
    if(!isBack(a) || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
    const i = previous();
    if(i < 0) return; // kein Vorgaenger: festes Ziel
    e.preventDefault();
    const target = stack[i].u;
    stack = stack.slice(0, i + 1); save();
    location.href = target;
  });
  document.addEventListener('DOMContentLoaded', () => {
    const i = previous();
    if(i < 0) return;
    document.querySelectorAll('a').forEach(a => { if(isBack(a)) { a.title = 'Zurück zu: ' + stack[i].t; a.setAttribute('aria-label', 'Zurück'); } });
  });
})();

// "Im Chat teilen": aktuelle Seite (ohne embed-Parameter) an den Chat uebergeben
// Oeffnet den Chat in der rechten Seitenleiste im Teilen-Modus (Fallback: Chat-Seite).
function pdhShareToChat(){
  const path = location.pathname + location.search.replace(/[?&]embed=1/, '').replace(/[?&](msg|err)=[^&]*/g, '');
  const title = ((document.querySelector('.main h1') || {}).textContent || document.title.replace(/^PDH – /, '')).trim();
  if(window.pdhSideChat) { window.pdhSideChat.share(location.origin + path, title); return; }
  location.href = '/chat?share=' + encodeURIComponent(path) + '&title=' + encodeURIComponent(title);
}
</script>
{{if and .CanChat (ne .Page "chat")}}
<script>
// Chat in der rechten Seitenleiste: Ungelesen-Zaehler, Chatliste,
// Unterhaltung mit Antworten und automatisches Oeffnen bei neuer Nachricht
// (nicht in eingebetteten Ansichten und nicht auf der Chat-Seite selbst).
(function(){
  if(document.documentElement.classList.contains('pdh-embedded') || !window.EventSource) return;
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const S = {me: null, users: {}, convs: {}, teams: {}, current: null, msgs: [], loaded: false};
  const COLORS = ['#4f6ef7','#10b981','#f59e0b','#ef4444','#7c3aed','#0ea5e9','#ec4899','#14b8a6'];
  const color = id => { let h = 0; for(const c of String(id)) h = (h*31 + c.charCodeAt(0)) >>> 0; return COLORS[h % COLORS.length]; };
  const userName = id => (S.users[id] && S.users[id].name) || 'Unbekannt';
  const other = c => (c.members || []).find(id => id !== S.me);
  function convName(c){
    if(c.kind === 'direct'){ const o = other(c); return o ? userName(o) : 'Notizen'; }
    if(c.kind === 'channel') return '# ' + c.name + (S.teams[c.team_id] ? ' · ' + S.teams[c.team_id] : '');
    return c.name || (c.members || []).filter(id => id !== S.me).map(id => userName(id).split(' ')[0]).join(', ') || 'Gruppe';
  }
  function avatar(c){
    const id = c.kind === 'direct' ? (other(c) || S.me) : c.id;
    let inner = '#';
    if(c.kind === 'direct') inner = esc((S.users[id] && S.users[id].initials) || '?');
    if(c.kind === 'group') inner = '<i class="ti ti-users"></i>';
    return '<span class="sc-av" style="background:' + color(id) + '">' + inner + '</span>';
  }
  function time(ts){
    const d = new Date(ts), t = new Date();
    return d.toDateString() === t.toDateString()
      ? d.toLocaleTimeString(PDH_LOCALE, {hour: '2-digit', minute: '2-digit'})
      : d.toLocaleDateString(PDH_LOCALE, {day: '2-digit', month: '2-digit'});
  }
  function renderBody(m){
    let s = esc(m.body);
    s = s.replace(/(https?:\/\/[^\s<]+[^\s<.,;:!?)])/g, function(u){
      if(u.startsWith(location.origin + '/')) return '<a href="' + u + '" data-frame>' + u + '</a>';
      return '<a href="' + u + '" target="_blank" rel="noopener noreferrer">' + u + '</a>';
    });
    (m.mentions || []).forEach(function(uid){
      const n = esc('@' + userName(uid));
      s = s.split(n).join('<b class="sc-mention">' + n + '</b>');
    });
    return s;
  }
  async function api(method, url, body){
    const opt = {method: method, credentials: 'same-origin'};
    if(body) opt.body = body;
    const res = await fetch(url, opt);
    const d = res.status === 204 ? null : await res.json().catch(function(){ return {}; });
    if(!res.ok) throw new Error((d && d.error) || ('HTTP ' + res.status));
    return d;
  }

  // ── Zaehler ──
  function updateBadges(){
    let total = 0, mention = false;
    Object.values(S.convs).forEach(function(c){ if(!c.muted) total += c.unread; if(c.mentions) mention = true; });
    const txt = total > 99 ? '99+' : String(total);
    ['chat-nav-badge', 'ctx-chat-badge', 'top-chat-badge'].forEach(function(id){
      const b = $(id); if(!b) return;
      b.textContent = txt; b.style.display = total ? '' : 'none';
      b.style.background = mention ? 'var(--red)' : 'var(--accent)';
    });
  }

  // ── Laden ──
  async function bootstrap(){
    const d = await api('GET', '/chat/api/bootstrap');
    S.me = d.me; S.users = {}; d.users.forEach(function(u){ S.users[u.id] = u; });
    S.teams = {}; (d.teams || []).forEach(function(t){ S.teams[t.id] = t.name; });
    S.convs = {}; d.conversations.forEach(function(c){ S.convs[c.id] = c; });
    S.loaded = true;
    updateBadges();
    if(!S.current) renderList();
  }

  function renderList(){
    S.current = null;
    $('sc-title').textContent = 'Chat';
    $('sc-back').style.display = 'none';
    $('sc-full').href = '/chat';
    $('sc-compose').style.display = 'none';
    const list = Object.values(S.convs).sort(function(a, b){ return new Date(b.last_message_at) - new Date(a.last_message_at); });
    $('sc-body').innerHTML = list.map(function(c){
      const p = c.preview;
      const prev = p ? ((p.user_id === S.me ? 'Du: ' : '') + (p.body || '📎 Datei')) : '';
      let badge = '';
      if(c.mentions) badge = '<span class="sc-badge" style="background:var(--red)">@</span>';
      else if(c.unread) badge = '<span class="sc-badge">' + c.unread + '</span>';
      return '<div class="sc-item' + (c.unread ? ' unread' : '') + '" data-conv="' + c.id + '">' + avatar(c) +
        '<div class="sc-t"><div class="sc-n">' + esc(convName(c)) + '</div><div class="sc-p">' + esc(prev) + '</div></div>' +
        '<div class="sc-meta">' + (p ? time(p.created_at) : '') + badge + '</div></div>';
    }).join('') || '<div class="sc-empty">Noch keine Unterhaltungen.<br><a href="/chat" style="color:var(--accent)">Chat öffnen</a></div>';
  }

  async function openConv(id){
    const c = S.convs[id]; if(!c) return;
    S.current = id;
    $('sc-title').textContent = convName(c);
    $('sc-back').style.display = '';
    $('sc-full').href = '/chat#c=' + id;
    $('sc-compose').style.display = '';
    $('sc-body').innerHTML = '<div class="sc-empty">Wird geladen…</div>';
    try {
      const d = await api('GET', '/chat/api/conversations/' + id + '/messages');
      if(S.current !== id) return;
      S.msgs = d.messages.slice(-60);
      renderMsgs();
      markRead();
      if(S.share){
        // Teilen: Titel und Link vorbelegen, Absenden bleibt beim Benutzer
        $('sc-input').value = (S.share.title ? S.share.title + '\n' : '') + S.share.url;
        S.share = null; $('sc-share').style.display = 'none';
        $('sc-input').focus();
      }
    } catch(e){ $('sc-body').innerHTML = '<div class="sc-empty">' + esc(e.message) + '</div>'; }
  }

  function renderMsgs(){
    const box = $('sc-body');
    box.innerHTML = S.msgs.map(function(m){
      if(m.kind === 'system') return '<div class="sc-sys">' + esc(m.body) + '</div>';
      const mine = m.user_id === S.me;
      const links = (m.links || []).map(function(l){
        return '<a class="sc-card" href="' + l.url + '" data-frame data-frame-title="' + esc(l.label + ': ' + l.title) + '"><i class="ti ' + l.icon + '"></i> ' + esc(l.title) + '</a>';
      }).join('');
      const files = (m.files || []).map(function(f){
        return '<a class="sc-card" href="' + f.url + '" target="_blank" rel="noopener"><i class="ti ' + (f.is_image ? 'ti-photo' : 'ti-file') + '"></i> ' + esc(f.name) + '</a>';
      }).join('');
      let bubble = '';
      if(m.deleted) bubble = '<div class="sc-bubble" style="font-style:italic;opacity:.6">gelöscht</div>';
      else if(m.body) bubble = '<div class="sc-bubble">' + renderBody(m) + '</div>';
      const who = mine ? '' : '<div class="sc-who">' + esc(userName(m.user_id)) + (m.parent_id ? ' <i class="ti ti-arrow-back-up"></i>' : '') + '</div>';
      return '<div class="sc-msg' + (mine ? ' mine' : '') + '">' + who + bubble + links + files + '<div class="sc-time">' + time(m.created_at) + '</div></div>';
    }).join('') || '<div class="sc-empty">Noch keine Nachrichten</div>';
    box.scrollTop = box.scrollHeight;
  }

  let readTimer = null;
  function markRead(){
    const c = S.convs[S.current];
    if(!c || document.hidden || document.documentElement.classList.contains('sidebar-right-collapsed')) return;
    clearTimeout(readTimer);
    readTimer = setTimeout(function(){
      c.unread = 0; c.mentions = 0; updateBadges();
      fetch('/chat/api/conversations/' + c.id + '/read', {method: 'POST', credentials: 'same-origin'}).catch(function(){});
    }, 500);
  }

  async function send(){
    const ta = $('sc-input'); const text = ta.value.trim();
    if(!text || !S.current) return;
    const fd = new FormData(); fd.append('body', text);
    ta.disabled = true;
    try {
      const m = await api('POST', '/chat/api/conversations/' + S.current + '/messages', fd);
      ta.value = '';
      if(!S.msgs.some(function(x){ return x.id === m.id; })) S.msgs.push(m);
      renderMsgs();
    } catch(e){ alert('Senden fehlgeschlagen: ' + e.message); }
    finally { ta.disabled = false; ta.focus(); }
  }

  // Laufende Eingabe irgendwo auf der Seite? Dann die Leiste nicht ungefragt umschalten.
  function userIsTyping(){
    const a = document.activeElement;
    if(!a || a.value === '' || a.value === undefined) return false;
    if(a.tagName === 'TEXTAREA') return true;
    return a.tagName === 'INPUT' && ['checkbox', 'radio', 'button', 'submit', 'hidden'].indexOf(a.type) < 0;
  }

  function onMessage(m){
    const c = S.convs[m.conversation_id];
    if(!c){ bootstrap().catch(function(){}); return; }
    c.last_message_at = m.created_at;
    c.preview = {user_id: m.user_id, body: m.body, kind: m.kind, created_at: m.created_at};
    const open = !document.documentElement.classList.contains('sidebar-right-collapsed') && localStorage.getItem('pdh_context_tab') === 'chat';
    if(S.current === m.conversation_id && !S.msgs.some(function(x){ return x.id === m.id; })){
      S.msgs.push(m); renderMsgs();
    }
    if(m.user_id === S.me || m.kind !== 'text'){ if(!S.current) renderList(); return; }
    if(S.current === m.conversation_id && open && !document.hidden) markRead();
    else { c.unread++; if((m.mentions || []).indexOf(S.me) >= 0) c.mentions++; }
    updateBadges();
    // Automatisch oeffnen (nicht bei stummgeschalteten Chats / laufender Eingabe;
    // auf Smartphone/Tablet nur Zaehler, damit das Overlay nicht die Arbeit verdeckt)
    if(!c.muted && !userIsTyping() && !(typeof PDH_NARROW !== 'undefined' && PDH_NARROW.matches)){
      activateContextTab('chat', {keepOpen: true});
      if(S.current !== m.conversation_id && !$('sc-input').value) openConv(m.conversation_id);
    } else if(!S.current) renderList();
  }

  // ── Ereignisse ──
  document.addEventListener('DOMContentLoaded', function(){
    if(!$('sc-body')) return;
    $('sc-back').onclick = renderList;
    $('sc-body').addEventListener('click', function(e){ const it = e.target.closest('[data-conv]'); if(it) openConv(it.dataset.conv); });
    $('sc-send').onclick = send;
    $('sc-input').addEventListener('keydown', function(e){ if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(); } });
    bootstrap().catch(function(){});
    const es = new EventSource('/chat/stream');
    es.addEventListener('chat', function(e){
      const ev = JSON.parse(e.data);
      if(!S.loaded) return;
      if(ev.type === 'message') onMessage(ev.data);
      else if(ev.type === 'message_updated' && S.current === ev.data.conversation_id){
        const i = S.msgs.findIndex(function(x){ return x.id === ev.data.id; });
        if(i >= 0){ S.msgs[i] = ev.data; renderMsgs(); }
      } else if(ev.type === 'read' && ev.data.user_id === S.me && S.convs[ev.data.conversation_id]){
        S.convs[ev.data.conversation_id].unread = 0; S.convs[ev.data.conversation_id].mentions = 0;
        updateBadges(); if(!S.current) renderList();
      } else if(ev.type === 'refresh') bootstrap().catch(function(){});
    });
    window.addEventListener('pagehide', function(){ es.close(); });
  });
  // wird von activateContextTab aufgerufen, wenn der Chat-Reiter sichtbar wird
  window.pdhSideChat = {
    shown: function(){ if(S.current) markRead(); else if(S.loaded) renderList(); },
    // bestimmte Unterhaltung in der Seitenleiste oeffnen (z. B. "Chat" auf der Benutzerseite)
    open: async function(convId){
      if(!S.convs[convId]) await bootstrap();
      activateContextTab('chat', {keepOpen: true});
      openConv(convId);
      setTimeout(function(){ const i = $('sc-input'); if(i) i.focus(); }, 300);
    },
    // "Im Chat teilen": Seitenleiste oeffnen, Unterhaltung auswaehlen lassen
    share: function(url, title){
      S.share = {url: url, title: title};
      const box = $('sc-share');
      box.innerHTML = '<i class="ti ti-share"></i><span style="flex:1">Unterhaltung wählen, um <b></b> zu teilen</span><a href="#" title="Abbrechen"><i class="ti ti-x"></i></a>';
      box.querySelector('b').textContent = title || url;
      box.querySelector('a').onclick = function(e){ e.preventDefault(); S.share = null; box.style.display = 'none'; };
      box.style.display = 'flex';
      activateContextTab('chat', {keepOpen: true});
      if(S.current) renderList();
    }
  };
  document.addEventListener('visibilitychange', function(){ if(!document.hidden) markRead(); });
})();
</script>
{{end}}
<script>
document.addEventListener('click', function(e){
  const a = e.target.closest('[data-frame],[data-frame-external]');
  if(!a || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
  // Innerhalb einer eingebetteten Ansicht normal navigieren (kein Overlay im Overlay)
  if(document.documentElement.classList.contains('pdh-embedded') && a.hasAttribute('data-frame')) return;
  e.preventDefault();
  e.stopPropagation();
  openPdhFrame(a.getAttribute('href') || a.dataset.href, a.dataset.frameTitle || a.textContent.trim(), a.hasAttribute('data-frame-external'));
}, true);
</script>
<script>
// Ersatzteil-Reservierung: (teilweise) zurueck an den Lagerplatz buchen.
// reload: Funktion zum Neuladen der Liste (sonst ganze Seite).
async function pdhReturnReservation(kind, ref, id, max, reload){
  const v = prompt({{t "Wie viel zurückbuchen? (reserviert: %s)" "#"}}.replace('#', max), String(max));
  if(v === null) return;
  const qty = parseFloat(String(v).replace(',', '.'));
  if(!(qty > 0)){ alert({{t "Bitte eine Menge größer 0 angeben."}}); return; }
  try{
    const res = await fetch('/reservations/' + encodeURIComponent(kind) + '/' + encodeURIComponent(ref) + '/' + encodeURIComponent(id) + '/return',
      {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({qty: Math.min(qty, max)})});
    const j = await res.json();
    if(!res.ok || j.success === false) throw new Error(j.error || ('HTTP ' + res.status));
    if(typeof reload === 'function') reload(); else location.reload();
  }catch(e){ alert({{t "Fehler"}} + ': ' + e.message); }
}
// Kennzeichnung + Rueckbuchen-Knopf fuer eine vorgemerkte Position (p aus .../pending-parts)
function pdhReservedTag(p, kind, ref, reloadName){
  if(!p || !p.reserved) return '';
  const a = [kind, ref, p.id].map(x => "'" + String(x).replace(/[^\w-]/g, '') + "'").join(',');
  return ' · <span class="res-q" title="' + {{t "bereits vom Lager abgebucht"}} + '">' + {{t "reserviert"}} + '</span>'
    + ' <button type="button" class="btn btn-small" style="font-size:11px;padding:2px 8px" title="' + {{t "Nicht benötigte Menge zurück an den Lagerplatz buchen"}} + '" onclick="pdhReturnReservation(' + a + ',' + Number(p.qty) + ',' + reloadName + ')"><i class="ti ti-arrow-back-up"></i> ' + {{t "Zurückbuchen"}} + '</button>';
}
</script>
{{block "scripts" .}}{{end}}
</body>
</html>
<script>
async function uploadFiles(input, refType, refId) {
  if(!input.files.length) return;
  const token = document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1]||'';
  const fd = new FormData();
  for(const f of input.files) fd.append('files', f);
  
  const res = await fetch('/api/v1/attachments/'+refType+'/'+refId, {
    method:'POST', headers:{'Authorization':'Bearer '+token}, body:fd
  });
  const data = await res.json();
  if(data.data) {
    const container = document.getElementById('attachments-'+refId);
    if(container) {
      data.data.forEach(a => {
        container.insertAdjacentHTML('beforeend',
          `<div style="position:relative">
            <img src="${a.url}" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid var(--border)">
            <button onclick="deleteAttachment('${a.id}','${refType}','${refId}')"
              style="position:absolute;top:-6px;right:-6px;background:var(--red);border:0;color:#fff;border-radius:50%;width:18px;height:18px;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center">×</button>
          </div>`
        );
      });
    }
  }
}

async function deleteAttachment(id, refType, refId) {
  const token = document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1]||'';
  await fetch('/api/v1/attachments/'+id, {method:'DELETE',headers:{'Authorization':'Bearer '+token}});
  htmx.trigger('#attachments-'+refId, 'load');
}
</script>
<script>
function attachmentToken(){
  return document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1] || localStorage.getItem('pdh_token') || '';
}
function escapeAttr(value){
  return String(value || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function attachmentCard(a, refType, refId){
  const name = escapeAttr(a.filename || 'Datei');
  const url = escapeAttr(a.url || ('/uploads/' + (a.filepath || '')));
  const isImage = !!a.is_image;
  const recordBadge = a.record_image ? '<span class="attachment-badge">Datensatzbild</span>' : '';
  // aus dem Internet uebernommene Dokumente: Art, Stand und Quelle
  const docLabel = ({datasheet: 'Datenblatt', manual: 'Benutzerhandbuch'})[a.doc_kind] || '';
  const docBadge = docLabel ? `<span class="attachment-badge doc">${docLabel}</span>` : '';
  const preview = isImage ? `<img src="${url}" alt="${name}">${recordBadge}` : `<i class="ti ${a.doc_kind === 'manual' ? 'ti-book' : 'ti-file-description'}"></i>${docBadge}`;
  const checked = a.source_checked_at ? new Date(a.source_checked_at).toLocaleDateString(PDH_LOCALE) : '';
  const srcLine = a.source_url ? `<div class="attachment-src" title="${escapeAttr(a.source_url)}">Stand ${checked} · <a href="${escapeAttr(a.source_url)}" target="_blank" rel="noopener noreferrer">Quelle</a></div>` : '';
  const refreshButton = a.source_url && refType === 'inventory'
    ? `<button type="button" class="btn" onclick="pdhRefreshDoc('${refId}','${a.id}',this)" title="Beim Anbieter nach einer neueren Fassung schauen"><i class="ti ti-refresh"></i> Aktualisieren</button>`
    : '';
  const imageButton = isImage && !a.record_image
    ? `<button type="button" class="btn" onclick="setRecordImage('${refType}','${refId}','${a.id}')"><i class="ti ti-photo-check"></i> Aktivieren</button>`
    : '';
  return `<div class="attachment-card">
    <a class="attachment-preview" href="${url}" target="_blank" rel="noopener">${preview}</a>
    <div class="attachment-meta">
      <div class="attachment-name" title="${name}">${name}</div>
      ${srcLine}
      <div class="attachment-actions">
        ${imageButton}${refreshButton}
        <button type="button" class="btn btn-danger" onclick="deleteAttachment('${a.id}','${refType}','${refId}')"><i class="ti ti-trash"></i> Entfernen</button>
      </div>
    </div>
  </div>`;
}
async function loadAttachmentGallery(refType, refId) {
  const container = document.getElementById('attachments-'+refId);
  if(!container) return;
  container.classList.add('attachment-gallery');
  container.style.display = 'grid';
  container.style.flexWrap = '';
  container.style.gap = '10px';
  container.innerHTML = '<div style="font-size:12px;color:var(--muted)">Lade Galerie...</div>';
  try {
    const res = await fetch('/api/v1/attachments/'+refType+'/'+refId, {headers:{Authorization:'Bearer '+attachmentToken()}});
    const json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Galerie konnte nicht geladen werden');
    const files = json.data || [];
    container.innerHTML = files.length ? files.map(a => attachmentCard(a, refType, refId)).join('') : '<div style="font-size:12px;color:var(--muted)">Keine Bilder oder Dokumente vorhanden</div>';
  } catch(err) {
    container.innerHTML = '<div style="font-size:12px;color:var(--red)">Fehler: '+escapeAttr(err.message || err)+'</div>';
  }
}
async function uploadFiles(input, refType, refId) {
  if(!input.files.length) return;
  const fd = new FormData();
  for(const f of input.files) fd.append('files', f);
  try {
    const res = await fetch('/api/v1/attachments/'+refType+'/'+refId, {
      method:'POST',
      headers:{Authorization:'Bearer '+attachmentToken()},
      body:fd
    });
    const json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Upload fehlgeschlagen');
    input.value = '';
    await loadAttachmentGallery(refType, refId);
  } catch(err) {
    showGlobalError('Upload fehlgeschlagen', err.message || String(err));
  }
}
async function deleteAttachment(id, refType, refId) {
  try {
    const res = await fetch('/api/v1/attachments/'+id, {method:'DELETE',headers:{Authorization:'Bearer '+attachmentToken()}});
    const json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Loeschen fehlgeschlagen');
    await loadAttachmentGallery(refType, refId);
  } catch(err) {
    showGlobalError('Anhang konnte nicht entfernt werden', err.message || String(err));
  }
}
async function setRecordImage(refType, refId, id) {
  try {
    const res = await fetch('/api/v1/attachments/'+refType+'/'+refId+'/'+id+'/record-image', {method:'POST',headers:{Authorization:'Bearer '+attachmentToken()}});
    const json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Datensatzbild konnte nicht gesetzt werden');
    await loadAttachmentGallery(refType, refId);
    setGlobalStatus('ok', 'Datensatzbild gesetzt', 100, 'Keine Fehler');
  } catch(err) {
    showGlobalError('Datensatzbild fehlgeschlagen', err.message || String(err));
  }
}
// Seitenleisten in der Breite ziehen: Griff am Innenrand, Breite bleibt im
// Browser gespeichert; Doppelklick = Standard, Pfeiltasten = 16 px.
(function(){
  const root = document.documentElement, app = document.querySelector('.app');
  if(!app) return;
  const LIM = {left: [160, 480, 200], right: [220, 760, 260]}; // min, max, Standard
  const MAIN_MIN = 420; // Inhalt in der Mitte bleibt bedienbar
  function cur(side){ return parseInt(getComputedStyle(root).getPropertyValue('--' + side + '-open-w'), 10) || LIM[side][2]; }
  function set(side, w, save){
    const other = side === 'left' ? 'right' : 'left';
    const otherW = root.classList.contains('sidebar-' + other + '-collapsed') ? 54 : (parseInt(getComputedStyle(root).getPropertyValue('--' + other + '-sidebar-w'), 10) || 0);
    const max = Math.min(LIM[side][1], app.clientWidth - otherW - MAIN_MIN);
    w = Math.round(Math.max(LIM[side][0], Math.min(max, w)));
    root.style.setProperty('--' + side + '-open-w', w + 'px');
    if(save){ try{ localStorage.setItem('pdh_sidebar_' + side + '_w', String(w)); }catch(e){} window.dispatchEvent(new Event('resize')); }
    return w;
  }
  document.querySelectorAll('.pdh-resizer').forEach(el => {
    const side = el.classList.contains('left') ? 'left' : 'right';
    el.addEventListener('pointerdown', e => {
      if(e.button !== 0) return;
      e.preventDefault();
      el.setPointerCapture(e.pointerId);
      el.classList.add('on'); root.classList.add('pdh-resizing');
      const r = app.getBoundingClientRect();
      const move = ev => set(side, side === 'left' ? ev.clientX - r.left : r.right - ev.clientX, false);
      const up = () => {
        el.removeEventListener('pointermove', move); el.removeEventListener('pointerup', up); el.removeEventListener('pointercancel', up);
        el.classList.remove('on'); root.classList.remove('pdh-resizing');
        set(side, cur(side), true);
      };
      el.addEventListener('pointermove', move); el.addEventListener('pointerup', up); el.addEventListener('pointercancel', up);
    });
    el.addEventListener('dblclick', () => {
      root.style.removeProperty('--' + side + '-open-w');
      try{ localStorage.removeItem('pdh_sidebar_' + side + '_w'); }catch(e){}
      window.dispatchEvent(new Event('resize'));
    });
    el.addEventListener('keydown', e => {
      if(e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const grow = (e.key === 'ArrowRight') === (side === 'left');
      set(side, cur(side) + (grow ? 16 : -16), true);
    });
  });
})();
// Dokument (oder 'all') erneut von der Quelle laden – ersetzt nur bei neuer Fassung
async function pdhRefreshDoc(partId, attId, btn) {
  if(btn) btn.disabled = true;
  setGlobalStatus('busy', 'Prüfe auf neue Fassung…', 40, '');
  try {
    const res = await fetch('/inventory/' + partId + '/documents/' + attId + '/refresh', {method: 'POST', credentials: 'same-origin'});
    const json = await res.json().catch(() => ({}));
    if(!res.ok || !json.success) throw new Error(json.error || ('HTTP ' + res.status));
    await loadAttachmentGallery('inventory', partId);
    setGlobalStatus(json.failed ? 'error' : 'ok', json.message, 100, json.failed ? 'Teilweise fehlgeschlagen' : 'Keine Fehler');
  } catch(err) {
    showGlobalError('Aktualisieren fehlgeschlagen', err.message || String(err));
  }
  if(btn) btn.disabled = false;
}
function initAttachmentGalleries(){
  document.querySelectorAll('[data-attach-ref]').forEach(el => {
    const [refType, refId] = String(el.dataset.attachRef || '').split(':');
    if(refType && refId) loadAttachmentGallery(refType, refId);
  });
}
if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAttachmentGalleries);
else initAttachmentGalleries();
// Druckkopf: Datum beim Drucken eintragen
window.addEventListener("beforeprint", function(){ document.querySelectorAll("[data-print-date]").forEach(function(el){ el.textContent = new Date().toLocaleString(PDH_LOCALE); }); });
</script>
<style>
.pdh-sg{position:fixed;z-index:7000;background:var(--bg2);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.3);font-size:12.5px;max-width:min(560px,calc(100vw - 16px));overflow:hidden}
.pdh-sg div{padding:6px 10px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pdh-sg div.on{background:var(--bg3)}
.pdh-sg .g{color:var(--muted)}
.pdh-sg .hint{font-size:10.5px;color:var(--muted);padding:4px 10px;border-top:1px solid var(--border);cursor:default}
</style>
<script>
// Lernende Autovervollstaendigung fuer Felder mit data-suggest="<art>" (suggest.go):
// Vorschlaege fuer die aktuelle Zeile; Tab/Klick uebernimmt, Pfeile waehlen, Esc schliesst.
(function(){
  let box = null, field = null, list = [], sel = 0, timer = null, seq = 0;
  function close(){ if(box){ box.remove(); box = null; } list = []; }
  function lineInfo(el){
    const pos = el.selectionStart ?? el.value.length, v = el.value;
    const start = el.tagName === 'TEXTAREA' ? v.lastIndexOf('\n', pos - 1) + 1 : 0;
    return {start, pos, line: v.slice(start, pos)};
  }
  function apply(i){
    const it = list[i]; if(!it || !field) return;
    const {start, pos, line} = lineInfo(field);
    const v = field.value;
    // Einrueckung/Aufzaehlungszeichen der Zeile behalten
    const lead = (line.match(/^[\s\-•*·]*/) || [''])[0];
    const repl = it.ghost ? line + it.ghost : lead + it.text;
    field.value = v.slice(0, start) + repl + v.slice(pos);
    const caret = start + repl.length;
    field.setSelectionRange(caret, caret);
    field.dispatchEvent(new Event('input', {bubbles: true}));
    const learned = it.ghost ? (line + it.ghost).replace(/^[\s\-•*·]+/, '') : it.text;
    fetch('/suggest/accept', {method: 'POST', credentials: 'same-origin', body: new URLSearchParams({k: field.dataset.suggest, text: learned})}).catch(()=>{});
    close();
  }
  function render(){
    if(!list.length){ close(); return; }
    if(!box){ box = document.createElement('div'); box.className = 'pdh-sg'; box.setAttribute('role', 'listbox'); document.body.appendChild(box); }
    const r = field.getBoundingClientRect();
    box.style.left = Math.max(8, Math.min(r.left, innerWidth - 300)) + 'px';
    box.style.minWidth = Math.min(r.width, 420) + 'px';
    const below = innerHeight - r.bottom > 180;
    box.style.top = below ? (r.bottom + 2) + 'px' : 'auto';
    box.style.bottom = below ? 'auto' : (innerHeight - r.top + 2) + 'px';
    box.innerHTML = list.map((it, i) => '<div role="option" data-i="' + i + '" class="' + (i === sel ? 'on' : '') + '">' +
      (it.ghost ? escapeHtml(it.line) + '<span class="g">' + escapeHtml(it.ghost) + '</span>' : escapeHtml(it.text)) + '</div>').join('') +
      '<div class="hint">Tab übernehmen · ↑↓ wählen · Esc schließen</div>';
  }
  async function query(el){
    const {line} = lineInfo(el);
    if(line.trim().length < 2){ close(); return; }
    const my = ++seq;
    try{
      const res = await fetch('/suggest?k=' + encodeURIComponent(el.dataset.suggest) + '&q=' + encodeURIComponent(line), {credentials: 'same-origin'});
      const j = await res.json();
      if(my !== seq || document.activeElement !== el) return;
      field = el; sel = 0; list = [];
      if(j.ghost) list.push({ghost: j.ghost, line});
      (j.items || []).forEach(t => { if(!(j.ghost && t === line + j.ghost)) list.push({text: t}); });
      render();
    }catch(e){ close(); }
  }
  document.addEventListener('input', e => {
    const el = e.target;
    if(!el.matches || !el.matches('[data-suggest]') || el === field && e.isTrusted === false) return;
    clearTimeout(timer); timer = setTimeout(() => query(el), 140);
  });
  document.addEventListener('keydown', e => {
    if(!box || e.target !== field) return;
    if(e.key === 'Tab' && !e.shiftKey){ e.preventDefault(); apply(sel); }
    else if(e.key === 'ArrowDown'){ e.preventDefault(); sel = (sel + 1) % list.length; render(); }
    else if(e.key === 'ArrowUp'){ e.preventDefault(); sel = (sel - 1 + list.length) % list.length; render(); }
    else if(e.key === 'Enter' && sel > 0){ e.preventDefault(); apply(sel); }
    else if(e.key === 'Escape'){ close(); }
  }, true);
  document.addEventListener('mousedown', e => {
    const d = e.target.closest && e.target.closest('.pdh-sg [data-i]');
    if(d){ e.preventDefault(); apply(+d.dataset.i); }
    else if(box && !e.target.closest('.pdh-sg')) close();
  });
  document.addEventListener('focusout', e => { if(e.target === field) setTimeout(close, 150); });
  window.addEventListener('scroll', () => { if(box) render(); }, true);
})();
</script>
