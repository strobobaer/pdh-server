{{/* Explorer einer Verbindung (Reiter „Explorer“): conn-explorer (Fläche), conn-explorer-js (Hilfsfunktionen).
     Protokolle: explorer-mqtt, explorer-opcua, explorer-modbus (eigene Widgets). */}}
{{define "conn-explorer"}}
<style>
.ex-bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--muted);margin-bottom:12px}
.ex-bar span{display:inline-flex;gap:5px;align-items:center;padding:3px 9px;border:1px solid var(--border);border-radius:999px;background:var(--bg2)}
.ex-bar .ex-warn{color:var(--amber)}
.ex-bar .ex-mirror{color:var(--red)}
.ex-log{margin-top:14px}
.ex-log table{width:100%;border-collapse:collapse;font-size:12.5px}
.ex-log th,.ex-log td{text-align:left;padding:5px 8px;border-bottom:1px solid var(--border)}
.ex-log th{color:var(--muted);font-weight:500}
.ex-msg{font-size:12.5px;margin-top:8px}
.ex-msg.ex-err{color:var(--red)}
.ex-msg.ex-ok{color:var(--green)}
.ex-box{border:1px solid var(--border);border-radius:var(--radius,8px);background:var(--bg2);padding:12px}
</style>
<div class="card" id="ex-root" data-direction="{{.Direction}}" data-conn="{{.ID}}"{{if .ExplorerWrite}} data-explorer-write{{end}}>
  <div class="card-title"><span><i class="ti ti-telescope"></i> Explorer</span></div>
  <div class="ex-bar" role="note">
    <span><i class="ti ti-clock"></i> Sitzung höchstens 15 Minuten</span>
    {{if .ExplorerMirror}}<span class="ex-mirror"><i class="ti ti-lock"></i> Spiegel – nur lesen</span>
    {{else if not .ExplorerWrite}}<span class="ex-warn"><i class="ti ti-eye"></i> Nur lesen – zum Testschreiben brauchst du das Recht ‚{{if eq .Direction "import"}}Import{{else}}Export{{end}} verwalten‘</span>{{end}}
  </div>
  {{if eq .Kind "mqtt"}}{{template "explorer-mqtt" .}}
  {{else if eq .Kind "opcua"}}{{template "explorer-opcua" .}}
  {{else if eq .Kind "modbus"}}{{template "explorer-modbus" .}}{{end}}
  {{if .ExplorerWrite}}
  {{if eq .Direction "export"}}
  <div class="ex-box" id="ex-target-panel" hidden style="margin-top:14px" data-explorer-write>
    <div class="rec-sub" style="margin-bottom:8px"><i class="ti ti-target-arrow"></i> Als Zielfeld übernehmen</div>
    {{if .ExportSources}}
    <div class="form-group"><label class="form-label" for="ex-target-source">Importierter Wert, der hierher geschrieben wird</label>
      <select id="ex-target-source" class="form-input">
        {{range .ExportSources}}<option value="{{.ID}}">{{.Name}}{{if .InfrastructureName}} – {{.InfrastructureName}}{{end}}</option>{{end}}
      </select></div>
    <div class="form-group"><label class="form-label" for="ex-target-field">Zielfeld</label>
      <input id="ex-target-field" class="form-input" readonly></div>
    <div class="form-group"><label class="form-label" for="ex-target-note">Notiz <span style="color:var(--muted);font-weight:400">(optional)</span></label>
      <input id="ex-target-note" class="form-input" maxlength="500"></div>
    <div style="display:flex;gap:8px">
      <button type="button" class="btn" id="ex-target-cancel">Abbrechen</button>
      <button type="button" class="btn btn-primary" id="ex-target-save"><i class="ti ti-check"></i> Zielfeld anlegen</button>
    </div>
    {{else}}
    <div class="rec-sub">Es gibt noch keine importierten Werte. Lege zuerst unter Import eine Zuordnung an – sie kann dann als Quelle für dieses Zielfeld dienen.</div>
    <div style="margin-top:8px"><button type="button" class="btn" id="ex-target-cancel">Schließen</button></div>
    {{end}}
    <p id="ex-target-msg" role="alert" class="ex-msg" style="margin:8px 0 0"></p>
  </div>
  {{end}}
  <div class="ex-log" data-explorer-write>
    <div class="rec-sub" style="margin-bottom:6px"><i class="ti ti-history"></i> Zuletzt testweise geschrieben</div>
    {{if .ExplorerLog}}
    <table>
      <thead><tr><th>Wann</th><th>Wer</th><th>Ziel</th><th>Wert</th></tr></thead>
      <tbody>{{range .ExplorerLog}}<tr><td style="white-space:nowrap">{{.CreatedAt}}</td><td>{{.UserName}}</td><td class="mono">{{.FieldName}}</td><td class="mono">{{.NewValue}}</td></tr>{{end}}</tbody>
    </table>
    {{else}}<div class="rec-sub">Noch nichts geschrieben.</div>{{end}}
  </div>
  {{end}}
</div>
{{end}}

{{define "conn-explorer-js"}}
<script>
window.pdhExplorer = (function(){
  // stream(url, handlers): Server-Ereignisse (EventSource); handlers = {Ereignisname: fn(daten)}.
  // „error“ und „end“ schließen die Sitzung. Rückgabe: {close()}.
  function stream(url, handlers){
    handlers = handlers || {};
    const es = new EventSource(url, {withCredentials: true});
    let closed = false;
    function close(){ closed = true; es.close(); }
    function parse(e){ try{ return JSON.parse(e.data); }catch(_){ return {}; } }
    Object.keys(handlers).forEach(function(name){
      if(name === 'error' || name === 'end' || name === 'disconnect') return;
      es.addEventListener(name, function(e){ handlers[name](parse(e)); });
    });
    // „error“ mit Daten kommt vom Server (Meldung), ohne Daten ist die Verbindung abgebrochen.
    es.addEventListener('error', function(e){
      if(e.data){ if(handlers.error) handlers.error(parse(e)); }
      else if(!closed && handlers.disconnect) handlers.disconnect();
      close();
    });
    es.addEventListener('end', function(e){ if(handlers.end) handlers.end(parse(e)); close(); });
    return {close: close};
  }
  // post(url, data, frage): zeigt die Rückfrage, hängt confirm=1 an und liefert die Antwort als JSON.
  // Bei Abbruch der Rückfrage: null. Bei Fehler wird eine Error mit der Meldung des Servers geworfen.
  async function post(url, data, frage){
    if(frage && !window.confirm(frage)) return null;
    const body = new URLSearchParams();
    Object.keys(data || {}).forEach(function(k){ if(data[k] != null) body.append(k, data[k]); });
    body.set('confirm', '1');
    const res = await fetch(url, {method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: body.toString()});
    const j = await res.json().catch(function(){ return {}; });
    if(!res.ok) throw new Error(j.error || ('HTTP ' + res.status));
    return j;
  }
  // ── Als Zuordnung übernehmen ──
  // Import: öffnet den Zuordnungs-Dialog der Seite (importMarkOpen) mit dem Quellwert.
  // Export: öffnet das Panel „Als Zielfeld übernehmen“ (Quelle wählen, Zielfeld = Quellwert).
  function root(){ return document.getElementById('ex-root'); }
  // canMap: nur mit Schreibrecht gibt es Knöpfe zum Übernehmen (Merkmal am Explorer-Rahmen).
  function canMap(){ const r = root(); return !!r && r.dataset.explorerWrite !== undefined; }
  function mapLabel(){ const r = root(); return r && r.dataset.direction === 'export' ? 'Als Zielfeld übernehmen' : 'Als Zuordnung übernehmen'; }
  // mapButton(ref, vorschlag, klein): Knopf für einen Quellwert; null ohne Schreibrecht.
  function mapButton(ref, suggestion, compact){
    if(!canMap()) return null;
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'btn btn-small ex-map';
    const i = document.createElement('i'); i.className = 'ti ti-map-pin'; b.appendChild(i);
    if(!compact) b.appendChild(document.createTextNode(' ' + mapLabel()));
    b.title = mapLabel() + ': ' + ref; b.setAttribute('aria-label', mapLabel() + ': ' + ref);
    b.addEventListener('click', function(e){ e.stopPropagation(); map(ref, suggestion); });
    return b;
  }
  function map(ref, suggestion){
    if(!canMap()) return;
    if(root().dataset.direction === 'export'){ openTarget(ref); return; }
    if(typeof importMarkOpen !== 'function') return;
    importMarkOpen(ref);
    const n = document.getElementById('mark-name');
    if(n && suggestion) n.value = suggestion;
  }
  function openTarget(ref){
    const p = document.getElementById('ex-target-panel');
    if(!p) return;
    const f = document.getElementById('ex-target-field'); if(f) f.value = ref;
    const n = document.getElementById('ex-target-note'); if(n) n.value = '';
    const m = document.getElementById('ex-target-msg'); m.className = 'ex-msg'; m.textContent = '';
    p.hidden = false;
    p.scrollIntoView({behavior: 'smooth', block: 'nearest'});
  }
  document.addEventListener('DOMContentLoaded', function(){
    const p = document.getElementById('ex-target-panel');
    if(!p) return;
    const m = document.getElementById('ex-target-msg');
    document.getElementById('ex-target-cancel').addEventListener('click', function(){ p.hidden = true; });
    const save = document.getElementById('ex-target-save');
    if(!save) return;
    save.addEventListener('click', async function(){
      m.className = 'ex-msg'; m.textContent = '';
      const payload = {import_mapping_id: document.getElementById('ex-target-source').value,
        field_name: document.getElementById('ex-target-field').value, note: document.getElementById('ex-target-note').value.trim()};
      save.disabled = true;
      try{
        const res = await fetch('/export/connections/' + encodeURIComponent(root().dataset.conn) + '/mappings', {
          method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)});
        const j = await res.json().catch(function(){ return {}; });
        if(!res.ok) throw new Error(j.error || ('HTTP ' + res.status));
        m.className = 'ex-msg ex-ok'; m.textContent = 'Zielfeld angelegt';
        document.dispatchEvent(new CustomEvent('pdh:mapping-created', {detail: {field_name: payload.field_name, id: j.id}}));
        setTimeout(function(){ p.hidden = true; }, 1500);
      }catch(e){ m.className = 'ex-msg ex-err'; m.textContent = e.message; }
      save.disabled = false;
    });
  });
  return {stream: stream, post: post, map: map, mapButton: mapButton, canMap: canMap};
})();
</script>
{{end}}
