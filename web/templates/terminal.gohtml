<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>{{if .NoInfra}}Terminal{{else}}{{.Name}} – Terminal{{end}}</title>
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css?v={{appVersion}}">
<style>
/* Anlagenterminal (terminal_page.go): Vollbild für den Wandmonitor, nur Berührung.
   Trefferflächen mindestens 64 px, keine Hover-Bedienung, wenig Text. */
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0f1117;--bg2:#1a1d27;--bg3:#222536;--accent:#4f6ef7;--text:#f1f3fb;--muted:#9aa3b8;--border:#2f3348;--red:#ef4444;--amber:#f59e0b;--green:#10b981;--font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);font-size:clamp(18px,1.6vw,28px);line-height:1.3;overflow:hidden;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;cursor:default}
body{display:flex;flex-direction:column;padding:max(2vh,12px) max(2vw,16px)}
[hidden]{display:none !important}
a{color:inherit;text-decoration:none}
.t-head{display:flex;align-items:center;gap:1.2vw;min-height:64px;padding-bottom:1.4vh}
.t-path{flex:1;min-width:0;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.t-path b{color:var(--text);font-weight:700}
.t-clock{color:var(--muted);font-variant-numeric:tabular-nums}
.t-btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-width:64px;min-height:64px;padding:0 1.6em;border-radius:18px;border:2px solid var(--border);background:var(--bg3);color:var(--text);font:inherit;font-weight:700}
.t-btn:active{filter:brightness(1.25)}
.t-btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.t-btn.big{min-height:clamp(88px,12vh,140px);font-size:1.25em;border-radius:22px;width:100%}
/* Schoner */
.t-saver{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3vh;text-align:center;padding:4vh 4vw;background:var(--bg)}
.t-saver .name{font-size:clamp(40px,7vw,120px);font-weight:800;line-height:1.1;max-width:92vw;overflow-wrap:anywhere}
.t-saver .time{font-size:clamp(32px,5vw,84px);color:var(--muted);font-variant-numeric:tabular-nums}
.t-saver .hint{font-size:clamp(20px,2.2vw,36px);color:var(--accent);font-weight:700;padding:1.2vh 2.4vw;border:2px solid var(--accent);border-radius:999px}
/* Störungsinfo */
.t-cols{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:1.6vw}
.t-tile{display:flex;flex-direction:column;min-height:0;background:var(--bg2);border:2px solid var(--border);border-radius:22px;padding:1.4vh 1.4vw}
.t-tile h2{display:flex;align-items:center;gap:.5em;font-size:1.25em;padding-bottom:1vh;border-bottom:2px solid var(--border)}
.t-tile h2 .n{margin-left:auto;min-width:2.2em;text-align:center;padding:.05em .5em;border-radius:999px;background:var(--bg3);font-variant-numeric:tabular-nums}
.t-tile.faults h2 .n.has{background:var(--red);color:#fff}
.t-tile.tickets h2 .n.has{background:var(--amber);color:#1b1500}
.t-list{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;list-style:none}
.t-list li{display:grid;grid-template-columns:1fr auto;column-gap:1em;padding:1.1vh 0;border-bottom:1px solid var(--border)}
.t-list .ti-title{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-meta{grid-column:1/-1;color:var(--muted);font-size:.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-st{color:var(--muted);font-size:.85em;white-space:nowrap}
.t-empty{display:flex;align-items:center;justify-content:center;gap:.5em;flex:1;color:var(--green);font-weight:700;font-size:1.1em}
.t-more{color:var(--muted);text-align:center;padding:1vh 0;font-size:.85em}
/* Sensoren nach Kartenanmeldung (terminal_sensors.go, terminal.js) */
.t-sensors{margin-top:1.6vh;background:var(--bg2);border:2px solid var(--border);border-radius:22px;padding:1.4vh 1.4vw;max-height:38vh;overflow-y:auto}
.t-sensors h2{display:flex;align-items:center;gap:.5em;font-size:1.15em;padding-bottom:.8vh;border-bottom:2px solid var(--border)}
.t-sens-body{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,22em),1fr));gap:1vh 1.4vw;margin-top:1vh}
.t-sens{border:1px solid var(--border);border-radius:14px;padding:.8vh .9vw;min-width:0}
.t-sens-head{display:flex;flex-wrap:wrap;align-items:center;gap:.4em .8em;font-weight:700;overflow-wrap:anywhere}
.t-sens-g{color:var(--muted);font-size:.75em;font-weight:700;text-transform:uppercase;margin-top:.6vh}
.t-sens-row{display:flex;justify-content:space-between;gap:1em;padding:.3vh 0;border-top:1px solid var(--border)}
.t-sens-row .v{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}.t-sens-row.stale{color:var(--muted)}.t-sens-row.stale .v{font-weight:400}
.hs{display:inline-flex;align-items:center;gap:.35em;flex-wrap:wrap;font-size:.85em;font-weight:600;padding:.1em .6em;border-radius:999px;border:1px solid var(--border)}
.hs-run .hs-state{color:var(--green)}.hs-stop .hs-state{color:var(--red)}.hs-none .hs-state{color:var(--muted)}.hs-count{font-variant-numeric:tabular-nums;font-weight:800}
.hs.hs-pulse{animation:t-hs-pulse .6s ease-out}@keyframes t-hs-pulse{40%{transform:scale(1.08)}}
@media (prefers-reduced-motion:reduce){.hs.hs-pulse{animation:none}}
.t-foot{padding-top:1.6vh;display:flex;gap:1.6vw}
/* Neu */
.t-new{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) auto;gap:1.6vw}
.t-tilebtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2vh;border-radius:26px;border:2px solid var(--border);font-weight:800;font-size:1.7em;padding:3vh 2vw;min-height:64px;text-align:center}
.t-tilebtn i{font-size:2.2em}
.t-tilebtn.fault{background:#7f1d1d;border-color:var(--red)}
.t-tilebtn.ticket{background:#78350f;border-color:var(--amber)}
.t-tilebtn:active{filter:brightness(1.25)}
.t-tilebtn.off{opacity:.35;filter:grayscale(1)}
.t-tilebtn.off:active{filter:grayscale(1)}
.t-note{grid-column:1/-1;color:var(--muted);text-align:center;font-weight:700}
.t-empty.off{color:var(--muted)}
.t-stop{grid-column:1/-1;background:var(--bg2);border:2px dashed var(--border);border-radius:22px;padding:2vh 2vw}
.t-stop h2{font-size:1.1em;display:flex;align-items:center;gap:.5em}
.t-stop p{color:var(--muted);margin-top:.5vh}
/* Hinweis ohne Anlage */
.t-none{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2vh;text-align:center}
.t-none i{font-size:4em;color:var(--amber)}
.t-none p{font-size:1.6em;font-weight:700;max-width:30em}
.t-none small{color:var(--muted);font-size:.9em}
/* Kartensitzung: Leiste unten, Hinweis bei unbekannter Karte */
.t-card{flex-shrink:0;margin-top:1.4vh;display:flex;align-items:center;gap:1.6vw;padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--green);border-radius:22px}
.t-card .who{flex:1;min-width:0;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-card .t-btn{min-height:64px}
.t-cardmsg{position:fixed;left:50%;transform:translateX(-50%);bottom:max(2vh,12px);max-width:90vw;padding:1.2vh 2vw;background:var(--bg3);border:2px solid var(--amber);border-radius:22px;font-weight:700;text-align:center;z-index:8}
/* Anmeldung ohne Kartenleser: Ziffernfeld, Knopf, Dialog (Tasten mindestens 64 px) */
.t-login{flex-shrink:0;margin-top:1.4vh;padding:1vh 1.4vw;background:var(--bg2);border:2px solid var(--border);border-radius:22px;display:flex;flex-direction:column;gap:1vh}
.t-login .l-msg{color:var(--amber);font-weight:700;text-align:center}
.t-login .l-row{display:flex;gap:1vw;align-items:center;flex-wrap:wrap;margin-bottom:1vh}
.t-login input,.t-dialog input{min-height:64px;flex:1;min-width:8em;padding:0 .8em;border-radius:14px;border:2px solid var(--border);background:var(--bg);color:var(--text);font:inherit;-webkit-user-select:text;user-select:text}
.t-login input:focus,.t-dialog input:focus{border-color:var(--accent);outline:none}
.t-keypad{display:grid;grid-template-columns:repeat(6,minmax(64px,1fr));gap:.6vh .6vw}
.t-keypad .t-btn{padding:0;min-width:64px;min-height:64px}
.t-dialog{position:fixed;inset:0;z-index:7;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.7)}
.t-dialog form{width:min(90vw,32em);display:flex;flex-direction:column;gap:1.4vh;padding:2vh 2vw;background:var(--bg2);border:2px solid var(--border);border-radius:22px}
.t-dialog .l-row{display:flex;gap:1vw}
.t-dialog .l-row .t-btn{flex:1}
/* Infobildschirm (Modus global): Folienschau, nur Berührung, nichts verlinkt, kein Markieren */
body[data-mode="global"]{padding:0;-webkit-touch-callout:none}
.g-stage{touch-action:none;position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--bg);overflow:hidden}
.g-img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;pointer-events:none;-webkit-user-drag:none}
.g-cap{position:absolute;left:0;right:0;bottom:0;padding:2vh 4vw;background:linear-gradient(transparent,rgba(0,0,0,.75));font-size:clamp(24px,3vw,56px);font-weight:800;text-align:center;pointer-events:none}
.g-text{max-width:90vw;max-height:94vh;overflow:hidden;text-align:center;display:flex;flex-direction:column;gap:3vh}
.g-text h1{font-size:clamp(40px,6vw,110px);line-height:1.1;overflow-wrap:anywhere}
.g-text p{font-size:clamp(26px,3.4vw,64px);line-height:1.3;white-space:pre-wrap;overflow-wrap:anywhere}
.g-vorg{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:grid;grid-template-columns:1fr 1fr;gap:1.6vw}
.g-vorg.one{grid-template-columns:1fr}
.g-vorg .t-tile{min-height:0}
.g-vorg .t-list li{cursor:pointer}
.g-vorg .t-list li:active{background:var(--bg3)}
.g-frame{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff;pointer-events:none}
.g-stats{position:absolute;inset:0;padding:max(2vh,12px) max(2vw,16px);display:flex;flex-direction:column;gap:2vh;min-height:0}
.g-stats h1{font-size:clamp(28px,3.6vw,64px);line-height:1.1;text-align:center;overflow-wrap:anywhere}
.g-nums{display:flex;flex-wrap:wrap;gap:1.4vw;justify-content:center}
.g-num{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:1.2vh 2vw;text-align:center;min-width:12vw}
.g-num b{display:block;font-size:clamp(34px,5vw,90px);line-height:1.1}
.g-num span{font-size:clamp(16px,1.8vw,32px);color:var(--muted)}
.g-chartbox{flex:1;min-height:0;display:flex;flex-direction:column;gap:1vh}
.g-chart{flex:1;min-height:0;width:100%}
.g-grid{stroke:var(--border);stroke-width:1}
.g-axis{fill:var(--muted);font-size:20px}
.g-bar.s0{fill:var(--accent)}
.g-bar.s1{fill:var(--green)}
.g-legend{display:flex;gap:2vw;justify-content:center;font-size:clamp(16px,1.8vw,32px);color:var(--muted)}
.g-legend .k::before{content:"";display:inline-block;width:.9em;height:.9em;border-radius:3px;margin-right:.4em;vertical-align:-.1em;background:var(--accent)}
.g-legend .k.s1::before{background:var(--green)}
.g-empty{font-size:clamp(32px,5vw,90px);font-weight:800;text-align:center}
.g-empty small{display:block;margin-top:2vh;font-size:.4em;color:var(--muted);font-weight:700}
/* Zahnrad zur Terminal-Einstellung (nur Gerätesitzung), oben rechts über allem; Trefferfläche 48 px */
.t-gear{position:fixed;top:max(6px,.8vh);right:max(6px,.8vw);z-index:50;display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:rgba(34,37,54,.6);border:1px solid var(--border);color:var(--muted);font-size:24px;opacity:.7}
.t-gear:active{opacity:1;filter:brightness(1.25)}
body.has-gear .t-head{padding-right:56px}
body.has-gear .g-vorg{padding-top:60px}
/* Rüsten (terminal_setup.go): Kachel auf „Neu“, Seite /terminal/rusten – Raster folgt der Bildschirmgröße */
.t-new .t-rzlink{grid-column:1/-1;flex-direction:row;font-size:1.3em;padding:2.2vh 2vw;background:#064e3b;border-color:var(--green)}
.t-new .t-rzlink i{font-size:1.6em}.t-rzlink small{display:block;font-weight:600;font-size:.6em;color:var(--muted)}
.t-new.has-rz{grid-template-rows:minmax(0,1fr) auto auto}
.t-rz{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:1.6vh;padding-bottom:1vh;-webkit-overflow-scrolling:touch}
.t-rz h3{font-size:.8em;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-top:.6vh}
.t-rznote{padding:1.2vh 1.6vw;background:var(--bg3);border:2px solid var(--amber);border-radius:18px;font-weight:700}
.t-rzrun{padding:1.6vh 2vw;background:var(--bg2);border:2px solid var(--border);border-left:10px solid var(--amber);border-radius:22px;display:flex;align-items:center;gap:2vw;flex-wrap:wrap}
.t-rzrun.fault{border-left-color:var(--red)}.t-rzrun b{flex:1;min-width:12em}.t-rzrun span{color:var(--amber);font-weight:700}
.t-rzrun .t-btn{min-width:10em}
.t-rzgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,13em),1fr));gap:1.4vw}
.t-rzgrid .t-btn,.t-opt span{min-height:clamp(72px,11vh,120px);font-size:1.1em;border-radius:20px;text-align:center;padding:.4em 1em}
.t-rzgrid .t-btn.cur{border-color:var(--amber);background:var(--bg2);opacity:1}
.t-opt{position:relative;display:block}
.t-opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}
.t-opt span{display:flex;align-items:center;justify-content:center;border:2px solid var(--border);background:var(--bg3);font-weight:700}
.t-opt input:checked+span{background:var(--accent);border-color:var(--accent);color:#fff}
.t-rzadd{display:flex;flex-direction:column;gap:1.4vh}
.t-rzh{font-size:1.3em}
.t-text{width:100%;min-height:clamp(90px,14vh,200px);padding:1vh 1.2vw;border-radius:18px;border:2px solid var(--border);background:var(--bg2);color:var(--text);font:inherit;-webkit-user-select:text;user-select:text}
.t-file{color:var(--muted);font:inherit}
@media (max-width:820px){.g-vorg{grid-template-columns:1fr}.t-cols,.t-new{grid-template-columns:1fr}.t-new,.t-new.has-rz{grid-template-rows:auto}}
</style>
</head>
<body{{if .DeviceSession}} class="has-gear"{{end}}{{if .SetupCard}} data-card-in="1"{{end}} data-mode="{{.Mode}}" data-idle="{{.Idle}}"{{if .SettingsEvents}} data-settings-events="1"{{end}}{{if .CardEvents}} data-card-events="1" data-card-notify="{{.CardNotify}}"{{if ne .Mode "schoner"}} data-manual-login="{{.ManualLogin}}" data-password-button="{{if .PasswordButton}}1{{else}}0{{end}}"{{end}}{{end}}>
{{if .DeviceSession}}<a class="t-gear" href="{{.AdminURL}}" aria-label="Terminal-Einstellungen" title="Terminal-Einstellungen"><i class="ti ti-settings" aria-hidden="true"></i></a>{{end}}
{{if .NoInfra}}
<div class="t-none">
  <i class="ti ti-plug-off" aria-hidden="true"></i>
  <p>Diesem Terminal ist keine Anlage zugeordnet</p>
  <small>Bitte in PDH unter „Benutzer“ eine Anlage für dieses Terminal festlegen.</small>
</div>
{{else if eq .Mode "global"}}
<div class="g-stage" id="g-stage" data-name="{{.Name}}" data-frame-csp="{{.FrameCSP}}" aria-live="off"><div class="g-empty">{{.Name}}<small>Folien werden geladen …</small></div></div>
{{else if eq .Mode "schoner"}}
<a class="t-saver" href="/terminal/info" aria-label="Zum Melden berühren">
  <div class="name">{{.Name}}</div>
  <div class="time t-clock" data-clock>&nbsp;</div>
  <div class="hint"><i class="ti ti-hand-finger" aria-hidden="true"></i> Zum Melden berühren</div>
</a>
{{else if eq .Mode "info"}}
<div class="t-head">
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .NoPerm}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier keine Störungen und Tickets anzeigen.</small></div>
{{else}}
<div class="t-cols">
  {{if .CanFaults}}<section class="t-tile faults" aria-labelledby="h-faults">
    <h2 id="h-faults"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Offene Störungen <span class="n{{if .Info.FaultsTotal}} has{{end}}" data-count="faults">{{.Info.FaultsTotal}}</span></h2>
    {{if .Info.Faults}}<ul class="t-list" data-list="faults">
      {{range .Info.Faults}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="faults" hidden></ul><div class="t-empty" data-empty="faults"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Störungen</div>{{end}}
    <div class="t-more" data-more="faults"{{if not .FaultsMore}} hidden{{end}}>{{if .FaultsMore}}… und {{.FaultsMore}} weitere{{end}}</div>
  </section>{{else}}<section class="t-tile faults" aria-labelledby="h-faults"><h2 id="h-faults"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Offene Störungen</h2><div class="t-empty off"><i class="ti ti-lock" aria-hidden="true"></i> Keine Berechtigung für Störungen</div></section>{{end}}
  {{if .CanTickets}}<section class="t-tile tickets" aria-labelledby="h-tickets">
    <h2 id="h-tickets"><i class="ti ti-ticket" aria-hidden="true"></i> Offene Tickets <span class="n{{if .Info.TicketsTotal}} has{{end}}" data-count="tickets">{{.Info.TicketsTotal}}</span></h2>
    {{if .Info.Tickets}}<ul class="t-list" data-list="tickets">
      {{range .Info.Tickets}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="tickets" hidden></ul><div class="t-empty" data-empty="tickets"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Tickets</div>{{end}}
    <div class="t-more" data-more="tickets"{{if not .TicketsMore}} hidden{{end}}>{{if .TicketsMore}}… und {{.TicketsMore}} weitere{{end}}</div>
  </section>{{else}}<section class="t-tile tickets" aria-labelledby="h-tickets"><h2 id="h-tickets"><i class="ti ti-ticket" aria-hidden="true"></i> Offene Tickets</h2><div class="t-empty off"><i class="ti ti-lock" aria-hidden="true"></i> Keine Berechtigung für Tickets</div></section>{{end}}
</div>
{{end}}
<section class="t-sensors" data-sensors hidden aria-labelledby="h-sensors">
  <h2 id="h-sensors"><i class="ti ti-cpu" aria-hidden="true"></i> Sensoren</h2>
  <div class="t-sens-body" data-sensors-body></div>
</section>
<div class="t-foot">
  <a class="t-btn primary big" href="/terminal/neu"><i class="ti ti-plus" aria-hidden="true"></i> Neu</a>
</div>
{{else if eq .Mode "melden"}}
<div class="t-head">
  <a class="t-btn" href="/terminal/neu"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .Report.LoggedIn}} · {{.Report.Person}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .Report.LoggedIn}}
<div class="t-none"><i class="ti ti-id-badge-2" aria-hidden="true"></i><p>Bitte zuerst anmelden</p><small>Zum Melden per Karte oder mit Benutzer und Passwort am Terminal anmelden.</small></div>
{{else if not .Report.Can}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier nichts melden.</small></div>
{{else}}
<form class="t-rz t-rzadd" method="post" action="/terminal/{{if eq .Report.Type "fault"}}stoerung{{else}}ticket{{end}}" enctype="multipart/form-data">
  <h2 class="t-rzh">{{.Report.Title}}</h2>
  {{if .Report.Notice}}<div class="t-rznote" role="alert">{{.Report.Notice}}</div>{{end}}
  {{if gt (len .Report.Plants) 1}}<h3>Anlage</h3>
  <div class="t-rzgrid">{{range $i, $p := .Report.Plants}}<label class="t-opt"><input type="radio" name="infra" value="{{$p.Value}}"{{if eq $i 0}} checked{{end}}><span>{{$p.Label}}</span></label>{{end}}</div>{{end}}
  {{if .Report.Texts}}<h3>Was ist los?</h3>
  <div class="t-rzgrid">{{range .Report.Texts}}<label class="t-opt"><input type="radio" name="text_id" value="{{.ID}}"><span>{{.Label}}</span></label>{{end}}</div>{{end}}
  <h3>{{if .Report.Texts}}Ergänzung (freiwillig){{else}}Beschreibung{{end}}</h3>
  <textarea class="t-text" name="text" maxlength="2000" rows="3" aria-label="Beschreibung"></textarea>
  <h3>Art</h3>
  <div class="t-rzgrid"><label class="t-opt"><input type="radio" name="kind" value="electrical" required><span><i class="ti ti-bolt" aria-hidden="true"></i>&nbsp;elektrisch</span></label><label class="t-opt"><input type="radio" name="kind" value="mechanical" required><span><i class="ti ti-settings" aria-hidden="true"></i>&nbsp;mechanisch</span></label></div>
  <h3>Zustand der Anlage</h3>
  <div class="t-rzgrid"><label class="t-opt"><input type="radio" name="state" value="running" required><span><i class="ti ti-player-play" aria-hidden="true"></i>&nbsp;Anlage läuft</span></label><label class="t-opt"><input type="radio" name="state" value="stopped" required><span><i class="ti ti-player-pause" aria-hidden="true"></i>&nbsp;Anlage steht</span></label></div>
  <h3>Foto (freiwillig)</h3>
  <input class="t-file" type="file" name="files" accept="image/*" capture="environment" multiple aria-label="Foto">
  <button type="submit" class="t-btn primary big"><i class="ti ti-send" aria-hidden="true"></i> Melden</button>
</form>
{{end}}
{{else if eq .Mode "rusten"}}
<div class="t-head">
  <a class="t-btn" href="{{if .SetupAdd}}/terminal/rusten{{else}}/terminal/neu{{end}}"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}{{if .SetupCard}} · {{.SetupPerson}}{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if not .SetupCard}}
<div class="t-none"><i class="ti ti-id-badge-2" aria-hidden="true"></i><p>Bitte zuerst anmelden</p><small>Zum Rüsten per Karte oder mit Benutzer und Passwort am Terminal anmelden.</small></div>
{{else if not .SetupCan}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>{{if .SetupPerson}}{{.SetupPerson}} darf an dieser Anlage nicht rüsten.{{else}}Dieses Terminal darf hier nicht rüsten.{{end}}</small></div>
{{else}}
<div class="t-rz">
  {{if .Setup.Notice}}<div class="t-rznote" role="alert">{{.Setup.Notice}}</div>{{end}}
  {{if .SetupAdd}}
  <form class="t-rzadd" method="post" action="/terminal/rusten/add">
    <h3>Rüsttaste</h3>
    <div class="t-rzgrid">{{range .Setup.Buttons}}<label class="t-opt"><input type="radio" name="button_id" value="{{.ID}}" required><span>{{.Name}}</span></label>{{end}}</div>
    <h3>Beginn</h3>
    <div class="t-rzgrid">{{range .SetupAgo}}<label class="t-opt"><input type="radio" name="ago" value="{{.Value}}" required><span>{{.Label}}</span></label>{{end}}</div>
    <h3>Dauer</h3>
    <div class="t-rzgrid">{{range .SetupDur}}<label class="t-opt"><input type="radio" name="dur" value="{{.Value}}" required><span>{{.Label}}</span></label>{{end}}</div>
    <button type="submit" class="t-btn primary big"><i class="ti ti-check" aria-hidden="true"></i> Nachtragen</button>
  </form>
  {{else}}
  {{if .Setup.Running}}<div class="t-rzrun"><b>{{.Setup.Text}}</b>{{if .Setup.Overrun}}<span><i class="ti ti-alert-triangle" aria-hidden="true"></i> Höchstdauer überschritten</span>{{end}}
    <form method="post" action="/terminal/rusten/finish"><button type="submit" class="t-btn primary big"><i class="ti ti-check" aria-hidden="true"></i> Fertig</button></form></div>
  {{else if .Setup.Fault}}<div class="t-rzrun fault"><b><i class="ti ti-alert-triangle" aria-hidden="true"></i> {{.Setup.Text}}</b></div>{{end}}
  {{if .Setup.Buttons}}
  <form class="t-rzgrid" method="post" action="/terminal/rusten/start">
    {{range .Setup.Buttons}}<button type="submit" class="t-btn{{if .Current}} cur{{end}}" name="button_id" value="{{.ID}}"{{if .Current}} aria-current="true" disabled{{end}}>{{.Name}}</button>{{end}}
  </form>
  <a class="t-btn" href="/terminal/rusten?nachtragen=1"><i class="ti ti-plus" aria-hidden="true"></i> Rüstzeit nachtragen</a>
  {{else}}<div class="t-empty"><i class="ti ti-tool-off" aria-hidden="true"></i> Keine Rüsttasten an dieser Anlage</div>{{end}}
  {{end}}
</div>
{{end}}
{{else}}
<div class="t-head">
  <a class="t-btn" href="/terminal/info"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
{{if .NoPerm}}
<div class="t-none"><i class="ti ti-lock" aria-hidden="true"></i><p>Keine Berechtigung</p><small>Dieses Terminal darf hier nichts melden oder anzeigen.</small></div>
{{else}}
{{if .Done}}<div class="t-rznote" role="status">{{if eq .Done "fault"}}Störung gemeldet – danke.{{else}}Ticket erstellt – danke.{{end}}</div>{{end}}
<div class="t-new{{if .Setup.Show}} has-rz{{end}}">
  <a class="t-tilebtn fault" href="/terminal/stoerung"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Störung</a>
  <a class="t-tilebtn ticket" href="/terminal/ticket"><i class="ti ti-ticket" aria-hidden="true"></i> Ticket</a>
  {{if .Setup.Show}}{{if and .SetupCard .SetupCan}}<a class="t-tilebtn t-rzlink" href="/terminal/rusten"><i class="ti ti-tool" aria-hidden="true"></i><span>Rüsten{{if .Setup.Running}}<small>{{.Setup.Text}}</small>{{else if .Setup.Fault}}<small>{{.Setup.Text}}</small>{{end}}</span></a>{{else}}<span class="t-tilebtn t-rzlink off" aria-disabled="true"><i class="ti ti-tool" aria-hidden="true"></i><span>Rüsten<small>{{if .SetupCard}}Keine Berechtigung zum Rüsten{{else}}Bitte zuerst anmelden{{end}}</small></span></span>{{end}}{{end}}
  <div class="t-stop">
    <h2><i class="ti ti-player-pause" aria-hidden="true"></i> Stillstand</h2>
    <p>Stillstandsgründe folgen</p>
  </div>
</div>
{{end}}
{{end}}
{{if and .CardEvents (ne .Mode "schoner")}}<div class="t-card" data-card-bar hidden><span class="who"><i class="ti ti-id-badge-2" aria-hidden="true"></i> Angemeldet: <span data-card-name></span></span><button type="button" class="t-btn" data-card-logout>Abmelden</button></div>
<div class="t-cardmsg" data-card-msg role="status" hidden></div>
<div class="t-login" id="login-panel" hidden>
  <div class="l-msg" data-login-msg hidden></div>
  <div data-login-fields hidden>
    <div class="l-row">
      <input type="text" id="login-card" inputmode="none" autocomplete="off" autocapitalize="characters" maxlength="32" placeholder="Kartennummer" aria-label="Kartennummer">
      <input type="password" id="login-pin" inputmode="none" autocomplete="off" maxlength="8" placeholder="PIN" aria-label="PIN">
    </div>
    <div class="t-keypad" id="login-keypad" aria-label="Ziffernfeld"></div>
  </div>
  <button type="button" class="t-btn" id="login-password-btn" hidden><i class="ti ti-user" aria-hidden="true"></i> Mit Benutzer und Passwort</button>
</div>
<div class="t-dialog" id="login-dialog" role="dialog" aria-modal="true" aria-label="Mit Benutzer und Passwort" hidden>
  <form autocomplete="off">
    <input type="text" id="login-user" autocomplete="off" autocapitalize="none" placeholder="Benutzer" aria-label="Benutzer">
    <input type="password" id="login-pass" autocomplete="off" placeholder="Passwort" aria-label="Passwort">
    <div class="l-row">
      <button type="button" class="t-btn" data-login-cancel>Abbrechen</button>
      <button type="submit" class="t-btn primary">Anmelden</button>
    </div>
  </form>
</div>{{end}}
<script src="/terminal/terminal.js?v={{appVersion}}"></script>
</body>
</html>
