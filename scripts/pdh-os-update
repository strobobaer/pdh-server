#!/bin/bash
# pdh-os-update – Betriebssystem-Updates mit festen Aktionen (für sudo freigegeben)
#   check    Paketlisten holen und die verfügbaren Updates auflisten
#   install  vorhandene Updates einspielen (nie Pakete entfernen)
#   status   Zustand als JSON ausgeben, ohne das Netz zu benutzen
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l LC_ALL=C.UTF-8

SCRIPT_VERSION=2

usage() { echo "Aufruf: pdh-os-update check|install|status" >&2; exit 2; }
[ $# -le 1 ] || usage
case "${1:-}" in check|install|status) ;; *) usage ;; esac

# Testschalter: nur mit PDH_OS_TEST=1 gilt ein Pfad-Präfix (sonst feste Pfade)
ROOT=""
# nie als root: sudo/systemd-run setzen die Umgebung heute zurück, ein späteres env_keep/SETENV
# könnte sonst Protokoll- und Stempelpfade auf root-eigene Dateien umlenken
if [ "${PDH_OS_TEST:-}" = "1" ] && [ "$(id -u)" != 0 ]; then ROOT="${PDH_OS_ROOT:-}"; fi
PROTO="$ROOT/var/log/pdh-os-update.log"
STAMP="$ROOT/var/lib/pdh-os-update.checked"
REBOOT="$ROOT/var/run/reboot-required"
APT=(apt-get -q -o DPkg::Lock::Timeout=300)

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

write_stamp() { date -Is > "$STAMP" 2>/dev/null || true; }

status_json() {
  local system="" kernel checked="" line name suites new old sec first=1 secn=0 pk
  if [ -r "$ROOT/etc/os-release" ]; then
    system=$(sed -n 's/^PRETTY_NAME=//p' "$ROOT/etc/os-release" | head -n 1)
    system=${system#\"}; system=${system%\"}
  fi
  kernel=$(uname -r)
  if [ -r "$STAMP" ]; then checked=$(head -n 1 "$STAMP"); fi
  local pkgs="" listing
  if ! listing=$(apt list --upgradable 2>/dev/null); then
    echo '{"ok":false,"error":"Paketliste nicht lesbar"}'
    return 1
  fi
  while IFS= read -r line; do
    if [[ $line =~ ^([A-Za-z0-9.+_-]+)/([^[:space:]]+)[[:space:]]+([A-Za-z0-9.+:~_-]+)[[:space:]]+[^[:space:]]+[[:space:]]+\[upgradable\ from:\ ([A-Za-z0-9.+:~_-]+)\] ]]; then
      name=${BASH_REMATCH[1]}; suites=${BASH_REMATCH[2]}; new=${BASH_REMATCH[3]}; old=${BASH_REMATCH[4]}
      sec=false
      case ",$suites," in *-security,*) sec=true; secn=$((secn + 1)) ;; esac
      [ $first = 1 ] || pkgs+=","
      first=0
      pkgs+="{\"name\":\"$name\",\"old\":\"$old\",\"new\":\"$new\",\"security\":$sec}"
    fi
  done < <(echo "$listing" | tail -n +2)
  local reboot=false rp="" f=1
  if [ -f "$REBOOT" ]; then
    reboot=true
    if [ -r "$REBOOT.pkgs" ]; then
      while IFS= read -r pk || [ -n "$pk" ]; do
        [ -n "$pk" ] || continue
        [ $f = 1 ] || rp+=","
        f=0
        rp+="\"$(json_escape "$pk")\""
      done < "$REBOOT.pkgs"
    fi
  fi
  printf '{"ok":true,"script_version":%s,"system":"%s","kernel":"%s","checked_at":"%s","upgradable":[%s],"security_count":%s,"reboot_required":%s,"reboot_pkgs":[%s]}\n' \
    "$SCRIPT_VERSION" "$(json_escape "$system")" "$(json_escape "$kernel")" "$(json_escape "$checked")" "$pkgs" "$secn" "$reboot" "$rp"
}

case "$1" in
  status)
    status_json
    exit 0
    ;;
  check)
    "${APT[@]}" update >/dev/null
    write_stamp
    apt list --upgradable 2>/dev/null | tail -n +2
    ;;
  install)
    { echo "== $(date -Is) install (von ${SUDO_USER:-root})"
      dpkg --configure -a --force-confdef --force-confold || echo "Warnung: dpkg --configure -a ist fehlgeschlagen"
      "${APT[@]}" update
      write_stamp
      "${APT[@]}" -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade --with-new-pkgs
    } 2>&1 | tee -a "$PROTO"
    ;;
esac
if [ -f "$REBOOT" ]; then echo "NEUSTART NÖTIG"; cat "$REBOOT.pkgs" 2>/dev/null || true; fi
