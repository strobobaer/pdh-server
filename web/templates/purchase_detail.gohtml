{{template "base" .}}

{{define "content"}}{{$p := .P}}{{$ed := .CanEdit}}
<style>
.pd-head{display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.pd-head h1{font-size:19px;font-weight:600;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pd-head .sub{font-size:12.5px;color:var(--muted);margin-top:3px}
@media (max-width:600px){.pd-head > div:first-child{flex-basis:100%}}
.pd-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin-bottom:12px}
.pd-step{border:1px solid var(--border);border-radius:10px;padding:8px 10px;background:var(--bg2);display:flex;gap:8px;align-items:center;min-width:0}
.pd-step i{font-size:18px;color:var(--muted)}
.pd-step .l{font-size:12.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pd-step .s{font-size:11px;color:var(--muted)}
.pd-step.done{border-color:color-mix(in srgb,var(--accent) 45%,var(--border))}
.pd-step.done i{color:var(--accent)}
.pd-step.cur{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.pd-step.warn{border-color:var(--amber,#f59e0b)}
.pd-step.warn .s{color:var(--amber,#b45309);font-weight:600}
@media (max-width:760px){.pd-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
.pd-warns{border:1px solid var(--amber,#f59e0b);background:color-mix(in srgb,var(--amber,#f59e0b) 10%,transparent);border-radius:10px;padding:8px 12px;margin-bottom:12px;font-size:12.5px}
.pd-warns div{display:flex;gap:6px;align-items:center}
.pd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:4px 14px}
.pd-items{width:100%;border-collapse:collapse;font-size:12.5px}
.pd-items th{font-size:11px;color:var(--muted);font-weight:600;text-align:left;padding:5px 4px;border-bottom:1px solid var(--border);white-space:nowrap}
.pd-items th.grp{text-align:center;border-bottom:0;color:var(--text)}
.pd-items td{padding:4px;border-bottom:1px solid var(--border);vertical-align:top}
.pd-items input,.pd-items select{width:100%;min-width:60px;font:inherit;font-size:12.5px;padding:4px 6px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text)}
.pd-items input.n{width:78px;text-align:right}
.pd-items input[name=item_part]{min-width:110px}
.pd-items .w{font-size:11px;color:var(--amber,#b45309);margin-top:2px;white-space:nowrap}
.pd-items .ok{font-size:11px;color:var(--green,#16a34a)}
.pd-items td.ro{white-space:nowrap}
.pd-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.pd-del li{font-size:12.5px}
.pd-docs{display:flex;flex-direction:column;gap:4px;font-size:12.5px}
</style>

<div class="pd-head">
  <div style="flex:1;min-width:0">
    <h1><i class="ti ti-truck-delivery"></i> {{$p.Number}} <span class="badge {{$p.StatusClass}}">{{$p.StatusLabel}}</span></h1>
    <div class="sub">{{if $p.SupplierName}}<a href="/directory/{{$p.SupplierID}}" style="color:var(--accent)">{{$p.SupplierName}}</a>{{else}}Lieferant fehlt{{end}}{{if $p.Title}} · {{$p.Title}}{{end}}{{if $p.DepartmentName}} · {{$p.DepartmentName}}{{end}} · angelegt {{$p.CreatedAt}}{{if $p.ValueLabel}} · Wert {{$p.ValueLabel}}{{end}}</div>
  </div>
  <a class="btn btn-small" href="/purchases"><i class="ti ti-arrow-left"></i> Alle Bestellvorgänge</a>
  {{if and $ed (ne $p.Status "cancelled")}}<form method="post" action="/purchases/{{$p.ID}}" onsubmit="return confirm('Bestellvorgang stornieren?')"><input type="hidden" name="action" value="cancel"><button class="btn btn-small" type="submit"><i class="ti ti-ban"></i> Stornieren</button></form>{{end}}
  {{if .CanDelete}}<form method="post" action="/purchases/{{$p.ID}}/delete" onsubmit="return confirm('Bestellvorgang endgültig löschen? Gebuchte Lagerbewegungen bleiben bestehen.')"><button class="btn btn-small btn-danger" type="submit" title="Nur Bereichsadministrator Beschaffung"><i class="ti ti-trash"></i> Löschen</button></form>{{end}}
</div>
{{if .Message}}<div class="rec-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="rec-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

<div class="pd-steps">
  {{range $p.Steps}}<div class="pd-step{{if .Done}} done{{end}}{{if .Current}} cur{{end}}{{if .Warn}} warn{{end}}"><i class="ti {{if .Done}}ti-circle-check{{else}}{{.Icon}}{{end}}" aria-hidden="true"></i><div style="min-width:0"><div class="l">{{.Label}}</div><div class="s">{{if .Warn}}{{.Warn}}{{else if .Done}}erledigt{{else if .Current}}jetzt{{else}}offen{{end}}</div></div></div>{{end}}
</div>
{{if $p.Warnings}}<div class="pd-warns">{{range $p.Warnings}}<div><i class="ti ti-alert-triangle"></i> {{.}}</div>{{end}}</div>{{end}}
{{if eq $p.Status "cancelled"}}<div class="rec-msg err"><i class="ti ti-ban"></i> Storniert.</div>{{end}}

<form method="post" action="/purchases/{{$p.ID}}" id="pd-form">
<fieldset {{if not $ed}}disabled{{end}} style="border:0;padding:0;margin:0;min-width:0">
  <div class="card">
    <div class="card-title"><span><i class="ti ti-info-circle"></i> Vorgang</span></div>
    <div class="pd-grid">
      <div class="form-group"><label class="form-label" for="pd-title">Titel</label><input class="form-input" id="pd-title" name="title" value="{{$p.Title}}" maxlength="200"></div>
      <div class="form-group"><label class="form-label" for="pd-sup">Lieferant</label>
        <select class="form-input" id="pd-sup" name="supplier_id"><option value="">–</option>{{range .Suppliers}}<option value="{{.Value}}" {{if eq .Value $p.SupplierID}}selected{{end}}>{{.Label}}</option>{{end}}{{if and (not .Suppliers) $p.SupplierID}}<option value="{{$p.SupplierID}}" selected>{{$p.SupplierName}}</option>{{end}}</select></div>
      <div class="form-group"><label class="form-label" for="pd-dep">Abteilung</label>
        <select class="form-input" id="pd-dep" name="department_id"><option value="">– alle –</option>{{range .Departments}}<option value="{{.ID}}" {{if eq .ID $p.DepartmentID}}selected{{end}}>{{.Indent}}{{.Name}}</option>{{end}}{{if and (not .Departments) $p.DepartmentID}}<option value="{{$p.DepartmentID}}" selected>{{$p.DepartmentName}}</option>{{end}}</select></div>
      <div class="form-group"><label class="form-label" for="pd-wanted">Wunschtermin</label><input class="form-input" type="date" id="pd-wanted" name="wanted_date" value="{{$p.WantedDate}}"></div>
      <div class="form-group"><label class="form-label" for="pd-store">Lagerort für den Wareneingang</label>
        <select class="form-input" id="pd-store" name="storage_node_id"><option value="">– je Position / Teil –</option>{{range .Storage}}<option value="{{.Value}}" {{if eq .Value $p.StorageID}}selected{{end}}>{{.Label}}</option>{{end}}</select></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label" for="pd-notes">Notizen</label><textarea class="form-input" id="pd-notes" name="notes" rows="2">{{$p.Notes}}</textarea></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title"><span><i class="ti ti-list-numbers"></i> Positionen</span><span class="rec-sub">Ersatzteil per Nummer wählen – Bezeichnung, Einheit, Lieferanten-Nr. und Preis kommen aus dem Teil</span></div>
    <div style="overflow-x:auto">
    <table class="pd-items">
      <thead>
        <tr><th colspan="5"></th><th class="grp" colspan="2">Angebot</th><th class="grp" colspan="2">Bestellung</th><th class="grp" colspan="2">AB</th><th colspan="3"></th></tr>
        <tr><th>Ersatzteil</th><th>Bezeichnung</th><th>Lief.-Art.-Nr.</th><th>Einheit</th><th></th><th>Menge</th><th>Preis €</th><th>Menge</th><th>Preis €</th><th>Menge</th><th>Preis €</th><th>Geliefert</th><th>Lagerort</th><th></th></tr>
      </thead>
      <tbody id="pd-rows">
      {{range $p.Items}}
      <tr>
        <td><input type="hidden" name="item_id" value="{{.ID}}"><input name="item_part" list="pd-parts" value="{{.PartNo}}" placeholder="Nummer" aria-label="Ersatzteil" onchange="pdPart(this)">{{if .PartID}}<div class="rec-sub"><a href="/inventory/{{.PartID}}?tab=purchasing" style="color:var(--accent)">Teil öffnen</a></div>{{end}}</td>
        <td><input name="item_desc" value="{{.Description}}" maxlength="300" aria-label="Bezeichnung" style="min-width:160px"></td>
        <td><input name="item_supno" value="{{.SupplierPartNo}}" maxlength="100" aria-label="Lieferanten-Artikelnummer"></td>
        <td><input name="item_unit" value="{{.Unit}}" maxlength="20" aria-label="Einheit" style="width:60px;min-width:50px"></td>
        <td></td>
        <td><input class="n" name="item_qq" value="{{.Q .QtyQuoted}}" inputmode="decimal" aria-label="Menge Angebot"></td>
        <td><input class="n" name="item_pq" value="{{.Q .PriceQuoted}}" inputmode="decimal" aria-label="Preis Angebot"></td>
        <td><input class="n" name="item_qo" value="{{.Q .QtyOrdered}}" inputmode="decimal" aria-label="Menge Bestellung"></td>
        <td><input class="n" name="item_po" value="{{.Q .PriceOrdered}}" inputmode="decimal" aria-label="Preis Bestellung"></td>
        <td><input class="n" name="item_qc" value="{{.Q .QtyConfirmed}}" inputmode="decimal" aria-label="Menge AB">{{if .ABWarn}}<div class="w" title="{{.ABWarn}}"><i class="ti ti-alert-triangle"></i> {{.ABWarn}}</div>{{else if .QtyConfirmed}}<div class="ok"><i class="ti ti-check"></i> wie bestellt</div>{{end}}</td>
        <td><input class="n" name="item_pc" value="{{.Q .PriceConfirmed}}" inputmode="decimal" aria-label="Preis AB"></td>
        <td class="ro">{{.F .Delivered}} {{.Unit}}{{if .DeliveryWarn}}<div class="w"><i class="ti ti-alert-triangle"></i> {{.DeliveryWarn}}</div>{{end}}</td>
        <td><select name="item_storage" aria-label="Lagerort" style="min-width:140px"><option value="">–</option>{{$sid := .StorageID}}{{range $.Storage}}<option value="{{.Value}}" {{if eq .Value $sid}}selected{{end}}>{{.Label}}</option>{{end}}</select></td>
        <td>{{if and $ed (eq .Delivered 0.0)}}<button type="button" class="btn-icon" onclick="this.closest('tr').remove()" title="Position entfernen" aria-label="Position entfernen"><i class="ti ti-x"></i></button>{{end}}</td>
      </tr>
      {{end}}
      </tbody>
    </table>
    </div>
    {{if $ed}}<div class="pd-actions"><button type="button" class="btn btn-small" onclick="pdAddRow()"><i class="ti ti-plus"></i> Position hinzufügen</button></div>{{end}}
  </div>

  <div class="card">
    <div class="card-title"><span><i class="ti ti-file-dollar"></i> Angebot · Bestellung · Auftragsbestätigung</span></div>
    <div class="pd-grid">
      <div class="form-group"><label class="form-label" for="pd-qno">Angebotsnummer</label><input class="form-input" id="pd-qno" name="quote_no" value="{{$p.QuoteNo}}" maxlength="80"></div>
      <div class="form-group"><label class="form-label" for="pd-qd">Angebot vom</label><input class="form-input" type="date" id="pd-qd" name="quote_date" value="{{$p.QuoteDate}}"></div>
      <div class="form-group"><label class="form-label" for="pd-qv">Angebot gültig bis</label><input class="form-input" type="date" id="pd-qv" name="quote_valid_until" value="{{$p.QuoteValid}}"></div>
      <div class="form-group"><label class="form-label" for="pd-ono">Bestellnummer</label><input class="form-input" id="pd-ono" name="order_no" value="{{$p.OrderNo}}" maxlength="80" placeholder="{{$p.Number}}"><div class="help" style="font-size:11px;color:var(--muted)">{{if $p.OrderedAt}}Bestellt am {{$p.OrderedAt}}{{if $p.OrderedBy}} von {{$p.OrderedBy}}{{end}}{{else}}noch nicht bestellt{{end}}</div></div>
      <div class="form-group"><label class="form-label" for="pd-cno">AB-Nummer</label><input class="form-input" id="pd-cno" name="confirmation_no" value="{{$p.ConfirmationNo}}" maxlength="80"></div>
      <div class="form-group"><label class="form-label" for="pd-cd">AB vom</label><input class="form-input" type="date" id="pd-cd" name="confirmation_date" value="{{$p.ConfirmationDate}}"></div>
      <div class="form-group"><label class="form-label" for="pd-cdel">Liefertermin laut AB</label><input class="form-input" type="date" id="pd-cdel" name="confirmed_delivery" value="{{$p.ConfirmedDelivery}}"></div>
    </div>
    {{if $ed}}
    <div class="pd-actions">
      <button class="btn btn-primary" type="submit" name="action" value="save"><i class="ti ti-device-floppy"></i> Speichern</button>
      {{if eq $p.Status "quote"}}
      <button class="btn" type="submit" name="action" value="quote_to_order" title="Mengen und Preise aus dem Angebot in die Bestellung übernehmen"><i class="ti ti-arrow-right"></i> Angebot → Bestellung</button>
      <button class="btn" type="submit" name="action" value="order" onclick="return confirm('Als bestellt markieren? Fehlende Bestellmengen werden aus dem Angebot übernommen.')"><i class="ti ti-shopping-cart"></i> Als bestellt markieren</button>
      {{else}}
      <button class="btn" type="submit" name="action" value="ab_equal" title="AB-Menge und -Preis = Bestellung (keine Abweichung)"><i class="ti ti-file-check"></i> AB wie Bestellung</button>
      {{end}}
    </div>
    {{end}}
  </div>
</fieldset>
</form>

<div class="card" id="delivery">
  <div class="card-title"><span><i class="ti ti-truck-delivery"></i> Lieferung</span><span class="rec-sub">Lieferung wird mit der AB verglichen und bucht ins Lager</span></div>
  {{if $p.Deliveries}}<ul class="pd-del">{{range $p.Deliveries}}<li><b>{{.Date}}</b>{{if .NoteNo}} · Lieferschein {{.NoteNo}}{{end}}{{if .By}} · {{.By}}{{end}}: {{range $i, $l := .Lines}}{{if $i}}; {{end}}{{$l}}{{end}}{{if .Notes}} – <i>{{.Notes}}</i>{{end}}</li>{{end}}</ul>{{else}}<p class="rec-sub">Noch keine Lieferung.</p>{{end}}
  {{if and .CanReceive .HasOpen}}
  <form method="post" action="/purchases/{{$p.ID}}/delivery" style="margin-top:10px">
    <div class="pd-grid">
      <div class="form-group"><label class="form-label" for="pd-ls">Lieferschein-Nr.</label><input class="form-input" id="pd-ls" name="delivery_note_no" maxlength="80"></div>
      <div class="form-group"><label class="form-label" for="pd-lon">Geliefert am</label><input class="form-input" type="date" id="pd-lon" name="delivered_on" value="{{.Today}}"></div>
      <div class="form-group"><label class="form-label" for="pd-ln">Bemerkung</label><input class="form-input" id="pd-ln" name="notes" maxlength="500"></div>
    </div>
    <div style="overflow-x:auto"><table class="pd-items">
      <thead><tr><th>Position</th><th>Soll (AB)</th><th>schon da</th><th>jetzt geliefert</th><th>Lagerort</th></tr></thead>
      <tbody>{{range $p.Items}}{{if gt .Open 0.0}}
      <tr><td>{{if .PartNo}}<b>{{.PartNo}}</b> {{end}}{{if .Description}}{{.Description}}{{else}}{{.PartName}}{{end}}{{if not .PartID}}<div class="rec-sub">ohne Ersatzteil – wird nicht ins Lager gebucht</div>{{end}}</td>
        <td class="ro">{{.F .Target}} {{.Unit}}</td><td class="ro">{{.F .Delivered}}</td>
        <td><input class="n" name="recv_{{.ID}}" value="{{.F .Open}}" inputmode="decimal" aria-label="Gelieferte Menge"></td>
        <td>{{if .PartID}}<select name="recv_storage_{{.ID}}" aria-label="Lagerort" style="min-width:160px"><option value="">{{if $p.StoragePath}}Standard: {{$p.StoragePath}}{{else}}– wählen –{{end}}</option>{{$sid := .StorageID}}{{range $.Storage}}<option value="{{.Value}}" {{if eq .Value $sid}}selected{{end}}>{{.Label}}</option>{{end}}</select>{{end}}</td></tr>
      {{end}}{{end}}</tbody>
    </table></div>
    <div class="pd-actions"><button class="btn btn-primary" type="submit"><i class="ti ti-package-import"></i> Wareneingang buchen</button><span class="rec-sub" style="align-self:center">Weniger eintragen = Teillieferung; 0 = diese Position noch nicht.</span></div>
  </form>
  {{end}}
</div>

<div class="card" id="invoice">
  <div class="card-title"><span><i class="ti ti-receipt"></i> Rechnung</span></div>
  {{if eq $p.Status "closed"}}
  <p><i class="ti ti-circle-check" style="color:var(--green)"></i> Rechnung OK am {{$p.InvoiceOKAt}}{{if $p.InvoiceOKBy}} von {{$p.InvoiceOKBy}}{{end}}{{if $p.InvoiceRef}} · {{$p.InvoiceRef}}{{else}} · Rechnung in ELO{{end}}{{if $p.InvoiceNote}} – {{$p.InvoiceNote}}{{end}}</p>
  {{if $.CanDelete}}<form method="post" action="/purchases/{{$p.ID}}"><input type="hidden" name="action" value="reopen"><button class="btn btn-small" type="submit"><i class="ti ti-lock-open"></i> Wieder öffnen</button></form>{{end}}
  {{else if .CanInvoice}}
  <form method="post" action="/purchases/{{$p.ID}}/invoice" onsubmit="return confirm('Rechnung OK setzen und den Vorgang abschließen?')">
    <div class="pd-grid">
      <div class="form-group"><label class="form-label" for="pd-inv">Rechnungs- oder ELO-Nummer (optional)</label><input class="form-input" id="pd-inv" name="invoice_ref" maxlength="120" placeholder="leer lassen, wenn die Rechnung in ELO liegt"></div>
      <div class="form-group"><label class="form-label" for="pd-invn">Bemerkung</label><input class="form-input" id="pd-invn" name="invoice_note" maxlength="500"></div>
    </div>
    <div class="pd-actions"><button class="btn btn-primary" type="submit"><i class="ti ti-receipt"></i> Rechnung OK – Vorgang abschließen</button>{{if ne $p.Status "delivered"}}<span class="rec-sub" style="align-self:center;color:var(--amber,#b45309)"><i class="ti ti-alert-triangle"></i> Noch nicht vollständig geliefert</span>{{end}}</div>
  </form>
  {{else}}<p class="rec-sub">Rechnung OK geht nach der Bestellung – mit dem Recht „Rechnung OK setzen“.</p>{{end}}
  {{if and (eq $p.Status "cancelled") $.CanDelete}}<form method="post" action="/purchases/{{$p.ID}}"><input type="hidden" name="action" value="reopen"><button class="btn btn-small" type="submit"><i class="ti ti-lock-open"></i> Wieder öffnen</button></form>{{end}}
</div>

<div class="card">
  <div class="card-title"><span><i class="ti ti-paperclip"></i> Dokumente</span><span class="rec-sub">Angebot, Bestellung, AB, Lieferschein als PDF oder Foto</span></div>
  <div class="pd-docs" id="pd-docs"><span class="rec-sub">Lädt …</span></div>
  {{if or $ed .CanReceive}}
  <div class="pd-actions">
    <select class="form-input" id="pd-doc-kind" style="width:auto" aria-label="Art des Dokuments"><option>Angebot</option><option>Bestellung</option><option>Auftragsbestätigung</option><option>Lieferschein</option><option>Sonstiges</option></select>
    <label class="btn btn-small"><i class="ti ti-upload"></i> Datei anhängen<input type="file" id="pd-doc-file" accept=".pdf,image/*" hidden onchange="pdUpload(this)"></label>
  </div>
  {{end}}
</div>

{{template "record-history" .History}}

<datalist id="pd-parts">{{range .Parts}}<option value="{{.No}}" data-id="{{.ID}}" data-name="{{.Name}}" data-unit="{{.Unit}}">{{.Name}}</option>{{end}}</datalist>
<template id="pd-row-tpl">
  <tr>
    <td><input type="hidden" name="item_id" value=""><input name="item_part" list="pd-parts" placeholder="Nummer" aria-label="Ersatzteil" onchange="pdPart(this)"></td>
    <td><input name="item_desc" maxlength="300" aria-label="Bezeichnung" style="min-width:160px"></td>
    <td><input name="item_supno" maxlength="100" aria-label="Lieferanten-Artikelnummer"></td>
    <td><input name="item_unit" value="Stk" maxlength="20" aria-label="Einheit" style="width:60px;min-width:50px"></td>
    <td></td>
    <td><input class="n" name="item_qq" inputmode="decimal" aria-label="Menge Angebot"></td>
    <td><input class="n" name="item_pq" inputmode="decimal" aria-label="Preis Angebot"></td>
    <td><input class="n" name="item_qo" inputmode="decimal" aria-label="Menge Bestellung"></td>
    <td><input class="n" name="item_po" inputmode="decimal" aria-label="Preis Bestellung"></td>
    <td><input class="n" name="item_qc" inputmode="decimal" aria-label="Menge AB"></td>
    <td><input class="n" name="item_pc" inputmode="decimal" aria-label="Preis AB"></td>
    <td class="ro">–</td>
    <td><select name="item_storage" aria-label="Lagerort" style="min-width:140px"><option value="">–</option>{{range .Storage}}<option value="{{.Value}}">{{.Label}}</option>{{end}}</select></td>
    <td><button type="button" class="btn-icon" onclick="this.closest('tr').remove()" title="Position entfernen" aria-label="Position entfernen"><i class="ti ti-x"></i></button></td>
  </tr>
</template>
{{end}}

{{define "scripts"}}
<script>
const PD_ID = {{.P.ID}};
function pdAddRow(){
  const tr = document.getElementById('pd-row-tpl').content.firstElementChild.cloneNode(true);
  document.getElementById('pd-rows').appendChild(tr);
  tr.querySelector('[name=item_part]').focus();
}
// Ersatzteil gewählt: Bezeichnung und Einheit vorschlagen
function pdPart(inp){
  const o = [...document.querySelectorAll('#pd-parts option')].find(x => x.value === inp.value.trim());
  if(!o) return;
  const tr = inp.closest('tr');
  const d = tr.querySelector('[name=item_desc]'), u = tr.querySelector('[name=item_unit]');
  if(!d.value) d.value = o.dataset.name || '';
  if(o.dataset.unit) u.value = o.dataset.unit;
}
// Dokumente (Anhänge am Vorgang)
async function pdDocs(){
  const box = document.getElementById('pd-docs');
  try{
    const res = await fetch('/api/v1/attachments/purchase_order/' + PD_ID, {credentials: 'same-origin'});
    const j = await res.json(); const list = (j && (j.data || j)) || [];
    box.replaceChildren();
    if(!list.length){ const s = document.createElement('span'); s.className = 'rec-sub'; s.textContent = 'Noch keine Dokumente.'; box.appendChild(s); return; }
    list.forEach(a => { const d = document.createElement('div'); const l = document.createElement('a'); l.href = a.url; l.target = '_blank'; l.rel = 'noopener'; l.style.color = 'var(--accent)';
      l.textContent = (a.caption ? a.caption + ': ' : '') + a.filename; d.appendChild(l); box.appendChild(d); });
  }catch(e){ box.textContent = 'Dokumente konnten nicht geladen werden.'; }
}
async function pdUpload(inp){
  if(!inp.files.length) return;
  const fd = new FormData(); fd.append('files', inp.files[0]); fd.append('caption', document.getElementById('pd-doc-kind').value);
  const res = await fetch('/api/v1/attachments/purchase_order/' + PD_ID, {method: 'POST', body: fd, credentials: 'same-origin'});
  if(!res.ok) alert('Hochladen fehlgeschlagen: ' + (await res.text()));
  inp.value = ''; pdDocs();
}
pdDocs();
</script>
{{end}}
