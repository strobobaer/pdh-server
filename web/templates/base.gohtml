<script>
document.addEventListener('click', function(e){
  const a = e.target.closest('[data-frame],[data-frame-external]');
  if(!a || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
  // Innerhalb einer eingebetteten Ansicht normal navigieren (kein Overlay im Overlay)
  if(document.documentElement.classList.contains('pdh-embedded') && a.hasAttribute('data-frame')) return;
  e.preventDefault();
  e.stopPropagation();
  openPdhFrame(a.getAttribute('href') || a.dataset.href, a.dataset.frameTitle || a.textContent.trim(), a.hasAttribute('data-frame-external'));
}, true);
</script>
<script>
// Ersatzteil-Reservierung: (teilweise) zurueck an den Lagerplatz buchen.
// reload: Funktion zum Neuladen der Liste (sonst ganze Seite).
async function pdhReturnReservation(kind, ref, id, max, reload){
  const v = prompt({{t "Wie viel zurückbuchen? (reserviert: %s)" "#"}}.replace('#', max), String(max));
  if(v === null) return;
  const qty = parseFloat(String(v).replace(',', '.'));
  if(!(qty > 0)){ alert({{t "Bitte eine Menge größer 0 angeben."}}); return; }
  try{
    const res = await fetch('/reservations/' + encodeURIComponent(kind) + '/' + encodeURIComponent(ref) + '/' + encodeURIComponent(id) + '/return',
      {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({qty: Math.min(qty, max)})});
    const j = await res.json();
    if(!res.ok || j.success === false) throw new Error(j.error || ('HTTP ' + res.status));
    if(typeof reload === 'function') reload(); else location.reload();
  }catch(e){ alert({{t "Fehler"}} + ': ' + e.message); }
}
// Reservierung als verbraucht buchen (Anlagen-Reservierungen, siehe part_booking.go).
async function pdhConsumeReservation(kind, ref, id){
  if(!confirm({{t "Reservierte Menge als verbraucht buchen?"}})) return;
  try{
    const res = await fetch('/reservations/' + encodeURIComponent(kind) + '/' + encodeURIComponent(ref) + '/' + encodeURIComponent(id) + '/consume',
      {method: 'POST', credentials: 'same-origin'});
    const j = await res.json();
    if(!res.ok || j.success === false) throw new Error(j.error || ('HTTP ' + res.status));
    location.reload();
  }catch(e){ alert({{t "Fehler"}} + ': ' + e.message); }
}
// Kennzeichnung + Rueckbuchen-Knopf fuer eine vorgemerkte Position (p aus .../pending-parts)
function pdhReservedTag(p, kind, ref, reloadName){
  if(!p || !p.reserved) return '';
  const a = [kind, ref, p.id].map(x => "'" + String(x).replace(/[^\w-]/g, '') + "'").join(',');
  return ' · <span class="res-q" title="' + {{t "bereits vom Lager abgebucht"}} + '">' + {{t "reserviert"}} + '</span>'
    + ' <button type="button" class="btn btn-small" style="font-size:11px;padding:2px 8px" title="' + {{t "Nicht benötigte Menge zurück an den Lagerplatz buchen"}} + '" onclick="pdhReturnReservation(' + a + ',' + Number(p.qty) + ',' + reloadName + ')"><i class="ti ti-arrow-back-up"></i> ' + {{t "Zurückbuchen"}} + '</button>';
}
</script>
{{block "scripts" .}}{{end}}
<script src="{{uiURL "pdh-live-translate.js"}}"></script>

<script>
// Hinweis-Band vor der automatischen Wartung: fragt alle 15 s /wartung/status (ohne Fortschrittsbalken),
// zählt bei laufendem Countdown sekündlich herunter und springt bei Sperre auf den Wartungsbildschirm
(function(){
  const band = document.getElementById('maint-band');
  if(!band || document.documentElement.classList.contains('pdh-embedded')) return;
  const txt = document.getElementById('maint-band-text');
  const act = band.querySelector('.mb-act');
  const tpl = {{t "Automatische Wartung in %s min – bitte Eingaben speichern"}};
  const askTpl = {{t "Wartungsfenster: Update auf %v durchführen? Noch %s min"}};
  const L = {
    go: {{t "Durchführen"}}, goQ: {{t "Update jetzt durchführen?"}},
    no: {{t "Absagen"}}, noQ: {{t "Update absagen?"}},
    stop: {{t "Abbrechen"}}, stopQ: {{t "Update abbrechen und zurücksetzen?"}},
    err: {{t "Aktion nicht möglich"}}
  };
  let until = 0, skew = 0, tick = null, timer = null, mode = '', ver = '', note = '', acts = '';
  const fmt = s => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  function hide(){ until = 0; mode = ''; acts = ''; act.textContent = ''; band.classList.remove('soon'); if(tick){ clearInterval(tick); tick = null; }
    if(note){ band.hidden = false; txt.textContent = note; return; } // Rückmeldung einer Aktion bleibt sichtbar
    band.hidden = true; }
  function draw(){
    const left = Math.max(0, Math.round((until - (Date.now() + skew)) / 1000));
    if(note){ txt.textContent = note; return; }
    if(mode === 'ask'){ txt.textContent = askTpl.replace('%v', ver).replace('%s', fmt(left)); band.classList.remove('soon'); return; }
    txt.textContent = tpl.replace('%s', fmt(left));
    band.classList.toggle('soon', left <= 30);
  }
  // Knöpfe nur neu aufbauen, wenn sich ihre Zusammensetzung ändert (sonst geht ein Klick verloren)
  function buttons(list){
    const key = list.map(b => b.url + '#' + b.label).join('|');
    if(key === acts) return;
    acts = key; act.textContent = '';
    list.forEach(b => {
      const el = document.createElement('button');
      el.type = 'button'; el.className = 'btn btn-small' + (b.primary ? ' btn-primary' : ''); el.textContent = b.label;
      el.addEventListener('click', () => post(b, el));
      act.appendChild(el);
    });
  }
  async function post(b, el){
    if(!confirm(b.q)) return;
    el.disabled = true;
    try {
      const r = await fetch(b.url, {method: 'POST', credentials: 'same-origin', headers: {Accept: 'application/json'}});
      let j = null;
      try { j = await r.json(); } catch(e) { /* z. B. 403 als Klartext */ }
      note = j ? (j.ok ? (j.msg || '') : (j.error || L.err)) : (r.statusText || (L.err + ' (' + r.status + ')'));
    } catch(e) { note = L.err; }
    el.disabled = false; draw();
    setTimeout(() => { note = ''; poll(); }, 6000);
    poll();
  }
  function schedule(ms){ clearTimeout(timer); timer = setTimeout(poll, ms); }
  async function poll(){
    if(document.hidden){ schedule(15000); return; }
    try {
      const r = await fetch('/wartung/status', {credentials: 'same-origin', cache: 'no-store', pdhQuiet: true});
      const v = await r.json();
      if(v.locked){ location.href='/wartung'; return; }
      const d = Date.parse(r.headers.get('Date') || '');
      skew = isNaN(d) ? 0 : d - Date.now();
      const u = v.countdown_until ? Date.parse(v.countdown_until) : 0;
      const ask = (v.phase === 'nachfrage' && v.ask_until) ? Date.parse(v.ask_until) : 0;
      if(ask && ask > Date.now() + skew){
        until = ask; mode = 'ask'; ver = v.to_version || ''; band.hidden = false;
        const l = [];
        if(v.can_confirm) l.push({url: '/wartung/durchfuehren', label: L.go, q: L.goQ, primary: true});
        if(v.can_abort) l.push({url: '/wartung/abbrechen', label: L.no, q: L.noQ});
        buttons(l); draw();
        if(!tick) tick = setInterval(draw, 1000);
      } else if(u && u > Date.now() + skew){
        until = u; mode = 'count'; band.hidden = false;
        buttons(v.can_abort ? [{url: '/wartung/abbrechen', label: L.stop, q: L.stopQ}] : []); draw();
        if(!tick) tick = setInterval(draw, 1000);
      } else if(!(until && mode === 'count' && Date.now() + skew - until < 60000)) hide(); // abgelaufen: Sperre folgt in Kürze
      else buttons([]);
    } catch(e) { /* Server startet vielleicht neu – weiter fragen */ }
    schedule(until ? 2000 : 15000);
  }
  document.addEventListener('visibilitychange', () => { if(!document.hidden) poll(); });
  schedule(3000);
})();
</script>

{{if .PushEnabled}}
<!-- Push-Benachrichtigungen (push.go, /sw.js): Geraet anmelden und „Anlage steht“-Alarm im Vollbild -->
<div id="pdh-alarm" hidden role="alertdialog" aria-modal="true" aria-labelledby="pdh-alarm-title">
  <div class="pa-box">
    <div class="pa-kind"><i class="ti ti-alert-octagon"></i> <span id="pdh-alarm-kind"></span> · Anlage steht</div>
    <h2 id="pdh-alarm-title"></h2>
    <div class="pa-body" id="pdh-alarm-body"></div>
    <div class="pa-more" id="pdh-alarm-more"></div>
    <button type="button" class="pa-accept" id="pdh-alarm-accept"><i class="ti ti-hand-grab"></i> Annehmen</button>
    <div class="pa-row"><a class="pa-btn" id="pdh-alarm-open" href="#"><i class="ti ti-eye"></i> Ansehen</a><button type="button" class="pa-btn" id="pdh-alarm-snooze">2 Min. ausblenden</button></div>
    <div class="pa-msg" id="pdh-alarm-msg" role="alert"></div>
  </div>
</div>
<style>
#pdh-alarm{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:18px;background:linear-gradient(170deg,#7f1d1d,#b91c1c 55%,#450a0a);color:#fff;animation:pa-pulse 1.6s ease-in-out infinite}
@keyframes pa-pulse{50%{filter:brightness(1.18)}}
#pdh-alarm[hidden]{display:none}
.pa-box{width:min(560px,100%);display:flex;flex-direction:column;gap:12px}
.pa-kind{font-size:15px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;display:flex;gap:8px;align-items:center}
.pa-kind i{font-size:24px}
#pdh-alarm h2{font-size:clamp(24px,6vw,36px);line-height:1.15;overflow-wrap:anywhere}
.pa-body{font-size:17px;line-height:1.45;white-space:pre-wrap;opacity:.9;overflow-wrap:anywhere;max-height:40vh;overflow:auto}
.pa-more{font-size:13px;opacity:.8}
.pa-accept{min-height:90px;border:0;border-radius:16px;background:#10b981;color:#fff;font:inherit;font-size:25px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.pa-accept i{font-size:32px}
.pa-accept:disabled{opacity:.6}
.pa-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.pa-btn{min-height:54px;border:0;border-radius:14px;background:rgba(255,255,255,.16);color:#fff;font:inherit;font-size:16px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;cursor:pointer}
.pa-msg{min-height:20px;text-align:center;font-size:14px}
</style>
<script src="{{uiURL "pdh-push.js"}}"></script>
{{end}}

<script>
// Microsoft (und andere Anbieter) verbieten ihre Anmeldeseite im Frame
// („login.microsoftonline.com hat die Verbindung verweigert“). Läuft das PDH
// eingebettet (Nextcloud-App, Frame-Overlay), Anmeldung im neuen Tab öffnen.
document.addEventListener('submit', function (e) {
  var f = e.target;
  if (!f.matches || !f.matches('form[data-oauth]')) return;
  var framed = false;
  try { framed = window.top !== window.self; } catch (err) { framed = true; }
  if (framed) f.target = '_blank';
}, true);
</script>
</body>
</html>
