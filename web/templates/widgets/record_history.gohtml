{{define "record-history"}}
<div class="card">
  <div class="card-title"><span><i class="ti ti-history"></i> Datensatzhistorie</span></div>
  {{range .}}
  <div class="li">
    <div class="act-dot d-blue"></div>
    <div class="li-text">
      <div class="li-title">{{if .Message}}{{.Message}}{{else}}{{.Action}}{{end}}</div>
      <div class="li-sub">{{.CreatedAt}}{{if .UserName}} &middot; {{.UserName}}{{end}}{{if .FieldName}} &middot; {{.FieldName}}{{end}}</div>
      {{if or .OldValue .NewValue}}<div class="li-sub">{{.OldValue}} &rarr; {{.NewValue}}</div>{{end}}
    </div>
  </div>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:4px 0">Noch keine Historie</div>
  {{end}}
</div>
{{end}}
