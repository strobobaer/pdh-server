 	r.Post("/storage/{id}/children-web", h.StorageAddChild)
@@ -2653,6 +2655,39 @@ type ITAssetView struct {
 	Notes        string
 }
 
+type ITDetailData struct {
+	BaseData
+	Users []UserOption
+	Asset ITAssetDetailView
+}
+
+type ITAssetDetailView struct {
+	ID               string
+	Name             string
+	Type             string
+	TypeLabel        string
+	TypeIcon         string
+	Status           string
+	StatusLabel      string
+	StatusClass      string
+	Hostname         string
+	IPAddress        string
+	MACAddress       string
+	Manufacturer     string
+	Model            string
+	SerialNo         string
+	Location         string
