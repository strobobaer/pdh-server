+  </div>
+  <span id="status-badge" class="badge {{.Asset.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Asset.StatusLabel}}</span>
+
+  <div style="position:relative">
+    {{template "icon-button" (dict "Action" "more" "OnClick" "toggleMenu('it-menu')")}}
+    <div id="it-menu" style="display:none;position:absolute;right:0;top:36px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:6px;min-width:180px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.3)">
+      <div style="padding:4px 8px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">Status ändern</div>
+      {{template "icon-button" (dict "Action" "activate" "ShowLabel" true "Label" "Aktiv" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"active\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
+      {{template "icon-button" (dict "Action" "refresh" "ShowLabel" true "Label" "Wartung" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"maintenance\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
+      {{template "icon-button" (dict "Action" "deactivate" "ShowLabel" true "Label" "Inaktiv" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"inactive\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
+      {{template "icon-button" (dict "Action" "delete" "ShowLabel" true "Label" "Außer Dienst" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"retired\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
+    </div>
+  </div>
+</div>
+
+<div class="grid2" style="grid-template-columns:1fr 340px;gap:14px;align-items:start">
+  <div>
+    <!-- Übersicht -->
+    <div class="card">
+      <div class="card-title">Übersicht</div>
