<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>PDH · Übersicht</title>
<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
<script>
(function(){
  var mode = localStorage.getItem('pdh_theme') || 'system';
  var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.dataset.theme = mode === 'system' ? (systemDark ? 'dark' : 'light') : mode;
  document.documentElement.dataset.themeMode = mode;
})();
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css?v={{appVersion}}">
{{template "wizard-styles"}}
{{template "timeline-style" .Timeline}}
<style>
/* Erstellungs- und Abschluss-Assistent im Leitstand: gleiche Optik wie im PDH, Farben aus dem Leitstand */
#cw{--bg2:var(--surface);--bg3:var(--surface-2);--accent-rgb:79,110,247;--on-accent:#fff;--font:inherit;font-family:inherit;color:var(--text)}
#cw .cw{font-size:14px}
#cw .form-label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:400}
#cw .form-input{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-size:14px;font-family:inherit;outline:0;min-height:44px}
#cw .form-input:focus{border-color:var(--accent)}
#cw textarea.form-input{min-height:96px;resize:vertical}
#cw .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 18px;border-radius:8px;font-size:14px;font-family:inherit;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text)}
#cw .btn:disabled{opacity:.55;cursor:default}
#cw .btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
#cw .btn-icon{min-height:32px;padding:0}
#cw .cw-chips button{min-height:40px;font-size:13px}
#cw .cw-people label,#cw .cw-check{min-height:44px}
#crw{--bg2:var(--surface);--bg3:var(--surface-2);--accent-rgb:79,110,247;--on-accent:#fff;--font:inherit;font-family:inherit;color:var(--text)}
#crw .cw{font-size:14px}
#crw .form-group{margin-bottom:14px}
#crw .form-label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:400}
#crw .form-input{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-size:14px;font-family:inherit;outline:0;min-height:44px}
#crw .form-input:focus{border-color:var(--accent)}
#crw textarea.form-input{min-height:96px;resize:vertical}
#crw .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 18px;border-radius:8px;font-size:14px;font-family:inherit;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text)}
#crw .btn:disabled{opacity:.55;cursor:default}
#crw .btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
#crw .cw-chips button{min-height:40px;font-size:13px}
#crw .crw-pick label{min-height:44px}
</style>
<style>
:root{
  color-scheme:dark;font-family:"Aptos","Segoe UI",sans-serif;
  --bg:#101512;--surface:#19211c;--surface-2:#222d26;--border:#35443a;--text:#f1f5f2;--muted:#a2b0a6;
  --accent:#4f6ef7;--green:#2b8a57;--amber:#c48b22;--red:#bd4747;--focus:#b6e3c6;--overdue:#e05a5a;
  --type-fault:#3fae86;--type-ticket:#4b9fc4;--type-maintenance:#c99a3c;--type-task:#9d7fc9;
  --type-fault-bg:#254b43;--type-fault-fg:#bce8d5;
  --type-ticket-bg:#214b61;--type-ticket-fg:#b7e4f5;
  --type-maintenance-bg:#614719;--type-maintenance-fg:#f3dcaa;
  --type-task-bg:#493d5a;--type-task-fg:#e1d1f4;
  --accept-bg:#24583d;--accept-border:#397b55;
  --finish-bg:#20576a;--finish-border:#347890;
  --discard-bg:#5b3030;--discard-border:#854545;
  --wait-bg:#594817;--wait-border:#856e2a;
}
:root[data-theme="light"]{
  color-scheme:light;
  --bg:#f5f7fb;--surface:#ffffff;--surface-2:#eef2f7;--border:#d7dee8;--text:#111827;--muted:#64748b;
  --accent:#3457d5;--green:#059669;--amber:#d97706;--red:#dc2626;--focus:#1d4ed8;--overdue:#dc2626;
  --type-fault:#0f9d6b;--type-ticket:#1f7fae;--type-maintenance:#b3801e;--type-task:#7c5bc7;
  --type-fault-bg:#d6f3e7;--type-fault-fg:#0b6b49;
  --type-ticket-bg:#dbeefb;--type-ticket-fg:#155d85;
  --type-maintenance-bg:#faedd2;--type-maintenance-fg:#8a5f10;
  --type-task-bg:#ece3fa;--type-task-fg:#5b3fa3;
  --accept-bg:#dcf3e6;--accept-border:#8fd1ac;
  --finish-bg:#daeef8;--finish-border:#8dc4dd;
  --discard-bg:#fbe0e0;--discard-border:#e2a3a3;
  --wait-bg:#faedd0;--wait-border:#e0bf78;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text)}
body{display:flex;flex-direction:column;overflow:hidden}
button,input,textarea,select{font:inherit}
select{color-scheme:inherit}
button{color:inherit}
header{min-height:74px;padding:12px 20px;display:flex;align-items:center;gap:16px;background:var(--surface);border-bottom:1px solid var(--border)}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand-mark{width:42px;height:42px;display:grid;place-items:center;background:var(--green);color:#fff;font-size:20px;font-weight:800;border-radius:7px;flex:none}
h1{font-size:21px;line-height:1.15;margin:0;font-weight:700}
.subtitle{margin-top:4px;color:var(--muted);font-size:13px}
.heading-edit-btn{flex:none;width:34px;height:34px;min-height:0;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
.heading-edit-btn:hover{color:var(--text);filter:brightness(1.14)}
#heading-form{display:flex;flex-direction:column;gap:6px}
#heading-form input{background:var(--surface-2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:5px 9px;min-height:0}
#heading-title-input{font-size:18px;font-weight:700;width:min(360px,60vw)}
#heading-subtitle-input{font-size:12.5px;width:min(420px,70vw)}
.heading-form-actions{display:flex;gap:6px;margin-top:2px}
.heading-form-actions button{min-height:30px;padding:0 10px;font-size:12px;border:1px solid var(--border);border-radius:6px;background:var(--surface-2);color:var(--text);cursor:pointer}
.heading-form-actions button:hover{filter:brightness(1.14)}
.header-meta{margin-left:auto;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
.header-button,.action-button{min-height:48px;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;text-decoration:none;cursor:pointer;font-weight:650;white-space:nowrap}
.header-button:hover,.action-button:hover{filter:brightness(1.14)}
.header-button:focus-visible,.action-button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
main{min-height:0;flex:1;display:flex;flex-direction:column;padding:14px 18px 18px;gap:10px;overflow:auto}
.toolbar{min-height:40px;flex:none;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
#load-state{margin-left:auto}
.legend{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}
.legend-dot.fault{background:var(--type-fault)}.legend-dot.ticket{background:var(--type-ticket)}.legend-dot.maintenance{background:var(--type-maintenance)}.legend-dot.task{background:var(--type-task)}.legend-dot.overdue{background:var(--overdue)}

/* ── Zeitstrahl (frappe-gantt, wie im User-Dashboard) ── */
#timeline-card{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:12px}
#timeline-card-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:8px}
#dash-gantt-target{overflow-x:auto}
#dash-gantt-empty{display:none;font-size:12px;color:var(--muted);padding:20px;text-align:center}
.gantt-container{background:transparent}
.gantt .grid-background{fill:none}
.gantt .grid-header{fill:var(--surface);stroke:var(--border)}
.gantt .grid-row{fill:var(--surface)}
.gantt .grid-row:nth-child(even){fill:var(--surface-2)}
.gantt .row-line{stroke:var(--border)}
.gantt .tick{stroke:var(--border)}
.gantt .tick.thick{stroke:var(--border)}
.gantt .today-highlight{fill:var(--accent);opacity:.14}
.gantt .arrow{stroke:var(--muted)}
.gantt .bar-label{fill:#fff}
.gantt .bar-label.big{fill:var(--text)}
.gantt .upper-text{fill:var(--muted)}
.gantt .lower-text{fill:var(--text)}
.gantt-container .popup-wrapper{background:var(--surface-2);border:1px solid var(--border);box-shadow:0 8px 24px rgba(0,0,0,.35)}
.gantt-container .popup-wrapper .title{border-bottom:2px solid var(--accent);color:var(--text)}
.gantt-container .popup-wrapper .subtitle{color:var(--muted)}
.gantt-container .popup-wrapper .pointer{border-top-color:var(--surface-2)}
.gantt .bar-wrapper.gantt-selected .bar{filter:drop-shadow(0 0 4px var(--focus))}

/* ── Anzeige-Auswahl je Ansicht (Tabelle, Zeitstrahl) ── */
.view-card{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:12px}
.view-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.view-count{margin-left:auto;font-size:12px;color:var(--muted)}
.view-filter{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.view-chip{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 11px;border-radius:16px;border:1px solid var(--border);background:var(--surface-2);color:var(--muted);font-size:12px;font-family:inherit;cursor:pointer}
.view-chip[aria-pressed="true"]{color:var(--text);border-color:var(--focus);font-weight:650}
.view-chip .legend-dot{margin:0}
.view-chip[aria-pressed="false"] .legend-dot{opacity:.35}
.view-sep{width:1px;align-self:stretch;background:var(--border);margin:0 2px}
#timeline-card-head .view-filter{flex-basis:100%}

/* ── Tabelle ── */
#entries-table-wrap{border:1px solid var(--border);border-radius:7px;background:var(--surface);overflow:auto;max-height:340px}
#entries-table{width:100%;border-collapse:collapse;font-size:13px}
#entries-table th,#entries-table td{padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap}
#entries-table th{position:sticky;top:0;background:var(--surface-2);color:var(--muted);font-weight:700;font-size:12px}
#entries-table tbody tr{cursor:pointer}
#entries-table tbody tr.alt{background:var(--surface-2)}
#entries-table-wrap.expanded{max-height:none}
#entries-table tbody tr.detail{cursor:default;background:var(--surface)}
#entries-table tbody tr.detail:hover{background:var(--surface)}
#entries-table td.detail-cell{white-space:normal;padding:0 10px 12px;border-bottom:2px solid var(--focus)}
#entries-table td.detail-cell #edit-panel{border-color:var(--focus);border-top:0;border-radius:0 0 7px 7px}
#entries-table tbody tr:not(.detail):hover{background:color-mix(in srgb,var(--surface-2) 80%,var(--focus) 20%)}
#entries-table tbody tr.selected{background:var(--surface-2);outline:2px solid var(--focus);outline-offset:-2px}
#entries-table td.overdue{color:var(--overdue);font-weight:700}

/* ── Bearbeitungsfenster (unterhalb) ── */
#edit-panel{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:16px 18px 18px;display:grid;gap:13px}
.edit-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.edit-panel-head h2{font-size:17px;margin:0}
.edit-actions{display:flex;gap:8px;flex-wrap:wrap}
.edit-actions .action-button{min-width:110px}
.accept{background:var(--accept-bg);border-color:var(--accept-border)}.finish{background:var(--finish-bg);border-color:var(--finish-border)}.discard{background:var(--discard-bg);border-color:var(--discard-border)}.wait{background:var(--wait-bg);border-color:var(--wait-border)}
#action-form,#create-form{display:grid;gap:13px;border-top:1px solid var(--border);padding-top:13px}
#action-form label,#create-form label{display:grid;gap:6px;font-size:13px;font-weight:650}
#action-form input,#action-form textarea,#action-form select,#create-form input,#create-form textarea,#create-form select{width:100%;min-height:48px;padding:10px 11px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text)}
#action-form textarea,#create-form textarea{min-height:96px;resize:vertical}
.required-hint{color:var(--muted);font-weight:400;font-size:12px}
.form-actions{display:flex;justify-content:flex-end;gap:8px}
.form-actions .action-button{min-width:110px}

/* ── Touch-Felder zum Anlegen ── */
#create-tiles{flex:none;display:flex;gap:10px;flex-wrap:wrap}
.create-tile{flex:1;min-width:150px;min-height:64px;display:flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);cursor:pointer;font-size:14px;font-weight:650}
.create-tile:hover{filter:brightness(1.12)}
.create-tile-icon{font-size:22px}
.create-tile.fault{border-color:var(--type-fault);color:var(--type-fault-fg,var(--text))}
.create-tile.ticket{border-color:var(--type-ticket)}
.create-tile.task{border-color:var(--type-task)}
.create-tile.maintenance{border-color:var(--type-maintenance)}
#create-panel{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:16px 18px 18px;display:grid;gap:13px}
.kind{display:inline-flex;padding:5px 7px;border-radius:5px;background:var(--type-fault-bg);color:var(--type-fault-fg);font-weight:700;font-size:12px}
.kind.ticket{background:var(--type-ticket-bg);color:var(--type-ticket-fg)}.kind.maintenance{background:var(--type-maintenance-bg);color:var(--type-maintenance-fg)}.kind.task{background:var(--type-task-bg);color:var(--type-task-fg)}
.item-sub{font-size:12px;color:var(--muted);margin-top:5px}
.empty,.error{padding:30px;text-align:center;color:var(--muted)}
.hidden{display:none!important}
/* ── Karte scannen zum Öffnen (ohne Anmeldung) ── */
#open-rfid{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:650;display:flex;align-items:center;justify-content:center;padding:16px}
#open-rfid form{background:var(--surface);border:1px solid var(--border);border-radius:12px;width:min(440px,100%);padding:18px;display:grid;gap:12px}
#open-rfid h2{font-size:17px;margin:0}
#open-rfid input{width:100%;min-height:48px;padding:10px 11px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text)}
#open-rfid-error{color:var(--overdue);font-size:13px;margin:0;min-height:18px}
@media(max-width:1050px){main{padding:10px}header{padding:10px 12px}.action-button{font-size:12px;padding:0 8px}}
@media(max-width:760px){header{min-height:64px}.brand-mark{width:38px;height:38px}h1{font-size:18px}.subtitle,#updated-at{display:none}.header-meta{gap:6px}.header-button{min-height:46px;padding:0 10px;font-size:12px}main{padding:8px}.toolbar{min-height:32px}}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="brand-mark">P</div>
    <div id="heading-view"><h1 id="heading-title">{{.Title}}</h1><div class="subtitle" id="heading-subtitle">{{if .Subtitle}}{{.Subtitle}}{{end}}</div></div>
    {{if .CanEditHeading}}
    <form id="heading-form" class="hidden">
      <input id="heading-title-input" name="title" maxlength="120" required value="{{.Title}}" placeholder="Überschrift">
      <input id="heading-subtitle-input" name="subtitle" maxlength="200" value="{{.Subtitle}}" placeholder="Untertitel (optional)">
      <div class="heading-form-actions">
        <button type="submit">Speichern</button>
        <button type="button" id="heading-cancel">Abbrechen</button>
      </div>
    </form>
    <button type="button" class="heading-edit-btn" id="heading-edit-btn" title="Überschrift bearbeiten" aria-label="Überschrift bearbeiten">✎</button>
    {{end}}
  </div>
  <div class="header-meta"><span id="updated-at">Wird geladen</span>
    <button class="header-button" type="button" id="theme-toggle" onclick="cycleThemeMode()" title="Darstellung wechseln" aria-label="Darstellung wechseln"><span aria-hidden="true" id="theme-toggle-icon">🖥️</span> <span id="theme-toggle-label">System</span></button>
    <button class="header-button" type="button" id="fullscreen-button" title="Vollbild umschalten"><span aria-hidden="true">⛶</span> Vollbild</button>
    {{if .CanChat}}<a class="header-button" href="/chat" title="Chat öffnen"><span aria-hidden="true">💬</span> Chat</a>{{end}}
    {{if .LoggedIn}}
    <a class="header-button" href="/" title="Zurück zum normalen PDH-Modus"><span aria-hidden="true">↩</span> Zur Startseite</a>
    {{else}}
    <a class="header-button" href="/login" title="In den normalen PDH-Modus wechseln"><span aria-hidden="true">↪</span> Anmelden</a>
    {{end}}
  </div>
</header>
<main>
  <div class="toolbar">
    <strong>Offene Vorgänge</strong><span id="item-count">0 Einträge</span>
    <span class="legend">
      <span><span class="legend-dot fault"></span>Störung</span>
      <span><span class="legend-dot ticket"></span>Ticket</span>
      <span><span class="legend-dot maintenance"></span>Wartung</span>
      <span><span class="legend-dot task"></span>Aufgabe</span>
      <span><span class="legend-dot overdue"></span>Überfällig</span>
    </span>
    <span id="load-state" role="status" aria-live="polite"></span>
  </div>

  <div id="create-tiles">
    <button type="button" class="create-tile fault" data-type="fault"><span class="create-tile-icon" aria-hidden="true">⚠</span><span>Neue Störung</span></button>
    <button type="button" class="create-tile ticket" data-type="ticket"><span class="create-tile-icon" aria-hidden="true">🎫</span><span>Neues Ticket</span></button>
    {{if .CanCreatePrivileged}}
    <button type="button" class="create-tile task" data-type="task"><span class="create-tile-icon" aria-hidden="true">✓</span><span>Neue Aufgabe</span></button>
    <button type="button" class="create-tile maintenance" data-type="maintenance"><span class="create-tile-icon" aria-hidden="true">🔧</span><span>Neue Wartung</span></button>
    {{end}}
  </div>

  <div id="maintenance-select-panel" class="hidden">
    <div class="edit-panel-head">
      <h2 style="font-size:17px;margin:0">Wartungen</h2>
      <button type="button" class="header-button" id="maintenance-select-close">Schließen</button>
    </div>
    <div id="maintenance-select-list" style="display:grid;gap:8px"></div>
    <div class="form-actions">
      <button type="button" class="action-button finish" id="maintenance-select-new">+ Neue Wartung anlegen</button>
    </div>
  </div>

  <div id="entries-card" class="view-card">
    <div class="view-head">
      <strong>Tabelle</strong>
      <div class="view-filter" id="table-filter" role="group" aria-label="Was in der Tabelle angezeigt wird"></div>
      <span class="view-count" id="table-count"></span>
    </div>
    <div id="entries-table-wrap">
      <table id="entries-table">
        <thead>
          <tr><th>Art</th><th>Titel</th><th>Priorität</th><th>Fällig</th><th>Ersteller</th><th>Zuständig</th><th>Status</th></tr>
        </thead>
        <tbody id="entries-table-body"></tbody>
      </table>
      <div id="entries-empty" class="empty hidden">Keine offenen Vorgänge vorhanden.</div>
    </div>
  </div>

  <div id="timeline-card">
    <div id="timeline-card-head">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <strong>Zeitstrahl</strong>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)">Heute ±
          <select id="dash-gantt-range" title="Anzeigebereich: Tage vor und nach heute" style="min-height:0;padding:3px 6px;border-radius:6px;border:1px solid var(--border);background:var(--surface-2);color:var(--text)">
            <option value="7">7 Tage</option>
            <option value="14">14 Tage</option>
            <option value="30" selected>30 Tage</option>
            <option value="60">60 Tage</option>
            <option value="90">90 Tage</option>
            <option value="180">180 Tage</option>
          </select>
        </label>
        <span id="dash-gantt-hidden-note" style="font-size:11px;color:var(--muted)"></span>
      </div>
      <div class="view-filter" id="gantt-filter" role="group" aria-label="Was im Zeitstrahl angezeigt wird"></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--muted)">
        <span><i class="ti ti-square-filled" style="color:var(--type-fault)"></i> Störungen</span>
        <span><i class="ti ti-square-filled" style="color:var(--type-ticket)"></i> Tickets</span>
        <span><i class="ti ti-square-filled" style="color:var(--type-maintenance)"></i> Wartung</span>
        <span><i class="ti ti-square-filled" style="color:var(--type-task)"></i> Aufgaben</span>
        <span><i class="ti ti-square-filled" style="color:var(--overdue)"></i> Überfällig</span>
        <span style="opacity:.5"><i class="ti ti-square-filled"></i> ausgeblasst = kein Termin, +30 Tage geschätzt</span>
      </div>
    </div>
    <div id="dash-gantt-target"></div>
    {{template "timeline-legend"}}
    <div id="dash-gantt-empty">Keine Einträge mit Terminen vorhanden.</div>
  </div>


  <div id="edit-panel-home"></div>
  <div id="edit-panel" class="hidden">
    <div class="edit-panel-head">
      <div>
        <span id="edit-kind" class="kind"></span>
        <strong id="edit-title" style="font-size:15px"></strong>
        <div class="item-sub" id="edit-meta"></div>
        <p class="item-sub hidden" id="edit-description" style="white-space:pre-wrap"></p>
      </div>
      <button type="button" class="header-button" id="edit-close">Schließen</button>
    </div>
    <div class="edit-actions" id="edit-action-buttons">
      <button type="button" class="action-button" id="edit-info-button" hidden>ℹ Info</button>
      <button type="button" class="action-button accept" data-action="accept">Annehmen</button>
      <button type="button" class="action-button finish" data-action="done">Fertig</button>
      {{if .CanDiscard}}<button type="button" class="action-button discard" data-action="discard">Verwerfen</button>{{end}}
      <button type="button" class="action-button wait" data-action="wait">Warten</button>
    </div>
    <form id="action-form" class="hidden">
      <p id="dialog-item" class="item-sub" style="margin:0"></p>
      <label id="worker-field" class="hidden">Zuständiger Mitarbeiter <span class="required-hint">Pflichtfeld · aktuell jeder Mitarbeiter wählbar</span>
        <select id="assigned-to" name="assigned_to" required><option value="">Mitarbeiter auswählen …</option></select>
      </label>
      <label id="date-field" class="hidden">Wiedervorlage am <span class="required-hint">Pflichtfeld</span>
        <input id="follow-up-date" type="date" name="follow_up_date">
      </label>
      <p id="done-hint" class="item-sub hidden" style="margin:0">Karte scannen – danach führt der Abschluss-Assistent Schritt für Schritt durch die Fertigmeldung: Material, Zeit, wer dabei war, Kommentar.</p>
      <label id="comment-field">Kommentar <span class="required-hint">Pflichtfeld, mindestens 8 Zeichen</span>
        <textarea id="comment" name="comment" minlength="8" maxlength="1000" required placeholder="Was wurde entschieden oder erledigt?"></textarea>
      </label>
      <label id="parts-field" class="hidden" style="display:flex;align-items:center;gap:10px">
        <input id="no-parts" type="checkbox" name="no_parts_needed" style="width:22px;min-height:22px">
        Keine Ersatzteile benötigt
      </label>
      <label>RFID-Karte zur Bestätigung <span class="required-hint">Pflichtfeld</span>
        <input id="rfid-uid" name="rfid_uid" type="password" autocomplete="off" required placeholder="Karte scannen">
      </label>
      <div class="form-actions">
        <button class="action-button" type="button" id="cancel-action">Abbrechen</button>
        <button class="action-button finish" type="submit" id="submit-action">Bestätigen</button>
      </div>
    </form>
  </div>
</main>

<!-- Öffnen ohne Anmeldung: Karte scannen → kurzer Zugang, keine dauerhafte Anmeldung -->
<div id="open-rfid" class="hidden" role="dialog" aria-modal="true" aria-labelledby="open-rfid-title">
  <form id="open-rfid-form" autocomplete="off">
    <h2 id="open-rfid-title">Karte scannen zum Öffnen</h2>
    <p class="item-sub" id="open-rfid-target" style="margin:0"></p>
    <p class="item-sub" style="margin:0">Du wirst nur kurz angemeldet: Der Zugang endet bei Inaktivität, mit „Zurück zum Leitstand“ oder sobald der Leitstand wieder geöffnet wird.</p>
    <input id="open-rfid-uid" type="password" autocomplete="off" required placeholder="Karte scannen" aria-label="RFID-Karte">
    <p id="open-rfid-error" role="alert"></p>
    <div class="form-actions">
      <button class="action-button" type="button" id="open-rfid-cancel">Abbrechen</button>
      <button class="action-button finish" type="submit" id="open-rfid-submit">Öffnen</button>
    </div>
  </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>
<script>
(function(){
  const THEME_MODES = ['system','light','dark'];
  const THEME_META = {system:{label:'System',icon:'🖥️'},light:{label:'Hell',icon:'☀️'},dark:{label:'Dunkel',icon:'🌙'}};
  function resolveTheme(mode){
    if(mode === 'light' || mode === 'dark') return mode;
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function applyThemeMode(mode){
    const selected = THEME_MODES.includes(mode) ? mode : 'system';
    localStorage.setItem('pdh_theme', selected);
    document.documentElement.dataset.themeMode = selected;
    document.documentElement.dataset.theme = resolveTheme(selected);
    const meta = THEME_META[selected];
    const icon = document.getElementById('theme-toggle-icon');
    const label = document.getElementById('theme-toggle-label');
    const btn = document.getElementById('theme-toggle');
    if(icon) icon.textContent = meta.icon;
    if(label) label.textContent = meta.label;
    if(btn) btn.title = 'Darstellung: ' + meta.label;
  }
  window.cycleThemeMode = function(){
    const current = localStorage.getItem('pdh_theme') || 'system';
    const index = THEME_MODES.indexOf(current);
    applyThemeMode(THEME_MODES[(index + 1) % THEME_MODES.length]);
  };
  applyThemeMode(localStorage.getItem('pdh_theme') || 'system');
  if(window.matchMedia){
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(){
      if((localStorage.getItem('pdh_theme') || 'system') === 'system') applyThemeMode('system');
    });
  }
})();

(function(){
  const editPanel = document.getElementById('edit-panel');
  const editActions = document.getElementById('edit-action-buttons');
  const form = document.getElementById('action-form');
  const workerField = document.getElementById('worker-field');
  const dateField = document.getElementById('date-field');
  const partsField = document.getElementById('parts-field');
  const workerSelect = document.getElementById('assigned-to');
  const dateInput = document.getElementById('follow-up-date');
  const commentInput = document.getElementById('comment');
  const rfidInput = document.getElementById('rfid-uid');
  const loadState = document.getElementById('load-state');

  // ── Öffnen: angemeldet direkt, sonst erst RFID-Karte (Kurzzugang, /global/open)
  const LOGGED_IN = {{if .LoggedIn}}true{{else}}false{{end}};
  const openRfid = document.getElementById('open-rfid');
  const openRfidUid = document.getElementById('open-rfid-uid');
  const openRfidError = document.getElementById('open-rfid-error');
  let openTarget = '';
  function openPage(url, label){
    if(!url) return;
    if(LOGGED_IN){ window.location = url; return; }
    openTarget = url;
    document.getElementById('open-rfid-target').textContent = label || '';
    openRfidError.textContent = '';
    openRfidUid.value = '';
    openRfid.classList.remove('hidden');
    openRfidUid.focus();
  }
  function closeOpenRfid(){ openRfid.classList.add('hidden'); openRfidUid.value = ''; openTarget = ''; }
  document.getElementById('open-rfid-cancel').addEventListener('click', closeOpenRfid);
  openRfid.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeOpenRfid(); });
  document.getElementById('open-rfid-form').addEventListener('submit', async function(e){
    e.preventDefault();
    const uid = openRfidUid.value.trim();
    if(!uid){ openRfidError.textContent = 'Bitte RFID-Karte scannen.'; return; }
    const submit = document.getElementById('open-rfid-submit');
    submit.disabled = true; openRfidError.textContent = '';
    try{
      const res = await fetch('/global/open', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({rfid_uid: uid, next: openTarget})});
      const json = await res.json().catch(function(){ return {}; });
      if(!res.ok) throw new Error(json.error || 'Öffnen fehlgeschlagen');
      window.location = json.url || openTarget;
    }catch(err){
      openRfidError.textContent = err.message;
      openRfidUid.value = ''; openRfidUid.focus();
    }finally{ submit.disabled = false; }
  });
  const actionNames = {accept:'Annehmen',done:'Fertig',discard:'Verwerfen',wait:'Warten'};
  let current = null; // {item, action}
  let selectedKey = null; // type_key:id
  let latestData = {items:[], workers:[], gantt_items:[]};

  function todayMidnight(){ const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
  function parseISODate(s){
    const parts = String(s || '').split('-').map(Number);
    if(parts.length !== 3 || parts.some(isNaN)) return null;
    return new Date(parts[0], parts[1]-1, parts[2]);
  }
  function fmtDisplayDate(d){ return String(d.getDate()).padStart(2,'0') + '.' + String(d.getMonth()+1).padStart(2,'0') + '.' + d.getFullYear(); }

  function itemKey(item){ return item.type_key + ':' + item.id; }

  function fillSelect(select, options, placeholder){
    if(!select) return;
    const previous = select.value;
    select.replaceChildren(new Option(placeholder, ''));
    (options || []).forEach(function(opt){ select.add(new Option(opt.name, opt.id)); });
    select.value = previous;
  }
  function setOptions(options){
    fillSelect(workerSelect, options, 'Mitarbeiter auswählen …');
  }

  // ── Zeitstrahl: frappe-gantt, identisch zum Dashboard der angemeldeten
  // Nutzer (dashboard.gohtml) - inklusive Drag-to-Reschedule und
  // Überfällig-/Bald-fällig-Einfärbung. Anders als dort liefert der
  // Leitstand seine Daten per periodischem /global/data-Poll statt
  // einmalig beim Seitenaufruf, daher wird der Gantt bei jedem Refresh
  // neu instanziiert statt einmalig aufgebaut.
  let dashGanttItems = [];
  let dashGanttInstance = null;

  // Fuellung = Farbe der Vorgangsart; Rand und Ausgrauen je Zustand kommen aus
  // dem Theming (widgets/timeline_style: pdhTimelineApply)
  function dashGanttColor(t){
    return {fill: t.color, opacity: t.provisional && !t.done ? 0.4 : 1};
  }

  function ganttItemKey(t){ return t.refType + ':' + t.id; }

  // updateDashGanttSelection hebt den zur aktuellen Tabellen-/Panel-
  // Auswahl gehoerenden Balken hervor - eigenstaendig von
  // applyDashGanttStyling, damit ein Auswahlwechsel (Tabelle anklicken)
  // nur die Umrandung aktualisiert statt Event-Listener erneut auf die
  // bestehenden Balken zu haengen.
  function updateDashGanttSelection(){
    dashGanttItems.forEach(function(t){
      const wrapper = document.querySelector('#dash-gantt-target .bar-wrapper[data-id="' + t.id + '"]');
      if(!wrapper) return;
      // Rand der Auswahl kommt aus dem Theming-CSS (.gantt-selected)
      wrapper.classList.toggle('gantt-selected', ganttItemKey(t) === selectedKey);
    });
  }

  function applyDashGanttStyling(){
    dashGanttItems.forEach(function(t){
      const wrapper = document.querySelector('#dash-gantt-target .bar-wrapper[data-id="' + t.id + '"]');
      if(!wrapper) return;
      const colors = dashGanttColor(t);
      const bar = wrapper.querySelector('.bar');
      const barProgress = wrapper.querySelector('.bar-progress');
      if(bar){ bar.style.fill = colors.fill; bar.style.stroke = colors.fill; }
      if(barProgress) barProgress.style.fill = colors.fill;
      const state = pdhTimelineApply(wrapper, t);
      wrapper.style.opacity = colors.opacity;
      wrapper.style.cursor = 'pointer';
      let titleEl = wrapper.querySelector('title');
      const hint = (state ? ' — ' + PDH_TL_LABEL[state] : '') + (t.provisional ? ' — kein Termin, geschätzt (+30 Tage). Klick zum Auswählen, Doppelklick zum Öffnen, Ziehen zum Eintragen eines echten Termins.' : ' — Klick zum Auswählen, Doppelklick zum Öffnen');
      if(!titleEl){
        titleEl = document.createElementNS('http://www.w3.org/2000/svg', 'title');
        wrapper.appendChild(titleEl);
      }
      titleEl.textContent = t.name + hint;

      // Einfacher Klick markiert den Vorgang wie ein Klick in der Tabelle
      // (öffnet das Bearbeitungsfenster); Doppelklick navigiert weiterhin
      // direkt zur Detailseite (wie im normalen Dashboard).
      wrapper.addEventListener('click', function(){
        const item = latestData.items.find(function(it){ return it.type_key === t.refType && it.id === t.id; });
        if(item) selectItem(item);
      });
      wrapper.addEventListener('dblclick', function(e){
        e.preventDefault();
        openPage(t.url, t.name);
      });
    });
    updateDashGanttSelection();
  }

  function formatDateISO(d){
    const year = d.getFullYear();
    const month = String(d.getMonth()+1).padStart(2,'0');
    const day = String(d.getDate()).padStart(2,'0');
    return year + '-' + month + '-' + day;
  }

  async function saveDashGanttDate(item, end){
    const dueStr = formatDateISO(end);
    try{
      const res = await fetch(item.dueEndpoint, {
        method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({due_date: dueStr})
      });
      if(!res.ok){
        let j = null; try{ j = await res.json(); }catch(e){}
        throw new Error((j && j.error) || ('HTTP ' + res.status));
      }
      await refresh();
    }catch(e){
      alert('Termin konnte nicht gespeichert werden: ' + e.message);
      await refresh();
    }
  }

  // Anzeigebereich: heute liegt immer in der Mitte, die Auswahl legt fest,
  // wie viele Tage davor/danach sichtbar sind (pro Browser gemerkt).
  const rangeSelect = document.getElementById('dash-gantt-range');
  const hiddenNote = document.getElementById('dash-gantt-hidden-note');
  function getRangeDays(){ return parseInt(rangeSelect.value, 10) || 30; }
  try{
    const saved = localStorage.getItem('pdh_global_gantt_range');
    if(saved && Array.prototype.some.call(rangeSelect.options, function(o){ return o.value === saved; })) rangeSelect.value = saved;
  }catch(e){}
  rangeSelect.addEventListener('change', function(){
    try{ localStorage.setItem('pdh_global_gantt_range', rangeSelect.value); }catch(e){}
    renderDashGantt();
  });

  function centerDashGanttOnToday(){
    const target = document.getElementById('dash-gantt-target');
    const scroller = target.querySelector('.gantt-container') || target;
    const marker = target.querySelector('.today-highlight');
    if(!marker) return;
    const x = parseFloat(marker.getAttribute('x')) || 0;
    const w = parseFloat(marker.getAttribute('width')) || 0;
    scroller.scrollLeft = Math.max(0, x + w/2 - scroller.clientWidth/2);
  }

  function renderDashGantt(){
    const target = document.getElementById('dash-gantt-target');
    const empty = document.getElementById('dash-gantt-empty');

    const days = getRangeDays();
    const today = todayMidnight();
    const winStart = new Date(today); winStart.setDate(winStart.getDate() - days);
    const winEnd = new Date(today); winEnd.setDate(winEnd.getDate() + days);

    // Nur Vorgänge, die den Bereich berühren; Balken werden zur Anzeige
    // auf den Bereich gekürzt.
    const visible = [];
    let filtered = 0;
    dashGanttItems.forEach(function(t){
      const s = parseISODate(t.start), e = parseISODate(t.end);
      if(!ganttMatch(t.refType, !!(e && e < today && !t.done && !t.provisional), t.unassigned)){ filtered++; return; }
      if(!s || !e || e < winStart || s > winEnd) return;
      visible.push({item:t, start: s < winStart ? winStart : s, end: e > winEnd ? winEnd : e});
    });
    const outside = dashGanttItems.length - filtered - visible.length;
    hiddenNote.textContent = [outside > 0 ? outside + ' außerhalb des Bereichs' : '', filtered > 0 ? filtered + ' ausgeblendet' : ''].filter(Boolean).join(' · ');

    if(!visible.length){
      target.style.display = 'none';
      empty.style.display = 'block';
      empty.textContent = !dashGanttItems.length ? 'Keine Einträge mit Terminen vorhanden.' : (filtered === dashGanttItems.length ? 'Keine Einträge für die gewählte Anzeige.' : 'Keine Einträge im gewählten Zeitbereich.');
      return;
    }
    target.style.display = 'block';
    empty.style.display = 'none';

    const byId = {};
    visible.forEach(function(v){ byId[v.item.id] = v.item; });

    const tasks = pdhTimelineCollect(visible.map(function(v){
      return {id: v.item.id, name: v.item.name, start: formatDateISO(v.start), end: formatDateISO(v.end), progress: v.item.done ? 100 : 0, done: v.item.done};
    }), 'leitstand');
    const viewMode = days <= 14 ? 'Day' : (days <= 90 ? 'Week' : 'Month');
    const axisStart = winStart;
    const axisEnd = new Date(winEnd); axisEnd.setDate(axisEnd.getDate() + 1);

    try{
      target.replaceChildren();
      dashGanttInstance = new Gantt('#dash-gantt-target', tasks, {
        on_date_change: function(task, start, end){
          const item = byId[task.id];
          if(item) saveDashGanttDate(item, end);
        },
        view_mode: viewMode,
        bar_height: PDH_TL.barHeight
      });
      // frappe-gantt leitet die Zeitachse aus den Aufgaben ab; hier wird sie
      // fest auf [heute-N, heute+N] gesetzt, damit heute immer mittig liegt.
      dashGanttInstance.setup_gantt_dates = function(){
        this.gantt_start = new Date(axisStart);
        this.gantt_end = new Date(axisEnd);
      };
      dashGanttInstance.change_view_mode(viewMode);
      centerDashGanttOnToday();
      setTimeout(function(){ applyDashGanttStyling(); pdhTimelineCollectorBind('#dash-gantt-target', 'leitstand', renderDashGantt); centerDashGanttOnToday(); }, 100);
    }catch(e){
      console.warn('Leitstand-Zeitstrahl konnte nicht gerendert werden', e);
      target.style.display = 'none';
      empty.style.display = 'block';
      empty.textContent = 'Zeitstrahl konnte nicht geladen werden.';
    }
  }

  // ── Anzeige-Auswahl: Tabelle und Zeitstrahl haben je eine eigene Auswahl
  // (Vorgangsarten, nur überfällige, nur ohne Zuständigen), im Browser gemerkt.
  const VIEW_TYPES = [['fault','Störungen'],['ticket','Tickets'],['maintenance','Wartung'],['task','Aufgaben']];
  const VIEW_FLAGS = [['overdue','Nur überfällig'],['unassigned','Nur ohne Zuständigen']];
  // withUpcoming: Knopf „Geplante Wartungen“ (Folgeauftraege eines Plans, noch nicht faellig)
  function viewFilter(boxId, storageKey, onChange, withUpcoming){
    const state = {fault:true, ticket:true, maintenance:true, task:true, overdue:false, unassigned:false, upcoming:false};
    try{ Object.assign(state, JSON.parse(localStorage.getItem(storageKey) || '{}')); }catch(e){}
    const box = document.getElementById(boxId);
    function chip(key, label, dotClass){
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'view-chip';
      b.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
      if(dotClass){ const d = document.createElement('span'); d.className = 'legend-dot ' + dotClass; b.appendChild(d); }
      b.appendChild(document.createTextNode(label));
      b.addEventListener('click', function(){
        state[key] = !state[key];
        b.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
        try{ localStorage.setItem(storageKey, JSON.stringify(state)); }catch(e){}
        onChange();
      });
      box.appendChild(b);
    }
    VIEW_TYPES.forEach(function(t){ chip(t[0], t[1], t[0]); });
    const sep = document.createElement('span'); sep.className = 'view-sep'; box.appendChild(sep);
    chip('overdue', VIEW_FLAGS[0][1], 'overdue');
    chip('unassigned', VIEW_FLAGS[1][1], '');
    if(withUpcoming) chip('upcoming', 'Geplante Wartungen', 'maintenance');
    // match(typ, ueberfaellig, ohneZustaendigen, geplant)
    return function(type, overdue, unassigned, upcoming){
      if(state[type] === false) return false;
      if(upcoming && !state.upcoming) return false;
      if(state.overdue && !overdue) return false;
      if(state.unassigned && !unassigned) return false;
      return true;
    };
  }
  const tableMatch = viewFilter('table-filter', 'pdh_global_table_filter', function(){ renderEntriesTable(latestData.items || []); }, true);
  const ganttMatch = viewFilter('gantt-filter', 'pdh_global_gantt_filter', function(){ renderDashGantt(); });

  const entriesBody = document.getElementById('entries-table-body');
  const entriesWrap = document.getElementById('entries-table-wrap');
  const editPanelHome = document.getElementById('edit-panel-home');
  const entriesEmpty = document.getElementById('entries-empty');

  function makeCell(text, className){
    const td = document.createElement('td');
    if(className) td.className = className;
    td.textContent = text;
    return td;
  }

  function renderEntriesTable(all){
    entriesBody.replaceChildren();
    const todayStr = todayMidnight().toISOString().slice(0,10);
    const items = all.filter(function(item){
      return tableMatch(item.type_key, !!(item.due_date && item.due_date < todayStr), !item.assignee, !!item.upcoming);
    });
    document.getElementById('table-count').textContent = items.length === all.length ? '' : (items.length + ' von ' + all.length);
    const sorted = items.slice().sort(function(a, b){
      const da = parseISODate(a.due_date), db = parseISODate(b.due_date);
      if(da && db) return da - db;
      if(da) return -1;
      if(db) return 1;
      return 0;
    });
    // Werkzeuge (Bearbeitungsfenster) erst nach Hause, dann ggf. unter die gewaehlte Zeile
    editPanelHome.after(editPanel);
    let expanded = false;
    sorted.forEach(function(item, index){
      const tr = document.createElement('tr');
      if(index % 2 === 1) tr.classList.add('alt');
      const isSelected = itemKey(item) === selectedKey;
      if(isSelected) tr.classList.add('selected');
      const kindCell = document.createElement('td');
      const kindSpan = document.createElement('span');
      kindSpan.className = 'kind ' + item.type_key;
      kindSpan.textContent = item.type;
      kindCell.appendChild(kindSpan);
      tr.appendChild(kindCell);
      tr.appendChild(makeCell(item.title));
      tr.appendChild(makeCell(item.priority || '—'));
      const overdue = item.due_date && item.due_date < todayStr;
      tr.appendChild(makeCell(item.due_date ? fmtDisplayDate(parseISODate(item.due_date)) : '—', overdue ? 'overdue' : ''));
      tr.appendChild(makeCell(item.creator || '—'));
      tr.appendChild(makeCell(item.assignee || '—'));
      tr.appendChild(makeCell(item.status || '—'));
      tr.setAttribute('aria-expanded', isSelected ? 'true' : 'false');
      tr.addEventListener('click', function(){ if(itemKey(item) === selectedKey) closeEditPanel(); else selectItem(item); });
      entriesBody.appendChild(tr);
      if(isSelected && !editPanel.classList.contains('hidden')){
        const detail = document.createElement('tr');
        detail.className = 'detail';
        const cell = document.createElement('td');
        cell.className = 'detail-cell';
        cell.colSpan = tr.children.length;
        cell.appendChild(editPanel);
        detail.appendChild(cell);
        entriesBody.appendChild(detail);
        expanded = true;
      }
    });
    entriesWrap.classList.toggle('expanded', expanded);
    entriesEmpty.textContent = all.length ? 'Keine Vorgänge für die gewählte Anzeige.' : 'Keine offenen Vorgänge vorhanden.';
    entriesEmpty.classList.toggle('hidden', items.length !== 0);
  }

  // ── Wartungsauswahl: der "Neue Wartung"-Klick oeffnet jetzt zuerst eine
  // Liste der bereits im Wartungsmodul angelegten Wartungen (offen/in
  // Arbeit), markiert die fälligen/überfälligen und startet eine per
  // Klick auf "Start" - Neuanlage bleibt als Sekundäraktion erreichbar.
  const maintenanceSelectPanel = document.getElementById('maintenance-select-panel');
  const maintenanceSelectList = document.getElementById('maintenance-select-list');

  function openMaintenanceSelectPanel(){
    closeCreatePanel();
    closeEditPanel();
    renderMaintenanceSelectList();
    maintenanceSelectPanel.classList.remove('hidden');
    maintenanceSelectPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
  }
  function closeMaintenanceSelectPanel(){
    maintenanceSelectPanel.classList.add('hidden');
  }
  document.getElementById('maintenance-select-close').addEventListener('click', closeMaintenanceSelectPanel);
  document.getElementById('maintenance-select-new').addEventListener('click', function(){
    closeMaintenanceSelectPanel();
    openCreatePanel('maintenance');
  });

  function renderMaintenanceSelectList(){
    maintenanceSelectList.replaceChildren();
    const todayStr = todayMidnight().toISOString().slice(0,10);
    const infraNames = {};
    (latestData.infrastructure || []).forEach(function(i){ infraNames[i.id] = i.name; });
    const items = (latestData.items || []).filter(function(item){ return item.type_key === 'maintenance'; });
    if(!items.length){
      const empty = document.createElement('div');
      empty.style.cssText = 'font-size:12px;color:var(--muted);padding:10px 0';
      empty.textContent = 'Keine Wartungen angelegt.';
      maintenanceSelectList.appendChild(empty);
      return;
    }
    items.slice().sort(function(a, b){
      const da = parseISODate(a.due_date), db = parseISODate(b.due_date);
      if(da && db) return da - db;
      if(da) return -1;
      if(db) return 1;
      return 0;
    }).forEach(function(item){
      const overdue = item.due_date && item.due_date < todayStr;
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid '
        + (overdue ? 'var(--overdue)' : 'var(--border)') + ';border-radius:7px;background:var(--surface)';

      const textBox = document.createElement('div');
      const titleEl = document.createElement('div');
      titleEl.style.fontWeight = '650';
      titleEl.textContent = item.title;
      const metaEl = document.createElement('div');
      metaEl.style.cssText = 'font-size:12px;color:' + (overdue ? 'var(--overdue)' : 'var(--muted)');
      const metaParts = [];
      if(infraNames[item.infrastructure_id]) metaParts.push(infraNames[item.infrastructure_id]);
      metaParts.push(item.due_date ? ('Fällig ' + fmtDisplayDate(parseISODate(item.due_date))) : 'Kein Termin');
      if(overdue) metaParts.push('Überfällig');
      metaEl.textContent = metaParts.join(' · ');
      textBox.appendChild(titleEl);
      textBox.appendChild(metaEl);
      row.appendChild(textBox);

      // Code statt Anzeige vergleichen (status ist das deutsche Wort)
      if(item.status_key === 'open'){
        const startBtn = document.createElement('button');
        startBtn.type = 'button';
        startBtn.className = 'action-button finish';
        startBtn.style.cssText = 'min-width:0;padding:0 14px';
        startBtn.innerHTML = '<i class="ti ti-player-play"></i> Start';
        startBtn.addEventListener('click', function(){ startMaintenance(item.id, startBtn); });
        row.appendChild(startBtn);
      } else {
        const badge = document.createElement('span');
        badge.className = 'kind maintenance';
        badge.textContent = 'In Arbeit';
        row.appendChild(badge);
      }
      maintenanceSelectList.appendChild(row);
    });
  }

  async function startMaintenance(id, button){
    if(button) button.disabled = true;
    try{
      const response = await fetch('/global/maintenance/' + id + '/start', {method: 'POST', credentials: 'same-origin'});
      const result = await response.json().catch(function(){ return {}; });
      if(!response.ok) throw new Error(result.error || 'Wartung konnte nicht gestartet werden');
      await refresh();
      renderMaintenanceSelectList();
    }catch(error){
      alert(error.message);
      if(button) button.disabled = false;
    }
  }

  function selectItem(item, quiet){
    closeCreatePanel();
    closeMaintenanceSelectPanel();
    selectedKey = itemKey(item);
    current = null;
    document.getElementById('edit-kind').textContent = item.type;
    document.getElementById('edit-kind').className = 'kind ' + item.type_key;
    document.getElementById('edit-title').textContent = item.title;
    const metaParts = [item.status];
    if(item.priority) metaParts.push('Priorität ' + item.priority);
    if(item.due_date) metaParts.push('Fällig ' + fmtDisplayDate(parseISODate(item.due_date)));
    if(item.assignee) metaParts.push('Zuständig: ' + item.assignee);
    document.getElementById('edit-meta').textContent = metaParts.join(' · ');
    const descriptionEl = document.getElementById('edit-description');
    descriptionEl.textContent = item.description || '';
    descriptionEl.classList.toggle('hidden', !item.description);
    const infoButton = document.getElementById('edit-info-button');
    infoButton.hidden = false;
    infoButton.textContent = item.infrastructure_id ? 'ℹ Info' : 'ℹ Öffnen';
    infoButton.onclick = function(){
      openPage(item.infrastructure_id ? ('/infrastructure/' + item.infrastructure_id) : item.detail_url, item.title);
    };
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
    editPanel.classList.remove('hidden');
    editPanel.dataset.itemKey = selectedKey;
    editPanel.dataset.item = JSON.stringify(item);
    renderEntriesTable(latestData.items);
    updateDashGanttSelection();
    if(!quiet) editPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
  }

  function closeEditPanel(){
    selectedKey = null;
    current = null;
    editPanel.classList.add('hidden');
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
    delete editPanel.dataset.itemKey;
    renderEntriesTable(latestData.items);
    updateDashGanttSelection();
  }

  editActions.addEventListener('click', function(event){
    const button = event.target.closest('[data-action]');
    if(!button) return;
    const item = JSON.parse(editPanel.dataset.item || 'null');
    if(!item) return;
    openAction(item, button.dataset.action);
  });

  function openAction(item, action){
    current = {item:item, action:action};
    document.getElementById('dialog-item').textContent = actionNames[action] + ' · ' + item.title;
    workerField.classList.toggle('hidden', action !== 'accept');
    workerSelect.required = action === 'accept';
    dateField.classList.toggle('hidden', action !== 'wait');
    dateInput.required = action === 'wait';
    // "Fertig" laeuft ueber den Abschluss-Assistenten: hier nur die Karte
    const guided = action === 'done';
    partsField.classList.add('hidden');
    document.getElementById('comment-field').classList.toggle('hidden', guided);
    document.getElementById('done-hint').classList.toggle('hidden', !guided);
    document.getElementById('submit-action').textContent = guided ? 'Fertigmeldung starten' : actionNames[action];
    form.reset();
    workerSelect.required = action === 'accept';
    dateInput.required = action === 'wait';
    commentInput.required = !guided;
    editActions.classList.add('hidden');
    form.classList.remove('hidden');
    (guided ? rfidInput : commentInput).focus();
  }

  // Fertig: Karte pruefen lassen, dann den Assistenten mit dem Token dieser Person oeffnen
  async function startGuidedDone(item){
    const response = await fetch('/global/complete-start', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify({type:item.type_key, id:item.id, rfid_uid:rfidInput.value.trim()})
    });
    const result = await response.json().catch(function(){return {};});
    if(!response.ok || !result.token) throw new Error(result.error || 'Fertigmeldung konnte nicht gestartet werden');
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
    current = null;
    pdhComplete(item.type_key, item.id, function(){ closeEditPanel(); refresh(); }, {token: result.token, who: result.name});
  }

  document.getElementById('cancel-action').addEventListener('click', function(){
    current = null;
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
  });
  document.getElementById('edit-close').addEventListener('click', closeEditPanel);

  // Anlegen ueber den Erstellungs-Assistenten im Leitstand-Modus: ohne
  // Zuweisung, der Vorgang geht an die Broker (siehe widgets/create_wizard).
  window.PDH_CREATE_BOARD = {
    options: function(){
      return {
        people: latestData.workers || [],
        infra: latestData.infrastructure || [],
        types: {{if .CanCreatePrivileged}}['fault', 'ticket', 'task', 'maintenance']{{else}}['fault', 'ticket']{{end}},
        due_days: {ticket: {{.DefaultDueDaysTicket}}, task: {{.DefaultDueDaysTask}}, maintenance: {{.DefaultDueDaysMaintenance}}}
      };
    },
    onCreated: function(){ refresh(); }
  };
  function openCreatePanel(type){
    closeEditPanel();
    closeMaintenanceSelectPanel();
    pdhCreate(type);
  }
  function closeCreatePanel(){
    const w = document.getElementById('crw');
    if(w && w.classList.contains('open') && window.crwClose) crwClose();
  }
  document.querySelectorAll('#create-tiles [data-type]').forEach(function(tile){
    tile.addEventListener('click', function(){
      if(tile.dataset.type === 'maintenance') openMaintenanceSelectPanel();
      else openCreatePanel(tile.dataset.type);
    });
  });

  function render(data){
    latestData = data;
    setOptions(data.workers || []);
    document.getElementById('item-count').textContent = data.items.length + (data.items.length === 1 ? ' Eintrag' : ' Einträge');
    dashGanttItems = (data.gantt_items || []).map(function(t){
      return {id: t.id, refType: t.ref_type, name: t.title, start: t.start_iso, end: t.end_iso,
        provisional: !!t.is_provisional, done: !!t.is_done, running: !!t.is_running, unassigned: !!t.is_unassigned,
        color: t.color, url: t.detail_url, dueEndpoint: t.due_date_endpoint};
    });
    renderDashGantt();
    renderEntriesTable(data.items);
    if(selectedKey){
      const still = data.items.find(function(item){ return itemKey(item) === selectedKey; });
      // offenes Formular (Kommentar, Karte) beim Aktualisieren stehen lassen
      if(still && current) editPanel.dataset.item = JSON.stringify(still);
      else if(still) selectItem(still, true);
      else closeEditPanel();
    }
  }

  async function refresh(){
    try{
      const response = await fetch('/global/data', {cache:'no-store'});
      if(!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      render(data);
      document.getElementById('updated-at').textContent = 'Stand ' + new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});
      loadState.textContent = '';
    }catch(error){
      loadState.textContent = 'Verbindung fehlgeschlagen · erneuter Versuch folgt';
    }
  }

  form.addEventListener('submit', async function(event){
    event.preventDefault();
    if(!current || !form.reportValidity()) return;
    if(current.action === 'done'){
      const submitDone = document.getElementById('submit-action');
      submitDone.disabled = true;
      try{ await startGuidedDone(current.item); loadState.textContent = ''; }
      catch(error){ loadState.textContent = error.message; }
      finally{ submitDone.disabled = false; rfidInput.value = ''; }
      return;
    }
    const payload = {
      type: current.item.type_key,
      id: current.item.id,
      action: current.action,
      comment: commentInput.value.trim(),
      rfid_uid: rfidInput.value.trim(),
      assigned_to: workerSelect.value,
      follow_up_date: dateInput.value,
      no_parts_needed: document.getElementById('no-parts').checked
    };
    const submit = document.getElementById('submit-action');
    submit.disabled = true;
    try{
      const response = await fetch('/global/actions', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){return {};});
      if(!response.ok) throw new Error(result.error || 'Aktion konnte nicht gespeichert werden');
      closeEditPanel();
      await refresh();
    }catch(error){
      loadState.textContent = error.message;
    }finally{
      submit.disabled = false;
      rfidInput.value = '';
    }
  });

  document.getElementById('fullscreen-button').addEventListener('click', function(){
    if(document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen().catch(function(){});
  });

  const headingEditBtn = document.getElementById('heading-edit-btn');
  if(headingEditBtn){
    const headingView = document.getElementById('heading-view');
    const headingForm = document.getElementById('heading-form');
    const titleInput = document.getElementById('heading-title-input');
    const subtitleInput = document.getElementById('heading-subtitle-input');
    headingEditBtn.addEventListener('click', function(){
      headingView.classList.add('hidden');
      headingEditBtn.classList.add('hidden');
      headingForm.classList.remove('hidden');
      titleInput.focus();
      titleInput.select();
    });
    function closeHeadingForm(){
      headingForm.classList.add('hidden');
      headingView.classList.remove('hidden');
      headingEditBtn.classList.remove('hidden');
    }
    document.getElementById('heading-cancel').addEventListener('click', function(){
      titleInput.value = document.getElementById('heading-title').textContent;
      subtitleInput.value = document.getElementById('heading-subtitle').textContent;
      closeHeadingForm();
    });
    headingForm.addEventListener('submit', async function(event){
      event.preventDefault();
      if(!headingForm.reportValidity()) return;
      try{
        const response = await fetch('/global/settings', {
          method: 'POST', credentials: 'same-origin',
          headers: {'Content-Type': 'application/x-www-form-urlencoded'},
          body: 'title=' + encodeURIComponent(titleInput.value.trim()) + '&subtitle=' + encodeURIComponent(subtitleInput.value.trim())
        });
        if(!response.ok) throw new Error((await response.text()) || ('HTTP ' + response.status));
        document.getElementById('heading-title').textContent = titleInput.value.trim();
        document.getElementById('heading-subtitle').textContent = subtitleInput.value.trim();
        closeHeadingForm();
      }catch(error){
        loadState.textContent = 'Überschrift konnte nicht gespeichert werden: ' + error.message;
      }
    });
  }

  refresh();
  window.setInterval(function(){ if(editPanel.classList.contains('hidden')) refresh(); }, 30000);
})();
</script>
{{template "create-wizard" (dict "Board" true)}}
{{template "completion-wizard"}}
</body>
</html>
