{{/*
Gemeinsame Teile der Seiten Import und Export: Tabelle der Verbindungen und
das Skript zum Bearbeiten, Aktivieren und Loeschen (vorher in beiden Seiten
kopiert).

  {{template "connection-list" (dict "Direction" "import" "Connections" .Connections "CanWrite" .CanWrite "CanExecute" .CanExecute)}}
  {{template "connection-list-js" (dict "Direction" "import")}}

Die Seite liefert davor im eigenen <script>:
  CONN_BOOL_FIELDS     – Ja/Nein-Felder der Konfiguration (Checkboxen)
  connFormSync()       – Umschalter der Formularteile je Typ (MQTT-Modus, Anmeldung …)
  connPageItems(row)   – eigene Eintraege im Kontextmenue (Sniffer, Vorschau …)
*/}}

{{define "connection-list"}}
{{$th := "text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)"}}{{$td := "padding:6px 10px;border-bottom:1px solid var(--border)"}}
{{$d := .}}
<div class="card">
  <div class="card-title">Bestehende Verbindungen · {{len .Connections}}</div>
  {{if .Connections}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="{{css $th}}">Name</th>
        <th style="{{css $th}}">Typ</th>
        <th style="{{css $th}}">Status</th>
        <th style="{{css $th}}">Angelegt von</th>
        <th style="{{css $th}}">Am</th>
      </tr>
    </thead>
    <tbody>
      {{range .Connections}}
      <tr data-conn-id="{{.ID}}" data-conn-kind="{{.Kind}}" data-conn-name="{{.Name}}" {{if $d.CanWrite}}data-conn-config='{{.ConfigJSON}}'{{end}} data-conn-can-write="{{$d.CanWrite}}"{{if eq $d.Direction "import"}} data-conn-broker-integrated="{{.IsIntegratedBroker}}"{{end}}
          {{if or $d.CanWrite $d.CanExecute}}oncontextmenu="showContextMenu(event, connContextItems(this, '{{$d.Direction}}')); return false;"{{end}}>
        <td style="{{css $td}}"><a href="/{{$d.Direction}}/connections/{{.ID}}" style="color:var(--accent);font-weight:600"><i class="ti ti-chevron-right"></i> {{.Name}}</a></td>
        <td style="{{css $td}}">{{.KindLabel}}</td>
        <td style="{{css $td}}">{{if .Enabled}}<span class="badge" style="background:var(--green)">Aktiv</span>{{else}}<span class="badge" style="background:var(--muted)">Deaktiviert</span>{{end}}</td>
        <td style="{{css $td}}">{{.CreatedBy}}</td>
        <td style="{{css $td}}">{{.CreatedAt}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Verbindungen angelegt</div>
  {{end}}
</div>
{{end}}

{{define "connection-list-js"}}
<script>
// Verbindungen bearbeiten/aktivieren/loeschen (widgets/connection_list.gohtml)
const CONN_DIRECTION = {{.Direction}};
function connFormKindChanged(){
  document.querySelectorAll('.kind-fields').forEach(function(el){ el.hidden = true; });
  const kind = document.getElementById('conn-kind').value;
  const target = document.getElementById('fields-' + kind);
  if(target) target.hidden = false;
}
function opcuaAuthModeChanged(){
  const el = document.getElementById('f_opcua_auth_mode');
  if(!el) return;
  document.getElementById('opcua-auth-username').hidden = el.value !== 'username';
}
function connSync(){
  connFormKindChanged();
  if(typeof connFormSync === 'function') connFormSync(); else opcuaAuthModeChanged();
}

function resetConnForm(){
  const form = document.getElementById('conn-form');
  form.reset();
  form.action = '/' + CONN_DIRECTION + '/connections';
  document.getElementById('conn-id').value = '';
  document.getElementById('conn-kind').disabled = false;
  document.getElementById('conn-form-title').textContent = 'Neue Verbindung anlegen';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-plus"></i> Verbindung anlegen';
  document.getElementById('conn-cancel').hidden = true;
  connSync();
}

function fillConnField(kind, field, value, isCheckbox){
  const el = document.querySelector('[name="f_' + kind + '_' + field + '"]');
  if(!el) return;
  if(isCheckbox) el.checked = value === 'true';
  else el.value = value || '';
}

function editConnFromRow(row){
  const form = document.getElementById('conn-form');
  const id = row.dataset.connId;
  const kind = row.dataset.connKind;
  let config = {};
  try{ config = JSON.parse(row.dataset.connConfig || '{}'); }catch(e){}

  form.reset();
  document.getElementById('conn-kind').value = kind;
  document.getElementById('conn-kind').disabled = true;
  connSync();
  document.getElementById('conn-name').value = row.dataset.connName;
  document.getElementById('conn-id').value = id;

  const booleanFields = typeof CONN_BOOL_FIELDS !== 'undefined' ? CONN_BOOL_FIELDS : [];
  Object.keys(config).forEach(function(field){
    fillConnField(kind, field, config[field], booleanFields.indexOf(field) !== -1);
  });
  connSync();

  form.action = form.action.replace(/\/connections.*/, '/connections/' + id + '/edit-web');
  document.getElementById('conn-form-title').textContent = 'Verbindung bearbeiten';
  document.getElementById('conn-submit').innerHTML = '<i class="ti ti-device-floppy"></i> Speichern';
  document.getElementById('conn-cancel').hidden = false;
  form.scrollIntoView({behavior:'smooth', block:'start'});
}

async function toggleConnFromRow(row, direction){
  try{
    const res = await fetch('/' + direction + '/connections/' + row.dataset.connId + '/toggle-web', {method:'POST', credentials:'same-origin'});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    location.reload();
  }catch(e){
    alert('Status konnte nicht geändert werden: ' + e.message);
  }
}

function deleteConnFromRow(row, direction){
  if(!confirm('Verbindung "' + row.dataset.connName + '" wirklich löschen?')) return;
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/' + direction + '/connections/' + row.dataset.connId + '/delete-web';
  document.body.appendChild(form);
  form.submit();
}

function connContextItems(row, direction){
  const canWrite = row.dataset.connCanWrite === 'true';
  const items = [{heading: row.dataset.connName}];
  items.push({label: 'Verbindungsseite öffnen', icon: 'ti-layout-dashboard', onClick: function(){
    window.location = '/' + direction + '/connections/' + row.dataset.connId;
  }});
  if(canWrite){
    items.push({label: 'Bearbeiten', icon: 'ti-edit', onClick: function(){ editConnFromRow(row); }});
    items.push({label: 'Aktivieren/Deaktivieren', icon: 'ti-power', onClick: function(){ toggleConnFromRow(row, direction); }});
  }
  if(typeof connPageItems === 'function') connPageItems(row).forEach(function(it){ items.push(it); });
  if(canWrite){
    items.push({separator: true});
    items.push({label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){ deleteConnFromRow(row, direction); }});
  }
  return items;
}

// Aufruf von der Verbindungsseite: /<richtung>?edit=<id> oeffnet das Formular und kehrt danach dorthin zurueck
(function(){
  const id = new URLSearchParams(location.search).get('edit');
  if(!id) return;
  const run = function(){
    const row = document.querySelector('tr[data-conn-id="' + id + '"]');
    if(!row) return;
    editConnFromRow(row);
    const ret = document.getElementById('conn-return'); if(ret) ret.value = 'detail';
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else setTimeout(run, 0);
})();
if(document.getElementById('conn-form')) connSync();
</script>
{{end}}
