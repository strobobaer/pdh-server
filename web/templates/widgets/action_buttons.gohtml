{{/*
Reusable action button widgets for PDH.

Symbole kommen aus der lokalen Tabler-Bibliothek (/vendor/tabler-icons) über
die Symbol-Tabelle: {{icon "action.<Aktion>"}} – änderbar unter /admin/icons.
*/}}


{{/* früher OpenUI5-Lader (Internet) – bleibt leer, damit alte Aufrufe nicht brechen */}}
{{define "ui5-icon-loader"}}{{end}}

{{define "icon-button"}}
{{template "ui5-icon-loader" .}}
{{- $action := .Action -}}
{{- $label := .Label -}}
{{- $icon := icon (printf "action.%s" $action) -}}
{{- $variant := "btn" -}}
{{- if eq $action "new" -}}{{- if not $label -}}{{- $label = "Neu" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "refresh" -}}{{- if not $label -}}{{- $label = "Aktualisieren" -}}{{- end -}}{{- end -}}
{{- if eq $action "expand" -}}{{- if not $label -}}{{- $label = "Aufklappen" -}}{{- end -}}{{- end -}}
{{- if eq $action "filter" -}}{{- if not $label -}}{{- $label = "Filtern" -}}{{- end -}}{{- end -}}
{{- if eq $action "analyze" -}}{{- if not $label -}}{{- $label = "Analysieren" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "edit" -}}{{- if not $label -}}{{- $label = "Bearbeiten" -}}{{- end -}}{{- end -}}
{{- if eq $action "view" -}}{{- if not $label -}}{{- $label = "Details" -}}{{- end -}}{{- end -}}
{{- if eq $action "copy" -}}{{- if not $label -}}{{- $label = "Kopieren" -}}{{- end -}}{{- end -}}
{{- if eq $action "history" -}}{{- if not $label -}}{{- $label = "Historie" -}}{{- end -}}{{- end -}}
{{- if eq $action "more" -}}{{- if not $label -}}{{- $label = "Mehr" -}}{{- end -}}{{- end -}}
{{- if eq $action "start" -}}{{- if not $label -}}{{- $label = "Starten" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "stop" -}}{{- if not $label -}}{{- $label = "Stoppen" -}}{{- end -}}{{- end -}}
{{- if eq $action "book" -}}{{- if not $label -}}{{- $label = "Buchen" -}}{{- end -}}{{- end -}}
{{- if eq $action "delete" -}}{{- if not $label -}}{{- $label = "Löschen" -}}{{- end -}}{{- $variant = "btn btn-danger" -}}{{- end -}}
{{- if eq $action "delete-mark" -}}{{- if not $label -}}{{- $label = "Löschvormerkung" -}}{{- end -}}{{- $variant = "btn btn-warning" -}}{{- end -}}
{{- if eq $action "activate" -}}{{- if not $label -}}{{- $label = "Aktivieren" -}}{{- end -}}{{- $variant = "btn btn-success" -}}{{- end -}}
{{- if eq $action "deactivate" -}}{{- if not $label -}}{{- $label = "Deaktivieren" -}}{{- end -}}{{- $variant = "btn btn-warning" -}}{{- end -}}
{{- if eq $action "done" -}}{{- if not $label -}}{{- $label = "Erledigen" -}}{{- end -}}{{- $variant = "btn btn-success" -}}{{- end -}}
{{- if eq $action "cancel" -}}{{- if not $label -}}{{- $label = "Abbrechen" -}}{{- end -}}{{- $variant = "btn btn-danger" -}}{{- end -}}
{{- if eq $action "save" -}}{{- if not $label -}}{{- $label = "Speichern" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "back" -}}{{- if not $label -}}{{- $label = "Zurück" -}}{{- end -}}{{- end -}}
{{- if eq $action "send" -}}{{- if not $label -}}{{- $label = "Senden" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- $showInlineLabel := eq $action "filter" -}}
{{- if .Href }}
<a href="{{.Href}}" {{if .ID}}id="{{.ID}}"{{end}} class="{{$variant}} btn-icon {{if $showInlineLabel}}btn-icon-labeled{{end}} {{.Class}}" style="{{css .Style}}" aria-label="{{$label}}" title="{{$label}}"
   {{if .OnClick}}onclick="{{safeJS .OnClick}}"{{else if .Confirm}}onclick="return confirm('{{.Confirm}}')"{{end}}
   {{if .HxGet}}hx-get="{{.HxGet}}"{{end}}
   {{if .HxPost}}hx-post="{{.HxPost}}"{{end}}
   {{if .HxDelete}}hx-delete="{{.HxDelete}}"{{end}}
   {{if .HxTarget}}hx-target="{{.HxTarget}}"{{end}}
   {{if .HxSwap}}hx-swap="{{.HxSwap}}"{{end}}
   {{if .HxTrigger}}hx-trigger="{{.HxTrigger}}"{{end}}
   {{if .HxVals}}hx-vals="{{.HxVals}}"{{end}}
   {{if .HxConfirm}}hx-confirm="{{.HxConfirm}}"{{end}}
   {{if .HxIndicator}}hx-indicator="{{.HxIndicator}}"{{end}}
   {{if .HxOnAfterRequest}}hx-on::after-request="{{safeJS .HxOnAfterRequest}}"{{end}}>
  <i class="ti {{$icon}}" aria-hidden="true"></i>{{if $showInlineLabel}}<span class="btn-icon-label">{{$label}}</span>{{else}}<span class="sr-only">{{$label}}</span>{{end}}
</a>
{{- else }}
<button type="{{if .Type}}{{.Type}}{{else}}button{{end}}" {{if .ID}}id="{{.ID}}"{{end}} class="{{$variant}} btn-icon {{if $showInlineLabel}}btn-icon-labeled{{end}} {{.Class}}" style="{{css .Style}}" aria-label="{{$label}}" title="{{$label}}"
   {{if .Disabled}}disabled{{end}}
   {{if .OnClick}}onclick="{{safeJS .OnClick}}"{{else if .Confirm}}onclick="return confirm('{{.Confirm}}')"{{end}}
   {{if .HxGet}}hx-get="{{.HxGet}}"{{end}}
   {{if .HxPost}}hx-post="{{.HxPost}}"{{end}}
   {{if .HxDelete}}hx-delete="{{.HxDelete}}"{{end}}
   {{if .HxTarget}}hx-target="{{.HxTarget}}"{{end}}
   {{if .HxSwap}}hx-swap="{{.HxSwap}}"{{end}}
   {{if .HxTrigger}}hx-trigger="{{.HxTrigger}}"{{end}}
   {{if .HxVals}}hx-vals="{{.HxVals}}"{{end}}
   {{if .HxConfirm}}hx-confirm="{{.HxConfirm}}"{{end}}
   {{if .HxIndicator}}hx-indicator="{{.HxIndicator}}"{{end}}
   {{if .HxOnAfterRequest}}hx-on::after-request="{{safeJS .HxOnAfterRequest}}"{{end}}>
  <i class="ti {{$icon}}" aria-hidden="true"></i>{{if $showInlineLabel}}<span class="btn-icon-label">{{$label}}</span>{{else}}<span class="sr-only">{{$label}}</span>{{end}}
</button>
{{- end }}
{{end}}

{{define "icon-button-toolbar"}}
{{template "ui5-icon-loader" .}}
<div class="widget-icon-toolbar {{.Class}}" style="{{css .Style}}" {{if .Label}}aria-label="{{.Label}}"{{end}}>
  {{range .Items}}{{template "icon-button" .}}{{end}}
</div>
{{end}}

