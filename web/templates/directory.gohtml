{{template "base" .}}
{{define "content"}}
<style>
.pb-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
.pb-kpi{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:block}
.pb-kpi:hover{border-color:var(--accent)}
.pb-kpi .v{font-size:22px;font-weight:600}
.pb-kpi .l{font-size:11px;color:var(--muted);margin-top:2px}
.pb-filter{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.pb-filter select{width:auto}
.pb-counts{display:flex;gap:10px;font-size:11px;color:var(--muted);white-space:nowrap}
.pb-counts span{display:inline-flex;align-items:center;gap:3px}
.pb-row{cursor:pointer}
.pb-row.inactive{opacity:.5}
.pb-warn{color:var(--amber)}
.pb-bad{color:var(--red)}
.pb-msg{font-size:12px;padding:8px 12px;border-radius:8px;margin-bottom:12px}
@media (max-width:800px){.pb-hide-sm{display:none}}
</style>

<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap">
  <div>
    <h1 style="font-size:19px;font-weight:600">Hersteller & Lieferanten</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">Stammdaten, Ansprechpartner, Portale und Verknüpfungen zu Anlagen, Ersatzteilen, IT und Vorgängen</p>
  </div>
  <div style="display:flex;gap:8px">
    <a class="btn" href="/directory/purchase-report"><i class="ti ti-shopping-cart"></i> Bestellvorschlag</a>
    {{if .CanEdit}}<a class="btn btn-primary" href="/directory/new"><i class="ti ti-plus"></i> Neuer Partner</a>{{end}}
  </div>
</div>

{{if .Message}}<div class="pb-msg" style="background:rgba(16,185,129,.12);color:var(--green)"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="pb-msg" style="background:rgba(239,68,68,.12);color:var(--red)"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

<div class="pb-kpis">
  <a class="pb-kpi" href="/directory"><div class="v">{{.Total}}</div><div class="l">Aktive Partner</div></a>
  <a class="pb-kpi" href="/directory?kind=manufacturer"><div class="v">{{.Manufacturers}}</div><div class="l">Hersteller</div></a>
  <a class="pb-kpi" href="/directory?kind=supplier"><div class="v">{{.Suppliers}}</div><div class="l">Lieferanten</div></a>
  <a class="pb-kpi" href="/directory?status=blocked"><div class="v {{if .Blocked}}pb-bad{{end}}">{{.Blocked}}</div><div class="l">Gesperrt</div></a>
  <a class="pb-kpi" href="/directory?status=contract"><div class="v {{if .ContractsDue}}pb-bad{{else if .ContractsSoon}}pb-warn{{end}}">{{.ContractsSoon}}{{if .ContractsDue}} <span style="font-size:13px">+{{.ContractsDue}} abgel.</span>{{end}}</div><div class="l">Verträge laufen ab (90 Tage)</div></a>
  <div class="pb-kpi"><div class="v {{if .WithoutContacts}}pb-warn{{end}}">{{.WithoutContacts}}</div><div class="l">Ohne Ansprechpartner</div></div>
</div>

{{template "category-filter-slot" (dict "Module" "business_partner")}}
<form class="pb-filter" method="get" action="/directory" id="pb-filter">
  <div class="search-box" style="flex:1;min-width:220px">
    <i class="ti ti-search" style="color:var(--muted)"></i>
    <input type="search" name="q" value="{{.Filter.Query}}" placeholder="Name, Nummer, Ort, Kontakt, Kreditor-/Kundennr. …" style="flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)">
  </div>
  <select name="kind" class="form-input" onchange="this.form.submit()">
    <option value="">Alle Arten</option>
    <option value="manufacturer" {{if eq .Filter.Kind "manufacturer"}}selected{{end}}>Hersteller</option>
    <option value="supplier" {{if eq .Filter.Kind "supplier"}}selected{{end}}>Lieferanten</option>
  </select>
  <select name="status" class="form-input" onchange="this.form.submit()">
    <option value="">Alle aktiven</option>
    <option value="approved" {{if eq .Filter.Status "approved"}}selected{{end}}>Freigegeben</option>
    <option value="conditional" {{if eq .Filter.Status "conditional"}}selected{{end}}>Bedingt freigegeben</option>
    <option value="new" {{if eq .Filter.Status "new"}}selected{{end}}>Neu / in Prüfung</option>
    <option value="blocked" {{if eq .Filter.Status "blocked"}}selected{{end}}>Gesperrt</option>
    <option value="contract" {{if eq .Filter.Status "contract"}}selected{{end}}>Vertrag läuft ab</option>
    <option value="inactive" {{if eq .Filter.Status "inactive"}}selected{{end}}>Deaktiviert</option>
  </select>
  {{if .Categories}}
  <select name="category" class="form-input" onchange="this.form.submit()">
    <option value="">Alle Kategorien</option>
    {{range .Categories}}<option value="{{.}}" {{if eq $.Filter.Category .}}selected{{end}}>{{.}}</option>{{end}}
  </select>
  {{end}}
  <button type="submit" class="btn btn-small"><i class="ti ti-filter"></i> Filtern</button>
  <a class="btn btn-small" href="/directory"><i class="ti ti-filter-off"></i></a>
</form>

<div class="card" style="padding:0;overflow-x:auto">
  <table>
    <thead><tr>
      <th>Partner</th><th>Art / Status</th><th class="pb-hide-sm">Kontakt</th><th class="pb-hide-sm">Vertrag</th><th>Verknüpft</th>
    </tr></thead>
    <tbody>
    {{range .Rows}}
    <tr class="pb-row{{if not .Active}} inactive{{end}}" data-rx data-rx-title="{{.Name}}" data-rx-view="/directory/{{.ID}}"{{if $.CanEdit}} data-rx-edit="/directory/{{.ID}}?tab=master"{{end}}>
      <td>
        <span style="font-weight:500">{{.Name}}</span>{{if .Rating}} <span class="badge b-gray" title="Bewertung">{{.Rating}}</span>{{end}}
        <div style="font-size:11px;color:var(--muted)">{{.PartnerNo}}{{if .ShortName}} · {{.ShortName}}{{end}}{{if .Category}} · {{.Category}}{{end}}{{if .City}} · {{.City}}{{end}}</div>
      </td>
      <td><span class="badge b-blue">{{.KindLabel}}</span> <span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td class="pb-hide-sm" style="font-size:12px">
        {{if .PrimaryContact}}<div>{{.PrimaryContact}}</div>{{end}}
        <div style="color:var(--muted)">{{if .Phone}}<a href="tel:{{.Phone}}">{{.Phone}}</a>{{end}}{{if and .Phone .Email}} · {{end}}{{if .Email}}<a href="mailto:{{.Email}}">{{.Email}}</a>{{end}}</div>
      </td>
      <td class="pb-hide-sm" style="font-size:12px">
        {{if .ContractUntil}}<span class="{{if eq .ContractState "expired"}}pb-bad{{else if eq .ContractState "soon"}}pb-warn{{end}}">{{if eq .ContractState "expired"}}<i class="ti ti-alert-triangle"></i> {{end}}bis {{.ContractUntil}}</span>{{else}}<span style="color:var(--muted)">–</span>{{end}}
      </td>
      <td>
        <div class="pb-counts">
          <span title="Anlagen"><i class="ti ti-hierarchy-2"></i>{{.InfraCount}}</span>
          <span title="Ersatzteile"><i class="ti ti-package"></i>{{.PartCount}}</span>
          <span title="IT-Assets"><i class="ti ti-server-2"></i>{{.ITCount}}</span>
          <span title="Vorgänge"><i class="ti ti-briefcase"></i>{{.RecordCount}}</span>
        </div>
      </td>
    </tr>
    {{else}}
    <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:24px">Keine Partner für diese Auswahl{{if .CanEdit}} – <a href="/directory/new" style="color:var(--accent)">jetzt anlegen</a>{{end}}</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "context-list"}}
{{range .Rows}}{{if eq .ContractState "expired" "soon"}}
<div class="act-item" onclick="window.location='/directory/{{.ID}}'" style="cursor:pointer">
  <div class="act-dot {{if eq .ContractState "expired"}}d-red{{else}}d-amber{{end}}"></div>
  <div class="act-text">{{.Name}} · Vertrag {{.ContractUntil}}</div>
</div>
{{end}}{{end}}
{{end}}

{{define "scripts"}}{{end}}
