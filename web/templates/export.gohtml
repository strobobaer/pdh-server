{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Export</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Verbindungen für PDF-, Excel-, Datenbank- und weitere Exporte verwalten · <a href="/export/templates">Vorlagen verwalten</a> · <a href="/export/mappings">Zuordnungen anzeigen</a></p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if .CanWrite}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title" id="conn-form-title">Neue Verbindung anlegen</div>
  <form id="conn-form" method="POST" action="/export/connections">
    <input type="hidden" name="return_to" id="conn-return" value="">
    <input type="hidden" name="_id" id="conn-id" value="">
    <div class="grid2" style="gap:10px">
      <div class="form-group">
        <label class="form-label">Name</label>
        <input id="conn-name" name="name" class="form-input" maxlength="150" required placeholder="z.B. Monatsbericht">
      </div>
      <div class="form-group">
        <label class="form-label">Typ</label>
        <select id="conn-kind" name="kind" class="form-input" onchange="connFormKindChanged()" required>
          <option value="">– Typ wählen –</option>
          {{range .Kinds}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
        </select>
      </div>
    </div>

    <div class="kind-fields" id="fields-pdf" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Vorlage <span style="color:var(--muted);font-weight:400">(optional)</span></label>
          <select name="f_pdf_template_id" class="form-input">
            <option value="">– Standard –</option>
            {{range .PDFTemplates}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group"><label class="form-label">Zielpfad</label><input name="f_pdf_destination_path" class="form-input" placeholder="Pfad/Freigabe für die PDF-Ausgabe"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_pdf_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Vorlagen (Titel/Ausrichtung) werden unter <a href="/export/templates">Vorlagen verwalten</a> angelegt.</p>
    </div>

    <div class="kind-fields" id="fields-excel" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Vorlage <span style="color:var(--muted);font-weight:400">(optional)</span></label>
          <select name="f_excel_template_id" class="form-input">
            <option value="">– Standard –</option>
            {{range .ExcelTemplates}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group"><label class="form-label">Zielpfad</label><input name="f_excel_destination_path" class="form-input" placeholder="Pfad/Freigabe für die Excel-Ausgabe"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_excel_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Vorlagen (Tabellenblattname) werden unter <a href="/export/templates">Vorlagen verwalten</a> angelegt.</p>
    </div>

    <div class="kind-fields" id="fields-csv" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Zielpfad</label><input name="f_csv_destination_path" class="form-input" placeholder="Pfad/Freigabe für die CSV-Ausgabe"></div>
        <div class="form-group"><label class="form-label">Trennzeichen</label><input name="f_csv_delimiter" class="form-input" placeholder="," maxlength="1"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_csv_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
    </div>

    <div class="kind-fields" id="fields-sqlite" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Dateipfad</label><input name="f_sqlite_file_path" class="form-input" placeholder="Pfad zur .sqlite/.db-Datei"></div>
        <div class="form-group"><label class="form-label">Zieltabelle</label><input name="f_sqlite_table_name" class="form-input" placeholder="z.B. export_log"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_sqlite_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Die Tabelle wird bei Bedarf automatisch angelegt (field_name, value, source, exported_at) - jeder Export hängt neue Zeilen an.</p>
    </div>

    <div class="kind-fields" id="fields-mysql" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Host</label><input name="f_mysql_host" class="form-input"></div>
        <div class="form-group"><label class="form-label">Port</label><input type="number" name="f_mysql_port" class="form-input" value="3306"></div>
        <div class="form-group"><label class="form-label">Datenbank</label><input name="f_mysql_database" class="form-input"></div>
        <div class="form-group"><label class="form-label">Zieltabelle</label><input name="f_mysql_table_name" class="form-input" placeholder="z.B. export_log"></div>
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_mysql_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_mysql_password" class="form-input" autocomplete="new-password"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_mysql_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mysql_use_tls"> TLS-Verschlüsselung</label>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Die Tabelle wird bei Bedarf automatisch angelegt (field_name, value, source, exported_at) - jeder Export hängt neue Zeilen an.</p>
    </div>

    <div class="kind-fields" id="fields-mssql" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Host</label><input name="f_mssql_host" class="form-input"></div>
        <div class="form-group"><label class="form-label">Port</label><input type="number" name="f_mssql_port" class="form-input" value="1433"></div>
        <div class="form-group"><label class="form-label">Datenbank</label><input name="f_mssql_database" class="form-input"></div>
        <div class="form-group"><label class="form-label">Instanzname</label><input name="f_mssql_instance_name" class="form-input" placeholder="optional"></div>
        <div class="form-group"><label class="form-label">Zieltabelle</label><input name="f_mssql_table_name" class="form-input" placeholder="z.B. export_log"></div>
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_mssql_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_mssql_password" class="form-input" autocomplete="new-password"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_mssql_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0 10px"><input type="checkbox" name="f_mssql_use_tls"> TLS-Verschlüsselung</label>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Die Tabelle wird bei Bedarf automatisch angelegt (field_name, value, source, exported_at) - jeder Export hängt neue Zeilen an.</p>
    </div>

    <div class="kind-fields" id="fields-opcua" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Endpunkt-URL</label><input name="f_opcua_endpoint_url" class="form-input" placeholder="opc.tcp://host:4840"></div>
        <div class="form-group"><label class="form-label">Anmeldung</label>
          <select id="f_opcua_auth_mode" name="f_opcua_auth_mode" class="form-input" onchange="opcuaAuthModeChanged()">
            <option value="anonymous">Anonym</option>
            <option value="username">Benutzername/Passwort</option>
          </select>
        </div>
      </div>
      <div id="opcua-auth-username" hidden class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Benutzername</label><input name="f_opcua_username" class="form-input"></div>
        <div class="form-group"><label class="form-label">Passwort</label><input type="password" name="f_opcua_password" class="form-input" autocomplete="new-password"></div>
      </div>
      <div class="form-group" style="max-width:260px"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_opcua_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Schreibt auf bestehende, beschreibbare Knoten (NodeID als Zielfeldname bei der Zuordnung) - nur unverschlüsselte Verbindung (SecurityPolicy "None").</p>
    </div>

    <div class="kind-fields" id="fields-modbus" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Host</label><input name="f_modbus_host" class="form-input"></div>
        <div class="form-group"><label class="form-label">Port</label><input type="number" name="f_modbus_port" class="form-input" value="502"></div>
        <div class="form-group"><label class="form-label">Unit-ID (Slave)</label><input type="number" min="1" max="255" name="f_modbus_unit_id" class="form-input" value="1"></div>
        <div class="form-group"><label class="form-label">Zeitplan (Cron, optional)</label><input name="f_modbus_schedule_cron" class="form-input" placeholder="z.B. 0 6 * * 1"></div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Schreibt auf Coils/Holding Register (Registertyp:Adresse:Datentyp als Zielfeldname bei der Zuordnung).</p>
    </div>

    <div style="display:flex;gap:8px;margin-top:10px">
      <button type="submit" class="btn btn-primary" id="conn-submit"><i class="ti ti-plus"></i> Verbindung anlegen</button>
      <button type="button" class="btn" id="conn-cancel" onclick="resetConnForm()" hidden>Abbrechen</button>
    </div>
  </form>
</div>
{{end}}

{{template "connection-list" (dict "Direction" "export" "Connections" .Connections "CanWrite" .CanWrite "CanExecute" .CanExecute)}}
{{end}}

{{define "scripts"}}
<script>
// Export-spezifisch; Tabelle, Bearbeiten & Co. kommen aus widgets/connection_list.gohtml
const CONN_BOOL_FIELDS = ['use_tls'];
function connPageItems(row){
  const exportableKinds = ['excel', 'csv', 'pdf', 'sqlite', 'mysql', 'mssql', 'opcua', 'modbus'];
  if(exportableKinds.indexOf(row.dataset.connKind) === -1) return [];
  return [{label: 'Vorschau öffnen', icon: 'ti-table', onClick: function(){
    window.location = '/export/connections/' + row.dataset.connId + '/preview';
  }}];
}
</script>
{{template "connection-list-js" (dict "Direction" "export")}}
{{end}}
