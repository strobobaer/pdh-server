{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  {{template "icon-button" (dict "Action" "back" "Href" "/faults")}}
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Fault.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">Erkannt {{.Fault.DetectedAgo}}{{if .Fault.InfraName}} · {{.Fault.InfraName}}{{end}}</p>
  </div>
  <span class="badge {{.Fault.SeverityClass}}" style="font-size:12px;padding:4px 12px">{{.Fault.Severity}}</span>
  <span class="badge {{.Fault.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Fault.StatusLabel}}</span>
  {{template "icon-button" (dict "Action" "done" "ShowLabel" true "Label" "Archivieren" "HxPost" (printf "/records/fault/%s/archive" .Fault.ID) "HxTarget" "#archive-result" "HxOnAfterRequest" "setTimeout(()=>window.location='/faults?status=archive',700)")}}
  <div style="position:relative">
    {{template "icon-button" (dict "Action" "more" "OnClick" "toggleMenu('fault-menu')")}}
    <div id="fault-menu" style="display:none;position:absolute;right:0;top:36px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:6px;min-width:180px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.3)">
      {{if eq .Fault.Status "detected"}}
      {{template "icon-button" (dict "Action" "analyze" "ShowLabel" true "Label" "Copilot analysieren" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "HxPost" (printf "/faults/%s/analyze" .Fault.ID) "HxTarget" "#analyze-result" "OnClick" "closeMenu('fault-menu')")}}
      {{end}}
      {{if eq .Fault.Status "in_progress"}}
      {{template "icon-button" (dict "Action" "done" "ShowLabel" true "Label" "Als gelöst markieren" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "OnClick" "document.getElementById('resolve-form').style.display='block';closeMenu('fault-menu')")}}
      {{end}}
    </div>
  </div>
</div>
<div id="archive-result" style="margin-bottom:10px"></div>

<div class="grid2" style="grid-template-columns:1fr 380px;gap:14px;align-items:start">
  <div>
    <div class="card">
      <div class="card-title">Symptome & Beschreibung</div>
      {{if .Fault.Description}}<p style="font-size:13px;margin-bottom:12px;line-height:1.6">{{.Fault.Description}}</p>{{end}}
      {{if .Fault.Symptoms}}
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        {{range .Fault.Symptoms}}
        <span style="background:var(--bg3);border:1px solid var(--border);padding:3px 10px;border-radius:20px;font-size:12px">{{.}}</span>
        {{end}}
      </div>
      {{end}}
    </div>

    {{if .Analysis}}
    <div class="card">
      <div class="card-title">
        <span><i class="ti ti-brain" style="color:var(--accent)"></i> Copilot-Analyse</span>
        <span style="font-size:11px;color:var(--muted)">Konfidenz: {{printf "%.0f" .Analysis.Confidence}}%</span>
      </div>
      <p style="font-size:13px;margin-bottom:14px;line-height:1.6;color:var(--muted)">{{.Analysis.Summary}}</p>
      {{if .Analysis.PossibleCauses}}
      <div style="margin-bottom:14px">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Mögliche Ursachen</div>
        {{range .Analysis.PossibleCauses}}
        <div class="li"><div class="act-dot d-amber"></div><div class="li-text">{{.}}</div></div>
        {{end}}
      </div>
      {{end}}
      {{if .Analysis.Steps}}
      <div>
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Entstörungsschritte</div>
        {{range .Analysis.Steps}}
        <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0">{{.Order}}</div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:500">{{.Title}}</div>
            <div style="font-size:12px;color:var(--muted);margin-top:2px">{{.Description}}</div>
            {{if .Command}}<code style="display:block;margin-top:6px;background:var(--bg3);padding:4px 8px;border-radius:5px;font-size:11px;color:#6ee7b7">{{.Command}}</code>{{end}}
          </div>
        </div>
        {{end}}
      </div>
      {{end}}
    </div>
    {{else}}
    <div class="card" style="text-align:center;padding:24px">
      <i class="ti ti-brain" style="font-size:32px;color:var(--muted);display:block;margin-bottom:10px"></i>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Noch keine Analyse vorhanden</p>
      {{template "icon-button" (dict "Action" "analyze" "ShowLabel" true "Label" "Copilot analysieren lassen" "HxPost" (printf "/faults/%s/analyze" .Fault.ID) "HxTarget" "#analyze-result")}}
      <span id="analyze-spinner" class="htmx-indicator" style="margin-left:6px">...</span>
      <div id="analyze-result"></div>
    </div>
    {{end}}

    {{if eq .Fault.Status "in_progress"}}
    <div id="resolve-form" style="display:none" class="card">
      <div class="card-title">Störung lösen</div>
      <form hx-post="/faults/{{.Fault.ID}}/resolve" hx-target="#resolve-result">
        <div class="form-group">
          <label class="form-label">Lösung / Maßnahmen</label>
          <textarea name="resolution" class="form-input" rows="3" placeholder="Was wurde gemacht?" required style="resize:vertical"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Grundursache</label>
          <input name="root_cause" class="form-input" placeholder="Warum ist es passiert?">
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer">
            <input type="checkbox" name="no_parts_needed"> Keine Ersatzteile benötigt
          </label>
        </div>
        {{template "icon-button-toolbar" (dict
          "Class" "end"
          "Label" "Störung lösen"
          "Style" "width:100%;justify-content:flex-end"
          "Items" (list
            (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('resolve-form').style.display='none'")
            (dict "Action" "done" "ShowLabel" true "Type" "submit" "Label" "Gelöst")
          )
        )}}
      </form>
      <div id="resolve-result"></div>
    </div>
    {{end}}

    {{if .Fault.Resolution}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div class="card-title"><i class="ti ti-check" style="color:var(--green)"></i> Gelöst</div>
      <p style="font-size:13px;margin-bottom:8px"><strong>Maßnahme:</strong> {{.Fault.Resolution}}</p>
      {{if .Fault.RootCause}}<p style="font-size:13px;color:var(--muted)"><strong>Grundursache:</strong> {{.Fault.RootCause}}</p>{{end}}
    </div>
    {{end}}

    <!-- Durchgeführte Maßnahmen -->
    <div class="card">
      <div class="card-title">Durchgeführte Maßnahmen</div>
      <div id="fault-actions-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      <div style="display:flex;gap:8px">
        <input id="fa-new-action" class="form-input" placeholder="z.B. Sicherung getauscht" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addFaultAction();}">
        <button type="button" class="btn" onclick="addFaultAction()"><i class="ti ti-plus"></i></button>
      </div>
    </div>

    <!-- Ersatzteile: Merkliste (Buchung erst beim Lösen) bzw. gebuchte Teile -->
    <div class="card">
      <div class="card-title">{{if .Fault.Resolution}}Verwendete Ersatzteile{{else}}Ersatzteile für die Reparatur{{end}}</div>
      {{if not .Fault.Resolution}}<p style="font-size:11px;color:var(--muted);margin-bottom:8px">Wird erst beim Lösen der Störung tatsächlich aus dem Lager gebucht.</p>{{end}}
      <div id="fault-parts-usage-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      {{if not .Fault.Resolution}}<button type="button" class="btn" onclick="openFaultPartModal()"><i class="ti ti-package"></i> Ersatzteil vormerken</button>{{end}}
    </div>

    {{if not .Fault.Resolution}}
    <!-- Ersatzteil-vormerken Popup -->
    <div id="fault-part-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:6000;align-items:center;justify-content:center">
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:22px;width:100%;max-width:420px;margin:20px">
        <div style="font-size:15px;font-weight:600;margin-bottom:14px">Ersatzteil vormerken</div>
        <div class="form-group">
          <label class="form-label">Ersatzteil</label>
          <input id="fa-part-search" class="form-input" placeholder="Suchen..." oninput="filterFaultParts()" autocomplete="off">
          <div id="fa-part-results" style="max-height:160px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;margin-top:4px;display:none"></div>
          <input type="hidden" id="fa-part-id">
          <div id="fa-part-selected" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Lagerort</label>
          <select id="fa-part-location" class="form-input"><option value="">Lade Lagerorte...</option></select>
        </div>
        <div class="form-group">
          <label class="form-label">Menge</label>
          <input id="fa-part-qty" type="number" step="0.001" class="form-input" value="1">
        </div>
        <div id="fa-part-error" style="display:none;color:var(--red);font-size:12px;margin-bottom:8px"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
          <button type="button" class="btn" onclick="closeFaultPartModal()">Abbrechen</button>
          <button type="button" class="btn btn-primary" onclick="bookFaultPart()">Vormerken</button>
        </div>
      </div>
    </div>
    {{end}}

    <!-- Anhänge -->
    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos & Dokumente</div>
      <div id="attachments-{{.Fault.ID}}" data-attach-ref="fault:{{.Fault.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-photo"></i>Galerie
          <input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'fault','{{.Fault.ID}}')">
        </label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-camera"></i>Kamera
          <input type="file" accept="image/*" capture="environment" style="display:none" onchange="uploadFiles(this,'fault','{{.Fault.ID}}')">
        </label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-file-upload"></i>Dokument
          <input type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" multiple style="display:none" onchange="uploadFiles(this,'fault','{{.Fault.ID}}')">
        </label>
      </div>
    </div>

    {{template "record-history" .History}}

  </div>

  <!-- Rechte Spalte -->
  <div>
    <div class="card">
      <div class="card-title">Details</div>
      {{if .Fault.RecordImageURL}}
      <img src="{{.Fault.RecordImageURL}}" alt="Datensatzbild" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px;border:1px solid var(--border);margin-bottom:12px">
      {{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Schweregrad</div><div class="li-title"><span class="badge {{.Fault.SeverityClass}}">{{.Fault.Severity}}</span></div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Status</div><div class="li-title"><span class="badge {{.Fault.StatusClass}}">{{.Fault.StatusLabel}}</span></div></div></div>
      <form hx-put="/faults/{{.Fault.ID}}/infrastructure-web" hx-target="#fault-infra-result" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        {{template "infra-tree-picker" (dict "TargetID" "fault-detail-infra-id" "SelectedLabelID" "fault-detail-infra-selected" "Label" "Infrastruktur" "Value" .Fault.InfraID "SelectedLabel" .Fault.InfraName)}}
        <div id="fault-infra-result" style="font-size:12px;margin-bottom:8px"></div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
      <form hx-post="/api/v1/faults/{{.Fault.ID}}/cost-center" hx-swap="none" hx-on::after-request="if(event.detail.successful) location.reload()" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        {{template "cost-center-picker" (dict "Label" "Kostenstelle" "Value" .Fault.CostCenterID)}}
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
      <form hx-put="/records/fault/{{.Fault.ID}}/people" hx-target="#people-result-fault" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div class="form-group">
          <label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input">
            <option value="">Nicht gesetzt</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Fault.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Zugewiesen</label>
          <select name="assigned_to" class="form-input">
            <option value="">Nicht zugewiesen</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Fault.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div id="people-result-fault" style="font-size:12px;margin-bottom:8px"></div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
    </div>

    <div class="card">
      <div class="card-title"><i class="ti ti-brain" style="color:var(--accent)"></i> Copilot Chat</div>
      <div id="chat-messages" style="background:var(--bg3);border-radius:8px;padding:10px;min-height:180px;max-height:320px;overflow-y:auto;margin-bottom:10px;font-size:13px">
        <div style="color:var(--muted);font-style:italic;font-size:12px">Stelle Fragen zur Entstörung...</div>
      </div>
      <form hx-post="/faults/{{.Fault.ID}}/chat-web" hx-target="#chat-messages" hx-swap="beforeend" hx-on::before-request="appendUserMsg(this)" style="display:flex;gap:8px">
        <input name="message" id="chat-input" class="form-input" placeholder="z.B. Was könnte die Ursache sein?" style="font-size:12px" autocomplete="off">
        {{template "icon-button" (dict "Action" "send" "Type" "submit")}}
      </form>
    </div>

    <div class="card">
      <div class="card-title">Zeiterfassung</div>
      {{if .RunningTime}}
      <div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:10px;margin-bottom:10px">
        <div style="font-size:12px;color:var(--green);font-weight:500">⏱ Läuft seit {{.RunningTime.StartedAt.Format "15:04"}}</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px">{{.RunningTime.Description}}</div>
      </div>
      {{template "icon-button" (dict "Action" "stop" "ShowLabel" true "Label" "Zeit stoppen" "Style" "width:100%;justify-content:center" "HxPost" (printf "/time/%s/stop-web" .RunningTime.ID) "HxTarget" "#time-result" "HxOnAfterRequest" "setTimeout(()=>location.reload(),1000)")}}
      {{else}}
      {{template "icon-button" (dict "Action" "start" "ShowLabel" true "Label" "Zeit erfassen starten" "Style" "width:100%;justify-content:center" "HxPost" (printf "/faults/%s/time/start" .Fault.ID) "HxTarget" "#time-result")}}
      {{end}}
      <div id="time-result"></div>
      {{range .TimeEntries}}
      <div class="li">
        <div class="li-text">
          <div class="li-title" style="font-size:12px">{{.Description}}</div>
          <div class="li-sub">{{.UserName}} · {{if .DurationMin}}{{.DurationMin}}min{{else}}läuft...{{end}}</div>
        </div>
      </div>
      {{end}}
    </div>
  </div>
</div>
{{end}}

{{define "context-list"}}
{{range .SimilarFaults}}
<div class="act-item">
  <div class="act-dot d-blue"></div>
  <div class="act-text">{{.Title}}</div>
  <span style="font-size:10px;color:var(--green)">gelöst</span>
</div>
{{end}}
{{end}}

{{block "scripts" .}}
<script>
async function populateCostCenterSelects(){
  const selects = document.querySelectorAll('[data-cost-center-picker]');
  if(selects.length===0) return;
  try{
    const res = await fetch('/api/v1/costcenters', {credentials:'same-origin'});
    const json = await res.json();
    const items = json.data || [];
    selects.forEach(function(sel){
      const selected = sel.dataset.selected || '';
      items.forEach(function(cc){
        const opt = document.createElement('option');
        opt.value = cc.id;
        opt.textContent = cc.number + ' - ' + cc.name;
        if(cc.id === selected) opt.selected = true;
        sel.appendChild(opt);
      });
    });
  }catch(e){ console.warn('Kostenstellen laden fehlgeschlagen', e); }
}
if(document.readyState !== 'loading') populateCostCenterSelects();
else document.addEventListener('DOMContentLoaded', populateCostCenterSelects);

function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){document.getElementById(id).style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id$="-menu"]'))document.querySelectorAll('[id$="-menu"]').forEach(m=>m.style.display='none');});

function appendUserMsg(form) {
  const input = form.querySelector('[name=message]');
  const msg = input.value.trim();
  if(!msg) return;
  const el = document.getElementById('chat-messages');
  el.innerHTML += '<div style="margin-bottom:8px"><div style="font-size:10px;color:var(--muted);margin-bottom:2px">Du</div><div style="color:var(--accent);font-size:12px">'+msg+'</div></div>';
  el.scrollTop = el.scrollHeight;
  input.value = '';
}
document.body.addEventListener('htmx:afterSettle', function() {
  const el = document.getElementById('chat-messages');
  if(el) el.scrollTop = el.scrollHeight;
});

// ── Durchgeführte Maßnahmen + Ersatzteilverwendung ──────────────
const FAULT_ID = '{{.Fault.ID}}';
const FAULT_RESOLVED = {{if .Fault.Resolution}}true{{else}}false{{end}};
let faPartsCache = null;

function escFa(s){return String(s||'').replace(/[&<>'"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'})[c];});}

async function loadFaultActions(){
  const box = document.getElementById('fault-actions-list');
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/actions', {credentials:'same-origin'});
    const json = await res.json();
    const actions = json.data || json || [];
    box.innerHTML = actions.length ? actions.map(function(a){
      const t = new Date(a.created_at);
      const timeStr = t.toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(a.description)+'</div><div class="li-sub">'+timeStr+' · '+escFa(a.created_by_name)+'</div></div></div>';
    }).join('') : '<div style="padding:4px 0">Noch keine Maßnahmen erfasst</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function addFaultAction(){
  const input = document.getElementById('fa-new-action');
  const description = input.value.trim();
  if(!description) return;
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/actions', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({description:description})
    });
    const json = await res.json();
    if(!res.ok) throw new Error(json.error||'Fehler');
    input.value='';
    loadFaultActions();
  }catch(e){ alert('Fehler: '+e.message); }
}

async function loadFaultPartsUsage(){
  const box = document.getElementById('fault-parts-usage-list');
  try{
    if(FAULT_RESOLVED){
      const res = await fetch('/api/v1/faults/'+FAULT_ID+'/parts-usage', {credentials:'same-origin'});
      const json = await res.json();
      const movements = json.data || json || [];
      box.innerHTML = movements.length ? movements.map(function(m){
        return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(m.part_name)+' <span style="color:var(--muted)">('+escFa(m.part_number)+')</span></div><div class="li-sub">'+m.qty+' Stk · '+escFa(m.created_by_name)+'</div></div></div>';
      }).join('') : '<div style="padding:4px 0">Keine Ersatzteile verwendet</div>';
      return;
    }
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts', {credentials:'same-origin'});
    const json = await res.json();
    const pending = json.data || json || [];
    box.innerHTML = pending.length ? pending.map(function(p){
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(p.part_name)+' <span style="color:var(--muted)">('+escFa(p.part_number)+')</span></div><div class="li-sub">'+p.qty+' Stk · '+escFa(p.storage_name)+'</div></div><button type="button" class="btn" style="font-size:11px;color:var(--red)" onclick="removePendingPart(THISID)"><i class="ti ti-x"></i></button></div>'.replace('THISID', "'"+p.id+"'");
    }).join('') : '<div style="padding:4px 0">Noch keine Ersatzteile vorgemerkt</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}

async function removePendingPart(id){
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts/'+id, {method:'DELETE', credentials:'same-origin'});
    const json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    loadFaultPartsUsage();
  }catch(e){ alert('Fehler beim Entfernen: '+e.message); }
}

async function loadFaultPartsCache(){
  if(faPartsCache) return faPartsCache;
  const res = await fetch('/api/v1/inventory/', {credentials:'same-origin'});
  const json = await res.json();
  faPartsCache = json.data || json || [];
  return faPartsCache;
}

async function loadStorageFlatOptions(selectEl){
  try{
    const res = await fetch('/api/v1/storage/', {credentials:'same-origin'});
    const json = await res.json();
    const tree = json.data || json;
    const options = [];
    function walk(nodes, prefix){
      (nodes||[]).forEach(function(n){
        const label = prefix ? prefix+' > '+n.name : n.name;
        options.push({id:n.id, label:label});
        if(n.children && n.children.length) walk(n.children, label);
      });
    }
    walk(Array.isArray(tree) ? tree : (tree.children||[]), '');
    selectEl.innerHTML = '<option value="">Lagerort wählen...</option>' + options.map(function(o){return '<option value="'+o.id+'">'+escFa(o.label)+'</option>';}).join('');
  }catch(e){
    selectEl.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}

function openFaultPartModal(){
  document.getElementById('fault-part-modal').style.display='flex';
  document.getElementById('fa-part-search').value='';
  document.getElementById('fa-part-id').value='';
  document.getElementById('fa-part-selected').textContent='';
  document.getElementById('fa-part-results').style.display='none';
  document.getElementById('fa-part-error').style.display='none';
  document.getElementById('fa-part-qty').value='1';
  loadStorageFlatOptions(document.getElementById('fa-part-location'));
}
function closeFaultPartModal(){ document.getElementById('fault-part-modal').style.display='none'; }

async function filterFaultParts(){
  const q = document.getElementById('fa-part-search').value.trim().toLowerCase();
  const box = document.getElementById('fa-part-results');
  if(!q){ box.style.display='none'; return; }
  const parts = await loadFaultPartsCache();
  const matches = parts.filter(function(p){
    return (p.name||'').toLowerCase().includes(q) || (p.part_number||'').toLowerCase().includes(q);
  }).slice(0,20);
  box.innerHTML = matches.length ? matches.map(function(p){
    return '<div style="padding:6px 8px;cursor:pointer;font-size:12px;border-bottom:1px solid var(--border)" onclick="selectFaultPart(\''+p.id+'\',\''+escFa(p.name).replace(/'/g,"\\'")+'\')">'+escFa(p.name)+' <span style="color:var(--muted)">('+escFa(p.part_number)+')</span></div>';
  }).join('') : '<div style="padding:6px 8px;font-size:12px;color:var(--muted)">Keine Treffer</div>';
  box.style.display='block';
}
function selectFaultPart(id,label){
  document.getElementById('fa-part-id').value=id;
  document.getElementById('fa-part-selected').textContent='Ausgewählt: '+label;
  document.getElementById('fa-part-results').style.display='none';
  document.getElementById('fa-part-search').value='';
}

async function bookFaultPart(){
  const partId = document.getElementById('fa-part-id').value;
  const locationId = document.getElementById('fa-part-location').value;
  const qty = parseFloat(document.getElementById('fa-part-qty').value);
  const errEl = document.getElementById('fa-part-error');
  errEl.style.display='none';
  if(!partId){ errEl.textContent='Bitte ein Ersatzteil auswählen'; errEl.style.display='block'; return; }
  if(!locationId){ errEl.textContent='Bitte einen Lagerort auswählen'; errEl.style.display='block'; return; }
  if(!qty || qty<=0){ errEl.textContent='Bitte eine gültige Menge angeben'; errEl.style.display='block'; return; }
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({part_id:partId, storage_node_id:locationId, qty:qty})
    });
    const json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    closeFaultPartModal();
    loadFaultPartsUsage();
  }catch(e){ errEl.textContent='Fehler: '+e.message; errEl.style.display='block'; }
}

if(document.readyState !== 'loading'){ loadFaultActions(); loadFaultPartsUsage(); }
else document.addEventListener('DOMContentLoaded', function(){ loadFaultActions(); loadFaultPartsUsage(); });
</script>
{{end}}
