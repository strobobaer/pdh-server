{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">IT-Infrastruktur</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Stats.total}} Assets · {{.Stats.active}} aktiv</p>
  </div>
  {{template "icon-button-toolbar" (dict
    "Class" "end"
    "Label" "IT-Aktionen"
    "Items" (list
      (dict "Action" "view" "ShowLabel" true "Label" "QR-Etiketten" "OnClick" "window.open('/a/labels?it_all=1', '_blank')")
      (dict "Action" "new" "ShowLabel" true "Label" "Neues Asset" "OnClick" "document.getElementById('new-asset').style.display='block'")
    )
  )}}
</div>

<div class="stats" style="grid-template-columns:repeat(4,1fr);margin-bottom:18px">
  <div class="stat s-blue"><div class="stat-label">Gesamt</div><div class="stat-val">{{.Stats.total}}</div></div>
  <div class="stat s-green"><div class="stat-label">Aktiv</div><div class="stat-val">{{.Stats.active}}</div></div>
  <div class="stat s-amber"><div class="stat-label">Server</div><div class="stat-val">{{.Stats.servers}}</div></div>
  <div class="stat s-blue"><div class="stat-label">Netzwerk</div><div class="stat-val">{{.Stats.network}}</div></div>
</div>

<div id="new-asset" style="display:none" class="card">
  <div class="card-title">Asset erfassen</div>
  <form hx-post="/it" hx-target="#asset-table tbody" hx-swap="afterbegin">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" required placeholder="z.B. PDH-Server-01"></div>
      <div class="form-group"><label class="form-label">Typ</label>
        <select name="type" class="form-input">
          <option value="server">🖥️ Server</option>
          <option value="network">🌐 Netzwerk</option>
          <option value="workstation">💻 Workstation</option>
          <option value="printer">🖨️ Drucker</option>
          <option value="phone">📱 Telefon/Handy</option>
          <option value="tablet">📟 Tablet</option>
          <option value="other">📦 Sonstiges</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Hostname</label><input name="hostname" class="form-input" placeholder="z.B. pdh-srv-01"></div>
      <div class="form-group"><label class="form-label">IP-Adresse</label><input name="ip_address" class="form-input" placeholder="z.B. 10.10.0.100"></div>
      {{template "directory-picker" (dict "Label" "Hersteller" "TargetID" "it-new-manufacturer-id")}}
      <div class="form-group"><label class="form-label">Modell</label><input name="model" class="form-input"></div>
      <div class="form-group"><label class="form-label">Seriennummer</label><input name="serial_no" class="form-input"></div>
      <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input" placeholder="z.B. Serverraum"></div>
      {{template "infra-tree-picker" (dict "TargetID" "it-infra-id" "SelectedLabelID" "it-infra-selected" "Label" "Infrastruktur")}}
      <div class="form-group"><label class="form-label">Betriebssystem</label><input name="os" class="form-input" placeholder="z.B. Debian 12"></div>
      <div class="form-group"><label class="form-label">Notizen</label><input name="notes" class="form-input"></div>
    </div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Formularaktionen"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-asset').style.display='none'")
        (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Erfassen")
      )
    )}}
  </form>
</div>

<!-- Filter -->
<div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">
  {{if eq .Filter ""}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/it" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/it")}}{{end}}
  {{if eq .Filter "server"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Server" "Href" "/it?type=server" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Server" "Href" "/it?type=server")}}{{end}}
  {{if eq .Filter "network"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Netzwerk" "Href" "/it?type=network" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Netzwerk" "Href" "/it?type=network")}}{{end}}
  {{if eq .Filter "workstation"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Workstation" "Href" "/it?type=workstation" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Workstation" "Href" "/it?type=workstation")}}{{end}}
</div>

<div class="card" style="padding:0">
  <table id="asset-table">
    <thead><tr><th>Asset</th><th>Typ</th><th>IP / Hostname</th><th>Standort</th><th>Status</th></tr></thead>
    <tbody>
    {{range .Assets}}
    <tr data-rx data-rx-title="{{.Name}}" data-rx-view="/it/{{.ID}}" data-rx-edit="/it/{{.ID}}">
      <td>
        <div style="font-weight:500">{{.Name}}</div>
        {{if .InfraName}}<div style="font-size:11px;color:var(--accent)">{{.InfraName}}</div>{{end}}
        <div style="font-size:11px;color:var(--muted)">{{if .Notes}}{{.Notes}}{{else}}{{.Manufacturer}} {{.Model}}{{if .SerialNo}} · {{.SerialNo}}{{end}}{{end}}</div>
      </td>
      <td><i class="ti {{.TypeIcon}}" style="font-size:15px"></i> <span style="font-size:12px;color:var(--muted)">{{.TypeLabel}}</span></td>
      <td style="font-size:12px">
        {{if .IPAddress}}<div style="font-family:monospace">{{.IPAddress}}</div>{{end}}
        {{if .Hostname}}<div style="color:var(--muted);font-size:11px">{{.Hostname}}</div>{{end}}
      </td>
      <td style="font-size:12px;color:var(--muted)">{{.Location}}</td>
      <td id="it-status-{{.ID}}"><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <template class="rx-more">
        <span class="rec-sub">Status:</span>
        <button type="button" class="btn btn-small" hx-post="/it/{{.ID}}/status-web" hx-vals='{"status":"active"}' hx-target="#it-status-{{.ID}}"><i class="ti ti-circle-check"></i> Aktiv</button>
        <button type="button" class="btn btn-small" hx-post="/it/{{.ID}}/status-web" hx-vals='{"status":"maintenance"}' hx-target="#it-status-{{.ID}}"><i class="ti ti-tool"></i> Wartung</button>
        <button type="button" class="btn btn-small" hx-post="/it/{{.ID}}/status-web" hx-vals='{"status":"inactive"}' hx-target="#it-status-{{.ID}}"><i class="ti ti-circle-x"></i> Inaktiv</button>
      </template>
    </tr>
    {{else}}
    <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:32px">Keine Assets vorhanden</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:8px">Übersicht</div>
<div class="act-item"><div class="act-dot d-blue"></div><div class="act-text">Server</div><span>{{.Stats.servers}}</span></div>
<div class="act-item"><div class="act-dot d-green"></div><div class="act-text">Netzwerk</div><span>{{.Stats.network}}</span></div>
{{end}}

{{block "scripts" .}}
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){document.getElementById(id).style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id^="it-"]'))document.querySelectorAll('[id^="it-"]').forEach(m=>{if(m.tagName==='DIV')m.style.display='none';});});
</script>
{{end}}
