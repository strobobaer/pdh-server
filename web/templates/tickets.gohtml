{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Ticketmanagement</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Total}} Tickets · {{.Open}} offen</p>
  </div>
  {{template "icon-button-toolbar" (dict
  "Class" "end"
  "Label" "Ticket-Aktionen"
  "Items" (list
      (dict "Action" "new" "ShowLabel" true "OnClick" "pdhCreate('ticket')")
      (dict "Action" "view" "ShowLabel" true "Label" "Auswahl öffnen" "OnClick" "runSelectedItemAction('view')")
      (dict "Action" "copy" "ShowLabel" true "Label" "Auswahl kopieren" "OnClick" "runSelectedItemAction('copy')")
      (dict "Action" "done" "ShowLabel" true "Label" "Auswahl erledigen" "OnClick" "runSelectedItemAction('done')")
  )
)}}
</div>


{{template "list-tabs" .Tabs}}
{{template "category-filter-slot" (dict "Module" "ticket")}}

<div id="ticket-table" class="card" style="padding:0">
  <table>
    <thead><tr style="cursor:pointer"><th>Ticket</th><th>Priorität</th><th>Status</th><th>Erstellt</th><th>Aktionen</th></tr></thead>
    <tbody>
    {{range .Tickets}}
    <tr class="selectable-item" data-selectable data-title="{{.Title}}" data-view-href="/tickets/{{.ID}}" data-complete="ticket:{{.ID}}" data-copy-text="{{.Title}} {{.Description}}" data-done-url="/tickets/{{.ID}}/status-web" data-done-method="PUT" data-done-body="status=resolved" style="cursor:pointer">
      <td>
        <a href="/tickets/{{.ID}}" style="display:block;color:inherit;text-decoration:none">
          <div style="font-weight:500">{{.Title}}</div>
          {{if .InfraName}}<div style="font-size:11px;color:var(--accent)">{{.InfraName}}</div>{{end}}
          <div style="font-size:11px;color:var(--muted)">{{.Description}}</div>
        </a>
      </td>
      <td><span class="badge {{.PriorityClass}}">{{.Priority}}</span></td>
      <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td style="font-size:11px;color:var(--muted)">{{.CreatedAgo}}</td>
      <td>
        <select name="status" class="form-input" style="font-size:11px;padding:4px 8px;width:auto"
          hx-put="/tickets/{{.ID}}/status-web"
          hx-trigger="change"
          hx-target="closest tr">
          <option value="open" {{if eq .Status "open"}}selected{{end}}>Offen</option>
          <option value="in_progress" {{if eq .Status "in_progress"}}selected{{end}}>In Arbeit</option>
          <option value="resolved" {{if eq .Status "resolved"}}selected{{end}}>Gelöst</option>
          <option value="closed" {{if eq .Status "closed"}}selected{{end}}>Geschlossen</option>
        </select>
      </td>
    </tr>
    {{else}}
    <tr style="cursor:pointer"><td colspan="5" style="text-align:center;color:var(--muted);padding:24px">Keine Tickets vorhanden</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}
{{define "context-list"}}
{{range .CriticalTickets}}
<div class="act-item">
  <div class="act-dot d-red"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge b-red">Krit</span>
</div>
{{end}}
{{end}}

