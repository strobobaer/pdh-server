{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Modbus-Test · {{.ConnectionName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a></p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if not .Applicable}}
<div class="card" role="status">
  Diese Verbindung ist keine Modbus-TCP-Verbindung.
</div>
{{else}}

<div class="card" style="margin-bottom:14px">
  <div class="card-title">Quelle</div>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0">
    <dt style="color:var(--muted)">Host</dt><dd style="margin:0">{{.Host}}</dd>
  </dl>
  {{if .CanWrite}}
  <form method="POST" action="/import/connections/{{.ConnectionID}}/read/refresh" style="margin-top:12px">
    <button type="submit" class="btn btn-primary"><i class="ti ti-refresh"></i> Alle Zuordnungen aktualisieren</button>
  </form>
  {{end}}
</div>

{{if .CanWrite}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Register testweise lesen</div>
  <form method="GET" action="/import/connections/{{.ConnectionID}}/read" id="test-form">
    <div class="grid2" style="gap:10px">
      <div class="form-group">
        <label class="form-label">Registertyp</label>
        <select id="test-register-type" name="register_type" class="form-input" onchange="testRegisterTypeChanged()" required>
          <option value="">– wählen –</option>
          {{range .RegisterTypes}}<option value="{{.Value}}" {{if eq .Value $.TestRegisterType}}selected{{end}}>{{.Label}}</option>{{end}}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Adresse</label>
        <input type="number" min="0" max="65535" id="test-address" name="address" class="form-input" value="{{.TestAddress}}" required>
      </div>
      <div class="form-group" id="test-data-type-field">
        <label class="form-label">Datentyp</label>
        <select id="test-data-type" name="data_type" class="form-input">
          {{range .DataTypes}}<option value="{{.Value}}" {{if eq .Value $.TestDataType}}selected{{end}}>{{.Label}}</option>{{end}}
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="ti ti-plug"></i> Lesen</button>
  </form>

  {{if .TestError}}<p role="alert" style="color:var(--red);font-size:13px;margin-top:12px">{{.TestError}}</p>{{end}}
  {{if .TestResult}}
  <div style="display:flex;align-items:center;gap:10px;margin-top:12px;padding:10px;background:var(--bg3);border-radius:8px">
    <div>
      <div style="font-size:11px;color:var(--muted)">Gelesener Wert</div>
      <div style="font-size:16px;font-family:monospace" id="test-result">{{.TestResult}}</div>
    </div>
    <button type="button" class="btn btn-primary" style="margin-left:auto" onclick="markResult()"><i class="ti ti-map-pin"></i> Markieren</button>
  </div>
  {{end}}
</div>

{{template "import-mark-panel" (dict "Title" "Wert markieren" "SourceLabel" "Quellwert")}}
{{end}}

{{template "import-mappings-table" (dict "Mappings" .Mappings "CanWrite" .CanWrite "SourceHeader" "Quellwert" "Empty" "Noch keine Register markiert." "Mono" true)}}
{{end}}
{{end}}

{{define "scripts"}}
<script>
function testRegisterTypeChanged(){
  const type = document.getElementById('test-register-type').value;
  const dataTypeField = document.getElementById('test-data-type-field');
  if(dataTypeField) dataTypeField.hidden = (type === 'coil' || type === 'discrete');
}

function markResult(){
  const type = document.getElementById('test-register-type').value;
  const address = document.getElementById('test-address').value;
  const dataType = (type === 'coil' || type === 'discrete') ? 'bool' : document.getElementById('test-data-type').value;
  importMarkOpen(type + ':' + address + ':' + dataType);
}
document.addEventListener('DOMContentLoaded', testRegisterTypeChanged);
</script>
{{template "import-mapping-js" (dict "ConnectionID" .ConnectionID)}}
{{end}}
