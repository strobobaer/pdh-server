{{template "base" .}}
{{define "content"}}
<style>
.ic-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border)}
.ic-row:last-child{border:0}
.ic-prev{width:42px;height:42px;border-radius:10px;border:1px solid var(--border);background:var(--bg3);color:var(--text);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.ic-prev i{font-size:21px}
.ic-prev:hover{border-color:var(--accent);color:var(--accent)}
.ic-row .grow{flex:1;min-width:0}
.ic-row small{display:block;color:var(--muted);font-size:11px;font-family:monospace}
.ic-row input{width:190px;font-family:monospace;font-size:12px}
.ic-row.changed .ic-prev{border-color:var(--accent);background:rgba(var(--accent-rgb),.1)}
.ic-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:12px;align-items:start}
@media (max-width:520px){.ic-groups{grid-template-columns:1fr}.ic-row input{width:120px}}
.ic-bar{position:sticky;bottom:0;background:var(--bg);border-top:1px solid var(--border);padding:10px 0;display:flex;gap:8px;justify-content:flex-end;z-index:5}
.ic-pick{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:700;display:none;align-items:center;justify-content:center;padding:16px}
.ic-pick.open{display:flex}
.ic-pick-box{background:var(--bg2);border:1px solid var(--border);border-radius:14px;width:min(760px,100%);max-height:86vh;display:flex;flex-direction:column}
.ic-pick-head{display:flex;gap:8px;align-items:center;padding:12px;border-bottom:1px solid var(--border)}
.ic-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:6px;padding:12px;overflow-y:auto}
.ic-grid button{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 4px;border:1px solid transparent;border-radius:8px;background:var(--bg3);color:var(--text);cursor:pointer;font-size:10px;font-family:monospace;overflow:hidden}
.ic-grid button i{font-size:22px}
.ic-grid button:hover,.ic-grid button.on{border-color:var(--accent);color:var(--accent)}
.ic-grid button span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>

<div class="rec-head">
  <div class="rec-img" style="display:flex;align-items:center;justify-content:center;color:var(--accent)"><i class="ti ti-icons" style="font-size:26px"></i></div>
  <div class="t"><h1>Symbole</h1>
    <div class="sub">Alle Symbole kommen aus der lokalen Bibliothek (Tabler Icons) – nichts wird aus dem Internet geladen. Symbol anklicken, um es auszutauschen.{{if .Changed}} · <b>{{.Changed}}</b> geändert{{end}}</div></div>
</div>
{{if .Message}}<div class="rec-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="rec-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

<form method="post" action="/admin/icons" id="ic-form">
  <div class="ic-groups">
  {{range .Groups}}
    <div class="card" style="margin:0">
      <div class="card-title"><span>{{.Label}}</span></div>
      <p class="rec-sub" style="margin:-6px 0 6px">{{.Hint}}</p>
      {{range .Rows}}
      <div class="ic-row{{if .Changed}} changed{{end}}" data-default="{{.Default}}">
        <button type="button" class="ic-prev" title="Symbol wählen" aria-label="Symbol für {{.Label}} wählen" onclick="icOpen(this)"><i class="ti {{.Current}}"></i></button>
        <div class="grow">{{.Label}}<small>{{.Key}}</small></div>
        <input class="form-input" name="icon.{{.Key}}" value="{{.Current}}" spellcheck="false" autocomplete="off" oninput="icPreview(this)" aria-label="Symbol für {{.Label}}">
        <button type="button" class="btn btn-small" title="Vorgabe: {{.Default}}" onclick="icReset(this)"><i class="ti ti-restore"></i></button>
      </div>
      {{end}}
    </div>
  {{end}}
  </div>
  <div class="ic-bar">
    <button type="submit" class="btn" name="reset" value="1" onclick="return confirm('Alle Symbole auf die Vorgabe zurücksetzen?')"><i class="ti ti-restore"></i> Alles zurücksetzen</button>
    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Speichern</button>
  </div>
</form>

<!-- Auswahl aus der Bibliothek -->
<div class="ic-pick" id="ic-pick" role="dialog" aria-modal="true" aria-label="Symbol wählen">
  <div class="ic-pick-box">
    <div class="ic-pick-head">
      <i class="ti ti-search" style="color:var(--muted)"></i>
      <input class="form-input" id="ic-q" placeholder="Suchen, z. B. tool, factory, alert, plug …" autocomplete="off" style="flex:1">
      <span class="rec-sub" id="ic-count"></span>
      <button type="button" class="btn btn-small" onclick="icClose()"><i class="ti ti-x"></i></button>
    </div>
    <div class="ic-grid" id="ic-grid"><div class="rec-sub">Lädt …</div></div>
  </div>
</div>
{{end}}

{{define "context-list"}}{{end}}

{{block "scripts" .}}
<script>
// Symbole: Vorschau, Vorgabe, Auswahl aus der lokalen Bibliothek (icons.go)
let icNames = null, icTarget = null;
function icPreview(inp){
  const row = inp.closest('.ic-row');
  let v = inp.value.trim();
  if(v && !v.startsWith('ti-')) v = 'ti-' + v;
  row.querySelector('.ic-prev i').className = 'ti ' + (v || row.dataset.default);
  row.classList.toggle('changed', !!v && v !== row.dataset.default);
}
function icReset(btn){
  const row = btn.closest('.ic-row'), inp = row.querySelector('input');
  inp.value = row.dataset.default; icPreview(inp);
}
async function icOpen(btn){
  icTarget = btn.closest('.ic-row').querySelector('input');
  document.getElementById('ic-pick').classList.add('open');
  const q = document.getElementById('ic-q');
  q.value = ''; q.focus();
  if(!icNames){
    try{ icNames = await (await fetch('/admin/icons/names', {credentials: 'same-origin'})).json(); }
    catch(e){ document.getElementById('ic-grid').textContent = 'Bibliothek konnte nicht geladen werden: ' + e.message; return; }
  }
  icRender();
}
function icClose(){ document.getElementById('ic-pick').classList.remove('open'); icTarget = null; }
function icRender(){
  const q = document.getElementById('ic-q').value.trim().toLowerCase().replace(/^ti-/, '');
  const words = q.split(/\s+/).filter(Boolean);
  const hits = icNames.filter(n => words.every(w => n.includes(w)));
  const grid = document.getElementById('ic-grid');
  grid.replaceChildren();
  const cur = icTarget ? icTarget.value.trim() : '';
  hits.slice(0, 300).forEach(n => {
    const b = document.createElement('button');
    b.type = 'button'; b.title = n; if(n === cur) b.className = 'on';
    const i = document.createElement('i'); i.className = 'ti ' + n;
    const s = document.createElement('span'); s.textContent = n.slice(3);
    b.append(i, s);
    b.addEventListener('click', () => { if(icTarget){ icTarget.value = n; icPreview(icTarget); } icClose(); });
    grid.appendChild(b);
  });
  document.getElementById('ic-count').textContent = hits.length > 300 ? '300 von ' + hits.length + ' – genauer suchen' : hits.length + ' Symbole';
}
document.getElementById('ic-q').addEventListener('input', () => { if(icNames) icRender(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') icClose(); });
document.getElementById('ic-pick').addEventListener('click', e => { if(e.target.id === 'ic-pick') icClose(); });
</script>
{{end}}
