<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="{{if .Urgent}}#b91c1c{{else}}#1a1d27{{end}}">
<title>{{if .Urgent}}🚨 {{end}}{{.Title}}</title>
<link rel="icon" href="/favicon.ico">
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css?v={{appVersion}}">
<style>
/* Alarm aus einer Push-Benachrichtigung (push.go): bildschirmfuellend, ein grosser Knopf */
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0f1117;--bg2:#1a1d27;--text:#f1f5f9;--muted:#cbd5e1;--accent:#4f6ef7;--green:#10b981;--red:#b91c1c}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
body{display:flex;flex-direction:column;min-height:100dvh;padding:max(20px,env(safe-area-inset-top)) 18px max(20px,env(safe-area-inset-bottom))}
body.urgent{background:linear-gradient(170deg,#7f1d1d,#b91c1c 55%,#450a0a)}
body.urgent.live{animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{50%{background-position:0 40px;filter:brightness(1.18)}}
.kind{display:inline-flex;align-items:center;gap:8px;font-size:15px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;opacity:.9}
.kind i{font-size:22px}
h1{font-size:clamp(26px,7vw,40px);line-height:1.15;margin:14px 0 12px;overflow-wrap:anywhere}
.body{font-size:18px;line-height:1.45;white-space:pre-wrap;color:var(--muted);overflow-wrap:anywhere}
.meta{font-size:14px;color:var(--muted);margin-top:12px;opacity:.85}
.grow{flex:1;min-height:20px}
.state{font-size:18px;font-weight:600;padding:14px 16px;border-radius:14px;background:rgba(0,0,0,.28);margin-bottom:14px;display:flex;gap:10px;align-items:center}
.state i{font-size:24px}
.btns{display:grid;gap:12px}
button,a.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;border:0;border-radius:16px;font:inherit;font-weight:700;text-decoration:none;cursor:pointer;touch-action:manipulation}
#accept{min-height:96px;font-size:26px;background:var(--green);color:#fff;box-shadow:0 10px 30px rgba(0,0,0,.35)}
#accept i{font-size:34px}
#accept:active{transform:scale(.98)}
#accept:disabled{opacity:.6}
a.btn{min-height:60px;font-size:18px;background:rgba(255,255,255,.14);color:var(--text)}
.msg{min-height:22px;font-size:15px;text-align:center;margin-top:10px}
[hidden]{display:none!important}
</style>
</head>
<body class="{{if .Urgent}}urgent{{if not .Closed}} live{{end}}{{end}}">
  <div class="kind"><i class="ti {{if eq .RefType "fault"}}ti-alert-triangle{{else}}ti-ticket{{end}}"></i> {{.Kind}}{{if .Urgent}} · Anlage steht{{end}}</div>
  <h1>{{.Title}}</h1>
  {{if .Body}}<div class="body">{{.Body}}</div>{{end}}
  <div class="meta">Gemeldet {{.Created}}</div>
  <div class="grow"></div>
  <div class="state" id="state"{{if not .Closed}} hidden{{end}}><i class="ti ti-circle-check"></i><span id="state-text">{{if .AcceptedBy}}Angenommen von {{.AcceptedBy}}{{if .AcceptedAt}} um {{.AcceptedAt}}{{end}}{{else}}{{.CloseReason}}{{end}}</span></div>
  <div class="btns">
    {{if .Recipient}}<button type="button" id="accept"{{if .Closed}} hidden{{end}}><i class="ti ti-hand-grab"></i> Annehmen</button>{{end}}
    <a class="btn" href="{{.DetailURL}}"><i class="ti ti-eye"></i> Ansehen</a>
    <a class="btn" href="/"><i class="ti ti-arrow-left"></i> Zurück</a>
  </div>
  <div class="msg" id="msg" role="alert"></div>
<script>
(function(){
  const ID = {{.ID}}, URGENT = {{.Urgent}};
  let closed = {{.Closed}};
  const $ = id => document.getElementById(id);
  function done(text){
    closed = true;
    document.body.classList.remove('live');
    if($('accept')) $('accept').hidden = true;
    $('state-text').textContent = text;
    $('state').hidden = false;
    if(navigator.vibrate) navigator.vibrate(0);
  }
  // „Anlage steht“: vibrieren, solange niemand angenommen hat (Android)
  if(URGENT && !closed && navigator.vibrate){
    const buzz = () => { if(!closed) navigator.vibrate([700, 300, 700]); };
    buzz(); const t = setInterval(() => closed ? clearInterval(t) : buzz(), 4000);
  }
  if($('accept')) $('accept').addEventListener('click', async () => {
    $('accept').disabled = true; $('msg').textContent = 'Wird angenommen …';
    try{
      const r = await fetch('/push/alert/' + ID + '/accept', {method: 'POST', credentials: 'same-origin'});
      const j = await r.json().catch(() => ({}));
      if(r.ok && j.url){ done('Angenommen – du bist zuständig'); location.href = j.url; return; }
      if(r.status === 409){ done(j.accepted_by ? 'Schon angenommen von ' + j.accepted_by : (j.error || 'Nicht mehr offen')); $('msg').textContent = ''; return; }
      throw new Error(j.error || ('HTTP ' + r.status));
    }catch(e){ $('msg').textContent = e.message; $('accept').disabled = false; }
  });
  // nimmt jemand anderes an, verschwindet der Alarm auch hier
  if(!closed){
    const poll = setInterval(async () => {
      if(closed){ clearInterval(poll); return; }
      try{
        const r = await fetch('/push/alert/' + ID + '/state', {credentials: 'same-origin', cache: 'no-store'});
        const j = await r.json();
        if(j.closed) done(j.accepted_by ? 'Angenommen von ' + j.accepted_by + (j.accepted_at ? ' um ' + j.accepted_at : '') : (j.reason || 'Nicht mehr offen'));
      }catch(e){}
    }, 4000);
    if(navigator.serviceWorker) navigator.serviceWorker.addEventListener('message', e => {
      const m = e.data && e.data.pdhPush;
      if(m && m.type === 'close' && m.id === ID) done(m.note ? m.note.charAt(0).toUpperCase() + m.note.slice(1) : 'Nicht mehr offen');
    });
  }
})();
</script>
</body>
</html>
