{{template "base" .}}
{{define "content"}}
<style>
.main{padding:0!important;overflow:hidden!important;display:flex}
.chat-app{flex:1;display:grid;grid-template-columns:300px 1fr;min-height:0;height:100%;background:var(--bg)}
.chat-app.side-open{grid-template-columns:300px 1fr 300px}
.chat-nav{border-right:1px solid var(--border);background:var(--bg2);display:flex;flex-direction:column;min-height:0}
.chat-nav-head{display:flex;align-items:center;gap:6px;padding:12px 12px 8px}
.chat-nav-head h2{flex:1;font-size:16px;font-weight:600}
.chat-icon-btn{width:34px;height:34px;border-radius:8px;border:1px solid var(--border);background:var(--bg3);color:var(--text);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.chat-icon-btn:hover{border-color:var(--accent);color:var(--accent)}
.chat-icon-btn.on{background:var(--accent);border-color:var(--accent);color:#fff}
.chat-search{margin:0 12px 8px;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:6px 10px}
.chat-search input{flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)}
.chat-list{flex:1;overflow-y:auto;padding:0 6px 12px}
.chat-sec{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;padding:12px 8px 4px;display:flex;align-items:center;gap:6px}
.chat-sec button{margin-left:auto;background:none;border:0;color:var(--muted);cursor:pointer;font-size:14px}
.chat-item{display:flex;align-items:center;gap:10px;padding:7px 8px;border-radius:8px;cursor:pointer;position:relative}
.chat-item:hover{background:var(--bg3)}
.chat-item.active{background:rgba(var(--accent-rgb),.14)}
.chat-item .t{flex:1;min-width:0}
.chat-item .n{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item.unread .n{font-weight:700}
.chat-item .p{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item .meta{display:flex;flex-direction:column;align-items:flex-end;gap:3px;font-size:10.5px;color:var(--muted)}
.chat-badge{min-width:18px;height:18px;border-radius:9px;background:var(--accent);color:#fff;font-size:10.5px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;padding:0 5px}
.chat-badge.mention{background:var(--red)}
.chat-badge.muted{background:var(--muted)}
.chat-team{padding:6px 8px;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;cursor:pointer;border-radius:8px}
.chat-team:hover{background:var(--bg3)}
.chat-team .sq{width:24px;height:24px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700}
.chat-team .act{margin-left:auto;display:none;gap:2px}
.chat-team:hover .act{display:flex}
.chat-team .act button{background:none;border:0;color:var(--muted);cursor:pointer;font-size:14px;padding:2px}
.chat-channel{padding-left:32px}
.chat-channel .n::before{content:"# ";color:var(--muted)}
.avatar{width:32px;height:32px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:600;flex-shrink:0;position:relative}
.avatar.sm{width:26px;height:26px;font-size:10.5px}
.avatar.group{border-radius:8px}
.avatar .dot{position:absolute;right:-1px;bottom:-1px;width:10px;height:10px;border-radius:50%;border:2px solid var(--bg2);background:var(--muted)}
.avatar .dot.on{background:var(--green)}
.chat-main{display:flex;flex-direction:column;min-width:0;min-height:0}
.chat-head{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border);background:var(--bg2);min-height:58px}
.chat-head .t{flex:1;min-width:0}
.chat-head .n{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-head .s{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-back{display:none}
.chat-msgs{flex:1;overflow-y:auto;padding:12px 18px 6px;display:flex;flex-direction:column}
.chat-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);gap:10px;text-align:center;padding:30px}
.chat-empty i{font-size:42px;color:var(--accent)}
.chat-day{align-self:center;font-size:11px;color:var(--muted);margin:14px 0 6px;padding:2px 10px;border-radius:10px;background:var(--bg3)}
.chat-more{align-self:center;margin:6px 0}
.msg{display:flex;gap:10px;padding:2px 0;position:relative;max-width:100%}
.msg.cont .avatar{visibility:hidden;height:0}
.msg .b{min-width:0;max-width:min(720px,85%)}
.msg .who{font-size:12px;color:var(--muted);margin:6px 0 2px;display:flex;gap:8px;align-items:baseline}
.msg .who b{color:var(--text);font-weight:600}
.msg.cont .who{display:none}
.bubble{background:var(--bg2);border:1px solid var(--border);border-radius:4px 10px 10px 10px;padding:7px 11px;font-size:13.5px;line-height:1.45;word-wrap:break-word;overflow-wrap:anywhere;white-space:pre-wrap}
.msg.mine{flex-direction:row-reverse}
.msg.mine .b{display:flex;flex-direction:column;align-items:flex-end}
.msg.mine .who{justify-content:flex-end}
.msg.mine .bubble{background:rgba(var(--accent-rgb),.16);border-color:rgba(var(--accent-rgb),.3);border-radius:10px 4px 10px 10px}
.msg.mentioned .bubble{border-left:3px solid var(--red)}
.msg.deleted .bubble{font-style:italic;color:var(--muted)}
.bubble code{font-family:monospace;background:var(--bg3);padding:0 4px;border-radius:4px;font-size:12.5px}
.bubble a{color:var(--accent);text-decoration:underline}
.bubble .mention{color:var(--accent);font-weight:600}
.bubble .mention.me{background:rgba(239,68,68,.15);color:var(--red);border-radius:4px;padding:0 3px}
.msg-sys{align-self:center;font-size:11.5px;color:var(--muted);margin:8px 0;display:flex;gap:6px;align-items:center}
.msg-actions{position:absolute;top:-10px;right:0;display:none;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:2px;box-shadow:0 4px 14px rgba(0,0,0,.2);z-index:5}
.msg.mine .msg-actions{right:auto;left:0}
.msg:hover .msg-actions{display:flex}
.msg-actions button{background:none;border:0;cursor:pointer;padding:3px 5px;border-radius:6px;font-size:14px;color:var(--text)}
.msg-actions button:hover{background:var(--bg3)}
.reacts{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}
.react{border:1px solid var(--border);background:var(--bg2);border-radius:12px;padding:1px 7px;font-size:12px;cursor:pointer;color:var(--text)}
.react.mine{border-color:var(--accent);background:rgba(var(--accent-rgb),.14)}
.cards{display:flex;flex-direction:column;gap:4px;margin-top:4px;width:100%}
.card-link{display:flex;align-items:center;gap:8px;border:1px solid var(--border);border-left:3px solid var(--accent);background:var(--bg2);border-radius:8px;padding:6px 10px;font-size:12.5px;max-width:420px}
.card-link:hover{border-color:var(--accent)}
.card-link i{font-size:17px;color:var(--accent)}
.card-link small{display:block;color:var(--muted);font-size:10.5px}
.files{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.file-img{max-width:240px;max-height:200px;border-radius:8px;border:1px solid var(--border);display:block}
.file-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:12px;background:var(--bg2)}
.receipt{font-size:10.5px;color:var(--muted);margin-top:2px}
.post{border:1px solid var(--border);border-radius:10px;background:var(--bg2);margin:8px 0;overflow:hidden}
.post > .msg{padding:10px 12px 6px}
.post .bubble{background:none;border:0;padding:2px 0}
.post .replies{border-top:1px solid var(--border);background:var(--bg);padding:4px 12px 4px 32px}
.post .replies .msg{padding:4px 0}
.post .replies .bubble{background:none;border:0;padding:0}
.post .reply-btn{border:0;border-top:1px solid var(--border);background:none;width:100%;text-align:left;padding:7px 12px;color:var(--accent);font-size:12.5px;cursor:pointer;font-family:var(--font)}
.post .reply-btn:hover{background:var(--bg3)}
.chat-typing{height:18px;padding:0 20px;font-size:11.5px;color:var(--muted)}
.composer{border-top:1px solid var(--border);padding:10px 16px 12px;background:var(--bg2)}
.composer-box{border:1px solid var(--border);border-radius:10px;background:var(--bg);padding:6px 8px;position:relative}
.composer-box:focus-within{border-color:var(--accent)}
.composer textarea{width:100%;border:0;outline:0;background:none;color:var(--text);font-size:13.5px;font-family:var(--font);resize:none;max-height:180px;min-height:38px;line-height:1.4;padding:4px}
.composer-row{display:flex;align-items:center;gap:4px}
.composer-row .grow{flex:1}
.composer-banner{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:6px;padding:4px 8px;border-left:3px solid var(--accent);background:var(--bg3);border-radius:6px}
.composer-banner .x{margin-left:auto;cursor:pointer}
.pending-files{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.mention-pop{position:absolute;bottom:100%;left:8px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.25);min-width:240px;max-height:220px;overflow-y:auto;z-index:20;margin-bottom:4px}
.mention-pop div{display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:13px;cursor:pointer}
.mention-pop div.sel,.mention-pop div:hover{background:var(--bg3)}
.emoji-pop{position:absolute;bottom:100%;right:40px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:4px;display:flex;gap:2px;z-index:20;margin-bottom:4px}
.emoji-pop button{font-size:18px;background:none;border:0;cursor:pointer;padding:3px 5px;border-radius:6px}
.emoji-pop button:hover{background:var(--bg3)}
.chat-side{border-left:1px solid var(--border);background:var(--bg2);display:none;flex-direction:column;min-height:0}
.chat-app.side-open .chat-side{display:flex}
.chat-side-head{display:flex;align-items:center;gap:8px;padding:14px 14px 8px;font-weight:600;font-size:14px}
.chat-side-head span{flex:1}
.chat-side-body{flex:1;overflow-y:auto;padding:0 12px 12px}
.side-row{display:flex;align-items:center;gap:8px;padding:6px 4px;font-size:13px;border-radius:8px}
.side-row:hover{background:var(--bg3)}
.side-row .t{flex:1;min-width:0}
.side-row .t small{display:block;color:var(--muted);font-size:11px}
.side-row button{background:none;border:0;color:var(--muted);cursor:pointer}
.hit{padding:8px 6px;border-bottom:1px solid var(--border);cursor:pointer;font-size:12.5px}
.hit:hover{background:var(--bg3)}
.hit small{color:var(--muted);display:block;font-size:11px}
.chat-modal{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:400;display:none;align-items:center;justify-content:center;padding:16px}
.chat-modal.open{display:flex}
.chat-modal .box{background:var(--bg2);border:1px solid var(--border);border-radius:12px;width:min(480px,100%);max-height:calc(100dvh - 32px);overflow:auto;padding:18px}
.chat-modal h3{font-size:16px;margin-bottom:12px}
.pick-list{max-height:260px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;margin:6px 0 10px}
.pick-list label{display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:13px;cursor:pointer}
.pick-list label:hover{background:var(--bg3)}
.pick-chips{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px}
.pick-chips span{background:rgba(var(--accent-rgb),.15);color:var(--accent);border-radius:12px;padding:2px 8px;font-size:12px;cursor:pointer}
.chat-share{margin:0 12px 8px;padding:8px 10px;border-radius:8px;background:rgba(var(--accent-rgb),.12);font-size:12px;color:var(--accent)}
@media (max-width:900px){
  .chat-app,.chat-app.side-open{grid-template-columns:1fr}
  .chat-app .chat-main{display:none}
  .chat-app.show-main .chat-nav{display:none}
  .chat-app.show-main .chat-main{display:flex}
  .chat-app.side-open .chat-side{position:fixed;inset:0;z-index:300}
  .chat-back{display:inline-flex}
  .msg .b{max-width:92%}
}
</style>

<div class="chat-app" id="chat-app" data-me="{{.MeID}}" data-share="{{.ShareURL}}" data-share-title="{{.ShareTitle}}">
  <aside class="chat-nav">
    <div class="chat-nav-head">
      <h2>Chat</h2>
      <button class="chat-icon-btn" title="Neuer Chat" onclick="Chat.openNewChat()"><i class="ti ti-message-plus"></i></button>
      <button class="chat-icon-btn" title="Team erstellen" onclick="Chat.openNewTeam()"><i class="ti ti-users-plus"></i></button>
    </div>
    <div class="chat-search"><i class="ti ti-search" style="color:var(--muted)"></i><input id="chat-filter" placeholder="Chats, Personen, Kanäle filtern"></div>
    <div id="chat-share-hint" class="chat-share" style="display:none"><i class="ti ti-share"></i> Unterhaltung auswählen, um „<span id="chat-share-title"></span>“ zu teilen</div>
    <div class="chat-list" id="chat-list"><div class="chat-empty"><i class="ti ti-loader-2"></i>Wird geladen…</div></div>
  </aside>

  <section class="chat-main" id="chat-main">
    <div class="chat-empty" id="chat-welcome">
      <i class="ti ti-messages"></i>
      <div style="font-size:15px;color:var(--text);font-weight:600">Willkommen im PDH-Chat</div>
      <div style="font-size:12.5px;max-width:420px">Schreibe Kolleg:innen direkt, starte Gruppenchats oder arbeite in Teams mit Kanälen. Links auf Tickets, Störungen, Anlagen oder Ersatzteile werden automatisch als Karte angezeigt.</div>
      <div style="display:flex;gap:8px;margin-top:6px">
        <button class="btn btn-primary btn-small" onclick="Chat.openNewChat()"><i class="ti ti-message-plus"></i> Neuer Chat</button>
        <button class="btn btn-small" onclick="Chat.openNewTeam()"><i class="ti ti-users-plus"></i> Team erstellen</button>
      </div>
    </div>
    <div id="chat-conv" style="display:none;flex:1;min-height:0;flex-direction:column">
      <div class="chat-head">
        <button class="chat-icon-btn chat-back" title="Zurück" onclick="Chat.back()"><i class="ti ti-arrow-left"></i></button>
        <div id="chat-head-avatar"></div>
        <div class="t"><div class="n" id="chat-head-name"></div><div class="s" id="chat-head-sub"></div></div>
        <button class="chat-icon-btn" id="btn-members" title="Mitglieder" onclick="Chat.toggleSide('members')"><i class="ti ti-users"></i></button>
        <button class="chat-icon-btn" id="btn-files" title="Dateien" onclick="Chat.toggleSide('files')"><i class="ti ti-files"></i></button>
        <button class="chat-icon-btn" id="btn-search" title="Suchen" onclick="Chat.toggleSide('search')"><i class="ti ti-search"></i></button>
        <button class="chat-icon-btn" id="btn-mute" title="Stummschalten" onclick="Chat.toggleMute()"><i class="ti ti-bell"></i></button>
      </div>
      <div class="chat-msgs" id="chat-msgs"></div>
      <div class="chat-typing" id="chat-typing"></div>
      <div class="composer">
        <div id="composer-banner"></div>
        <div class="pending-files" id="pending-files"></div>
        <div class="composer-box">
          <div class="mention-pop" id="mention-pop" style="display:none"></div>
          <div class="emoji-pop" id="emoji-pop" style="display:none"></div>
          <textarea id="composer" rows="1" placeholder="Nachricht eingeben – @ für Erwähnungen, Enter zum Senden"></textarea>
          <div class="composer-row">
            <label class="chat-icon-btn" title="Datei anhängen" style="border:0;background:none"><i class="ti ti-paperclip"></i><input type="file" id="file-input" multiple style="display:none"></label>
            <button class="chat-icon-btn" style="border:0;background:none" title="Emoji" onclick="Chat.toggleEmoji()"><i class="ti ti-mood-smile"></i></button>
            <span class="grow" style="font-size:11px;color:var(--muted)">Shift+Enter: neue Zeile · **fett** · `code`</span>
            <button class="chat-icon-btn on" id="btn-send" title="Senden" onclick="Chat.send()"><i class="ti ti-send"></i></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside class="chat-side" id="chat-side">
    <div class="chat-side-head"><span id="chat-side-title"></span><button class="chat-icon-btn" onclick="Chat.toggleSide(null)"><i class="ti ti-x"></i></button></div>
    <div class="chat-side-body" id="chat-side-body"></div>
  </aside>
</div>

<!-- Dialoge -->
<div class="chat-modal" id="modal-people" onclick="if(event.target===this)Chat.closeModal()">
  <div class="box">
    <h3 id="people-title">Neuer Chat</h3>
    <div id="people-extra"></div>
    <div class="pick-chips" id="people-chips"></div>
    <input class="form-input" id="people-filter" placeholder="Personen suchen">
    <div class="pick-list" id="people-list"></div>
    <div id="people-error" style="color:var(--red);font-size:12px;margin-bottom:8px"></div>
    <div style="display:flex;justify-content:flex-end;gap:8px">
      <button class="btn btn-small" onclick="Chat.closeModal()">Abbrechen</button>
      <button class="btn btn-small btn-primary" id="people-ok">Starten</button>
    </div>
  </div>
</div>
<div class="chat-modal" id="modal-text" onclick="if(event.target===this)Chat.closeModal()">
  <div class="box">
    <h3 id="text-title"></h3>
    <div class="form-group"><label class="form-label">Name</label><input class="form-input" id="text-name" maxlength="100"></div>
    <div class="form-group"><label class="form-label">Beschreibung</label><input class="form-input" id="text-desc" maxlength="500"></div>
    <div id="text-error" style="color:var(--red);font-size:12px;margin-bottom:8px"></div>
    <div style="display:flex;justify-content:flex-end;gap:8px">
      <button class="btn btn-small" onclick="Chat.closeModal()">Abbrechen</button>
      <button class="btn btn-small btn-primary" id="text-ok">Speichern</button>
    </div>
  </div>
</div>
{{end}}

{{define "context-list"}}
<div class="act-item"><div class="act-dot d-blue"></div><div class="act-text">Links auf PDH-Datensätze werden als Karte angezeigt</div></div>
<div class="act-item"><div class="act-dot d-green"></div><div class="act-text">„Im Chat teilen“ in der Kopfleiste jeder Seite</div></div>
{{end}}

{{define "scripts"}}
<script>
(function(){
const root = document.getElementById('chat-app');
const ME = root.dataset.me;
const COLORS = ['#4f6ef7','#10b981','#f59e0b','#ef4444','#7c3aed','#0ea5e9','#ec4899','#14b8a6','#f97316','#6366f1'];
const S = {
  users: {}, convs: {}, teams: [], emojis: [], online: new Set(), isAdmin: false,
  current: null, msgs: {}, hasMore: {}, reads: {}, typing: {}, replyTo: null,
  pendingFiles: [], mentionIds: new Set(), editing: null, side: null,
  share: root.dataset.share ? { url: location.origin + root.dataset.share, title: root.dataset.shareTitle || '' } : null,
};

// ── Hilfen ──────────────────────────────────────────────
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function color(id){ let h = 0; for(const c of String(id)) h = (h*31 + c.charCodeAt(0)) >>> 0; return COLORS[h % COLORS.length]; }
function userName(id){ return S.users[id]?.name || 'Unbekannt'; }
function avatar(id, cls){
  const u = S.users[id];
  const dot = `<span class="dot ${S.online.has(id) ? 'on' : ''}" data-presence="${esc(id)}"></span>`;
  return `<span class="avatar ${cls||''}" style="background:${color(id)}" title="${esc(u?.name||'')}">${esc(u?.initials||'?')}${dot}</span>`;
}
function convAvatar(c){
  if(c.kind === 'direct') return avatar(otherMember(c) || ME);
  if(c.kind === 'channel'){ const t = S.teams.find(t => t.id === c.team_id); return `<span class="avatar group" style="background:${t?.color||color(c.id)}">#</span>`; }
  return `<span class="avatar group" style="background:${color(c.id)}"><i class="ti ti-users"></i></span>`;
}
function otherMember(c){ return (c.members||[]).find(id => id !== ME); }
function convName(c){
  if(c.kind === 'direct'){ const o = otherMember(c); return o ? userName(o) : userName(ME) + ' (Notizen)'; }
  if(c.kind === 'group' && !c.name) return (c.members||[]).filter(id => id !== ME).map(id => userName(id).split(' ')[0]).join(', ') || 'Gruppe';
  return c.name;
}
function fmtTime(ts){ const d = new Date(ts); return d.toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'}); }
function fmtDay(ts){
  const d = new Date(ts), t = new Date(); const y = new Date(); y.setDate(t.getDate()-1);
  if(d.toDateString() === t.toDateString()) return 'Heute';
  if(d.toDateString() === y.toDateString()) return 'Gestern';
  return d.toLocaleDateString('de-DE', {weekday:'long', day:'2-digit', month:'long', year: d.getFullYear() === t.getFullYear() ? undefined : 'numeric'});
}
function fmtShort(ts){
  const d = new Date(ts), t = new Date();
  if(d.toDateString() === t.toDateString()) return fmtTime(ts);
  return d.toLocaleDateString('de-DE', {day:'2-digit', month:'2-digit'});
}
function fmtSize(b){ return b > 1048576 ? (b/1048576).toFixed(1).replace('.', ',') + ' MB' : Math.max(1, Math.round(b/1024)) + ' KB'; }
async function api(method, url, body){
  const opt = {method, credentials:'same-origin', headers:{}};
  if(body instanceof FormData) opt.body = body;
  else if(body !== undefined){ opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
  const res = await fetch(url, opt);
  if(res.status === 204) return null;
  const data = await res.json().catch(() => ({}));
  if(!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
  return data;
}
function toast(msg, err){
  const el = document.createElement('div');
  el.textContent = msg;
  el.style.cssText = `position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:600;padding:8px 14px;border-radius:8px;font-size:13px;color:#fff;background:${err ? 'var(--red)' : 'var(--accent)'}`;
  document.body.appendChild(el); setTimeout(() => el.remove(), 3500);
}

// Nachrichtentext: escapen, Links, Erwaehnungen, **fett**, *kursiv*, `code`
function renderBody(m){
  let s = esc(m.body);
  s = s.replace(/`([^`\n]+)`/g, '<code>$1</code>');
  s = s.replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>').replace(/(^|\s)\*([^*\n]+)\*(?=\s|$)/g, '$1<i>$2</i>');
  s = s.replace(/(https?:\/\/[^\s<]+[^\s<.,;:!?)])/g, url => {
    const internal = url.startsWith(location.origin + '/');
    return internal ? `<a href="${url}" data-frame>${url}</a>` : `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`;
  });
  for(const uid of (m.mentions||[])){
    const n = esc('@' + userName(uid));
    s = s.split(n).join(`<span class="mention ${uid === ME ? 'me' : ''}">${n}</span>`);
  }
  return s;
}

// ── Laden ───────────────────────────────────────────────
async function bootstrap(){
  const d = await api('GET', '/chat/api/bootstrap');
  S.users = {}; for(const u of d.users) S.users[u.id] = u;
  for(const u of d.users) if(u.online) S.online.add(u.id);
  S.convs = {}; for(const c of d.conversations) S.convs[c.id] = c;
  S.teams = d.teams || []; S.emojis = d.emojis || []; S.isAdmin = d.is_admin;
  renderList();
  if(S.current && !S.convs[S.current]){ S.current = null; showWelcome(); }
  else if(S.current) renderHead();
}

function sortedConvs(kind){
  return Object.values(S.convs).filter(c => kind === 'chat' ? c.kind !== 'channel' : c.kind === 'channel')
    .sort((a,b) => new Date(b.last_message_at) - new Date(a.last_message_at));
}

function convItem(c, extraCls){
  const unread = c.id !== S.current && c.unread > 0;
  let badge = '';
  if(c.id !== S.current && c.mentions > 0) badge = `<span class="chat-badge mention">@</span>`;
  else if(unread) badge = `<span class="chat-badge ${c.muted ? 'muted' : ''}">${c.unread > 99 ? '99+' : c.unread}</span>`;
  const p = c.preview;
  let prev = '';
  if(p){ prev = p.kind === 'system' ? p.body : ((p.user_id === ME ? 'Du: ' : (c.kind !== 'direct' ? userName(p.user_id).split(' ')[0] + ': ' : '')) + (p.body || (p.kind ? '📎 Datei' : 'Nachricht gelöscht'))); }
  return `<div class="chat-item ${extraCls||''} ${c.id === S.current ? 'active' : ''} ${unread ? 'unread' : ''}" data-conv="${c.id}" onclick="Chat.open('${c.id}')">
    ${extraCls ? '' : convAvatar(c)}
    <div class="t"><div class="n">${esc(convName(c))}${c.muted ? ' <i class="ti ti-bell-off" style="font-size:11px;color:var(--muted)"></i>' : ''}</div>${extraCls ? '' : `<div class="p">${esc(prev)}</div>`}</div>
    <div class="meta">${extraCls ? '' : `<span>${p ? fmtShort(p.created_at) : ''}</span>`}${badge}</div>
  </div>`;
}

function renderList(){
  const f = $('chat-filter').value.trim().toLowerCase();
  const match = s => !f || s.toLowerCase().includes(f);
  let html = `<div class="chat-sec"><i class="ti ti-message"></i> Chats</div>`;
  const chats = sortedConvs('chat').filter(c => match(convName(c)));
  html += chats.map(c => convItem(c)).join('') || `<div style="font-size:12px;color:var(--muted);padding:4px 10px">Noch keine Chats</div>`;
  if(f){
    // Personen ohne bestehenden Chat direkt anschreibbar
    const withChat = new Set(chats.filter(c => c.kind === 'direct').map(otherMember));
    const people = Object.values(S.users).filter(u => u.id !== ME && !withChat.has(u.id) && match(u.name)).slice(0, 8);
    if(people.length){
      html += `<div class="chat-sec"><i class="ti ti-user"></i> Personen</div>` + people.map(u =>
        `<div class="chat-item" onclick="Chat.direct('${u.id}')">${avatar(u.id)}<div class="t"><div class="n">${esc(u.name)}</div><div class="p">${esc(u.department || u.email)}</div></div></div>`).join('');
    }
  }
  html += `<div class="chat-sec"><i class="ti ti-users-group"></i> Teams <button title="Team erstellen" onclick="Chat.openNewTeam()"><i class="ti ti-plus"></i></button></div>`;
  for(const t of S.teams){
    const channels = sortedConvs('channel').filter(c => c.team_id === t.id).sort((a,b) => a.name === 'Allgemein' ? -1 : b.name === 'Allgemein' ? 1 : a.name.localeCompare(b.name));
    if(f && !match(t.name) && !channels.some(c => match(c.name))) continue;
    const owner = t.role === 'owner' || S.isAdmin;
    html += `<div class="chat-team"><span class="sq" style="background:${t.color||color(t.id)}">${esc(t.name.slice(0,2).toUpperCase())}</span>${esc(t.name)}
      <span class="act"><button title="Kanal hinzufügen" onclick="event.stopPropagation();Chat.openNewChannel('${t.id}')"><i class="ti ti-hash"></i></button>
      <button title="Mitglieder" onclick="event.stopPropagation();Chat.teamMembers('${t.id}')"><i class="ti ti-users"></i></button></span></div>`;
    html += channels.filter(c => !f || match(c.name) || match(t.name)).map(c => convItem(c, 'chat-channel')).join('');
  }
  if(!S.teams.length) html += `<div style="font-size:12px;color:var(--muted);padding:4px 10px">Noch in keinem Team</div>`;
  $('chat-list').innerHTML = html;
  updateTitle();
}

function updateTitle(){
  const total = Object.values(S.convs).reduce((n, c) => n + (c.muted ? 0 : c.unread), 0);
  document.title = (total ? `(${total}) ` : '') + 'PDH – Chat';
  const b = document.getElementById('chat-nav-badge');
  if(b){ b.textContent = total > 99 ? '99+' : total; b.style.display = total ? '' : 'none'; }
}

// ── Unterhaltung ────────────────────────────────────────
function showWelcome(){ $('chat-welcome').style.display = ''; $('chat-conv').style.display = 'none'; root.classList.remove('show-main'); }

async function open(id){
  if(!S.convs[id]) return;
  S.current = id; S.replyTo = null; S.editing = null; S.mentionIds.clear();
  history.replaceState(null, '', '/chat#c=' + id);
  $('chat-welcome').style.display = 'none'; $('chat-conv').style.display = 'flex';
  root.classList.add('show-main');
  renderHead(); renderList(); renderBanner();
  $('chat-typing').textContent = '';
  if(!S.msgs[id]){ $('chat-msgs').innerHTML = '<div class="chat-empty"><i class="ti ti-loader-2"></i></div>'; await loadMessages(id); }
  renderMessages(true);
  if(S.share){
    const c = $('composer');
    c.value = (S.share.title ? S.share.title + '\n' : '') + S.share.url;
    S.share = null; $('chat-share-hint').style.display = 'none';
  }
  $('composer').focus(); autosize();
  markRead();
  if(S.side) renderSide();
}

async function loadMessages(id, older){
  const list = S.msgs[id] || [];
  const tops = list.filter(m => !m.parent_id);
  const before = older && tops.length ? '?before=' + encodeURIComponent(tops[0].created_at) : '';
  const d = await api('GET', `/chat/api/conversations/${id}/messages${before}`);
  const known = new Set(list.map(m => m.id));
  const incoming = d.messages.filter(m => !known.has(m.id));
  S.msgs[id] = older ? incoming.concat(list) : incoming;
  S.hasMore[id] = d.has_more;
  S.reads[id] = d.reads || {};
}

function renderHead(){
  const c = S.convs[S.current]; if(!c) return;
  $('chat-head-avatar').innerHTML = convAvatar(c);
  $('chat-head-name').textContent = (c.kind === 'channel' ? '# ' : '') + convName(c);
  let sub = '';
  if(c.kind === 'direct'){ const o = otherMember(c); const u = S.users[o]; sub = (S.online.has(o) ? '● Online' : 'Offline') + (u?.department ? ' · ' + u.department : ''); }
  else if(c.kind === 'group') sub = (c.members||[]).length + ' Mitglieder';
  else { const t = S.teams.find(t => t.id === c.team_id); sub = (t ? t.name : '') + (c.description ? ' · ' + c.description : ''); }
  $('chat-head-sub').textContent = sub;
  $('btn-mute').innerHTML = `<i class="ti ${c.muted ? 'ti-bell-off' : 'ti-bell'}"></i>`;
  $('btn-mute').title = c.muted ? 'Stummschaltung aufheben' : 'Stummschalten';
  $('composer').placeholder = c.kind === 'channel' ? 'Neuen Beitrag verfassen – @ für Erwähnungen' : 'Nachricht eingeben – @ für Erwähnungen, Enter zum Senden';
}

function fileHtml(f){
  if(f.is_image) return `<a href="${f.url}" target="_blank" rel="noopener"><img class="file-img" src="${f.url}" alt="${esc(f.name)}" loading="lazy"></a>`;
  return `<a class="file-chip" href="${f.url}" target="_blank" rel="noopener"><i class="ti ti-file"></i> ${esc(f.name)} <small style="color:var(--muted)">${fmtSize(f.size)}</small></a>`;
}

function msgHtml(m, prev, inPost){
  if(m.kind === 'system') return `<div class="msg-sys"><i class="ti ti-info-circle"></i>${esc(m.body)} · ${fmtTime(m.created_at)}</div>`;
  const mine = m.user_id === ME && !inPost;
  const cont = prev && prev.kind !== 'system' && prev.user_id === m.user_id && (new Date(m.created_at) - new Date(prev.created_at)) < 5*60*1000 && !inPost;
  const c = S.convs[m.conversation_id];
  const mentioned = (m.mentions||[]).includes(ME);
  let body = m.deleted ? '<i class="ti ti-trash"></i> Diese Nachricht wurde gelöscht.' : renderBody(m);
  const cards = (m.links||[]).map(l => `<a class="card-link" href="${l.url}" data-frame data-frame-title="${esc(l.label + ': ' + l.title)}"><i class="ti ${l.icon}"></i><span><small>${esc(l.label)}</small>${esc(l.title)}</span></a>`).join('');
  const files = (m.files||[]).map(fileHtml).join('');
  const reacts = (m.reactions||[]).map(r => `<button class="react ${r.users.includes(ME) ? 'mine' : ''}" title="${esc(r.users.map(userName).join(', '))}" onclick="Chat.react('${m.id}','${r.emoji}')">${r.emoji} ${r.users.length}</button>`).join('');
  let actions = '';
  if(!m.deleted){
    actions = (S.emojis.slice(0,4).map(e => `<button title="Reagieren" onclick="Chat.react('${m.id}','${e}')">${e}</button>`).join(''))
      + (c && c.kind === 'channel' && !m.parent_id ? `<button title="Antworten" onclick="Chat.reply('${m.id}')"><i class="ti ti-arrow-back-up"></i></button>` : '')
      + `<button title="Zitieren" onclick="Chat.quote('${m.id}')"><i class="ti ti-quote"></i></button>`
      + (m.user_id === ME ? `<button title="Bearbeiten" onclick="Chat.edit('${m.id}')"><i class="ti ti-pencil"></i></button>` : '')
      + (m.user_id === ME || S.isAdmin ? `<button title="Löschen" onclick="Chat.del('${m.id}')"><i class="ti ti-trash"></i></button>` : '');
  }
  return `<div class="msg ${mine ? 'mine' : ''} ${cont ? 'cont' : ''} ${mentioned ? 'mentioned' : ''} ${m.deleted ? 'deleted' : ''}" id="m-${m.id}">
    ${inPost || !mine ? avatar(m.user_id, inPost && m.parent_id ? 'sm' : '') : ''}
    <div class="b">
      <div class="who"><b>${esc(userName(m.user_id))}</b><span>${fmtTime(m.created_at)}</span>${m.edited_at && !m.deleted ? '<span>(bearbeitet)</span>' : ''}</div>
      ${m.body || m.deleted ? `<div class="bubble">${body}</div>` : ''}
      ${files ? `<div class="files">${files}</div>` : ''}
      ${cards ? `<div class="cards">${cards}</div>` : ''}
      ${reacts ? `<div class="reacts">${reacts}</div>` : ''}
    </div>
    ${actions ? `<div class="msg-actions">${actions}</div>` : ''}
  </div>`;
}

function renderMessages(scrollBottom){
  const box = $('chat-msgs'); const c = S.convs[S.current]; if(!c) return;
  const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;
  const list = S.msgs[S.current] || [];
  let html = S.hasMore[S.current] ? `<button class="btn btn-small chat-more" onclick="Chat.older()">Ältere Nachrichten laden</button>` : '';
  let lastDay = '', prev = null;
  if(c.kind === 'channel'){
    const replies = {};
    for(const m of list) if(m.parent_id) (replies[m.parent_id] = replies[m.parent_id] || []).push(m);
    for(const m of list.filter(m => !m.parent_id)){
      const day = new Date(m.created_at).toDateString();
      if(day !== lastDay){ html += `<div class="chat-day">${fmtDay(m.created_at)}</div>`; lastDay = day; }
      if(m.kind === 'system'){ html += msgHtml(m); continue; }
      const rs = replies[m.id] || [];
      html += `<div class="post">${msgHtml(m, null, true)}${rs.length ? `<div class="replies">${rs.map(r => msgHtml(r, null, true)).join('')}</div>` : ''}
        ${m.deleted ? '' : `<button class="reply-btn" onclick="Chat.reply('${m.id}')"><i class="ti ti-arrow-back-up"></i> Antworten${rs.length ? ' (' + rs.length + ')' : ''}</button>`}</div>`;
    }
    if(!list.length) html += `<div class="chat-empty"><i class="ti ti-hash"></i>Noch keine Beiträge in diesem Kanal</div>`;
  } else {
    for(const m of list){
      const day = new Date(m.created_at).toDateString();
      if(day !== lastDay){ html += `<div class="chat-day">${fmtDay(m.created_at)}</div>`; lastDay = day; prev = null; }
      html += msgHtml(m, prev); prev = m;
    }
    if(!list.length) html += `<div class="chat-empty"><i class="ti ti-message-circle"></i>Schreib die erste Nachricht</div>`;
    // "Gesehen" unter der letzten eigenen Nachricht im 1:1-Chat
    if(c.kind === 'direct'){
      const o = otherMember(c); const lastMine = [...list].reverse().find(m => m.user_id === ME && m.kind === 'text');
      const seen = o && lastMine && S.reads[S.current]?.[o] && new Date(S.reads[S.current][o]) >= new Date(lastMine.created_at);
      if(seen) html += `<div class="receipt" style="align-self:flex-end"><i class="ti ti-checks"></i> Gesehen</div>`;
    }
  }
  box.innerHTML = html;
  if(scrollBottom || atBottom) box.scrollTop = box.scrollHeight;
}

function upsertMessage(m){
  const list = S.msgs[m.conversation_id]; if(!list) return;
  const i = list.findIndex(x => x.id === m.id);
  if(i >= 0) list[i] = m; else list.push(m);
}

// ── Lesen ───────────────────────────────────────────────
let readTimer = null;
function markRead(){
  const c = S.convs[S.current]; if(!c || document.hidden) return;
  clearTimeout(readTimer);
  readTimer = setTimeout(async () => {
    if(!c.unread && !c.mentions && c._readOnce) return;
    c._readOnce = true; c.unread = 0; c.mentions = 0; renderList();
    try { await api('POST', `/chat/api/conversations/${c.id}/read`); } catch(e) {}
  }, 400);
}
document.addEventListener('visibilitychange', () => { if(!document.hidden) markRead(); });

// ── Senden / Composer ───────────────────────────────────
const composer = $('composer');
function autosize(){ composer.style.height = 'auto'; composer.style.height = Math.min(composer.scrollHeight, 180) + 'px'; }
composer.addEventListener('input', () => { autosize(); onMentionInput(); sendTyping(); });
composer.addEventListener('keydown', e => {
  if(mention.open && ['ArrowDown','ArrowUp','Enter','Tab','Escape'].includes(e.key)){ mentionKey(e); return; }
  if(e.key === 'Enter' && !e.shiftKey && !e.isComposing){ e.preventDefault(); send(); }
  if(e.key === 'Escape' && (S.replyTo || S.editing)){ S.replyTo = null; S.editing = null; composer.value = ''; renderBanner(); }
  if(e.key === 'ArrowUp' && !composer.value){ const last = [...(S.msgs[S.current]||[])].reverse().find(m => m.user_id === ME && !m.deleted && m.kind === 'text'); if(last){ e.preventDefault(); edit(last.id); } }
});
composer.addEventListener('paste', e => {
  const files = [...(e.clipboardData?.files || [])];
  if(files.length){ e.preventDefault(); addFiles(files); }
});
$('file-input').addEventListener('change', e => { addFiles([...e.target.files]); e.target.value = ''; });
$('chat-msgs').addEventListener('dragover', e => e.preventDefault());
$('chat-msgs').addEventListener('drop', e => { e.preventDefault(); addFiles([...e.dataTransfer.files]); });

function addFiles(files){ S.pendingFiles.push(...files); renderPending(); }
function renderPending(){
  $('pending-files').innerHTML = S.pendingFiles.map((f, i) => `<span class="file-chip"><i class="ti ti-file"></i> ${esc(f.name)} <small>${fmtSize(f.size)}</small> <i class="ti ti-x" style="cursor:pointer" onclick="Chat.unfile(${i})"></i></span>`).join('');
}
function renderBanner(){
  let html = '';
  if(S.replyTo){ const p = (S.msgs[S.current]||[]).find(m => m.id === S.replyTo); html = `<div class="composer-banner"><i class="ti ti-arrow-back-up"></i> Antwort an ${esc(userName(p?.user_id))}: ${esc((p?.body||'').slice(0,80))}<i class="ti ti-x x" onclick="Chat.cancel()"></i></div>`; }
  if(S.editing) html = `<div class="composer-banner"><i class="ti ti-pencil"></i> Nachricht bearbeiten – Enter speichert, Esc bricht ab<i class="ti ti-x x" onclick="Chat.cancel()"></i></div>`;
  $('composer-banner').innerHTML = html;
}

let sending = false;
async function send(){
  if(sending || !S.current) return;
  const text = composer.value.trim();
  if(S.editing){
    if(!text) return;
    sending = true;
    try { const m = await api('POST', `/chat/api/messages/${S.editing}/edit`, {body: text}); upsertMessage(m); S.editing = null; composer.value = ''; renderBanner(); renderMessages(); }
    catch(e){ toast(e.message, true); } finally { sending = false; autosize(); }
    return;
  }
  if(!text && !S.pendingFiles.length) return;
  const fd = new FormData();
  fd.append('body', text);
  if(S.replyTo) fd.append('parent_id', S.replyTo);
  for(const id of S.mentionIds) if(text.includes('@' + userName(id))) fd.append('mentions', id);
  for(const f of S.pendingFiles) fd.append('files', f);
  sending = true; $('btn-send').disabled = true;
  try {
    const m = await api('POST', `/chat/api/conversations/${S.current}/messages`, fd);
    upsertMessage(m);
    composer.value = ''; S.pendingFiles = []; S.replyTo = null; S.mentionIds.clear();
    renderPending(); renderBanner(); renderMessages(true); onConvMessage(m);
  } catch(e){ toast(e.message, true); }
  finally { sending = false; $('btn-send').disabled = false; autosize(); composer.focus(); }
}

let lastTyping = 0;
function sendTyping(){
  if(!S.current || Date.now() - lastTyping < 3000 || !composer.value) return;
  lastTyping = Date.now();
  fetch(`/chat/api/conversations/${S.current}/typing`, {method:'POST', credentials:'same-origin'}).catch(() => {});
}
function renderTyping(){
  const now = Date.now();
  const names = Object.entries(S.typing[S.current] || {}).filter(([,t]) => now - t < 5000).map(([id]) => userName(id).split(' ')[0]);
  $('chat-typing').textContent = names.length ? names.join(', ') + (names.length > 1 ? ' schreiben…' : ' schreibt…') : '';
}
setInterval(renderTyping, 1500);

// ── @-Erwaehnungen ──────────────────────────────────────
const mention = {open:false, start:0, items:[], sel:0};
function onMentionInput(){
  const pos = composer.selectionStart; const before = composer.value.slice(0, pos);
  const m = before.match(/(^|\s)@([^\s@]{0,30})$/);
  const c = S.convs[S.current];
  if(!m || !c){ closeMention(); return; }
  const q = m[2].toLowerCase();
  const pool = c.kind === 'channel' ? (S.teams.find(t => t.id === c.team_id)?.members || []) : (c.members || []);
  mention.items = pool.filter(id => id !== ME && userName(id).toLowerCase().includes(q)).slice(0, 8);
  if(!mention.items.length){ closeMention(); return; }
  mention.open = true; mention.start = pos - m[2].length - 1; mention.sel = 0; drawMention();
}
function drawMention(){
  const pop = $('mention-pop'); pop.style.display = '';
  pop.innerHTML = mention.items.map((id, i) => `<div class="${i === mention.sel ? 'sel' : ''}" onmousedown="event.preventDefault();Chat.pickMention(${i})">${avatar(id, 'sm')} ${esc(userName(id))}</div>`).join('');
}
function closeMention(){ mention.open = false; $('mention-pop').style.display = 'none'; }
function mentionKey(e){
  e.preventDefault();
  if(e.key === 'ArrowDown') mention.sel = (mention.sel + 1) % mention.items.length;
  else if(e.key === 'ArrowUp') mention.sel = (mention.sel - 1 + mention.items.length) % mention.items.length;
  else if(e.key === 'Escape') return closeMention();
  else return pickMention(mention.sel);
  drawMention();
}
function pickMention(i){
  const id = mention.items[i]; const pos = composer.selectionStart;
  const ins = '@' + userName(id) + ' ';
  composer.value = composer.value.slice(0, mention.start) + ins + composer.value.slice(pos);
  const np = mention.start + ins.length; composer.setSelectionRange(np, np);
  S.mentionIds.add(id); closeMention(); composer.focus();
}

// ── Aktionen ────────────────────────────────────────────
async function react(id, emoji){
  try { const m = await api('POST', `/chat/api/messages/${id}/react`, {emoji}); upsertMessage(m); renderMessages(); } catch(e){ toast(e.message, true); }
}
function reply(id){ S.replyTo = id; S.editing = null; renderBanner(); composer.focus(); }
function quote(id){
  const m = (S.msgs[S.current]||[]).find(x => x.id === id); if(!m) return;
  composer.value = '> ' + userName(m.user_id) + ': ' + m.body.split('\n').join('\n> ') + '\n' + composer.value; autosize(); composer.focus();
}
function edit(id){
  const m = (S.msgs[S.current]||[]).find(x => x.id === id); if(!m) return;
  S.editing = id; S.replyTo = null; composer.value = m.body; renderBanner(); autosize(); composer.focus();
}
async function del(id){
  if(!confirm('Nachricht löschen?')) return;
  try { const m = await api('POST', `/chat/api/messages/${id}/delete`); upsertMessage(m); renderMessages(); } catch(e){ toast(e.message, true); }
}
function toggleEmoji(){
  const pop = $('emoji-pop');
  if(pop.style.display === 'none'){
    pop.innerHTML = S.emojis.map(e => `<button onclick="Chat.insertEmoji('${e}')">${e}</button>`).join('');
    pop.style.display = 'flex';
  } else pop.style.display = 'none';
}
function insertEmoji(e){
  const p = composer.selectionStart;
  composer.value = composer.value.slice(0, p) + e + composer.value.slice(p);
  $('emoji-pop').style.display = 'none'; composer.focus(); composer.setSelectionRange(p + e.length, p + e.length);
}
async function toggleMute(){
  const c = S.convs[S.current]; if(!c) return;
  try { const d = await api('POST', `/chat/api/conversations/${c.id}/mute`); c.muted = d.muted; renderHead(); renderList(); } catch(e){ toast(e.message, true); }
}
async function direct(uid){
  try { const d = await api('POST', '/chat/api/direct', {user_id: uid}); $('chat-filter').value = ''; await bootstrap(); open(d.id); } catch(e){ toast(e.message, true); }
}

// ── Seitenleiste (Mitglieder / Dateien / Suche) ─────────
function toggleSide(which){
  S.side = S.side === which ? null : which;
  root.classList.toggle('side-open', !!S.side);
  ['members','files','search'].forEach(k => $('btn-' + k).classList.toggle('on', S.side === k));
  if(S.side) renderSide();
}
async function renderSide(){
  const c = S.convs[S.current]; const body = $('chat-side-body');
  if(!c || !S.side) return;
  if(S.side === 'members'){
    $('chat-side-title').textContent = 'Mitglieder';
    const team = c.kind === 'channel' ? S.teams.find(t => t.id === c.team_id) : null;
    const ids = team ? team.members : c.members;
    let html = '';
    if(c.kind === 'group') html += `<button class="btn btn-small" style="width:100%;margin-bottom:8px" onclick="Chat.addToGroup()"><i class="ti ti-user-plus"></i> Personen hinzufügen</button>`;
    if(team && (team.role === 'owner' || S.isAdmin)) html += `<button class="btn btn-small" style="width:100%;margin-bottom:8px" onclick="Chat.teamMembers('${team.id}')"><i class="ti ti-user-plus"></i> Teammitglieder verwalten</button>`;
    html += (ids||[]).map(id => `<div class="side-row">${avatar(id, 'sm')}<div class="t">${esc(userName(id))}<small>${team && team.owners.includes(id) ? 'Besitzer · ' : ''}${esc(S.users[id]?.department || '')}</small></div>
      ${id !== ME ? `<button title="Chat" onclick="Chat.direct('${id}')"><i class="ti ti-message"></i></button>` : ''}</div>`).join('');
    html += '<div style="margin-top:12px;display:flex;flex-direction:column;gap:6px">';
    if(c.kind === 'group') html += `<button class="btn btn-small" onclick="Chat.rename()"><i class="ti ti-pencil"></i> Umbenennen</button><button class="btn btn-small" onclick="Chat.leave()"><i class="ti ti-logout"></i> Chat verlassen</button>`;
    if(team && (team.role === 'owner' || S.isAdmin)) html += `<button class="btn btn-small" onclick="Chat.rename()"><i class="ti ti-pencil"></i> Kanal bearbeiten</button><button class="btn btn-small" onclick="Chat.archive()"><i class="ti ti-archive"></i> Kanal archivieren</button>`;
    if(team) html += `<button class="btn btn-small" onclick="Chat.leaveTeam('${team.id}')"><i class="ti ti-logout"></i> Team verlassen</button>`;
    body.innerHTML = html + '</div>';
  } else if(S.side === 'files'){
    $('chat-side-title').textContent = 'Dateien';
    body.innerHTML = '<div style="color:var(--muted);font-size:12px">Wird geladen…</div>';
    try {
      const files = await api('GET', `/chat/api/conversations/${c.id}/files`);
      body.innerHTML = files.map(f => `<a class="side-row" href="${f.url}" target="_blank" rel="noopener"><i class="ti ${f.is_image ? 'ti-photo' : 'ti-file'}" style="font-size:18px;color:var(--accent)"></i><div class="t">${esc(f.name)}<small>${esc(userName(f.user_id))} · ${fmtShort(f.created_at)} · ${fmtSize(f.size)}</small></div></a>`).join('')
        || '<div style="color:var(--muted);font-size:12px">Noch keine Dateien geteilt</div>';
    } catch(e){ body.textContent = e.message; }
  } else {
    $('chat-side-title').textContent = 'Nachrichten durchsuchen';
    body.innerHTML = `<input class="form-input" id="side-q" placeholder="Suchbegriff (alle Chats)" style="margin-bottom:8px"><div id="side-hits"></div>`;
    let t; $('side-q').addEventListener('input', e => { clearTimeout(t); t = setTimeout(() => search(e.target.value), 300); });
    $('side-q').focus();
  }
}
async function search(q){
  const box = $('side-hits'); if(!box) return;
  if(q.trim().length < 2){ box.innerHTML = ''; return; }
  const hits = await api('GET', '/chat/api/search?q=' + encodeURIComponent(q));
  box.innerHTML = hits.map(h => { const c = S.convs[h.conversation_id];
    return `<div class="hit" onclick="Chat.jump('${h.conversation_id}','${h.id}')"><small>${esc(c ? convName(c) : '')} · ${esc(userName(h.user_id))} · ${fmtShort(h.created_at)}</small>${esc(h.body)}</div>`; }).join('')
    || '<div style="color:var(--muted);font-size:12px">Keine Treffer</div>';
}
async function jump(convId, msgId){
  await open(convId);
  let el = document.getElementById('m-' + msgId);
  for(let i = 0; !el && S.hasMore[convId] && i < 10; i++){ await loadMessages(convId, true); renderMessages(); el = document.getElementById('m-' + msgId); }
  if(el){ el.scrollIntoView({block:'center'}); el.querySelector('.bubble')?.animate([{background:'rgba(245,158,11,.35)'},{background:'transparent'}], {duration:1800}); }
}

// ── Dialoge ─────────────────────────────────────────────
let modalAction = null;
function closeModal(){ document.querySelectorAll('.chat-modal').forEach(m => m.classList.remove('open')); }
function peopleModal(title, okLabel, extraHtml, exclude, onOk){
  const picked = new Set();
  $('people-title').textContent = title; $('people-ok').textContent = okLabel;
  $('people-extra').innerHTML = extraHtml || ''; $('people-error').textContent = ''; $('people-filter').value = '';
  const draw = () => {
    const f = $('people-filter').value.toLowerCase();
    $('people-chips').innerHTML = [...picked].map(id => `<span data-id="${id}">${esc(userName(id))} ✕</span>`).join('');
    $('people-list').innerHTML = Object.values(S.users).filter(u => u.id !== ME && !(exclude||[]).includes(u.id) && (!f || u.name.toLowerCase().includes(f) || (u.department||'').toLowerCase().includes(f)))
      .map(u => `<label><input type="checkbox" value="${u.id}" ${picked.has(u.id) ? 'checked' : ''}> ${avatar(u.id, 'sm')} ${esc(u.name)} <small style="color:var(--muted)">${esc(u.department||'')}</small></label>`).join('');
  };
  $('people-list').onchange = e => { if(e.target.checked) picked.add(e.target.value); else picked.delete(e.target.value); draw(); };
  $('people-chips').onclick = e => { const id = e.target.dataset.id; if(id){ picked.delete(id); draw(); } };
  $('people-filter').oninput = draw;
  $('people-ok').onclick = async () => { try { await onOk([...picked]); closeModal(); } catch(e){ $('people-error').textContent = e.message; } };
  draw(); $('modal-people').classList.add('open'); $('people-filter').focus();
}
function textModal(title, name, desc, onOk){
  $('text-title').textContent = title; $('text-name').value = name || ''; $('text-desc').value = desc || ''; $('text-error').textContent = '';
  $('text-ok').onclick = async () => { try { await onOk($('text-name').value.trim(), $('text-desc').value.trim()); closeModal(); } catch(e){ $('text-error').textContent = e.message; } };
  $('modal-text').classList.add('open'); $('text-name').focus();
}
function openNewChat(){
  peopleModal('Neuer Chat', 'Chat starten', `<div class="form-group"><label class="form-label">Gruppenname (optional, ab 2 Personen)</label><input class="form-input" id="group-name" maxlength="100"></div>`, [], async ids => {
    if(!ids.length) throw new Error('Bitte mindestens eine Person auswählen');
    if(ids.length === 1) return direct(ids[0]);
    const d = await api('POST', '/chat/api/groups', {name: $('group-name').value.trim(), members: ids});
    await bootstrap(); open(d.id);
  });
}
function openNewTeam(){
  peopleModal('Team erstellen', 'Team erstellen', `<div class="form-group"><label class="form-label">Teamname</label><input class="form-input" id="team-name" maxlength="100"></div><div class="form-group"><label class="form-label">Beschreibung</label><input class="form-input" id="team-desc" maxlength="500"></div>`, [], async ids => {
    const d = await api('POST', '/chat/api/teams', {name: $('team-name').value.trim(), description: $('team-desc').value.trim(), members: ids});
    await bootstrap(); open(d.channel_id);
  });
}
function openNewChannel(teamId){
  textModal('Neuer Kanal', '', '', async (name, desc) => { const d = await api('POST', `/chat/api/teams/${teamId}/channels`, {name, description: desc}); await bootstrap(); open(d.id); });
}
function teamMembers(teamId){
  const t = S.teams.find(t => t.id === teamId); if(!t) return;
  const owner = t.role === 'owner' || S.isAdmin;
  if(!owner){ S.side = null; const ch = sortedConvs('channel').find(c => c.team_id === teamId); if(ch){ open(ch.id).then(() => toggleSide('members')); } return; }
  const list = t.members.map(id => `<div class="side-row">${avatar(id,'sm')}<div class="t">${esc(userName(id))}<small>${t.owners.includes(id) ? 'Besitzer' : 'Mitglied'}</small></div>${id !== ME ? `<button title="Entfernen" onclick="Chat.removeTeamMember('${teamId}','${id}')"><i class="ti ti-user-minus"></i></button>` : ''}</div>`).join('');
  peopleModal('Team „' + t.name + '“ – Mitglieder', 'Hinzufügen', `<div style="margin-bottom:10px;max-height:180px;overflow:auto">${list}</div><label style="font-size:12px;display:flex;gap:6px;align-items:center;margin-bottom:8px"><input type="checkbox" id="as-owner"> Als Besitzer hinzufügen</label>`, t.members, async ids => {
    if(!ids.length) throw new Error('Bitte Personen auswählen');
    await api('POST', `/chat/api/teams/${teamId}/members`, {members: ids, owner: $('as-owner').checked});
    await bootstrap();
  });
}
async function removeTeamMember(teamId, uid){
  if(!confirm(userName(uid) + ' aus dem Team entfernen?')) return;
  try { await api('POST', `/chat/api/teams/${teamId}/members/${uid}/remove`); closeModal(); await bootstrap(); } catch(e){ toast(e.message, true); }
}
function addToGroup(){
  const c = S.convs[S.current];
  peopleModal('Personen hinzufügen', 'Hinzufügen', '', c.members, async ids => { await api('POST', `/chat/api/conversations/${c.id}/members`, {members: ids}); await bootstrap(); renderSide(); });
}
function rename(){
  const c = S.convs[S.current];
  textModal(c.kind === 'channel' ? 'Kanal bearbeiten' : 'Gruppe umbenennen', c.name, c.description, async (name, desc) => { await api('POST', `/chat/api/conversations/${c.id}/rename`, {name, description: desc}); await bootstrap(); });
}
async function leave(){
  if(!confirm('Chat verlassen?')) return;
  try { await api('POST', `/chat/api/conversations/${S.current}/leave`); S.current = null; toggleSide(null); await bootstrap(); showWelcome(); } catch(e){ toast(e.message, true); }
}
async function leaveTeam(teamId){
  if(!confirm('Team verlassen?')) return;
  try { await api('POST', `/chat/api/teams/${teamId}/leave`); S.current = null; toggleSide(null); await bootstrap(); showWelcome(); } catch(e){ toast(e.message, true); }
}
async function archive(){
  if(!confirm('Kanal archivieren? Er verschwindet für alle Teammitglieder.')) return;
  try { await api('POST', `/chat/api/channels/${S.current}/archive`); S.current = null; toggleSide(null); await bootstrap(); showWelcome(); } catch(e){ toast(e.message, true); }
}

// ── Echtzeit ────────────────────────────────────────────
function onConvMessage(m){
  const c = S.convs[m.conversation_id]; if(!c) return;
  c.last_message_at = m.created_at;
  if(!m.parent_id || c.kind !== 'channel') c.preview = {user_id: m.user_id, body: m.body, kind: m.kind, created_at: m.created_at};
}
function notify(m){
  const c = S.convs[m.conversation_id];
  if(!c || c.muted || m.user_id === ME || m.kind !== 'text') return;
  if(!document.hidden && S.current === c.id) return;
  if('Notification' in window && Notification.permission === 'granted'){
    const n = new Notification(userName(m.user_id) + (c.kind !== 'direct' ? ' in ' + convName(c) : ''), {body: m.body || '📎 Datei', tag: c.id});
    n.onclick = () => { window.focus(); open(c.id); n.close(); };
  }
}
function connect(){
  const es = new EventSource('/chat/stream');
  es.addEventListener('chat', async e => {
    const ev = JSON.parse(e.data); const d = ev.data;
    switch(ev.type){
      case 'hello': S.online = new Set(d.online || []); renderList(); if(S.current) renderHead(); break;
      case 'presence':
        if(d.online) S.online.add(d.user_id); else S.online.delete(d.user_id);
        document.querySelectorAll(`[data-presence="${d.user_id}"]`).forEach(el => el.classList.toggle('on', d.online));
        if(S.current) renderHead();
        break;
      case 'message': {
        if(!S.convs[d.conversation_id]){ await bootstrap(); }
        const c = S.convs[d.conversation_id]; if(!c) break;
        const had = (S.msgs[c.id]||[]).some(x => x.id === d.id);
        upsertMessage(d); onConvMessage(d);
        if(!had && d.user_id !== ME && d.kind === 'text'){
          if(S.current === c.id && !document.hidden) markRead();
          else { c.unread++; if((d.mentions||[]).includes(ME)) c.mentions++; }
          notify(d);
        }
        if(S.typing[c.id]) delete S.typing[c.id][d.user_id];
        if(S.current === c.id) renderMessages();
        renderList();
        break; }
      case 'message_updated': upsertMessage(d); if(S.current === d.conversation_id) renderMessages(); break;
      case 'read':
        if(d.user_id === ME){ const c = S.convs[d.conversation_id]; if(c){ c.unread = 0; c.mentions = 0; renderList(); } }
        else { (S.reads[d.conversation_id] = S.reads[d.conversation_id] || {})[d.user_id] = d.at; const c = S.convs[d.conversation_id]; if(c && c.reads) c.reads[d.user_id] = d.at; if(S.current === d.conversation_id) renderMessages(); }
        break;
      case 'typing': (S.typing[d.conversation_id] = S.typing[d.conversation_id] || {})[d.user_id] = Date.now(); renderTyping(); break;
      case 'refresh': await bootstrap(); break;
    }
  });
  es.onerror = () => { /* EventSource verbindet selbst neu */ };
}

// ── Oeffentliche API fuer onclick ────────────────────────
window.Chat = { open, send, react, reply, quote, edit, del, toggleEmoji, insertEmoji, toggleMute, direct, toggleSide, jump,
  openNewChat, openNewTeam, openNewChannel, teamMembers, removeTeamMember, addToGroup, rename, leave, leaveTeam, archive, closeModal,
  pickMention, back: () => { root.classList.remove('show-main'); },
  cancel: () => { S.replyTo = null; S.editing = null; composer.value = ''; renderBanner(); autosize(); },
  unfile: i => { S.pendingFiles.splice(i, 1); renderPending(); },
  older: async () => { const box = $('chat-msgs'); const h = box.scrollHeight; await loadMessages(S.current, true); renderMessages(); box.scrollTop = box.scrollHeight - h; },
};
$('chat-filter').addEventListener('input', renderList);
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });

(async () => {
  if(S.share){ $('chat-share-title').textContent = S.share.title || S.share.url; $('chat-share-hint').style.display = ''; }
  try { await bootstrap(); } catch(e){ $('chat-list').innerHTML = `<div class="chat-empty">${esc(e.message)}</div>`; return; }
  connect();
  const m = location.hash.match(/c=([0-9a-f-]{36})/);
  if(m && S.convs[m[1]]) open(m[1]);
  if('Notification' in window && Notification.permission === 'default'){
    document.addEventListener('click', () => Notification.requestPermission(), {once: true});
  }
})();
})();
</script>
{{end}}
