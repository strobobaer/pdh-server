{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  {{template "icon-button" (dict "Action" "back" "Href" "/it")}}
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600"><i class="ti {{.Asset.TypeIcon}}"></i> {{.Asset.Name}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">{{.Asset.TypeLabel}} · Erstellt {{.Asset.CreatedAgo}}{{if .Asset.InfraName}} · {{.Asset.InfraName}}{{end}}</p>
  </div>
  <span id="status-badge" class="badge {{.Asset.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Asset.StatusLabel}}</span>

  <a class="btn btn-small" href="/a/{{.Asset.ID}}" title="Infoseite mit offenen Vorgängen – Ziel des QR-Codes"><i class="ti ti-qrcode"></i> QR &amp; Vorgänge</a>
  <a class="btn btn-small" href="/a/labels?it={{.Asset.ID}}" target="_blank" rel="noopener" title="QR-Etikett drucken"><i class="ti ti-printer"></i></a>
  <div style="position:relative" oncontextmenu="toggleMenu('it-menu'); return false;">
    {{template "icon-button" (dict "Action" "more" "OnClick" "toggleMenu('it-menu')")}}
    <div id="it-menu" class="win11-menu" style="display:none;position:absolute;right:0;top:36px;min-width:180px;z-index:100">
      <div style="padding:4px 8px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px">Status ändern</div>
      {{template "icon-button" (dict "Action" "activate" "ShowLabel" true "Label" "Aktiv" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"active\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
      {{template "icon-button" (dict "Action" "refresh" "ShowLabel" true "Label" "Wartung" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"maintenance\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
      {{template "icon-button" (dict "Action" "deactivate" "ShowLabel" true "Label" "Inaktiv" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"inactive\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
      {{template "icon-button" (dict "Action" "delete" "ShowLabel" true "Label" "Außer Dienst" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "HxPost" (printf "/it/%s/status-web" .Asset.ID) "HxVals" "{\"status\":\"retired\"}" "HxTarget" "#status-badge" "OnClick" "closeMenu('it-menu')")}}
    </div>
  </div>
</div>

<div class="grid2" style="grid-template-columns:1fr 340px;gap:14px;align-items:start">
  <div>
    <!-- Übersicht -->
    <div class="card">
      <div class="card-title">Übersicht</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:13px">
        <div><div style="color:var(--muted);font-size:11px">Hostname</div>{{if .Asset.Hostname}}{{.Asset.Hostname}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">IP-Adresse</div>{{if .Asset.IPAddress}}{{.Asset.IPAddress}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">MAC-Adresse</div>{{if .Asset.MACAddress}}{{.Asset.MACAddress}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Betriebssystem</div>{{if .Asset.OS}}{{.Asset.OS}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Hersteller</div>{{if .Asset.ManufacturerName}}<a href="/directory/{{.Asset.ManufacturerID}}" data-frame data-frame-title="{{.Asset.ManufacturerName}}" style="color:var(--accent)">{{.Asset.ManufacturerName}}</a>{{else if .Asset.Manufacturer}}{{.Asset.Manufacturer}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Lieferant</div>{{if .Supplier}}<a href="/directory/{{.Supplier.ID}}" data-frame data-frame-title="{{.Supplier.Name}}" style="color:var(--accent)">{{.Supplier.Name}}</a>{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Modell</div>{{if .Asset.Model}}{{.Asset.Model}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Seriennummer</div>{{if .Asset.SerialNo}}{{.Asset.SerialNo}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Standort</div>{{if .Asset.Location}}{{.Asset.Location}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Gekauft am</div>{{if .Asset.PurchasedAt}}{{.Asset.PurchasedAt}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Garantie bis</div>{{if .Asset.WarrantyUntil}}{{.Asset.WarrantyUntil}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Verantwortlich</div>{{if .Asset.ResponsibleName}}{{.Asset.ResponsibleName}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Zugewiesen an</div>{{if .Asset.AssigneeName}}{{.Asset.AssigneeName}}{{else}}Niemand{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Infrastruktur</div>{{if .Asset.InfraName}}{{.Asset.InfraName}}{{else}}—{{end}}</div>
      </div>
    </div>

    {{with .Net}}
    <!-- Netz (Abgleich mit UniFi) -->
    <div class="card it-net-card">
      <div class="card-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><i class="ti ti-network"></i> Netz
        <span class="badge {{.StateClass}}">{{.StateLabel}}</span>
        {{if .FirmwareUpdate}}<span class="badge b-amber" title="Firmware-Update verfügbar">Update</span>{{end}}
        {{if .Gone}}<span class="badge b-gray" title="Die Quelle meldet das Gerät nicht mehr">nicht mehr gemeldet</span>{{end}}
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:12px;font-size:13px">
        <div><div style="color:var(--muted);font-size:11px">Quelle</div>{{.Source}} · {{.Role}}</div>
        <div><div style="color:var(--muted);font-size:11px">Zustand seit</div>{{if .StateSince}}{{.StateSince}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Zuletzt gesehen</div>{{if .LastSeen}}{{.LastSeen}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Firmware</div>{{if .Firmware}}{{.Firmware}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Uplink</div>{{if .Uplink}}{{.Uplink}}{{else}}—{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">Überwacht</div>{{if .Monitored}}ja – Ausfall erzeugt ein Ticket{{else}}nein{{end}}</div>
        <div><div style="color:var(--muted);font-size:11px">&nbsp;</div>Karenz bis zum Alarm: {{.GraceMin}} min ({{.GraceSource}})</div>
      </div>
      {{if $.Notice}}<div class="card" role="status" style="margin:10px 0 0;border-color:var(--green)"><i class="ti ti-circle-check" style="color:var(--green)"></i> {{$.Notice}}</div>{{end}}
      {{if $.Err}}<div class="card" role="alert" style="margin:10px 0 0;border-color:var(--red);color:var(--red)"><i class="ti ti-alert-circle"></i> {{$.Err}}</div>{{end}}
      {{if .Ports}}
      <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;max-width:100%;margin-top:12px">
        <table style="min-width:420px">
          <thead><tr><th>Port</th><th>Anschluss</th><th>Zustand</th><th>Geschwindigkeit</th><th>PoE</th></tr></thead>
          <tbody>
          {{range .Ports}}<tr><td>{{.Idx}}</td><td style="font-size:12px">{{if .Connector}}{{.Connector}}{{else}}—{{end}}</td><td>{{if .Up}}<span class="badge b-green">aktiv</span>{{else}}<span class="badge b-gray">{{.State}}</span>{{end}}</td><td style="font-size:12px">{{.Speed}}</td><td style="font-size:12px">{{if .PoE}}{{.PoE}}{{else}}—{{end}}</td></tr>{{end}}
          </tbody>
        </table>
      </div>
      {{end}}
      {{if $.CanNetEdit}}
      <form method="POST" action="/it/{{$.Asset.ID}}/net-grace" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:12px 0 0">
        <label class="form-label" for="it-grace" style="margin:0">Eigene Karenz (Minuten)</label>
        <input id="it-grace" type="number" name="minutes" class="form-input" min="1" max="1440" value="{{.GraceOwn}}" placeholder="leer = Kategorie bzw. allgemein" style="width:130px;max-width:100%">
        <button type="submit" class="btn btn-small" title="Leer lassen und speichern, um den eigenen Wert zu entfernen"><i class="ti ti-clock-check"></i> Speichern</button>
      </form>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
        <form method="POST" action="/it/{{$.Asset.ID}}/net-monitor" style="margin:0">
          <input type="hidden" name="on" value="{{if .Monitored}}0{{else}}1{{end}}">
          <button type="submit" class="btn btn-small" title="Bei Ausfall ein Alarm-Ticket anlegen"><i class="ti {{if .Monitored}}ti-bell-off{{else}}ti-bell{{end}}"></i> {{if .Monitored}}Nicht mehr überwachen{{else}}Überwachen{{end}}</button>
        </form>
        <form method="POST" action="/it/{{$.Asset.ID}}/net-detach" style="margin:0" onsubmit="return confirm('Quelle trennen? Das Asset bleibt erhalten, wird aber nicht mehr mit UniFi abgeglichen und nicht mehr überwacht. Zustand und Ports werden entfernt. Rückgängig mit „Wieder verbinden“.')">
          <button type="submit" class="btn btn-small"><i class="ti ti-unlink"></i> Quelle trennen</button>
        </form>
      </div>
      {{end}}
    </div>
    {{end}}
    {{if .NetDetached}}
    <!-- Netz: Quelle getrennt -->
    <div class="card it-net-detached">
      <div class="card-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><i class="ti ti-network"></i> Netz
        <span class="badge b-gray"><i class="ti ti-unlink"></i> Quelle getrennt</span></div>
      <p style="font-size:13px;color:var(--muted);margin:0">Dieses Asset wird nicht mehr mit UniFi abgeglichen und nicht überwacht.</p>
      {{if .CanNetEdit}}
      <form method="POST" action="/it/{{.Asset.ID}}/net-reattach" style="margin:12px 0 0">
        <button type="submit" class="btn btn-small" title="Beim nächsten Abgleich wieder Zustand und Ports übernehmen"><i class="ti ti-link"></i> Wieder verbinden</button>
      </form>
      {{end}}
    </div>
    {{end}}

    <!-- Notizen -->
    <div class="card">
      <div class="card-title">Notizen</div>
      <p style="font-size:13px;line-height:1.6;color:var(--muted)">{{if .Asset.Notes}}{{.Asset.Notes}}{{else}}Keine Notizen{{end}}</p>
    </div>
  </div>

  <div>
    <!-- Bearbeiten -->
    <div class="card">
      <div class="card-title">Bearbeiten</div>
      <form method="POST" action="/it/{{.Asset.ID}}/edit-web">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input name="name" class="form-input" value="{{.Asset.Name}}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Typ</label>
          <select name="type" class="form-input">
            {{range .Types}}<option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
            {{end}}
          </select>
        </div>
        <div class="grid2" style="gap:10px">
          <div class="form-group">
            <label class="form-label">Hostname</label>
            <input name="hostname" class="form-input" value="{{.Asset.Hostname}}">
          </div>
          <div class="form-group">
            <label class="form-label">IP-Adresse</label>
            <input name="ip_address" class="form-input" value="{{.Asset.IPAddress}}">
          </div>
        </div>
        <div class="grid2" style="gap:10px">
          <div class="form-group">
            <label class="form-label">MAC-Adresse</label>
            <input name="mac_address" class="form-input" value="{{.Asset.MACAddress}}">
          </div>
          <div class="form-group">
            <label class="form-label">Betriebssystem</label>
            <input name="os" class="form-input" value="{{.Asset.OS}}">
          </div>
        </div>
        <div class="grid2" style="gap:10px">
          {{template "directory-picker" (dict "Label" "Hersteller" "TargetID" "it-edit-manufacturer-id" "Value" .Asset.ManufacturerID "LegacyValue" .Asset.Manufacturer)}}
          {{template "directory-picker" (dict "Label" "Lieferant" "TargetID" "it-edit-supplier-id" "Name" "supplier_id" "Kind" "supplier" "Value" .SupplierID)}}
          <div class="form-group">
            <label class="form-label">Modell</label>
            <input name="model" class="form-input" value="{{.Asset.Model}}">
          </div>
        </div>
        <div class="grid2" style="gap:10px">
          <div class="form-group">
            <label class="form-label">Seriennummer</label>
            <input name="serial_no" class="form-input" value="{{.Asset.SerialNo}}">
          </div>
          <div class="form-group">
            <label class="form-label">Standort</label>
            <input name="location" class="form-input" value="{{.Asset.Location}}">
          </div>
        </div>
        <div class="grid2" style="gap:10px">
          <div class="form-group">
            <label class="form-label">Gekauft am</label>
            <input type="date" name="purchased_at" class="form-input" value="{{.Asset.PurchasedAt}}">
          </div>
          <div class="form-group">
            <label class="form-label">Garantie bis</label>
            <input type="date" name="warranty_until" class="form-input" value="{{.Asset.WarrantyUntil}}">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input">
            <option value="">Nicht gesetzt</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Asset.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Zugewiesen an</label>
          <select name="assigned_to" class="form-input">
            <option value="">Niemand</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Asset.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        {{template "infra-tree-picker" (dict "TargetID" "it-detail-infra-id" "SelectedLabelID" "it-detail-infra-selected" "Label" "Infrastruktur" "Value" .Asset.InfrastructureID "SelectedLabel" .Asset.InfraName)}}
        <div class="form-group">
          <label class="form-label">Notizen</label>
          <textarea name="notes" class="form-input" rows="4">{{.Asset.Notes}}</textarea>
        </div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
    </div>
  </div>
</div>
{{end}}
