+        <div><div style="color:var(--muted);font-size:11px">MAC-Adresse</div>{{if .Asset.MACAddress}}{{.Asset.MACAddress}}{{else}}—{{end}}</div>
+        <div><div style="color:var(--muted);font-size:11px">Betriebssystem</div>{{if .Asset.OS}}{{.Asset.OS}}{{else}}—{{end}}</div>
+        <div><div style="color:var(--muted);font-size:11px">Hersteller</div>{{if .Asset.Manufacturer}}{{.Asset.Manufacturer}}{{else}}—{{end}}</div>
+        <div><div style="color:var(--muted);font-size:11px">Modell</div>{{if .Asset.Model}}{{.Asset.Model}}{{else}}—{{end}}</div>
+        <div><div style="color:var(--muted);font-size:11px">Seriennummer</div>{{if .Asset.SerialNo}}{{.Asset.SerialNo}}{{else}}—{{end}}</div>
+        <div><div style="color:var(--muted);font-size:11px">Standort</div>{{if .Asset.Location}}{{.Asset.Location}}{{else}}—{{end}}</div>
