{{/*
  Erstellungs-Assistent (create_wizard.go) – gleicher Aufbau und Stil wie der
  Abschluss-Assistent (cw-*-Klassen). Aufruf: pdhCreate() oder
  pdhCreate('ticket' | 'fault' | 'task' | 'maintenance', vorbelegung?).
  Vorbelegung: {project_id, project_label, infra_id, infra_label, stay}
  (stay: nach dem Anlegen auf der Seite bleiben und neu laden).
  Links mit data-create="art" (oder "any") und Seitenaufrufe mit ?create=art
  oeffnen den Assistenten ebenfalls.

  Leitstand-Modus (Aufruf mit dict "Board" true): ohne
  Anmeldung, statt "Wer kuemmert sich?" der Schritt "Wer meldet?" – es wird
  nicht zugewiesen, der Vorgang geht an die Broker (POST /global/create).
  Die Seite stellt window.PDH_CREATE_BOARD = {options(), onCreated()} bereit.
  Schritte: Art → Was? → Wo? → Wer? → Wann? → Anlegen.
*/}}
{{define "create-wizard"}}
<style>
.crw-types{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.crw-types button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--bg3);color:var(--text);cursor:pointer;font-family:var(--font);text-align:left}
.crw-types button:hover{border-color:var(--accent)}
.crw-types button.on{border-color:var(--accent);background:rgba(var(--accent-rgb),.12)}
.crw-types i{font-size:24px}
.crw-types b{font-size:14px}
.crw-types small{color:var(--muted);font-size:11.5px}
.crw-similar{margin-top:10px}
.crw-similar a{display:block;padding:7px 10px;border-bottom:1px solid var(--border);color:var(--text);text-decoration:none;font-size:12.5px}
.crw-similar a:last-child{border-bottom:0}
.crw-similar a:hover{background:var(--bg3)}
.crw-similar small{color:var(--muted);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.crw-pick label{display:flex;align-items:center;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border);cursor:pointer}
.crw-pick label:last-child{border-bottom:0}
.crw-pick input{width:18px;height:18px;accent-color:var(--accent)}
.crw-pick .dept{margin-left:auto;font-size:11px;color:var(--muted)}
.crw-pick .grp{color:var(--accent)}
@media (max-width:760px){.crw-types{grid-template-columns:1fr}}
</style>
<div class="cw-overlay" id="crw" role="dialog" aria-modal="true" aria-labelledby="crw-title">
  <div class="cw">
    <div class="cw-head">
      <h2 id="crw-title"><i class="ti ti-circle-plus" style="color:var(--accent)"></i> <span id="crw-label">Neu anlegen</span></h2>
      <div class="sub" id="crw-sub">Schritt für Schritt – mit „OK – weiter“ durch die Angaben.</div>
      <div class="cw-steps" id="crw-steps">
        <div class="cw-step" data-s="0"><b>1</b><span>Art</span></div>
        <div class="cw-step" data-s="1"><b>2</b><span>Was?</span></div>
        <div class="cw-step" data-s="2"><b>3</b><span>Wo?</span></div>
        <div class="cw-step" data-s="3"><b>4</b><span>{{if .Board}}Melder{{else}}Wer?{{end}}</span></div>
        <div class="cw-step" data-s="4"><b>5</b><span>Wann?</span></div>
        <div class="cw-step" data-s="5"><b>6</b><span>Anlegen</span></div>
      </div>
    </div>
    <div class="cw-body">
      <!-- 1 Art -->
      <div class="cw-pane" data-step="0">
        <h3><i class="ti ti-category"></i> Was möchtest du anlegen?</h3>
        <p class="hint">Wähle die Art des Vorgangs.</p>
        <div class="crw-types" id="crw-types">
          <button type="button" data-type="fault"><i class="ti ti-alert-triangle" style="color:var(--red)"></i><b>Störung</b><small>Etwas ist kaputt oder läuft nicht</small></button>
          <button type="button" data-type="ticket"><i class="ti ti-ticket" style="color:#60a5fa"></i><b>Ticket</b><small>Anliegen, Auftrag oder Anfrage</small></button>
          <button type="button" data-type="task"><i class="ti ti-list-check" style="color:var(--accent)"></i><b>Aufgabe</b><small>To-do mit Termin, auch für mehrere</small></button>
          <button type="button" data-type="maintenance"><i class="ti ti-tool" style="color:var(--amber)"></i><b>Wartungsauftrag</b><small>Einmalige Wartung an einer Anlage</small></button>
        </div>
      </div>
      <!-- 2 Was? -->
      <div class="cw-pane" data-step="1">
        <h3><i class="ti ti-pencil"></i> Worum geht es?</h3>
        <p class="hint">Ein kurzer, eindeutiger Titel – die Details in die Beschreibung.</p>
        <div class="form-group"><label class="form-label">Titel *</label><input data-suggest="title" class="form-input" id="crw-title-in" maxlength="200" autocomplete="off" placeholder="z. B. Presse 3 – Hydraulik verliert Öl"></div>
        <div class="form-group"><label class="form-label">Beschreibung{{if .Board}} * <small style="color:var(--muted)">(mehr als drei Wörter)</small>{{end}}</label><textarea data-suggest="description" class="form-input" id="crw-desc" rows="4" maxlength="4000" placeholder="Was genau ist los? Seit wann? Was wurde schon versucht?"></textarea></div>
        <div id="crw-sym-box" class="form-group"><label class="form-label">Symptome (mit Komma trennen)</label><input class="form-input" id="crw-sym" placeholder="z. B. Ölaustritt, Druckabfall, Geräusch"></div>
        <label class="form-label" id="crw-prio-label">Priorität</label>
        <div class="cw-chips" id="crw-prio">
          <button type="button" data-v="low">Niedrig</button><button type="button" data-v="medium" class="on">Mittel</button><button type="button" data-v="high">Hoch</button><button type="button" data-v="critical">Kritisch</button>
        </div>
        <div id="crw-mtype-box"><label class="form-label">Art der Wartung</label>
          <div class="cw-chips" id="crw-mtype"><button type="button" data-v="preventive" class="on">Vorbeugend</button><button type="button" data-v="inspection">Inspektion</button><button type="button" data-v="calibration">Kalibrierung</button><button type="button" data-v="cleaning">Reinigung</button></div>
        </div>
        <div class="cw-list crw-similar" id="crw-similar" style="display:none"></div>
      </div>
      <!-- 3 Wo? -->
      <div class="cw-pane" data-step="2">
        <h3><i class="ti ti-hierarchy-2"></i> Wo? Welche Anlage ist betroffen?</h3>
        <p class="hint" id="crw-where-hint">Die Anlage bestimmt auch, welche Abteilung den Vorgang sieht. Ohne Anlage einfach weiter.</p>
        {{if .Board}}
        <input type="hidden" id="crw-infra-id"><div class="sc-sub" id="crw-infra-label" style="font-size:12.5px;margin-bottom:8px;color:var(--accent)"></div>
        <input class="form-input" id="crw-infra-q" placeholder="Anlage suchen: Gebäude, Linie, Anlage …" style="margin-bottom:8px" autocomplete="off">
        <div class="cw-list cw-people crw-pick" id="crw-infra-list" style="max-height:300px;overflow:auto"></div>
        {{else}}
        {{template "infra-tree-picker" (dict "TargetID" "crw-infra-id" "SelectedLabelID" "crw-infra-label" "Label" "Anlage")}}
        {{end}}
      </div>
      <!-- 4 Wer? (Leitstand: Wer meldet?) -->
      {{if .Board}}
      <div class="cw-pane" data-step="3">
        <h3><i class="ti ti-user-question"></i> Wer meldet?</h3>
        <p class="hint">Im Leitstand wird nicht zugewiesen: Der Vorgang geht an die <b>Broker</b>, die ihn übernehmen oder verteilen. Bitte dich selbst auswählen.</p>
        <input class="form-input" id="crw-rep-q" placeholder="Namen suchen…" style="margin-bottom:8px" autocomplete="off">
        <div class="cw-list cw-people crw-pick" id="crw-rep" style="max-height:260px;overflow:auto"></div>
        <div class="form-group" style="margin-top:10px"><label class="form-label">Abweichender Melder (optional)</label><input class="form-input" id="crw-rep-name" maxlength="120" placeholder="z. B. Besucher ohne PDH-Konto"></div>
      </div>
      {{else}}
      <div class="cw-pane" data-step="3">
        <h3><i class="ti ti-users"></i> Wer kümmert sich darum?</h3>
        <p class="hint">Eine Person oder eine ganze Gruppe zuweisen – oder offen lassen, dann verteilt es jemand später.</p>
        <div class="cw-chips" id="crw-who-quick"><button type="button" data-q="me"><i class="ti ti-user"></i> Ich selbst</button><button type="button" data-q="none">Niemand (offen)</button></div>
        <input class="form-input" id="crw-people-q" placeholder="Name oder Gruppe suchen…" style="margin-bottom:8px" autocomplete="off">
        <div class="cw-list cw-people crw-pick" id="crw-people"></div>
        <div class="form-group" style="margin-top:10px"><label class="form-label">Verantwortlich (optional)</label><select class="form-input" id="crw-resp"><option value="">– niemand –</option></select></div>
      </div>
      {{end}}
      <!-- 5 Wann? -->
      <div class="cw-pane" data-step="4">
        <h3><i class="ti ti-calendar"></i> Bis wann?</h3>
        <p class="hint" id="crw-when-hint">Fälligkeit wählen – oder ein Datum eintragen.</p>
        <div class="cw-chips" id="crw-due-quick"></div>
        <div class="cw-time">
          <div><label class="form-label">Fällig am</label><input class="form-input" id="crw-due" type="date"></div>
          <div id="crw-start-box"><label class="form-label">Start (Aufgabe)</label><input class="form-input" id="crw-start" type="date"></div>
        </div>
      </div>
      <!-- 6 Anlegen -->
      <div class="cw-pane" data-step="5">
        <h3><i class="ti ti-flag-check"></i> Alles richtig?</h3>
        <dl class="cw-sum" id="crw-sum"></dl>
        {{if .Board}}<p class="hint"><b>Anlegen</b> erstellt den Vorgang und verteilt ihn an die Broker. <b>Anlegen &amp; nächster</b> beginnt gleich den nächsten derselben Art.</p>
        {{else}}<p class="hint"><b>Anlegen</b> erstellt den Vorgang und öffnet ihn. <b>Anlegen &amp; nächster</b> erstellt ihn und beginnt gleich den nächsten derselben Art.</p>{{end}}
      </div>
      <div class="cw-msg" id="crw-msg"></div>
    </div>
    <div class="cw-foot">
      <button type="button" class="btn" onclick="crwClose()">Abbrechen</button>
      <span class="grow"></span>
      <button type="button" class="btn" id="crw-back" onclick="crwGo(-1)"><i class="ti ti-arrow-left"></i> Zurück</button>
      <button type="button" class="btn btn-primary" id="crw-next" onclick="crwGo(1)">OK – weiter <i class="ti ti-arrow-right"></i></button>
      <button type="button" class="btn cw-more" id="crw-again" onclick="crwSubmit(true)" style="display:none"><i class="ti ti-repeat"></i> Anlegen &amp; nächster</button>
      <button type="button" class="btn cw-finish" id="crw-create" onclick="crwSubmit(false)" style="display:none"><i class="ti ti-check"></i> Anlegen</button>
    </div>
  </div>
</div>
<script>
(function(){
  const $ = id => document.getElementById(id);
  const TYPES = {
    fault:       {label: 'Störung',         icon: 'ti-alert-triangle', api: '/api/v1/faults/',           ref: 'fault',            url: '/faults/'},
    ticket:      {label: 'Ticket',          icon: 'ti-ticket',         api: '/api/v1/tickets/',          ref: 'ticket',           url: '/tickets/'},
    task:        {label: 'Aufgabe',         icon: 'ti-list-check',     api: '/api/v1/tasks/',            ref: 'task',             url: '/tasks/'},
    maintenance: {label: 'Wartungsauftrag', icon: 'ti-tool',           api: '/api/v1/maintenance/tasks', ref: 'maintenance_task', url: '/maintenance/tasks/'}
  };
  const PRIO = {low: 'Niedrig', medium: 'Mittel', high: 'Hoch', critical: 'Kritisch'};
  const MTYPE = {preventive: 'Vorbeugend', inspection: 'Inspektion', calibration: 'Kalibrierung', cleaning: 'Reinigung'};
  let st = null, opts = null, simTimer = null;

  function chips(id, onPick){
    $(id).addEventListener('click', e => {
      const b = e.target.closest('button'); if(!b) return;
      $(id).querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
      if(onPick) onPick(b);
    });
  }
  const chipVal = id => { const b = $(id).querySelector('button.on'); return b ? b.dataset.v : ''; };
  const iso = d => d.toISOString().slice(0, 10);
  const addDays = n => { const d = new Date(); d.setDate(d.getDate() + n); return iso(d); };
  function msg(text, cls){ const m = $('crw-msg'); m.textContent = text || ''; m.className = 'cw-msg' + (cls ? ' ' + cls : ''); }
  // Leitstand-Modus: keine Zuweisung, Melder statt Zustaendigem, Verteilung an die Broker
  const BOARD = {{.Board}};
  const escapeHtml = window.escapeHtml || (s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c])));
  const words = s => s.trim().split(/\s+/).filter(Boolean).length;

  async function loadOpts(){
    if(BOARD){
      // Listen kommen von der Leitstand-Seite (ohne Anmeldung, /global/data)
      const b = window.PDH_CREATE_BOARD;
      opts = b && b.options ? b.options() : null;
      if(!opts || !(opts.people || []).length) throw new Error('Die Auswahllisten sind noch nicht geladen – bitte kurz warten.');
      opts.groups = [];
      return opts;
    }
    if(opts) return opts;
    const res = await fetch('/create/options', {credentials: 'same-origin'});
    if(!res.ok) throw new Error('Auswahllisten konnten nicht geladen werden (HTTP ' + res.status + ')');
    opts = await res.json();
    const sel = $('crw-resp');
    opts.people.forEach(p => { const o = document.createElement('option'); o.value = p.id; o.textContent = p.name + (p.department ? ' (' + p.department + ')' : ''); sel.appendChild(o); });
    return opts;
  }

  // Schritte je Art: 0 Art wird uebersprungen, wenn die Art vorgegeben ist
  function steps(){
    let l = [0, 1, 2, 3, 4, 5];
    if(st.fixedType) l = l.filter(x => x !== 0);
    if(BOARD && st.type === 'fault') l = l.filter(x => x !== 4); // Stoerungen ohne Termin
    return l;
  }

  function render(){
    const list = steps(), cur = list[st.i];
    document.querySelectorAll('#crw .cw-pane').forEach(p => p.classList.toggle('on', +p.dataset.step === cur));
    document.querySelectorAll('#crw-steps .cw-step').forEach(s => {
      const n = +s.dataset.s, pos = list.indexOf(n);
      s.style.display = pos < 0 ? 'none' : '';
      s.classList.toggle('on', n === cur);
      s.classList.toggle('ok', pos >= 0 && pos < st.i);
      if(pos >= 0) s.querySelector('b').textContent = pos + 1;
    });
    const t = TYPES[st.type];
    $('crw-label').textContent = t ? t.label + ' anlegen' : 'Neu anlegen';
    $('crw-title').querySelector('i').className = 'ti ' + (t ? t.icon : 'ti-circle-plus');
    $('crw-back').style.visibility = st.i > 0 ? '' : 'hidden';
    const last = cur === 5;
    $('crw-next').style.display = last ? 'none' : '';
    $('crw-create').style.display = last ? '' : 'none';
    $('crw-again').style.display = last ? '' : 'none';
    // artabhaengige Felder
    $('crw-sym-box').style.display = st.type === 'fault' ? '' : 'none';
    $('crw-mtype-box').style.display = st.type === 'maintenance' ? '' : 'none';
    $('crw-prio-label').textContent = st.type === 'fault' ? 'Schweregrad' : 'Priorität';
    $('crw-start-box').style.display = st.type === 'task' ? '' : 'none';
    $('crw-where-hint').textContent = st.type === 'maintenance'
      ? 'Für einen Wartungsauftrag ist die Anlage Pflicht.'
      : 'Die Anlage bestimmt auch, welche Abteilung den Vorgang sieht. Ohne Anlage einfach weiter.';
    if(BOARD){
      document.querySelectorAll('#crw-types button').forEach(b => { b.style.display = opts && (opts.types || []).includes(b.dataset.type) ? '' : 'none'; });
      $('crw-where-hint').textContent = st.type === 'task' ? 'Für eine Aufgabe ist die Anlage optional.' : 'Bitte die betroffene Anlage auswählen – Pflicht.';
      if(cur === 2) renderInfra();
      if(cur === 3) renderReporters();
    } else if(cur === 3) renderPeople();
    if(cur === 4) renderDue();
    if(cur === 5) renderSum();
    if(cur === 1) setTimeout(() => $('crw-title-in').focus(), 30);
    msg('');
  }

  function renderPeople(){
    const q = $('crw-people-q').value.trim().toLowerCase();
    const box = $('crw-people');
    const match = s => !q || s.toLowerCase().includes(q);
    const rows = [];
    (opts.groups || []).filter(g => match(g.name + ' ' + g.department)).forEach(g => rows.push(
      '<label><input type="radio" name="crw-who" value="g:' + g.id + '"' + (st.who === 'g:' + g.id ? ' checked' : '') + '><span class="grp"><i class="ti ti-users-group"></i> ' + escapeHtml(g.name) + '</span><span class="dept">' + escapeHtml(g.department || '') + ' · ' + g.members + ' Mitglieder</span></label>'));
    opts.people.filter(p => match(p.name + ' ' + p.department)).forEach(p => rows.push(
      '<label><input type="radio" name="crw-who" value="' + p.id + '"' + (st.who === p.id ? ' checked' : '') + '><span>' + escapeHtml(p.name) + '</span><span class="dept">' + escapeHtml(p.department || '') + '</span></label>'));
    box.innerHTML = rows.join('') || '<div class="cw-empty">Niemand gefunden</div>';
  }

  function renderDue(){
    const def = (opts.due_days || {})[st.type] || 7;
    const quick = [['Heute', 0], ['Morgen', 1], ['In 3 Tagen', 3], ['In 1 Woche', 7], ['In 2 Wochen', 14], ['Standard (' + def + ' Tage)', def]];
    $('crw-due-quick').innerHTML = quick.map(q => '<button type="button" data-d="' + addDays(q[1]) + '"' + (st.due === addDays(q[1]) ? ' class="on"' : '') + '>' + q[0] + '</button>').join('');
    if(!st.dueTouched && !st.due){ st.due = addDays(def); }
    $('crw-due').value = st.due || '';
    $('crw-due-quick').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.d === st.due));
    if(st.type === 'task' && !$('crw-start').value) $('crw-start').value = iso(new Date());
  }

  function whoLabel(){
    if(!st.who) return 'niemand (offen)';
    if(st.who.startsWith('g:')){ const g = opts.groups.find(x => 'g:' + x.id === st.who); return g ? 'Gruppe ' + g.name : st.who; }
    const p = opts.people.find(x => x.id === st.who); return p ? p.name : st.who;
  }

  function renderInfra(){
    const q = $('crw-infra-q').value.trim().toLowerCase(), cur = $('crw-infra-id').value;
    const list = (opts.infra || []).filter(x => !q || x.name.toLowerCase().includes(q)).slice(0, 300);
    $('crw-infra-list').innerHTML = list.map(x => '<label><input type="radio" name="crw-infra" value="' + escapeHtml(x.id) + '"' + (x.id === cur ? ' checked' : '') + '><span>' + escapeHtml(x.name) + '</span></label>').join('')
      || '<div class="cw-empty">Keine Anlage gefunden</div>';
  }

  function renderReporters(){
    const q = $('crw-rep-q').value.trim().toLowerCase();
    const list = (opts.people || []).filter(p => !q || p.name.toLowerCase().includes(q));
    $('crw-rep').innerHTML = list.map(p => '<label><input type="radio" name="crw-rep" value="' + escapeHtml(p.id) + '"' + (p.id === st.rep ? ' checked' : '') + '><span>' + escapeHtml(p.name) + '</span></label>').join('')
      || '<div class="cw-empty">Niemand gefunden</div>';
  }

  function repLabel(){
    const p = (opts.people || []).find(x => x.id === st.rep), other = $('crw-rep-name').value.trim();
    return (p ? p.name : '–') + (other ? ' · gemeldet von ' + other : '');
  }

  function renderSum(){
    if(BOARD){
      const rows = [
        ['Art', TYPES[st.type].label + (st.type === 'maintenance' ? ' · ' + MTYPE[chipVal('crw-mtype')] : '')],
        ['Titel', $('crw-title-in').value.trim()],
        ['Beschreibung', $('crw-desc').value.trim()],
        [st.type === 'fault' ? 'Schweregrad' : 'Priorität', PRIO[chipVal('crw-prio')]],
        ['Anlage', $('crw-infra-id').value ? $('crw-infra-label').textContent.trim() : '–'],
        ['Melder', repLabel()],
        ['Zuweisung', 'keine – geht an die Broker']
      ];
      if(st.type === 'fault' && $('crw-sym').value.trim()) rows.splice(3, 0, ['Symptome', $('crw-sym').value.trim()]);
      if(st.type !== 'fault') rows.push(['Fällig', $('crw-due').value ? new Date($('crw-due').value + 'T00:00:00').toLocaleDateString('de-DE') : 'Standard']);
      $('crw-sum').innerHTML = rows.map(r => '<dt>' + escapeHtml(r[0]) + '</dt><dd>' + escapeHtml(r[1]) + '</dd>').join('');
      return;
    }
    const sel = $('crw-resp'), resp = sel.value ? sel.options[sel.selectedIndex].textContent : '–';
    const rows = [
      ['Art', TYPES[st.type].label + (st.type === 'maintenance' ? ' · ' + MTYPE[chipVal('crw-mtype')] : '')],
      ['Titel', $('crw-title-in').value.trim()],
      ['Beschreibung', $('crw-desc').value.trim() || '–'],
      [st.type === 'fault' ? 'Schweregrad' : 'Priorität', PRIO[chipVal('crw-prio')]],
      ['Anlage', $('crw-infra-id').value ? $('crw-infra-label').textContent.trim() : '–'],
      ['Zugewiesen', whoLabel()],
      ['Verantwortlich', resp],
      ['Fällig', $('crw-due').value ? new Date($('crw-due').value + 'T00:00:00').toLocaleDateString(window.PDH_LOCALE || 'de-DE') : '–']
    ];
    if(st.type === 'fault' && $('crw-sym').value.trim()) rows.splice(3, 0, ['Symptome', $('crw-sym').value.trim()]);
    if(st.type === 'task' && st.preset.project_label) rows.splice(1, 0, ['Projekt', st.preset.project_label]);
    $('crw-sum').innerHTML = rows.map(r => '<dt>' + escapeHtml(r[0]) + '</dt><dd>' + escapeHtml(r[1]) + '</dd>').join('');
  }

  // aehnliche geloeste Stoerungen schon waehrend der Erfassung
  async function similar(){
    const box = $('crw-similar');
    if(BOARD || st.type !== 'fault'){ box.style.display = 'none'; return; }
    const title = $('crw-title-in').value.trim(), desc = $('crw-desc').value.trim();
    if((title + desc).length < 4){ box.style.display = 'none'; return; }
    try{
      const res = await fetch('/create/similar?' + new URLSearchParams({title, description: desc, infra: $('crw-infra-id').value}), {credentials: 'same-origin'});
      const list = await res.json();
      if(!Array.isArray(list) || !list.length){ box.style.display = 'none'; return; }
      box.innerHTML = '<div class="cw-row" style="font-size:11.5px;color:var(--muted)"><i class="ti ti-brain"></i> Ähnliche gelöste Störungen – vielleicht hilft die Lösung schon:</div>' +
        list.map(f => '<a href="/faults/' + encodeURIComponent(f.id) + '" target="_blank" rel="noopener">' + escapeHtml(f.title) + ' <span style="color:var(--green);font-size:11px">' + f.percent + ' %</span>' +
          (f.resolution ? '<small>Lösung: ' + escapeHtml(f.resolution) + '</small>' : '') + '</a>').join('');
      box.style.display = '';
    }catch(e){ box.style.display = 'none'; }
  }

  function validate(cur){
    if(BOARD){
      // gleiche Regeln wie der Leitstand-Server (GlobalDashboardCreate)
      if(cur === 0 && !st.type) return 'Bitte eine Art wählen.';
      if(cur === 1 && $('crw-title-in').value.trim().length < 3) return 'Der Titel muss mindestens 3 Zeichen lang sein.';
      if(cur === 1 && words($('crw-desc').value) <= 3) return 'Bitte die Beschreibung in mehr als drei Wörtern – was ist los?';
      if(cur === 2 && st.type !== 'task' && !$('crw-infra-id').value) return 'Bitte eine Anlage auswählen.';
      if(cur === 3 && !st.rep) return 'Bitte auswählen, wer meldet.';
      return '';
    }
    if(cur === 0 && !st.type) return 'Bitte eine Art wählen.';
    if(cur === 1 && !$('crw-title-in').value.trim()) return 'Bitte einen Titel eingeben.';
    if(cur === 2 && st.type === 'maintenance' && !$('crw-infra-id').value) return 'Für einen Wartungsauftrag ist die Anlage Pflicht.';
    return '';
  }

  window.crwGo = function(dir){
    const cur = steps()[st.i];
    if(dir > 0){ const err = validate(cur); if(err){ msg(err, 'err'); return; } }
    st.i = Math.max(0, Math.min(steps().length - 1, st.i + dir));
    render();
  };

  window.crwClose = function(){ $('crw').classList.remove('open'); };

  function reset(type, preset){
    st = {type: type || '', fixedType: !!type, i: 0, who: '', rep: '', due: '', dueTouched: false, preset: preset || {}};
    ['crw-title-in', 'crw-desc', 'crw-sym', 'crw-people-q', 'crw-start', 'crw-infra-q', 'crw-rep-q', 'crw-rep-name'].forEach(id => { if($(id)) $(id).value = ''; });
    if($('crw-resp')) $('crw-resp').value = '';
    if(BOARD) $('crw-infra-label').textContent = '';
    $('crw-similar').style.display = 'none';
    document.querySelectorAll('#crw-types button').forEach(b => b.classList.toggle('on', b.dataset.type === type));
    $('crw-prio').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.v === 'medium'));
    $('crw-mtype').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.v === 'preventive'));
    const picker = document.querySelector('#crw [data-infra-picker]');
    if(picker && typeof clearInfraPicker === 'function') clearInfraPicker(picker);
    $('crw-infra-id').value = '';
    if(st.preset.infra_id){
      $('crw-infra-id').value = st.preset.infra_id;
      if(st.preset.infra_label) $('crw-infra-label').textContent = st.preset.infra_label;
    }
  }

  window.pdhCreate = async function(type, preset){
    if(type && !TYPES[type]) type = '';
    reset(type, preset);
    $('crw').classList.add('open');
    if(BOARD){
      // Arten und Listen muessen vor dem ersten Schritt feststehen
      try{ await loadOpts(); }catch(e){ render(); msg(e.message, 'err'); return; }
      if(st.type && !opts.types.includes(st.type)){ st.type = ''; st.fixedType = false; }
      render();
      return;
    }
    render();
    try{ await loadOpts(); }catch(e){ msg(e.message, 'err'); }
  };

  async function boardSubmit(again){
    const t = TYPES[st.type];
    const payload = {type: st.type, title: $('crw-title-in').value.trim(), description: $('crw-desc').value.trim(),
      priority: chipVal('crw-prio'), infrastructure_id: $('crw-infra-id').value, reporter_id: st.rep,
      reporter_name: $('crw-rep-name').value.trim(), due_date: st.type === 'fault' ? '' : $('crw-due').value};
    if(st.type === 'fault') payload.symptoms = $('crw-sym').value.split(',').map(s => s.trim()).filter(Boolean);
    if(st.type === 'maintenance') payload.maintenance_type = chipVal('crw-mtype');
    ['crw-create', 'crw-again'].forEach(id => $(id).disabled = true);
    msg('Lege an …');
    try{
      const res = await fetch('/global/create', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)});
      const j = await res.json().catch(() => ({}));
      if(!res.ok) throw new Error(j.error || ('HTTP ' + res.status));
      const b = window.PDH_CREATE_BOARD;
      if(b && b.onCreated) b.onCreated();
      const done = t.label + ' angelegt' + (j.broker ? ' – ' + j.broker : '');
      if(again){
        reset(st.type); st.fixedType = true; render();
        msg(done + ' – jetzt der nächste.', 'ok');
      } else {
        msg(done, 'ok');
        setTimeout(crwClose, 1800);
      }
    }catch(e){ msg('Nicht angelegt: ' + e.message, 'err'); }
    ['crw-create', 'crw-again'].forEach(id => $(id).disabled = false);
  }

  async function post(url, body, method){
    const res = await fetch(url, {method: method || 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
    const j = await res.json().catch(() => ({}));
    if(!res.ok || j.success === false) throw new Error(j.error || ('HTTP ' + res.status));
    return j;
  }

  window.crwSubmit = async function(again){
    if(BOARD) return boardSubmit(again);
    const t = TYPES[st.type];
    const title = $('crw-title-in').value.trim(), description = $('crw-desc').value.trim();
    const prio = chipVal('crw-prio'), infra = $('crw-infra-id').value, due = $('crw-due').value, resp = $('crw-resp').value;
    const person = st.who && !st.who.startsWith('g:') ? st.who : '';
    const group = st.who.startsWith('g:') ? st.who.slice(2) : '';
    let payload;
    if(st.type === 'ticket') payload = {title, description, priority: prio, tags: []};
    else if(st.type === 'fault') payload = {title, description, severity: prio, symptoms: $('crw-sym').value.split(',').map(s => s.trim()).filter(Boolean)};
    else if(st.type === 'task') payload = {title, description, priority: prio, due_date: due, start_date: $('crw-start').value};
    else payload = {title, description, priority: prio, type: chipVal('crw-mtype'), infrastructure_id: infra, due_date: due};
    if(infra) payload.infrastructure_id = infra;
    if(st.type === 'task' && st.preset.project_id) payload.project_id = st.preset.project_id;
    // Kostenstelle wie bisher aus der Anlage uebernehmen
    if(infra && (st.type === 'ticket' || st.type === 'fault')){
      try{
        const r = await fetch('/api/v1/infrastructure/' + encodeURIComponent(infra), {credentials: 'same-origin'});
        const j = await r.json();
        if(j && j.data && j.data.cost_center_id) payload.cost_center_id = j.data.cost_center_id;
      }catch(e){}
    }
    if(st.type === 'ticket' && due) payload.due_date = due + 'T00:00:00Z';
    if(st.type === 'task'){ if(person) payload.assigned_to_ids = [person]; if(resp) payload.responsible_to = resp; }
    else if(st.type !== 'maintenance'){ if(person) payload.assigned_to = person; if(resp) payload.responsible_to = resp; }
    else if(person) payload.assigned_to = person;
    ['crw-create', 'crw-again'].forEach(id => $(id).disabled = true);
    msg('Lege an …');
    try{
      const j = await post(t.api, payload);
      const id = j.data && j.data.id;
      if(!id) throw new Error('Keine ID in der Antwort');
      const extra = [];
      if(group) extra.push(fetch('/records/' + t.ref + '/' + encodeURIComponent(id) + '/group', {method: 'PUT', credentials: 'same-origin', body: new URLSearchParams({assigned_group_id: group})}));
      if(st.type === 'maintenance' && resp) extra.push(fetch('/records/maintenance_task/' + encodeURIComponent(id) + '/people', {method: 'PUT', credentials: 'same-origin', body: new URLSearchParams({assigned_to: person, responsible_to: resp})}));
      if(st.type === 'fault' && due) extra.push(fetch('/api/v1/faults/' + encodeURIComponent(id) + '/due-date', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({due_date: due})}));
      const results = await Promise.all(extra);
      const failed = results.filter(r => !r.ok).length;
      if(again){
        reset(st.type, st.preset); st.fixedType = true; render();
        msg(t.label + ' angelegt' + (failed ? ' (Zusatzangaben teilweise nicht gespeichert)' : '') + ' – jetzt der nächste.', failed ? 'warn' : 'ok');
      } else if(st.preset.stay){
        location.reload();
      } else {
        location.href = t.url + encodeURIComponent(id);
      }
    }catch(e){ msg('Nicht angelegt: ' + e.message, 'err'); }
    ['crw-create', 'crw-again'].forEach(id => $(id).disabled = false);
  };

  // Ereignisse
  $('crw-types').addEventListener('click', e => {
    const b = e.target.closest('button[data-type]'); if(!b) return;
    st.type = b.dataset.type;
    document.querySelectorAll('#crw-types button').forEach(x => x.classList.toggle('on', x === b));
    setTimeout(() => crwGo(1), 120);
  });
  chips('crw-prio'); chips('crw-mtype');
  chips('crw-due-quick', b => { st.due = b.dataset.d; st.dueTouched = true; $('crw-due').value = st.due; });
  $('crw-due').addEventListener('input', e => { st.due = e.target.value; st.dueTouched = true; $('crw-due-quick').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.d === st.due)); });
  if(BOARD){
    $('crw-infra-q').addEventListener('input', renderInfra);
    $('crw-infra-list').addEventListener('change', e => {
      if(e.target.name !== 'crw-infra') return;
      $('crw-infra-id').value = e.target.value;
      $('crw-infra-label').textContent = e.target.closest('label').textContent.trim();
    });
    $('crw-rep-q').addEventListener('input', renderReporters);
    $('crw-rep').addEventListener('change', e => { if(e.target.name === 'crw-rep') st.rep = e.target.value; });
  } else {
    $('crw-people-q').addEventListener('input', renderPeople);
    $('crw-people').addEventListener('change', e => { if(e.target.name === 'crw-who') st.who = e.target.value; });
    $('crw-who-quick').addEventListener('click', e => {
      const b = e.target.closest('button'); if(!b) return;
      st.who = b.dataset.q === 'me' ? (opts && opts.me) || '' : '';
      renderPeople();
    });
  }
  ['crw-title-in', 'crw-desc'].forEach(id => $(id).addEventListener('input', () => { clearTimeout(simTimer); simTimer = setTimeout(similar, 500); }));
  $('crw').addEventListener('keydown', e => {
    if(e.key === 'Escape') crwClose();
    if(e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type !== 'radio'){ e.preventDefault(); crwGo(1); }
  });
  if(BOARD) return; // im Leitstand oeffnen nur die Kacheln den Assistenten
  // "Neue Zuweisung" in der Navigation und Links mit data-create oeffnen den Assistenten
  document.addEventListener('click', e => {
    const a = e.target.closest('a[data-nav="assign"], a[href="/assignments/new"], [data-create]');
    if(a && !document.documentElement.classList.contains('nav-editing') && !e.ctrlKey && !e.metaKey){
      e.preventDefault();
      const k = a.dataset.create || '';
      pdhCreate(k === 'any' ? '' : k);
    }
  });
  // Seitenaufruf mit ?create=art (z. B. aus Schnellaktionen ohne Skript)
  function openFromURL(){
    const q = new URLSearchParams(location.search), k = q.get('create');
    if(k === null) return;
    q.delete('create');
    history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : '') + location.hash);
    pdhCreate(TYPES[k] ? k : '');
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', openFromURL); else openFromURL();
})();
</script>
{{end}}
