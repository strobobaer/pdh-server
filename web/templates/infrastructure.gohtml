{{template "base" .}}

{{define "content"}}
<style>
.infra-row{background:var(--bg3)}
.infra-fold{width:22px;height:22px;flex-shrink:0;border:0;border-radius:6px;background:none;color:var(--muted);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.infra-fold:hover{background:var(--bg2);color:var(--text)}
.infra-fold i{font-size:14px;transition:transform .2s}
</style>
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Infrastruktur-Topologie</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Stats.building}} Gebäude · {{.Stats.line}} Linien · {{.Stats.plant}} Anlagen · {{.Stats.device}} Geräte</p>
  </div>
  {{template "icon-button-toolbar" (dict
    "Class" "end"
    "Label" "Infrastruktur-Aktionen"
    "Items" (list
      (dict "Action" "expand" "ShowLabel" true "Label" "Alle aufklappen" "OnClick" "expandAll()")
      (dict "Action" "view" "ShowLabel" true "Label" "QR-Etiketten" "OnClick" "window.open('/a/labels?infra_all=1', '_blank')")
      (dict "Action" "new" "ShowLabel" true "Label" "Hinzufügen" "OnClick" (or (and .CanEditInfra "openNewNode('')") "alert('Zum Anlegen fehlt die Berechtigung „Infrastruktur anlegen, bearbeiten & deaktivieren“.')"))
    )
  )}}
</div>

{{if .Message}}<div class="rec-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="rec-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

{{if .DueObligations}}
<!-- Fällige Prüfpflichten & Gefährdungsbeurteilungen über alle Anlagen (infra_obligations.go) -->
<div class="card">
  <div class="card-title"><span><i class="ti ti-clipboard-check" style="color:var(--amber)"></i> Fällige Prüfungen &amp; GBU <b>{{len .DueObligations}}</b></span></div>
  {{range .DueObligations}}
  <div class="rec-row" data-rx data-rx-title="{{.Title}}" data-rx-view="/infrastructure/{{.InfraID}}?tab=checks" data-rx-edit="/infrastructure/{{.InfraID}}?tab=checks">
    <i class="ti {{if eq .State "overdue"}}ti-alert-octagon{{else}}ti-bell-ringing{{end}}" style="font-size:18px;color:{{if eq .State "overdue"}}var(--red){{else}}var(--amber){{end}}"></i>
    <div class="grow"><b>{{.Title}}</b><div class="rec-sub">{{.KindLabel}} · {{.InfraName}}{{if .ResponsibleName}} · <i class="ti ti-user"></i> {{.ResponsibleName}}{{end}}</div></div>
    <div style="text-align:right;white-space:nowrap"><span class="badge {{.StateClass}}">{{.StateLabel}}</span><div class="rec-sub">fällig {{.NextDue}}</div></div>
  </div>
  {{end}}
</div>
{{end}}

{{template "category-filter-slot" (dict "Module" "infrastructure")}}

<!-- Neues Element: nur das Nötigste – danach öffnet sich die Anlage im Reiter „Stammdaten“ -->
{{if .CanEditInfra}}
<div id="new-node-form" style="display:none" class="card">
  <div class="card-title"><span><i class="ti ti-plus"></i> Infrastruktur hinzufügen</span></div>
  <form class="rec-form" method="post" action="/infrastructure">
    <div class="cols">
      <div class="form-group"><label class="form-label">Name *</label><input name="name" class="form-input" required maxlength="255" placeholder="z. B. Presse 3"></div>
      <div class="form-group"><label class="form-label">Typ *</label>
        <select name="type" class="form-input">{{range .Types}}<option value="{{.Key}}">{{.Label}}</option>{{end}}</select></div>
      <div class="form-group"><label class="form-label">Übergeordnet</label>
        <select name="parent_id" class="form-input">
          <option value="">– oberste Ebene –</option>
          {{range .AllNodes}}<option value="{{.ID}}">{{.Path}}</option>{{end}}
        </select></div>
      <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input" maxlength="255" placeholder="z. B. Halle A"></div>
    </div>
    <p class="rec-sub" style="margin:2px 0 10px"><i class="ti ti-info-circle"></i> Hersteller, Modell, Seriennummer, Partner, Kostenstelle und Abteilung ergänzt du direkt danach im Reiter „Stammdaten“.</p>
    <div style="display:flex;justify-content:flex-end;gap:8px">
      <button type="button" class="btn" onclick="document.getElementById('new-node-form').style.display='none'">Abbrechen</button>
      <button class="btn btn-primary" type="submit"><i class="ti ti-arrow-right"></i> Anlegen &amp; weiter</button>
    </div>
  </form>
</div>
{{end}}

<!-- Legende -->
<div style="display:flex;gap:16px;margin-bottom:16px;flex-wrap:wrap">
  <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)"><div style="width:12px;height:12px;border-radius:3px;background:#6366F1"></div>Gebäude</div>
  <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)"><div style="width:12px;height:12px;border-radius:3px;background:#4f6ef7"></div>Linie</div>
  <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)"><div style="width:12px;height:12px;border-radius:3px;background:#10b981"></div>Anlage</div>
  <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)"><div style="width:12px;height:12px;border-radius:3px;background:#f59e0b"></div>Gerät</div>
</div>

<!-- Infrastruktur-Baum -->
<div id="infra-tree" class="card" style="padding:16px;overflow-x:auto">
  {{range .Tree}}
  {{template "infra_node" .}}
  {{else}}
  <div style="text-align:center;padding:40px;color:var(--muted)">
    <i class="ti ti-hierarchy-2" style="font-size:48px;display:block;margin-bottom:12px"></i>
    Noch keine Infrastruktur vorhanden
  </div>
  {{end}}
</div>

<!-- Easy-Mode-Meldetexte: zentraler Katalog, Zuordnung im Reiter „Meldetexte“ der Anlage (easy_texts.go) -->
<details class="card" id="easy-texts"{{if not .EasyTexts}} open{{end}}>
  <summary class="card-title" style="cursor:pointer;list-style:none"><span><i class="ti ti-hand-finger"></i> Easy-Mode: Meldetexte <b>{{len .EasyTexts}}</b></span><span class="card-action">auf-/zuklappen</span></summary>
  <p class="rec-sub" style="margin-bottom:10px">Vorformulierte Meldungen für den QR-Code ohne Anmeldung. Mit <i class="ti ti-chevron-up"></i>/<i class="ti ti-chevron-down"></i> legst du die Reihenfolge der Tasten fest.</p>
  <p class="rec-sub" style="margin-bottom:10px"> An der Anlage im Reiter <b>Meldetexte</b> zuordnen – ein Text an einer Halle oder Linie gilt auch für alle Anlagen darunter. Im Easy-Mode erscheinen sie als Tasten in der Sprache des Handys.</p>
  {{range $i, $t := .EasyTexts}}
  <div class="rec-row" data-rx data-rx-title="{{.Text}}">
    {{if $.CanEditInfra}}<span class="et-move">
      <form method="post" action="/infrastructure/easy-texts/{{.ID}}/move"><input type="hidden" name="dir" value="up"><input type="hidden" name="back" value="/infrastructure#easy-texts">
        <button class="ih-act" title="Nach oben"{{if eq $i 0}} disabled{{end}} aria-label="Nach oben"><i class="ti ti-chevron-up"></i></button></form>
      <form method="post" action="/infrastructure/easy-texts/{{.ID}}/move"><input type="hidden" name="dir" value="down"><input type="hidden" name="back" value="/infrastructure#easy-texts">
        <button class="ih-act" title="Nach unten"{{if .Last}} disabled{{end}} aria-label="Nach unten"><i class="ti ti-chevron-down"></i></button></form>
    </span>{{else}}<i class="ti ti-message-2" style="font-size:18px;color:var(--accent)"></i>{{end}}
    <div class="grow"><b>{{.Text}}</b><div class="rec-sub">{{.TypeLabel}} · elektrisch/mechanisch: {{.KindLabel}}</div></div>
    <span class="badge {{if .Uses}}b-blue{{else}}b-gray{{end}}" title="An so vielen Anlagen zugeordnet (Unteranlagen nicht mitgezählt)">{{if .Uses}}{{.Uses}} Anlage{{if ne .Uses 1}}n{{end}}{{else}}nicht zugeordnet{{end}}</span>
    {{if $.CanEditInfra}}<template class="rx-more">
      <div style="flex-basis:100%">{{template "easy-text-form" (dict "T" . "Action" (printf "/infrastructure/easy-texts/%s" .ID) "Back" "/infrastructure#easy-texts" "Label" "Speichern")}}</div>
      <form method="post" action="/infrastructure/easy-texts/{{.ID}}/delete" onsubmit="return confirm('Meldetext „{{.Text}}“ löschen? Er verschwindet auch von allen Anlagen.')"><input type="hidden" name="back" value="/infrastructure#easy-texts"><button class="btn btn-small" style="color:var(--red)"><i class="ti ti-trash"></i> Löschen</button></form>
    </template>{{end}}
  </div>
  {{else}}<div class="rec-sub" style="padding:6px 0 10px">Noch keine Meldetexte – z. B. „Band steht“, „Not-Aus ausgelöst“, „Öl tritt aus“, „Material fehlt“.</div>{{end}}
  {{if .CanEditInfra}}<div class="ih-section" style="margin-top:14px">Neuer Meldetext</div>
  {{template "easy-text-form" (dict "T" nil "Action" "/infrastructure/easy-texts" "Back" "/infrastructure#easy-texts" "Label" "Anlegen")}}{{end}}
</details>
<style>
.et-move{display:flex;flex-direction:column;gap:0;flex-shrink:0}
.et-move form{margin:0;line-height:0}
.et-move .ih-act{width:32px;height:24px;border:0;background:none;color:var(--muted);border-radius:6px;cursor:pointer}
.et-move .ih-act:hover:not(:disabled){background:var(--bg3);color:var(--text)}
.et-move .ih-act:disabled{opacity:.25;cursor:default}
</style>
<script>
// Ruecksprung auf den Katalog (#easy-texts): Karte aufgeklappt zeigen
if(location.hash === '#easy-texts'){ const d = document.getElementById('easy-texts'); if(d){ d.open = true; d.scrollIntoView({block: 'start'}); } }
</script>
{{end}}

{{define "infra_node"}}
<div class="infra-node" data-id="{{.ID}}" style="margin-bottom:6px">
  <div class="infra-row" style="display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1px solid var(--border)"
    data-rx data-rx-title="{{.Name}}" data-rx-view="/infrastructure/{{.ID}}" data-rx-edit="/infrastructure/{{.ID}}?tab=master">
    {{if .Children}}
    <button type="button" class="infra-fold" onclick="toggleNode('{{.ID}}')" aria-label="Unteranlagen auf-/zuklappen" title="Unteranlagen auf-/zuklappen"><i id="toggle-{{.ID}}" class="ti ti-chevron-down" style="transform:rotate(-90deg)"></i></button>
    {{else}}
    <div style="width:22px;flex-shrink:0"></div>
    {{end}}
    <div style="width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;background:{{css .TypeBg}}" title="{{.TypeLabel}}"><i class="ti {{.TypeIcon}}"></i></div>
    <div style="flex:1;min-width:0">
      <div style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{.Name}}</div>
      <div style="font-size:11px;color:var(--muted)">{{.TypeLabel}}{{if .Location}} · {{.Location}}{{end}}{{if .Manufacturer}} · {{.Manufacturer}}{{end}}{{if .CostCenterName}} · {{.CostCenterNumber}} - {{.CostCenterName}}{{end}}</div>
    </div>
    {{if .SerialNo}}<span style="font-size:10px;color:var(--muted);background:var(--bg);padding:2px 6px;border-radius:4px;flex-shrink:0">{{.SerialNo}}</span>{{end}}
    <template class="rx-more"><button type="button" class="btn btn-small" onclick="addChildNode('{{.ID}}')"><i class="ti ti-plus"></i> Unteranlage hinzufügen</button></template>
  </div>
  {{if .Children}}
  <div id="children-{{.ID}}" style="display:none;margin-left:24px;margin-top:4px;padding-left:16px;border-left:2px solid var(--border)">
    {{range .Children}}
    {{template "infra_node" .}}
    {{end}}
  </div>
  {{end}}
</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:8px">Schnellzugriff</div>
{{range .AllNodes}}
<div class="act-item" style="cursor:pointer" onclick="scrollToNode('{{.ID}}')">
  <div class="act-text">{{.Name}}</div>
  <span style="font-size:10px;color:var(--muted)">{{.TypeLabel}}</span>
</div>
{{end}}
{{end}}

{{block "scripts" .}}
<script>
// Baum startet zugeklappt; offen ist nur der zuletzt geöffnete Ast (samt
// seiner übergeordneten Knoten) – alle anderen Äste klappen dabei zu.
function setNodeOpen(id, open) {
  const children = document.getElementById('children-'+id);
  const icon = document.getElementById('toggle-'+id);
  if(children) children.style.display = open ? 'block' : 'none';
  if(icon) icon.style.transform = open ? '' : 'rotate(-90deg)';
}
function openBranch(id) {
  const keep = new Set();
  for(let n = document.querySelector('.infra-node[data-id="'+id+'"]'); n; n = n.parentElement.closest('.infra-node')) keep.add(n.dataset.id);
  document.querySelectorAll('[id^="children-"]').forEach(el => { const nid = el.id.slice(9); setNodeOpen(nid, keep.has(nid)); });
  try { sessionStorage.setItem('pdh.infra.branch', id); } catch(e) {}
}
function toggleNode(id) {
  const children = document.getElementById('children-'+id);
  if(!children) return;
  if(children.style.display === 'none') { openBranch(id); return; }
  setNodeOpen(id, false);
  const parent = children.closest('.infra-node').parentElement.closest('.infra-node');
  try { if(parent) sessionStorage.setItem('pdh.infra.branch', parent.dataset.id); else sessionStorage.removeItem('pdh.infra.branch'); } catch(e) {}
}
document.addEventListener('DOMContentLoaded', () => {
  let id = null;
  try { id = sessionStorage.getItem('pdh.infra.branch'); } catch(e) {}
  if(id && document.querySelector('.infra-node[data-id="'+id+'"]')) openBranch(id);
});

function expandAll() {
  document.querySelectorAll('[id^="children-"]').forEach(el => el.style.display = 'block');
  document.querySelectorAll('[id^="toggle-"]').forEach(el => el.style.transform = '');
}

function scrollToNode(id) {
  const el = document.querySelector('[data-id="'+id+'"]');
  const parent = el && el.parentElement.closest('.infra-node');
  if(parent) openBranch(parent.dataset.id);
  if(el) { el.scrollIntoView({behavior:'smooth',block:'center'}); el.querySelector('.infra-row').style.background='rgba(var(--accent-rgb),.2)'; setTimeout(()=>el.querySelector('.infra-row').style.background='',1500); }
}

function openNewNode(parentId) {
  const box = document.getElementById('new-node-form');
  if(!box){ alert('Zum Anlegen fehlt die Berechtigung „Infrastruktur anlegen, bearbeiten & deaktivieren“.'); return; }
  box.style.display = 'block';
  const sel = box.querySelector('select[name="parent_id"]');
  if(sel) sel.value = parentId || '';
  box.scrollIntoView({behavior:'smooth', block:'start'});
  box.querySelector('input[name="name"]').focus({preventScroll:true});
}
function addChildNode(parentId) { openNewNode(parentId); }
</script>
{{end}}
