{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Ersatzteillager</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Stats.Total}} Teile · Wert: {{.Stats.TotalValue}}€</p>
  </div>
  {{template "icon-button-toolbar" (dict "Class" "end" "Label" "Ersatzteil-Aktionen" "Items" (list (dict "Action" "book" "ShowLabel" true "Href" "/inventory/book") (dict "Action" "edit" "ShowLabel" true "Label" "Feldsätze" "OnClick" "toggleFieldAdmin()") (dict "Action" "new" "ShowLabel" true "Label" "Neues Teil" "OnClick" "document.getElementById('new-part-form').style.display='block';loadStorageTree()")) )}}
</div>

<div class="stats" style="grid-template-columns:repeat(4,1fr)">
  <div class="stat s-blue"><div class="stat-label">Gesamt</div><div class="stat-val">{{.Stats.Total}}</div></div>
  <div class="stat s-amber"><div class="stat-label">Unter Mindest</div><div class="stat-val">{{.Stats.LowStock}}</div></div>
  <div class="stat s-red"><div class="stat-label">Kritisch</div><div class="stat-val">{{.Stats.Critical}}</div></div>
  <div class="stat s-green"><div class="stat-label">Lagerwert</div><div class="stat-val">{{.Stats.TotalValue}}€</div></div>
</div>

<div id="field-admin" class="card" style="display:none">
  <div class="card-title">Feldsätze und Stammdatenfelder</div>
  <p style="font-size:12px;color:var(--muted);margin-bottom:10px">Feldsatz anlegen, z.B. Motoren, und technische Felder zuordnen.</p>
  <form hx-post="/api/v1/inventory/field-sets" hx-on::after-request="if(event.detail.successful){this.reset();loadFieldSets();}">
    <div style="display:flex;gap:8px;align-items:end;margin-bottom:10px">
      <div class="form-group" style="flex:1"><label class="form-label">Feldsatz</label><input name="name" class="form-input" placeholder="Motoren" required></div>
      <div class="form-group" style="flex:2"><label class="form-label">Beschreibung</label><input name="description" class="form-input" placeholder="Technische Motordaten"></div>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Feldsatz anlegen")}}
    </div>
  </form>
  <div style="display:flex;gap:8px;align-items:end;margin-bottom:10px">
    <div class="form-group" style="flex:1"><label class="form-label">Aktiver Feldsatz</label><select id="admin-field-set" class="form-input" onchange="loadFieldsForSelectedSet()"></select></div>
    <div class="form-group" style="flex:1"><label class="form-label">Feldname</label><input id="admin-field-name" class="form-input" placeholder="Spannung"></div>
    <div class="form-group" style="width:150px"><label class="form-label">Typ</label><select id="admin-field-type" class="form-input"><option value="text">Text</option><option value="number">Zahl</option><option value="date">Datum</option></select></div>
    <div class="form-group" style="width:110px"><label class="form-label">Sortierung</label><input id="admin-field-order" type="number" class="form-input" value="100"></div>
    <button type="button" class="btn" onclick="createFieldInSelectedSet()"><i class="ti ti-plus"></i> Feld</button>
  </div>
  <div id="field-set-list" style="font-size:12px;color:var(--muted)"></div>
  <div id="field-def-list" style="margin-top:10px;font-size:12px;color:var(--muted)"></div>
</div>

<div id="storage-picker" class="card" style="display:none;position:fixed;right:24px;top:92px;width:420px;max-height:70vh;overflow:auto;z-index:5000;box-shadow:0 18px 48px rgba(0,0,0,.35)">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px"><div class="card-title" style="margin:0">Lager auswählen</div>{{template "icon-button" (dict "Action" "cancel" "OnClick" "closeStoragePicker()")}}</div>
  <div id="storage-picker-tree" style="font-size:12px;color:var(--muted)">Lade Lagerbaum...</div>
</div>

<div id="image-search-panel" class="card" style="display:none;position:fixed;right:24px;top:92px;width:460px;max-height:70vh;overflow:auto;z-index:5001;box-shadow:0 18px 48px rgba(0,0,0,.35)">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px"><div class="card-title" style="margin:0">Teilebild suchen</div>{{template "icon-button" (dict "Action" "cancel" "OnClick" "closeImageSearch()")}}</div>
  <div id="image-search-content" style="font-size:12px;color:var(--muted)"></div>
</div>

<div id="new-part-form" style="display:none" class="card">
  <div class="card-title">Teil anlegen</div>
  <form hx-post="/api/v1/inventory" onsubmit="embedImageUrlIntoDescription(this)" hx-on::after-request="if(event.detail.successful) location.reload()">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Teilenummer</label><div style="display:flex;gap:6px"><input id="new-part-number" name="part_number" class="form-input" required><input id="barcode-new-part-number" type="file" accept="image/*" capture="environment" style="display:none" onchange="scanBarcodeIntoInput(this,'new-part-number')"><button type="button" class="btn" onclick="document.getElementById('barcode-new-part-number').click()"><i class="ti ti-barcode"></i></button></div></div>
      <div class="form-group"><label class="form-label">Name</label><input id="new-part-name" name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Hersteller</label><input id="new-part-manufacturer" name="manufacturer" class="form-input"></div>
      <div class="form-group"><label class="form-label">Kategorie</label><input name="category" class="form-input"></div>
      <div class="form-group"><label class="form-label">Einheit</label><input name="unit" class="form-input" value="Stück"></div>
      <div class="form-group"><label class="form-label">Preis</label><input name="price" type="number" step="0.01" class="form-input" value="0"></div>
      <div class="form-group"><label class="form-label">Lagerort</label><input id="new-storage-location" name="storage_location" class="form-input" readonly onclick="openStoragePicker('new-storage-location','new-storage-place')" placeholder="Aus Baum auswählen"></div>
      <div class="form-group"><label class="form-label">Lagerplatz</label><input id="new-storage-place" name="storage_place" class="form-input" readonly onclick="openStoragePicker('new-storage-location','new-storage-place')" placeholder="Aus Baum auswählen"></div>
      <div class="form-group"><label class="form-label">Mindestbestand</label><input name="min_qty" type="number" step="0.001" class="form-input" value="1"></div>
      <div class="form-group"><label class="form-label">Kritischer Bestand</label><input name="critical_qty" type="number" step="0.001" class="form-input" value="0"></div>
      <div class="form-group"><label class="form-label">Bestellmenge</label><input name="reorder_qty" type="number" step="0.001" class="form-input" value="5"></div>
      <div class="form-group"><label class="form-label">Anfangsbestand</label><input name="initial_stock" type="number" step="0.001" class="form-input" value="0"></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Teilebild URL</label><div style="display:flex;gap:6px"><input data-image-url="1" class="form-input" placeholder="https://...jpg/png/webp" oninput="previewImageUrl(this)"><button type="button" class="btn" onclick="openImageSearch(this.form)"><i class="ti ti-search"></i> Suchen</button></div><div class="image-preview" style="margin-top:6px"></div></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><input name="description" class="form-input"></div>
    </div>
    {{template "icon-button-toolbar" (dict "Class" "end" "Label" "Formularaktionen" "Style" "width:100%;justify-content:flex-end" "Items" (list (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-part-form').style.display='none'") (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Anlegen")) )}}
  </form>
</div>

<div id="parts-table" class="card" style="padding:0">
  <table>
    <thead><tr><th>Teil</th><th>Lagerort</th><th>Bestand</th><th>Status</th><th></th></tr></thead>
    <tbody>
    {{range .Parts}}
    <tr data-part-row="{{.ID}}" data-description="">
      <td><div style="display:flex;gap:8px;align-items:center"><div id="thumb-{{.ID}}" style="width:42px;height:42px;border-radius:8px;background:var(--bg3);display:none;overflow:hidden;align-items:center;justify-content:center;flex-shrink:0"></div><div><div style="font-weight:500">{{.Name}}</div><div style="font-size:11px;color:var(--muted)">{{.PartNumber}} · {{.Manufacturer}}</div></div></div></td>
      <td style="font-size:12px;color:var(--muted)">{{.StorageLocation}}<br>{{.StoragePlace}}</td>
      <td><div style="font-weight:500">{{.StockQty}} {{.Unit}}</div><div style="font-size:10px;color:var(--muted)">Min: {{.MinQty}}</div></td>
      <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td style="white-space:nowrap">{{template "icon-button" (dict "Action" "edit" "OnClick" (printf "togglePartEdit('%s')" .ID))}}{{template "icon-button" (dict "Action" "history" "HxGet" (printf "/inventory/%s/movements" .ID) "HxTarget" (printf "#movements-%s" .ID) "HxSwap" "innerHTML")}}</td>
    </tr>
    <tr id="edit-{{.ID}}" style="display:none"><td colspan="5" style="background:var(--bg3);padding:14px">
      <form hx-put="/api/v1/inventory/{{.ID}}" onsubmit="embedImageUrlIntoDescription(this)" hx-on::after-request="if(event.detail.successful) location.reload()">
        <div class="grid2">
          <div class="form-group"><label class="form-label">Teilenummer</label><div style="display:flex;gap:6px"><input id="part-number-{{.ID}}" name="part_number" class="form-input" value="{{.PartNumber}}" required><input id="barcode-part-number-{{.ID}}" type="file" accept="image/*" capture="environment" style="display:none" onchange="scanBarcodeIntoInput(this,'part-number-{{.ID}}')"><button type="button" class="btn" onclick="document.getElementById('barcode-part-number-{{.ID}}').click()"><i class="ti ti-barcode"></i></button></div></div>
          <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" value="{{.Name}}" required></div>
          <div class="form-group"><label class="form-label">Hersteller</label><input name="manufacturer" class="form-input" value="{{.Manufacturer}}"></div>
          <div class="form-group"><label class="form-label">Kategorie</label><input name="category" class="form-input" value="{{.Category}}"></div>
          <div class="form-group"><label class="form-label">Einheit</label><input name="unit" class="form-input" value="{{.Unit}}"></div>
          <div class="form-group"><label class="form-label">Mindestbestand</label><input name="min_qty" type="number" step="0.001" class="form-input" value="{{.MinQty}}"></div>
          <div class="form-group"><label class="form-label">Lagerort</label><input id="loc-{{.ID}}" name="storage_location" class="form-input" value="{{.StorageLocation}}" readonly onclick="openStoragePicker('loc-{{.ID}}','place-{{.ID}}')"></div>
          <div class="form-group"><label class="form-label">Lagerplatz</label><input id="place-{{.ID}}" name="storage_place" class="form-input" value="{{.StoragePlace}}" readonly onclick="openStoragePicker('loc-{{.ID}}','place-{{.ID}}')"></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Feldsatz</label><select data-field-set-select="{{.ID}}" class="form-input" onchange="assignFieldSet('{{.ID}}', this.value)"></select></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Teilebild URL</label><div style="display:flex;gap:6px"><input data-image-url="1" class="form-input" placeholder="https://...jpg/png/webp" oninput="previewImageUrl(this)"><button type="button" class="btn" onclick="openImageSearch(this.form)"><i class="ti ti-search"></i> Suchen</button></div><div class="image-preview" style="margin-top:6px"></div></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><input name="description" class="form-input"></div>
        </div>
        <div id="custom-fields-{{.ID}}" data-part-id="{{.ID}}" style="margin-top:10px"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px">
          {{template "icon-button" (dict "Action" "edit" "ShowLabel" true "Label" "Feldsatzfelder laden" "OnClick" (printf "loadPartFields('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Label" "Stammfelder speichern" "OnClick" (printf "savePartFields('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "cancel" "ShowLabel" true "OnClick" (printf "togglePartEdit('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Teil speichern")}}
        </div>
      </form>
    </td></tr>
    <tr id="movements-{{.ID}}" style="display:none"><td colspan="5"></td></tr>
    {{else}}<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:24px">Keine Teile vorhanden</td></tr>{{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "context-list"}}{{range .LowStockParts}}<div class="act-item"><div class="act-dot {{.StatusDot}}"></div><div class="act-text">{{.Name}}</div><span style="font-size:11px;color:var(--muted)">{{.StockQty}}</span></div>{{end}}{{end}}

{{block "scripts" .}}
<script>
let storagePickerTarget={loc:null,place:null};let storageTreeCache=null;let fieldSetsCache=null;
async function apiData(url,options){const res=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));let payload=null;try{payload=await res.json();}catch(e){throw new Error('Keine JSON-Antwort von '+url);}if(!res.ok||payload.success===false)throw new Error(payload.error||payload.message||('HTTP '+res.status));return Array.isArray(payload)?payload:(payload.data!==undefined?payload.data:payload);}
function toggleFieldAdmin(){const el=document.getElementById('field-admin');el.style.display=el.style.display==='none'?'block':'none';if(el.style.display==='block')loadFieldSets();}
function togglePartEdit(id){const el=document.getElementById('edit-'+id);el.style.display=el.style.display==='none'?'table-row':'none';if(el.style.display==='table-row'){loadStorageTree();initImageFields(el);loadFieldSetSelect(id);}}
function openStoragePicker(locId,placeId){storagePickerTarget={loc:locId,place:placeId};document.getElementById('storage-picker').style.display='block';loadStorageTree();}function closeStoragePicker(){document.getElementById('storage-picker').style.display='none';}
async function loadStorageTree(){const root=document.getElementById('storage-picker-tree');try{if(storageTreeCache){renderStorageTree(storageTreeCache);return;}root.innerHTML='Lade Lagerbaum...';storageTreeCache=await apiData('/api/v1/storage/');renderStorageTree(storageTreeCache);}catch(e){root.innerHTML='<div style="color:var(--red)">Lagerbaum konnte nicht geladen werden: '+escapeHtml(e.message)+'</div>';}}
function renderStorageTree(warehouses){const root=document.getElementById('storage-picker-tree');if(!root)return;if(!Array.isArray(warehouses)||warehouses.length===0){root.innerHTML='<div style="color:var(--muted)">Keine Lager vorhanden</div>';return;}root.innerHTML=warehouses.map(w=>`<div style="margin-bottom:8px"><div style="font-weight:600;color:var(--fg);padding:6px 0">${escapeHtml(w.name||'Lager')}</div>${(w.locations||[]).map(l=>`<div style="margin-left:14px;border-left:2px solid var(--border);padding-left:10px;margin-bottom:6px"><div style="font-weight:500;color:var(--fg);padding:4px 0">${escapeHtml(l.name||'Lagerort')}</div>${(l.places||[]).map(p=>`<button type="button" class="btn" style="width:100%;justify-content:flex-start;margin:2px 0" onclick="selectStorage('${escapeJs(l.name||'')}','${escapeJs(p.name||'')}')">${escapeHtml(p.name||'Lagerplatz')}</button>`).join('')||'<div style="font-size:11px;color:var(--muted)">Keine Lagerplätze</div>'}</div>`).join('')||'<div style="font-size:11px;color:var(--muted)">Keine Lagerorte</div>'}</div>`).join('');}function selectStorage(loc,place){document.getElementById(storagePickerTarget.loc).value=loc;document.getElementById(storagePickerTarget.place).value=place;closeStoragePicker();}
async function loadFieldSets(){try{fieldSetsCache=await apiData('/api/v1/inventory/field-sets');const sel=document.getElementById('admin-field-set');sel.innerHTML=fieldSetsCache.map(s=>`<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');document.getElementById('field-set-list').innerHTML=fieldSetsCache.length?fieldSetsCache.map(s=>`<span class="badge b-blue" style="margin-right:4px">${escapeHtml(s.name)}</span>`).join(''):'Noch keine Feldsätze angelegt';loadFieldsForSelectedSet();}catch(e){document.getElementById('field-set-list').innerHTML='<span style="color:var(--red)">'+escapeHtml(e.message)+'</span>';}}
async function loadFieldsForSelectedSet(){const sel=document.getElementById('admin-field-set');const list=document.getElementById('field-def-list');if(!sel||!sel.value){list.innerHTML='Kein Feldsatz ausgewählt';return;}try{const fields=await apiData('/api/v1/inventory/field-sets/'+sel.value+'/fields');list.innerHTML=fields.length?fields.map(f=>`<span class="badge b-green" style="margin-right:4px">${escapeHtml(f.name)} · ${escapeHtml(f.field_type)}</span>`).join(''):'Dieser Feldsatz hat noch keine Felder';}catch(e){list.innerHTML='<span style="color:var(--red)">'+escapeHtml(e.message)+'</span>';}}
async function createFieldInSelectedSet(){const set=document.getElementById('admin-field-set').value;if(!set){alert('Bitte Feldsatz anlegen/auswählen');return;}const body=new URLSearchParams();body.set('name',document.getElementById('admin-field-name').value);body.set('field_type',document.getElementById('admin-field-type').value);body.set('sort_order',document.getElementById('admin-field-order').value||'100');await fetch('/api/v1/inventory/field-sets/'+set+'/fields',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});document.getElementById('admin-field-name').value='';loadFieldsForSelectedSet();}
async function loadFieldSetSelect(id){if(!fieldSetsCache)fieldSetsCache=await apiData('/api/v1/inventory/field-sets');const sel=document.querySelector('[data-field-set-select="'+id+'"]');if(!sel)return;const assigned=await apiData('/api/v1/inventory/'+id+'/field-set');sel.innerHTML='<option value="">Kein Feldsatz</option>'+fieldSetsCache.map(s=>`<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');sel.value=assigned.field_set_id||'';}
async function assignFieldSet(id,setId){await apiData('/api/v1/inventory/'+id+'/field-set',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({field_set_id:setId})});document.getElementById('custom-fields-'+id).innerHTML='';}
async function loadPartFields(id){const box=document.getElementById('custom-fields-'+id);box.innerHTML='Lade Feldsatzfelder...';try{const fields=await apiData('/api/v1/inventory/'+id+'/fields-assigned');box.innerHTML=fields.length?`<div class="grid2">${fields.map(f=>`<div class="form-group"><label class="form-label">${escapeHtml(f.name)}</label><input data-field-id="${f.field_id}" class="form-input custom-field-input" value="${escapeHtml(f.value||'')}"></div>`).join('')}</div>`:'<div style="color:var(--muted);font-size:12px">Kein Feldsatz ausgewählt oder keine Felder im Feldsatz.</div>';}catch(e){box.innerHTML='<span style="color:var(--red)">Felder konnten nicht geladen werden: '+escapeHtml(e.message)+'</span>';}}
async function savePartFields(id){const box=document.getElementById('custom-fields-'+id);const values={};box.querySelectorAll('.custom-field-input').forEach(i=>values[i.dataset.fieldId]=i.value);try{await apiData('/api/v1/inventory/'+id+'/fields',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({values})});alert('Stammfelder gespeichert');}catch(e){alert('Stammfelder konnten nicht gespeichert werden: '+e.message);}}
function imageUrlFromDescription(desc){const m=String(desc||'').match(/(?:^|\n)PDH_IMAGE_URL:\s*(\S+)/);return m?m[1]:'';}function cleanImageUrlFromDescription(desc){return String(desc||'').replace(/(?:^|\n)PDH_IMAGE_URL:\s*\S+\s*/g,'').trim();}function embedImageUrlIntoDescription(form){const input=form.querySelector('[data-image-url]');const desc=form.querySelector('[name="description"]');if(!input||!desc)return true;const clean=cleanImageUrlFromDescription(desc.value);const url=input.value.trim();desc.value=url?(clean?clean+'\n':'')+'PDH_IMAGE_URL: '+url:clean;return true;}function initImageFields(root=document){root.querySelectorAll('form').forEach(form=>{const img=form.querySelector('[data-image-url]');const desc=form.querySelector('[name="description"]');if(img&&desc){img.value=imageUrlFromDescription(desc.value);desc.value=cleanImageUrlFromDescription(desc.value);previewImageUrl(img);}});}function previewImageUrl(input){const box=input.closest('.form-group')?.querySelector('.image-preview');if(!box)return;const url=input.value.trim();box.innerHTML=url?`<img src="${escapeHtml(url)}" style="max-height:90px;max-width:180px;border-radius:8px;border:1px solid var(--border);object-fit:contain" onerror="this.replaceWith(document.createTextNode('Bild konnte nicht geladen werden'))">`:'';}function openImageSearch(form){const part=form.querySelector('[name="part_number"]')?.value||'';const name=form.querySelector('[name="name"]')?.value||'';const manufacturer=form.querySelector('[name="manufacturer"]')?.value||'';const q=[manufacturer,part,name].filter(Boolean).join(' ').trim()||'Ersatzteil';const enc=encodeURIComponent(q);const panel=document.getElementById('image-search-panel');const content=document.getElementById('image-search-content');panel.style.display='block';content.innerHTML=`<div style="margin-bottom:10px;color:var(--fg)">Suchbegriff: <b>${escapeHtml(q)}</b></div><div style="display:grid;gap:6px"><a class="btn" target="_blank" rel="noopener" href="https://www.google.com/search?tbm=isch&q=${enc}">Google Bilder öffnen</a><a class="btn" target="_blank" rel="noopener" href="https://www.bing.com/images/search?q=${enc}">Bing Bilder öffnen</a><a class="btn" target="_blank" rel="noopener" href="https://duckduckgo.com/?iax=images&ia=images&q=${enc}">DuckDuckGo Bilder öffnen</a></div>`;}function closeImageSearch(){document.getElementById('image-search-panel').style.display='none';}
async function scanBarcodeIntoInput(fileInput,targetInputId){const target=document.getElementById(targetInputId);if(!target||!fileInput.files||fileInput.files.length===0)return;if(!('BarcodeDetector'in window)){alert('Barcode-Erkennung wird von diesem Browser nicht unterstützt.');fileInput.value='';return;}try{const bitmap=await createImageBitmap(fileInput.files[0]);const formats=await BarcodeDetector.getSupportedFormats();const detector=new BarcodeDetector({formats:formats&&formats.length?formats:undefined});const codes=await detector.detect(bitmap);if(!codes||codes.length===0){alert('Kein Barcode erkannt.');return;}target.value=codes[0].rawValue||'';target.dispatchEvent(new Event('input',{bubbles:true}));target.focus();}catch(e){alert('Barcode konnte nicht erkannt werden: '+e.message);}finally{fileInput.value='';}}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}function escapeJs(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'");}
</script>
{{end}}
