+	NewKeyRaw  string
+	NewKeyName string
+	AllEvents  []string
+}
+
+func (h *Handler) IntegrationsPage(w http.ResponseWriter, r *http.Request) {
+	if !h.canManageIntegrations(r) {
+		http.Redirect(w, r, "/", http.StatusFound)
+		return
+	}
+	ctx := r.Context()
+	keys, _ := h.integrations.ListAPIKeys(ctx)
+	hooks, _ := h.integrations.ListWebhooks(ctx)
+	data := IntegrationsPageData{
+		BaseData: h.baseData(r, "integrations", "Schnittstellen", "Produktionsdaten-Import/-Export"),
+		APIKeys:  keys,
+		Webhooks: hooks,
+		AllEvents: []string{
+			integrations.EventProductionRecorded,
+			integrations.EventFaultCreated,
+		},
+	}
+	q := r.URL.Query()
+	data.NewKeyRaw = q.Get("new_key")
+	data.NewKeyName = q.Get("key_name")
+	h.render(w, "integrations", data)
+}
+
+func (h *Handler) IntegrationKeyCreateWeb(w http.ResponseWriter, r *http.Request) {
+	if !h.canManageIntegrations(r) {
+		http.Error(w, "keine berechtigung", http.StatusForbidden)
+		return
+	}
+	r.ParseForm()
+	name := strings.TrimSpace(r.FormValue("name"))
+	if name == "" {
+		http.Redirect(w, r, "/admin/integrations", http.StatusFound)
+		return
+	}
+	u := getUser(r)
+	rawKey, _, err := h.integrations.GenerateAPIKey(r.Context(), name, &u.ID)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	http.Redirect(w, r, "/admin/integrations?new_key="+url.QueryEscape(rawKey)+"&key_name="+url.QueryEscape(name), http.StatusFound)
+}
+
+func (h *Handler) IntegrationKeyRevokeWeb(w http.ResponseWriter, r *http.Request) {
+	if !h.canManageIntegrations(r) {
+		http.Error(w, "keine berechtigung", http.StatusForbidden)
+		return
+	}
+	h.integrations.RevokeAPIKey(r.Context(), chi.URLParam(r, "id"))
+	http.Redirect(w, r, "/admin/integrations", http.StatusFound)
+}
+
+func (h *Handler) IntegrationWebhookCreateWeb(w http.ResponseWriter, r *http.Request) {
+	if !h.canManageIntegrations(r) {
+		http.Error(w, "keine berechtigung", http.StatusForbidden)
+		return
+	}
+	r.ParseForm()
+	name := strings.TrimSpace(r.FormValue("name"))
+	targetURL := strings.TrimSpace(r.FormValue("target_url"))
+	secret := strings.TrimSpace(r.FormValue("secret"))
+	events := r.Form["events"]
+	if name == "" || targetURL == "" {
+		http.Redirect(w, r, "/admin/integrations", http.StatusFound)
+		return
+	}
+	if secret == "" {
+		raw := make([]byte, 24)
+		rand.Read(raw)
+		secret = hex.EncodeToString(raw)
+	}
+	u := getUser(r)
+	h.integrations.CreateWebhook(r.Context(), name, targetURL, secret, events, &u.ID)
+	http.Redirect(w, r, "/admin/integrations", http.StatusFound)
+}
+
+func (h *Handler) IntegrationWebhookDeleteWeb(w http.ResponseWriter, r *http.Request) {
+	if !h.canManageIntegrations(r) {
+		http.Error(w, "keine berechtigung", http.StatusForbidden)
+		return
+	}
+	h.integrations.DeleteWebhook(r.Context(), chi.URLParam(r, "id"))
+	http.Redirect(w, r, "/admin/integrations", http.StatusFound)
+}
