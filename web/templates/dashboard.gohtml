{{template "base" .}}

{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600;letter-spacing:-.3px">Guten {{.Greeting}}, {{.UserFirstName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.DateStr}} · Werk Augsburg</p>
</div>

<div class="stats">
  <div class="stat s-blue">
    <div class="stat-label">Offene Tickets</div>
    <div class="stat-val">{{.Stats.OpenTickets}}</div>
    <div class="stat-sub">{{.Stats.CriticalTickets}} kritisch</div>
  </div>
  <div class="stat s-red">
    <div class="stat-label">Störungen</div>
    <div class="stat-val">{{.Stats.ActiveFaults}}</div>
    <div class="stat-sub">{{.Stats.AnalyzingFaults}} analysiert</div>
  </div>
  <div class="stat s-amber">
    <div class="stat-label">Wartung fällig</div>
    <div class="stat-val">{{.Stats.MaintenanceDue}}</div>
    <div class="stat-sub">diese Woche</div>
  </div>
  <div class="stat s-green">
    <div class="stat-label">Lagerwert</div>
    <div class="stat-val">{{.Stats.InventoryValue}}€</div>
    <div class="stat-sub">{{.Stats.LowStock}} unter Mindest</div>
  </div>
</div>

<!-- Kombinierter Zeitstrahl: Aufgaben, Tickets, Wartung, Störungen -->
<div class="card">
  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <span>Zeitstrahl</span>
    <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--muted)">
      <span><i class="ti ti-square-filled" style="color:#4f6ef7"></i> Aufgaben</span>
      <span><i class="ti ti-square-filled" style="color:#8b5cf6"></i> Tickets</span>
      <span><i class="ti ti-square-filled" style="color:#14b8a6"></i> Wartung</span>
      <span><i class="ti ti-square-filled" style="color:#f97316"></i> Störungen</span>
      <span style="opacity:.5"><i class="ti ti-square-filled"></i> ausgeblasst = kein Termin, +30 Tage geschätzt</span>
    </div>
  </div>
  <div id="dash-gantt-target" style="overflow-x:auto"></div>
  <div id="dash-gantt-empty" style="display:none;font-size:12px;color:var(--muted);padding:20px;text-align:center">
    Keine Einträge mit Terminen vorhanden.
  </div>
</div>

<div class="grid2">
  <!-- Störungen -->
  <div class="card">
    <div class="card-title">
      Aktive Störungen
      <a href="/faults" class="card-action">alle anzeigen →</a>
    </div>
    {{if .Faults}}
    {{range .Faults}}
    <div class="li {{.BlinkClass}}">
      <div class="li-text">
        <div class="li-title">{{.Title}}</div>
        <div class="li-sub">{{.InfraName}} · {{.DetectedAgo}}</div>
      </div>
      <span class="badge {{.SeverityClass}}">{{.Severity}}</span>
    </div>
    {{end}}
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine aktiven Störungen</div>
    {{end}}
  </div>

  <!-- Schichtplan -->
  <div class="card">
    <div class="card-title">
      Schichtplan KW {{.WeekNumber}}
      <span style="font-size:11px;color:var(--muted)">{{.WeekRange}}</span>
    </div>
    {{if .WeekPlan}}
    <div style="font-size:11px;color:var(--muted);margin-bottom:5px">{{.UserFirstName}} {{.UserLastName}}</div>
    <div class="shift-grid">
      {{range .WeekDays}}
      <div class="shift-day">
        <div class="shift-day-name">{{.Short}}</div>
        <div class="shift-pill {{.Class}}">{{.Label}}</div>
      </div>
      {{end}}
    </div>
    <div style="margin-top:10px;font-size:10px;color:var(--muted);display:flex;gap:10px">
      <span style="color:#6ee7b7">■ Früh</span>
      <span style="color:#fcd34d">■ Spät</span>
      <span style="color:#a5b4fc">■ Nacht</span>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Schichten diese Woche</div>
    {{end}}
  </div>
</div>

<!-- Wartung heute -->
<div class="card">
  <div class="card-title">
    Wartung fällig
    <a href="/maintenance" class="card-action">alle anzeigen →</a>
  </div>
  {{if .MaintenanceDue}}
  {{range .MaintenanceDue}}
  <div class="li {{.BlinkClass}}">
    <div class="li-text">
      <div class="li-title">{{.Title}}</div>
      <div class="li-sub">{{.InfraName}} · ~{{.EstimatedMin}}min</div>
    </div>
    <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
  </div>
  {{end}}
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Wartung fällig</div>
  {{end}}
</div>
{{end}}

{{define "context-list"}}
{{range .OpenTickets}}
<div class="act-item {{.BlinkClass}}">
  <div class="act-dot {{.PriorityDot}}"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">
<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>
<script>
var dashGanttItems = [
{{range .GanttItems}}
  {id:'{{.ID}}', refType:'{{.RefType}}', name:'{{.Title}}', start:'{{.StartISO}}', end:'{{.EndISO}}',
   provisional: {{if .IsProvisional}}true{{else}}false{{end}}, done: {{if .IsDone}}true{{else}}false{{end}},
   color:'{{.Color}}', url:'{{.DetailURL}}', dueEndpoint:'{{.DueDateEndpoint}}'},
{{end}}
];

function dashGanttColor(t){
  var today = new Date(); today.setHours(0,0,0,0);
  var due = t.end ? new Date(t.end+'T00:00:00') : null;
  var tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate()+1);
  var isOverdue = (!t.done && due && due < today);
  var isDueSoon = (!t.done && due && (due.getTime() === today.getTime() || due.getTime() === tomorrow.getTime()));

  if(t.done) return {fill:'#10b981', stroke:'#10b981', opacity:1};
  if(isOverdue) return {fill:t.color, stroke:'#ef4444', opacity: t.provisional ? 0.4 : 1};
  if(isDueSoon) return {fill:'#f59e0b', stroke:'#f59e0b', opacity: t.provisional ? 0.4 : 1};
  return {fill:t.color, stroke:t.color, opacity: t.provisional ? 0.4 : 1};
}

function applyDashGanttStyling(){
  dashGanttItems.forEach(function(t){
    var wrapper = document.querySelector('#dash-gantt-target .bar-wrapper[data-id="' + t.id + '"]');
    if(!wrapper) return;
    var colors = dashGanttColor(t);
    var bar = wrapper.querySelector('.bar');
    var barProgress = wrapper.querySelector('.bar-progress');
    if(bar){
      bar.style.fill = colors.fill;
      bar.style.stroke = colors.stroke;
      bar.style.strokeWidth = (colors.stroke === '#ef4444') ? '3px' : '1px';
    }
    if(barProgress) barProgress.style.fill = colors.fill;
    wrapper.style.opacity = colors.opacity;
    wrapper.style.cursor = 'pointer';
    var titleEl = wrapper.querySelector('title');
    var hint = t.provisional ? ' — kein Termin, geschätzt (+30 Tage). Doppelklick zum Öffnen, Ziehen zum Eintragen eines echten Termins.' : ' — Doppelklick zum Öffnen';
    if(!titleEl){
      titleEl = document.createElementNS('http://www.w3.org/2000/svg', 'title');
      wrapper.appendChild(titleEl);
    }
    titleEl.textContent = t.name + hint;

    wrapper.addEventListener('dblclick', function(e){
      e.preventDefault();
      window.location = t.url;
    });
  });
}

function formatDateISO(d){
  var year = d.getFullYear();
  var month = String(d.getMonth()+1).padStart(2,'0');
  var day = String(d.getDate()).padStart(2,'0');
  return year + '-' + month + '-' + day;
}

async function saveDashGanttDate(item, end){
  var dueStr = formatDateISO(end);
  try{
    var res = await fetch(item.dueEndpoint, {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({due_date: dueStr})
    });
    if(!res.ok){
      var j = null; try{ j = await res.json(); }catch(e){}
      throw new Error((j && j.error) || ('HTTP ' + res.status));
    }
    location.reload();
  }catch(e){
    alert('Termin konnte nicht gespeichert werden: ' + e.message);
    location.reload();
  }
}

function renderDashGantt(){
  var target = document.getElementById('dash-gantt-target');
  var empty = document.getElementById('dash-gantt-empty');
  if(!dashGanttItems.length){
    target.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  target.style.display = 'block';
  empty.style.display = 'none';

  var byId = {};
  dashGanttItems.forEach(function(t){ byId[t.id] = t; });

  var tasks = dashGanttItems.map(function(t){
    return {id: t.id, name: t.name, start: t.start, end: t.end, progress: t.done ? 100 : 0};
  });

  try{
    new Gantt('#dash-gantt-target', tasks, {
      on_date_change: function(task, start, end){
        var item = byId[task.id];
        if(item) saveDashGanttDate(item, end);
      },
      view_mode: 'Week'
    });
    setTimeout(applyDashGanttStyling, 100);
  }catch(e){
    console.warn('Dashboard-Zeitstrahl konnte nicht gerendert werden', e);
    target.style.display = 'none';
    empty.style.display = 'block';
    empty.textContent = 'Zeitstrahl konnte nicht geladen werden.';
  }
}

if(document.readyState !== 'loading'){ renderDashGantt(); }
else document.addEventListener('DOMContentLoaded', renderDashGantt);
</script>
{{end}}
