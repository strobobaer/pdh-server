{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Zeiterfassung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.TodayCount}} Einträge heute · {{.TodayStr}}</p>
  </div>
  {{template "icon-button-toolbar" (dict
    "Class" "end"
    "Label" "Zeit-Aktionen"
    "Items" (list
      (dict "Action" "edit" "ShowLabel" true "Label" "Manuell" "OnClick" "openManual()")
      (dict "Action" "start" "ShowLabel" true "Label" "Zeit starten" "OnClick" "openStart()")
    )
  )}}
</div>

{{if .IsAdmin}}
<div class="card" style="margin-bottom:14px;padding:12px">
  <div style="display:flex;align-items:center;gap:10px">
    <label class="form-label" style="margin:0">Nutzer:</label>
    <select id="user-filter" class="form-input" style="max-width:260px" onchange="if(this.value)window.location='/time?user='+this.value;else window.location='/time'">
      <option value="">Alle Nutzer</option>
      {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.FilterUser}}selected{{end}}>{{.Name}}</option>{{end}}
    </select>
  </div>
</div>
{{end}}

{{if .Running}}
<div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;padding:14px;margin-bottom:16px;display:flex;align-items:center;gap:12px">
  <div style="width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(16,185,129,.15);flex-shrink:0;animation:pulse 1.5s infinite"></div>
  <div style="flex:1">
    <div style="font-weight:500;font-size:14px">{{.Running.Description}}</div>
    <div style="font-size:12px;color:var(--green);margin-top:2px">
      Gestartet {{.Running.StartedStr}} · <span id="live-timer" style="font-weight:600">…</span>
    </div>
  </div>
  {{template "icon-button" (dict "Action" "stop" "ShowLabel" true "Style" "border-color:rgba(16,185,129,.5);color:var(--green)" "Label" "Stoppen" "OnClick" (printf "this.disabled=true;this.textContent='...';fetch('/time/%s/stop-web',{method:'POST'}).then(()=>location.reload())" .Running.ID))}}
</div>
{{end}}

<div class="stats" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px">
  <div class="stat s-blue">
    <div class="stat-label">Heute</div>
    <div class="stat-val">{{.TodayStr}}</div>
    <div class="stat-sub">{{.TodayCount}} Einträge</div>
  </div>
  <div class="stat s-green">
    <div class="stat-label">Diese Woche</div>
    <div class="stat-val">{{.WeekStr}}</div>
  </div>
  <div class="stat {{if .Running}}s-amber{{else}}s-gray{{end}}">
    <div class="stat-label">Status</div>
    <div class="stat-val" style="font-size:16px">{{if .Running}}Läuft{{else}}–{{end}}</div>
  </div>
</div>

<div class="card" style="padding:0">
  <table>
    <thead>
      <tr><th>Beschreibung</th>{{if .IsAdmin}}<th>Nutzer</th>{{end}}<th>Typ</th><th>Kostenstelle</th><th>Start</th><th>Ende</th><th>Dauer</th><th></th></tr>
    </thead>
    <tbody>
    {{range .Entries}}
    <tr id="entry-{{.ID}}">
      <td><div style="font-weight:500">{{.Description}}</div></td>
      {{if $.IsAdmin}}<td style="font-size:12px;color:var(--muted)">{{.UserName}}</td>{{end}}
      <td><div style="display:flex;align-items:center;gap:6px"><div class="act-dot {{.RefTypeDot}}"></div><span style="font-size:12px;color:var(--muted)">{{.RefTypeLabel}}</span></div></td>
      <td style="font-size:12px;color:var(--muted)">{{if .InfraName}}{{.InfraName}}{{else}}–{{end}}</td>
      <td style="font-family:monospace;font-size:12px">{{.StartedStr}}</td>
      <td style="font-family:monospace;font-size:12px">{{if .Running}}<span style="color:var(--green)">läuft…</span>{{else}}{{.EndedStr}}{{end}}</td>
      <td><span style="font-size:12px;font-weight:500">{{if .Running}}<span style="color:var(--green)">aktiv</span>{{else}}{{.DurationStr}}{{end}}</span></td>
      <td style="white-space:nowrap">
        {{if not .Running}}
        <button type="button" class="btn btn-icon" style="width:32px;height:32px" title="Bearbeiten" onclick="openEditEntry('{{.ID}}','{{.Description}}','{{.StartedISO}}','{{.EndedISO}}')"><i class="ti ti-edit"></i></button>
        {{template "icon-button" (dict "Action" "delete" "Style" "color:var(--muted)" "Label" "Löschen" "OnClick" (printf "if(confirm('Eintrag löschen?')){this.disabled=true;fetch('/time/%s/delete-web',{method:'DELETE'}).then(()=>document.getElementById('entry-%s')?.remove())}" .ID .ID))}}
        {{end}}
      </td>
    </tr>
    {{else}}
    <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:40px">
      <i class="ti ti-clock" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4"></i>Noch keine Einträge heute
    </td></tr>
    {{end}}
    </tbody>
  </table>
</div>

<div class="card" style="margin-top:14px">
  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <span>Zeitstrahl</span>
    <div style="display:flex;gap:8px">
      <select id="time-range-select" class="form-input" style="font-size:12px" onchange="applyTimeRange()">
        <option value="today" {{if eq .FilterRange "today"}}selected{{end}}>Heute</option>
        <option value="week" {{if eq .FilterRange "week"}}selected{{end}}>Diese Woche</option>
        <option value="month" {{if eq .FilterRange "month"}}selected{{end}}>Dieser Monat</option>
      </select>
      <select id="time-raster-select" class="form-input" style="font-size:12px" onchange="renderTimeGantt()">
        <option value="15">15 Minuten</option>
        <option value="60" selected>1 Stunde</option>
        <option value="1440">1 Tag</option>
        <option value="10080">1 Woche</option>
      </select>
    </div>
  </div>
  <div id="timeline-scroll" style="overflow-x:auto;border:1px solid var(--border);border-radius:8px">
    <div id="timeline-header" style="display:flex;position:sticky;top:0;background:var(--bg2);border-bottom:1px solid var(--border);z-index:2"></div>
    <div id="timeline-rows" style="position:relative"></div>
  </div>
  <div id="timeline-empty" style="display:none;font-size:12px;color:var(--muted);padding:20px;text-align:center">
    Keine Eintraege im aktuellen Zeitraum.
  </div>
</div>

<!-- ── Monatsauswertung ── -->
<div class="card" style="margin-top:24px">
  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <span>Monatsauswertung</span>
    <div style="display:flex;align-items:center;gap:8px">
      <button type="button" class="btn btn-small" onclick="changeMonth(-1)"><i class="ti ti-chevron-left"></i></button>
      <div id="month-label" style="font-size:13px;font-weight:500;min-width:120px;text-align:center"></div>
      <button type="button" class="btn btn-small" onclick="changeMonth(1)"><i class="ti ti-chevron-right"></i></button>
      <a id="export-csv-link" href="#" class="btn btn-small" style="margin-left:8px;text-decoration:none"><i class="ti ti-download"></i> CSV Export</a>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1.6fr 1fr;gap:20px;padding:16px;align-items:start" class="month-charts-grid">
    <div style="position:relative;height:260px"><canvas id="month-bar-chart"></canvas></div>
    <div style="position:relative;height:260px"><canvas id="month-pie-chart"></canvas></div>
  </div>
</div>

<!-- ── Start Modal ── -->
<div id="start-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:460px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)">
    <div style="font-size:15px;font-weight:600;margin-bottom:4px">Zeit starten</div>
    <div style="font-size:12px;color:var(--muted);margin-bottom:18px">Aufgabe auswählen</div>
    <form id="start-form">
      <div class="form-group">
        <label class="form-label">Typ</label>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px" id="start-type-btns">
          <button type="button" class="type-btn active" onclick="setType(this,'fault')"><div style="font-size:18px">🔴</div><div style="font-size:10px;margin-top:3px">Störung</div></button>
          <button type="button" class="type-btn" onclick="setType(this,'ticket')"><div style="font-size:18px">🎫</div><div style="font-size:10px;margin-top:3px">Ticket</div></button>
          <button type="button" class="type-btn" onclick="setType(this,'maintenance')"><div style="font-size:18px">🔧</div><div style="font-size:10px;margin-top:3px">Wartung</div></button>
          <button type="button" class="type-btn" onclick="setType(this,'production')"><div style="font-size:18px">⚙️</div><div style="font-size:10px;margin-top:3px">Sonstiges</div></button>
        </div>
        <input type="hidden" id="start-ref-type" value="fault">
      </div>
      <div class="form-group" id="start-select-grp">
        <label class="form-label">Aufgabe</label>
        <select id="start-ref-select" class="form-input"><option value="">Lädt…</option></select>
      </div>
      <div class="form-group" id="start-text-grp" style="display:none">
        <label class="form-label">Aktivität</label>
        <input id="start-activity" class="form-input" placeholder="z.B. Rüsten, Reinigung…">
        <input type="hidden" id="start-uuid">
      </div>
      <div class="form-group">
        <label class="form-label">Beschreibung <span style="color:var(--muted)">(optional)</span></label>
        <input id="start-desc" class="form-input" placeholder="Was wird gemacht?">
      </div>
      {{template "infra-tree-picker" (dict "TargetID" "start-infra-id" "SelectedLabelID" "start-infra-selected" "Label" "Kostenstelle (optional)")}}
      <div id="start-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:12px"></div>
      {{template "icon-button-toolbar" (dict
        "Class" "end"
        "Label" "Formularaktionen"
        "Style" "width:100%;justify-content:flex-end"
        "Items" (list
          (dict "Action" "cancel" "ShowLabel" true "OnClick" "closeStart()")
          (dict "Action" "start" "ShowLabel" true "Type" "submit" "ID" "start-btn")
        )
      )}}
    </form>
  </div>
</div>

<!-- ── Manuell Modal ── -->
<div id="manual-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:460px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)">
    <div style="font-size:15px;font-weight:600;margin-bottom:4px">Manuell erfassen</div>
    <div style="font-size:12px;color:var(--muted);margin-bottom:18px">Zurückliegende Zeit eintragen</div>
    <form id="manual-form">
      <div class="form-group">
        <label class="form-label">Typ</label>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">
          <button type="button" class="type-btn active" onclick="setTypeM(this,'fault')"><div style="font-size:18px">🔴</div><div style="font-size:10px;margin-top:3px">Störung</div></button>
          <button type="button" class="type-btn" onclick="setTypeM(this,'ticket')"><div style="font-size:18px">🎫</div><div style="font-size:10px;margin-top:3px">Ticket</div></button>
          <button type="button" class="type-btn" onclick="setTypeM(this,'maintenance')"><div style="font-size:18px">🔧</div><div style="font-size:10px;margin-top:3px">Wartung</div></button>
          <button type="button" class="type-btn" onclick="setTypeM(this,'production')"><div style="font-size:18px">⚙️</div><div style="font-size:10px;margin-top:3px">Sonstiges</div></button>
        </div>
        <input type="hidden" id="manual-ref-type" value="fault">
      </div>
      <div class="form-group" id="manual-select-grp">
        <label class="form-label">Aufgabe</label>
        <select id="manual-ref-select" class="form-input"><option value="">Lädt…</option></select>
      </div>
      <div class="form-group" id="manual-text-grp" style="display:none">
        <label class="form-label">Aktivität</label>
        <input id="manual-activity" class="form-input" placeholder="z.B. Rüsten, Reinigung…">
        <input type="hidden" id="manual-uuid">
      </div>
      <div class="form-group">
        <label class="form-label">Beschreibung</label>
        <input id="manual-desc" class="form-input" placeholder="Was wurde gemacht?">
      </div>
      {{template "infra-tree-picker" (dict "TargetID" "manual-infra-id" "SelectedLabelID" "manual-infra-selected" "Label" "Kostenstelle (optional)")}}
      <div class="grid2">
        <div class="form-group"><label class="form-label">Start</label><input type="datetime-local" id="manual-start" class="form-input" required></div>
        <div class="form-group"><label class="form-label">Ende</label><input type="datetime-local" id="manual-end" class="form-input" required></div>
      </div>
      <div id="manual-duration" style="font-size:12px;text-align:right;margin-top:-8px;margin-bottom:12px"></div>
      <div id="manual-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:12px"></div>
      {{template "icon-button-toolbar" (dict
        "Class" "end"
        "Label" "Formularaktionen"
        "Style" "width:100%;justify-content:flex-end"
        "Items" (list
          (dict "Action" "cancel" "ShowLabel" true "OnClick" "closeManual()")
          (dict "Action" "save" "ShowLabel" true "Type" "submit")
        )
      )}}
    </form>
  </div>
</div>
<!-- ── Bearbeiten Modal ── -->
<div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:460px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)">
    <div style="font-size:15px;font-weight:600;margin-bottom:18px">Eintrag bearbeiten</div>
    <form id="edit-form">
      <input type="hidden" id="edit-id">
      <div class="form-group">
        <label class="form-label">Beschreibung</label>
        <input id="edit-desc" class="form-input">
      </div>
      <div class="grid2">
        <div class="form-group"><label class="form-label">Start</label><input type="datetime-local" id="edit-start" class="form-input" required></div>
        <div class="form-group"><label class="form-label">Ende</label><input type="datetime-local" id="edit-end" class="form-input"></div>
      </div>
      <div id="edit-duration" style="font-size:12px;text-align:right;margin-top:-8px;margin-bottom:12px"></div>
      <div id="edit-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:12px"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn" onclick="closeEditEntry()">Abbrechen</button>
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Speichern</button>
      </div>
    </form>
  </div>
</div>

{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:8px">Heute</div>
{{range .Entries}}
<div class="act-item">
  <div class="act-dot {{.RefTypeDot}}"></div>
  <div class="act-text">{{.Description}}</div>
  <span style="font-size:10px;color:var(--muted)">{{if .Running}}läuft{{else}}{{.DurationStr}}{{end}}</span>
</div>
{{else}}<div style="font-size:11px;color:var(--muted)">Keine Einträge</div>{{end}}
{{end}}

{{block "scripts" .}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.type-btn{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 6px;cursor:pointer;text-align:center;color:var(--text);transition:all .15s;font-family:var(--font)}
.type-btn:hover{border-color:var(--muted)}
.type-btn.active{border-color:var(--accent);background:rgba(79,110,247,.12)}
.s-gray .stat-val{color:var(--muted)}
</style>
<script>
const tok = () => document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1]||'';

// ── Monatsauswertung (Balken- & Tortendiagramm) ─────────────
let chartYear, chartMonth, monthBarChart, monthPieChart;
const MONTH_NAMES = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

function changeMonth(delta) {
  chartMonth += delta;
  if (chartMonth < 1) { chartMonth = 12; chartYear--; }
  if (chartMonth > 12) { chartMonth = 1; chartYear++; }
  loadMonthlyCharts();
}

async function loadMonthlyCharts() {
  document.getElementById('month-label').textContent = MONTH_NAMES[chartMonth-1] + ' ' + chartYear;
  document.getElementById('export-csv-link').href = `/api/v1/time/export.csv?year=${chartYear}&month=${chartMonth}`;

  const h = {'Authorization':'Bearer '+tok()};
  const [daysRes, catsRes] = await Promise.all([
    fetch(`/api/v1/time/monthly/days?year=${chartYear}&month=${chartMonth}`, {headers:h}),
    fetch(`/api/v1/time/monthly/categories?year=${chartYear}&month=${chartMonth}`, {headers:h}),
  ]);
  const days = (await daysRes.json()).data || [];
  const cats = (await catsRes.json()).data || [];

  const daysInMonth = new Date(chartYear, chartMonth, 0).getDate();
  const dayLabels = [], dayHours = [];
  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${chartYear}-${String(chartMonth).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const entry = days.find(x => x.date === dateStr);
    dayLabels.push(d);
    dayHours.push(entry ? +(entry.total_min/60).toFixed(2) : 0);
  }

  const catLabels = cats.map(c => c.label);
  const catHours = cats.map(c => +(c.total_min/60).toFixed(2));

  if (monthBarChart) monthBarChart.destroy();
  monthBarChart = new Chart(document.getElementById('month-bar-chart'), {
    type: 'bar',
    data: { labels: dayLabels, datasets: [{ label: 'Stunden', data: dayHours, backgroundColor: '#4f6ef7', borderRadius: 3 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, title: { display: false } },
      scales: { y: { beginAtZero: true, title: { display: true, text: 'Stunden' } }, x: { title: { display: true, text: 'Tag' } } }
    }
  });

  if (monthPieChart) monthPieChart.destroy();
  monthPieChart = new Chart(document.getElementById('month-pie-chart'), {
    type: 'pie',
    data: { labels: catLabels, datasets: [{ data: catHours, backgroundColor: ['#4f6ef7','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#6366f1','#14b8a6'] }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } }
    }
  });
}

(function initMonthlyCharts(){
  const now = new Date();
  chartYear = now.getFullYear();
  chartMonth = now.getMonth() + 1;
  loadMonthlyCharts();
})();

// ── Eigene Zeitachse (statt Frappe Gantt, fuer freie Taktung inkl. 15min) ──
var RANGE_FROM = new Date('{{.RangeFromISO}}');
var RANGE_TO = new Date('{{.RangeToISO}}');
var timelineEntries = [
{{range .Entries}}
  {id:'{{.ID}}', name:'{{if $.IsAdmin}}{{.UserName}}: {{end}}{{.Description}}', desc:'{{.Description}}', start:'{{.StartedISO}}', end:'{{if .EndedISO}}{{.EndedISO}}{{else}}{{.StartedISO}}{{end}}', endedRaw:'{{.EndedISO}}', running: {{if .Running}}true{{else}}false{{end}} },
{{end}}
];

var TL_COL_PX = 40;

function tlRasterMinutes(){
  var sel = document.getElementById('time-raster-select');
  return sel ? parseInt(sel.value, 10) : 60;
}

function tlFormatLabel(d, rasterMin){
  var p2 = function(n){ return String(n).padStart(2,'0'); };
  if(rasterMin < 1440){
    return p2(d.getHours())+':'+p2(d.getMinutes());
  }
  return p2(d.getDate())+'.'+p2(d.getMonth()+1)+'.';
}

function renderTimeGantt(){
  var scrollBox = document.getElementById('timeline-scroll');
  var header = document.getElementById('timeline-header');
  var rows = document.getElementById('timeline-rows');
  var empty = document.getElementById('timeline-empty');

  if(!timelineEntries.length){
    scrollBox.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  scrollBox.style.display = 'block';
  empty.style.display = 'none';

  var rasterMin = tlRasterMinutes();
  var totalMin = Math.max(1, Math.round((RANGE_TO - RANGE_FROM) / 60000));
  var colCount = Math.ceil(totalMin / rasterMin);
  var totalWidth = colCount * TL_COL_PX;

  // Kopfzeile zeichnen
  header.innerHTML = '';
  header.style.width = totalWidth + 'px';
  for(var i = 0; i < colCount; i++){
    var colTime = new Date(RANGE_FROM.getTime() + i * rasterMin * 60000);
    var cell = document.createElement('div');
    cell.style.width = TL_COL_PX + 'px';
    cell.style.minWidth = TL_COL_PX + 'px';
    cell.style.flexShrink = '0';
    cell.style.fontSize = '10px';
    cell.style.color = 'var(--muted)';
    cell.style.textAlign = 'center';
    cell.style.padding = '6px 0';
    cell.style.borderRight = '1px solid var(--border)';
    cell.textContent = tlFormatLabel(colTime, rasterMin);
    header.appendChild(cell);
  }

  // Zeilen (eine pro Eintrag) zeichnen
  rows.innerHTML = '';
  rows.style.width = totalWidth + 'px';
  var rowHeight = 40;

  timelineEntries.forEach(function(entry, idx){
    var row = document.createElement('div');
    row.style.position = 'relative';
    row.style.height = rowHeight + 'px';
    row.style.borderBottom = '1px solid var(--border)';
    row.style.background = idx % 2 === 0 ? 'transparent' : 'rgba(255,255,255,.015)';

    var entryStart = new Date(entry.start);
    var entryEnd = entry.end ? new Date(entry.end) : new Date(entryStart.getTime() + rasterMin*60000);
    if(entryEnd <= entryStart){ entryEnd = new Date(entryStart.getTime() + rasterMin*60000); }

    var startOffsetMin = (entryStart - RANGE_FROM) / 60000;
    var durationMin = (entryEnd - entryStart) / 60000;
    var left = (startOffsetMin / rasterMin) * TL_COL_PX;
    var width = Math.max(TL_COL_PX * 0.5, (durationMin / rasterMin) * TL_COL_PX);

    var bar = document.createElement('div');
    bar.className = 'timeline-bar';
    bar.dataset.entryId = entry.id;
    bar.style.position = 'absolute';
    bar.style.top = '6px';
    bar.style.height = (rowHeight - 12) + 'px';
    bar.style.left = left + 'px';
    bar.style.width = width + 'px';
    bar.style.background = entry.running ? 'rgba(16,185,129,.8)' : 'rgba(79,110,247,.8)';
    bar.style.borderRadius = '5px';
    bar.style.cursor = 'grab';
    bar.style.display = 'flex';
    bar.style.alignItems = 'center';
    bar.style.paddingLeft = '6px';
    bar.style.fontSize = '11px';
    bar.style.color = '#fff';
    bar.style.whiteSpace = 'nowrap';
    bar.style.overflow = 'hidden';
    bar.title = entry.name + ' (' + entryStart.toLocaleString('de-DE') + ' - ' + entryEnd.toLocaleString('de-DE') + ')';
    bar.textContent = entry.name;
    bar.title += ' — Doppelklick zum Bearbeiten';

    bar.addEventListener('dblclick', function(e){
      e.preventDefault();
      e.stopPropagation();
      openEditEntry(entry.id, entry.desc, entry.start, entry.endedRaw);
    });

    if(!entry.running){
      var leftHandle = document.createElement('div');
      leftHandle.className = 'timeline-handle-left';
      leftHandle.style.position = 'absolute';
      leftHandle.style.left = '0';
      leftHandle.style.top = '0';
      leftHandle.style.bottom = '0';
      leftHandle.style.width = '6px';
      leftHandle.style.cursor = 'ew-resize';
      leftHandle.style.background = 'rgba(255,255,255,.25)';
      bar.appendChild(leftHandle);

      var rightHandle = document.createElement('div');
      rightHandle.className = 'timeline-handle-right';
      rightHandle.style.position = 'absolute';
      rightHandle.style.right = '0';
      rightHandle.style.top = '0';
      rightHandle.style.bottom = '0';
      rightHandle.style.width = '6px';
      rightHandle.style.cursor = 'ew-resize';
      rightHandle.style.background = 'rgba(255,255,255,.25)';
      bar.appendChild(rightHandle);
    }

    row.appendChild(bar);
    rows.appendChild(row);

    if(!entry.running){
      tlMakeDraggable(bar, row, entry, rasterMin, durationMin, leftHandle, rightHandle);
    }
  });
}

function tlMakeDraggable(bar, row, entry, rasterMin, durationMin, leftHandle, rightHandle){
  var mode = null; // 'move' | 'resize-left' | 'resize-right'
  var startX = 0;
  var origLeft = 0;
  var origWidth = 0;

  function beginDrag(e, m){
    mode = m;
    startX = e.clientX;
    origLeft = parseFloat(bar.style.left);
    origWidth = parseFloat(bar.style.width);
    e.preventDefault();
    e.stopPropagation();
  }

  bar.addEventListener('mousedown', function(e){
    if(e.target === leftHandle || e.target === rightHandle) return;
    bar.style.cursor = 'grabbing';
    beginDrag(e, 'move');
  });
  if(leftHandle) leftHandle.addEventListener('mousedown', function(e){ beginDrag(e, 'resize-left'); });
  if(rightHandle) rightHandle.addEventListener('mousedown', function(e){ beginDrag(e, 'resize-right'); });

  document.addEventListener('mousemove', function(e){
    if(!mode) return;
    var deltaX = e.clientX - startX;
    if(mode === 'move'){
      var newLeft = origLeft + deltaX;
      if(newLeft < 0) newLeft = 0;
      bar.style.left = newLeft + 'px';
    } else if(mode === 'resize-left'){
      var newLeft2 = origLeft + deltaX;
      var newWidth2 = origWidth - deltaX;
      if(newLeft2 < 0){ newWidth2 += newLeft2; newLeft2 = 0; }
      if(newWidth2 < TL_COL_PX * 0.5) newWidth2 = TL_COL_PX * 0.5;
      bar.style.left = newLeft2 + 'px';
      bar.style.width = newWidth2 + 'px';
    } else if(mode === 'resize-right'){
      var newWidth3 = origWidth + deltaX;
      if(newWidth3 < TL_COL_PX * 0.5) newWidth3 = TL_COL_PX * 0.5;
      bar.style.width = newWidth3 + 'px';
    }
  });

  document.addEventListener('mouseup', function(e){
    if(!mode) return;
    var finishedMode = mode;
    mode = null;
    bar.style.cursor = 'grab';

    var finalLeft = parseFloat(bar.style.left);
    var finalWidth = parseFloat(bar.style.width);
    var snappedStartCols = Math.round(finalLeft / TL_COL_PX);
    var snappedEndCols = Math.round((finalLeft + finalWidth) / TL_COL_PX);
    if(snappedEndCols <= snappedStartCols) snappedEndCols = snappedStartCols + 1;

    var snappedLeft = snappedStartCols * TL_COL_PX;
    var snappedWidth = (snappedEndCols - snappedStartCols) * TL_COL_PX;
    bar.style.left = snappedLeft + 'px';
    bar.style.width = snappedWidth + 'px';

    var newStart = new Date(RANGE_FROM.getTime() + snappedStartCols * rasterMin * 60000);
    var newEnd = new Date(RANGE_FROM.getTime() + snappedEndCols * rasterMin * 60000);

    var changed = (finishedMode === 'move' && Math.abs(finalLeft - origLeft) > 2) ||
                  (finishedMode !== 'move' && Math.abs(finalWidth - origWidth) > 2 || finishedMode === 'resize-left' && Math.abs(finalLeft - origLeft) > 2);
    if(changed){
      saveTimeEntryDates(entry.id, newStart, newEnd);
    }
  });
}

function formatDateTimeLocal(d){
  var dt = (d instanceof Date) ? d : new Date(d);
  if(isNaN(dt.getTime())) return '';
  var year = dt.getFullYear();
  var month = String(dt.getMonth()+1).padStart(2,'0');
  var day = String(dt.getDate()).padStart(2,'0');
  var hour = String(dt.getHours()).padStart(2,'0');
  var min = String(dt.getMinutes()).padStart(2,'0');
  return year+'-'+month+'-'+day+'T'+hour+':'+min;
}

async function saveTimeEntryDates(entryId, start, end){
  var startStr = formatDateTimeLocal(start);
  var endStr = formatDateTimeLocal(end);
  if(!startStr){
    alert('Ungueltiges Startdatum.');
    location.reload();
    return;
  }
  var fd = new FormData();
  fd.append('description', '');
  fd.append('started_at', startStr);
  fd.append('ended_at', endStr);
  try{
    var res = await fetch('/time/'+entryId+'/edit-web', {method:'POST', body:fd});
    if(!res.ok){
      var text = await res.text();
      throw new Error(text.replace(/<[^>]+>/g,'') || 'Fehler');
    }
    location.reload();
  }catch(e){
    alert('Termin konnte nicht gespeichert werden: '+e.message);
    location.reload();
  }
}

function applyTimeRange(){
  var range = document.getElementById('time-range-select').value;
  var url = new URL(window.location.href);
  url.searchParams.set('range', range);
  window.location.href = url.toString();
}

document.getElementById('timeline-scroll').addEventListener('wheel', function(e){
  if(!e.ctrlKey) return;
  e.preventDefault();
  var delta = e.deltaY < 0 ? 6 : -6;
  TL_COL_PX = Math.max(16, Math.min(120, TL_COL_PX + delta));
  renderTimeGantt();
}, {passive:false});

if(document.readyState !== 'loading') renderTimeGantt();
else document.addEventListener('DOMContentLoaded', renderTimeGantt);

// ── Live-Timer ───────────────────────────────────────────────
{{if .Running}}
(function(){
  const el = document.getElementById('live-timer');
  if(!el) return;
  const parts = '{{.Running.StartedStr}}'.split(':');
  const start = new Date();
  start.setHours(+parts[0], +parts[1], 0, 0);
  if(start > new Date()) start.setDate(start.getDate()-1);
  const tick = () => {
    const s = Math.floor((Date.now()-start)/1000);
    const h = Math.floor(s/3600), m = Math.floor(s%3600/60), sec = s%60;
    el.textContent = h>0 ? `${h}h ${String(m).padStart(2,'0')}min` : `${m}min ${String(sec).padStart(2,'0')}s`;
  };
  tick(); setInterval(tick, 1000);
})();
{{end}}

// ── Stopp ────────────────────────────────────────────────────
document.querySelectorAll('[data-stop-id]').forEach(btn => {
  btn.addEventListener('click', async function(){
    this.disabled=true; this.textContent='…';
    await fetch(`/time/${this.dataset.stopId}/stop-web`, {method:'POST'});
    location.reload();
  });
});

// ── Löschen ──────────────────────────────────────────────────
document.querySelectorAll('[data-delete-id]').forEach(btn => {
  btn.addEventListener('click', async function(){
    if(!confirm('Eintrag löschen?')) return;
    this.disabled=true;
    await fetch(`/time/${this.dataset.deleteId}/delete-web`, {method:'DELETE'});
    const row = document.getElementById('entry-'+this.dataset.deleteId);
    if(row){ row.style.transition='opacity .25s'; row.style.opacity='0'; setTimeout(()=>row.remove(),250); }
  });
});

// ── API laden ────────────────────────────────────────────────
async function fetchRefs(type) {
  const h = {'Authorization':'Bearer '+tok()};
  try {
    if(type==='fault') { const d=await(await fetch('/api/v1/faults',{headers:h})).json(); return (d.data||[]).filter(x=>x.status!=='resolved'&&x.status!=='closed').map(x=>({id:x.id,title:x.title})); }
    if(type==='ticket') { const d=await(await fetch('/api/v1/tickets?status=open',{headers:h})).json(); return (d.data||[]).map(x=>({id:x.id,title:x.title})); }
    if(type==='maintenance') { const d=await(await fetch('/api/v1/maintenance/tasks?status=open',{headers:h})).json(); return (d.data||[]).map(x=>({id:x.id,title:x.title})); }
  } catch(e){}
  return [];
}
async function fillSelect(sel, type) {
  sel.innerHTML='<option>Lädt…</option>';
  const items = await fetchRefs(type);
  sel.innerHTML = items.length ? items.map(i=>`<option value="${i.id}">${i.title}</option>`).join('') : '<option value="">– Keine Einträge –</option>';
}

// ── Start Modal ──────────────────────────────────────────────
function openStart(){document.getElementById('start-modal').style.display='flex';loadStartRefs('fault');}
function closeStart(){document.getElementById('start-modal').style.display='none';}
function setType(btn,type){
  btn.closest('[id="start-type-btns"]').querySelectorAll('.type-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('start-ref-type').value=type;
  loadStartRefs(type);
}
async function loadStartRefs(type){
  const sg=document.getElementById('start-select-grp'),tg=document.getElementById('start-text-grp'),sel=document.getElementById('start-ref-select');
  if(type==='production'){sg.style.display='none';tg.style.display='block';document.getElementById('start-uuid').value=crypto.randomUUID();}
  else{sg.style.display='block';tg.style.display='none';await fillSelect(sel,type);}
}
document.getElementById('start-form').addEventListener('submit', async function(e){
  e.preventDefault();
  const btn=document.getElementById('start-btn'); btn.disabled=true; btn.textContent='…';
  const type=document.getElementById('start-ref-type').value;
  let refId='', desc=document.getElementById('start-desc').value.trim();
  if(type==='production'){refId=document.getElementById('start-uuid').value; if(!desc)desc=document.getElementById('start-activity').value||'Sonstiges';}
  else{const sel=document.getElementById('start-ref-select'); refId=sel.value; if(!desc&&sel.selectedOptions[0])desc=sel.selectedOptions[0].text;}
  const fd=new FormData(); fd.append('ref_type',type); fd.append('ref_id',refId); fd.append('description',desc);
  fd.append('infrastructure_id', document.getElementById('start-infra-id').value);
  const res=await fetch('/time/start-web',{method:'POST',body:fd});
  if(res.ok){closeStart();location.reload();}
  else{const t=await res.text(); const err=document.getElementById('start-error'); err.textContent=t.replace(/<[^>]+>/g,'')||'Fehler'; err.style.display='block'; btn.disabled=false; btn.innerHTML='<i class="ti ti-player-play"></i>Starten';}
});

// ── Manuell Modal ────────────────────────────────────────────
function openManual(){
  document.getElementById('manual-modal').style.display='flex';
  const now=new Date(), p=n=>String(n).padStart(2,'0');
  const fmt=d=>`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  document.getElementById('manual-end').value=fmt(now);
  document.getElementById('manual-start').value=fmt(new Date(now-3600000));
  updateDuration(); loadManualRefs('fault');
}
function closeManual(){document.getElementById('manual-modal').style.display='none';}
function setTypeM(btn,type){
  btn.closest('.form-group').querySelectorAll('.type-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); document.getElementById('manual-ref-type').value=type; loadManualRefs(type);
}
async function loadManualRefs(type){
  const sg=document.getElementById('manual-select-grp'),tg=document.getElementById('manual-text-grp'),sel=document.getElementById('manual-ref-select');
  if(type==='production'){sg.style.display='none';tg.style.display='block';document.getElementById('manual-uuid').value=crypto.randomUUID();}
  else{sg.style.display='block';tg.style.display='none';await fillSelect(sel,type);}
}
function updateDuration(){
  const s=document.getElementById('manual-start').value, e=document.getElementById('manual-end').value, el=document.getElementById('manual-duration');
  if(!s||!e){el.textContent='';return;}
  const diff=Math.round((new Date(e)-new Date(s))/60000);
  if(diff<=0){el.style.color='var(--red)';el.textContent='⚠ Ende muss nach Start liegen';return;}
  el.style.color='var(--accent)'; el.textContent=`Dauer: ${diff>=60?Math.floor(diff/60)+'h ':''}${diff%60}min`;
}
document.getElementById('manual-start').addEventListener('change',updateDuration);
document.getElementById('manual-end').addEventListener('change',updateDuration);
document.getElementById('manual-form').addEventListener('submit', async function(e){
  e.preventDefault();
  const type=document.getElementById('manual-ref-type').value;
  let refId='', desc=document.getElementById('manual-desc').value.trim();
  if(type==='production'){refId=document.getElementById('manual-uuid').value; if(!desc)desc=document.getElementById('manual-activity').value||'Sonstiges';}
  else{const sel=document.getElementById('manual-ref-select'); refId=sel.value; if(!desc&&sel.selectedOptions[0])desc=sel.selectedOptions[0].text;}
  const fd=new FormData(); fd.append('ref_type',type); fd.append('ref_id',refId); fd.append('description',desc);
  fd.append('started_at',document.getElementById('manual-start').value);
  fd.append('ended_at',document.getElementById('manual-end').value);
  fd.append('infrastructure_id', document.getElementById('manual-infra-id').value);
  const res=await fetch('/time/manual-web',{method:'POST',body:fd});
  if(res.ok){closeManual();location.reload();}
  else{const t=await res.text(); const err=document.getElementById('manual-error'); err.textContent=t.replace(/<[^>]+>/g,'')||'Fehler'; err.style.display='block';}
});

// ── Bearbeiten Modal ─────────────────────────────────────────
function openEditEntry(id, desc, startISO, endISO){
  document.getElementById('edit-id').value = id;
  document.getElementById('edit-desc').value = desc;
  document.getElementById('edit-start').value = startISO;
  document.getElementById('edit-end').value = endISO || '';
  document.getElementById('edit-error').style.display = 'none';
  updateEditDuration();
  document.getElementById('edit-modal').style.display = 'flex';
}
function closeEditEntry(){ document.getElementById('edit-modal').style.display = 'none'; }
function updateEditDuration(){
  var s = document.getElementById('edit-start').value, e = document.getElementById('edit-end').value;
  var el = document.getElementById('edit-duration');
  if(!s || !e){ el.textContent = ''; return; }
  var diff = Math.round((new Date(e) - new Date(s)) / 60000);
  if(diff <= 0){ el.style.color = 'var(--red)'; el.textContent = '⚠ Ende muss nach Start liegen'; return; }
  el.style.color = 'var(--accent)';
  el.textContent = 'Dauer: ' + (diff >= 60 ? Math.floor(diff/60)+'h ' : '') + (diff % 60) + 'min';
}
document.getElementById('edit-start').addEventListener('change', updateEditDuration);
document.getElementById('edit-end').addEventListener('change', updateEditDuration);
document.getElementById('edit-form').addEventListener('submit', async function(e){
  e.preventDefault();
  var id = document.getElementById('edit-id').value;
  var fd = new FormData();
  fd.append('description', document.getElementById('edit-desc').value);
  fd.append('started_at', document.getElementById('edit-start').value);
  fd.append('ended_at', document.getElementById('edit-end').value);
  var res = await fetch('/time/'+id+'/edit-web', {method:'POST', body:fd});
  var text = await res.text();
  if(res.ok){ location.reload(); }
  else{
    var err = document.getElementById('edit-error');
    err.innerHTML = text;
    err.style.display = 'block';
  }
});
document.getElementById('edit-modal').addEventListener('click', function(e){
  if(e.target.id === 'edit-modal') closeEditEntry();
});

// ── Backdrop ─────────────────────────────────────────────────
['start-modal','manual-modal'].forEach(id=>{
  document.getElementById(id).addEventListener('click',e=>{if(e.target.id===id)document.getElementById(id).style.display='none';});
});
</script>
{{end}}
