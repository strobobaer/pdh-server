{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  <a href="/tasks" class="btn btn-icon"><i class="ti ti-arrow-left"></i></a>
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Task.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">
      {{.Task.CreatedAgo}}{{if .Task.ProjectName}} · Projekt: {{.Task.ProjectName}}{{end}}
    </p>
  </div>
  <span class="badge {{.Task.PriorityClass}}" style="font-size:12px;padding:4px 12px">{{.Task.Priority}}</span>
  <span class="badge {{.Task.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Task.StatusLabel}}</span>
</div>

<div class="grid2" style="grid-template-columns:1fr 300px;gap:14px;align-items:start">
  <div>
    {{if .Task.Description}}
    <div class="card">
      <div class="card-title">Beschreibung</div>
      <p style="font-size:13px;line-height:1.7;color:var(--muted)">{{.Task.Description}}</p>
    </div>
    {{end}}

    {{if .Task.Resolution}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div class="card-title"><i class="ti ti-check" style="color:var(--green)"></i> Gelöst</div>
      <p style="font-size:13px;margin-bottom:8px"><strong>Maßnahme:</strong> {{.Task.Resolution}}</p>
      {{if .Task.RootCause}}<p style="font-size:13px;color:var(--muted)"><strong>Grundursache:</strong> {{.Task.RootCause}}</p>{{end}}
    </div>
    {{end}}

    {{if .Task.CanResolve}}
    <div class="card">
      <div class="card-title"><i class="ti ti-clipboard-check" style="color:var(--accent)"></i> Aufgabe lösen</div>

      <div style="margin-bottom:16px">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Durchgeführte Maßnahmen</div>
        <div id="task-actions-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
        <div style="display:flex;gap:8px">
          <input id="ta-new-action" class="form-input" placeholder="z.B. Ursache behoben" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addTaskAction();}">
          <button type="button" class="btn" onclick="addTaskAction()"><i class="ti ti-plus"></i></button>
        </div>
      </div>

      <div style="margin-bottom:16px">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Ersatzteile</div>
        <div id="task-parts-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
        <button type="button" class="btn" onclick="openTaskPartModal()"><i class="ti ti-package"></i> Ersatzteil vormerken</button>
        <label style="display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted);margin-top:10px">
          <input type="checkbox" id="ta-no-parts"> Keine Ersatzteile benötigt
        </label>
      </div>

      <div class="form-group">
        <label class="form-label">Lösung / Maßnahmen-Zusammenfassung</label>
        <textarea id="ta-resolution" class="form-input" rows="3" placeholder="Was wurde gemacht?" style="resize:vertical"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Grundursache</label>
        <input id="ta-rootcause" class="form-input" placeholder="Warum ist es passiert?">
      </div>
      <div id="task-resolve-result" style="font-size:12px;margin-bottom:8px"></div>
      <div style="display:flex;justify-content:flex-end">
        <button type="button" class="btn btn-primary" onclick="resolveTask()"><i class="ti ti-check"></i> Aufgabe lösen</button>
      </div>
    </div>

    <div id="task-part-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:6000;align-items:center;justify-content:center">
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:22px;width:100%;max-width:420px;margin:20px">
        <div style="font-size:15px;font-weight:600;margin-bottom:14px">Ersatzteil vormerken</div>
        <div class="form-group">
          <label class="form-label">Ersatzteil</label>
          <input id="ta-part-search" class="form-input" placeholder="Suchen..." oninput="filterTaskParts()" autocomplete="off">
          <div id="ta-part-results" style="max-height:160px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;margin-top:4px;display:none"></div>
          <input type="hidden" id="ta-part-id">
          <div id="ta-part-selected" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Lagerort</label>
          <select id="ta-part-location" class="form-input"><option value="">Lade Lagerorte...</option></select>
        </div>
        <div class="form-group">
          <label class="form-label">Menge</label>
          <input id="ta-part-qty" type="number" step="0.001" class="form-input" value="1">
        </div>
        <div id="ta-part-error" style="display:none;color:var(--red);font-size:12px;margin-bottom:8px"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
          <button type="button" class="btn" onclick="closeTaskPartModal()">Abbrechen</button>
          <button type="button" class="btn btn-primary" onclick="bookTaskPart()">Vormerken</button>
        </div>
      </div>
    </div>
    {{end}}
  </div>

  <div>
    <div class="card">
      <div class="card-title"><i class="ti ti-clock"></i> Zeiterfassung</div>
      {{if .RunningTime}}
      <div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:10px;margin-bottom:10px">
        <div style="font-size:12px;color:var(--green);font-weight:500">Läuft seit {{.RunningTime.StartedAt.Format "15:04"}}</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px">{{.RunningTime.Description}}</div>
      </div>
      <button type="button" class="btn" style="width:100%;justify-content:center;margin-bottom:8px" onclick="stopTaskTime('{{.RunningTime.ID}}')"><i class="ti ti-player-stop"></i> Zeit stoppen</button>
      {{else}}
      <button type="button" class="btn" style="width:100%;justify-content:center;margin-bottom:8px" onclick="startTaskTime()"><i class="ti ti-player-play"></i> Zeit erfassen</button>
      {{end}}
      <div id="task-time-result" style="font-size:12px;margin-bottom:8px"></div>
      {{range .TimeEntries}}
      <div class="li">
        <div class="li-text">
          <div class="li-title" style="font-size:12px">{{.Description}}</div>
          <div class="li-sub">{{if .DurationMin}}{{.DurationMin}}min{{else}}läuft...{{end}}</div>
        </div>
      </div>
      {{else}}
      <div style="font-size:12px;color:var(--muted);padding:4px 0">Keine Zeiteinträge</div>
      {{end}}
    </div>

    <div class="card">
      <div class="card-title">Details</div>
      <div class="li"><div class="li-text"><div class="li-sub">Priorität</div><div class="li-title"><span class="badge {{.Task.PriorityClass}}">{{.Task.Priority}}</span></div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Status</div><div class="li-title"><span class="badge {{.Task.StatusClass}}">{{.Task.StatusLabel}}</span></div></div></div>
      {{if .Task.DueDate}}<div class="li"><div class="li-text"><div class="li-sub">Fällig am</div><div class="li-title">{{.Task.DueDate}}</div></div></div>{{end}}
      {{if .Task.StartDate}}<div class="li"><div class="li-text"><div class="li-sub">Start</div><div class="li-title">{{.Task.StartDate}}</div></div></div>{{end}}
      {{if .Task.AssigneeName}}<div class="li"><div class="li-text"><div class="li-sub">Zugewiesen</div><div class="li-title">{{.Task.AssigneeName}}</div></div></div>{{end}}
      {{if .Task.ResponsibleName}}<div class="li"><div class="li-text"><div class="li-sub">Verantwortlich</div><div class="li-title">{{.Task.ResponsibleName}}</div></div></div>{{end}}
      {{if .Task.ProjectName}}<div class="li"><div class="li-text"><div class="li-sub">Projekt</div><div class="li-title"><a href="/projects/{{.Task.ProjectID}}" style="color:var(--accent)">{{.Task.ProjectName}}</a></div></div></div>{{end}}
      {{if .Task.CanResolve}}
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <label class="form-label">Farbe im Gantt (optional)</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="color" id="ta-color-picker" class="form-input" style="width:60px;height:36px;padding:2px" value="{{if .Task.Color}}{{.Task.Color}}{{else}}#4f6ef7{{end}}">
          <button type="button" class="btn" style="font-size:11px" onclick="saveTaskColor()">Speichern</button>
        </div>
        <div id="task-color-result" style="font-size:11px;margin-top:6px"></div>
      </div>
      {{end}}
    </div>
  </div>
</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:6px">Aufgabe</div>
<div class="act-item"><div class="act-dot {{.Task.PriorityDot}}"></div><div class="act-text">{{.Task.Title}}</div><span class="badge {{.Task.StatusClass}}" style="font-size:9px">{{.Task.StatusLabel}}</span></div>
{{end}}

{{define "scripts"}}
<script>
var TASK_ID = '{{.Task.ID}}';
var taPartsCache = null;
function escTa(s){return String(s||'').replace(/[&<>'"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]);});}

async function loadTaskActions(){
  var box = document.getElementById('task-actions-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/actions', {credentials:'same-origin'});
    var json = await res.json();
    var actions = json.data || json || [];
    box.innerHTML = actions.length ? actions.map(function(a){
      var t = new Date(a.created_at);
      var timeStr = t.toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escTa(a.description)+'</div><div class="li-sub">'+timeStr+' · '+escTa(a.created_by_name)+'</div></div></div>';
    }).join('') : '<div style="padding:4px 0">Noch keine Maßnahmen erfasst</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function addTaskAction(){
  var input = document.getElementById('ta-new-action');
  var description = input.value.trim();
  if(!description) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/actions', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({description:description})
    });
    var json = await res.json();
    if(!res.ok) throw new Error(json.error||'Fehler');
    input.value='';
    loadTaskActions();
  }catch(e){ alert('Fehler: '+e.message); }
}

async function loadTaskPartsList(){
  var box = document.getElementById('task-parts-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts', {credentials:'same-origin'});
    var json = await res.json();
    var pending = json.data || json || [];
    box.innerHTML = pending.length ? pending.map(function(p){
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escTa(p.part_name)+' <span style="color:var(--muted)">('+escTa(p.part_number)+')</span></div><div class="li-sub">'+p.qty+' Stk · '+escTa(p.storage_name)+'</div></div><button type="button" class="btn" style="font-size:11px;color:var(--red)" onclick="removeTaskPendingPart(THISID)"><i class="ti ti-x"></i></button></div>'.replace('THISID', "'"+p.id+"'");
    }).join('') : '<div style="padding:4px 0">Noch keine Ersatzteile vorgemerkt</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function removeTaskPendingPart(id){
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts/'+id, {method:'DELETE', credentials:'same-origin'});
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    loadTaskPartsList();
  }catch(e){ alert('Fehler beim Entfernen: '+e.message); }
}

async function loadTaskPartsCache(){
  if(taPartsCache) return taPartsCache;
  var res = await fetch('/api/v1/inventory/', {credentials:'same-origin'});
  var json = await res.json();
  taPartsCache = json.data || json || [];
  return taPartsCache;
}
async function loadTaskStorageOptions(selectEl){
  try{
    var res = await fetch('/api/v1/storage/', {credentials:'same-origin'});
    var json = await res.json();
    var tree = json.data || json;
    var options = [];
    function walk(nodes, prefix){
      (nodes||[]).forEach(function(n){
        var label = prefix ? prefix+' > '+n.name : n.name;
        options.push({id:n.id, label:label});
        if(n.children && n.children.length) walk(n.children, label);
      });
    }
    walk(Array.isArray(tree) ? tree : (tree.children||[]), '');
    selectEl.innerHTML = '<option value="">Lagerort wählen...</option>' + options.map(function(o){return '<option value="'+o.id+'">'+escTa(o.label)+'</option>';}).join('');
  }catch(e){
    selectEl.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}
function openTaskPartModal(){
  document.getElementById('task-part-modal').style.display='flex';
  document.getElementById('ta-part-search').value='';
  document.getElementById('ta-part-id').value='';
  document.getElementById('ta-part-selected').textContent='';
  document.getElementById('ta-part-results').style.display='none';
  document.getElementById('ta-part-error').style.display='none';
  document.getElementById('ta-part-qty').value='1';
  loadTaskStorageOptions(document.getElementById('ta-part-location'));
}
function closeTaskPartModal(){ document.getElementById('task-part-modal').style.display='none'; }
async function filterTaskParts(){
  var q = document.getElementById('ta-part-search').value.trim().toLowerCase();
  var box = document.getElementById('ta-part-results');
  if(!q){ box.style.display='none'; return; }
  var parts = await loadTaskPartsCache();
  var matches = parts.filter(function(p){
    return (p.name||'').toLowerCase().indexOf(q)!==-1 || (p.part_number||'').toLowerCase().indexOf(q)!==-1;
  }).slice(0,20);
  var html = '';
  for(var i=0;i<matches.length;i++){
    var p = matches[i];
    var row = document.createElement('div');
    row.style.padding='6px 8px';
    row.style.cursor='pointer';
    row.style.fontSize='12px';
    row.style.borderBottom='1px solid var(--border)';
    row.textContent = p.name + ' (' + p.part_number + ')';
    row.addEventListener('click', (function(part){ return function(){ selectTaskPart(part.id, part.name); }; })(p));
    box.appendChild(row);
  }
  box.innerHTML = '';
  if(matches.length === 0){
    box.innerHTML = '<div style="padding:6px 8px;font-size:12px;color:var(--muted)">Keine Treffer</div>';
  } else {
    for(var j=0;j<matches.length;j++){
      var mp = matches[j];
      var el = document.createElement('div');
      el.style.padding='6px 8px';
      el.style.cursor='pointer';
      el.style.fontSize='12px';
      el.style.borderBottom='1px solid #333';
      el.textContent = mp.name + ' (' + mp.part_number + ')';
      el.addEventListener('click', (function(part){ return function(){ selectTaskPart(part.id, part.name); }; })(mp));
      box.appendChild(el);
    }
  }
  box.style.display='block';
}
function selectTaskPart(id,label){
  document.getElementById('ta-part-id').value=id;
  document.getElementById('ta-part-selected').textContent='Ausgewählt: '+label;
  document.getElementById('ta-part-results').style.display='none';
  document.getElementById('ta-part-search').value='';
}
async function bookTaskPart(){
  var partId = document.getElementById('ta-part-id').value;
  var locationId = document.getElementById('ta-part-location').value;
  var qty = parseFloat(document.getElementById('ta-part-qty').value);
  var errEl = document.getElementById('ta-part-error');
  errEl.style.display='none';
  if(!partId){ errEl.textContent='Bitte ein Ersatzteil auswählen'; errEl.style.display='block'; return; }
  if(!locationId){ errEl.textContent='Bitte einen Lagerort auswählen'; errEl.style.display='block'; return; }
  if(!qty || qty<=0){ errEl.textContent='Bitte eine gültige Menge angeben'; errEl.style.display='block'; return; }
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/pending-parts', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({part_id:partId, storage_node_id:locationId, qty:qty})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    closeTaskPartModal();
    loadTaskPartsList();
  }catch(e){ errEl.textContent='Fehler: '+e.message; errEl.style.display='block'; }
}

async function resolveTask(){
  var result = document.getElementById('task-resolve-result');
  var payload = {
    resolution: document.getElementById('ta-resolution').value,
    root_cause: document.getElementById('ta-rootcause').value,
    no_parts_needed: document.getElementById('ta-no-parts').checked
  };
  result.textContent = 'Speichere...';
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/resolve', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    location.reload();
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}

async function startTaskTime(){
  var result = document.getElementById('task-time-result');
  result.textContent = 'Starte...';
  try{
    var res = await fetch('/tasks/'+TASK_ID+'/time/start', {method:'POST', credentials:'same-origin'});
    var text = await res.text();
    result.innerHTML = text;
    setTimeout(function(){ location.reload(); }, 800);
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}
async function stopTaskTime(entryID){
  var result = document.getElementById('task-time-result');
  result.textContent = 'Stoppe...';
  try{
    var res = await fetch('/time/'+entryID+'/stop-web', {method:'POST', credentials:'same-origin'});
    var text = await res.text();
    result.innerHTML = text;
    setTimeout(function(){ location.reload(); }, 800);
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}

async function saveTaskColor(){
  var color = document.getElementById('ta-color-picker').value;
  var result = document.getElementById('task-color-result');
  result.textContent = 'Speichere...';
  try{
    var res = await fetch('/api/v1/tasks/'+TASK_ID+'/edit', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({color: color})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    result.innerHTML = '<span style="color:var(--green)">Gespeichert</span>';
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escTa(e.message)+'</span>'; }
}

if(document.readyState !== 'loading'){ loadTaskActions(); loadTaskPartsList(); }
else document.addEventListener('DOMContentLoaded', function(){ loadTaskActions(); loadTaskPartsList(); });
</script>
{{end}}


