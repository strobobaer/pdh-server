<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>{{if .NoInfra}}Terminal{{else}}{{.Name}} – Terminal{{end}}</title>
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/vendor/tabler-icons/tabler-icons.min.css?v={{appVersion}}">
<style>
/* Anlagenterminal (terminal_page.go): Vollbild für den Wandmonitor, nur Berührung.
   Trefferflächen mindestens 64 px, keine Hover-Bedienung, wenig Text. */
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0f1117;--bg2:#1a1d27;--bg3:#222536;--accent:#4f6ef7;--text:#f1f3fb;--muted:#9aa3b8;--border:#2f3348;--red:#ef4444;--amber:#f59e0b;--green:#10b981;--font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--font);font-size:clamp(18px,1.6vw,28px);line-height:1.3;overflow:hidden;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;cursor:default}
body{display:flex;flex-direction:column;padding:max(2vh,12px) max(2vw,16px)}
a{color:inherit;text-decoration:none}
.t-head{display:flex;align-items:center;gap:1.2vw;min-height:64px;padding-bottom:1.4vh}
.t-path{flex:1;min-width:0;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.t-path b{color:var(--text);font-weight:700}
.t-clock{color:var(--muted);font-variant-numeric:tabular-nums}
.t-btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-width:64px;min-height:64px;padding:0 1.6em;border-radius:18px;border:2px solid var(--border);background:var(--bg3);color:var(--text);font:inherit;font-weight:700}
.t-btn:active{filter:brightness(1.25)}
.t-btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.t-btn.big{min-height:clamp(88px,12vh,140px);font-size:1.25em;border-radius:22px;width:100%}
/* Schoner */
.t-saver{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3vh;text-align:center;padding:4vh 4vw;background:var(--bg)}
.t-saver .name{font-size:clamp(40px,7vw,120px);font-weight:800;line-height:1.1;max-width:92vw;overflow-wrap:anywhere}
.t-saver .time{font-size:clamp(32px,5vw,84px);color:var(--muted);font-variant-numeric:tabular-nums}
.t-saver .hint{font-size:clamp(20px,2.2vw,36px);color:var(--accent);font-weight:700;padding:1.2vh 2.4vw;border:2px solid var(--accent);border-radius:999px}
/* Störungsinfo */
.t-cols{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:1.6vw}
.t-tile{display:flex;flex-direction:column;min-height:0;background:var(--bg2);border:2px solid var(--border);border-radius:22px;padding:1.4vh 1.4vw}
.t-tile h2{display:flex;align-items:center;gap:.5em;font-size:1.25em;padding-bottom:1vh;border-bottom:2px solid var(--border)}
.t-tile h2 .n{margin-left:auto;min-width:2.2em;text-align:center;padding:.05em .5em;border-radius:999px;background:var(--bg3);font-variant-numeric:tabular-nums}
.t-tile.faults h2 .n.has{background:var(--red);color:#fff}
.t-tile.tickets h2 .n.has{background:var(--amber);color:#1b1500}
.t-list{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;list-style:none}
.t-list li{display:grid;grid-template-columns:1fr auto;column-gap:1em;padding:1.1vh 0;border-bottom:1px solid var(--border)}
.t-list .ti-title{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-meta{grid-column:1/-1;color:var(--muted);font-size:.8em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.t-list .ti-st{color:var(--muted);font-size:.85em;white-space:nowrap}
.t-empty{display:flex;align-items:center;justify-content:center;gap:.5em;flex:1;color:var(--green);font-weight:700;font-size:1.1em}
.t-more{color:var(--muted);text-align:center;padding:1vh 0;font-size:.85em}
.t-foot{padding-top:1.6vh;display:flex;gap:1.6vw}
/* Neu */
.t-new{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) auto;gap:1.6vw}
.t-tilebtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2vh;border-radius:26px;border:2px solid var(--border);font-weight:800;font-size:1.7em;padding:3vh 2vw;min-height:64px;text-align:center}
.t-tilebtn i{font-size:2.2em}
.t-tilebtn.fault{background:#7f1d1d;border-color:var(--red)}
.t-tilebtn.ticket{background:#78350f;border-color:var(--amber)}
.t-tilebtn:active{filter:brightness(1.25)}
.t-stop{grid-column:1/-1;background:var(--bg2);border:2px dashed var(--border);border-radius:22px;padding:2vh 2vw}
.t-stop h2{font-size:1.1em;display:flex;align-items:center;gap:.5em}
.t-stop p{color:var(--muted);margin-top:.5vh}
/* Hinweis ohne Anlage */
.t-none{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2vh;text-align:center}
.t-none i{font-size:4em;color:var(--amber)}
.t-none p{font-size:1.6em;font-weight:700;max-width:30em}
.t-none small{color:var(--muted);font-size:.9em}
@media (max-width:820px){.t-cols,.t-new{grid-template-columns:1fr}.t-new{grid-template-rows:auto}}
</style>
</head>
<body data-mode="{{.Mode}}" data-idle="{{.Idle}}">
{{if .NoInfra}}
<div class="t-none">
  <i class="ti ti-plug-off" aria-hidden="true"></i>
  <p>Diesem Terminal ist keine Anlage zugeordnet</p>
  <small>Bitte in PDH unter „Benutzer“ eine Anlage für dieses Terminal festlegen.</small>
</div>
{{else if eq .Mode "schoner"}}
<a class="t-saver" href="/terminal/info" aria-label="Zum Melden berühren">
  <div class="name">{{.Name}}</div>
  <div class="time t-clock" data-clock>&nbsp;</div>
  <div class="hint"><i class="ti ti-hand-finger" aria-hidden="true"></i> Zum Melden berühren</div>
</a>
{{else if eq .Mode "info"}}
<div class="t-head">
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
<div class="t-cols">
  <section class="t-tile faults" aria-labelledby="h-faults">
    <h2 id="h-faults"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Offene Störungen <span class="n{{if .Info.FaultsTotal}} has{{end}}" data-count="faults">{{.Info.FaultsTotal}}</span></h2>
    {{if .Info.Faults}}<ul class="t-list" data-list="faults">
      {{range .Info.Faults}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="faults" hidden></ul><div class="t-empty" data-empty="faults"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Störungen</div>{{end}}
    <div class="t-more" data-more="faults"{{if not .FaultsMore}} hidden{{end}}>{{if .FaultsMore}}… und {{.FaultsMore}} weitere{{end}}</div>
  </section>
  <section class="t-tile tickets" aria-labelledby="h-tickets">
    <h2 id="h-tickets"><i class="ti ti-ticket" aria-hidden="true"></i> Offene Tickets <span class="n{{if .Info.TicketsTotal}} has{{end}}" data-count="tickets">{{.Info.TicketsTotal}}</span></h2>
    {{if .Info.Tickets}}<ul class="t-list" data-list="tickets">
      {{range .Info.Tickets}}<li><span class="ti-title">{{.Title}}</span><span class="ti-st">{{.StatusLabel}}</span><span class="ti-meta">{{if .Path}}{{.Path}} · {{end}}{{.Age}}</span></li>{{end}}
    </ul>{{else}}<ul class="t-list" data-list="tickets" hidden></ul><div class="t-empty" data-empty="tickets"><i class="ti ti-circle-check" aria-hidden="true"></i> Keine offenen Tickets</div>{{end}}
    <div class="t-more" data-more="tickets"{{if not .TicketsMore}} hidden{{end}}>{{if .TicketsMore}}… und {{.TicketsMore}} weitere{{end}}</div>
  </section>
</div>
<div class="t-foot">
  <a class="t-btn primary big" href="/terminal/neu"><i class="ti ti-plus" aria-hidden="true"></i> Neu</a>
</div>
{{else}}
<div class="t-head">
  <a class="t-btn" href="/terminal/info"><i class="ti ti-arrow-left" aria-hidden="true"></i> Zurück</a>
  <div class="t-path">{{if .Path}}{{.Path}}{{else}}<b>{{.Name}}</b>{{end}}</div>
  <div class="t-clock" data-clock>&nbsp;</div>
</div>
<div class="t-new">
  <a class="t-tilebtn fault" href="/e/{{.InfraID}}"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Störung</a>
  <a class="t-tilebtn ticket" href="/e/{{.InfraID}}"><i class="ti ti-ticket" aria-hidden="true"></i> Ticket</a>
  <div class="t-stop">
    <h2><i class="ti ti-player-pause" aria-hidden="true"></i> Stillstand</h2>
    <p>Stillstandsgründe folgen</p>
  </div>
</div>
{{end}}
<script src="/terminal/terminal.js?v={{appVersion}}"></script>
</body>
</html>
