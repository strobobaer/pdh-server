# Shell-Skripte laufen unter Linux und in Containern: immer LF
*.sh text eol=lf
# Golden-Dateien der Tests enthalten SQL/HTML mit LF; unter Windows (autocrlf) nicht umwandeln
internal/web/testdata/** text eol=lf
# TIA-Quellen der Tests byte-genau halten (CRLF, Windows-1252)
internal/modules/tiamqtt/testdata/** -text
# ESPPDH-Erwartungsdateien (ESPHome-YAML) werden Byte für Byte verglichen: immer LF
internal/modules/esppdh/testdata/** text eol=lf
# ESP Web Tools (USB-Flash im Browser) Byte für Byte wie im npm-Paket – SHA256SUMS prüft das
web/static/vendor/esp-web-tools/** -text
# Bibliotheken der Seiten (htmx, Sortable, Gantt, Chart.js, Excel, Word) unverändert wie von der Quelle
web/static/vendor/htmx/** -text
web/static/vendor/sortablejs/** -text
web/static/vendor/frappe-gantt/** -text
web/static/vendor/chartjs/** -text
web/static/vendor/xlsx/** -text
web/static/vendor/mammoth/** -text
