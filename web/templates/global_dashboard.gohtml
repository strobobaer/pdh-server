<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>PDH · Übersicht</title>
<script>
(function(){
  var mode = localStorage.getItem('pdh_theme') || 'system';
  var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.dataset.theme = mode === 'system' ? (systemDark ? 'dark' : 'light') : mode;
  document.documentElement.dataset.themeMode = mode;
})();
</script>
<style>
:root{
  color-scheme:dark;font-family:"Aptos","Segoe UI",sans-serif;
  --bg:#101512;--surface:#19211c;--surface-2:#222d26;--border:#35443a;--text:#f1f5f2;--muted:#a2b0a6;
  --accent:#4f6ef7;--green:#2b8a57;--amber:#c48b22;--red:#bd4747;--focus:#b6e3c6;--overdue:#e05a5a;
  --type-fault:#3fae86;--type-ticket:#4b9fc4;--type-maintenance:#c99a3c;--type-task:#9d7fc9;
  --type-fault-bg:#254b43;--type-fault-fg:#bce8d5;
  --type-ticket-bg:#214b61;--type-ticket-fg:#b7e4f5;
  --type-maintenance-bg:#614719;--type-maintenance-fg:#f3dcaa;
  --type-task-bg:#493d5a;--type-task-fg:#e1d1f4;
  --accept-bg:#24583d;--accept-border:#397b55;
  --finish-bg:#20576a;--finish-border:#347890;
  --discard-bg:#5b3030;--discard-border:#854545;
  --wait-bg:#594817;--wait-border:#856e2a;
}
:root[data-theme="light"]{
  color-scheme:light;
  --bg:#f5f7fb;--surface:#ffffff;--surface-2:#eef2f7;--border:#d7dee8;--text:#111827;--muted:#64748b;
  --accent:#3457d5;--green:#059669;--amber:#d97706;--red:#dc2626;--focus:#1d4ed8;--overdue:#dc2626;
  --type-fault:#0f9d6b;--type-ticket:#1f7fae;--type-maintenance:#b3801e;--type-task:#7c5bc7;
  --type-fault-bg:#d6f3e7;--type-fault-fg:#0b6b49;
  --type-ticket-bg:#dbeefb;--type-ticket-fg:#155d85;
  --type-maintenance-bg:#faedd2;--type-maintenance-fg:#8a5f10;
  --type-task-bg:#ece3fa;--type-task-fg:#5b3fa3;
  --accept-bg:#dcf3e6;--accept-border:#8fd1ac;
  --finish-bg:#daeef8;--finish-border:#8dc4dd;
  --discard-bg:#fbe0e0;--discard-border:#e2a3a3;
  --wait-bg:#faedd0;--wait-border:#e0bf78;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text)}
body{display:flex;flex-direction:column;overflow:hidden}
button,input,textarea,select{font:inherit}
select{color-scheme:inherit}
button{color:inherit}
header{min-height:74px;padding:12px 20px;display:flex;align-items:center;gap:16px;background:var(--surface);border-bottom:1px solid var(--border)}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand-mark{width:42px;height:42px;display:grid;place-items:center;background:var(--green);color:#fff;font-size:20px;font-weight:800;border-radius:7px;flex:none}
h1{font-size:21px;line-height:1.15;margin:0;font-weight:700}
.subtitle{margin-top:4px;color:var(--muted);font-size:13px}
.heading-edit-btn{flex:none;width:34px;height:34px;min-height:0;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
.heading-edit-btn:hover{color:var(--text);filter:brightness(1.14)}
#heading-form{display:flex;flex-direction:column;gap:6px}
#heading-form input{background:var(--surface-2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:5px 9px;min-height:0}
#heading-title-input{font-size:18px;font-weight:700;width:min(360px,60vw)}
#heading-subtitle-input{font-size:12.5px;width:min(420px,70vw)}
.heading-form-actions{display:flex;gap:6px;margin-top:2px}
.heading-form-actions button{min-height:30px;padding:0 10px;font-size:12px;border:1px solid var(--border);border-radius:6px;background:var(--surface-2);color:var(--text);cursor:pointer}
.heading-form-actions button:hover{filter:brightness(1.14)}
.header-meta{margin-left:auto;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
.header-button,.action-button{min-height:48px;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;text-decoration:none;cursor:pointer;font-weight:650;white-space:nowrap}
.header-button:hover,.action-button:hover{filter:brightness(1.14)}
.header-button:focus-visible,.action-button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.tl-ray:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
main{min-height:0;flex:1;display:flex;flex-direction:column;padding:14px 18px 18px;gap:10px;overflow:auto}
.toolbar{min-height:40px;flex:none;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
#load-state{margin-left:auto}
.legend{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}
.legend-dot.fault{background:var(--type-fault)}.legend-dot.ticket{background:var(--type-ticket)}.legend-dot.maintenance{background:var(--type-maintenance)}.legend-dot.task{background:var(--type-task)}.legend-dot.overdue{background:var(--overdue)}

/* ── Anzeigebereich ── */
#timeline-range{flex:none;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:var(--muted)}
#timeline-range input[type="date"]{min-height:36px;padding:4px 8px;border-radius:6px;border:1px solid var(--border);background:var(--surface);color:var(--text)}

/* ── Zeitstrahl ── */
#timeline-card{flex:none;display:flex;border:1px solid var(--border);border-radius:7px;background:var(--surface);overflow:hidden;height:600px}
.tl-labels{flex:none;width:98px;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--surface)}
.tl-corner{height:34px;flex:none;border-bottom:1px solid var(--border)}
.tl-lane-label{flex:1;display:flex;align-items:center;padding:0 10px;font-size:12px;font-weight:700;color:var(--muted);border-bottom:1px solid var(--border)}
.tl-lane-label:last-child{border-bottom:0}
.tl-scroll{flex:1;overflow-x:auto;overflow-y:hidden;position:relative}
.tl-content{position:relative;height:100%;display:flex;flex-direction:column}
.tl-axis{height:34px;flex:none;position:relative;background:var(--surface-2);border-bottom:1px solid var(--border)}
.tl-axis-tick{position:absolute;top:0;bottom:0;border-left:1px solid var(--border)}
.tl-axis-label{position:absolute;top:0;height:100%;display:flex;align-items:center;font-size:11px;color:var(--muted);padding-left:5px;white-space:nowrap}
.tl-lanes{flex:1;display:flex;flex-direction:column}
.tl-lane{flex:1;position:relative;border-bottom:1px solid var(--border)}
.tl-lane:last-child{border-bottom:0}
.tl-lane.weekend-cols{background-image:none}
.tl-today-line{position:absolute;top:0;bottom:0;width:2px;background:var(--overdue);z-index:2;pointer-events:none}
.tl-today-line::after{content:'Heute';position:absolute;top:-19px;left:4px;font-size:10px;font-weight:700;color:var(--overdue);white-space:nowrap}
.tl-ray{position:absolute;bottom:0;display:flex;flex-direction:column;align-items:center;cursor:pointer;transform:translateX(-50%);background:none;border:0;padding:0;z-index:1}
.tl-ray-chip{display:flex;flex-direction:column;align-items:center;gap:2px;white-space:nowrap;font-size:22px;line-height:1.2;background:var(--surface-2);border:1px solid var(--border);border-radius:4px;padding:4px 10px;margin-bottom:6px;color:var(--text)}
.tl-ray-title{font-weight:700}
.tl-ray-assignee{font-weight:400;font-size:22px;color:var(--muted)}
.tl-ray-stem{width:6px;border-radius:3px 3px 0 0;background:var(--muted)}
.tl-ray-dot{width:28px;height:28px;border-radius:50%;border:3px solid var(--surface);margin-bottom:-3px;flex:none}
.tl-ray.fault .tl-ray-stem,.tl-ray.fault .tl-ray-dot{background:var(--type-fault)}
.tl-ray.ticket .tl-ray-stem,.tl-ray.ticket .tl-ray-dot{background:var(--type-ticket)}
.tl-ray.maintenance .tl-ray-stem,.tl-ray.maintenance .tl-ray-dot{background:var(--type-maintenance)}
.tl-ray.task .tl-ray-stem,.tl-ray.task .tl-ray-dot{background:var(--type-task)}
.tl-ray.overdue .tl-ray-stem,.tl-ray.overdue .tl-ray-dot{background:var(--overdue)}
.tl-ray.selected .tl-ray-dot{outline:3px solid var(--focus);outline-offset:1px}
.tl-ray-bar{position:absolute;bottom:0;height:16px;border-radius:8px;opacity:.35;pointer-events:none}
.tl-ray-bar.fault{background:var(--type-fault)}
.tl-ray-bar.ticket{background:var(--type-ticket)}
.tl-ray-bar.maintenance{background:var(--type-maintenance)}
.tl-ray-bar.task{background:var(--type-task)}
.tl-ray-bar.overdue{background:var(--overdue)}
.tl-empty{padding:30px;text-align:center;color:var(--muted)}

/* ── Tabelle ── */
#entries-table-wrap{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);overflow:auto;max-height:340px}
#entries-table{width:100%;border-collapse:collapse;font-size:13px}
#entries-table th,#entries-table td{padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap}
#entries-table th{position:sticky;top:0;background:var(--surface-2);color:var(--muted);font-weight:700;font-size:12px}
#entries-table tbody tr{cursor:pointer}
#entries-table tbody tr:hover{background:var(--surface-2)}
#entries-table tbody tr.selected{background:var(--surface-2);outline:2px solid var(--focus);outline-offset:-2px}
#entries-table td.overdue{color:var(--overdue);font-weight:700}

/* ── Ohne Termin ── */
#noduedate-wrap{flex:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:2px 2px}
#noduedate-label{font-size:12px;font-weight:700;color:var(--muted);white-space:nowrap}
.nd-chip{display:inline-flex;align-items:center;gap:7px;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:6px 12px 6px 8px;cursor:pointer;font-size:12.5px}
.nd-chip:hover,.nd-chip.selected{border-color:var(--muted)}
.nd-chip .kind-dot{width:9px;height:9px;border-radius:50%;flex:none}
.nd-chip.fault .kind-dot{background:var(--type-fault)}.nd-chip.ticket .kind-dot{background:var(--type-ticket)}.nd-chip.maintenance .kind-dot{background:var(--type-maintenance)}.nd-chip.task .kind-dot{background:var(--type-task)}

/* ── Bearbeitungsfenster (unterhalb) ── */
#edit-panel{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:16px 18px 18px;display:grid;gap:13px}
.edit-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.edit-panel-head h2{font-size:17px;margin:0}
.edit-actions{display:flex;gap:8px;flex-wrap:wrap}
.edit-actions .action-button{min-width:110px}
.accept{background:var(--accept-bg);border-color:var(--accept-border)}.finish{background:var(--finish-bg);border-color:var(--finish-border)}.discard{background:var(--discard-bg);border-color:var(--discard-border)}.wait{background:var(--wait-bg);border-color:var(--wait-border)}
#action-form,#create-form{display:grid;gap:13px;border-top:1px solid var(--border);padding-top:13px}
#action-form label,#create-form label{display:grid;gap:6px;font-size:13px;font-weight:650}
#action-form input,#action-form textarea,#action-form select,#create-form input,#create-form textarea,#create-form select{width:100%;min-height:48px;padding:10px 11px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text)}
#action-form textarea,#create-form textarea{min-height:96px;resize:vertical}
.required-hint{color:var(--muted);font-weight:400;font-size:12px}
.form-actions{display:flex;justify-content:flex-end;gap:8px}
.form-actions .action-button{min-width:110px}

/* ── Touch-Felder zum Anlegen ── */
#create-tiles{flex:none;display:flex;gap:10px;flex-wrap:wrap}
.create-tile{flex:1;min-width:150px;min-height:64px;display:flex;align-items:center;justify-content:center;gap:10px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);cursor:pointer;font-size:14px;font-weight:650}
.create-tile:hover{filter:brightness(1.12)}
.create-tile-icon{font-size:22px}
.create-tile.fault{border-color:var(--type-fault);color:var(--type-fault-fg,var(--text))}
.create-tile.ticket{border-color:var(--type-ticket)}
.create-tile.task{border-color:var(--type-task)}
#create-panel{flex:none;border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:16px 18px 18px;display:grid;gap:13px}
.kind{display:inline-flex;padding:5px 7px;border-radius:5px;background:var(--type-fault-bg);color:var(--type-fault-fg);font-weight:700;font-size:12px}
.kind.ticket{background:var(--type-ticket-bg);color:var(--type-ticket-fg)}.kind.maintenance{background:var(--type-maintenance-bg);color:var(--type-maintenance-fg)}.kind.task{background:var(--type-task-bg);color:var(--type-task-fg)}
.item-sub{font-size:12px;color:var(--muted);margin-top:5px}
.empty,.error{padding:30px;text-align:center;color:var(--muted)}
.hidden{display:none!important}
@media(max-width:1050px){main{padding:10px}header{padding:10px 12px}.action-button{font-size:12px;padding:0 8px}}
@media(max-width:760px){header{min-height:64px}.brand-mark{width:38px;height:38px}h1{font-size:18px}.subtitle,#updated-at{display:none}.header-meta{gap:6px}.header-button{min-height:46px;padding:0 10px;font-size:12px}main{padding:8px}.toolbar{min-height:32px}#timeline-card{height:520px}.tl-labels{width:76px}}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="brand-mark">P</div>
    <div id="heading-view"><h1 id="heading-title">{{.Title}}</h1><div class="subtitle" id="heading-subtitle">{{if .Subtitle}}{{.Subtitle}}{{end}}</div></div>
    {{if .CanEditHeading}}
    <form id="heading-form" class="hidden">
      <input id="heading-title-input" name="title" maxlength="120" required value="{{.Title}}" placeholder="Überschrift">
      <input id="heading-subtitle-input" name="subtitle" maxlength="200" value="{{.Subtitle}}" placeholder="Untertitel (optional)">
      <div class="heading-form-actions">
        <button type="submit">Speichern</button>
        <button type="button" id="heading-cancel">Abbrechen</button>
      </div>
    </form>
    <button type="button" class="heading-edit-btn" id="heading-edit-btn" title="Überschrift bearbeiten" aria-label="Überschrift bearbeiten">✎</button>
    {{end}}
  </div>
  <div class="header-meta"><span id="updated-at">Wird geladen</span>
    <button class="header-button" type="button" id="theme-toggle" onclick="cycleThemeMode()" title="Darstellung wechseln" aria-label="Darstellung wechseln"><span aria-hidden="true" id="theme-toggle-icon">🖥️</span> <span id="theme-toggle-label">System</span></button>
    <button class="header-button" type="button" id="fullscreen-button" title="Vollbild umschalten"><span aria-hidden="true">⛶</span> Vollbild</button>
    {{if .LoggedIn}}
    <a class="header-button" href="/" title="Zurück zum normalen PDH-Modus"><span aria-hidden="true">↩</span> Zur Startseite</a>
    {{else}}
    <a class="header-button" href="/login" title="In den normalen PDH-Modus wechseln"><span aria-hidden="true">↪</span> Anmelden</a>
    {{end}}
  </div>
</header>
<main>
  <div class="toolbar">
    <strong>Offene Vorgänge</strong><span id="item-count">0 Einträge</span>
    <span class="legend">
      <span><span class="legend-dot fault"></span>Störung</span>
      <span><span class="legend-dot ticket"></span>Ticket</span>
      <span><span class="legend-dot maintenance"></span>Wartung</span>
      <span><span class="legend-dot task"></span>Aufgabe</span>
      <span><span class="legend-dot overdue"></span>Überfällig</span>
    </span>
    <span id="load-state" role="status" aria-live="polite"></span>
  </div>

  <div id="create-tiles">
    <button type="button" class="create-tile fault" data-type="fault"><span class="create-tile-icon" aria-hidden="true">⚠</span><span>Neue Störung</span></button>
    <button type="button" class="create-tile ticket" data-type="ticket"><span class="create-tile-icon" aria-hidden="true">🎫</span><span>Neues Ticket</span></button>
    <button type="button" class="create-tile task" data-type="task"><span class="create-tile-icon" aria-hidden="true">✓</span><span>Neue Aufgabe</span></button>
  </div>

  <div id="create-panel" class="hidden">
    <div class="edit-panel-head">
      <h2 id="create-panel-title" style="font-size:17px;margin:0">Neuer Vorgang</h2>
      <button type="button" class="header-button" id="create-close">Schließen</button>
    </div>
    <form id="create-form">
      <label>Titel <span class="required-hint">Pflichtfeld</span>
        <input id="create-title" name="title" required minlength="3" maxlength="255" placeholder="Kurzbeschreibung">
      </label>
      <label>Beschreibung <span class="required-hint">Pflichtfeld, mehr als drei Wörter</span>
        <textarea id="create-description" name="description" maxlength="2000" required placeholder="Was ist los? Bitte in ganzen Sätzen beschreiben."></textarea>
      </label>
      <label id="create-infra-field">Infrastruktur <span class="required-hint">Pflichtfeld</span>
        <select id="create-infra" name="infrastructure_id" required>
          <option value="">Infrastruktur auswählen …</option>
        </select>
      </label>
      <label>Priorität
        <select id="create-priority" name="priority">
          <option value="low">Niedrig</option>
          <option value="medium" selected>Mittel</option>
          <option value="high">Hoch</option>
          <option value="critical">Kritisch</option>
        </select>
      </label>
      <label id="create-symptoms-field" class="hidden">Symptome
        <input id="create-symptoms" name="symptoms" placeholder="Kommagetrennt, z.B. Rauch, ungewöhnliches Geräusch">
      </label>
      <label id="create-duedate-field" class="hidden">Termin <span class="required-hint" id="create-duedate-hint">Optional, Fälligkeitsdatum</span>
        <input id="create-duedate" type="date" name="due_date">
      </label>
      <label>Ersteller/in <span class="required-hint">Pflichtfeld</span>
        <select id="create-reporter" name="reporter_id" required>
          <option value="">Mitarbeiter/in auswählen …</option>
        </select>
      </label>
      <label>Abweichender Melder <span class="required-hint">Optional, z.B. Besucher ohne PDH-Konto</span>
        <input id="create-reporter-name" name="reporter_name" maxlength="120" placeholder="Nur ausfüllen, falls jemand anderes gemeldet hat">
      </label>
      <div class="form-actions">
        <button type="button" class="action-button" id="create-cancel">Abbrechen</button>
        <button type="submit" class="action-button finish" id="create-submit">Anlegen</button>
      </div>
    </form>
  </div>

  <div id="timeline-range">
    <label for="timeline-range-from">Anzeigebereich von</label>
    <input type="date" id="timeline-range-from">
    <label for="timeline-range-to">bis</label>
    <input type="date" id="timeline-range-to">
  </div>

  <div id="timeline-card">
    <div class="tl-labels">
      <div class="tl-corner"></div>
      <div class="tl-lane-label">Störung</div>
      <div class="tl-lane-label">Ticket</div>
      <div class="tl-lane-label">Wartung</div>
      <div class="tl-lane-label">Aufgabe</div>
    </div>
    <div class="tl-scroll" id="timeline-scroll">
      <div class="tl-content" id="timeline-content">
        <div class="tl-axis" id="timeline-axis"></div>
        <div class="tl-lanes" id="timeline-lanes">
          <div class="tl-lane" data-type="fault"></div>
          <div class="tl-lane" data-type="ticket"></div>
          <div class="tl-lane" data-type="maintenance"></div>
          <div class="tl-lane" data-type="task"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="entries-table-wrap">
    <table id="entries-table">
      <thead>
        <tr><th>Art</th><th>Titel</th><th>Priorität</th><th>Fällig</th><th>Zuständig</th><th>Status</th></tr>
      </thead>
      <tbody id="entries-table-body"></tbody>
    </table>
    <div id="entries-empty" class="empty hidden">Keine offenen Vorgänge vorhanden.</div>
  </div>

  <div id="noduedate-wrap">
    <span id="noduedate-label">Ohne Termin</span>
    <div id="noduedate-list" style="display:flex;gap:8px;flex-wrap:wrap"></div>
  </div>

  <div id="edit-panel" class="hidden">
    <div class="edit-panel-head">
      <div>
        <span id="edit-kind" class="kind"></span>
        <strong id="edit-title" style="font-size:15px"></strong>
        <div class="item-sub" id="edit-meta"></div>
      </div>
      <button type="button" class="header-button" id="edit-close">Schließen</button>
    </div>
    <div class="edit-actions" id="edit-action-buttons">
      <button type="button" class="action-button accept" data-action="accept">Annehmen</button>
      <button type="button" class="action-button finish" data-action="done">Fertig</button>
      <button type="button" class="action-button discard" data-action="discard">Verwerfen</button>
      <button type="button" class="action-button wait" data-action="wait">Warten</button>
    </div>
    <form id="action-form" class="hidden">
      <p id="dialog-item" class="item-sub" style="margin:0"></p>
      <label id="worker-field" class="hidden">Zuständiger Mitarbeiter <span class="required-hint">Pflichtfeld · aktuell jeder Mitarbeiter wählbar</span>
        <select id="assigned-to" name="assigned_to" required><option value="">Mitarbeiter auswählen …</option></select>
      </label>
      <label id="date-field" class="hidden">Wiedervorlage am <span class="required-hint">Pflichtfeld</span>
        <input id="follow-up-date" type="date" name="follow_up_date">
      </label>
      <label>Kommentar <span class="required-hint">Pflichtfeld, mindestens 8 Zeichen</span>
        <textarea id="comment" name="comment" minlength="8" maxlength="1000" required placeholder="Was wurde entschieden oder erledigt?"></textarea>
      </label>
      <label id="parts-field" class="hidden" style="display:flex;align-items:center;gap:10px">
        <input id="no-parts" type="checkbox" name="no_parts_needed" style="width:22px;min-height:22px">
        Keine Ersatzteile benötigt
      </label>
      <label>RFID-Karte zur Bestätigung <span class="required-hint">Pflichtfeld</span>
        <input id="rfid-uid" name="rfid_uid" type="password" autocomplete="off" required placeholder="Karte scannen">
      </label>
      <div class="form-actions">
        <button class="action-button" type="button" id="cancel-action">Abbrechen</button>
        <button class="action-button finish" type="submit" id="submit-action">Bestätigen</button>
      </div>
    </form>
  </div>
</main>
<script>
(function(){
  const THEME_MODES = ['system','light','dark'];
  const THEME_META = {system:{label:'System',icon:'🖥️'},light:{label:'Hell',icon:'☀️'},dark:{label:'Dunkel',icon:'🌙'}};
  function resolveTheme(mode){
    if(mode === 'light' || mode === 'dark') return mode;
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function applyThemeMode(mode){
    const selected = THEME_MODES.includes(mode) ? mode : 'system';
    localStorage.setItem('pdh_theme', selected);
    document.documentElement.dataset.themeMode = selected;
    document.documentElement.dataset.theme = resolveTheme(selected);
    const meta = THEME_META[selected];
    const icon = document.getElementById('theme-toggle-icon');
    const label = document.getElementById('theme-toggle-label');
    const btn = document.getElementById('theme-toggle');
    if(icon) icon.textContent = meta.icon;
    if(label) label.textContent = meta.label;
    if(btn) btn.title = 'Darstellung: ' + meta.label;
  }
  window.cycleThemeMode = function(){
    const current = localStorage.getItem('pdh_theme') || 'system';
    const index = THEME_MODES.indexOf(current);
    applyThemeMode(THEME_MODES[(index + 1) % THEME_MODES.length]);
  };
  applyThemeMode(localStorage.getItem('pdh_theme') || 'system');
  if(window.matchMedia){
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(){
      if((localStorage.getItem('pdh_theme') || 'system') === 'system') applyThemeMode('system');
    });
  }
})();

(function(){
  const DAY_MS = 86400000;
  const WINDOW_BEFORE = 14;
  const WINDOW_AFTER = 60;
  const DAY_WIDTH = 26;
  const MIN_DAYS_WIDE = 2; // Laufbalken nicht beendeter Vorgänge sind mindestens so viele Tage breit
  const LANE_TYPES = ['fault','ticket','maintenance','task'];

  const axisEl = document.getElementById('timeline-axis');
  const lanesEl = document.getElementById('timeline-lanes');
  const contentEl = document.getElementById('timeline-content');
  const noDueList = document.getElementById('noduedate-list');
  const editPanel = document.getElementById('edit-panel');
  const editActions = document.getElementById('edit-action-buttons');
  const form = document.getElementById('action-form');
  const workerField = document.getElementById('worker-field');
  const dateField = document.getElementById('date-field');
  const partsField = document.getElementById('parts-field');
  const workerSelect = document.getElementById('assigned-to');
  const dateInput = document.getElementById('follow-up-date');
  const commentInput = document.getElementById('comment');
  const rfidInput = document.getElementById('rfid-uid');
  const loadState = document.getElementById('load-state');
  const actionNames = {accept:'Annehmen',done:'Fertig',discard:'Verwerfen',wait:'Warten'};
  const rangeFromInput = document.getElementById('timeline-range-from');
  const rangeToInput = document.getElementById('timeline-range-to');
  let current = null; // {item, action}
  let selectedKey = null; // type_key:id
  let latestData = {items:[], workers:[]};

  function localMidnight(d){ return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
  function todayMidnight(){ return localMidnight(new Date()); }
  function parseISODate(s){
    const parts = String(s || '').split('-').map(Number);
    if(parts.length !== 3 || parts.some(isNaN)) return null;
    return new Date(parts[0], parts[1]-1, parts[2]);
  }
  function isoDate(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }
  function fmtAxisDate(d){ return d.getDate() + '.' + (d.getMonth()+1) + '.'; }
  function fmtDisplayDate(d){ return String(d.getDate()).padStart(2,'0') + '.' + String(d.getMonth()+1).padStart(2,'0') + '.' + d.getFullYear(); }

  function itemKey(item){ return item.type_key + ':' + item.id; }

  // Anzeigebereich des Zeitstrahls: per Von/Bis-Feld einstellbar, Voreinstellung ist stets der Beginn der aktuellen Woche.
  function currentWeekStart(){
    const today = todayMidnight();
    const day = today.getDay(); // 0=So, 1=Mo, ...
    const diffToMonday = (day === 0 ? -6 : 1 - day);
    return new Date(today.getTime() + diffToMonday*DAY_MS);
  }
  function defaultDisplayWindow(){
    const start = currentWeekStart();
    const end = new Date(start.getTime() + (WINDOW_BEFORE + WINDOW_AFTER)*DAY_MS);
    return {start:start, end:end};
  }
  function getDisplayWindow(){
    const defaults = defaultDisplayWindow();
    let start = parseISODate(rangeFromInput.value) || defaults.start;
    let end = parseISODate(rangeToInput.value) || defaults.end;
    if(end <= start) end = new Date(start.getTime() + DAY_MS);
    return {start:start, totalDays:Math.round((end - start)/DAY_MS)};
  }
  (function initDisplayWindowInputs(){
    const defaults = defaultDisplayWindow();
    rangeFromInput.value = isoDate(defaults.start);
    rangeToInput.value = isoDate(defaults.end);
  })();
  rangeFromInput.addEventListener('change', function(){ renderTimeline(latestData.items); });
  rangeToInput.addEventListener('change', function(){ renderTimeline(latestData.items); });

  function fillSelect(select, options, placeholder){
    if(!select) return;
    const previous = select.value;
    select.replaceChildren(new Option(placeholder, ''));
    (options || []).forEach(function(opt){ select.add(new Option(opt.name, opt.id)); });
    select.value = previous;
  }
  function setOptions(options){
    fillSelect(workerSelect, options, 'Mitarbeiter auswählen …');
  }

  function renderAxis(windowStart, totalDays){
    axisEl.replaceChildren();
    const today = todayMidnight();
    for(let i=0;i<=totalDays;i++){
      const d = new Date(windowStart.getTime() + i*DAY_MS);
      const x = i*DAY_WIDTH;
      if(d.getDay()===1 || i===0){
        const tick = document.createElement('div');
        tick.className = 'tl-axis-tick';
        tick.style.left = x + 'px';
        axisEl.appendChild(tick);
        const label = document.createElement('div');
        label.className = 'tl-axis-label';
        label.style.left = (x+4) + 'px';
        label.textContent = fmtAxisDate(d);
        axisEl.appendChild(label);
      }
    }
    const todayIdx = Math.round((today - windowStart)/DAY_MS);
    if(todayIdx >= 0 && todayIdx <= totalDays){
      const line = document.createElement('div');
      line.className = 'tl-today-line';
      line.style.left = (todayIdx*DAY_WIDTH) + 'px';
      axisEl.appendChild(line);
    }
  }

  function stemHeight(priority){
    const p = String(priority || '').toLowerCase();
    if(p === 'critical' || p === 'high') return 108;
    if(p === 'medium') return 72;
    return 40;
  }

  function makeRangeBar(item, barLeft, barWidth, overdue){
    const bar = document.createElement('span');
    bar.className = 'tl-ray-bar ' + item.type_key + (overdue ? ' overdue' : '');
    bar.style.left = barLeft + 'px';
    bar.style.width = barWidth + 'px';
    return bar;
  }

  function makeRay(item, x, todayStr, stack){
    const ray = document.createElement('button');
    ray.type = 'button';
    ray.className = 'tl-ray ' + item.type_key;
    const overdue = item.due_date && item.due_date < todayStr;
    if(overdue) ray.className += ' overdue';
    if(itemKey(item) === selectedKey) ray.className += ' selected';
    ray.style.left = x + 'px';
    ray.setAttribute('aria-label', item.type + ': ' + item.title + (item.assignee ? ' · ' + item.assignee : ''));
    const chip = document.createElement('span');
    chip.className = 'tl-ray-chip';
    const chipTitle = document.createElement('span');
    chipTitle.className = 'tl-ray-title';
    chipTitle.textContent = item.title;
    chip.appendChild(chipTitle);
    if(item.assignee){
      const chipAssignee = document.createElement('span');
      chipAssignee.className = 'tl-ray-assignee';
      chipAssignee.textContent = item.assignee;
      chip.appendChild(chipAssignee);
    }
    const stem = document.createElement('span');
    stem.className = 'tl-ray-stem';
    stem.style.height = (stemHeight(item.priority) + (stack || 0)*40) + 'px'; // mehrere Vorgänge am selben Tag staffeln sich statt zu überlappen
    const dot = document.createElement('span');
    dot.className = 'tl-ray-dot';
    ray.appendChild(chip);
    ray.appendChild(dot);
    ray.appendChild(stem);
    ray.addEventListener('click', function(){ selectItem(item); });
    return ray;
  }

  function renderTimeline(items){
    const today = todayMidnight();
    const range = getDisplayWindow();
    const windowStart = range.start;
    const totalDays = range.totalDays;
    const todayStr = today.toISOString().slice(0,10);
    contentEl.style.width = ((totalDays+1)*DAY_WIDTH) + 'px';
    renderAxis(windowStart, totalDays);

    const laneEls = {};
    LANE_TYPES.forEach(function(t){ laneEls[t] = lanesEl.querySelector('[data-type="' + t + '"]'); laneEls[t].replaceChildren(); });

    const todayIdx = Math.max(0, Math.min(totalDays, Math.round((today - windowStart)/DAY_MS)));
    LANE_TYPES.forEach(function(t){
      const line = document.createElement('div');
      line.className = 'tl-today-line';
      line.style.left = (todayIdx*DAY_WIDTH) + 'px';
      laneEls[t].appendChild(line);
    });

    const dayCounts = {}; // "type|dayIdx" -> stacked count, spreads rays slightly so same-day items don't fully overlap
    let anyDated = false;
    items.forEach(function(item){
      const lane = laneEls[item.type_key];
      if(!lane) return;
      const due = parseISODate(item.due_date);
      if(!due) return;
      anyDated = true;
      let idx = Math.round((due - windowStart)/DAY_MS);
      idx = Math.max(0, Math.min(totalDays, idx));
      const stackKey = item.type_key + '|' + idx;
      const stack = dayCounts[stackKey] || 0;
      dayCounts[stackKey] = stack + 1;
      const x = idx*DAY_WIDTH;
      const overdue = item.due_date && item.due_date < todayStr;
      // Noch nicht beendete Vorgänge spannen einen Laufbalken zwischen heute und Fälligkeit auf
      // und nutzen so dynamisch den verfügbaren Anzeigebereich statt einer festen Breite.
      const barStartIdx = Math.min(idx, todayIdx);
      const barEndIdx = Math.max(idx, todayIdx);
      const barDays = Math.max(MIN_DAYS_WIDE, barEndIdx - barStartIdx);
      lane.appendChild(makeRangeBar(item, barStartIdx*DAY_WIDTH, barDays*DAY_WIDTH, overdue));
      lane.appendChild(makeRay(item, x, todayStr, stack));
    });

    Object.keys(laneEls).forEach(function(t){
      if(!laneEls[t].querySelector('.tl-ray')){
        const empty = document.createElement('div');
        empty.className = 'item-sub';
        empty.style.cssText = 'position:absolute;left:8px;top:50%;transform:translateY(-50%)';
        empty.textContent = '—';
        laneEls[t].appendChild(empty);
      }
    });

    if(!items.length){
      lanesEl.insertAdjacentHTML('beforeend', '<div class="tl-empty" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center">Keine offenen Vorgänge vorhanden.</div>');
    }
  }

  const entriesBody = document.getElementById('entries-table-body');
  const entriesEmpty = document.getElementById('entries-empty');

  function makeCell(text, className){
    const td = document.createElement('td');
    if(className) td.className = className;
    td.textContent = text;
    return td;
  }

  function renderEntriesTable(items){
    entriesBody.replaceChildren();
    const todayStr = todayMidnight().toISOString().slice(0,10);
    const sorted = items.slice().sort(function(a, b){
      const da = parseISODate(a.due_date), db = parseISODate(b.due_date);
      if(da && db) return da - db;
      if(da) return -1;
      if(db) return 1;
      return 0;
    });
    sorted.forEach(function(item){
      const tr = document.createElement('tr');
      if(itemKey(item) === selectedKey) tr.className = 'selected';
      const kindCell = document.createElement('td');
      const kindSpan = document.createElement('span');
      kindSpan.className = 'kind ' + item.type_key;
      kindSpan.textContent = item.type;
      kindCell.appendChild(kindSpan);
      tr.appendChild(kindCell);
      tr.appendChild(makeCell(item.title));
      tr.appendChild(makeCell(item.priority || '—'));
      const overdue = item.due_date && item.due_date < todayStr;
      tr.appendChild(makeCell(item.due_date ? fmtDisplayDate(parseISODate(item.due_date)) : '—', overdue ? 'overdue' : ''));
      tr.appendChild(makeCell(item.assignee || '—'));
      tr.appendChild(makeCell(item.status || '—'));
      tr.addEventListener('click', function(){ selectItem(item); });
      entriesBody.appendChild(tr);
    });
    entriesEmpty.classList.toggle('hidden', items.length !== 0);
  }

  function renderNoDueDate(items){
    noDueList.replaceChildren();
    const undated = items.filter(function(item){ return !parseISODate(item.due_date); });
    document.getElementById('noduedate-wrap').classList.toggle('hidden', undated.length === 0);
    undated.forEach(function(item){
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'nd-chip ' + item.type_key + (itemKey(item) === selectedKey ? ' selected' : '');
      chip.innerHTML = '<span class="kind-dot"></span>';
      chip.appendChild(document.createTextNode(item.title));
      chip.addEventListener('click', function(){ selectItem(item); });
      noDueList.appendChild(chip);
    });
  }

  function selectItem(item){
    closeCreatePanel();
    selectedKey = itemKey(item);
    current = null;
    document.getElementById('edit-kind').textContent = item.type;
    document.getElementById('edit-kind').className = 'kind ' + item.type_key;
    document.getElementById('edit-title').textContent = item.title;
    const metaParts = [item.status];
    if(item.priority) metaParts.push('Priorität ' + item.priority);
    if(item.due_date) metaParts.push('Fällig ' + fmtDisplayDate(parseISODate(item.due_date)));
    if(item.assignee) metaParts.push('Zuständig: ' + item.assignee);
    document.getElementById('edit-meta').textContent = metaParts.join(' · ');
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
    editPanel.classList.remove('hidden');
    editPanel.dataset.itemKey = selectedKey;
    editPanel.dataset.item = JSON.stringify(item);
    renderTimeline(latestData.items);
    renderNoDueDate(latestData.items);
    renderEntriesTable(latestData.items);
    editPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
  }

  function closeEditPanel(){
    selectedKey = null;
    current = null;
    editPanel.classList.add('hidden');
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
    delete editPanel.dataset.itemKey;
    renderTimeline(latestData.items);
    renderNoDueDate(latestData.items);
    renderEntriesTable(latestData.items);
  }

  editActions.addEventListener('click', function(event){
    const button = event.target.closest('[data-action]');
    if(!button) return;
    const item = JSON.parse(editPanel.dataset.item || 'null');
    if(!item) return;
    openAction(item, button.dataset.action);
  });

  function openAction(item, action){
    current = {item:item, action:action};
    document.getElementById('dialog-item').textContent = actionNames[action] + ' · ' + item.title;
    workerField.classList.toggle('hidden', action !== 'accept');
    workerSelect.required = action === 'accept';
    dateField.classList.toggle('hidden', action !== 'wait');
    dateInput.required = action === 'wait';
    partsField.classList.toggle('hidden', action !== 'done');
    document.getElementById('submit-action').textContent = actionNames[action];
    form.reset();
    workerSelect.required = action === 'accept';
    dateInput.required = action === 'wait';
    editActions.classList.add('hidden');
    form.classList.remove('hidden');
    commentInput.focus();
  }

  document.getElementById('cancel-action').addEventListener('click', function(){
    current = null;
    form.classList.add('hidden');
    editActions.classList.remove('hidden');
  });
  document.getElementById('edit-close').addEventListener('click', closeEditPanel);

  const createTileNames = {fault:'Neue Störung', ticket:'Neues Ticket', task:'Neue Aufgabe'};
  const createDefaultDueDays = {ticket: {{.DefaultDueDaysTicket}}, task: {{.DefaultDueDaysTask}}};
  const createPanel = document.getElementById('create-panel');
  const createForm = document.getElementById('create-form');
  const createSymptomsField = document.getElementById('create-symptoms-field');
  const createInfraField = document.getElementById('create-infra-field');
  const createInfraSelect = document.getElementById('create-infra');
  const createDueDateField = document.getElementById('create-duedate-field');
  const createDescriptionInput = document.getElementById('create-description');
  const createTitleInput = document.getElementById('create-title');
  let createType = null;

  function openCreatePanel(type){
    createType = type;
    closeEditPanel();
    document.getElementById('create-panel-title').textContent = createTileNames[type] || 'Neuer Vorgang';
    createSymptomsField.classList.toggle('hidden', type !== 'fault');
    const needsInfra = type !== 'task';
    createInfraField.classList.toggle('hidden', !needsInfra);
    createInfraSelect.required = needsInfra;
    createDueDateField.classList.toggle('hidden', type === 'fault');
    if(createDefaultDueDays[type] !== undefined){
      document.getElementById('create-duedate-hint').textContent = 'Optional, leer = ' + createDefaultDueDays[type] + ' Tage nach Anlage';
    }
    createForm.reset();
    document.getElementById('create-priority').value = 'medium';
    createPanel.classList.remove('hidden');
    createPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
    createTitleInput.focus();
  }
  function closeCreatePanel(){
    createType = null;
    createPanel.classList.add('hidden');
    createForm.reset();
  }
  document.querySelectorAll('#create-tiles [data-type]').forEach(function(tile){
    tile.addEventListener('click', function(){ openCreatePanel(tile.dataset.type); });
  });
  document.getElementById('create-close').addEventListener('click', closeCreatePanel);
  document.getElementById('create-cancel').addEventListener('click', closeCreatePanel);

  createDescriptionInput.addEventListener('input', function(){
    const wordCount = createDescriptionInput.value.trim().split(/\s+/).filter(Boolean).length;
    createDescriptionInput.setCustomValidity(wordCount > 3 ? '' : 'Bitte mehr als drei Wörter eingeben');
  });

  createForm.addEventListener('submit', async function(event){
    event.preventDefault();
    if(!createType || !createForm.reportValidity()) return;
    const payload = {
      type: createType,
      title: createTitleInput.value.trim(),
      description: createDescriptionInput.value.trim(),
      priority: document.getElementById('create-priority').value,
      infrastructure_id: createInfraSelect.value,
      reporter_id: document.getElementById('create-reporter').value,
      reporter_name: document.getElementById('create-reporter-name').value.trim(),
      due_date: document.getElementById('create-duedate').value
    };
    if(createType === 'fault'){
      payload.symptoms = String(document.getElementById('create-symptoms').value || '').split(',').map(function(s){return s.trim();}).filter(Boolean);
    }
    const submit = document.getElementById('create-submit');
    submit.disabled = true;
    try{
      const response = await fetch('/global/create', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){return {};});
      if(!response.ok) throw new Error(result.error || 'Vorgang konnte nicht angelegt werden');
      closeCreatePanel();
      await refresh();
    }catch(error){
      loadState.textContent = error.message;
    }finally{
      submit.disabled = false;
    }
  });

  function render(data){
    latestData = data;
    setOptions(data.workers || []);
    fillSelect(document.getElementById('create-reporter'), data.workers || [], 'Mitarbeiter/in auswählen …');
    fillSelect(document.getElementById('create-infra'), data.infrastructure || [], 'Infrastruktur auswählen …');
    document.getElementById('item-count').textContent = data.items.length + (data.items.length === 1 ? ' Eintrag' : ' Einträge');
    renderTimeline(data.items);
    renderNoDueDate(data.items);
    renderEntriesTable(data.items);
    if(selectedKey){
      const still = data.items.find(function(item){ return itemKey(item) === selectedKey; });
      if(still) selectItem(still); else closeEditPanel();
    }
  }

  async function refresh(){
    try{
      const response = await fetch('/global/data', {cache:'no-store'});
      if(!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      render(data);
      document.getElementById('updated-at').textContent = 'Stand ' + new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});
      loadState.textContent = '';
    }catch(error){
      loadState.textContent = 'Verbindung fehlgeschlagen · erneuter Versuch folgt';
    }
  }

  form.addEventListener('submit', async function(event){
    event.preventDefault();
    if(!current || !form.reportValidity()) return;
    const payload = {
      type: current.item.type_key,
      id: current.item.id,
      action: current.action,
      comment: commentInput.value.trim(),
      rfid_uid: rfidInput.value.trim(),
      assigned_to: workerSelect.value,
      follow_up_date: dateInput.value,
      no_parts_needed: document.getElementById('no-parts').checked
    };
    const submit = document.getElementById('submit-action');
    submit.disabled = true;
    try{
      const response = await fetch('/global/actions', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){return {};});
      if(!response.ok) throw new Error(result.error || 'Aktion konnte nicht gespeichert werden');
      closeEditPanel();
      await refresh();
    }catch(error){
      loadState.textContent = error.message;
    }finally{
      submit.disabled = false;
      rfidInput.value = '';
    }
  });

  document.getElementById('fullscreen-button').addEventListener('click', function(){
    if(document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen().catch(function(){});
  });

  const headingEditBtn = document.getElementById('heading-edit-btn');
  if(headingEditBtn){
    const headingView = document.getElementById('heading-view');
    const headingForm = document.getElementById('heading-form');
    const titleInput = document.getElementById('heading-title-input');
    const subtitleInput = document.getElementById('heading-subtitle-input');
    headingEditBtn.addEventListener('click', function(){
      headingView.classList.add('hidden');
      headingEditBtn.classList.add('hidden');
      headingForm.classList.remove('hidden');
      titleInput.focus();
      titleInput.select();
    });
    function closeHeadingForm(){
      headingForm.classList.add('hidden');
      headingView.classList.remove('hidden');
      headingEditBtn.classList.remove('hidden');
    }
    document.getElementById('heading-cancel').addEventListener('click', function(){
      titleInput.value = document.getElementById('heading-title').textContent;
      subtitleInput.value = document.getElementById('heading-subtitle').textContent;
      closeHeadingForm();
    });
    headingForm.addEventListener('submit', async function(event){
      event.preventDefault();
      if(!headingForm.reportValidity()) return;
      try{
        const response = await fetch('/global/settings', {
          method: 'POST', credentials: 'same-origin',
          headers: {'Content-Type': 'application/x-www-form-urlencoded'},
          body: 'title=' + encodeURIComponent(titleInput.value.trim()) + '&subtitle=' + encodeURIComponent(subtitleInput.value.trim())
        });
        if(!response.ok) throw new Error((await response.text()) || ('HTTP ' + response.status));
        document.getElementById('heading-title').textContent = titleInput.value.trim();
        document.getElementById('heading-subtitle').textContent = subtitleInput.value.trim();
        closeHeadingForm();
      }catch(error){
        loadState.textContent = 'Überschrift konnte nicht gespeichert werden: ' + error.message;
      }
    });
  }

  refresh();
  window.setInterval(function(){ if(editPanel.classList.contains('hidden')) refresh(); }, 30000);
})();
</script>
</body>
</html>
