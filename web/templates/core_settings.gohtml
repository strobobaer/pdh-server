{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Core-Einstellungen</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Systemweite Einstellungen und Updates</p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

<div class="card" style="margin-bottom:14px">
  <div class="card-title">Verwaltung</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    {{if .CanManageUsers}}<a href="/users" class="btn" style="font-size:12px"><i class="ti ti-users"></i> Benutzerverwaltung</a>{{end}}
    <a href="/admin/roles" class="btn" style="font-size:12px"><i class="ti ti-shield-lock"></i> Rollen & Rechte</a>
    <a href="/admin/orgchart" class="btn" style="font-size:12px"><i class="ti ti-sitemap"></i> Organigramm</a>
    <a href="/directory" class="btn" style="font-size:12px"><i class="ti ti-building-warehouse"></i> Hersteller & Lieferanten</a>
    <a href="/core/fieldsets" class="btn" style="font-size:12px"><i class="ti ti-forms"></i> Feldsätze & Stammdatenfelder</a>
    <a href="/core/settings/microsoft" class="btn" style="font-size:12px"><i class="ti ti-brand-windows"></i> Microsoft-365-Organisationssync</a>
    <a href="/core/settings/drives" class="btn" style="font-size:12px"><i class="ti ti-server-2"></i> Netzlaufwerke</a>
  </div>
</div>

<div class="grid2" style="grid-template-columns:1fr 1fr;gap:14px">
  <div class="card">
    <div class="card-title">GitHub-Updates</div>
    <p style="font-size:13px;color:var(--muted);margin:0 0 12px">Repository: strobobaer/pdh-server · Branch: main</p>
    <dl style="display:grid;grid-template-columns:max-content 1fr;gap:8px 12px;font-size:13px">
      <dt style="color:var(--muted)">Installierte Version</dt><dd style="margin:0"><b>{{.CurrentVersion}}</b> · <a href="/help#versions">Änderungen</a></dd>
      <dt style="color:var(--muted)">Version auf GitHub</dt><dd style="margin:0">{{if .LatestVersion}}{{.LatestVersion}}{{else}}{{if .LatestCommit}}nicht angegeben{{else}}Noch nicht geprüft{{end}}{{end}}</dd>
      <dt style="color:var(--muted)">Installierter Commit</dt><dd style="margin:0">{{if .CurrentCommit}}{{.CurrentCommit}}{{else}}unbekannt{{end}}</dd>
      <dt style="color:var(--muted)">GitHub-Commit</dt><dd style="margin:0">{{if .LatestCommit}}{{.LatestCommit}}{{else}}Noch nicht geprüft{{end}}</dd>
      <dt style="color:var(--muted)">Letzte Prüfung</dt><dd style="margin:0">{{if .LastChecked}}{{.LastChecked}}{{else}}Noch nicht geprüft{{end}}</dd>
    </dl>
    {{if eq .CurrentCommit "unknown"}}<p role="status" style="color:var(--muted);font-size:12px">Build-Commit unbekannt; Update-Verfügbarkeit ist nicht vergleichbar.</p>{{else if .UpdateAvailable}}<p role="status" style="color:var(--amber);font-size:13px;font-weight:600">Ein Update ist verfügbar.</p>{{else if eq .ComparisonStatus "diverged"}}<p role="alert" style="color:var(--red);font-size:13px">Lokaler Stand ist abweichend; Fast-Forward ist nicht möglich.</p>{{else if eq .ComparisonStatus "behind"}}<p role="status" style="color:var(--muted);font-size:13px">Der installierte Stand liegt vor GitHub main.</p>{{else if eq .ComparisonStatus "identical"}}<p role="status" style="color:var(--green);font-size:13px">PDH ist aktuell.</p>{{else if .LatestCommit}}<p role="status" style="color:var(--muted);font-size:13px">Vergleich nicht verfügbar.</p>{{end}}
    {{if .NewReleases}}
    <div class="upd-releases" style="margin:10px 0;padding:10px 12px;border:1px solid var(--border);border-radius:8px;max-height:260px;overflow:auto;font-size:13px">
      <div style="font-weight:600;margin-bottom:6px"><i class="ti ti-sparkles"></i> Neu in {{len .NewReleases}} Version(en) seit {{.CurrentVersion}}</div>
      {{range .NewReleases}}<div style="margin-top:8px"><b>Version {{.Version}}</b>{{if .Date}} <span style="color:var(--muted)">· {{.Date}}</span>{{end}}
        {{range .Sections}}<div style="margin-top:4px;color:var(--muted);font-size:12px">{{.Title}}</div><ul style="margin:2px 0 0 18px;padding:0">{{range .Items}}<li>{{.}}</li>{{end}}</ul>{{end}}</div>{{end}}
    </div>
    {{end}}
    {{if .LastCheckError}}<p role="alert" style="color:var(--red);font-size:12px">{{.LastCheckError}}</p>{{end}}
    {{if and .CurrentCommit (ne .CurrentCommit "unknown")}}<p style="font-size:13px"><a href="https://github.com/strobobaer/pdh-server/compare/{{.CurrentCommit}}...main" target="_blank" rel="noopener">Vollständigen Commit-Vergleich auf GitHub öffnen</a></p>{{end}}
    {{if .AgentStatus}}<p role="status" style="font-size:12px">{{.AgentStatus}}</p>{{end}}
    {{if .AgentOutput}}<pre style="max-height:180px;overflow:auto;white-space:pre-wrap;font-size:11px;color:var(--muted)">{{.AgentOutput}}</pre>{{end}}
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
      <form method="POST" action="/core/settings/check-update">
        {{template "icon-button" (dict "Action" "refresh" "ShowLabel" true "Type" "submit" "Label" "Commit-Vergleich")}}
      </form>
      <form method="POST" action="/core/settings/install-update" onsubmit="return confirm('Update vom GitHub-Branch main herunterladen und installieren? Der Dienst wird dabei neu gestartet.')">
        <button class="btn btn-primary" type="submit" {{if or (not .AgentConfigured) (not .AgentReachable) (not .UpdateAvailable)}}disabled title="Update-Agent nicht bereit oder kein Update verfügbar"{{end}}><i class="ti ti-download"></i> Update installieren</button>
      </form>
    </div>
    {{if not .AgentConfigured}}<p style="font-size:12px;color:var(--muted);margin-bottom:0">Der Update-Agent ist nicht erreichbar oder nicht konfiguriert. Installationsskript und Agent-Konfiguration prüfen.</p>{{end}}
  </div>

  <div class="card">
    <div class="card-title">Standard-Fälligkeiten</div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 12px">Greift, wenn beim Anlegen kein eigener Termin angegeben wird - Anzahl Tage nach Erstellung.</p>
    <form method="POST" action="/core/settings/due-dates">
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label" for="due_days_fault">Störungen</label><input id="due_days_fault" type="number" min="1" max="365" name="due_days_fault" class="form-input" value="{{.DefaultDueDaysFault}}" required></div>
        <div class="form-group"><label class="form-label" for="due_days_ticket">Tickets</label><input id="due_days_ticket" type="number" min="1" max="365" name="due_days_ticket" class="form-input" value="{{.DefaultDueDaysTicket}}" required></div>
        <div class="form-group"><label class="form-label" for="due_days_task">Aufgaben</label><input id="due_days_task" type="number" min="1" max="365" name="due_days_task" class="form-input" value="{{.DefaultDueDaysTask}}" required></div>
        <div class="form-group"><label class="form-label" for="due_days_maintenance">Wartungen</label><input id="due_days_maintenance" type="number" min="1" max="365" name="due_days_maintenance" class="form-input" value="{{.DefaultDueDaysMaintenance}}" required></div>
      </div>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>

  <div class="card">
    <div class="card-title">Easy-Mode: Melden per QR-Code ohne Anmeldung</div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 12px">Wer den QR-Code einer Anlage scannt und nicht angemeldet ist, kommt auf eine einfache Meldeseite in der Sprache seines Handys: die letzten 5 Meldungen der Anlage und „Störung +“ / „Ticket +“. Die Meldung wird automatisch ins Deutsche übersetzt (Copilot). Ausgeschaltet führen QR-Codes zur Anmeldung.</p>
    <form method="POST" action="/core/settings/easy-mode">
      <label style="display:flex;gap:8px;align-items:center;font-size:13px;margin-bottom:10px"><input type="checkbox" name="enabled" {{if .EasyMode}}checked{{end}} style="width:18px;height:18px"> Meldungen ohne Anmeldung per QR-Code erlauben</label>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>

  <div class="card" id="push">
    <div class="card-title">Push-Benachrichtigungen aufs Handy</div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 12px">Bei jeder neuen Störung bzw. jedem neuen Ticket bekommen die Mitglieder der gewählten Benutzergruppen eine Nachricht aufs Handy – mit Inhalt und <b>Annehmen</b>. Wer zuerst annimmt, wird zuständig; bei allen anderen verschwindet die Nachricht. Ist <b>Anlage steht</b> angehakt, wiederholt sich der Alarm, bis jemand annimmt, und erscheint in der PDH-App bildschirmfüllend. Jede Person schaltet Push unter <b>Mein Konto</b> auf ihrem Handy ein.</p>
    {{with .Push}}
    {{if not .HTTPS}}<p style="font-size:12px;color:var(--amber);margin:0 0 12px"><i class="ti ti-alert-triangle"></i> Push funktioniert nur über <b>https://</b>. Unter Server-Einstellungen ist keine https-Adresse eingetragen – z. B. über den Cloudflare-Tunnel erreichbar machen.</p>{{end}}
    <form method="POST" action="/core/settings/push">
      <label style="display:flex;gap:8px;align-items:center;font-size:13px;margin-bottom:12px"><input type="checkbox" name="enabled" {{if .Enabled}}checked{{end}} style="width:18px;height:18px"> Push-Benachrichtigungen einschalten</label>
      {{if .Groups}}
      <div style="overflow:auto;margin-bottom:12px"><table style="font-size:12.5px">
        <thead><tr><th>Benutzergruppe</th><th style="text-align:center">Störungen</th><th style="text-align:center">Tickets</th></tr></thead>
        <tbody>{{range .Groups}}<tr><td>{{.Name}} <span style="color:var(--muted)">({{.Members}})</span></td>
          <td style="text-align:center"><input type="checkbox" name="groups_fault" value="{{.ID}}" {{if .ForFault}}checked{{end}} aria-label="{{.Name}} bei Störungen"></td>
          <td style="text-align:center"><input type="checkbox" name="groups_ticket" value="{{.ID}}" {{if .ForTicket}}checked{{end}} aria-label="{{.Name}} bei Tickets"></td></tr>{{end}}</tbody>
      </table></div>
      {{else}}<p style="font-size:12px;color:var(--amber);margin:0 0 12px">Noch keine Benutzergruppen – unter Abteilungen &amp; Gruppen anlegen.</p>{{end}}
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label" for="push_repeat">„Anlage steht“: wiederholen alle … Sekunden</label><input id="push_repeat" type="number" min="30" max="600" name="repeat_seconds" class="form-input" value="{{.RepeatSeconds}}"></div>
        <div class="form-group"><label class="form-label" for="push_max">… höchstens … Minuten lang</label><input id="push_max" type="number" min="5" max="720" name="max_minutes" class="form-input" value="{{.MaxMinutes}}"></div>
      </div>
      <p style="font-size:11.5px;color:var(--muted);margin:0 0 10px">Eingeschaltete Geräte: {{.Devices}}. Benachrichtigt werden nur Vorgänge, die nach dem Einschalten angelegt werden; der Ersteller selbst bekommt keine Nachricht.</p>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
    {{end}}
  </div>

  <div class="card">
    <div class="card-title">Leitstand: Wer führt aus?</div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 12px">Beim Annehmen, Verwerfen und Fertigmelden am Leitstand wählt man aus der Liste der Mitarbeitenden aus Instandhaltung und IT, wer die Aktion ausführt – ohne Nachweis. Eingeschaltet gibt es die Liste nur an angemeldeten Terminals (Systembenutzer); an allen anderen Geräten, z. B. über den Cloudflare-Tunnel, muss dann wie früher die RFID-Karte gescannt werden.</p>
    <form method="POST" action="/core/settings/board-pick">
      <label style="display:flex;gap:8px;align-items:center;font-size:13px;margin-bottom:10px"><input type="checkbox" name="terminal_only" {{if .BoardPickTerminalOnly}}checked{{end}} style="width:18px;height:18px"> Personenauswahl nur am Terminal, sonst RFID-Karte</label>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>

  <div class="card">
    <div class="card-title">Abschluss-Assistent: Wer war dabei?</div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 12px">Beim Abschließen von Tickets, Störungen, Aufgaben und Wartungen fragt das PDH, wer mitgearbeitet hat. Vorgeschlagen werden Mitarbeitende dieser Abteilungen (Teilwort genügt, z. B. „Elektro“ passt auf „Elektrowerkstatt“); alle anderen lassen sich im Assistenten zuschalten.</p>
    <form method="POST" action="/core/settings/completion">
      <div class="form-group"><label class="form-label" for="completion_departments">Abteilungen (durch Komma getrennt)</label>
        <input id="completion_departments" name="departments" class="form-input" value="{{.CompletionDepartments}}" placeholder="Instandhaltung, Elektro, Mechanik">
        {{if .DepartmentOptions}}<div style="font-size:11px;color:var(--muted);margin-top:6px">Vorhandene Abteilungen: {{range $i, $d := .DepartmentOptions}}{{if $i}}, {{end}}<a href="#" style="color:var(--accent)" onclick="const f=document.getElementById('completion_departments');f.value=(f.value.trim()?f.value.trim().replace(/,\s*$/,'')+', ':'')+this.textContent;return false;">{{$d}}</a>{{end}}</div>{{end}}
      </div>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>

  <div class="card">
    <div class="card-title">Automatische Update-Prüfung</div>
    <form method="POST" action="/core/settings">
      <div class="form-group" style="margin-bottom:12px">
        <label class="form-label" style="display:flex;align-items:center;gap:8px">
          <input type="checkbox" name="auto_check_enabled" {{if .AutoCheckEnabled}}checked{{end}}>
          Regelmäßig nach Updates suchen
        </label>
      </div>
      <div class="form-group" style="max-width:220px">
        <label class="form-label" for="check_interval_hours">Prüfintervall (Stunden)</label>
        <input id="check_interval_hours" type="number" min="1" max="168" name="check_interval_hours" class="form-input" value="{{.CheckInterval}}" required>
      </div>
      <p style="font-size:12px;color:var(--muted)">Die Prüfung installiert nichts automatisch. Updates werden nur nach einem Admin-Klick eingespielt.</p>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>
</div>
{{end}}