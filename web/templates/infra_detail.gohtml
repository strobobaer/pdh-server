{{template "base" .}}
{{define "content"}}
<style>
.ih-comment-form{margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.ih-comment-row,.ih-filter-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px}
.ih-comment-row select{flex:1;min-width:180px;width:auto}
.ih-check{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);cursor:pointer;user-select:none}
.ih-mod{padding:5px 9px;border:1px solid var(--border);border-radius:999px;background:var(--bg3)}
.ih-mod:has(input:checked){color:var(--text);border-color:var(--accent)}
.ih-date{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
.ih-date input{width:auto}
.ih-filter{margin-bottom:12px}
.ih-chips{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 12px}
.ih-chip{font-size:11px;color:var(--muted);padding:3px 8px;border-radius:999px;background:var(--bg3);opacity:.55}
.ih-chip.on{opacity:1}
.ih-chip b{color:var(--text);margin-left:2px}
.ih-section{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:10px 0 6px}
.ih-pinned{margin-bottom:12px}
.ih-entry{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:12px}
.ih-entry:last-child{border-bottom:0}
.ih-icon{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:13px}
.ih-body{flex:1;min-width:0}
.ih-head{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.ih-title{font-weight:500;color:var(--text);text-decoration:none;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
.ih-title:hover{color:var(--accent)}
.ih-text{margin-top:4px;white-space:pre-wrap;word-break:break-word;color:var(--text);opacity:.85;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.ih-comment .ih-text{-webkit-line-clamp:unset;display:block}
.ih-comment.pinned{background:rgba(var(--accent-rgb),.06);border-radius:8px;padding:9px 8px}
.ih-actions{display:flex;gap:2px;flex-shrink:0;align-items:flex-start}
.ih-act{width:30px;height:30px;border:0;background:none;color:var(--muted);border-radius:6px;cursor:pointer}
.ih-act:hover{background:var(--bg3);color:var(--text)}
.ih-parts th,.ih-parts td{padding:6px 8px;font-size:12px}
</style>
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  {{template "icon-button" (dict "Action" "back" "Href" "/infrastructure")}}
  {{if .Parent}}{{template "icon-button" (dict "Action" "back" "Href" (printf "/infrastructure/%s" .Parent.ID) "ShowLabel" true "Label" (printf "%s %s" .Parent.TypeIcon .Parent.Name))}}
  <span style="color:var(--muted)">/</span>{{end}}
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Node.TypeIcon}} {{.Node.Name}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">{{.Node.TypeLabel}}{{if .Node.Location}} · {{.Node.Location}}{{end}}</p>
  </div>
  <div style="position:relative" oncontextmenu="toggleMenu('infra-menu'); return false;">
    {{template "icon-button" (dict "Action" "more" "OnClick" "toggleMenu('infra-menu')")}}
    <div id="infra-menu" class="win11-menu" style="display:none;position:absolute;right:0;top:36px;min-width:160px;z-index:100">
      {{if $.CanEditInfra}}{{template "icon-button" (dict "Action" "new" "ShowLabel" true "Label" "Unteranlage hinzufügen" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start;margin-bottom:4px" "OnClick" "document.getElementById('add-child').style.display='block';closeMenu('infra-menu')")}}{{end}}
      {{template "icon-button" (dict "Action" "delete" "ShowLabel" true "Label" "Zum Löschen vormerken" "Class" "btn-small" "Style" "width:100%;justify-content:flex-start" "HxPost" (printf "/records/state/infrastructure/%s" .Node.ID) "HxVals" "{\"action\":\"mark\"}" "HxTarget" (printf "#rmeta-%s" .Node.ID) "HxConfirm" "Element zum Löschen vormerken? Es wird sofort deaktiviert; der Bereinigungslauf löscht es oder blendet es aus, falls es noch verwendet wird." "OnClick" "closeMenu('infra-menu')")}}
    </div>
  </div>
</div>

{{template "record-meta-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  <a class="rec-tab" data-tab="events" href="?tab=events"><i class="ti ti-timeline"></i> Anlagen-Historie</a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="docs" href="?tab=docs"><i class="ti ti-paperclip"></i> Dokumente</a>
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Änderungen</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">
<!-- Kind hinzufügen -->
<div id="add-child" style="display:none" class="card">
  <div class="card-title">Unteranlage hinzufügen</div>
  <form hx-post="/infrastructure" hx-target="#children-list" hx-swap="afterbegin">
    <input type="hidden" name="parent_id" value="{{.Node.ID}}">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Typ</label>
        <select name="type" class="form-input">
          <option value="line">🔄 Linie</option>
          <option value="plant">⚙️ Anlage</option>
          <option value="device">🔌 Gerät</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input"></div>
      {{template "directory-picker" (dict "Label" "Hersteller" "TargetID" "infra-child-manufacturer-id")}}
      {{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "infra-child-cost-center-id")}}
    </div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Unteranlage hinzufügen"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('add-child').style.display='none'")
        (dict "Action" "new" "ShowLabel" true "Type" "submit" "Label" "Hinzufügen")
      )
    )}}
  </form>
</div>

<div class="grid2" style="grid-template-columns:1fr 320px;gap:14px;align-items:start">
  <div>
    <!-- Untergeordnete Elemente -->
    <div class="card">
      <div class="card-title">
        <span>Untergeordnete Anlagen</span>
        {{if $.CanEditInfra}}{{template "icon-button" (dict "Action" "new" "ShowLabel" true "Label" "Hinzufügen" "Class" "btn-small" "OnClick" "document.getElementById('add-child').style.display='block'")}}{{end}}
      </div>
      <div id="children-list">
        {{range .Children}}
        <div class="li" data-href="/infrastructure/{{.ID}}" style="cursor:pointer">
          <div style="width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;background:{{.TypeBg}};flex-shrink:0">{{.TypeIcon}}</div>
          <div class="li-text">
            <div class="li-title">{{.Name}}</div>
            <div class="li-sub">{{.TypeLabel}}{{if .Location}} · {{.Location}}{{end}}{{if .ManufacturerName}} · {{.ManufacturerName}}{{else if .Manufacturer}} · {{.Manufacturer}}{{end}}{{if .CostCenterName}} · {{.CostCenterNumber}} - {{.CostCenterName}}{{end}}</div>
          </div>
          <i class="ti ti-chevron-right" style="color:var(--muted);font-size:14px"></i>
        </div>
        {{else}}
        <div style="text-align:center;padding:20px;color:var(--muted);font-size:12px">Keine untergeordneten Elemente</div>
        {{end}}
      </div>
    </div>

  </div>

  <!-- Bearbeiten -->
    <div class="card" style="margin-top:14px">
      <div class="card-title">
        <span>Bearbeiten</span>
        {{if $.CanEditInfra}}{{template "icon-button" (dict "Action" "edit" "Class" "btn-small" "OnClick" "toggleEdit()")}}{{end}}
      </div>
      <div id="edit-form" style="display:none">
        <form hx-post="/infrastructure/{{.Node.ID}}/edit" hx-target="#edit-result" hx-swap="innerHTML">
          <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" value="{{.Node.Name}}" required></div>
          <div class="form-group"><label class="form-label">Standort</label><input name="location" class="form-input" value="{{.Node.Location}}"></div>
          <div class="form-group"><label class="form-label">Seriennummer</label><input name="serial_no" class="form-input" value="{{.Node.SerialNo}}"></div>
          <div class="form-group"><label class="form-label">Modell</label><input name="model" class="form-input"></div>
          {{template "directory-picker" (dict "Label" "Hersteller" "TargetID" "infra-edit-manufacturer-id" "Value" .Node.ManufacturerID "LegacyValue" .Node.Manufacturer)}}
          {{template "directory-picker" (dict "Label" "Lieferant" "TargetID" "infra-edit-supplier-id" "Name" "supplier_id" "Kind" "supplier" "Value" .SupplierID)}}
          {{template "directory-picker" (dict "Label" "Servicepartner" "TargetID" "infra-edit-service-id" "Name" "service_partner_id" "Kind" "all" "Value" .ServiceID)}}
          {{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "infra-edit-cost-center-id" "Value" .Node.CostCenterID)}}
          <div class="form-group"><label class="form-label">Abteilung</label>
            <select name="department_id" class="form-input"><option value="">– von übergeordneter Anlage erben –</option>{{range .Departments}}<option value="{{.ID}}" {{if eq .ID $.DepartmentID}}selected{{end}}>{{.Name}}</option>{{end}}</select>
            <div style="font-size:11px;color:var(--muted);margin-top:3px">Bestimmt, welche Abteilung die Vorgänge dieser Anlage sieht. Gilt auch für alle Unteranlagen ohne eigene Abteilung.</div></div>
          {{template "icon-button-toolbar" (dict
            "Class" "end"
            "Label" "Infrastruktur bearbeiten"
            "Style" "width:100%;justify-content:flex-end;margin-top:8px"
            "Items" (list
              (dict "Action" "cancel" "ShowLabel" true "OnClick" "toggleEdit()")
              (dict "Action" "save" "ShowLabel" true "Type" "submit")
            )
          )}}
        </form>
        <div id="edit-result"></div>
      </div>
      <div id="edit-info">
        <div class="li"><div class="li-text"><div class="li-sub">Typ</div><div class="li-title">{{.Node.TypeIcon}} {{.Node.TypeLabel}}</div></div></div>
        {{if .Node.Location}}<div class="li"><div class="li-text"><div class="li-sub">Standort</div><div class="li-title">{{.Node.Location}}</div></div></div>{{end}}
        {{if and .Node.Manufacturer (not .Node.ManufacturerName)}}<div class="li"><div class="li-text"><div class="li-sub">Hersteller</div><div class="li-title">{{.Node.Manufacturer}}</div></div></div>{{end}}
        {{range .PartnerLinks}}<div class="li"><div class="li-text"><div class="li-sub">{{.RoleLabel}}</div><div class="li-title"><a href="/directory/{{.ID}}" data-frame data-frame-title="{{.Name}}" style="color:var(--accent)"><i class="ti ti-building-factory-2"></i> {{.Name}}</a></div></div></div>{{end}}
        {{if .Node.SerialNo}}<div class="li"><div class="li-text"><div class="li-sub">Seriennummer</div><div class="li-title" style="font-family:monospace">{{.Node.SerialNo}}</div></div></div>{{end}}
        {{if .EffectiveDept}}<div class="li"><div class="li-text"><div class="li-sub">Abteilung</div><div class="li-title">{{.EffectiveDept}}{{if .DeptInherited}} <span style="font-size:11px;color:var(--muted);font-weight:400">(geerbt)</span>{{end}}</div></div></div>{{end}}
        {{if .Node.CostCenterName}}<div class="li"><div class="li-text"><div class="li-sub">Kostenstelle</div><div class="li-title">{{.Node.CostCenterNumber}} - {{.Node.CostCenterName}}</div></div></div>{{end}}
        {{if .Parent}}<div class="li"><div class="li-text"><div class="li-sub">Übergeordnet</div><div class="li-title"><a href="/infrastructure/{{.Parent.ID}}" style="color:var(--accent)">{{.Parent.Name}}</a></div></div></div>{{end}}
      </div>
    </div>
</div>
</div>

<!-- ── Anlagen-Historie (Vorgänge, Kommentare, Ersatzteile) ── -->
<div class="rec-pane" data-pane="events">
    <!-- Historie -->
    <div class="card" id="infra-history">
      <div class="card-title"><span><i class="ti ti-history"></i> Anlagen-Historie</span></div>

      <!-- Kommentar erfassen -->
      <form id="infra-comment-form" class="ih-comment-form"
            hx-post="/infrastructure/{{.Node.ID}}/comments" hx-target="#infra-comment-result" hx-swap="innerHTML"
            hx-on::after-request="if(event.detail.successful && !event.detail.xhr.getResponseHeader('HX-Retarget')) this.reset()">
        <textarea name="text" class="form-input" rows="2" placeholder="Kommentar, Hinweis oder Beobachtung zur Anlage …" required></textarea>
        <div class="ih-comment-row">
          <select name="ref" class="form-input" title="Optional: Bezug zu einem Vorgang">
            <option value="">Ohne Bezug (allgemein zur Anlage)</option>
            {{range .CommentRefs}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
          </select>
          <label class="ih-check"><input type="checkbox" name="pinned"> <i class="ti ti-pin"></i> Anheften</label>
          <button type="submit" class="btn btn-small btn-primary"><i class="ti ti-send"></i> Kommentieren</button>
        </div>
        <div id="infra-comment-result"></div>
      </form>

      <!-- Filter & Suche -->
      <form id="infra-history-filter" class="ih-filter"
            hx-get="/infrastructure/{{.Node.ID}}/history" hx-target="#infra-history-results" hx-swap="innerHTML"
            hx-trigger="load, input delay:350ms, submit, infra-history-refresh from:body"
            hx-indicator="#infra-history-loading">
        <input type="hidden" name="filtered" value="1">
        <div class="ih-filter-row">
          <div class="search-box" style="flex:1;min-width:200px">
            <i class="ti ti-search" style="color:var(--muted)"></i>
            <input type="search" name="q" placeholder="Suche in Titel, Text, Maßnahmen, Ersatzteilen, Personen …" style="flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)">
          </div>
          <label class="ih-date">Von <input type="date" name="from" class="form-input"></label>
          <label class="ih-date">Bis <input type="date" name="to" class="form-input"></label>
          <select name="state" class="form-input" style="width:auto" title="Status der Vorgänge">
            <option value="">Alle Status</option>
            <option value="open">Offen</option>
            <option value="closed">Abgeschlossen</option>
          </select>
        </div>
        <div class="ih-filter-row">
          {{range .HistoryModules}}
          <label class="ih-check ih-mod"><input type="checkbox" name="module" value="{{.Key}}" checked> <i class="ti {{.Icon}}"></i> {{.Label}}</label>
          {{end}}
        </div>
        <div class="ih-filter-row" style="justify-content:space-between">
          <label class="ih-check"><input type="checkbox" name="children" value="1" checked> <i class="ti ti-subtask"></i> Unteranlagen einbeziehen</label>
          <div style="display:flex;gap:6px;align-items:center">
            <span id="infra-history-loading" class="htmx-indicator" style="font-size:11px;color:var(--muted)"><i class="ti ti-loader-2"></i> lädt …</span>
            <button type="button" class="btn btn-small" onclick="infraHistoryPreset(30)">30 Tage</button>
            <button type="button" class="btn btn-small" onclick="infraHistoryPreset(365)">12 Monate</button>
            <button type="button" class="btn btn-small" onclick="infraHistoryReset()"><i class="ti ti-filter-off"></i> Zurücksetzen</button>
          </div>
        </div>
      </form>

      <div id="infra-history-results">
        <div style="font-size:12px;color:var(--muted);padding:14px 0;text-align:center">Historie wird geladen …</div>
      </div>
    </div>

</div>

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>
</div>

<!-- ── Dokumente ── -->
<div class="rec-pane" data-pane="docs">
    <!-- Anhänge -->
    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos & Dokumente</div>
      <div id="attachments-{{.Node.ID}}" data-attach-ref="infrastructure:{{.Node.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-photo"></i>Galerie<input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')">
        </label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-camera"></i>Kamera<input type="file" accept="image/*" capture="environment" style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')">
        </label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
          <i class="ti ti-file-upload"></i>Dokument<input type="file" accept=".pdf,.doc,.docx" multiple style="display:none" onchange="uploadFiles(this,'infrastructure','{{.Node.ID}}')">
        </label>
      </div>
    </div>
</div>

<!-- ── Verknüpfungen ── -->
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>

<!-- ── Änderungen ── -->
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "infrastructure" "ID" .Node.ID)}}</div>
{{end}}

{{define "context-list"}}
{{range .Children}}
<div class="act-item" onclick="window.location='/infrastructure/{{.ID}}'" style="cursor:pointer">
  <div style="font-size:12px">{{.TypeIcon}}</div>
  <div class="act-text">{{.Name}}</div>
  <i class="ti ti-chevron-right" style="font-size:12px;color:var(--muted)"></i>
</div>
{{end}}
{{end}}

{{block "scripts" .}}
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){document.getElementById(id).style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id$="-menu"]'))document.querySelectorAll('[id$="-menu"]').forEach(m=>m.style.display='none');});
document.querySelectorAll('[data-href]').forEach(el=>el.addEventListener('click',()=>window.location=el.dataset.href));
function toggleEdit() {
  const form = document.getElementById('edit-form');
  const info = document.getElementById('edit-info');
  const show = form.style.display === 'none';
  form.style.display = show ? 'block' : 'none';
  info.style.display = show ? 'none' : 'block';
}
// Anlagen-Historie: Kommentar inline bearbeiten und Filter-Schnellwahl
function infraCommentEdit(btn, show) {
  const entry = btn.closest('.ih-comment');
  entry.querySelector('.ih-comment-edit').style.display = show ? 'block' : 'none';
  entry.querySelector('.ih-comment-text').style.display = show ? 'none' : 'block';
  if (show) entry.querySelector('.ih-comment-edit textarea').focus();
}
function infraHistoryPreset(days) {
  const f = document.getElementById('infra-history-filter');
  const from = new Date(Date.now() - days * 86400000);
  f.elements['from'].value = from.toISOString().slice(0, 10);
  f.elements['to'].value = '';
  htmx.trigger(f, 'submit');
}
function infraHistoryReset() {
  const f = document.getElementById('infra-history-filter');
  f.reset();
  htmx.trigger(f, 'submit');
}
</script>
{{end}}
