{{/*
  Kommentare an Ticket und KVP-Vorschlag (Plan 2026-11-19-sortierung):
  Karte „Kommentare“ mit Sortier-Leiste, zusammengefassten Gruppen
  (häufigste / gleiches zusammen) und Eingabezeile.
  Daten: commentsPage aus RecordCommentsWeb (record_comments.go); geladen über
    {{template "record-comments-slot" (dict "Module" "ticket" "ID" .Ticket.ID)}}
  Das Aussehen der Gruppen ist dasselbe wie bei der Datensatzhistorie (.rh-group).
*/}}
{{define "record-comments-slot"}}
<div hx-get="/records/comments/{{.Module}}/{{.ID}}" hx-trigger="intersect once" hx-swap="innerHTML" data-quiet-denied="{{t "Keine Berechtigung für die Kommentare"}}">
  <div style="font-size:12px;color:var(--muted);padding:8px 0">{{t "Kommentare werden geladen…"}}</div>
</div>
{{end}}

{{define "record-comment-row"}}
  <div class="rc-row" style="display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)">
    <div style="width:30px;height:30px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0;color:#fff">{{.Initial}}</div>
    <div style="flex:1;min-width:0">
      <div style="font-size:12px;font-weight:500">{{.Person}} <span style="color:var(--muted);font-weight:400">&middot; {{.When}}</span></div>
      <div class="rc-text" style="font-size:13px;margin-top:4px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere">{{.Text}}</div>
    </div>
  </div>
{{end}}

{{define "record-comments"}}
<div class="card" id="rec-comments">
  <div class="card-title">{{t "Kommentare"}}</div>
  {{template "sort-bar" .Bar}}
  <div>
  {{range .Entries}}
    {{if gt .Count 1}}
    <details class="rh-group">
      <summary class="rc-row" style="padding:10px 0 10px 18px;border-bottom:1px solid var(--border)">
        <div class="rc-text" style="font-size:13px;font-weight:500;overflow-wrap:anywhere">{{.Count}}× {{.Label}}</div>
        <div style="font-size:12px;color:var(--muted)">{{t "zuletzt"}} {{.Last}}</div>
      </summary>
      {{range .Rows}}{{template "record-comment-row" .}}{{end}}
    </details>
    {{else}}
    {{template "record-comment-row" .Row}}
    {{end}}
  {{else}}
  <div style="color:var(--muted);font-size:12px;padding:8px 0">{{t "Noch keine Kommentare"}}</div>
  {{end}}
  </div>
  {{if .Error}}<div role="alert" style="color:var(--red);font-size:13px;margin-top:10px">{{.Error}}</div>{{end}}
  <form hx-post="{{.PostURL}}" hx-target="#rec-comments" hx-swap="outerHTML" style="margin-top:12px;display:flex;gap:8px">
    <input data-suggest="comment" name="text" class="form-input" value="{{.Draft}}" placeholder="{{t "Kommentar hinzufügen…"}}" aria-label="{{t "Kommentar hinzufügen…"}}" style="flex:1;font-size:12px" required autocomplete="off"{{if .Focus}} autofocus{{end}}>
    <button class="btn" type="submit" aria-label="{{t "Senden"}}"><i class="ti ti-send"></i></button>
  </form>
</div>
{{end}}
