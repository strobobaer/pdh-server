diff --git a/web/templates/integrations.gohtml b/web/templates/integrations.gohtml
new file mode 100644
index 0000000..f303474
--- /dev/null
+++ b/web/templates/integrations.gohtml
@@ -0,0 +1,102 @@
+{{template "base" .}}
+{{define "content"}}
+<div style="margin-bottom:18px">
+  <h1 style="font-size:19px;font-weight:600">Schnittstellen</h1>
+  <p style="font-size:12px;color:var(--muted);margin-top:3px">API-Zugänge und Webhooks für externe Systeme wie n8n</p>
+</div>
+
+{{if .NewKeyRaw}}
+<div class="card" style="border-color:var(--amber,#f59e0b);background:rgba(245,158,11,.08);margin-bottom:14px">
+  <div style="font-size:13px;font-weight:600;margin-bottom:6px"><i class="ti ti-alert-triangle"></i> Neuer API-Schlüssel "{{.NewKeyName}}" — jetzt kopieren, wird nicht noch einmal angezeigt</div>
+  <code id="new-key-value" style="display:block;background:var(--bg3);padding:10px 12px;border-radius:8px;font-size:12.5px;word-break:break-all;margin-bottom:8px">{{.NewKeyRaw}}</code>
+  <button type="button" class="btn btn-small" onclick="navigator.clipboard.writeText(document.getElementById('new-key-value').textContent); this.textContent='Kopiert ✓'"><i class="ti ti-copy"></i> In Zwischenablage kopieren</button>
+</div>
+<script>history.replaceState({}, '', location.pathname);</script>
+{{end}}
+
+<div class="grid2" style="grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
+  <!-- API-Schlüssel -->
+  <div class="card">
+    <div class="card-title">API-Schlüssel (eingehend, n8n → PDH)</div>
+    <p style="font-size:11px;color:var(--muted);margin-bottom:10px">Header <code>X-API-Key</code> bei Aufrufen von <code>/api/v1/integration/...</code>.</p>
+    <form method="POST" action="/admin/integrations/keys" style="display:flex;gap:8px;margin-bottom:14px">
+      <input name="name" class="form-input" placeholder="z.B. n8n Produktion" required style="flex:1">
+      <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Erzeugen</button>
+    </form>
+    {{range .APIKeys}}
+    <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-top:1px solid var(--border);font-size:12.5px">
+      <div>
+        <div style="font-weight:500">{{.Name}}</div>
+        <div style="color:var(--muted);font-size:11px">{{.KeyPrefix}}… {{if .LastUsedAt}}· zuletzt genutzt {{.LastUsedAt.Format "02.01.2006 15:04"}}{{else}}· noch nie genutzt{{end}}</div>
+      </div>
+      {{if .Active}}
+      <form method="POST" action="/admin/integrations/keys/{{.ID}}/revoke-web" onsubmit="return confirm('Schlüssel {{.Name}} widerrufen? Aufrufe damit schlagen danach fehl.')">
+        <button type="submit" class="btn-icon" title="Widerrufen"><i class="ti ti-ban"></i></button>
+      </form>
+      {{else}}
+      <span class="badge b-gray">widerrufen</span>
+      {{end}}
+    </div>
+    {{else}}
+    <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Schlüssel erzeugt</div>
+    {{end}}
+  </div>
+
+  <!-- Webhooks -->
+  <div class="card">
+    <div class="card-title">Webhooks (ausgehend, PDH → n8n)</div>
+    <p style="font-size:11px;color:var(--muted);margin-bottom:10px">Payload wird mit dem Secret per HMAC-SHA256 signiert (Header <code>X-PDH-Signature</code>).</p>
+    <form method="POST" action="/admin/integrations/webhooks" style="margin-bottom:14px">
+      <div class="form-group">
+        <label class="form-label">Name</label>
+        <input name="name" class="form-input" placeholder="z.B. n8n Produktions-Webhook" required>
+      </div>
+      <div class="form-group">
+        <label class="form-label">Ziel-URL</label>
+        <input name="target_url" class="form-input" placeholder="http://host.docker.internal:5678/webhook/..." required>
+      </div>
+      <div class="form-group">
+        <label class="form-label">Secret (leer = automatisch erzeugt)</label>
+        <input name="secret" class="form-input" placeholder="wird sonst zufällig erzeugt">
+      </div>
+      <div class="form-group">
+        <label class="form-label">Ereignisse</label>
+        {{range .AllEvents}}
+        <label style="display:flex;align-items:center;gap:6px;font-size:12px;margin-top:4px;cursor:pointer">
+          <input type="checkbox" name="events" value="{{.}}"> {{.}}
+        </label>
+        {{end}}
+      </div>
+      <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Webhook anlegen</button>
+    </form>
+    {{range .Webhooks}}
+    <div style="padding:8px 0;border-top:1px solid var(--border);font-size:12.5px">
+      <div style="display:flex;align-items:center;justify-content:space-between">
+        <div style="font-weight:500">{{.Name}}</div>
+        <form method="POST" action="/admin/integrations/webhooks/{{.ID}}/delete-web" onsubmit="return confirm('Webhook {{.Name}} löschen?')">
+          <button type="submit" class="btn-icon" title="Löschen"><i class="ti ti-trash"></i></button>
+        </form>
+      </div>
+      <div style="color:var(--muted);font-size:11px;word-break:break-all">{{.TargetURL}}</div>
+      <div style="margin-top:4px">
+        {{range .Events}}<span class="badge b-gray" style="margin-right:4px">{{.}}</span>{{end}}
+        {{if eq .LastStatus "ok"}}<span class="badge b-green">zuletzt ok</span>{{else if eq .LastStatus "error"}}<span class="badge b-red" title="{{.LastError}}">zuletzt fehlgeschlagen</span>{{end}}
+      </div>
+    </div>
+    {{else}}
+    <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Webhooks angelegt</div>
+    {{end}}
+  </div>
+</div>
+
+<!-- Kurzreferenz für n8n -->
+<div class="card">
+  <div class="card-title">Kurzreferenz für n8n (HTTP-Request-Knoten)</div>
+  <div style="font-size:12.5px;line-height:1.7">
+    <p><strong>Export (GET):</strong> <code>/api/v1/integration/production</code>, <code>/tasks</code>, <code>/tickets</code>, <code>/faults</code>, <code>/maintenance</code>, <code>/inventory</code> — Query-Parameter <code>from</code>/<code>to</code> (YYYY-MM-DD) und <code>limit</code> wo sinnvoll.</p>
+    <p><strong>Import (POST):</strong> <code>/api/v1/integration/production</code> (einzelnes Objekt oder Array), <code>/api/v1/integration/faults</code> (legt eine neue Störung an).</p>
+    <p><strong>Header bei jedem Aufruf:</strong> <code>X-API-Key: &lt;dein Schlüssel&gt;</code></p>
+    <p>PDH von n8n aus erreichen: <code>http://host.docker.internal:&lt;PDH-Port&gt;</code> (siehe pdh-admin-Stack).</p>
+  </div>
+</div>
+{{end}}
diff --git a/web/templates/production.gohtml b/web/templates/production.gohtml
new file mode 100644
index 0000000..2626c92
--- /dev/null
+++ b/web/templates/production.gohtml
@@ -0,0 +1,77 @@
+{{template "base" .}}
+{{define "content"}}
+<div style="margin-bottom:18px">
+  <h1 style="font-size:19px;font-weight:600">Produktionsdaten</h1>
+  <p style="font-size:12px;color:var(--muted);margin-top:3px">Stückzahlen, Ausschuss und Zykluszeit pro Maschine — manuell erfasst oder per n8n importiert</p>
+</div>
+
+<div class="grid2" style="grid-template-columns:{{if .CanEdit}}320px 1fr{{else}}1fr{{end}};gap:14px">
+  {{if .CanEdit}}
+  <div class="card">
+    <div class="card-title">Neu erfassen</div>
+    <form method="POST" action="/production">
+      <div class="form-group">
+        <label class="form-label">Maschine / Anlage</label>
+        <select name="infrastructure_id" class="form-input">
+          <option value="">— keine Zuordnung —</option>
+          {{range .InfraOptions}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
+        </select>
+      </div>
+      <div class="grid2" style="gap:10px">
+        <div class="form-group">
+          <label class="form-label">Gutteile</label>
+          <input type="number" min="0" name="quantity_good" class="form-input" value="0" required>
+        </div>
+        <div class="form-group">
+          <label class="form-label">Ausschuss</label>
+          <input type="number" min="0" name="quantity_scrap" class="form-input" value="0" required>
+        </div>
+      </div>
+      <div class="form-group">
+        <label class="form-label">Zykluszeit (Sekunden, optional)</label>
+        <input type="number" min="0" step="0.1" name="cycle_time_seconds" class="form-input">
+      </div>
+      <div class="form-group">
+        <label class="form-label">Notizen</label>
+        <textarea name="notes" class="form-input" rows="2"></textarea>
+      </div>
+      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern" "Style" "width:100%;justify-content:center")}}
+    </form>
+  </div>
+  {{end}}
+
+  <div class="card" style="overflow-x:auto">
+    <div class="card-title">Letzte Einträge</div>
+    <table style="border-collapse:collapse;width:100%;font-size:12.5px">
+      <thead>
+        <tr>
+          <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Zeit</th>
+          <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Maschine</th>
+          <th style="text-align:right;padding:6px 10px;border-bottom:1px solid var(--border)">Gut</th>
+          <th style="text-align:right;padding:6px 10px;border-bottom:1px solid var(--border)">Ausschuss</th>
+          <th style="text-align:right;padding:6px 10px;border-bottom:1px solid var(--border)">Zykluszeit</th>
+          <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Quelle</th>
+          <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Notizen</th>
+        </tr>
+      </thead>
+      <tbody>
+        {{range .Records}}
+        <tr>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">{{.RecordedAt.Format "02.01. 15:04"}}</td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{if .InfraName}}{{.InfraName}}{{else}}—{{end}}</td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border);text-align:right">{{.QuantityGood}}</td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border);text-align:right{{if gt .QuantityScrap 0}};color:var(--red){{end}}">{{.QuantityScrap}}</td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border);text-align:right">{{if .CycleTimeSeconds}}{{printf "%.1f" (derefFloat .CycleTimeSeconds)}}s{{else}}—{{end}}</td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border)">
+            {{if eq .Source "manual"}}<span class="badge b-gray">manuell</span>{{else if eq .Source "import"}}<span class="badge b-blue">Import</span>{{else}}<span class="badge b-blue">API</span>{{end}}
+          </td>
+          <td style="padding:6px 10px;border-bottom:1px solid var(--border);color:var(--muted)">{{.Notes}}</td>
+        </tr>
+        {{else}}
+        <tr><td colspan="7" style="padding:16px;text-align:center;color:var(--muted)">Noch keine Produktionsdaten erfasst</td></tr>
+        {{end}}
+      </tbody>
+    </table>
+  </div>
+</div>
+{{end}}
