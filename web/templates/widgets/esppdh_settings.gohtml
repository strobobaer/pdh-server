{{/* ESPPDH (internal/web/esppdh_settings.go): Karte im Reiter „ESPPDH“ der Server-Einstellungen
     – Schalter, Zustand der Python-Umgebung mit ESPHome und Knopf „Umgebung einrichten“.
     Daten: esppdhPanel. Ein Zusatz – ohne ihn läuft alles unverändert. Im Docker-Betrieb nur
     ein Hinweis. Am Spiegelserver kein Schalter, aber „Umgebung einrichten“ (jeder Server
     braucht die Umgebung selbst). Solange die Einrichtung beim Update-Agenten
     läuft, fragt die Karte alle 2 s nach (GET, keine Dauerverbindung). */}}
{{define "esppdh-panel"}}
<div id="esppdh-panel" class="card"{{if .Job.Running}} hx-get="/admin/server-config/esppdh" hx-trigger="every 2s" hx-swap="outerHTML"{{end}}>
  <style>
  .esppdh-row{display:flex;gap:8px 12px;align-items:center;flex-wrap:wrap;margin:0 0 10px;font-size:13px}
  .esppdh-row form{margin:0;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .esppdh-state{border:1px solid var(--border);border-radius:8px;padding:8px 12px;margin:0 0 10px;font-size:13px;background:var(--bg2);color:var(--text)}
  </style>
  <div class="card-title"><span><i class="ti ti-cpu"></i> ESPPDH – ESP-Geräte</span><span class="sc-sub">Zusatz – ohne läuft alles wie bisher</span></div>
  {{if .Msg}}<div class="sc-sub" role="status" style="margin-bottom:8px;color:var(--green)"><i class="ti ti-check"></i> {{.Msg}}</div>{{end}}
  {{if .Err}}<div class="sc-sub" role="alert" style="margin-bottom:8px;color:var(--red);white-space:pre-line"><i class="ti ti-alert-circle"></i> {{.Err}}</div>{{end}}
  <p class="sc-sub" style="margin:0 0 10px">Mit ESPPDH legst du kleine Messgeräte mit ESP32 oder ESP8266 an. Das PDH baut ihre Firmware mit ESPHome. Die Geräte senden ihre Werte an den eingebauten MQTT-Broker.</p>
  {{if .Docker}}
  <p class="sc-sub" style="margin:0 0 10px;color:var(--amber)"><i class="ti ti-info-circle"></i> ESPPDH gibt es im Docker-Betrieb nicht. Im Betrieb mit systemd lässt es sich hier einschalten.</p>
  {{else}}
  {{if .Mirror}}<p class="sc-sub" style="margin:0 0 10px;color:var(--amber)"><i class="ti ti-server-2"></i> Dies ist der Spiegelserver. Die Umgebung braucht jeder Server selbst – im Verbund tauschen die Server bei jedem Update die Rollen. Hier lässt sie sich einrichten; ein- und ausschalten nur am aktiven Server.</p>{{end}}
  <div class="esppdh-row">
    <b>ESPPDH ist {{if .Enabled}}eingeschaltet{{else}}ausgeschaltet{{end}}.</b>
    {{if not .Mirror}}<form hx-post="/admin/server-config/esppdh" hx-target="#esppdh-panel" hx-swap="outerHTML" hx-disabled-elt="find button">
      {{if .Enabled}}<input type="hidden" name="on" value="0"><button class="btn btn-small" type="submit"><i class="ti ti-player-pause"></i> Ausschalten</button>
      {{else}}<input type="hidden" name="on" value="1"><button class="btn btn-primary btn-small" type="submit"><i class="ti ti-player-play"></i> Einschalten</button>{{end}}
    </form>{{end}}
  </div>
  {{if .Job.Running}}
  <div class="esppdh-state" role="status"><i class="ti ti-loader-2"></i> <b>Umgebung wird eingerichtet …</b> Das dauert einige Minuten. Die Karte aktualisiert sich selbst.</div>
  {{else}}
  {{if .Job.Done}}{{if .Job.Error}}<div class="sc-sub" role="alert" style="margin-bottom:8px;color:var(--red);white-space:pre-line"><i class="ti ti-alert-circle"></i> {{.Job.Error}}</div>
  {{else}}<div class="sc-sub" role="status" style="margin-bottom:8px;color:var(--green)"><i class="ti ti-check"></i> Einrichtung abgeschlossen: ESPHome {{.Job.Version}}.</div>{{end}}{{end}}
  <div class="esppdh-state">
    {{if .Env.Installed}}<i class="ti ti-circle-check" style="color:var(--green)"></i> Umgebung eingerichtet: ESPHome {{.Env.Version}}{{if .Env.Outdated}}
    <div style="color:var(--amber);margin-top:4px"><i class="ti ti-clock-up"></i> veraltet – wird mit dem nächsten Update angehoben (festgelegt: ESPHome {{.Pinned}})</div>{{end}}
    {{else if .Env.Problem}}<i class="ti ti-alert-circle" style="color:var(--red)"></i> Umgebung gestört: {{.Env.Problem}}
    {{else}}<i class="ti ti-circle-dashed"></i> Umgebung noch nicht eingerichtet. Ohne sie lässt sich keine Firmware bauen.{{end}}
    {{with .Free}}<div class="sc-sub" style="margin-top:4px"><i class="ti ti-database"></i> Freier Platz: {{.}}</div>{{end}}
  </div>
  <div class="esppdh-row">
    <form hx-post="/admin/server-config/esppdh/install" hx-target="#esppdh-panel" hx-swap="outerHTML" hx-disabled-elt="find button"
      hx-confirm="Umgebung jetzt einrichten? Das lädt ESPHome {{.Pinned}} aus dem Internet und dauert einige Minuten.">
      <button class="btn btn-small" type="submit" {{if not .AgentReady}}disabled{{end}}><i class="ti ti-download"></i> Umgebung einrichten</button>
    </form>
  </div>
  {{if not .AgentReady}}<p class="sc-sub" style="margin:0 0 10px;color:var(--amber)"><i class="ti ti-alert-triangle"></i> Zum Einrichten braucht das PDH den Update-Agenten.</p>{{end}}
  {{end}}
  <p class="sc-sub" style="margin:0 0 6px"><i class="ti ti-world-download"></i> Das Einrichten lädt ESPHome aus dem Internet. Der erste Bau je Platinentyp lädt mehrere hundert MB aus dem Internet.</p>
  <p class="sc-sub" style="margin:0">Mit jedem PDH-Update kommt die passende ESPHome-Version mit, wenn die Umgebung eingerichtet ist.</p>
  {{end}}
  <p class="sc-sub" style="margin:10px 0 0">ESPPDH baut auf ESPHome auf (Lizenz GPLv3 bzw. MIT).</p>
</div>
{{end}}
