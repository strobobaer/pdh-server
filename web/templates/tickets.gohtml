{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Ticketmanagement</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Total}} Tickets · {{.Open}} offen</p>
  </div>
  {{template "icon-button-toolbar" (dict
  "Class" "end"
  "Label" "Ticket-Aktionen"
  "Items" (list
      (dict "Action" "new" "ShowLabel" true "OnClick" "document.getElementById('new-ticket-form').style.display='block'")
      (dict "Action" "view" "ShowLabel" true "Label" "Auswahl öffnen" "OnClick" "runSelectedItemAction('view')")
      (dict "Action" "copy" "ShowLabel" true "Label" "Auswahl kopieren" "OnClick" "runSelectedItemAction('copy')")
      (dict "Action" "done" "ShowLabel" true "Label" "Auswahl erledigen" "OnClick" "runSelectedItemAction('done')")
  )
)}}
</div>

<div id="new-ticket-form" style="display:none" class="card">
  <div class="card-title">Ticket erstellen</div>
  <form onsubmit="return submitTicketForm(this)">
    <div class="grid2">
      <div class="form-group">
        <label class="form-label">Titel</label>
        <input name="title" class="form-input" placeholder="Kurzbeschreibung" required>
      </div>
      <div class="form-group">
        <label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Zugewiesen</label>
        <select name="assigned_to" class="form-input">
          <option value="">Nicht zugewiesen</option>
          {{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Verantwortlich</label>
        <select name="responsible_to" class="form-input">
          <option value="">Nicht gesetzt</option>
          {{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Beschreibung</label>
      <input name="description" class="form-input" placeholder="Details">
    </div>

    {{template "infra-tree-picker" (dict "TargetID" "ticket-infra-id" "SelectedLabelID" "ticket-infra-selected" "Label" "Infrastruktur")}}

    {{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "ticket-cost-center-id")}}

    <div id="ticket-create-result" style="font-size:12px;margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Formularaktionen"
  "Style" "width:100%;justify-content:flex-end"
  "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-ticket-form').style.display='none'")
        (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Erstellen")
  )
)}}
  </form>
</div>

<div class="widget-icon-toolbar compact" style="margin-bottom:14px" aria-label="Ticketfilter">
  {{if eq .Filter ""}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/tickets" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/tickets")}}{{end}}
  {{if eq .Filter "open"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Offen" "Href" "/tickets?status=open" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Offen" "Href" "/tickets?status=open")}}{{end}}
  {{if eq .Filter "in_progress"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Arbeit" "Href" "/tickets?status=in_progress" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Arbeit" "Href" "/tickets?status=in_progress")}}{{end}}
  {{if eq .Filter "archive"}}{{template "icon-button" (dict "Action" "history" "ShowLabel" true "Label" "Archiv" "Href" "/tickets?status=archive" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "history" "ShowLabel" true "Label" "Archiv" "Href" "/tickets?status=archive")}}{{end}}
</div>

<div id="ticket-table" class="card" style="padding:0">
  <table>
    <thead><tr style="cursor:pointer"><th>Ticket</th><th>Priorität</th><th>Status</th><th>Erstellt</th><th>Aktionen</th></tr></thead>
    <tbody>
    {{range .Tickets}}
    <tr class="selectable-item" data-selectable data-title="{{.Title}}" data-view-href="/tickets/{{.ID}}" data-copy-text="{{.Title}} {{.Description}}" data-done-url="/tickets/{{.ID}}/status-web" data-done-method="PUT" data-done-body="status=resolved" style="cursor:pointer">
      <td>
        <a href="/tickets/{{.ID}}" style="display:block;color:inherit;text-decoration:none">
          <div style="font-weight:500">{{.Title}}</div>
          {{if .InfraName}}<div style="font-size:11px;color:var(--accent)">{{.InfraName}}</div>{{end}}
          <div style="font-size:11px;color:var(--muted)">{{.Description}}</div>
        </a>
      </td>
      <td><span class="badge {{.PriorityClass}}">{{.Priority}}</span></td>
      <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td style="font-size:11px;color:var(--muted)">{{.CreatedAgo}}</td>
      <td>
        <select name="status" class="form-input" style="font-size:11px;padding:4px 8px;width:auto"
          hx-put="/tickets/{{.ID}}/status-web"
          hx-trigger="change"
          hx-target="closest tr">
          <option value="open" {{if eq .Status "open"}}selected{{end}}>Offen</option>
          <option value="in_progress" {{if eq .Status "in_progress"}}selected{{end}}>In Arbeit</option>
          <option value="resolved" {{if eq .Status "resolved"}}selected{{end}}>Gelöst</option>
          <option value="closed" {{if eq .Status "closed"}}selected{{end}}>Geschlossen</option>
        </select>
      </td>
    </tr>
    {{else}}
    <tr style="cursor:pointer"><td colspan="5" style="text-align:center;color:var(--muted);padding:24px">Keine Tickets vorhanden</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}
{{define "context-list"}}
{{range .CriticalTickets}}
<div class="act-item">
  <div class="act-dot d-red"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge b-red">Krit</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
async function populateCostCenterSelects(){
  const selects = document.querySelectorAll('[data-cost-center-picker]');
  if(selects.length===0) return;
  try{
    const res = await fetch('/api/v1/costcenters', {credentials:'same-origin'});
    const json = await res.json();
    const items = json.data || [];
    selects.forEach(function(sel){
      const selected = sel.dataset.selected || '';
      items.forEach(function(cc){
        const opt = document.createElement('option');
        opt.value = cc.id;
        opt.textContent = cc.number + ' - ' + cc.name;
        if(cc.id === selected) opt.selected = true;
        sel.appendChild(opt);
      });
    });
  }catch(e){ console.warn('Kostenstellen laden fehlgeschlagen', e); }
}
if(document.readyState !== 'loading') populateCostCenterSelects();
else document.addEventListener('DOMContentLoaded', populateCostCenterSelects);

function watchInfraForCostCenter(hiddenInfraInputId, costCenterSelectId){
  const hidden = document.getElementById(hiddenInfraInputId);
  const ccSelect = document.getElementById(costCenterSelectId);
  if(!hidden || !ccSelect) return;
  let lastVal = hidden.value;
  setInterval(async function(){
    if(hidden.value === lastVal) return;
    lastVal = hidden.value;
    if(!lastVal) return;
    if(ccSelect.value) return; // Nutzer hat bereits manuell etwas gewaehlt - nicht ueberschreiben
    try{
      const res = await fetch('/api/v1/infrastructure/'+lastVal, {credentials:'same-origin'});
      const json = await res.json();
      const infra = json.data;
      if(infra && infra.cost_center_id){
        ccSelect.value = infra.cost_center_id;
      }
    }catch(e){ console.warn('Kostenstelle aus Infrastruktur laden fehlgeschlagen', e); }
  }, 400);
}
watchInfraForCostCenter('ticket-infra-id', 'ticket-cost-center-id');

async function submitTicketForm(form){
  const fd=new FormData(form); const payload={title:fd.get('title'),description:fd.get('description'),priority:fd.get('priority')};
  if(fd.get('infrastructure_id')) payload.infrastructure_id=fd.get('infrastructure_id');
  if(fd.get('cost_center_id')) payload.cost_center_id=fd.get('cost_center_id');
  if(fd.get('assigned_to')) payload.assigned_to=fd.get('assigned_to');
  if(fd.get('responsible_to')) payload.responsible_to=fd.get('responsible_to');
  const result=document.getElementById('ticket-create-result'); result.textContent='Speichere...';
  try{
    const res=await fetch('/api/v1/tickets/',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+pdhToken()},body:JSON.stringify(payload)});
    const json=await res.json(); if(!res.ok||!json.success) throw new Error(json.error||'Fehler');
    window.location.href='/tickets';
  }catch(e){result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>'}
  return false;
}
</script>
{{end}}
