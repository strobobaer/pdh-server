{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Export-Vorlagen</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/export">← zurück zu Export</a></p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if .CanWrite}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title" id="tpl-form-title">Neue Vorlage anlegen</div>
  <form id="tpl-form" method="POST" action="/export/templates">
    <div class="grid2" style="gap:10px">
      <div class="form-group">
        <label class="form-label">Name</label>
        <input id="tpl-name" name="name" class="form-input" maxlength="150" required placeholder="z.B. Monatsbericht">
      </div>
      <div class="form-group">
        <label class="form-label">Typ</label>
        <select id="tpl-kind" name="kind" class="form-input" onchange="tplKindChanged()" required>
          <option value="">– Typ wählen –</option>
          <option value="pdf">PDF</option>
          <option value="excel">Excel</option>
        </select>
      </div>
    </div>

    <div class="kind-fields" id="tpl-fields-pdf" hidden>
      <div class="grid2" style="gap:10px">
        <div class="form-group"><label class="form-label">Titel (Überschrift im Dokument)</label><input name="title" id="tpl-title" class="form-input" maxlength="200" placeholder="z.B. Monatsbericht Werk Augsburg"></div>
        <div class="form-group"><label class="form-label">Ausrichtung</label>
          <select name="orientation" id="tpl-orientation" class="form-input">
            <option value="P">Hochformat</option>
            <option value="L">Querformat</option>
          </select>
        </div>
      </div>
    </div>

    <div class="kind-fields" id="tpl-fields-excel" hidden>
      <div class="form-group"><label class="form-label">Tabellenblattname</label><input name="sheet_name" id="tpl-sheet-name" class="form-input" maxlength="100" placeholder="z.B. Werte"></div>
    </div>

    <div style="display:flex;gap:8px;margin-top:10px">
      <button type="submit" class="btn btn-primary" id="tpl-submit"><i class="ti ti-plus"></i> Vorlage anlegen</button>
      <button type="button" class="btn" id="tpl-cancel" onclick="resetTplForm()" hidden>Abbrechen</button>
    </div>
  </form>
</div>
{{end}}

<div class="card">
  <div class="card-title">Vorhandene Vorlagen · {{len .Templates}}</div>
  {{if .Templates}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Name</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Typ</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Details</th>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)">Angelegt</th>
      </tr>
    </thead>
    <tbody>
      {{range .Templates}}
      <tr data-tpl-id="{{.ID}}" data-tpl-kind="{{.Kind}}" data-tpl-name="{{.Name}}" data-tpl-title="{{.Title}}" data-tpl-sheet-name="{{.SheetName}}" data-tpl-orientation="{{.Orientation}}"
          {{if $.CanWrite}}oncontextmenu="showContextMenu(event, tplContextItems(this)); return false;"{{end}}>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Name}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{if eq .Kind "pdf"}}PDF{{else}}Excel{{end}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">
          {{if eq .Kind "pdf"}}{{if .Title}}{{.Title}}{{end}}{{if eq .Orientation "L"}} · Querformat{{else}} · Hochformat{{end}}
          {{else}}{{if .SheetName}}Blatt „{{.SheetName}}"{{end}}{{end}}
        </td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.CreatedAt}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Vorlagen angelegt</div>
  {{end}}
</div>
{{end}}

{{define "scripts"}}
<script>
function tplKindChanged(){
  document.querySelectorAll('#tpl-form .kind-fields').forEach(function(el){ el.hidden = true; });
  const kind = document.getElementById('tpl-kind').value;
  const target = document.getElementById('tpl-fields-' + kind);
  if(target) target.hidden = false;
}

function resetTplForm(){
  const form = document.getElementById('tpl-form');
  form.reset();
  form.action = '/export/templates';
  document.getElementById('tpl-kind').disabled = false;
  document.getElementById('tpl-form-title').textContent = 'Neue Vorlage anlegen';
  document.getElementById('tpl-submit').innerHTML = '<i class="ti ti-plus"></i> Vorlage anlegen';
  document.getElementById('tpl-cancel').hidden = true;
  tplKindChanged();
}

function editTplFromRow(row){
  const form = document.getElementById('tpl-form');
  form.reset();
  document.getElementById('tpl-kind').value = row.dataset.tplKind;
  document.getElementById('tpl-kind').disabled = true;
  tplKindChanged();
  document.getElementById('tpl-name').value = row.dataset.tplName;
  document.getElementById('tpl-title').value = row.dataset.tplTitle || '';
  document.getElementById('tpl-orientation').value = row.dataset.tplOrientation || 'P';
  document.getElementById('tpl-sheet-name').value = row.dataset.tplSheetName || '';
  form.action = '/export/templates/' + row.dataset.tplId + '/edit-web';
  document.getElementById('tpl-form-title').textContent = 'Vorlage bearbeiten';
  document.getElementById('tpl-submit').innerHTML = '<i class="ti ti-device-floppy"></i> Speichern';
  document.getElementById('tpl-cancel').hidden = false;
  form.scrollIntoView({behavior:'smooth', block:'start'});
}

function deleteTplFromRow(row){
  if(!confirm('Vorlage "' + row.dataset.tplName + '" wirklich löschen?')) return;
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/export/templates/' + row.dataset.tplId + '/delete-web';
  document.body.appendChild(form);
  form.submit();
}

function tplContextItems(row){
  return [
    {heading: row.dataset.tplName},
    {label: 'Bearbeiten', icon: 'ti-edit', onClick: function(){ editTplFromRow(row); }},
    {separator: true},
    {label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){ deleteTplFromRow(row); }}
  ];
}

if(document.getElementById('tpl-form')){
  tplKindChanged();
}
</script>
{{end}}
