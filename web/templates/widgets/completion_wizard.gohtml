{{/*
  Abschluss-Assistent (completion.go). Jeder gruene Haken zum Fertigsetzen
  ruft pdhComplete(typ, id) auf: ticket | fault | task | maintenance.
  Schritte: (Wartung: Checkliste →) Material → Zeit → Wer war dabei? → Kommentar → Fertig / geht weiter.
*/}}
{{/* Gemeinsame Optik der Assistenten (Abschluss, Anlegen) – auch im Leitstand */}}
{{define "wizard-styles"}}
<style>
.cw-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:600;display:none;align-items:center;justify-content:center;padding:16px}
.cw-overlay.open{display:flex}
.cw{background:var(--bg2);border:1px solid var(--border);border-radius:14px;width:min(640px,100%);max-height:calc(100dvh - 32px);display:flex;flex-direction:column;box-shadow:0 24px 70px rgba(0,0,0,.45)}
.cw-head{padding:14px 18px 10px;border-bottom:1px solid var(--border)}
.cw-head h2{font-size:15px;font-weight:600;display:flex;align-items:center;gap:8px}
.cw-head h2 i{color:var(--green)}
.cw-head .sub{font-size:12px;color:var(--muted);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cw-steps{display:flex;gap:4px;margin-top:12px}
.cw-step{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:10.5px;color:var(--muted);min-width:0}
.cw-step b{width:26px;height:26px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;background:var(--bg3)}
.cw-step.on{color:var(--text)}.cw-step.on b{border-color:var(--accent);background:var(--accent);color:var(--on-accent)}
.cw-step.ok b{border-color:var(--green);background:var(--green);color:#fff}
.cw-step span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.cw-body{padding:16px 18px;overflow-y:auto;flex:1;font-size:13px}
.cw-pane{display:none}.cw-pane.on{display:block}
.cw-pane h3{font-size:14px;font-weight:600;margin-bottom:4px;display:flex;gap:8px;align-items:center}
.cw-pane h3 i{color:var(--accent)}
.cw-pane p.hint{font-size:12px;color:var(--muted);margin-bottom:12px}
.cw-list{border:1px solid var(--border);border-radius:10px;margin-bottom:10px}
.cw-row{display:flex;align-items:center;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border)}
.cw-row:last-child{border-bottom:0}
.cw-row .grow{flex:1;min-width:0}
.cw-row small{color:var(--muted);display:block}
.cw-empty{padding:10px;color:var(--muted);font-size:12px}
.cw-add{display:grid;grid-template-columns:1fr 1fr 90px auto;gap:8px;align-items:end;margin-bottom:10px}
.cw-results{border:1px solid var(--border);border-radius:8px;max-height:180px;overflow:auto;margin:-4px 0 10px;display:none}
.cw-results div{padding:7px 10px;cursor:pointer;border-bottom:1px solid var(--border);font-size:12px}
.cw-results div:hover{background:var(--bg3)}
.cw-check{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--border);border-radius:10px;cursor:pointer;font-weight:500}
.cw-check input{width:18px;height:18px;accent-color:var(--accent)}
.cw-info{padding:10px 12px;border-radius:10px;background:var(--bg3);border:1px solid var(--border);margin-bottom:12px;font-size:12.5px}
.cw-info.run{border-color:var(--green);background:rgba(16,185,129,.1)}
.cw-time{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.cw-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.cw-chips button{border:1px solid var(--border);background:var(--bg3);color:var(--text);border-radius:16px;padding:6px 12px;font-size:12px;cursor:pointer;font-family:var(--font)}
.cw-chips button.on{border-color:var(--accent);background:rgba(var(--accent-rgb),.15)}
.cw-people{max-height:280px;overflow:auto}
.cw-people label{display:flex;align-items:center;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border);cursor:pointer}
.cw-people label:last-child{border-bottom:0}
.cw-people input{width:18px;height:18px;accent-color:var(--accent)}
.cw-people .dept{margin-left:auto;font-size:11px;color:var(--muted)}
.cw-sum{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;font-size:12.5px;margin-bottom:14px}
.cw-sum dt{color:var(--muted)}
.cw-sum dd{white-space:pre-wrap}
.cw-msg{font-size:12.5px;margin-top:8px;min-height:18px}
.cw-msg.err{color:var(--red)}.cw-msg.ok{color:var(--green)}.cw-msg.warn{color:var(--amber)}
.cw-foot{display:flex;gap:8px;padding:12px 18px;border-top:1px solid var(--border);flex-wrap:wrap}
.cw-foot .grow{flex:1}
.cw-foot .btn{min-height:40px}
.cw-finish{background:var(--green)!important;border-color:var(--green)!important;color:#fff!important}
.cw-more{background:rgba(245,158,11,.15)!important;border-color:var(--amber)!important;color:var(--amber)!important}
.cw-ck-prog{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:6px}
.cw-ck-bar{height:5px;border-radius:999px;background:var(--bg3);overflow:hidden;margin-bottom:12px;border:1px solid var(--border)}
.cw-ck-bar i{display:block;height:100%;background:var(--green)}
.cw-ck-item{border:1px solid var(--border);border-radius:10px;padding:12px}
.cw-ck-list{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--accent);margin:0 0 6px;display:flex;gap:6px;align-items:center}
.cw-ck-station{display:flex;align-items:center;gap:8px;margin:0 0 8px;padding:8px 10px;border-radius:10px;background:rgba(var(--accent-rgb),.10);border:1px solid rgba(var(--accent-rgb),.35)}
.cw-ck-station i{color:var(--accent);font-size:18px}
.cw-ck-station b{font-size:14px}
.cw-ck-station small{display:block;font-size:11px;color:var(--muted)}
.cw-ck-station .cw-ck-defect{margin-left:auto;font-size:12px;padding:5px 9px;border-radius:8px;border:1px solid var(--red);color:var(--red);background:transparent;cursor:pointer;font-family:var(--font);display:inline-flex;gap:4px;align-items:center;white-space:nowrap}
.cw-ck-station .cw-ck-defect i{color:var(--red);font-size:14px}
.cw-ck-sum .grp{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);padding:8px 10px 4px;border-bottom:1px solid var(--border)}
.cw-ck-docs{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px}
.cw-ck-docs img{width:64px;height:64px;object-fit:cover;border-radius:6px;border:1px solid var(--border)}
.cw-ck-photo{height:64px;min-width:64px;padding:0 10px;border:1px dashed var(--border);border-radius:6px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:11px;color:var(--muted);cursor:pointer}
.cw-ck-photo:hover{border-color:var(--accent);color:var(--accent)}
.cw-ck-photo.busy{opacity:.5;pointer-events:none}
.cw-ck-item .lbl{font-size:15px;font-weight:600}
.cw-ck-item .desc{font-size:12px;color:var(--muted);margin-top:3px;white-space:pre-wrap}
.cw-ck-spec{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.cw-ck-spec span{font-size:11.5px;background:var(--bg3);border:1px solid var(--border);border-radius:999px;padding:1px 8px;color:var(--muted)}
.cw-ck-spec b{color:var(--text)}
.cw-ck-imgs{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.cw-ck-imgs img{height:80px;border-radius:6px;border:1px solid var(--border)}
.cw-ck-in{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px}
.cw-ck-in .form-input{max-width:200px}
.cw-ck-in textarea.form-input{max-width:none;width:100%;min-height:80px}
.cw-ck-state{font-size:12px;font-weight:600}.cw-ck-state.ok{color:var(--green)}.cw-ck-state.bad{color:var(--red)}
.cw-ck-sum button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;padding:8px 10px;border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);font-size:12.5px;cursor:pointer;font-family:var(--font)}
.cw-ck-sum button:last-child{border-bottom:0}
.cw-ck-sum .v{margin-left:auto;color:var(--muted);max-width:50%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:760px){
  .cw-overlay{padding:0}
  .cw{width:100%;max-height:100dvh;height:100dvh;border-radius:0}
  .cw-add{grid-template-columns:1fr 1fr}
  .cw-step span{display:none}
}
</style>
{{end}}

{{define "completion-wizard"}}
{{template "wizard-styles"}}
<div class="cw-overlay" id="cw" role="dialog" aria-modal="true" aria-labelledby="cw-title">
  <div class="cw">
    <div class="cw-head">
      <h2 id="cw-title"><i class="ti ti-circle-check"></i> <span id="cw-label">{{t "Abschließen"}}</span></h2>
      <div class="sub" id="cw-sub"></div>
      <div class="cw-steps" id="cw-steps">
        <div class="cw-step" data-step="-1" id="cw-step-ck" style="display:none"><b>1</b><span>{{t "Checkliste"}}</span></div>
        <div class="cw-step" data-step="0"><b>1</b><span>{{t "Material"}}</span></div>
        <div class="cw-step" data-step="1"><b>2</b><span>{{t "Zeit"}}</span></div>
        <div class="cw-step" data-step="2"><b>3</b><span>{{t "Wer war dabei?"}}</span></div>
        <div class="cw-step" data-step="3"><b>4</b><span>{{t "Kommentar"}}</span></div>
        <div class="cw-step" data-step="4"><b>5</b><span>{{t "Abschluss"}}</span></div>
      </div>
    </div>
    <div class="cw-body">
      <!-- 0 Checkliste (nur Wartung mit faelligen Punkten) – ein Punkt je Schritt -->
      <div class="cw-pane" data-step="-1">
        <h3><i class="ti ti-list-check"></i> {{t "Checkliste"}}</h3>
        <p class="hint">{{t "Erst die Checkliste – Punkt für Punkt. Jeder Punkt wird beim Weitergehen gespeichert; mit „Foto“ dokumentierst du ihn."}}</p>
        <div id="cw-ck"></div>
      </div>
      <!-- 1 Material -->
      <div class="cw-pane" data-step="0">
        <h3><i class="ti ti-package"></i> {{t "Welches Material wurde verwendet?"}}</h3>
        <p class="hint">{{t "Reservierte Teile sind bereits vom Lagerplatz abgebucht und werden beim Abschluss zum Verbrauch. Nicht benötigte Mengen vorher zurückbuchen."}}</p>
        <div class="cw-list" id="cw-parts"><div class="cw-empty">{{t "Lädt…"}}</div></div>
        <div class="cw-add">
          <div><label class="form-label">{{t "Ersatzteil suchen"}}</label><input class="form-input" id="cw-part-q" placeholder="{{t "Name oder Teilenummer"}}" autocomplete="off"></div>
          <div><label class="form-label">{{t "Lagerort"}}</label><select class="form-input" id="cw-part-loc"><option value="">{{t "Lädt…"}}</option></select></div>
          <div><label class="form-label">{{t "Menge"}}</label><input class="form-input" id="cw-part-qty" type="number" min="0.01" step="any" value="1"></div>
          <button type="button" class="btn btn-primary" onclick="cwAddPart()"><i class="ti ti-plus"></i> {{t "Reservieren"}}</button>
        </div>
        <div class="cw-results" id="cw-part-results"></div>
        <div class="sc-sub" id="cw-part-sel" style="font-size:12px;margin:-4px 0 10px;color:var(--accent)"></div>
        <label class="cw-check"><input type="checkbox" id="cw-noparts"> {{t "Kein Material verwendet"}}</label>
      </div>
      <!-- 2 Zeit -->
      <div class="cw-pane" data-step="1">
        <h3><i class="ti ti-clock"></i> {{t "Wie lange wurde gearbeitet?"}}</h3>
        <p class="hint">{{t "Deine Arbeitszeit für diesen Vorgang. Mitarbeitende aus dem nächsten Schritt bekommen denselben Zeitraum."}}</p>
        <div class="cw-info" id="cw-booked"></div>
        <div class="cw-info run" id="cw-running" style="display:none"></div>
        <div id="cw-time-inputs">
          <div class="cw-time">
            <div><label class="form-label">{{t "Beginn"}}</label><input class="form-input" id="cw-start" type="datetime-local"></div>
            <div><label class="form-label">{{t "Dauer (Minuten)"}}</label><input class="form-input" id="cw-min" type="number" min="0" max="1440" step="5" value="0"></div>
          </div>
          <div class="cw-chips" id="cw-quick"><button type="button" data-min="15">15 min</button><button type="button" data-min="30">30 min</button><button type="button" data-min="45">45 min</button><button type="button" data-min="60">1 h</button><button type="button" data-min="90">1½ h</button><button type="button" data-min="120">2 h</button><button type="button" data-min="180">3 h</button><button type="button" data-min="240">4 h</button><button type="button" data-min="480">8 h</button></div>
        </div>
      </div>
      <!-- 3 Team -->
      <div class="cw-pane" data-step="2">
        <h3><i class="ti ti-users"></i> {{t "Wer war noch dabei?"}}</h3>
        <p class="hint">{{th "Ausgewählte bekommen die Zeit als <b style='color:var(--amber)'>gelben Eintrag</b> in ihre Zeiterfassung und bestätigen ihn dort mit dem grünen Haken. Niemand? Einfach weiter."}}</p>
        <input class="form-input" id="cw-people-q" placeholder="{{t "Name suchen…"}}" style="margin-bottom:8px" autocomplete="off">
        <div class="cw-chips" id="cw-depts"></div>
        <div class="cw-list cw-people" id="cw-people"></div>
        <label style="font-size:12px;color:var(--muted);display:flex;gap:6px;align-items:center"><input type="checkbox" id="cw-all-depts"> {{t "Alle Abteilungen anzeigen"}}</label>
      </div>
      <!-- 4 Kommentar -->
      <div class="cw-pane" data-step="3">
        <h3><i class="ti ti-message"></i> {{t "Was wurde gemacht?"}}</h3>
        <p class="hint">{{t "Kurz und konkret – erscheint als Maßnahme im Verlauf."}}</p>
        <textarea data-suggest="resolution" class="form-input" id="cw-comment" rows="5" maxlength="4000" placeholder="{{t "z. B. Lichtschranke gereinigt und neu justiert, Funktionstest OK"}}"></textarea>
        <div id="cw-cause-box" style="margin-top:10px"><label class="form-label">{{t "Ursache (optional)"}}</label><input data-suggest="cause" class="form-input" id="cw-cause" maxlength="500" placeholder="{{t "z. B. Verschmutzung durch Kühlschmierstoff"}}"></div>
      </div>
      <!-- 5 Abschluss -->
      <div class="cw-pane" data-step="4">
        <h3><i class="ti ti-flag-check"></i> {{t "Fertig – oder geht's noch weiter?"}}</h3>
        <dl class="cw-sum" id="cw-sum"></dl>
        <p class="hint">{{th "<b>Fertig</b> bucht das Material und schließt den Vorgang ab. <b>Geht noch weiter</b> speichert Zeit und Kommentar, der Vorgang bleibt in Bearbeitung."}}</p>
      </div>
      <div class="cw-msg" id="cw-msg"></div>
    </div>
    <div class="cw-foot">
      <button type="button" class="btn" onclick="cwClose()">{{t "Abbrechen"}}</button>
      <span class="grow"></span>
      <button type="button" class="btn" id="cw-back" onclick="cwGo(-1)"><i class="ti ti-arrow-left"></i> {{t "Zurück"}}</button>
      <button type="button" class="btn btn-primary" id="cw-next" onclick="cwGo(1)">{{t "OK – weiter"}} <i class="ti ti-arrow-right"></i></button>
      <button type="button" class="btn cw-more" id="cw-more" onclick="cwSubmit(false)" style="display:none"><i class="ti ti-player-pause"></i> {{t "Geht noch weiter"}}</button>
      <button type="button" class="btn cw-finish" id="cw-finish" onclick="cwSubmit(true)" style="display:none"><i class="ti ti-check"></i> {{t "Fertig"}}</button>
    </div>
  </div>
</div>
<script>
(function(){
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const hm = m => Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0') + ' h';
  // F: Platzhalter %s/%d der uebersetzten Texte der Reihe nach fuellen
  const F = (s, ...a) => { let n = 0; return s.replace(/%[sd]/g, () => a[n++]); };
  let S = null; // Zustand des offenen Assistenten
  let partsCache = null;
  // Anfragen des Assistenten: mit Sitzung – oder im Leitstand mit dem
  // zweckgebundenen RFID-Token (opts.token, gilt nur fuer diesen Vorgang)
  function api(url, o){
    o = Object.assign({credentials: 'same-origin'}, o || {});
    if(S && S.token) o.headers = Object.assign({}, o.headers || {}, {'Authorization': 'Bearer ' + S.token});
    return fetch(url, o);
  }
  function reservedTag(p){
    if(typeof pdhReservedTag === 'function' && !(S && S.token)) return pdhReservedTag(p, S.type, S.id, 'cwReloadParts');
    return p && p.reserved ? ' · ' + {{t "reserviert"}} : '';
  }

  // pdhComplete(type, id, done, opts) – opts (Leitstand): {token, who}
  window.pdhComplete = async function(type, id, done, opts){
    opts = opts || {};
    if(opts.token) partsCache = null; // andere Person, andere Sicht
    S = {type, id, step: 0, info: null, parts: [], picked: '', done: done || null, busy: false, token: opts.token || '', who: opts.who || ''};
    $('cw-msg').textContent = ''; $('cw-msg').className = 'cw-msg';
    $('cw-noparts').checked = false; $('cw-comment').value = ''; $('cw-cause').value = '';
    $('cw-min').value = '0'; $('cw-part-q').value = ''; $('cw-part-sel').textContent = ''; $('cw-people-q').value = ''; $('cw-all-depts').checked = false;
    $('cw-sub').textContent = {{t "Lädt…"}};
    $('cw').classList.add('open');
    S.ck = null; $('cw-step-ck').style.display = 'none'; numberSteps();
    show(0);
    try{
      const res = await api('/complete/' + type + '/' + id);
      const json = await res.json();
      if(!res.ok || !json.success) throw new Error(json.error || {{t "Fehler"}});
      S.info = json.data;
    }catch(e){ msg('err', e.message); $('cw-sub').textContent = ''; return; }
    const i = S.info;
    $('cw-label').textContent = F({{t "%s abschließen"}}, i.Label);
    $('cw-sub').textContent = S.who ? F({{t "%s · Fertigmeldung von %s"}}, i.Title, S.who) : i.Title;
    $('cw-cause-box').style.display = i.root_cause ? '' : 'none';
    $('cw-start').value = i.suggest_start;
    $('cw-booked').innerHTML = i.booked_min > 0 ? '<i class="ti ti-history"></i> ' + F({{t "Von dir bereits erfasst: %s – weitere Zeit ist optional."}}, '<b>' + hm(i.booked_min) + '</b>') : '<i class="ti ti-info-circle"></i> ' + {{t "Für diesen Vorgang hast du noch keine Zeit erfasst."}};
    if(i.running_since){
      $('cw-running').style.display = '';
      $('cw-running').innerHTML = '<i class="ti ti-player-play"></i> ' + F({{t "Dein Timer läuft seit %s (≈ %s) und wird beim Speichern gestoppt."}}, '<b>' + esc(i.running_since) + '</b>', hm(i.running_min));
      $('cw-time-inputs').style.display = 'none';
    } else { $('cw-running').style.display = 'none'; $('cw-time-inputs').style.display = ''; }
    // Wartung: geplante Dauer vorschlagen, wenn noch keine Zeit erfasst ist
    if(!i.running_since && !i.booked_min && i.default_min > 0) $('cw-min').value = String(i.default_min);
    if(i.checklist && i.checklist.length){
      const items = i.checklist.map(c => Object.assign({}, c, {confirmed: c.value, saved: ckKey(c)}));
      let idx = items.findIndex(c => c.required && !ckFilled(c));
      if(idx < 0) idx = items.findIndex(c => !ckFilled(c));
      S.ck = {items, idx: idx < 0 ? items.length : idx};
      $('cw-step-ck').style.display = ''; numberSteps();
      show(-1);
    }
    renderPeople();
    loadLocations();
    await loadParts(); // vor dem ersten "weiter" muessen die vorgemerkten Teile bekannt sein
  };
  window.cwClose = function(){ $('cw').classList.remove('open'); S = null; };
  function msg(kind, text){ const m = $('cw-msg'); m.className = 'cw-msg ' + kind; m.textContent = text || ''; }

  function show(step){
    S.step = step;
    document.querySelectorAll('#cw .cw-pane').forEach(p => p.classList.toggle('on', +p.dataset.step === step));
    document.querySelectorAll('#cw-steps .cw-step').forEach(s => { const n = +s.dataset.step; s.classList.toggle('on', n === step); s.classList.toggle('ok', n < step); });
    $('cw-back').style.display = (step > 0 || (step === 0 && S.ck) || (step === -1 && S.ck && S.ck.idx > 0)) ? '' : 'none';
    if(step === -1) ckRender();
    $('cw-next').style.display = step < 4 ? '' : 'none';
    $('cw-more').style.display = step === 4 ? '' : 'none';
    $('cw-finish').style.display = step === 4 ? '' : 'none';
    $('cw-finish').disabled = !!(S.info && !S.info.can_finish);
    $('cw-finish').title = S.info && !S.info.can_finish ? {{t "Zum Abschließen fehlt dir die Berechtigung"}} : '';
    if(step === 4) renderSummary();
    msg('', '');
  }
  // Pruefung je Schritt, bevor es weitergeht
  function check(step){
    const i = S.info;
    if(!i) return {{t "Daten werden noch geladen…"}};
    if(step === 0 && !S.parts.length && !$('cw-noparts').checked) return {{t "Bitte Material reservieren oder „Kein Material verwendet“ ankreuzen."}};
    if(step === 1){
      const min = +$('cw-min').value || 0;
      if(min < 0 || min > 1440) return {{t "Die Dauer muss zwischen 0 und 1440 Minuten liegen."}};
      if(!i.running_since && min === 0 && i.booked_min === 0) return {{t "Bitte die Arbeitszeit angeben."}};
    }
    if(step === 2){
      const min = +$('cw-min').value || 0;
      if(picked().length && !i.running_since && min === 0) return {{t "Für die Mitarbeitenden bitte im Schritt „Zeit“ die gemeinsame Dauer angeben."}};
    }
    if(step === 3 && $('cw-comment').value.trim().length < 3) return {{t "Bitte kurz beschreiben, was gemacht wurde."}};
    return '';
  }
  window.cwGo = function(d){
    if(!S) return;
    if(S.step === -1 && S.ck){ ckGo(d); return; }
    if(d < 0 && S.step === 0 && S.ck){ S.ck.idx = S.ck.items.length; show(-1); return; }
    if(d > 0){ const err = check(S.step); if(err){ msg('err', err); return; } }
    show(Math.max(0, Math.min(4, S.step + d)));
    if(S.step === 3) $('cw-comment').focus();
  };

  // ── Material ──
  async function loadParts(){
    try{
      const res = await api(S.info.parts_url);
      const json = await res.json();
      S.parts = json.data || [];
    }catch(e){ S.parts = []; }
    $('cw-parts').innerHTML = S.parts.length ? S.parts.map(p => '<div class="cw-row"><i class="ti ti-package"></i><div class="grow">' + esc(p.part_name) + '<small>' + esc(p.part_number || '') + (p.storage_name ? ' · ' + esc(p.storage_name) : '') + reservedTag(p) + '</small></div><b>' + esc(p.qty) + '</b><button type="button" class="btn btn-icon" style="width:32px;height:32px" title="' + {{t "Entfernen"}} + '" onclick="cwDelPart(\'' + esc(p.id) + '\')"><i class="ti ti-x"></i></button></div>').join('') : '<div class="cw-empty">' + {{t "Noch kein Material reserviert."}} + '</div>';
    if(S.parts.length) $('cw-noparts').checked = false;
  }
  window.cwReloadParts = function(){ loadParts(); };
  window.cwDelPart = async function(pid){
    await api(S.info.parts_url + '/' + encodeURIComponent(pid), {method: 'DELETE'});
    loadParts();
  };
  async function loadLocations(){
    const sel = $('cw-part-loc');
    try{
      const res = await api('/api/v1/storage/');
      const json = await res.json(); const tree = json.data || json; const out = [];
      (function walk(nodes, prefix){ (nodes || []).forEach(n => { const l = prefix ? prefix + ' › ' + n.name : n.name; out.push([n.id, l]); walk(n.children, l); }); })(Array.isArray(tree) ? tree : (tree.children || []), '');
      sel.innerHTML = '<option value="">' + {{t "Lagerort wählen…"}} + '</option>' + out.map(o => '<option value="' + esc(o[0]) + '">' + esc(o[1]) + '</option>').join('');
    }catch(e){ sel.innerHTML = '<option value="">' + {{t "Lagerorte nicht verfügbar"}} + '</option>'; }
  }
  $('cw-part-q').addEventListener('input', async function(){
    const q = this.value.trim().toLowerCase(), box = $('cw-part-results');
    if(q.length < 2){ box.style.display = 'none'; return; }
    if(!partsCache){ try{ const r = await api('/api/v1/inventory/'); const j = await r.json(); partsCache = j.data || j || []; }catch(e){ partsCache = []; } }
    const hits = partsCache.filter(p => (p.name || '').toLowerCase().includes(q) || (p.part_number || '').toLowerCase().includes(q)).slice(0, 20);
    box.innerHTML = hits.length ? hits.map(p => '<div data-id="' + esc(p.id) + '" data-name="' + esc(p.name) + '">' + esc(p.name) + ' <span style="color:var(--muted)">' + esc(p.part_number || '') + ' · ' + {{t "Bestand"}} + ' ' + esc(p.stock_qty) + (p.reserved_qty > 0 ? ' (' + esc(p.reserved_qty) + ')' : '') + '</span></div>').join('') : '<div style="color:var(--muted)">' + {{t "Keine Treffer"}} + '</div>';
    box.style.display = 'block';
  });
  $('cw-part-results').addEventListener('click', function(e){
    const d = e.target.closest('[data-id]'); if(!d) return;
    S.picked = d.dataset.id; $('cw-part-sel').textContent = F({{t "Ausgewählt: %s"}}, d.dataset.name);
    this.style.display = 'none'; $('cw-part-q').value = '';
  });
  window.cwAddPart = async function(){
    const qty = parseFloat($('cw-part-qty').value), loc = $('cw-part-loc').value;
    if(!S.picked) return msg('err', {{t "Bitte zuerst ein Ersatzteil suchen und antippen."}});
    if(!loc) return msg('err', {{t "Bitte den Lagerort wählen."}});
    if(!(qty > 0)) return msg('err', {{t "Bitte eine gültige Menge angeben."}});
    try{
      const res = await api(S.info.parts_url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({part_id: S.picked, storage_node_id: loc, qty})});
      const json = await res.json().catch(() => ({}));
      if(!res.ok || json.success === false) throw new Error(json.error || 'HTTP ' + res.status);
      S.picked = ''; $('cw-part-sel').textContent = ''; $('cw-part-qty').value = '1'; msg('ok', {{t "Reserviert und vom Lager abgebucht."}});
      loadParts();
    }catch(e){ msg('err', F({{t "Nicht reserviert: %s"}}, e.message)); }
  };

  // ── Zeit ──
  $('cw-quick').addEventListener('click', e => { const b = e.target.closest('[data-min]'); if(!b) return; $('cw-min').value = b.dataset.min; syncQuick(); });
  $('cw-min').addEventListener('input', syncQuick);
  function syncQuick(){ document.querySelectorAll('#cw-quick button').forEach(b => b.classList.toggle('on', b.dataset.min === $('cw-min').value)); }

  // ── Wer war dabei? ──
  let deptFilter = '';
  function picked(){ return [...document.querySelectorAll('#cw-people input:checked')].map(i => i.value); }
  function renderPeople(){
    const i = S.info; if(!i) return;
    const all = $('cw-all-depts').checked, q = $('cw-people-q').value.trim().toLowerCase();
    const sel = new Set(picked());
    const list = (i.colleagues || []).filter(c => (all || c.suggested || sel.has(c.id)) && (!deptFilter || c.department === deptFilter) && (!q || c.name.toLowerCase().includes(q)));
    const depts = [...new Set((i.colleagues || []).filter(c => all || c.suggested).map(c => c.department).filter(Boolean))];
    $('cw-depts').innerHTML = depts.length > 1 ? '<button type="button" data-dept="" class="' + (deptFilter ? '' : 'on') + '">' + {{t "Alle"}} + '</button>' + depts.map(d => '<button type="button" data-dept="' + esc(d) + '" class="' + (deptFilter === d ? 'on' : '') + '">' + esc(d) + '</button>').join('') : '';
    $('cw-people').innerHTML = list.length ? list.map(c => '<label><input type="checkbox" value="' + esc(c.id) + '"' + (sel.has(c.id) ? ' checked' : '') + '> ' + esc(c.name) + '<span class="dept">' + esc(c.department || '–') + '</span></label>').join('')
      : '<div class="cw-empty">' + (i.departments && i.departments.length && !all ? esc(F({{t "Niemand aus %s gefunden – „Alle Abteilungen anzeigen“ ankreuzen."}}, i.departments.join(', '))) : {{t "Keine Mitarbeitenden gefunden."}}) + '</div>';
  }
  $('cw-depts').addEventListener('click', e => { const b = e.target.closest('[data-dept]'); if(!b) return; deptFilter = b.dataset.dept; renderPeople(); });
  $('cw-people-q').addEventListener('input', renderPeople);
  $('cw-all-depts').addEventListener('change', () => { deptFilter = ''; renderPeople(); });

  // ── Checkliste (Wartung) ──
  function numberSteps(){ let n = 1; document.querySelectorAll('#cw-steps .cw-step').forEach(s => { if(s.style.display !== 'none') s.querySelector('b').textContent = n++; }); }
  const ckNum = v => (v === null || v === undefined) ? '' : String(v).replace('.', ',');
  const ckParse = v => { v = String(v || '').trim().replace(',', '.'); if(v === '') return null; const n = Number(v); return isFinite(n) ? n : NaN; };
  const ckHas = v => v !== null && v !== undefined;
  function ckFilled(c){ return c.item_type === 'checkbox' ? !!c.done : String(c.value || '').trim() !== ''; }
  const ckKey = c => (c.item_type === 'checkbox' ? (c.done ? '1' : '0') : String(c.value || '').trim());
  // Punkt sofort speichern (auch per Karte am Leitstand: gleicher Token-Pfad)
  async function ckSave(c){
    if(c.saved === ckKey(c)) return '';
    try{
      const res = await api('/complete/' + S.type + '/' + S.id + '/steps/' + encodeURIComponent(c.id), {method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({value: c.item_type === 'checkbox' ? '' : String(c.value || '').trim(), done: !!c.done})});
      const json = await res.json();
      if(!res.ok || !json.success) return json.error || {{t "Fehler"}};
      c.saved = ckKey(c); c.in_range = json.data ? json.data.in_range : c.in_range;
      return '';
    }catch(e){ return e.message; }
  }
  async function ckFlush(){
    for(const c of (S.ck ? S.ck.items : [])){ const err = await ckSave(c); if(err) return F({{t "„%s“: %s"}}, c.label, err); }
    return '';
  }
  window.cwCkPhoto = async function(input){
    const c = S && S.ck && S.ck.items[S.ck.idx]; if(!c || !input.files || !input.files.length) return;
    const lbl = input.closest('.cw-ck-photo'); lbl.classList.add('busy');
    try{
      const fd = new FormData(); [...input.files].forEach(f => fd.append('files', f));
      const res = await api('/complete/' + S.type + '/' + S.id + '/steps/' + encodeURIComponent(c.id) + '/photo', {method: 'POST', body: fd});
      const json = await res.json();
      if(!res.ok || !json.success) throw new Error(json.error || {{t "Fehler"}});
      (json.data || []).filter(a => a.is_image).forEach(a => (c.doc_images = c.doc_images || []).push({id: a.id, url: a.url, filename: a.filename}));
      ckRender();
    }catch(e){ msg('err', e.message); }
    lbl.classList.remove('busy');
  };
  // Bewertung gegen Min/Max: null = keine Grenzen oder kein Wert
  function ckRange(c){
    if(c.item_type !== 'number') return null;
    const n = ckParse(c.value);
    if(n === null || isNaN(n) || (!ckHas(c.min_value) && !ckHas(c.max_value))) return null;
    return (!ckHas(c.min_value) || n >= c.min_value) && (!ckHas(c.max_value) || n <= c.max_value);
  }
  function ckError(c){
    if(c.item_type === 'number' && ckFilled(c) && isNaN(ckParse(c.value))) return F({{t "„%s“: bitte eine Zahl eingeben."}}, c.label);
    if(c.required && !ckFilled(c)) return F({{t "„%s“ ist ein Pflichtpunkt."}}, c.label);
    return '';
  }
  function ckRead(){
    const c = S.ck && S.ck.items[S.ck.idx]; if(!c) return;
    if(c.item_type === 'checkbox'){ const cb = $('cw-ck-done'); if(cb){ c.done = cb.checked; c.value = cb.checked ? 'erledigt' : ''; } }
    else { const v = $('cw-ck-val'); if(v){ c.value = v.value.trim(); c.done = c.value !== ''; } }
  }
  function ckSpec(c){
    if(c.item_type !== 'number') return '';
    const u = c.unit ? ' ' + esc(c.unit) : '', p = [];
    if(ckHas(c.target_value)) p.push('<span>' + {{t "Soll"}} + ' <b>' + esc(ckNum(c.target_value)) + u + '</b></span>');
    if(ckHas(c.min_value)) p.push('<span>Min <b>' + esc(ckNum(c.min_value)) + u + '</b></span>');
    if(ckHas(c.max_value)) p.push('<span>Max <b>' + esc(ckNum(c.max_value)) + u + '</b></span>');
    return p.length ? '<div class="cw-ck-spec">' + p.join('') + '</div>' : '';
  }
  function ckState(){
    const c = S.ck.items[S.ck.idx], st = $('cw-ck-state'); if(!c || !st) return;
    ckRead(); const r = ckRange(c);
    st.className = 'cw-ck-state' + (r === true ? ' ok' : r === false ? ' bad' : '');
    st.textContent = r === true ? {{t "im Bereich"}} : r === false ? {{t "außerhalb von Min/Max"}} : (c.item_type === 'number' && ckFilled(c) && isNaN(ckParse(c.value)) ? {{t "keine Zahl"}} : '');
  }
  window.cwCkState = ckState;
  function ckValue(c){
    if(c.item_type === 'checkbox') return c.done ? {{t "erledigt"}} : '–';
    if(!ckFilled(c)) return '–';
    return esc(c.value) + (c.item_type === 'number' && c.unit ? ' ' + esc(c.unit) : '') + (ckRange(c) === false ? ' <span style="color:var(--red)"><i class="ti ti-alert-triangle"></i></span>' : '');
  }
  // Rundgang: Gruppe = „Station · Checkliste“; Stationen in Reihenfolge
  const ckGroup = c => c.station_name ? c.station_name + ' · ' + (c.checklist_name || '') : (c.checklist_name || '');
  function ckStations(items){
    const out = [];
    items.forEach(c => { if(c.station_infra_id && !out.includes(c.station_infra_id)) out.push(c.station_infra_id); });
    return out;
  }
  // „Mangel melden“ an der Station: Stoerung zur Anlage anlegen, danach weiter im Rundgang
  window.cwReportDefect = function(){
    const c = S && S.ck && S.ck.items[S.ck.idx]; if(!c || typeof pdhCreate !== 'function') return;
    ckRead();
    pdhCreate('fault', {infra_id: c.station_infra_id, infra_label: c.station_name, onDone: () => {
      $('cw').classList.add('open'); show(-1); msg('ok', F({{t "Störung zu „%s“ gemeldet – weiter im Rundgang."}}, c.station_name));
    }});
  };
  function ckRender(){
    const box = $('cw-ck'), ck = S.ck; if(!ck) return;
    const n = ck.items.length, filled = ck.items.filter(ckFilled).length;
    let html = '<div class="cw-ck-prog"><b>' + (ck.idx < n ? esc(F({{t "Punkt %d von %d"}}, ck.idx + 1, n)) : esc({{t "Übersicht"}})) + '</b><span>' + esc(F({{t "%d von %d erfasst"}}, filled, n)) + '</span></div>'
      + '<div class="cw-ck-bar"><i style="width:' + Math.round(filled * 100 / n) + '%"></i></div>';
    if(ck.idx < n){
      const c = ck.items[ck.idx];
      const imgs = (c.ref_images || []).map(i => '<a href="' + esc(i.url) + '" target="_blank" rel="noopener"><img src="' + esc(i.url) + '" alt="' + esc(i.filename) + '" loading="lazy"></a>').join('');
      let input;
      if(c.item_type === 'checkbox') input = '<label class="cw-check" style="width:100%"><input type="checkbox" id="cw-ck-done"' + (c.done ? ' checked' : '') + '> ' + {{t "erledigt"}} + '</label>';
      else if(c.item_type === 'number') input = '<input class="form-input" id="cw-ck-val" inputmode="decimal" placeholder="' + {{t "Messwert"}} + '" value="' + esc(c.value || '') + '" oninput="cwCkState()" onkeydown="if(event.key===\'Enter\'){event.preventDefault();cwGo(1);}">' + (c.unit ? '<span>' + esc(c.unit) + '</span>' : '') + '<span class="cw-ck-state" id="cw-ck-state"></span>';
      else input = '<textarea class="form-input" id="cw-ck-val" placeholder="' + {{t "Freitext"}} + '">' + esc(c.value || '') + '</textarea>';
      const docs = (c.doc_images || []).map(i => '<a href="' + esc(i.url) + '" target="_blank" rel="noopener"><img src="' + esc(i.url) + '" alt="' + esc(i.filename) + '"></a>').join('');
      const stations = ckStations(ck.items), sn = stations.indexOf(c.station_infra_id);
      if(c.station_name) html += '<div class="cw-ck-station"><i class="ti ti-map-pin"></i><div><small>' + esc(F({{t "Station %d von %d"}}, sn + 1, stations.length)) + '</small><b>' + esc(c.station_name) + '</b></div>'
        + (!S.token && typeof pdhCreate === 'function' ? '<button type="button" class="cw-ck-defect" onclick="cwReportDefect()"><i class="ti ti-alert-triangle"></i>' + {{t "Mangel melden"}} + '</button>' : '') + '</div>';
      html += (c.checklist_name ? '<div class="cw-ck-list"><i class="ti ti-list-check"></i>' + esc(c.checklist_name) + '</div>' : '')
        + '<div class="cw-ck-item"><div class="lbl">' + (c.required ? '<span style="color:var(--red)" title="' + {{t "Pflichtpunkt"}} + '">✱</span> ' : '') + esc(c.label) + '</div>'
        + (c.description ? '<div class="desc">' + esc(c.description) + '</div>' : '') + ckSpec(c)
        + (imgs ? '<div class="cw-ck-imgs">' + imgs + '</div>' : '') + '<div class="cw-ck-in">' + input + '</div>'
        + '<div class="cw-ck-docs">' + docs + '<label class="cw-ck-photo" title="' + {{t "Foto aufnehmen oder auswählen"}} + '"><i class="ti ti-camera-plus"></i><span>' + {{t "Foto"}} + '</span><input type="file" accept="image/*" capture="environment" multiple hidden onchange="cwCkPhoto(this)"></label></div></div>';
    } else {
      html += '<p class="hint" style="margin:0 0 8px">' + {{t "Alle Punkte durchgegangen – zum Ändern antippen."}} + '</p><div class="cw-list cw-ck-sum">'
        + ck.items.map((c, k) => (k === 0 || ckGroup(c) !== ckGroup(ck.items[k - 1]) ? '<div class="grp">' + (c.station_name ? '<i class="ti ti-map-pin"></i> ' : '') + esc(ckGroup(c)) + '</div>' : '')
          + '<button type="button" data-ck="' + k + '"><i class="ti ti-' + (ckFilled(c) ? 'circle-check' : c.required ? 'alert-circle' : 'circle-dashed') + '" style="color:var(--' + (ckFilled(c) ? 'green' : c.required ? 'red' : 'muted') + ')"></i><span>' + (k + 1) + '. ' + esc(c.label) + '</span><span class="v">' + ckValue(c) + ((c.doc_images || []).length ? ' <i class="ti ti-photo"></i>' : '') + '</span></button>').join('') + '</div>';
    }
    box.innerHTML = html;
    ckState();
    const inp = $('cw-ck-val'); if(inp) inp.focus();
  }
  $('cw-ck').addEventListener('click', e => { const b = e.target.closest('[data-ck]'); if(!b || !S || !S.ck) return; S.ck.idx = +b.dataset.ck; show(-1); });
  async function ckGo(d){
    const ck = S.ck;
    ckRead();
    if(d < 0){ if(ck.idx > 0){ await ckSave(ck.items[ck.idx]); ck.idx--; show(-1); } return; }
    if(ck.idx < ck.items.length){
      const c = ck.items[ck.idx], err = ckError(c);
      if(err){ msg('err', err); return; }
      if(ckRange(c) === false && c.confirmed !== c.value){
        if(!confirm(F({{t "„%s“: %s liegt außerhalb von Min/Max. Trotzdem so übernehmen?"}}, c.label, c.value + (c.unit ? ' ' + c.unit : '')))) return;
        c.confirmed = c.value;
      }
      const saveErr = await ckSave(c);
      if(saveErr){ msg('err', saveErr); return; }
      ck.idx++; show(-1); return;
    }
    const bad = ck.items.findIndex(c => ckError(c));
    if(bad >= 0){ ck.idx = bad; show(-1); msg('err', ckError(ck.items[bad])); return; }
    show(0);
  }

  // ── Zusammenfassung & Absenden ──
  function renderSummary(){
    const i = S.info, min = +$('cw-min').value || 0;
    const names = [...document.querySelectorAll('#cw-people input:checked')].map(x => x.parentElement.textContent.replace(x.parentElement.querySelector('.dept').textContent, '').trim());
    const time = i.running_since ? F({{t "Timer seit %s (wird gestoppt)"}}, i.running_since) : (min ? F({{t "%s ab %s"}}, hm(min), $('cw-start').value.replace(/^(\d{4})-(\d{2})-(\d{2})T/, '$3.$2.$1 ')) : F({{t "keine weitere (bisher %s)"}}, hm(i.booked_min)));
    $('cw-sum').innerHTML = '<dt>' + {{t "Material"}} + '</dt><dd>' + (S.parts.length ? S.parts.map(p => esc(p.qty + ' × ' + p.part_name)).join('<br>') : {{t "kein Material"}}) + '</dd>'
      + '<dt>' + {{t "Zeit"}} + '</dt><dd>' + esc(time) + '</dd>'
      + '<dt>' + {{t "Dabei"}} + '</dt><dd>' + (names.length ? esc(names.join(', ')) + ' <span style="color:var(--amber)">(' + {{t "gelb, zur Bestätigung"}} + ')</span>' : (S.who ? esc(S.who) : {{t "nur du"}})) + '</dd>'
      + (S.ck ? '<dt>' + {{t "Checkliste"}} + '</dt><dd>' + esc(F({{t "%d von %d erfasst"}}, S.ck.items.filter(ckFilled).length, S.ck.items.length)) + '</dd>' : '')
      + '<dt>' + {{t "Kommentar"}} + '</dt><dd>' + esc($('cw-comment').value.trim()) + '</dd>'
      + ($('cw-cause').value.trim() ? '<dt>' + {{t "Ursache"}} + '</dt><dd>' + esc($('cw-cause').value.trim()) + '</dd>' : '');
  }
  window.cwSubmit = async function(finish){
    if(!S || S.busy) return;
    if(S.ck){
      ckRead();
      const flushErr = await ckFlush();
      if(flushErr){ show(-1); msg('err', flushErr); return; }
      const bad = finish ? S.ck.items.findIndex(c => ckError(c)) : S.ck.items.findIndex(c => ckFilled(c) && ckError(c));
      if(bad >= 0){ S.ck.idx = bad; show(-1); msg('err', ckError(S.ck.items[bad])); return; }
    }
    for(let s = 0; s < 4; s++){ const err = check(s); if(err && !(s === 0 && !finish)){ show(s); msg('err', err); return; } }
    S.busy = true; $('cw-finish').disabled = true; $('cw-more').disabled = true; msg('', {{t "Speichere…"}});
    const body = {no_parts: $('cw-noparts').checked, start: $('cw-start').value, minutes: S.info.running_since ? 0 : (+$('cw-min').value || 0),
      colleagues: picked(), comment: $('cw-comment').value, root_cause: $('cw-cause').value, finish};
    try{
      const res = await api('/complete/' + S.type + '/' + S.id, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)});
      const json = await res.json();
      if(!res.ok || !json.success) throw new Error(json.error || {{t "Fehler"}});
      if(json.warning){ msg('warn', json.warning); }
      else { msg('ok', json.message); }
      const done = S.done;
      // Erfolg kurz stehen lassen – mit „Nächster Termin“ etwas laenger zum Lesen
      setTimeout(() => { cwClose(); if(typeof done === 'function') done(json); else location.reload(); }, json.warning ? 3500 : (json.closed && /\d\d\.\d\d\.\d{4}/.test(json.message || '') ? 2500 : 900));
    }catch(e){
      msg('err', e.message); S.busy = false; $('cw-finish').disabled = !S.info.can_finish; $('cw-more').disabled = false;
    }
  };
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && S) cwClose(); });
})();
</script>
{{end}}
