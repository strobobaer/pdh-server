{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  <a href="/projects" class="btn btn-icon"><i class="ti ti-arrow-left"></i></a>
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Project.Name}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">
      {{if .Project.StartDate}}{{.Project.StartDate}} – {{.Project.EndDate}}{{end}}
    </p>
  </div>
  <span class="badge {{.Project.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Project.StatusLabel}}</span>
</div>

{{if .Project.Description}}
<div class="card">
  <div class="card-title">Beschreibung</div>
  <p style="font-size:13px;line-height:1.7;color:var(--muted)">{{.Project.Description}}</p>
</div>
{{end}}

<div class="card">
  <div class="card-title">Zeitstrahl</div>
  <div id="gantt-target" style="overflow-x:auto"></div>
  <div id="gantt-empty" style="display:none;font-size:12px;color:var(--muted);padding:20px;text-align:center">
    Keine Aufgaben mit Start-/Fälligkeitsdatum vorhanden.
  </div>
</div>

<div class="card">
  <div class="card-title">
    Aufgaben
    <button type="button" class="btn btn-icon" style="font-size:11px" onclick="document.getElementById('new-project-task-form').style.display='block'" title="Neue Aufgabe"><i class="ti ti-plus"></i></button>
  </div>

  <div style="display:flex;gap:8px;margin-bottom:12px">
    <select id="assign-existing-task" class="form-input" style="flex:1"><option value="">Lade offene, nicht zugeordnete Aufgaben...</option></select>
    <button type="button" class="btn btn-primary" onclick="assignExistingTask()">Zuordnen</button>
  </div>
  <div id="assign-task-result" style="font-size:12px;margin-bottom:10px"></div>

  <div id="new-project-task-form" style="display:none;background:var(--bg3);border-radius:8px;padding:12px;margin-bottom:12px">
    <form onsubmit="return submitProjectTaskForm(this)">
      <div class="grid2">
        <div class="form-group"><label class="form-label">Titel</label><input name="title" class="form-input" required></div>
        <div class="form-group"><label class="form-label">Priorität</label>
          <select name="priority" class="form-input">
            <option value="low">Low</option><option value="medium" selected>Medium</option>
            <option value="high">High</option><option value="critical">Critical</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Start</label><input name="start_date" type="date" class="form-input"></div>
        <div class="form-group"><label class="form-label">Fällig am</label><input name="due_date" type="date" class="form-input"></div>
      </div>
      <div id="project-task-create-result" style="font-size:12px;margin-bottom:8px"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn" onclick="document.getElementById('new-project-task-form').style.display='none'">Abbrechen</button>
        <button type="submit" class="btn btn-primary">Hinzufügen</button>
      </div>
    </form>
  </div>

  {{range .Tasks}}
  <div class="li" style="cursor:pointer" onclick="window.location='/tasks/{{.ID}}'">
    <div class="li-text">
      <div class="li-title">{{.Title}}</div>
      <div class="li-sub">{{if .DueDate}}fällig {{.DueDate}}{{end}}</div>
    </div>
    <span class="badge {{.PriorityClass}}" style="font-size:9px">{{.Priority}}</span>
    <span class="badge {{.StatusClass}}">{{.StatusLabel}}</span>
  </div>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">Noch keine Aufgaben in diesem Projekt</div>
  {{end}}
</div>

<!-- ── Aufgabe bearbeiten (Doppelklick im Zeitstrahl) ── -->
<div id="task-edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:460px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4)">
    <div style="font-size:15px;font-weight:600;margin-bottom:18px">Aufgabe bearbeiten</div>
    <form id="task-edit-form" onsubmit="return submitTaskEditForm(event)">
      <input type="hidden" id="task-edit-id">
      <div class="form-group">
        <label class="form-label">Titel</label>
        <input id="task-edit-title" class="form-input" required>
      </div>
      <div class="grid2">
        <div class="form-group">
          <label class="form-label">Priorität</label>
          <select id="task-edit-priority" class="form-input">
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <div id="task-edit-status" style="font-size:13px;padding-top:9px;color:var(--muted)"></div>
        </div>
      </div>
      <div class="grid2">
        <div class="form-group"><label class="form-label">Start</label><input type="date" id="task-edit-start" class="form-input"></div>
        <div class="form-group"><label class="form-label">Fällig am</label><input type="date" id="task-edit-due" class="form-input"></div>
      </div>
      <div id="task-edit-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:12px"></div>
      <div style="display:flex;gap:8px;justify-content:space-between;align-items:center">
        <a id="task-edit-fulllink" href="#" style="font-size:12px;color:var(--accent);text-decoration:none">Vollständige Ansicht →</a>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn" onclick="closeTaskEditModal()">Abbrechen</button>
          <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Speichern</button>
        </div>
      </div>
    </form>
  </div>
</div>
{{end}}

{{define "context-list"}}
{{range .Tasks}}
<div class="act-item">
  <div class="act-text">{{.Title}}</div>
  <span class="badge {{.StatusClass}}" style="font-size:9px">{{.StatusLabel}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">
<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>
<script>
var PROJECT_ID = '{{.Project.ID}}';
var ganttTasks = [
{{range .Tasks}}{{if and .StartDateISO .DueDateISO}}
  {id:'{{.ID}}', name:'{{.Title}}', start:'{{.StartDateISO}}', end:'{{.DueDateISO}}',
   progress: {{if eq .Status "resolved"}}100{{else if eq .Status "closed"}}100{{else if eq .Status "in_progress"}}50{{else}}0{{end}},
   status: '{{.Status}}', dueDateISO: '{{.DueDateISO}}', color: '{{.Color}}' },
{{end}}{{end}}
];

function ganttTaskColor(t){
  var today = new Date(); today.setHours(0,0,0,0);
  var due = t.dueDateISO ? new Date(t.dueDateISO+'T00:00:00') : null;
  var isDone = (t.status === 'resolved' || t.status === 'closed');
  var isOverdue = (!isDone && due && due < today);
  var tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate()+1);
  var isDueSoon = (!isDone && due && (due.getTime() === today.getTime() || due.getTime() === tomorrow.getTime()));

  if(isDone) return {fill:'#10b981', stroke:'#10b981'};
  if(isOverdue) return {fill: t.color || '#4f6ef7', stroke:'#ef4444'};
  if(isDueSoon) return {fill:'#f59e0b', stroke:'#f59e0b'};
  return {fill: t.color || '#4f6ef7', stroke: t.color || '#4f6ef7'};
}

function applyGanttColors(){
  ganttTasks.forEach(function(t){
    var colors = ganttTaskColor(t);
    var wrapper = document.querySelector('.bar-wrapper[data-id="' + t.id + '"]');
    if(!wrapper) return;
    var bar = wrapper.querySelector('.bar');
    var barProgress = wrapper.querySelector('.bar-progress');
    if(bar){
      bar.style.fill = colors.fill;
      bar.style.stroke = colors.stroke;
      bar.style.strokeWidth = (colors.stroke === '#ef4444') ? '3px' : '1px';
    }
    if(barProgress){
      barProgress.style.fill = colors.fill;
    }
  });
}

function formatDateISO(d){
  var year = d.getFullYear();
  var month = String(d.getMonth()+1).padStart(2,'0');
  var day = String(d.getDate()).padStart(2,'0');
  return year + '-' + month + '-' + day;
}

async function saveTaskDates(taskId, start, end){
  try{
    var res = await fetch('/api/v1/tasks/'+taskId+'/edit', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({start_date: formatDateISO(start), due_date: formatDateISO(end)})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
  }catch(e){
    alert('Termin konnte nicht gespeichert werden: '+e.message);
    location.reload();
  }
}

// Einfach-Klick navigiert (nach kurzer Verzögerung) zur Aufgabe, ein
// Doppelklick innerhalb der Verzögerung oeffnet stattdessen das
// Bearbeiten-Modal direkt hier im Zeitstrahl.
var ganttClickTimer = null;
function handleGanttBarClick(task){
  if(ganttClickTimer){
    clearTimeout(ganttClickTimer);
    ganttClickTimer = null;
    openTaskEditModal(task.id);
  } else {
    ganttClickTimer = setTimeout(function(){
      ganttClickTimer = null;
      window.location = '/tasks/' + task.id;
    }, 280);
  }
}

function renderGantt(){
  var target = document.getElementById('gantt-target');
  var empty = document.getElementById('gantt-empty');
  if(!ganttTasks.length){
    target.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  target.style.display = 'block';
  empty.style.display = 'none';
  try{
    new Gantt('#gantt-target', ganttTasks, {
      on_click: handleGanttBarClick,
      on_date_change: function(task, start, end){ saveTaskDates(task.id, start, end); },
      view_mode: 'Week'
    });
    setTimeout(applyGanttColors, 100);
  }catch(e){
    console.warn('Gantt-Rendering fehlgeschlagen', e);
    target.style.display = 'none';
    empty.style.display = 'block';
    empty.textContent = 'Zeitstrahl konnte nicht geladen werden.';
  }
}

// ── Aufgabe bearbeiten (Modal, per Doppelklick im Zeitstrahl) ──────────
async function openTaskEditModal(taskId){
  var box = document.getElementById('task-edit-modal');
  var err = document.getElementById('task-edit-error');
  err.style.display = 'none';
  document.getElementById('task-edit-id').value = taskId;
  document.getElementById('task-edit-fulllink').href = '/tasks/' + taskId;
  box.style.display = 'flex';
  try{
    var res = await fetch('/api/v1/tasks/' + taskId, {credentials:'same-origin'});
    var json = await res.json();
    if(!res.ok) throw new Error(json.error || ('HTTP '+res.status));
    var t = json.data || json;
    document.getElementById('task-edit-title').value = t.title || '';
    document.getElementById('task-edit-priority').value = t.priority || 'medium';
    document.getElementById('task-edit-status').textContent = t.status || '';
    document.getElementById('task-edit-start').value = t.start_date ? t.start_date.substring(0,10) : '';
    document.getElementById('task-edit-due').value = t.due_date ? t.due_date.substring(0,10) : '';
  }catch(e){
    err.textContent = 'Aufgabe konnte nicht geladen werden: ' + e.message;
    err.style.display = 'block';
  }
}
function closeTaskEditModal(){ document.getElementById('task-edit-modal').style.display = 'none'; }
document.getElementById('task-edit-modal').addEventListener('click', function(e){
  if(e.target.id === 'task-edit-modal') closeTaskEditModal();
});
async function submitTaskEditForm(e){
  e.preventDefault();
  var id = document.getElementById('task-edit-id').value;
  var err = document.getElementById('task-edit-error');
  err.style.display = 'none';
  var payload = {
    title: document.getElementById('task-edit-title').value,
    priority: document.getElementById('task-edit-priority').value,
    start_date: document.getElementById('task-edit-start').value,
    due_date: document.getElementById('task-edit-due').value
  };
  try{
    var res = await fetch('/api/v1/tasks/' + id + '/edit', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    location.reload();
  }catch(e){
    err.textContent = 'Fehler: ' + e.message;
    err.style.display = 'block';
  }
  return false;
}
async function loadUnassignedTasks(){
  var sel = document.getElementById('assign-existing-task');
  if(!sel) return;
  try{
    var res = await fetch('/api/v1/tasks/?unassigned=true', {credentials:'same-origin'});
    var json = await res.json();
    var all = json.data || json || [];
    var open = all.filter(function(t){ return t.status === 'open' || t.status === 'in_progress'; });
    if(open.length === 0){
      sel.innerHTML = '<option value="">Keine offenen, nicht zugeordneten Aufgaben</option>';
      return;
    }
    sel.innerHTML = '<option value="">Aufgabe wählen...</option>' + open.map(function(t){
      return '<option value="'+t.id+'">'+escapeHtml(t.title)+'</option>';
    }).join('');
  }catch(e){
    sel.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}

async function assignExistingTask(){
  var sel = document.getElementById('assign-existing-task');
  var taskId = sel.value;
  var result = document.getElementById('assign-task-result');
  if(!taskId){ result.innerHTML = '<span style="color:var(--red)">Bitte eine Aufgabe auswählen</span>'; return; }
  result.textContent = 'Ordne zu...';
  try{
    var res = await fetch('/api/v1/tasks/'+taskId+'/edit', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({project_id: PROJECT_ID})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    location.reload();
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>'; }
}

if(document.readyState !== 'loading'){ renderGantt(); loadUnassignedTasks(); }
else document.addEventListener('DOMContentLoaded', function(){ renderGantt(); loadUnassignedTasks(); });

async function submitProjectTaskForm(form){
  var fd = new FormData(form);
  var payload = {
    title: fd.get('title'), priority: fd.get('priority'),
    start_date: fd.get('start_date'), due_date: fd.get('due_date'),
    project_id: PROJECT_ID
  };
  var result = document.getElementById('project-task-create-result');
  result.textContent = 'Speichere...';
  try{
    var res = await fetch('/api/v1/tasks/', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json', Authorization:'Bearer '+pdhToken()},
      body: JSON.stringify(payload)
    });
    var json = await res.json();
    if(!res.ok || !json.success) throw new Error(json.error || 'Fehler');
    location.reload();
  }catch(e){ result.innerHTML = '<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>'; }
  return false;
}
</script>
{{end}}

