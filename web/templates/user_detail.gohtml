{{template "base" .}}
{{define "content"}}
{{$u := .User}}{{$m := .Master}}{{$p := .Private}}
<div class="rec-head">
  <a class="btn btn-icon" href="{{if .IsSelf}}/{{else}}/users{{end}}" title="Zurück"><i class="ti ti-arrow-left"></i></a>
  {{if .CanAvatar}}{{template "avatar-edit" (dict "ID" $u.ID "URL" $u.AvatarURL "Initials" $u.Initials "Bg" $u.AvatarBg "Back" (printf "/users/%s?tab=%s" $u.ID (or .Tab "overview")))}}
  {{else if $u.AvatarURL}}<img class="rec-img" src="{{$u.AvatarURL}}" alt="" style="border-radius:50%">
  {{else}}<div class="rec-img" style="display:flex;align-items:center;justify-content:center;background:{{$u.AvatarBg}};color:#fff;font-size:20px;font-weight:600;border-radius:50%">{{$u.Initials}}</div>{{end}}
  <div class="t">
    <h1>{{$u.FullName}} {{if .IsSelf}}<span class="badge b-blue">Mein Konto</span>{{end}} {{if not $u.Active}}<span class="badge b-gray">inaktiv</span>{{end}}</h1>
    <div class="sub">
      @{{$u.Username}} · <span class="badge {{$u.RoleClass}}">{{$u.RoleLabel}}</span>
      {{if $m.JobTitle}} · {{$m.JobTitle}}{{end}}{{if $u.Department}} · {{$u.Department}}{{end}}
      {{if $m.BrokerTickets}} <span class="badge b-amber" title="Erhält nicht zugewiesene Tickets aus dem Leitstand"><i class="ti ti-inbox"></i> Broker Tickets</span>{{end}}
      {{if $m.BrokerFaults}} <span class="badge b-red" title="Erhält nicht zugewiesene Störungen aus dem Leitstand"><i class="ti ti-inbox"></i> Broker Störungen</span>{{end}}
      {{if $m.BrokerTasks}} <span class="badge b-blue" title="Erhält im Leitstand angelegte Aufgaben"><i class="ti ti-inbox"></i> Broker Aufgaben</span>{{end}}
      {{if $m.BrokerMaintenance}} <span class="badge b-amber" title="Erhält im Leitstand angelegte Wartungen"><i class="ti ti-inbox"></i> Broker Wartungen</span>{{end}}
    </div>
  </div>
  {{if not .IsSelf}}<a class="btn btn-small" href="#" onclick="pdhOpenDirectChat('{{$u.ID}}');return false"><i class="ti ti-message"></i> Chat</a>{{end}}
  {{if .CanDeactivate}}<button type="button" class="btn btn-small" style="color:var(--red)" onclick="pdhDeactivateUser('{{$u.ID}}')"><i class="ti ti-user-off"></i> Deaktivieren</button>{{end}}
  {{if .CanEditMaster}}<a class="btn btn-small btn-primary" href="?tab=master" onclick="recTab('master');return false"><i class="ti ti-edit"></i> Bearbeiten</a>{{end}}
</div>

{{if .Message}}<div class="rec-msg ok"><i class="ti ti-check"></i> {{.Message}}</div>{{end}}
{{if .Error}}<div class="rec-msg err"><i class="ti ti-alert-circle"></i> {{.Error}}</div>{{end}}

<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  {{if .CanEditMaster}}<a class="rec-tab" data-tab="master" href="?tab=master"><i class="ti ti-edit"></i> Stammdaten</a>{{end}}
  {{if .CanPrivate}}<a class="rec-tab" data-tab="private" href="?tab=private"><i class="ti ti-lock"></i> Privat</a>{{end}}
  <a class="rec-tab" data-tab="quals" href="?tab=quals"><i class="ti ti-certificate"></i> Nachweise{{if .QualWarn}} <b style="background:var(--amber);color:#111">{{.QualWarn}}</b>{{end}}</a>
  <a class="rec-tab" data-tab="trainings" href="?tab=trainings"><i class="ti ti-school"></i> Schulungen</a>
  <a class="rec-tab" data-tab="work" href="?tab=work"><i class="ti ti-briefcase"></i> Zuständigkeiten <b>{{len .Responsibilities}}</b></a>
  {{if .CanPermissions}}<a class="rec-tab" data-tab="perms" href="?tab=perms"><i class="ti ti-shield-lock"></i> Einzelrechte</a>{{end}}
  {{if .IsSelf}}<a class="rec-tab" data-tab="account" href="?tab=account"><i class="ti ti-plug-connected"></i> Konto & Dienste</a>{{end}}
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Historie</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">
  <div class="rec-grid">
    <div class="card" style="margin:0">
      <div class="card-title"><span><i class="ti ti-address-book"></i> Kontakt (dienstlich)</span></div>
      <div class="rec-f"><div class="rec-l">E-Mail</div><div class="rec-v"><a href="mailto:{{$u.Email}}">{{$u.Email}}</a></div></div>
      <div class="rec-f"><div class="rec-l">Telefon</div><div class="rec-v">{{if $u.Phone}}<a href="tel:{{$u.Phone}}">{{$u.Phone}}</a>{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Durchwahl</div><div class="rec-v">{{if $m.PhoneInternal}}{{$m.PhoneInternal}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Mobil</div><div class="rec-v">{{if $m.PhoneMobile}}<a href="tel:{{$m.PhoneMobile}}">{{$m.PhoneMobile}}</a>{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Standort</div><div class="rec-v">{{if $m.WorkLocation}}{{$m.WorkLocation}}{{else}}—{{end}}</div></div>
    </div>
    <div class="card" style="margin:0">
      <div class="card-title"><span><i class="ti ti-id-badge-2"></i> Organisation</span></div>
      <div class="rec-f"><div class="rec-l">Personalnummer</div><div class="rec-v" style="font-family:monospace">{{if $m.PersonnelNo}}{{$m.PersonnelNo}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Rolle</div><div class="rec-v"><span class="badge {{$u.RoleClass}}">{{$u.RoleLabel}}</span>{{if $u.IsSystemUser}} <span class="badge b-blue">Systemnutzer</span>{{end}}</div></div>
      {{if $u.IsSystemUser}}<div class="rec-f"><div class="rec-l">Terminal-Standort</div><div class="rec-v">{{if $m.TerminalInfraID}}<a href="/infrastructure/{{$m.TerminalInfraID}}">{{$m.TerminalInfraPath}}</a>{{else}}—{{end}}</div></div>{{end}}
      <div class="rec-f"><div class="rec-l">Funktion</div><div class="rec-v">{{if $m.JobTitle}}{{$m.JobTitle}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Abteilung</div><div class="rec-v">{{if $u.Department}}{{$u.Department}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Gruppen</div><div class="rec-v">{{range $i, $g := .Groups}}{{if $i}}, {{end}}{{$g.Name}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Kostenstelle</div><div class="rec-v">{{if $m.CostCenterName}}{{$m.CostCenterName}}{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Vorgesetzte/r</div><div class="rec-v">{{if $u.ManagerID}}<a href="/users/{{$u.ManagerID}}">{{$u.ManagerName}}</a>{{else}}—{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Eintritt / Austritt</div><div class="rec-v">{{if $m.EntryDate}}{{$m.EntryDate}}{{else}}—{{end}}{{if $m.ExitDate}} / {{$m.ExitDate}}{{end}}</div></div>
      <div class="rec-f"><div class="rec-l">Angelegt</div><div class="rec-v">{{.CreatedAt}}</div></div>
    </div>
    <div class="card" style="margin:0">
      <div class="card-title"><span><i class="ti ti-certificate"></i> Qualifikationen & Rollen</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        {{if $u.ShiftLeader}}<span class="badge b-blue">Schichtführer</span>{{end}}
        {{if $u.OnCallDuty}}<span class="badge b-blue">Bereitschaft</span>{{end}}
        {{if $u.ShiftLocksmith1}}<span class="badge b-blue">Schichtschlosser 1</span>{{end}}
        {{if $u.ShiftLocksmith2}}<span class="badge b-blue">Schichtschlosser 2</span>{{end}}
        {{if $u.Sharpening}}<span class="badge b-blue">Schleifen</span>{{end}}
        {{if $u.HeatingFill}}<span class="badge b-blue">Heizung füllen</span>{{end}}
        {{if $m.BrokerTickets}}<span class="badge b-amber">Broker Tickets</span>{{end}}
        {{if $m.BrokerFaults}}<span class="badge b-red">Broker Störungen</span>{{end}}
        {{if $m.BrokerTasks}}<span class="badge b-blue">Broker Aufgaben</span>{{end}}
        {{if $m.BrokerMaintenance}}<span class="badge b-amber">Broker Wartungen</span>{{end}}
      </div>
      {{if .Team}}
      <div class="rec-sec">Team ({{len .Team}})</div>
      {{range .Team}}<div class="rec-row" data-rx data-rx-view="/users/{{.ID}}" data-rx-edit="/users/{{.ID}}"><i class="ti ti-user" style="color:var(--muted)"></i><div class="grow">{{.Name}}</div></div>{{end}}
      {{end}}
    </div>
  </div>
  {{if $m.Notes}}<div class="card"><div class="card-title"><span><i class="ti ti-notes"></i> Notizen</span></div><div class="rec-v" style="font-size:13px">{{$m.Notes}}</div></div>{{end}}
</div>

<!-- ── Stammdaten (alles in einem Formular, wie bei den übrigen Modulen) ── -->
{{if .CanEditMaster}}
<div class="rec-pane" data-pane="master">
  <form class="card rec-form" method="post" action="/users/{{$u.ID}}/master" enctype="multipart/form-data" autocomplete="off">
    <input type="hidden" name="core_submitted" value="1">
    <input type="hidden" name="username" value="{{$u.Username}}">

    <div class="rec-sec" style="margin-top:0">Person</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Vorname *</label><input name="first_name" class="form-input" value="{{$u.FirstName}}" required maxlength="100"></div>
      <div class="form-group"><label class="form-label">Nachname *</label><input name="last_name" class="form-input" value="{{$u.LastName}}" required maxlength="100"></div>
      <div class="form-group"><label class="form-label">Benutzername</label><input class="form-input" value="{{$u.Username}}" disabled title="nicht änderbar"></div>
      <div class="form-group"><label class="form-label">E-Mail *</label><input type="email" name="email" class="form-input" value="{{$u.Email}}" required maxlength="255"></div>
    </div>

    <div class="rec-sec">Anmeldung & Rolle</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Rolle</label>
        {{if .CanChangeRole}}
        <select name="role" class="form-input">{{range .Roles}}<option value="{{.Key}}" {{if eq .Key $u.RoleValue}}selected{{end}}>{{.Label}}</option>{{end}}</select>
        {{else}}<input class="form-input" value="{{$u.RoleLabel}}" disabled><input type="hidden" name="role" value="{{$u.RoleValue}}">{{end}}
      </div>
      <div class="form-group"><label class="form-label">Neues Passwort <span class="rec-sub">(leer = unverändert)</span></label><input type="password" name="password" class="form-input" autocomplete="new-password" minlength="8">
        {{if .AdminPasswordHint}}<div class="rec-sub" style="font-size:11px;margin-top:3px">{{.AdminPasswordHint}}</div>{{end}}
        {{if not $u.IsSystemUser}}<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;font-size:12px">
          {{if .Password.MustChange}}<span class="badge b-amber"><i class="ti ti-key"></i> Wechsel bei nächster Anmeldung</span>
          <button type="button" class="btn btn-small" hx-post="/users/{{$u.ID}}/password-change" hx-vals='{"on":"0"}' hx-target="#ud-pwc">Erlassen</button>
          {{else if .Password.Expired}}<span class="badge b-amber"><i class="ti ti-clock-exclamation"></i> Passwort abgelaufen</span>
          {{else}}<button type="button" class="btn btn-small" hx-post="/users/{{$u.ID}}/password-change" hx-vals='{"on":"1"}' hx-target="#ud-pwc"><i class="ti ti-key"></i> Passwortwechsel verlangen</button>{{end}}
          <span id="ud-pwc"></span></div>{{end}}
      </div>
      <div class="form-group"><label class="form-label">Nextcloud-Benutzer</label><input name="nextcloud_user_id" class="form-input" value="{{$u.NextcloudUserID}}"></div>
      <div class="form-group"><label class="form-label">RFID-Karte</label><input name="rfid_uid" class="form-input" value="{{$u.RFIDUID}}"></div>
    </div>
    <label style="font-size:13px;display:flex;gap:8px;align-items:center;margin-bottom:6px"><input type="checkbox" name="is_system_user" id="ud-system-user" {{if $u.IsSystemUser}}checked{{end}} onchange="var t=document.getElementById('ud-terminal-loc'); if(t) t.style.display=this.checked?'':'none'"> Systemnutzer (Terminal, bleibt dauerhaft angemeldet)</label>
    {{if .CanBroker}}<div id="ud-terminal-loc" style="{{if not $u.IsSystemUser}}display:none;{{end}}margin:4px 0 10px">
      {{template "infra-tree-picker" (dict "TargetID" "ud-terminal-infra" "SelectedLabelID" "ud-terminal-infra-label" "Label" "Standort des Terminals" "Name" "terminal_infrastructure_id" "Value" $m.TerminalInfraID "SelectedLabel" $m.TerminalInfraPath)}}
      <div class="rec-sub" style="margin-top:4px">Beim Anlegen von Tickets, Störungen &amp; Co. an diesem Terminal klappt die Infrastruktur-Auswahl bis hierhin auf.</div>
    </div>{{end}}

    <div class="rec-sec">Organisation</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Personalnummer</label><input name="personnel_no" class="form-input" value="{{$m.PersonnelNo}}" maxlength="50"></div>
      <div class="form-group"><label class="form-label">Funktion / Stelle</label><input name="job_title" class="form-input" value="{{$m.JobTitle}}" maxlength="100" placeholder="z. B. Instandhalter Elektrik"></div>
      <div class="form-group"><label class="form-label">Abteilung</label>
        <select name="department" class="form-input"><option value="">– keine –</option>{{$hasDep := false}}{{range .Departments}}<option value="{{.}}" {{if eq . $u.Department}}selected{{$hasDep = true}}{{end}}>{{.}}</option>{{end}}{{if and $u.Department (not $hasDep)}}<option value="{{$u.Department}}" selected>{{$u.Department}}</option>{{end}}</select></div>
      <div class="form-group"><label class="form-label">Vorgesetzte/r</label>
        <select name="manager_id" class="form-input"><option value="">– keine/r –</option>{{range .ManagerOptions}}{{if ne .ID $u.ID}}<option value="{{.ID}}" {{if eq .ID $u.ManagerID}}selected{{end}}>{{.Name}}</option>{{end}}{{end}}</select></div>
      <div class="form-group"><label class="form-label">Arbeitsort / Standort</label><input name="work_location" class="form-input" value="{{$m.WorkLocation}}" maxlength="150"></div>
      <div class="form-group"><label class="form-label">Sprache</label>
        <select name="language" class="form-input">{{$known := false}}{{range langs}}<option value="{{.Code}}" {{if eq .Code $m.Language}}selected{{$known = true}}{{end}}>{{.Name}}</option>{{end}}{{if and $m.Language (not $known)}}<option value="{{$m.Language}}" selected>{{$m.Language}}</option>{{end}}</select>
        <div class="rec-sub" style="margin-top:3px">{{t "Sprache der Oberfläche – wird beim Anmelden verwendet; umstellen geht jederzeit über die Flagge oben rechts."}}</div></div>
      <div class="form-group"><label class="form-label">Eintritt</label><input type="date" name="entry_date" class="form-input" value="{{$m.EntryDate}}"></div>
      <div class="form-group"><label class="form-label">Austritt</label><input type="date" name="exit_date" class="form-input" value="{{$m.ExitDate}}"></div>
    </div>
    {{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "user-cost-center" "Value" $m.CostCenterID)}}

    <div class="rec-sec">Erreichbarkeit (dienstlich)</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Telefon</label><input name="phone" class="form-input" value="{{$u.Phone}}" maxlength="50"></div>
      <div class="form-group"><label class="form-label">Durchwahl</label><input name="phone_internal" class="form-input" value="{{$m.PhoneInternal}}" maxlength="30"></div>
      <div class="form-group"><label class="form-label">Mobil (dienstlich)</label><input name="phone_mobile" class="form-input" value="{{$m.PhoneMobile}}" maxlength="50"></div>
    </div>

    <div class="rec-sec">Qualifikationen (Schichtplan)</div>
    <div class="cols">
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="shift_leader" {{if $u.ShiftLeader}}checked{{end}}> Schichtführer</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="on_call_duty" {{if $u.OnCallDuty}}checked{{end}}> Bereitschaft</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="shift_locksmith_1" {{if $u.ShiftLocksmith1}}checked{{end}}> Schichtschlosser 1</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="shift_locksmith_2" {{if $u.ShiftLocksmith2}}checked{{end}}> Schichtschlosser 2</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="sharpening" {{if $u.Sharpening}}checked{{end}}> Schleifen</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="heating_fill" {{if $u.HeatingFill}}checked{{end}}> Heizung füllen</label>
    </div>

    <div class="rec-sec">Broker-Funktion</div>
    {{if .CanBroker}}
    <p class="rec-sub" style="margin-bottom:8px">Im Leitstand angelegte Vorgänge werden nicht zugewiesen, sondern gehen an alle Broker des Typs – jeder erhält eine Chat-Nachricht mit dem Vorgang und übernimmt oder verteilt ihn.</p>
    <div class="cols">
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="broker_tickets" {{if $m.BrokerTickets}}checked{{end}}> Broker für Tickets</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="broker_faults" {{if $m.BrokerFaults}}checked{{end}}> Broker für Störungen</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="broker_tasks" {{if $m.BrokerTasks}}checked{{end}}> Broker für Aufgaben</label>
      <label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="broker_maintenance" {{if $m.BrokerMaintenance}}checked{{end}}> Broker für Wartungen</label>
    </div>
    {{else}}
    <p class="rec-sub">Tickets: {{if $m.BrokerTickets}}ja{{else}}nein{{end}} · Störungen: {{if $m.BrokerFaults}}ja{{else}}nein{{end}} · Aufgaben: {{if $m.BrokerTasks}}ja{{else}}nein{{end}} · Wartungen: {{if $m.BrokerMaintenance}}ja{{else}}nein{{end}} – Vergabe durch die Benutzerverwaltung.</p>
    {{end}}

    <div class="form-group" style="margin-top:12px"><label class="form-label">Notizen (dienstlich)</label><textarea name="notes" class="form-input" rows="3">{{$m.Notes}}</textarea></div>
    <div style="display:flex;justify-content:flex-end;gap:8px">
      <a class="btn" href="?tab=overview">Abbrechen</a>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </form>
  <form class="card rec-form" method="post" action="/users/{{$u.ID}}/groups" style="margin-top:12px">
    <div class="rec-sec" style="margin-top:0">Gruppen</div>
    {{if .AllGroups}}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:4px 12px">
      {{$mine := .Groups}}
      {{range .AllGroups}}{{$gid := .ID}}<label style="font-size:13px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="group_ids" value="{{.ID}}" {{range $mine}}{{if eq .ID $gid}}checked{{end}}{{end}}> {{.Name}}{{if .DepartmentName}} <span class="rec-sub">({{.DepartmentName}})</span>{{end}}</label>{{end}}
    </div>
    <div style="display:flex;justify-content:flex-end;margin-top:8px"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Gruppen speichern</button></div>
    {{else}}<p class="rec-sub">Noch keine Gruppen angelegt{{if .CanManageUsers}} – unter <a href="/admin/org-units#groups" style="color:var(--accent)">Abteilungen &amp; Gruppen</a>{{end}}.</p>{{end}}
  </form>
</div>
{{end}}

<!-- ── Privat ── -->
{{if .CanPrivate}}
<div class="rec-pane" data-pane="private">
  <div class="rec-msg" style="background:rgba(245,158,11,.12);color:var(--amber)"><i class="ti ti-lock"></i> Vertrauliche Daten – sichtbar nur für die Person selbst und Berechtigte (Recht „Private Mitarbeiterdaten“). Änderungen werden ohne Inhalte protokolliert.</div>
  <form class="card rec-form" method="post" action="/users/{{$u.ID}}/private" autocomplete="off">
    <div class="rec-sec" style="margin-top:0">Person</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Geburtsdatum</label><input type="date" name="birth_date" class="form-input" value="{{$p.BirthDate}}"></div>
    </div>
    <div class="rec-sec">Anschrift</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Straße, Nr.</label><input name="street" class="form-input" value="{{$p.Street}}" maxlength="200"></div>
      <div class="form-group"><label class="form-label">PLZ</label><input name="postal_code" class="form-input" value="{{$p.PostalCode}}" maxlength="20"></div>
      <div class="form-group"><label class="form-label">Ort</label><input name="city" class="form-input" value="{{$p.City}}" maxlength="100"></div>
      <div class="form-group"><label class="form-label">Land</label><input name="country" class="form-input" value="{{$p.Country}}" maxlength="100"></div>
    </div>
    <div class="rec-sec">Private Erreichbarkeit</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Telefon</label><input name="private_phone" class="form-input" value="{{$p.PrivatePhone}}" maxlength="50"></div>
      <div class="form-group"><label class="form-label">Mobil</label><input name="private_mobile" class="form-input" value="{{$p.PrivateMobile}}" maxlength="50"></div>
      <div class="form-group"><label class="form-label">E-Mail</label><input type="email" name="private_email" class="form-input" value="{{$p.PrivateEmail}}" maxlength="150"></div>
    </div>
    <div class="rec-sec">Notfallkontakt</div>
    <div class="cols">
      <div class="form-group"><label class="form-label">Name</label><input name="emergency_name" class="form-input" value="{{$p.EmergencyName}}" maxlength="150"></div>
      <div class="form-group"><label class="form-label">Beziehung</label><input name="emergency_relation" class="form-input" value="{{$p.EmergencyRelation}}" maxlength="100" placeholder="z. B. Ehepartner/in"></div>
      <div class="form-group"><label class="form-label">Telefon</label><input name="emergency_phone" class="form-input" value="{{$p.EmergencyPhone}}" maxlength="50"></div>
    </div>
    <div class="form-group"><label class="form-label">Vertrauliche Notizen</label><textarea name="private_notes" class="form-input" rows="3">{{$p.Notes}}</textarea></div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
      <span class="rec-sub">{{if $p.UpdatedAt}}Zuletzt geändert {{$p.UpdatedAt}}{{if $p.UpdatedBy}} von {{$p.UpdatedBy}}{{end}}{{end}}</span>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </form>
</div>
{{end}}

<!-- ── Nachweise: Führerschein, externe Qualifikationen, Lehrgänge ── -->
<div class="rec-pane" data-pane="quals">
  {{$d := .}}
  {{if .QualWarn}}<div class="rec-msg" style="background:rgba(245,158,11,.12);color:var(--amber)"><i class="ti ti-alert-triangle"></i> {{.QualWarn}} Nachweis(e) abgelaufen oder laufen in den nächsten 60 Tagen ab.</div>{{end}}
  <div class="rec-grid">
  {{range .Quals}}
    <div class="card" style="margin:0">
      <div class="card-title"><span><i class="ti {{.Icon}}"></i> {{.Label}}</span><span class="rec-sub">{{len .Items}}</span></div>
      {{range .Items}}
      <div class="rec-row" style="align-items:flex-start">
        <div class="grow">
          <div style="font-weight:500">{{.Title}}{{if .Classes}} <span class="badge b-blue">{{.Classes}}</span>{{end}}</div>
          <div class="rec-sub">
            {{if .Issuer}}{{.Issuer}}{{end}}{{if .Number}} · Nr. {{.Number}}{{end}}
            {{if .IssuedLabel}} · ab {{.IssuedLabel}}{{end}}{{if .Hours}} · {{.Hours}} Std.{{end}}
          </div>
          {{if .ValidLabel}}<div style="font-size:12px;margin-top:2px;color:{{if eq .State "expired"}}var(--red){{else if eq .State "soon"}}var(--amber){{else}}var(--muted){{end}}">
            {{if eq .State "expired"}}<i class="ti ti-alert-circle"></i> abgelaufen am{{else if eq .State "soon"}}<i class="ti ti-alert-triangle"></i> läuft ab am{{else}}gültig bis{{end}} {{.ValidLabel}}</div>{{end}}
          {{if .Notes}}<div class="rec-sub" style="margin-top:2px">{{.Notes}}</div>{{end}}
          {{if $d.CanEditMaster}}
          <details style="margin-top:6px"><summary class="rec-sub" style="cursor:pointer">Bearbeiten</summary>
            {{template "user-qual-form" (dict "U" $d.User.ID "Q" . "Kinds" $d.QualKinds "Kind" .Kind "Number" $d.CanPrivate)}}
          </details>
          {{end}}
        </div>
        {{if $d.CanEditMaster}}<form method="post" action="/users/{{$d.User.ID}}/qualifications/{{.ID}}/delete" onsubmit="return confirm('Nachweis entfernen?')"><button class="btn btn-icon" style="width:30px;min-width:30px;height:30px" title="Entfernen"><i class="ti ti-trash" style="font-size:14px"></i></button></form>{{end}}
      </div>
      {{else}}<div class="rec-sub">Keine Einträge</div>{{end}}
      {{if $d.CanEditMaster}}
      <details style="margin-top:8px"><summary style="cursor:pointer;font-size:12px;color:var(--accent)"><i class="ti ti-plus"></i> Hinzufügen</summary>
        {{template "user-qual-form" (dict "U" $d.User.ID "Kinds" $d.QualKinds "Kind" .Key "Number" $d.CanPrivate)}}
      </details>
      {{end}}
    </div>
  {{end}}
  </div>
</div>

<!-- ── Schulungen ── -->
<div class="rec-pane" data-pane="trainings">
  <div hx-get="/trainings/user/{{$u.ID}}" hx-trigger="load" hx-swap="innerHTML"><span class="rec-sub">Lädt…</span></div>
  <p class="rec-sub" style="margin-top:8px"><a href="/trainings" style="color:var(--accent)">Zur Schulungsmatrix</a></p>
</div>

<!-- ── Zuständigkeiten ── -->
<div class="rec-pane" data-pane="work">
  <div class="card" style="padding:0;overflow-x:auto">
    <table>
      <thead><tr><th>Vorgang</th><th>Art</th><th>Rolle</th><th>Fällig</th><th>Status</th></tr></thead>
      <tbody>
      {{range .Responsibilities}}
      <tr>
        <td><a href="{{.URL}}" data-frame data-frame-title="{{.Module}}: {{.Title}}" style="color:var(--accent)">{{.Title}}</a></td>
        <td>{{.Module}}</td><td>{{.Role}}</td><td style="white-space:nowrap">{{.Due}}</td>
        <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      </tr>
      {{else}}<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:16px">Keine offenen Vorgänge</td></tr>{{end}}
      </tbody>
    </table>
  </div>
</div>

<!-- ── Einzelrechte ── -->
{{if .CanPermissions}}
<div class="rec-pane" data-pane="perms">
  {{if .CanMakeAdmin}}
  <div class="card" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
    <i class="ti ti-crown" style="font-size:22px;color:var(--amber)"></i>
    <div style="flex:1;min-width:200px"><div style="font-weight:600">Zum Administrator machen</div><div class="rec-sub">Nur für Administratoren sichtbar. Die Person erhält die Rolle „Administrator“ mit allen Rechten.</div></div>
    <button type="button" class="btn btn-small" style="border-color:var(--amber);color:var(--amber)" onclick="pdhMakeAdmin('{{$u.ID}}','{{$u.FullName}}')"><i class="ti ti-crown"></i> Admin machen</button>
  </div>
  {{end}}
  <div class="card">
    <div class="card-title"><span><i class="ti ti-shield-lock"></i> Einzelrechte</span><span class="rec-sub">Abweichungen von der Rolle „{{$u.RoleLabel}}“</span></div>
    <p class="rec-sub" style="margin-bottom:8px">„Rolle“ übernimmt die Einstellung der Rolle; „Erlaubt“/„Verboten“ gelten nur für diese Person und haben Vorrang. Änderungen werden sofort gespeichert.</p>
    <div id="perm-list" data-user="{{$u.ID}}" style="font-size:13px">Wird geladen…</div>
  </div>
</div>
{{end}}

<!-- ── Konto & Dienste (nur eigenes Konto) ── -->
{{if .IsSelf}}
<div class="rec-pane" data-pane="account">
  <div class="card">
    <div class="card-title"><span><i class="ti ti-bell"></i> Chat-Hinweise zu Änderungen</span><span id="cn-result" class="rec-sub"></span></div>
    <label style="display:flex;gap:8px;align-items:flex-start;font-size:13px;cursor:pointer">
      <input type="checkbox" {{if .ChangeNotifications}}checked{{end}} style="margin-top:3px"
             hx-post="/users/me/change-notifications" hx-trigger="change" hx-vals='js:{on: event.target.checked ? "1" : "0"}' hx-target="#cn-result">
      <span>PDH-System schickt mir einen Chat-Hinweis, wenn jemand ein Ticket, eine Störung, Aufgabe, Wartung oder ein Projekt ändert, das ich erfasst habe, verantworte oder dem ich zugewiesen bin.</span>
    </label>
  </div>
  <div class="card">
    <div class="card-title"><span><i class="ti ti-key"></i> {{if .HasPassword}}Passwort ändern{{else}}Passwort festlegen{{end}}</span></div>
    {{if not .HasPassword}}<p class="rec-sub" style="margin-bottom:10px">Dein Konto hat noch kein Passwort (z. B. Anmeldung nur per Karte oder Microsoft). Hier legst du eines fest, um dich auch mit Benutzername und Passwort anzumelden.</p>{{end}}
    <form hx-post="/users/me/password" hx-target="#pw-result" hx-on::after-request="if(event.detail.successful && event.detail.xhr.responseText.indexOf('ti-check') > -1){ this.reset(); {{if not .HasPassword}}setTimeout(function(){ location.reload(); }, 1500);{{end}} }" autocomplete="off">
      <div class="grid2" style="gap:10px">
        {{if .HasPassword}}<div class="form-group"><label class="form-label">Aktuelles Passwort</label><input type="password" name="current" class="form-input" required autocomplete="current-password"></div><div></div>{{end}}
        <div class="form-group"><label class="form-label">Neues Passwort</label><input type="password" name="password" class="form-input" required minlength="8" maxlength="72" autocomplete="new-password">{{if .PasswordHint}}<div class="rec-sub" style="font-size:11px;margin-top:3px">{{.PasswordHint}}</div>{{end}}</div>
        <div class="form-group"><label class="form-label">Neues Passwort wiederholen</label><input type="password" name="password2" class="form-input" required minlength="8" maxlength="72" autocomplete="new-password"></div>
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i> Passwort speichern</button>
        <span id="pw-result" class="rec-sub" role="status"></span>
      </div>
    </form>
    <p class="rec-sub" style="margin-top:8px;font-size:11.5px">Passwort vergessen? Melde dich ab und wähle auf der Anmeldeseite „Passwort vergessen?“.</p>
  </div>
  <div class="card" style="padding:0;overflow:hidden">
    <iframe name="pdh-embed" src="/account" title="Konto & Dienste" loading="lazy" style="width:100%;height:640px;border:0;display:block;background:var(--bg)"></iframe>
  </div>
</div>
{{end}}

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "user" "ID" $u.ID)}}</div>
</div>

<!-- ── Historie ── -->
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "user" "ID" $u.ID)}}</div>
{{end}}

{{define "user-qual-form"}}
{{$q := .Q}}{{$kind := .Kind}}
<form method="post" action="/users/{{.U}}/qualifications" class="rec-form" style="margin-top:8px">
  {{with $q}}<input type="hidden" name="qual_id" value="{{.ID}}">{{end}}
  <div class="cols">
    <div class="form-group"><label class="form-label">Art</label>
      <select name="kind" class="form-input">{{range .Kinds}}<option value="{{.Key}}" {{if eq .Key $kind}}selected{{end}}>{{.Label}}</option>{{end}}</select></div>
    <div class="form-group"><label class="form-label">Bezeichnung *</label><input name="title" class="form-input" required maxlength="200" value="{{with $q}}{{.Title}}{{end}}"
      placeholder="{{if eq $kind "license"}}z. B. Führerschein{{else if eq $kind "course"}}z. B. Ersthelfer-Lehrgang{{else}}z. B. Elektrofachkraft, Staplerschein{{end}}"></div>
    <div class="form-group"><label class="form-label">{{if eq $kind "license"}}Klassen{{else}}Stufe / Umfang{{end}}</label><input name="classes" class="form-input" maxlength="100" value="{{with $q}}{{.Classes}}{{end}}" placeholder="{{if eq $kind "license"}}z. B. B, BE, C1{{end}}"></div>
    <div class="form-group"><label class="form-label">{{if eq $kind "course"}}Anbieter{{else}}Aussteller / Prüfstelle{{end}}</label><input name="issuer" class="form-input" maxlength="200" value="{{with $q}}{{.Issuer}}{{end}}"></div>
    {{if .Number}}<div class="form-group"><label class="form-label">Nummer <span class="rec-sub">(vertraulich)</span></label><input name="number" class="form-input" maxlength="100" value="{{with $q}}{{.Number}}{{end}}" autocomplete="off"></div>{{end}}
    <div class="form-group"><label class="form-label">{{if eq $kind "course"}}Teilnahme am{{else}}Ausgestellt am{{end}}</label><input type="date" name="issued_on" class="form-input" value="{{with $q}}{{.IssuedOn}}{{end}}"></div>
    <div class="form-group"><label class="form-label">Gültig bis</label><input type="date" name="valid_until" class="form-input" value="{{with $q}}{{.ValidUntil}}{{end}}"></div>
    {{if eq $kind "course"}}<div class="form-group"><label class="form-label">Dauer (Std.)</label><input name="hours" class="form-input" inputmode="decimal" value="{{with $q}}{{.Hours}}{{end}}"></div>{{end}}
  </div>
  <div class="form-group"><label class="form-label">Bemerkung</label><input name="notes" class="form-input" maxlength="1000" value="{{with $q}}{{.Notes}}{{end}}"></div>
  <div style="display:flex;justify-content:flex-end"><button class="btn btn-primary btn-small" type="submit"><i class="ti ti-device-floppy"></i> Speichern</button></div>
</form>
{{end}}

{{define "context-list"}}
{{range .Team}}<div class="act-item" onclick="location='/users/{{.ID}}'" style="cursor:pointer"><div class="act-dot d-blue"></div><div class="act-text">{{.Name}}</div></div>{{end}}
{{end}}

{{define "scripts"}}
<script>
// 1:1-Chat mit der Person in der Seitenleiste oeffnen (Fallback: Chat-Seite)
async function pdhOpenDirectChat(userId){
  try {
    const res = await fetch('/chat/api/direct', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body: JSON.stringify({user_id: userId})});
    const d = await res.json();
    if(!res.ok) throw new Error(d.error || res.status);
    if(window.pdhSideChat && window.pdhSideChat.open) window.pdhSideChat.open(d.id);
    else location.href = '/chat#c=' + d.id;
  } catch(e){ alert('Chat konnte nicht geöffnet werden: ' + e.message); }
}

async function pdhDeactivateUser(userId){
  if(!confirm('Benutzer deaktivieren? Die Person kann sich danach nicht mehr anmelden.')) return;
  const res = await fetch('/users/' + userId + '/deactivate-web', {method: 'DELETE', credentials: 'same-origin'});
  if(res.ok) location.href = '/users/' + userId + '?msg=' + encodeURIComponent('Benutzer deaktiviert');
  else alert('Deaktivieren fehlgeschlagen: ' + (await res.text()));
}

async function pdhMakeAdmin(userId, name){
  if(!confirm(name + ' wirklich zum Administrator machen?')) return;
  const res = await fetch('/users/' + userId + '/role-web', {method: 'POST', credentials: 'same-origin',
    headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'role=admin'});
  if(res.ok) location.href = '/users/' + userId + '?tab=perms&msg=' + encodeURIComponent('Rolle auf Administrator geändert');
  else alert('Nicht möglich: ' + (await res.text()));
}

// Einzelrechte: Liste laden (JSON) und Aenderungen sofort speichern
(function(){
  const box = document.getElementById('perm-list');
  if(!box) return;
  const userId = box.dataset.user;
  let loaded = false;
  async function load(){
    if(loaded) return; loaded = true;
    try {
      const res = await fetch('/users/' + userId + '/permissions', {credentials: 'same-origin'});
      if(!res.ok) throw new Error(await res.text() || ('HTTP ' + res.status));
      render(await res.json() || []);
    } catch(e){ box.innerHTML = ''; const s = document.createElement('span'); s.style.color = 'var(--red)'; s.textContent = 'Konnte nicht geladen werden: ' + e.message; box.appendChild(s); loaded = false; }
  }
  function render(rows){
    box.replaceChildren();
    let cat = null;
    rows.forEach(function(row){
      if(row.category !== cat){
        cat = row.category;
        const h = document.createElement('div');
        h.className = 'rec-sec'; h.textContent = cat;
        box.appendChild(h);
      }
      const line = document.createElement('div');
      line.className = 'rec-row';
      const label = document.createElement('div');
      label.className = 'grow';
      label.textContent = row.label;
      const hint = document.createElement('div');
      hint.className = 'rec-sub';
      hint.textContent = 'Rolle: ' + (row.role_granted ? 'erlaubt' : 'nicht erlaubt');
      label.appendChild(hint);
      const sel = document.createElement('select');
      sel.className = 'form-input'; sel.style.cssText = 'width:auto;font-size:12px;padding:5px 8px';
      sel.add(new Option('Wie Rolle (' + (row.role_granted ? 'erlaubt' : 'verboten') + ')', 'clear'));
      sel.add(new Option('Erlaubt', 'allow'));
      sel.add(new Option('Verboten', 'deny'));
      sel.value = row.override === true ? 'allow' : row.override === false ? 'deny' : 'clear';
      const mark = function(){ line.style.background = sel.value === 'clear' ? '' : 'rgba(var(--accent-rgb),.07)'; };
      mark();
      sel.addEventListener('change', async function(){
        sel.disabled = true;
        try {
          const res = await fetch('/users/' + userId + '/permissions', {method: 'POST', credentials: 'same-origin',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: 'permission_id=' + encodeURIComponent(row.id) + '&mode=' + encodeURIComponent(sel.value)});
          if(!res.ok) throw new Error(await res.text() || ('HTTP ' + res.status));
          mark();
        } catch(e){ alert('Konnte nicht gespeichert werden: ' + e.message); }
        finally { sel.disabled = false; }
      });
      line.append(label, sel);
      box.appendChild(line);
    });
    if(!rows.length) box.textContent = 'Keine Berechtigungen definiert.';
  }
  // erst laden, wenn der Reiter sichtbar ist
  const obs = new IntersectionObserver(function(entries){ if(entries.some(function(e){ return e.isIntersecting; })) load(); });
  obs.observe(box);
})();
</script>
{{end}}
