{{/*
Reusable action button widgets for PDH.

Goal:
- one visual and semantic button system for all modules
- usable in forms, tables, cards, modals and HTMX fragments
- supports normal links, submit buttons, plain buttons and HTMX actions

Supported actions:
- new
- refresh
- expand
- filter
- analyze
- edit
- view
- copy
- history
- more
- start
- stop
- book
- delete
- delete-mark
- activate
- deactivate
- done
- cancel
- save
- back
- send

Expected data fields:
Action      string  // new, refresh, expand, filter, analyze, edit, view, copy, history, more, start, stop, book, delete, delete-mark, activate, deactivate, done, cancel, save, back, send
ID          string  // optional element id
Label       string  // optional; falls back to the default action label
ShowLabel   bool    // optional; only filter shows a label by default, all other actions are icon-only
Href        string  // optional link target
Type        string  // optional button type: button, submit, reset
Class       string  // optional extra classes
Style       string  // optional inline style
Confirm     string  // optional confirm text
OnClick     string
HxGet       string
HxPost      string
HxPut       string
HxDelete    string
HxTarget    string
HxSwap      string
HxTrigger   string
HxVals      string
HxConfirm   string
HxIndicator string
HxOnAfterRequest string
Disabled    bool
*/}}

{{define "action-button"}}{{template "icon-button" .}}{{end}}

{{define "icon-button"}}
{{- $action := .Action -}}
{{- $label := .Label -}}
{{- $icon := "ti ti-circle" -}}
{{- $fallback := "?" -}}
{{- $variant := "btn" -}}
{{- if eq $action "new" -}}{{- $icon = "ti ti-plus" -}}{{- $fallback = "+" -}}{{- if not $label -}}{{- $label = "Neu" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "refresh" -}}{{- $icon = "ti ti-refresh" -}}{{- $fallback = "R" -}}{{- if not $label -}}{{- $label = "Aktualisieren" -}}{{- end -}}{{- end -}}
{{- if eq $action "expand" -}}{{- $icon = "ti ti-arrows-maximize" -}}{{- $fallback = "[]" -}}{{- if not $label -}}{{- $label = "Aufklappen" -}}{{- end -}}{{- end -}}
{{- if eq $action "filter" -}}{{- $icon = "ti ti-filter" -}}{{- $fallback = "F" -}}{{- if not $label -}}{{- $label = "Filtern" -}}{{- end -}}{{- end -}}
{{- if eq $action "analyze" -}}{{- $icon = "ti ti-brain" -}}{{- $fallback = "AI" -}}{{- if not $label -}}{{- $label = "Analysieren" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "edit" -}}{{- $icon = "ti ti-pencil" -}}{{- $fallback = "E" -}}{{- if not $label -}}{{- $label = "Bearbeiten" -}}{{- end -}}{{- end -}}
{{- if eq $action "view" -}}{{- $icon = "ti ti-eye" -}}{{- $fallback = "O" -}}{{- if not $label -}}{{- $label = "Details" -}}{{- end -}}{{- end -}}
{{- if eq $action "copy" -}}{{- $icon = "ti ti-copy" -}}{{- $fallback = "C" -}}{{- if not $label -}}{{- $label = "Kopieren" -}}{{- end -}}{{- end -}}
{{- if eq $action "history" -}}{{- $icon = "ti ti-history" -}}{{- $fallback = "H" -}}{{- if not $label -}}{{- $label = "Historie" -}}{{- end -}}{{- end -}}
{{- if eq $action "more" -}}{{- $icon = "ti ti-dots" -}}{{- $fallback = "..." -}}{{- if not $label -}}{{- $label = "Mehr" -}}{{- end -}}{{- end -}}
{{- if eq $action "start" -}}{{- $icon = "ti ti-player-play" -}}{{- $fallback = ">" -}}{{- if not $label -}}{{- $label = "Starten" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "stop" -}}{{- $icon = "ti ti-player-stop" -}}{{- $fallback = "[]" -}}{{- if not $label -}}{{- $label = "Stoppen" -}}{{- end -}}{{- end -}}
{{- if eq $action "book" -}}{{- $icon = "ti ti-arrows-exchange" -}}{{- $fallback = "B" -}}{{- if not $label -}}{{- $label = "Buchen" -}}{{- end -}}{{- end -}}
{{- if eq $action "delete" -}}{{- $icon = "ti ti-trash" -}}{{- $fallback = "D" -}}{{- if not $label -}}{{- $label = "Löschen" -}}{{- end -}}{{- $variant = "btn btn-danger" -}}{{- end -}}
{{- if eq $action "delete-mark" -}}{{- $icon = "ti ti-trash-x" -}}{{- $fallback = "DX" -}}{{- if not $label -}}{{- $label = "Löschvormerkung" -}}{{- end -}}{{- $variant = "btn btn-warning" -}}{{- end -}}
{{- if eq $action "activate" -}}{{- $icon = "ti ti-circle-arrow-up" -}}{{- $fallback = "^" -}}{{- if not $label -}}{{- $label = "Aktivieren" -}}{{- end -}}{{- $variant = "btn btn-success" -}}{{- end -}}
{{- if eq $action "deactivate" -}}{{- $icon = "ti ti-circle-arrow-down" -}}{{- $fallback = "v" -}}{{- if not $label -}}{{- $label = "Deaktivieren" -}}{{- end -}}{{- $variant = "btn btn-warning" -}}{{- end -}}
{{- if eq $action "done" -}}{{- $icon = "ti ti-check" -}}{{- $fallback = "OK" -}}{{- if not $label -}}{{- $label = "Erledigen" -}}{{- end -}}{{- $variant = "btn btn-success" -}}{{- end -}}
{{- if eq $action "cancel" -}}{{- $icon = "ti ti-x" -}}{{- $fallback = "X" -}}{{- if not $label -}}{{- $label = "Abbrechen" -}}{{- end -}}{{- $variant = "btn btn-danger" -}}{{- end -}}
{{- if eq $action "save" -}}{{- $icon = "ti ti-device-floppy" -}}{{- $fallback = "S" -}}{{- if not $label -}}{{- $label = "Speichern" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- if eq $action "back" -}}{{- $icon = "ti ti-arrow-left" -}}{{- $fallback = "<" -}}{{- if not $label -}}{{- $label = "Zurück" -}}{{- end -}}{{- end -}}
{{- if eq $action "send" -}}{{- $icon = "ti ti-send" -}}{{- $fallback = ">" -}}{{- if not $label -}}{{- $label = "Senden" -}}{{- end -}}{{- $variant = "btn btn-primary" -}}{{- end -}}
{{- $showInlineLabel := or .ShowLabel (eq $action "filter") -}}
{{- if .Href }}
<a href="{{.Href}}" {{if .ID}}id="{{.ID}}"{{end}} class="{{$variant}} btn-icon {{if $showInlineLabel}}btn-icon-labeled{{end}} {{.Class}}" style="{{css .Style}}" aria-label="{{$label}}" title="{{$label}}"
   {{if .OnClick}}onclick="{{safeJS .OnClick}}"{{else if .Confirm}}onclick="return confirm('{{.Confirm}}')"{{end}}
   {{if .HxGet}}hx-get="{{.HxGet}}"{{end}}
   {{if .HxPost}}hx-post="{{.HxPost}}"{{end}}
   {{if .HxPut}}hx-put="{{.HxPut}}"{{end}}
   {{if .HxDelete}}hx-delete="{{.HxDelete}}"{{end}}
   {{if .HxTarget}}hx-target="{{.HxTarget}}"{{end}}
   {{if .HxSwap}}hx-swap="{{.HxSwap}}"{{end}}
   {{if .HxTrigger}}hx-trigger="{{.HxTrigger}}"{{end}}
   {{if .HxVals}}hx-vals="{{.HxVals}}"{{end}}
   {{if .HxConfirm}}hx-confirm="{{.HxConfirm}}"{{end}}
   {{if .HxIndicator}}hx-indicator="{{.HxIndicator}}"{{end}}
   {{if .HxOnAfterRequest}}hx-on::after-request="{{safeJS .HxOnAfterRequest}}"{{end}}>
  <i class="{{$icon}}" aria-hidden="true"></i><span class="btn-icon-glyph" aria-hidden="true">{{$fallback}}</span>{{if $showInlineLabel}}<span class="btn-icon-label">{{$label}}</span>{{else}}<span class="sr-only">{{$label}}</span>{{end}}
</a>
{{- else }}
<button type="{{if .Type}}{{.Type}}{{else}}button{{end}}" {{if .ID}}id="{{.ID}}"{{end}} class="{{$variant}} btn-icon {{if $showInlineLabel}}btn-icon-labeled{{end}} {{.Class}}" style="{{css .Style}}" aria-label="{{$label}}" title="{{$label}}"
   {{if .Disabled}}disabled{{end}}
   {{if .OnClick}}onclick="{{safeJS .OnClick}}"{{else if .Confirm}}onclick="return confirm('{{.Confirm}}')"{{end}}
   {{if .HxGet}}hx-get="{{.HxGet}}"{{end}}
   {{if .HxPost}}hx-post="{{.HxPost}}"{{end}}
   {{if .HxPut}}hx-put="{{.HxPut}}"{{end}}
   {{if .HxDelete}}hx-delete="{{.HxDelete}}"{{end}}
   {{if .HxTarget}}hx-target="{{.HxTarget}}"{{end}}
   {{if .HxSwap}}hx-swap="{{.HxSwap}}"{{end}}
   {{if .HxTrigger}}hx-trigger="{{.HxTrigger}}"{{end}}
   {{if .HxVals}}hx-vals="{{.HxVals}}"{{end}}
   {{if .HxConfirm}}hx-confirm="{{.HxConfirm}}"{{end}}
   {{if .HxIndicator}}hx-indicator="{{.HxIndicator}}"{{end}}
   {{if .HxOnAfterRequest}}hx-on::after-request="{{safeJS .HxOnAfterRequest}}"{{end}}>
  <i class="{{$icon}}" aria-hidden="true"></i><span class="btn-icon-glyph" aria-hidden="true">{{$fallback}}</span>{{if $showInlineLabel}}<span class="btn-icon-label">{{$label}}</span>{{else}}<span class="sr-only">{{$label}}</span>{{end}}
</button>
{{- end }}
{{end}}

{{define "icon-button-toolbar"}}
<div class="widget-icon-toolbar {{.Class}}" style="{{css .Style}}" {{if .Label}}aria-label="{{.Label}}"{{end}}>
  {{range .Items}}{{template "icon-button" .}}{{end}}
</div>
{{end}}

{{define "button-new"}}{{template "action-button" .}}{{end}}
{{define "button-refresh"}}{{template "action-button" .}}{{end}}
{{define "button-edit"}}{{template "action-button" .}}{{end}}
{{define "button-copy"}}{{template "action-button" .}}{{end}}
{{define "button-delete"}}{{template "action-button" .}}{{end}}
{{define "button-delete-mark"}}{{template "action-button" .}}{{end}}
{{define "button-activate"}}{{template "action-button" .}}{{end}}
{{define "button-deactivate"}}{{template "action-button" .}}{{end}}
{{define "button-done"}}{{template "action-button" .}}{{end}}
{{define "button-cancel"}}{{template "action-button" .}}{{end}}
{{define "button-save"}}{{template "action-button" .}}{{end}}
{{define "icon-button-new"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-refresh"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-expand"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-filter"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-analyze"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-edit"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-view"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-copy"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-history"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-more"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-start"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-stop"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-book"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-delete"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-delete-mark"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-activate"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-deactivate"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-done"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-cancel"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-save"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-back"}}{{template "icon-button" .}}{{end}}
{{define "icon-button-send"}}{{template "icon-button" .}}{{end}}
