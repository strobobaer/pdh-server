{{template "base" .}}
{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Ersatzteillager</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Stats.Total}} Teile · Wert: {{.Stats.TotalValue}}€</p>
  </div>
  {{template "icon-button-toolbar" (dict "Class" "end" "Label" "Ersatzteil-Aktionen" "Items" (list (dict "Action" "book" "ShowLabel" true "OnClick" "openBookingModal()") (dict "Action" "history" "ShowLabel" true "Label" "Inventur" "OnClick" "openStocktakeModal()") (dict "Action" "edit" "ShowLabel" true "Label" "Feldsätze" "OnClick" "toggleFieldAdmin()") (dict "Action" "new" "ShowLabel" true "Label" "Neues Teil" "OnClick" "document.getElementById('new-part-form').style.display='block'")) )}}
</div>

<div class="stats" style="grid-template-columns:repeat(4,1fr)">
  <div class="stat s-blue"><div class="stat-label">Gesamt</div><div class="stat-val">{{.Stats.Total}}</div></div>
  <div class="stat s-amber"><div class="stat-label">Unter Mindest</div><div class="stat-val">{{.Stats.LowStock}}</div></div>
  <div class="stat s-red"><div class="stat-label">Kritisch</div><div class="stat-val">{{.Stats.Critical}}</div></div>
  <div class="stat s-green"><div class="stat-label">Lagerwert</div><div class="stat-val">{{.Stats.TotalValue}}€</div></div>
</div>

<div id="field-admin" class="card" style="display:none">
  <div class="card-title">Feldsätze und Stammdatenfelder</div>
  <p style="font-size:12px;color:var(--muted);margin-bottom:10px">Feldsatz anlegen, z.B. Motoren, und technische Felder zuordnen. Feldtyp „Auswahlliste“ erzeugt später am Teil ein Dropdown mit Plus-Button.</p>
  <form hx-post="/api/v1/inventory/field-sets" hx-on::after-request="if(event.detail.successful){this.reset();loadFieldSets();}">
    <div style="display:flex;gap:8px;align-items:end;margin-bottom:10px">
      <div class="form-group" style="flex:1"><label class="form-label">Feldsatz</label><input name="name" class="form-input" placeholder="Motoren" required></div>
      <div class="form-group" style="flex:2"><label class="form-label">Beschreibung</label><input name="description" class="form-input" placeholder="Technische Motordaten"></div>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Feldsatz anlegen")}}
    </div>
  </form>
  <div style="display:flex;gap:8px;align-items:end;margin-bottom:10px">
    <div class="form-group" style="flex:1"><label class="form-label">Aktiver Feldsatz</label><select id="admin-field-set" class="form-input" onchange="loadFieldsForSelectedSet()"></select></div>
    <div class="form-group" style="flex:1"><label class="form-label">Feldname</label><input id="admin-field-name" class="form-input" placeholder="Spannung"></div>
    <div class="form-group" style="width:170px"><label class="form-label">Typ</label><select id="admin-field-type" class="form-input"><option value="text">Text</option><option value="number">Zahl</option><option value="date">Datum</option><option value="select">Auswahlliste</option></select></div>
    <div class="form-group" style="width:110px"><label class="form-label">Sortierung</label><input id="admin-field-order" type="number" class="form-input" value="100"></div>
    <button type="button" class="btn" onclick="createFieldInSelectedSet()"><i class="ti ti-plus"></i> Feld</button>
  </div>
  <div id="field-set-list" style="font-size:12px;color:var(--muted)"></div>
  <div id="field-def-list" style="margin-top:10px;font-size:12px;color:var(--muted)"></div>
</div>

<div id="booking-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:5000;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:480px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4);max-height:85vh;overflow-y:auto">
    <div style="font-size:15px;font-weight:600;margin-bottom:14px">Buchung</div>
    <div class="form-group">
      <label class="form-label">Buchungsart</label>
      <select id="book-type" class="form-input" onchange="onBookTypeChange()">
        <option value="in">Wareneingang</option>
        <option value="out">Warenausgang</option>
        <option value="correction">Korrekturbuchung</option>
        <option value="inventory">Inventurbuchung</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Ersatzteil</label>
      <input id="book-part-search" class="form-input" placeholder="Suchen (Name, Teilenummer)..." oninput="filterBookPartOptions()" autocomplete="off">
      <select id="book-part-id" class="form-input" style="margin-top:6px" onchange="onBookPartOrLocationChange()" size="6"></select>
    </div>
    <div class="form-group">
      <label class="form-label">Lagerort</label>
      <div id="book-storage-tree" style="max-height:180px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:8px;font-size:12px">Lade Lagerbaum...</div>
      <input type="hidden" id="book-storage-node-id">
      <div id="book-storage-selected" style="font-size:11px;color:var(--muted);margin-top:4px">Kein Lagerort ausgewählt</div>
    </div>
    <div class="form-group">
      <label class="form-label" id="book-qty-label">Stückzahl</label>
      <input id="book-qty" type="number" step="0.001" class="form-input" value="0">
    </div>
    <div id="book-current-stock" style="font-size:12px;color:var(--muted);margin-bottom:10px">Aktueller Bestand: –</div>
    <div class="form-group">
      <label class="form-label">Referenz / Notiz <span style="color:var(--muted)">(optional)</span></label>
      <input id="book-notes" class="form-input" placeholder="z.B. Lieferschein-Nr., Grund der Korrektur">
    </div>
    <div id="book-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:10px"></div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button type="button" class="btn" style="color:var(--red);border-color:rgba(239,68,68,.4)" onclick="closeBookingModal()" title="Abbrechen"><i class="ti ti-x"></i></button>
      <button type="button" class="btn btn-primary" style="background:var(--green);border-color:var(--green)" onclick="submitBooking()" title="Buchen"><i class="ti ti-check"></i></button>
    </div>
  </div>
</div>

<div id="image-search-panel" class="card" style="display:none;position:fixed;right:24px;top:92px;width:460px;max-height:70vh;overflow:auto;z-index:5001;box-shadow:0 18px 48px rgba(0,0,0,.35)">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px"><div class="card-title" style="margin:0">Teilebild suchen</div>{{template "icon-button" (dict "Action" "cancel" "OnClick" "closeImageSearch()")}}</div>
  <div id="image-search-content" style="font-size:12px;color:var(--muted)"></div>
</div>

<div id="new-part-form" style="display:none" class="card">
  <div class="card-title">Teil anlegen</div>
  <form hx-post="/api/v1/inventory" onsubmit="embedImageUrlIntoDescription(this)" hx-on::after-request="if(event.detail.successful) location.reload()">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Teilenummer</label><div style="display:flex;gap:6px"><input id="new-part-number" name="part_number" class="form-input" required><input id="barcode-new-part-number" type="file" accept="image/*" capture="environment" style="display:none" onchange="scanBarcodeIntoInput(this,'new-part-number')"><button type="button" class="btn" onclick="document.getElementById('barcode-new-part-number').click()"><i class="ti ti-barcode"></i></button></div></div>
      <div class="form-group"><label class="form-label">Name</label><input id="new-part-name" name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Hersteller</label><input id="new-part-manufacturer" name="manufacturer" class="form-input"></div>
      <div class="form-group"><label class="form-label">Kategorie</label><input name="category" class="form-input"></div>
      <div class="form-group"><label class="form-label">Einheit</label><input name="unit" class="form-input" value="Stück"></div>
      <div class="form-group"><label class="form-label">Preis</label><input name="price" type="number" step="0.01" class="form-input" value="0"></div>
      <div class="form-group"><label class="form-label">Mindestbestand</label><input name="min_qty" type="number" step="0.001" class="form-input" value="1"></div>
      <div class="form-group"><label class="form-label">Kritischer Bestand</label><input name="critical_qty" type="number" step="0.001" class="form-input" value="0"></div>
      <div class="form-group"><label class="form-label">Bestellmenge</label><input name="reorder_qty" type="number" step="0.001" class="form-input" value="5"></div>
      <div class="form-group" style="grid-column:1/-1;font-size:11px;color:var(--muted)">Bestand wird über "Buchung" (Wareneingang) an einem Lagerort hinzugefügt, nicht hier beim Anlegen.</div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Teilebild URL</label><div style="display:flex;gap:6px"><input data-image-url="1" class="form-input" placeholder="https://...jpg/png/webp" oninput="previewImageUrl(this)"><button type="button" class="btn" onclick="openImageSearch(this.form)"><i class="ti ti-search"></i> Suchen</button></div><div class="image-preview" style="margin-top:6px"></div></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><input name="description" class="form-input"></div>
    </div>
    {{template "icon-button-toolbar" (dict "Class" "end" "Label" "Formularaktionen" "Style" "width:100%;justify-content:flex-end" "Items" (list (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-part-form').style.display='none'") (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Anlegen")) )}}
  </form>
</div>

<div id="parts-table" class="card" style="padding:0">
  <table>
    <thead><tr><th>Teil</th><th>Bestand</th><th>Status</th><th></th></tr></thead>
    <tbody>
    {{range .Parts}}
    <tr data-part-row="{{.ID}}" data-description="">
      <td><div style="display:flex;gap:8px;align-items:center"><div id="thumb-{{.ID}}" style="width:42px;height:42px;border-radius:8px;background:var(--bg3);display:none;overflow:hidden;align-items:center;justify-content:center;flex-shrink:0"></div><div><div style="font-weight:500">{{.Name}}</div><div style="font-size:11px;color:var(--muted)">{{.PartNumber}} · {{.Manufacturer}}</div></div></div></td>
      <td><div style="font-weight:500">{{.StockQty}} {{.Unit}}</div><div style="font-size:10px;color:var(--muted)">Min: {{.MinQty}}</div></td>
      <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td style="white-space:nowrap">{{template "icon-button" (dict "Action" "edit" "OnClick" (printf "togglePartEdit('%s')" .ID))}}{{template "icon-button" (dict "Action" "history" "HxGet" (printf "/inventory/%s/movements" .ID) "HxTarget" (printf "#movements-%s" .ID) "HxSwap" "innerHTML")}}</td>
    </tr>
    <tr id="edit-{{.ID}}" style="display:none"><td colspan="4" style="background:var(--bg3);padding:14px">
      <form hx-post="/api/v1/inventory/{{.ID}}" onsubmit="embedImageUrlIntoDescription(this)" hx-on::after-request="if(event.detail.successful) location.reload()">
        <div class="grid2">
          <div class="form-group"><label class="form-label">Teilenummer</label><div style="display:flex;gap:6px"><input id="part-number-{{.ID}}" name="part_number" class="form-input" value="{{.PartNumber}}" required><input id="barcode-part-number-{{.ID}}" type="file" accept="image/*" capture="environment" style="display:none" onchange="scanBarcodeIntoInput(this,'part-number-{{.ID}}')"><button type="button" class="btn" onclick="document.getElementById('barcode-part-number-{{.ID}}').click()"><i class="ti ti-barcode"></i></button></div></div>
          <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" value="{{.Name}}" required></div>
          <div class="form-group"><label class="form-label">Hersteller</label><input name="manufacturer" class="form-input" value="{{.Manufacturer}}"></div>
          <div class="form-group"><label class="form-label">Kategorie</label><input name="category" class="form-input" value="{{.Category}}"></div>
          <div class="form-group"><label class="form-label">Einheit</label><input name="unit" class="form-input" value="{{.Unit}}"></div>
          <div class="form-group"><label class="form-label">Mindestbestand</label><input name="min_qty" type="number" step="0.001" class="form-input" value="{{.MinQty}}"></div>
          <div class="form-group"><label class="form-label">Preis</label><input name="price" type="number" step="0.01" class="form-input" value="{{.Price}}"></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Feldsätze</label><div id="field-sets-{{.ID}}" data-field-set-box="{{.ID}}" style="display:flex;gap:8px;flex-wrap:wrap;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--bg)">Lade Feldsätze...</div></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Teilebild URL</label><div style="display:flex;gap:6px"><input data-image-url="1" class="form-input" placeholder="https://...jpg/png/webp" oninput="previewImageUrl(this)"><button type="button" class="btn" onclick="openImageSearch(this.form)"><i class="ti ti-search"></i> Suchen</button></div><div class="image-preview" style="margin-top:6px"></div></div>
          <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><input name="description" class="form-input"></div>
        </div>
        <div id="custom-fields-{{.ID}}" data-part-id="{{.ID}}" style="margin-top:10px"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px">
          {{template "icon-button" (dict "Action" "edit" "ShowLabel" true "Label" "Felder neu laden" "OnClick" (printf "loadPartFields('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Label" "Stammfelder speichern" "OnClick" (printf "savePartFields('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "cancel" "ShowLabel" true "OnClick" (printf "togglePartEdit('%s')" .ID))}}
          {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Teil speichern")}}
        </div>
      </form>
    </td></tr>
    <tr id="movements-{{.ID}}" style="display:none"><td colspan="4"></td></tr>
    {{else}}<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:24px">Keine Teile vorhanden</td></tr>{{end}}
    </tbody>
  </table>
</div>
<div id="stocktake-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:6000;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;width:100%;max-width:640px;margin:20px;box-shadow:0 20px 60px rgba(0,0,0,.4);max-height:90vh;overflow-y:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <div style="font-size:15px;font-weight:600" id="stocktake-title">Inventur</div>
      <button type="button" class="btn" style="padding:4px 8px" onclick="closeStocktakeModal()"><i class="ti ti-x"></i></button>
    </div>

    <div id="stocktake-view-list">
      <div id="stocktake-open-sessions" style="margin-bottom:16px"></div>
      <div style="border-top:1px solid var(--border);padding-top:14px">
        <div style="font-size:13px;font-weight:600;margin-bottom:10px">Neue Inventur starten</div>
        <div class="form-group">
          <label class="form-label">Von (Lagerort)</label>
          <div id="stocktake-tree-from" style="max-height:160px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:8px;font-size:12px">Lade Lagerbaum...</div>
          <div id="stocktake-from-selected" style="font-size:11px;color:var(--muted);margin-top:4px">Nicht ausgewählt</div>
        </div>
        <div class="form-group">
          <label class="form-label">Bis (Lagerort, gleicher übergeordneter Ort)</label>
          <div id="stocktake-tree-to" style="max-height:160px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:8px;font-size:12px">Lade Lagerbaum...</div>
          <div id="stocktake-to-selected" style="font-size:11px;color:var(--muted);margin-top:4px">Nicht ausgewählt</div>
        </div>
        <div id="stocktake-start-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:10px"></div>
        <div style="display:flex;justify-content:flex-end">
          <button type="button" class="btn btn-primary" onclick="startStocktake()"><i class="ti ti-list-check"></i> Zählliste erstellen</button>
        </div>
      </div>
    </div>

    <div id="stocktake-view-count" style="display:none">
      <div style="font-size:12px;color:var(--muted);margin-bottom:10px" id="stocktake-count-range"></div>
      <div id="stocktake-items" style="max-height:50vh;overflow-y:auto;margin-bottom:12px"></div>
      <div id="stocktake-count-error" style="display:none;color:var(--red);font-size:12px;padding:8px;background:rgba(239,68,68,.1);border-radius:6px;margin-bottom:10px"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button type="button" class="btn" style="color:var(--red);border-color:rgba(239,68,68,.4)" onclick="cancelStocktake()"><i class="ti ti-trash"></i> Abbrechen</button>
        <button type="button" class="btn" onclick="saveStocktakeCounts(false)"><i class="ti ti-device-floppy"></i> Zwischenspeichern</button>
        <button type="button" class="btn btn-primary" style="background:var(--green);border-color:var(--green)" onclick="saveStocktakeCounts(true)"><i class="ti ti-check"></i> Inventur buchen</button>
      </div>
    </div>
  </div>
</div>
{{end}}

{{define "context-list"}}{{range .LowStockParts}}<div class="act-item"><div class="act-dot {{.StatusDot}}"></div><div class="act-text">{{.Name}}</div><span style="font-size:11px;color:var(--muted)">{{.StockQty}}</span></div>{{end}}{{end}}

{{block "scripts" .}}
<script>
let fieldSetsCache=null;
async function apiData(url,options){const res=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));let payload=null;try{payload=await res.json();}catch(e){throw new Error('Keine JSON-Antwort von '+url);}if(!res.ok||payload.success===false)throw new Error(payload.error||payload.message||('HTTP '+res.status));return Array.isArray(payload)?payload:(payload.data!==undefined?payload.data:payload);}
function toggleFieldAdmin(){const el=document.getElementById('field-admin');el.style.display=el.style.display==='none'?'block':'none';if(el.style.display==='block')loadFieldSets();}
function togglePartEdit(id){const el=document.getElementById('edit-'+id);el.style.display=el.style.display==='none'?'table-row':'none';if(el.style.display==='table-row'){loadPartDetails(id);initImageFields(el);loadFieldSetCheckboxes(id).then(()=>loadPartFields(id));}}
let bookPartsCache=null;let bookStorageTreeCache=null;
function openBookingModal(){document.getElementById('booking-modal').style.display='flex';loadBookParts();loadBookStorageTree();onBookTypeChange();}
function closeBookingModal(){document.getElementById('booking-modal').style.display='none';document.getElementById('book-error').style.display='none';}
function onBookTypeChange(){const type=document.getElementById('book-type').value;const label=document.getElementById('book-qty-label');if(type==='in')label.textContent='Menge (Zugang)';else if(type==='out')label.textContent='Menge (Abgang)';else if(type==='correction')label.textContent='Neuer Bestand (Korrektur)';else label.textContent='Gezählte Menge (Inventur)';}
async function loadBookParts(){if(bookPartsCache){renderBookPartOptions(bookPartsCache);return;}try{bookPartsCache=await apiData('/api/v1/inventory/');renderBookPartOptions(bookPartsCache);}catch(e){console.warn(e);}}
function renderBookPartOptions(parts){const sel=document.getElementById('book-part-id');sel.innerHTML=parts.map(p=>`<option value="${p.id}">${escapeHtml(p.name)} (${escapeHtml(p.part_number)})</option>`).join('');onBookPartOrLocationChange();}
function filterBookPartOptions(){const q=document.getElementById('book-part-search').value.toLowerCase();const sel=document.getElementById('book-part-id');[...sel.options].forEach(o=>{o.style.display=o.textContent.toLowerCase().includes(q)?'':'none';});}
async function loadBookStorageTree(){const root=document.getElementById('book-storage-tree');try{if(!bookStorageTreeCache){bookStorageTreeCache=await apiData('/api/v1/storage/');}root.innerHTML=renderBookStorageNodes(bookStorageTreeCache)||'<div style="color:var(--muted)">Keine Lagerorte vorhanden</div>';}catch(e){root.innerHTML='<div style="color:var(--red)">Lagerbaum konnte nicht geladen werden: '+escapeHtml(e.message)+'</div>';}}
function renderBookStorageNodes(nodes,depth){depth=depth||0;if(!Array.isArray(nodes)||nodes.length===0)return '';return nodes.map(n=>`<div style="margin-left:${depth*12}px"><div style="padding:3px 4px;cursor:pointer;border-radius:4px" onclick="selectBookStorage('${n.id}','${escapeJs(n.name)}')" onmouseover="this.style.background='var(--bg3)'" onmouseout="this.style.background=''">${escapeHtml(n.name)} <span style="color:var(--muted);font-size:10px">(${escapeHtml(n.type)})</span></div>${n.children&&n.children.length?renderBookStorageNodes(n.children,depth+1):''}</div>`).join('');}
function selectBookStorage(id,name){document.getElementById('book-storage-node-id').value=id;document.getElementById('book-storage-selected').textContent='Ausgewählt: '+name;onBookPartOrLocationChange();}
async function onBookPartOrLocationChange(){const partId=document.getElementById('book-part-id').value;const nodeId=document.getElementById('book-storage-node-id').value;const stockEl=document.getElementById('book-current-stock');if(!partId||!nodeId){stockEl.textContent='Aktueller Bestand: –';return;}try{const data=await apiData('/api/v1/inventory/'+partId+'/stock/'+nodeId);stockEl.textContent='Aktueller Bestand an diesem Lagerort: '+data.qty;}catch(e){stockEl.textContent='Aktueller Bestand: konnte nicht geladen werden';}}
async function submitBooking(){const errEl=document.getElementById('book-error');errEl.style.display='none';const partId=document.getElementById('book-part-id').value;const nodeId=document.getElementById('book-storage-node-id').value;const type=document.getElementById('book-type').value;const qty=parseFloat(document.getElementById('book-qty').value)||0;const notes=document.getElementById('book-notes').value;if(!partId){errEl.textContent='Bitte ein Ersatzteil auswählen';errEl.style.display='block';return;}if(!nodeId){errEl.textContent='Bitte einen Lagerort auswählen';errEl.style.display='block';return;}try{const headers={'Content-Type':'application/json'};if(typeof pdhToken==='function'){headers['Authorization']='Bearer '+pdhToken();}const res=await fetch('/api/v1/inventory/book',{method:'POST',headers:headers,credentials:'same-origin',body:JSON.stringify({part_id:partId,type:type,qty:qty,storage_node_id:nodeId,notes:notes})});const json=await res.json();if(!res.ok||json.success===false)throw new Error((json&&json.error)||'Fehler bei der Buchung');closeBookingModal();location.reload();}catch(e){errEl.textContent='Fehler: '+e.message;errEl.style.display='block';}}
async function loadPartDetails(id){try{const p=await apiData('/api/v1/inventory/'+id);const row=document.querySelector('[data-part-row="'+id+'"]');if(row)row.dataset.description=p.description||'';const edit=document.getElementById('edit-'+id);const desc=edit?.querySelector('[name="description"]');if(desc&&!desc.value)desc.value=p.description||'';initImageFields(edit);}catch(e){console.warn(e);}}
async function loadFieldSets(){try{fieldSetsCache=await apiData('/api/v1/inventory/field-sets');const sel=document.getElementById('admin-field-set');sel.innerHTML=fieldSetsCache.map(s=>`<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');document.getElementById('field-set-list').innerHTML=fieldSetsCache.length?fieldSetsCache.map(s=>`<span class="badge b-blue" style="margin-right:4px">${escapeHtml(s.name)}</span>`).join(''):'Noch keine Feldsätze angelegt';loadFieldsForSelectedSet();}catch(e){document.getElementById('field-set-list').innerHTML='<span style="color:var(--red)">'+escapeHtml(e.message)+'</span>';}}
async function loadFieldsForSelectedSet(){const sel=document.getElementById('admin-field-set');const list=document.getElementById('field-def-list');if(!sel||!sel.value){list.innerHTML='Kein Feldsatz ausgewählt';return;}try{const fields=await apiData('/api/v1/inventory/field-sets/'+sel.value+'/fields');list.innerHTML=fields.length?fields.map(f=>`<span class="badge b-green" style="margin-right:4px">${escapeHtml(f.name)} · ${escapeHtml(f.field_type)}</span>`).join(''):'Dieser Feldsatz hat noch keine Felder';}catch(e){list.innerHTML='<span style="color:var(--red)">'+escapeHtml(e.message)+'</span>';}}
async function createFieldInSelectedSet(){const set=document.getElementById('admin-field-set').value;if(!set){alert('Bitte Feldsatz anlegen/auswählen');return;}const body=new URLSearchParams();body.set('name',document.getElementById('admin-field-name').value);body.set('field_type',document.getElementById('admin-field-type').value);body.set('sort_order',document.getElementById('admin-field-order').value||'100');await fetch('/api/v1/inventory/field-sets/'+set+'/fields',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});document.getElementById('admin-field-name').value='';loadFieldsForSelectedSet();}
async function loadFieldSetCheckboxes(id){if(!fieldSetsCache)fieldSetsCache=await apiData('/api/v1/inventory/field-sets');const box=document.getElementById('field-sets-'+id);if(!box)return;let assigned=[];try{const a=await apiData('/api/v1/inventory/'+id+'/field-sets');assigned=a.field_set_ids||[];}catch(e){try{const a=await apiData('/api/v1/inventory/'+id+'/field-set');assigned=a.field_set_id?[a.field_set_id]:[];}catch(_){assigned=[];}}box.innerHTML=fieldSetsCache.length?fieldSetsCache.map(s=>`<label class="badge b-blue" style="cursor:pointer;margin-right:4px"><input type="checkbox" data-field-set-id="${s.id}" ${assigned.includes(s.id)?'checked':''} onchange="assignFieldSets('${id}')"> ${escapeHtml(s.name)}</label>`).join(''):'Keine Feldsätze angelegt';}
async function assignFieldSets(id){const box=document.getElementById('field-sets-'+id);const ids=[...box.querySelectorAll('[data-field-set-id]:checked')].map(i=>i.dataset.fieldSetId);await apiData('/api/v1/inventory/'+id+'/field-sets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({field_set_ids:ids})});loadPartFields(id);}
async function loadPartFields(id){const box=document.getElementById('custom-fields-'+id);box.innerHTML='Lade Feldsatzfelder...';try{const fields=await apiData('/api/v1/inventory/'+id+'/fields-assigned');box.innerHTML=fields.length?`<div class="grid2">${fields.map(f=>renderCustomFieldInput(id,f)).join('')}</div>`:'<div style="color:var(--muted);font-size:12px">Keine Feldsätze ausgewählt oder keine Felder in den Feldsätzen.</div>';}catch(e){box.innerHTML='<span style="color:var(--red)">Felder konnten nicht geladen werden: '+escapeHtml(e.message)+'</span>';}}
function renderCustomFieldInput(partId,f){const type=(f.field_type||'text').toLowerCase();if(type==='select'||type==='list'||type==='choice'){const opts=(f.options||[]).map(o=>`<option value="${escapeHtml(o.value)}" ${o.value===f.value?'selected':''}>${escapeHtml(o.value)}</option>`).join('');return `<div class="form-group"><label class="form-label">${escapeHtml(f.name)}</label><div style="display:flex;gap:6px"><select data-field-id="${f.field_id}" data-field-type="select" class="form-input custom-field-input"><option value="">-- wählen --</option>${opts}</select><button type="button" class="btn" onclick="addFieldOption('${partId}','${f.field_id}')"><i class="ti ti-plus"></i></button></div></div>`;}const inputType=type==='number'?'number':(type==='date'?'date':'text');return `<div class="form-group"><label class="form-label">${escapeHtml(f.name)}</label><input type="${inputType}" data-field-id="${f.field_id}" class="form-input custom-field-input" value="${escapeHtml(f.value||'')}"></div>`;}
async function addFieldOption(partId,fieldId){const value=prompt('Neuen Auswahlwert eingeben:');if(!value||!value.trim())return;const body=new URLSearchParams();body.set('value',value.trim());body.set('sort_order','100');try{await fetch('/api/v1/inventory/fields/'+fieldId+'/options',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});await loadPartFields(partId);const sel=document.querySelector(`#custom-fields-${partId} [data-field-id="${fieldId}"]`);if(sel)sel.value=value.trim();}catch(e){alert('Auswahlwert konnte nicht angelegt werden: '+e.message);}}
async function savePartFields(id){const box=document.getElementById('custom-fields-'+id);const values={};box.querySelectorAll('.custom-field-input').forEach(i=>values[i.dataset.fieldId]=i.value);try{await apiData('/api/v1/inventory/'+id+'/fields',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values})});alert('Stammfelder gespeichert');}catch(e){alert('Stammfelder konnten nicht gespeichert werden: '+e.message);}}
function imageUrlFromDescription(desc){const m=String(desc||'').match(/(?:^|\n)PDH_IMAGE_URL:\s*(\S+)/);return m?m[1]:'';}function cleanImageUrlFromDescription(desc){return String(desc||'').replace(/(?:^|\n)PDH_IMAGE_URL:\s*\S+\s*/g,'').trim();}function embedImageUrlIntoDescription(form){const input=form.querySelector('[data-image-url]');const desc=form.querySelector('[name="description"]');if(!input||!desc)return true;const clean=cleanImageUrlFromDescription(desc.value);const url=input.value.trim();desc.value=url?(clean?clean+'\n':'')+'PDH_IMAGE_URL: '+url:clean;return true;}function initImageFields(root=document){if(!root)return;root.querySelectorAll('form').forEach(form=>{const img=form.querySelector('[data-image-url]');const desc=form.querySelector('[name="description"]');if(img&&desc){img.value=imageUrlFromDescription(desc.value);desc.value=cleanImageUrlFromDescription(desc.value);previewImageUrl(img);}});}function previewImageUrl(input){const box=input.closest('.form-group')?.querySelector('.image-preview');if(!box)return;const url=input.value.trim();box.innerHTML=url?`<img src="${escapeHtml(url)}" style="max-height:90px;max-width:180px;border-radius:8px;border:1px solid var(--border);object-fit:contain" onerror="this.replaceWith(document.createTextNode('Bild konnte nicht geladen werden'))">`:'';}function openImageSearch(form){const part=form.querySelector('[name="part_number"]')?.value||'';const name=form.querySelector('[name="name"]')?.value||'';const manufacturer=form.querySelector('[name="manufacturer"]')?.value||'';const q=[manufacturer,part,name].filter(Boolean).join(' ').trim()||'Ersatzteil';const enc=encodeURIComponent(q);const panel=document.getElementById('image-search-panel');const content=document.getElementById('image-search-content');panel.style.display='block';content.innerHTML=`<div style="margin-bottom:10px;color:var(--fg)">Suchbegriff: <b>${escapeHtml(q)}</b></div><div style="display:grid;gap:6px"><a class="btn" target="_blank" rel="noopener" href="https://www.google.com/search?tbm=isch&q=${enc}">Google Bilder öffnen</a><a class="btn" target="_blank" rel="noopener" href="https://www.bing.com/images/search?q=${enc}">Bing Bilder öffnen</a><a class="btn" target="_blank" rel="noopener" href="https://duckduckgo.com/?iax=images&ia=images&q=${enc}">DuckDuckGo Bilder öffnen</a></div>`;}function closeImageSearch(){document.getElementById('image-search-panel').style.display='none';}
async function scanBarcodeIntoInput(fileInput,targetInputId){const target=document.getElementById(targetInputId);if(!target||!fileInput.files||fileInput.files.length===0)return;if(!('BarcodeDetector'in window)){alert('Barcode-Erkennung wird von diesem Browser nicht unterstützt.');fileInput.value='';return;}try{const bitmap=await createImageBitmap(fileInput.files[0]);const formats=await BarcodeDetector.getSupportedFormats();const detector=new BarcodeDetector({formats:formats&&formats.length?formats:undefined});const codes=await detector.detect(bitmap);if(!codes||codes.length===0){alert('Kein Barcode erkannt.');return;}target.value=codes[0].rawValue||'';target.dispatchEvent(new Event('input',{bubbles:true}));target.focus();}catch(e){alert('Barcode konnte nicht erkannt werden: '+e.message);}finally{fileInput.value='';}}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}function escapeJs(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'");}
let stocktakeTreeCache=null;
let stocktakeFromId=null, stocktakeToId=null;
let currentStocktakeSessionID=null;

function openStocktakeModal(){document.getElementById('stocktake-modal').style.display='flex';showStocktakeListView();loadOpenStocktakes();loadStocktakeTrees();}
function closeStocktakeModal(){document.getElementById('stocktake-modal').style.display='none';}
function showStocktakeListView(){document.getElementById('stocktake-view-list').style.display='block';document.getElementById('stocktake-view-count').style.display='none';document.getElementById('stocktake-title').textContent='Inventur';}
function showStocktakeCountView(){document.getElementById('stocktake-view-list').style.display='none';document.getElementById('stocktake-view-count').style.display='block';document.getElementById('stocktake-title').textContent='Zählliste';}

async function loadOpenStocktakes(){
  const box=document.getElementById('stocktake-open-sessions');
  try{
    const sessions=await apiData('/api/v1/inventory/stocktake/open');
    if(!sessions||sessions.length===0){box.innerHTML='<div style="font-size:12px;color:var(--muted)">Keine laufende Inventur</div>';return;}
    box.innerHTML='<div style="font-size:13px;font-weight:600;margin-bottom:8px">Laufende Inventuren</div>'+sessions.map(s=>`
      <div class="li" style="cursor:pointer" onclick="openStocktakeSession('${s.id}')">
        <div class="li-text"><div class="li-title">${escapeHtml(s.from_name)} – ${escapeHtml(s.to_name)}</div><div class="li-sub">gestartet ${new Date(s.created_at).toLocaleString()}</div></div>
        <span class="badge b-amber">offen</span>
      </div>`).join('');
  }catch(e){box.innerHTML='<div style="color:var(--red);font-size:12px">'+escapeHtml(e.message)+'</div>';}
}

async function loadStocktakeTrees(){
  if(!stocktakeTreeCache){try{stocktakeTreeCache=await apiData('/api/v1/storage/');}catch(e){console.warn(e);return;}}
  document.getElementById('stocktake-tree-from').innerHTML=renderStocktakeTree(stocktakeTreeCache,'from')||'<div style="color:var(--muted)">Keine Lagerorte vorhanden</div>';
  document.getElementById('stocktake-tree-to').innerHTML=renderStocktakeTree(stocktakeTreeCache,'to')||'<div style="color:var(--muted)">Keine Lagerorte vorhanden</div>';
}
function renderStocktakeTree(nodes,which,depth){
  depth=depth||0;
  if(!Array.isArray(nodes)||nodes.length===0)return '';
  return nodes.map(n=>`<div style="margin-left:${depth*12}px">
    <div style="padding:3px 4px;cursor:pointer;border-radius:4px" onclick="selectStocktakeNode('${which}','${n.id}','${escapeJs(n.name)}')" onmouseover="this.style.background='var(--bg3)'" onmouseout="this.style.background=''">
      ${escapeHtml(n.name)} <span style="color:var(--muted);font-size:10px">(${escapeHtml(n.type)})</span>
    </div>
    ${n.children&&n.children.length?renderStocktakeTree(n.children,which,depth+1):''}
  </div>`).join('');
}
function selectStocktakeNode(which,id,name){
  if(which==='from'){stocktakeFromId=id;document.getElementById('stocktake-from-selected').textContent='Ausgewählt: '+name;}
  else{stocktakeToId=id;document.getElementById('stocktake-to-selected').textContent='Ausgewählt: '+name;}
}

async function startStocktake(){
  const errEl=document.getElementById('stocktake-start-error');
  errEl.style.display='none';
  if(!stocktakeFromId||!stocktakeToId){errEl.textContent='Bitte "Von" und "Bis" auswählen';errEl.style.display='block';return;}
  try{
    const headers={'Content-Type':'application/json'};
    if(typeof pdhToken==='function'){headers['Authorization']='Bearer '+pdhToken();}
    const res=await fetch('/api/v1/inventory/stocktake',{method:'POST',headers:headers,credentials:'same-origin',body:JSON.stringify({from_node_id:stocktakeFromId,to_node_id:stocktakeToId})});
    const json=await res.json();
    if(!res.ok||json.success===false)throw new Error((json&&json.error)||'Fehler beim Erstellen der Zählliste');
    currentStocktakeSessionID=json.data.session.id;
    renderStocktakeItems(json.data.items,json.data.session);
    showStocktakeCountView();
  }catch(e){errEl.textContent='Fehler: '+e.message;errEl.style.display='block';}
}

async function openStocktakeSession(sessionId){
  try{
    const data=await apiData('/api/v1/inventory/stocktake/'+sessionId);
    currentStocktakeSessionID=sessionId;
    renderStocktakeItems(data.items,data.session);
    showStocktakeCountView();
  }catch(e){alert('Sitzung konnte nicht geladen werden: '+e.message);}
}

function renderStocktakeItems(items,session){
  document.getElementById('stocktake-count-range').textContent='Bereich: '+session.from_name+' – '+session.to_name;
  const box=document.getElementById('stocktake-items');
  if(!items||items.length===0){box.innerHTML='<div style="color:var(--muted);font-size:12px">Keine Positionen</div>';return;}
  box.innerHTML=items.map(it=>{
    const isPlaceholder=!it.part_id;
    const label=isPlaceholder?'<span style="color:var(--muted);font-style:italic">Leerer Platz</span>':escapeHtml(it.part_name)+' ('+escapeHtml(it.part_number)+')';
    const countedVal=(it.counted_qty!==undefined&&it.counted_qty!==null)?it.counted_qty:'';
    return `<div class="li" style="flex-direction:column;align-items:stretch;gap:6px" data-item-id="${it.id}">
      <div style="display:flex;gap:8px;align-items:center">
        <div style="flex:1">
          <div style="font-size:12px;color:var(--accent)">${escapeHtml(it.storage_name)}</div>
          <div style="font-size:13px;font-weight:500">${label}</div>
        </div>
        <div style="font-size:11px;color:var(--muted)">Soll: ${it.expected_qty}</div>
      </div>
      ${isPlaceholder?'<input type="text" class="form-input stocktake-part-search" placeholder="Teil suchen falls hier etwas gefunden wurde..." style="font-size:12px" oninput="filterStocktakePartOptions(this)"><select class="form-input stocktake-part-select" style="font-size:12px"><option value="">– kein Teil zugewiesen –</option></select>':''}
      <input type="number" step="0.001" class="form-input stocktake-qty-input" placeholder="Ist-Menge" value="${countedVal}">
    </div>`;
  }).join('');
  if(items.some(it=>!it.part_id)){populateStocktakePartSelects();}
}

async function populateStocktakePartSelects(){
  if(!bookPartsCache){try{bookPartsCache=await apiData('/api/v1/inventory/');}catch(e){return;}}
  document.querySelectorAll('.stocktake-part-select').forEach(sel=>{
    sel.innerHTML='<option value="">– kein Teil zugewiesen –</option>'+bookPartsCache.map(p=>`<option value="${p.id}">${escapeHtml(p.name)} (${escapeHtml(p.part_number)})</option>`).join('');
  });
}
function filterStocktakePartOptions(input){
  const q=input.value.toLowerCase();
  const sel=input.parentElement.querySelector('.stocktake-part-select');
  if(!sel)return;
  [...sel.options].forEach(o=>{o.style.display=(!o.value||o.textContent.toLowerCase().includes(q))?'':'none';});
}

async function saveStocktakeCounts(thenBook){
  const errEl=document.getElementById('stocktake-count-error');
  errEl.style.display='none';
  const rows=[...document.querySelectorAll('#stocktake-items [data-item-id]')];
  const items=rows.map(row=>{
    const itemId=row.dataset.itemId;
    const qtyInput=row.querySelector('.stocktake-qty-input');
    const partSelect=row.querySelector('.stocktake-part-select');
    const qtyVal=qtyInput.value.trim();
    const entry={item_id:itemId,counted_qty:qtyVal===''?null:parseFloat(qtyVal)};
    if(partSelect&&partSelect.value){entry.part_id=partSelect.value;}
    return entry;
  });
  try{
    const headers={'Content-Type':'application/json'};
    if(typeof pdhToken==='function'){headers['Authorization']='Bearer '+pdhToken();}
    let res=await fetch('/api/v1/inventory/stocktake/'+currentStocktakeSessionID+'/count',{method:'POST',headers:headers,credentials:'same-origin',body:JSON.stringify({items:items})});
    let json=await res.json();
    if(!res.ok||json.success===false)throw new Error((json&&json.error)||'Fehler beim Speichern');
    if(thenBook){
      res=await fetch('/api/v1/inventory/stocktake/'+currentStocktakeSessionID+'/book',{method:'POST',headers:headers,credentials:'same-origin'});
      json=await res.json();
      if(!res.ok||json.success===false)throw new Error((json&&json.error)||'Fehler beim Buchen');
      closeStocktakeModal();
      location.reload();
    }else{
      alert('Zählung gespeichert');
    }
  }catch(e){errEl.textContent='Fehler: '+e.message;errEl.style.display='block';}
}

async function cancelStocktake(){
  if(!confirm('Inventur wirklich abbrechen? Die Sperre wird aufgehoben, es wird nichts gebucht.'))return;
  try{
    const headers={};
    if(typeof pdhToken==='function'){headers['Authorization']='Bearer '+pdhToken();}
    await fetch('/api/v1/inventory/stocktake/'+currentStocktakeSessionID+'/cancel',{method:'POST',headers:headers,credentials:'same-origin'});
    closeStocktakeModal();
  }catch(e){alert('Fehler: '+e.message);}
}
</script>
{{end}}
