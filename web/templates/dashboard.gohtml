{{template "base" .}}


{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600;letter-spacing:-.3px">{{if eq .Greeting "Morgen"}}{{t "Guten Morgen"}}{{else if eq .Greeting "Abend"}}{{t "Guten Abend"}}{{else}}{{t "Guten Tag"}}{{end}}, {{.UserFirstName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.DateStr}} · Werk Augsburg</p>
</div>

{{template "dw-grid" .}}

<style>
.dv-filter{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-weight:400}
.dv-chip{display:inline-flex;align-items:center;gap:6px;min-height:30px;padding:0 11px;border-radius:16px;border:1px solid var(--border);background:var(--bg3);color:var(--muted);font-size:12px;font-family:inherit;cursor:pointer}
.dv-chip[aria-pressed="true"]{color:var(--text);border-color:var(--accent);font-weight:600}
.dv-chip i{font-size:10px}
.dv-chip[aria-pressed="false"] i{opacity:.35}
.dv-sep{width:1px;align-self:stretch;background:var(--border);margin:0 2px}
.dv-table{width:100%;border-collapse:collapse;font-size:13px}
.dv-table th{text-align:left;font-size:11px;color:var(--muted);font-weight:600;padding:6px 8px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg2,var(--bg3))}
.dv-table td{padding:7px 8px;border-bottom:1px solid var(--border)}
.dv-table tr.dv-row{cursor:pointer}
.dv-table tr.dv-row:hover{background:var(--bg3)}
.dv-table .dv-over{color:var(--red);font-weight:600}
</style>

<!-- Tabelle der offenen Vorgänge (gleiche Auswahl wie im Leitstand) -->
<div class="card" id="dash-table-card">
  <div class="card-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <span>{{t "Tabelle"}}</span>
    <div class="dv-filter" id="dash-table-filter" role="group" aria-label="{{t "Was in der Tabelle angezeigt wird"}}"></div>
    <span id="dash-table-count" style="margin-left:auto;font-size:12px;color:var(--muted);font-weight:400"></span>
  </div>
  <div style="overflow:auto;max-height:340px">
    <table class="dv-table">
      <thead><tr><th>{{t "Art"}}</th><th>{{t "Titel"}}</th><th>{{t "Fällig"}}</th><th>{{t "Status"}}</th></tr></thead>
      <tbody id="dash-table-body"></tbody>
    </table>
    <div id="dash-table-empty" style="display:none;font-size:12px;color:var(--muted);padding:14px;text-align:center">{{t "Keine offenen Vorgänge vorhanden."}}</div>
  </div>
</div>

<!-- Kombinierter Zeitstrahl: Aufgaben, Tickets, Wartung, Störungen -->
<div class="card">
  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <span>{{t "Zeitstrahl"}}</span>
    <div class="dv-filter" id="dash-gantt-filter" role="group" aria-label="{{t "Was im Zeitstrahl angezeigt wird"}}" style="flex-basis:100%;order:3"></div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--muted)">
      <span><i class="ti ti-square-filled" style="color:#3fae86"></i> {{t "Störungen"}}</span>
      <span><i class="ti ti-square-filled" style="color:#4b9fc4"></i> {{t "Tickets"}}</span>
      <span><i class="ti ti-square-filled" style="color:#c99a3c"></i> {{t "Wartung"}}</span>
      <span><i class="ti ti-square-filled" style="color:#9d7fc9"></i> {{t "Aufgaben"}}</span>
      <span><i class="ti ti-square-filled" style="color:#e05a5a"></i> {{t "Überfällig"}}</span>
      <span style="opacity:.5"><i class="ti ti-square-filled"></i> {{t "ausgeblasst = kein Termin, +30 Tage geschätzt"}}</span>
    </div>
  </div>
  <div id="dash-gantt-target" style="overflow-x:auto"></div>
  {{template "timeline-legend"}}
  <div id="dash-gantt-empty" style="display:none;font-size:12px;color:var(--muted);padding:20px;text-align:center">
    {{t "Keine Einträge mit Terminen vorhanden."}}
  </div>
</div>

<div class="grid2">
  <!-- Störungen -->
  <div class="card">
    <div class="card-title">
      {{t "Aktive Störungen"}}
      <a href="/faults" class="card-action">{{t "alle anzeigen →"}}</a>
    </div>
    {{if .Faults}}
    {{range .Faults}}
    <div class="li {{.BlinkClass}}">
      <div class="li-text">
        <div class="li-title">{{.Title}}</div>
        <div class="li-sub">{{.InfraName}} · {{.DetectedAgo}}</div>
      </div>
      <span class="badge {{.SeverityClass}}">{{.Severity}}</span>
    </div>
    {{end}}
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">{{t "Keine aktiven Störungen"}}</div>
    {{end}}
  </div>

  <!-- Schichtplan -->
  <div class="card">
    <div class="card-title">
      {{t "Schichtplan KW %d" .WeekNumber}}
      <span style="font-size:11px;color:var(--muted)">{{.WeekRange}}</span>
    </div>
    {{if .WeekPlan}}
    <div style="font-size:11px;color:var(--muted);margin-bottom:5px">{{.UserFirstName}} {{.UserLastName}}</div>
    <div class="shift-grid">
      {{range .WeekDays}}
      <div class="shift-day">
        <div class="shift-day-name">{{.Short}}</div>
        <div class="shift-pill {{.Class}}">{{.Label}}</div>
      </div>
      {{end}}
    </div>
    <div style="margin-top:10px;font-size:10px;color:var(--muted);display:flex;gap:10px">
      <span style="color:#6ee7b7">{{t "■ Früh"}}</span>
      <span style="color:#fcd34d">{{t "■ Spät"}}</span>
      <span style="color:#a5b4fc">{{t "■ Nacht"}}</span>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">{{t "Keine Schichten diese Woche"}}</div>
    {{end}}
  </div>
</div>

<!-- Wartung heute -->
<div class="card">
  <div class="card-title">
    {{t "Wartung fällig"}}
    <a href="/maintenance" class="card-action">{{t "alle anzeigen →"}}</a>
  </div>
  {{if .MaintenanceDue}}
  {{range .MaintenanceDue}}
  <div class="li {{.BlinkClass}}">
    <div class="li-text">
      <div class="li-title">{{.Title}}</div>
      <div class="li-sub">{{.InfraName}} · ~{{.EstimatedMin}}min</div>
    </div>
    <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
  </div>
  {{end}}
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:8px 0">{{t "Keine Wartung fällig"}}</div>
  {{end}}
</div>
{{end}}

{{define "context-list"}}
{{range .OpenTickets}}
<div class="act-item {{.BlinkClass}}">
  <div class="act-dot {{.PriorityDot}}"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.css">
<script src="https://cdn.jsdelivr.net/npm/frappe-gantt@0.6.1/dist/frappe-gantt.min.js"></script>
<script>
var dashGanttItems = [
{{range .GanttItems}}
  {id:'{{.ID}}', refType:'{{.RefType}}', name:'{{.Title}}', start:'{{.StartISO}}', end:'{{.EndISO}}',
   provisional: {{if .IsProvisional}}true{{else}}false{{end}}, done: {{if .IsDone}}true{{else}}false{{end}},
   running: {{if .IsRunning}}true{{else}}false{{end}}, unassigned: {{if .IsUnassigned}}true{{else}}false{{end}},
   upcoming: {{if .IsUpcoming}}true{{else}}false{{end}},
   color:'{{.Color}}', url:'{{.DetailURL}}', dueEndpoint:'{{.DueDateEndpoint}}'},
{{end}}
];

// Fuellung = Farbe der Vorgangsart; Rand und Ausgrauen je Zustand kommen aus
// dem Theming (widgets/timeline_style: pdhTimelineApply)
function dashGanttColor(t){
  return {fill: t.color, opacity: t.provisional && !t.done ? 0.4 : 1};
}

function applyDashGanttStyling(){
  dashGanttItems.forEach(function(t){
    var wrapper = document.querySelector('#dash-gantt-target .bar-wrapper[data-id="' + t.id + '"]');
    if(!wrapper) return;
    var colors = dashGanttColor(t);
    var bar = wrapper.querySelector('.bar');
    var barProgress = wrapper.querySelector('.bar-progress');
    if(bar){ bar.style.fill = colors.fill; bar.style.stroke = colors.fill; }
    if(barProgress) barProgress.style.fill = colors.fill;
    var state = pdhTimelineApply(wrapper, t);
    wrapper.style.opacity = colors.opacity;
    wrapper.style.cursor = 'pointer';
    var titleEl = wrapper.querySelector('title');
    var hint = (state ? ' — ' + PDH_TL_LABEL[state] : '') + (t.provisional ? ' — kein Termin, geschätzt (+30 Tage). Doppelklick zum Öffnen, Ziehen zum Eintragen eines echten Termins.' : ' — Doppelklick zum Öffnen');
    if(!titleEl){
      titleEl = document.createElementNS('http://www.w3.org/2000/svg', 'title');
      wrapper.appendChild(titleEl);
    }
    titleEl.textContent = t.name + hint;

    wrapper.addEventListener('dblclick', function(e){
      e.preventDefault();
      window.location = t.url;
    });
  });
}

function formatDateISO(d){
  var year = d.getFullYear();
  var month = String(d.getMonth()+1).padStart(2,'0');
  var day = String(d.getDate()).padStart(2,'0');
  return year + '-' + month + '-' + day;
}

async function saveDashGanttDate(item, end){
  var dueStr = formatDateISO(end);
  try{
    var res = await fetch(item.dueEndpoint, {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({due_date: dueStr})
    });
    if(!res.ok){
      var j = null; try{ j = await res.json(); }catch(e){}
      throw new Error((j && j.error) || ('HTTP ' + res.status));
    }
    location.reload();
  }catch(e){
    alert('Termin konnte nicht gespeichert werden: ' + e.message);
    location.reload();
  }
}

// ── Anzeige-Auswahl wie im Leitstand: je Tabelle und Zeitstrahl eigene Chips
// (Vorgangsarten, nur überfällig, nur ohne Zuständigen), im Browser gemerkt.
var DV_TYPES = [['fault','Störungen','#3fae86'],['ticket','Tickets','#4b9fc4'],['maintenance','Wartung','#c99a3c'],['task','Aufgaben','#9d7fc9']];
var DV_LABEL = {fault:'Störung', ticket:'Ticket', maintenance:'Wartung', task:'Aufgabe'};
// Text des Fertigstellen-Knopfs je Art (wie im Arbeitsbereich)
var DV_DONE = {fault:'Beheben', ticket:'Abschließen', maintenance:'Durchführen', task:'Erledigen'};
function dvToday(){ return formatDateISO(new Date()); }
function dvOverdue(t){ return !t.done && !t.provisional && t.end < dvToday(); }
function dvFilter(boxId, storageKey, onChange){
  var state = {fault:true, ticket:true, maintenance:true, task:true, overdue:false, unassigned:false};
  try{ Object.assign(state, JSON.parse(localStorage.getItem(storageKey) || '{}')); }catch(e){}
  var box = document.getElementById(boxId);
  function chip(key, label, color){
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'dv-chip';
    b.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
    if(color){ var d = document.createElement('i'); d.className = 'ti ti-square-filled'; d.style.color = color; b.appendChild(d); }
    b.appendChild(document.createTextNode(label));
    b.addEventListener('click', function(){
      state[key] = !state[key];
      b.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
      try{ localStorage.setItem(storageKey, JSON.stringify(state)); }catch(e){}
      onChange();
    });
    box.appendChild(b);
  }
  DV_TYPES.forEach(function(t){ chip(t[0], t[1], t[2]); });
  var sep = document.createElement('span'); sep.className = 'dv-sep'; box.appendChild(sep);
  chip('overdue', 'Nur überfällig', '#e05a5a');
  chip('unassigned', 'Nur ohne Zuständigen', '');
  return function(t){
    if(state[t.refType] === false) return false;
    if(state.overdue && !dvOverdue(t)) return false;
    if(state.unassigned && !t.unassigned) return false;
    return true;
  };
}
var dvTableMatch = dvFilter('dash-table-filter', 'pdh_dash_table_filter', function(){ renderDashTable(); });
var dvGanttMatch = dvFilter('dash-gantt-filter', 'pdh_dash_gantt_filter', function(){ renderDashGantt(); });

function renderDashTable(){
  var body = document.getElementById('dash-table-body');
  // offen = wie „Alle offenen“: ohne Erledigtes und ohne Wartungen vor dem Vorlauf (stehen im Zeitstrahl)
  var open = dashGanttItems.filter(function(t){ return !t.done && !t.upcoming; });
  var items = open.filter(dvTableMatch).sort(function(a, b){
    if(a.provisional !== b.provisional) return a.provisional ? 1 : -1;
    return a.end < b.end ? -1 : a.end > b.end ? 1 : 0;
  });
  document.getElementById('dash-table-count').textContent = items.length === open.length ? '' : (items.length + ' von ' + open.length);
  document.getElementById('dash-table-empty').style.display = items.length ? 'none' : 'block';
  body.replaceChildren();
  items.forEach(function(t){
    var tr = document.createElement('tr'); tr.className = 'dv-row';
    function td(text, cls){ var c = document.createElement('td'); if(cls) c.className = cls; c.textContent = text; tr.appendChild(c); }
    td(DV_LABEL[t.refType] || t.refType);
    td(t.name);
    td(t.provisional ? '—' : t.end.split('-').reverse().join('.'), dvOverdue(t) ? 'dv-over' : '');
    td((t.running ? 'In Arbeit' : 'Offen') + (t.unassigned ? ' · ohne Zuständigen' : ''));
    // einheitlich aufklappbar (base.gohtml, data-rx): Ansehen / Bearbeiten / Fertigstellen
    tr.setAttribute('data-rx', '');
    tr.dataset.rxTitle = t.name;
    if(t.url){ tr.dataset.rxView = t.url; tr.dataset.rxEdit = t.url; }
    if(t.id && DV_DONE[t.refType]){ tr.dataset.rxDone = t.refType + ':' + t.id; tr.dataset.rxDoneLabel = DV_DONE[t.refType]; }
    body.appendChild(tr);
  });
  if(window.pdhRowsPrepare) window.pdhRowsPrepare(body);
}

function renderDashGantt(){
  var target = document.getElementById('dash-gantt-target');
  var empty = document.getElementById('dash-gantt-empty');
  var shown = dashGanttItems.filter(dvGanttMatch);
  if(!shown.length){
    target.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  target.style.display = 'block';
  empty.style.display = 'none';

  var byId = {};
  shown.forEach(function(t){ byId[t.id] = t; });

  var tasks = pdhTimelineCollect(shown.map(function(t){
    return {id: t.id, name: t.name, start: t.start, end: t.end, progress: t.done ? 100 : 0, done: t.done};
  }), 'dashboard');

  try{
    target.replaceChildren();
    new Gantt('#dash-gantt-target', tasks, {
      on_date_change: function(task, start, end){
        var item = byId[task.id];
        if(item) saveDashGanttDate(item, end);
      },
      view_mode: 'Week',
      bar_height: PDH_TL.barHeight
    });
    setTimeout(function(){ applyDashGanttStyling(); pdhTimelineCollectorBind('#dash-gantt-target', 'dashboard', renderDashGantt); }, 100);
  }catch(e){
    console.warn('Dashboard-Zeitstrahl konnte nicht gerendert werden', e);
    target.style.display = 'none';
    empty.style.display = 'block';
    empty.textContent = 'Zeitstrahl konnte nicht geladen werden.';
  }
}

function dashInit(){ renderDashTable(); renderDashGantt(); }
if(document.readyState !== 'loading'){ dashInit(); }
else document.addEventListener('DOMContentLoaded', dashInit);
</script>
{{end}}
