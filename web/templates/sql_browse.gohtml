{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Datenbank-Vorschau · {{.ConnectionName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a></p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if not .Applicable}}
<div class="card" role="status">
  Diese Verbindung ist keine durchsuchbare Datenbankverbindung.
</div>
{{else}}

<div class="card" style="margin-bottom:14px">
  <div class="card-title">Quelle</div>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0">
    <dt style="color:var(--muted)">Typ</dt><dd style="margin:0">{{.KindLabel}}</dd>
    <dt style="color:var(--muted)">Adresse</dt><dd style="margin:0;word-break:break-all">{{if .SourceLabel}}{{.SourceLabel}}{{else}}<span style="color:var(--red)">nicht konfiguriert</span>{{end}}</dd>
  </dl>
  {{if .CanWrite}}
  <form method="POST" action="/import/connections/{{.ConnectionID}}/browse/refresh" style="margin-top:12px">
    <button type="submit" class="btn btn-primary"><i class="ti ti-refresh"></i> Jetzt aktualisieren</button>
  </form>
  <p style="font-size:11px;color:var(--muted);margin:8px 0 0">Liest die Datenbank neu ein und übernimmt für jede Zuordnung den Wert der zuletzt eingefügten Zeile der markierten Spalte (jede Tabelle wird als fortlaufendes Log behandelt - bei MySQL wird dafür ein eindeutiger Primärschlüssel benötigt).</p>
  {{end}}
</div>

{{if .Error}}
<div class="card" role="alert">
  {{.Error}}
</div>
{{end}}

{{if .Tables}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Tabelle</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    {{range .Tables}}
    <a href="/import/connections/{{$.ConnectionID}}/browse?table={{.}}" class="btn{{if eq . $.SelectedTable}} btn-primary{{end}}" style="font-size:12px">{{.}}</a>
    {{end}}
  </div>
</div>

{{if .Columns}}
<div class="card" style="overflow-x:auto;margin-bottom:14px">
  <div class="card-title">Vorschau · {{.SelectedTable}}</div>
  <table style="border-collapse:collapse;width:100%;font-size:12px">
    <thead>
      <tr>
        {{range .Columns}}
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">
          {{.}}
          {{if $.CanWrite}}<button type="button" class="btn-icon" style="width:22px;height:22px;min-width:22px;vertical-align:middle;margin-left:4px" onclick="markColumn('{{$.SelectedTable}}', '{{.}}')" title="Spalte markieren"><i class="ti ti-map-pin" style="font-size:12px"></i></button>{{end}}
        </th>
        {{end}}
      </tr>
    </thead>
    <tbody>
      {{range .Rows}}
      <tr>
        {{range .}}<td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">{{.}}</td>{{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
  {{if not .Rows}}<div style="font-size:12px;color:var(--muted);padding:10px 0">Keine Datenzeilen gefunden.</div>{{end}}
</div>
{{end}}

{{if .CanWrite}}
{{template "import-mark-panel" (dict "Title" "Spalte markieren" "SourceLabel" "Tabelle.Spalte")}}
{{end}}
{{else}}
{{if not .Error}}<div class="card" role="status">Keine Tabellen in dieser Datenbank gefunden.</div>{{end}}
{{end}}

{{template "import-mappings-table" (dict "Mappings" .Mappings "CanWrite" .CanWrite "SourceHeader" "Tabelle.Spalte" "Empty" "Noch keine Spalten markiert." "Mono" false)}}
{{end}}
{{end}}

{{define "scripts"}}
<script>
function markColumn(table, column){ importMarkOpen(table + '.' + column); }
</script>
{{template "import-mapping-js" (dict "ConnectionID" .ConnectionID)}}
{{end}}
