{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Mein Konto</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Verbundene Anmeldungen und Dienste</p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

<div class="card" style="max-width:680px;margin-bottom:14px">
  <div class="card-title"><i class="ti ti-user-circle"></i> Profilbild</div>
  <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
    {{template "avatar-edit" (dict "ID" .UserID "URL" .UserAvatar "Initials" .Initials "Bg" .AvatarBg "Back" "/account" "Size" "72px")}}
    <p style="font-size:12px;color:var(--muted);flex:1;min-width:200px">Bild antippen, um ein Foto zu wählen (JPG, PNG oder GIF, höchstens 8 MB). Es wird quadratisch zugeschnitten und erscheint im Chat, in der Kopfleiste und in der Benutzerliste.{{if .UserAvatar}} × entfernt es wieder.{{end}}</p>
  </div>
</div>

{{if .PushEnabled}}
<div class="card" id="push-card" style="max-width:680px;margin-bottom:14px">
  <div class="card-title"><i class="ti ti-bell-ringing"></i> Push-Benachrichtigungen aufs Handy</div>
  <p style="font-size:12px;color:var(--muted);margin-bottom:10px">Neue Störungen und Tickets für deine Gruppen kommen als Nachricht aufs Handy – mit <b>Annehmen</b>. Steht eine Anlage, meldet sich das Handy immer wieder, bis jemand annimmt; in der geöffneten PDH-App erscheint der Alarm bildschirmfüllend.</p>
  <p id="push-status" style="font-size:13px;margin-bottom:10px">Wird geprüft …</p>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button type="button" class="btn btn-primary" id="push-on"><i class="ti ti-bell-plus"></i> Auf diesem Gerät einschalten</button>
    <button type="button" class="btn" id="push-test"><i class="ti ti-send"></i> Probe senden</button>
    <button type="button" class="btn" id="push-off"><i class="ti ti-bell-off"></i> Auf diesem Gerät ausschalten</button>
  </div>
  <p style="font-size:11.5px;color:var(--muted);margin-top:10px"><b>iPhone</b> (ab iOS 16.4): PDH in Safari öffnen → Teilen → <b>Zum Home-Bildschirm</b>, dann PDH vom Home-Bildschirm starten und hier einschalten. <b>Android</b>: in Chrome einschalten; für Alarme die Benachrichtigungen von Chrome bzw. PDH auf „Mit Ton“/„Wichtig“ stellen.</p>
</div>
<script>
// pdhPush steht erst am Seitenende (base.gohtml) bereit
document.addEventListener('DOMContentLoaded', function(){
  const $ = id => document.getElementById(id);
  async function refresh(){
    const s = await pdhPush.status();
    let text = 'Auf diesem Gerät ausgeschaltet.';
    if(!s.supported) text = 'Dieser Browser kann keine Push-Nachrichten (iPhone: erst „Zum Home-Bildschirm“).';
    else if(s.permission === 'denied') text = 'Benachrichtigungen sind für PDH blockiert – in den Einstellungen des Browsers/Handys freigeben.';
    else if(s.here) text = '✅ Auf diesem Gerät eingeschaltet.';
    $('push-status').textContent = text;
    $('push-on').hidden = !s.supported || s.here;
    $('push-off').hidden = !s.here;
    $('push-test').hidden = !s.here;
  }
  async function run(btn, fn, ok){
    btn.disabled = true;
    try{ await fn(); if(ok) $('push-status').textContent = ok; await new Promise(r => setTimeout(r, 300)); await refresh(); if(ok) $('push-status').textContent = ok; }
    catch(e){ $('push-status').textContent = '⚠ ' + e.message; }
    btn.disabled = false;
  }
  $('push-on').addEventListener('click', () => run($('push-on'), pdhPush.enable, '✅ Eingeschaltet – „Probe senden“ zum Testen.'));
  $('push-off').addEventListener('click', () => run($('push-off'), pdhPush.disable, 'Auf diesem Gerät ausgeschaltet.'));
  $('push-test').addEventListener('click', () => run($('push-test'), async () => { const j = await pdhPush.test(); if(!j.sent) throw new Error('Kein Gerät erreichbar'); }, '📨 Probe verschickt – sie sollte gleich ankommen.'));
  refresh();
});
</script>
{{end}}

<div class="card" style="max-width:680px;margin-bottom:14px">
  <div class="card-title"><i class="ti ti-briefcase"></i> Microsoft 365 · Geschäftlich</div>
  {{with .MicrosoftWork}}{{if .Connected}}
  <p>Verbunden als <strong>{{.AccountLabel}}</strong></p>
  {{if .TeamsPermission}}
  <p style="font-size:12px;color:var(--green)">Teams-Berechtigungen erteilt</p>
  {{else}}
  <form method="POST" action="/account/microsoft/connect-teams" style="margin-bottom:10px">
    <button type="submit" class="btn"><i class="ti ti-brand-teams"></i> Teams freigeben</button>
  </form>
  {{end}}
  {{template "account-ms-connected" .}}
  {{else if $.MicrosoftConfigured}}
  <p style="font-size:13px;color:var(--muted)">Verbinde dein Geschäfts- oder Schulkonto (Firmen-Microsoft-365) mit PDH – für Outlook-Kalender und Teams.</p>
  <form method="POST" action="/account/microsoft/connect">
    <input type="hidden" name="account" value="work">
    <button type="submit" class="btn btn-primary"><i class="ti ti-brand-windows"></i> Geschäftskonto verbinden</button>
  </form>
  {{else}}
  <p style="font-size:13px;color:var(--muted)">Microsoft OAuth ist serverseitig noch nicht konfiguriert.</p>
  {{end}}{{end}}
</div>

<div class="card" style="max-width:680px">
  <div class="card-title"><i class="ti ti-home"></i> Microsoft 365 · Privat</div>
  {{with .MicrosoftPrivate}}{{if .Connected}}
  <p>Verbunden als <strong>{{.AccountLabel}}</strong></p>
  {{template "account-ms-connected" .}}
  {{else if $.MicrosoftConfigured}}
  <p style="font-size:13px;color:var(--muted)">Zusätzlich kannst du ein privates Microsoft-Konto verbinden (Outlook.com, Hotmail, Live oder Microsoft 365 Single/Family). So landen z. B. deine Schichten im privaten Kalender, und private Termine erscheinen als Busy-Blocker im Schichtplan – ohne Betreff.</p>
  <form method="POST" action="/account/microsoft/connect">
    <input type="hidden" name="account" value="private">
    <button type="submit" class="btn btn-primary"><i class="ti ti-brand-windows"></i> Privates Konto verbinden</button>
  </form>
  {{else}}
  <p style="font-size:13px;color:var(--muted)">Microsoft OAuth ist serverseitig noch nicht konfiguriert.</p>
  {{end}}{{end}}
</div>
{{end}}

{{define "account-ms-connected"}}
  <form method="POST" action="/account/microsoft/disconnect" onsubmit="return confirm('Microsoft-Konto wirklich trennen?')">
    <input type="hidden" name="account" value="{{.Kind}}">
    <button type="submit" class="btn"><i class="ti ti-unlink"></i> Konto trennen</button>
  </form>
  <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:14px">
    <div style="font-size:13px;font-weight:600;margin-bottom:10px">Outlook-Kalender</div>
    <form method="POST" action="/account/microsoft/calendar">
      <input type="hidden" name="account" value="{{.Kind}}">
      <div style="display:grid;gap:8px;font-size:13px">
        <label><input type="checkbox" name="sync_shifts" {{if .SyncShifts}}checked{{end}}> Schichten nach Outlook schreiben</label>
        <label><input type="checkbox" name="sync_tasks" {{if .SyncTasks}}checked{{end}}> Zugewiesene Aufgaben nach Outlook schreiben</label>
        <label><input type="checkbox" name="sync_maintenance" {{if .SyncMaintenance}}checked{{end}}> Wartungen nach Outlook schreiben</label>
        <label><input type="checkbox" name="sync_tickets_faults" {{if .SyncTicketsFaults}}checked{{end}}> Tickets und Störungen nach Outlook schreiben</label>
        <label><input type="checkbox" name="import_busy_events" {{if .ImportBusyEvents}}checked{{end}}> Outlook-Termine als private Busy-Blocker nach PDH importieren</label>
      </div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:12px">
        <button type="submit" class="btn"><i class="ti ti-device-floppy"></i> Kalenderauswahl speichern</button>
      </div>
    </form>
    <form method="POST" action="/account/microsoft/calendar/sync" style="margin-top:8px">
      <input type="hidden" name="account" value="{{.Kind}}">
      <button type="submit" class="btn btn-primary"><i class="ti ti-refresh"></i> Jetzt synchronisieren</button>
    </form>
    <p style="font-size:11px;color:var(--muted)">Letzter Sync: {{if .CalendarLastSync}}{{.CalendarLastSync}}{{else}}noch keiner{{end}} · {{.CalendarBusyCount}} Busy-Blocker importiert</p>
    {{if .CalendarBusyBlocks}}
    <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:10px">
      <div style="font-size:12px;font-weight:600;margin-bottom:6px">Kommende Busy-Blocker</div>
      <ul style="padding-left:18px;margin:0;color:var(--muted);font-size:12px">
        {{range .CalendarBusyBlocks}}<li>{{.StartsAt}} bis {{.EndsAt}}</li>{{end}}
      </ul>
    </div>
    {{end}}
  </div>
{{end}}
