{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  {{template "icon-button" (dict "Action" "back" "Href" "/maintenance")}}
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Task.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">
      {{.Task.TypeLabel}} · fällig {{.Task.DueDate}}{{if .Task.InfraName}} · {{.Task.InfraName}}{{end}}
    </p>
  </div>
  <span class="badge {{.Task.PriorityClass}}" style="font-size:12px;padding:4px 12px">{{.Task.Priority}}</span>
  <span class="badge {{.Task.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Task.StatusLabel}}</span>
  <div class="widget-icon-toolbar compact">
    {{template "icon-button" (dict "Action" "edit" "OnClick" "toggleEdit();closeMenu('maint-menu')")}}
    {{if .Task.CanComplete}}
    {{template "icon-button" (dict "Action" "done" "Label" "Abschließen" "OnClick" (printf "openCompleteForm('%s')" .Task.ID))}}
    {{end}}
    {{if .Task.CanStart}}
    {{template "icon-button" (dict "Action" "start" "HxPost" (printf "/maintenance/tasks/%s/start-web" .Task.ID) "HxOnAfterRequest" "location.reload()")}}
    {{end}}
  <form method="POST" action="/maintenance/tasks/{{.Task.ID}}/delete-web" onsubmit="return confirm('Auftrag löschen?')">
    {{template "icon-button" (dict "Action" "delete" "Type" "submit" "Label" "Löschen")}}
  </form>
  </div>
</div>
{{template "record-meta-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Historie</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">

<!-- Bearbeiten -->
<div id="edit-form" style="display:none" class="card">
  <div class="card-title">Auftrag bearbeiten</div>
  <form hx-put="/maintenance/tasks/{{.Task.ID}}/edit-web" hx-target="#edit-result" hx-swap="innerHTML">
    <div class="grid2">
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Titel</label><input name="title" class="form-input" value="{{.Task.Title}}" required></div>
      <div class="form-group"><label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low" {{if eq .Task.Priority "low"}}selected{{end}}>Low</option>
          <option value="medium" {{if eq .Task.Priority "medium"}}selected{{end}}>Medium</option>
          <option value="high" {{if eq .Task.Priority "high"}}selected{{end}}>High</option>
          <option value="critical" {{if eq .Task.Priority "critical"}}selected{{end}}>Critical</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Fällig am</label><input name="due_date" type="date" class="form-input" value="{{.Task.DueDateISO}}"></div>
      {{template "infra-tree-picker" (dict "TargetID" "task-infra-id" "SelectedLabelID" "task-infra-selected" "Label" "Infrastruktur" "Value" .Task.InfraID "SelectedLabel" .Task.InfraName)}}
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><textarea name="description" class="form-input" rows="3" style="resize:vertical">{{.Task.Description}}</textarea></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Notizen</label><textarea name="notes" class="form-input" rows="2" style="resize:vertical">{{.Task.Notes}}</textarea></div>
    </div>
    <div id="edit-result" style="margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Auftrag bearbeiten"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "toggleEdit()")
        (dict "Action" "save" "ShowLabel" true "Type" "submit")
      )
    )}}
  </form>
</div>

<!-- Checklisten-Protokoll -->
<div id="checklist-protocol" class="card" style="display:none">
  <div class="card-title"><i class="ti ti-list-check" style="color:var(--accent)"></i> Checklisten-Protokoll</div>
  <div id="checklist-protocol-body"></div>
</div>

<!-- Ausführungsformular -->
{{if .Task.CanComplete}}
<div id="complete-form" class="card">
  <div class="card-title"><i class="ti ti-clipboard-check" style="color:var(--accent)"></i> Ausführungsformular</div>
  <form onsubmit="return submitMaintenanceCompletion(this,'{{.Task.ID}}')">

    <div id="due-checklist-box" style="margin-bottom:16px;font-size:12px;color:var(--muted)">Fällige Checklistenpunkte werden geladen...</div>

    <div style="margin-bottom:16px">
      <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Durchgeführte Maßnahmen</div>
      <div id="maint-actions-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      <div style="display:flex;gap:8px">
        <input data-suggest="action" id="ma-new-action" class="form-input" placeholder="z.B. Filter getauscht" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addMaintAction();}">
        <button type="button" class="btn" onclick="addMaintAction()"><i class="ti ti-plus"></i></button>
      </div>
    </div>

    <div style="margin-bottom:16px">
      <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Ersatzteile</div>
      <div id="maint-parts-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      <button type="button" class="btn" onclick="openMaintPartModal()"><i class="ti ti-package"></i> Ersatzteil vormerken</button>
      <label style="display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted);margin-top:10px">
        <input type="checkbox" name="no_parts_needed"> Keine Ersatzteile benötigt
      </label>
    </div>

    <p style="font-size:12px;color:var(--muted);margin-bottom:10px">Weiter geht es im Abschluss-Assistenten: Material → Zeit → wer war dabei → Kommentar → Fertig.</p>
    <div id="complete-result" style="font-size:12px;margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Auftrag abschließen"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "done" "ShowLabel" true "Type" "submit" "Label" "Weiter zum Abschluss")
      )
    )}}
  </form>
</div>

<!-- Ersatzteil-vormerken Popup -->
<div id="maint-part-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:6000;align-items:center;justify-content:center">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:22px;width:100%;max-width:420px;margin:20px">
    <div style="font-size:15px;font-weight:600;margin-bottom:14px">Ersatzteil vormerken</div>
    <div class="form-group">
      <label class="form-label">Ersatzteil</label>
      <input id="ma-part-search" class="form-input" placeholder="Suchen..." oninput="filterMaintParts()" autocomplete="off">
      <div id="ma-part-results" style="max-height:160px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;margin-top:4px;display:none"></div>
      <input type="hidden" id="ma-part-id">
      <div id="ma-part-selected" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
    </div>
    <div class="form-group">
      <label class="form-label">Lagerort</label>
      <select id="ma-part-location" class="form-input"><option value="">Lade Lagerorte...</option></select>
    </div>
    <div class="form-group">
      <label class="form-label">Menge</label>
      <input id="ma-part-qty" type="number" step="0.001" class="form-input" value="1">
    </div>
    <div id="ma-part-error" style="display:none;color:var(--red);font-size:12px;margin-bottom:8px"></div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
      <button type="button" class="btn" onclick="closeMaintPartModal()">Abbrechen</button>
      <button type="button" class="btn btn-primary" onclick="bookMaintPart()">Vormerken</button>
    </div>
  </div>
</div>
{{end}}

<div class="grid2" style="grid-template-columns:1fr 300px;gap:14px;align-items:start">
  <div>
    {{if eq .Task.Status "done"}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:32px;height:32px;background:rgba(16,185,129,.15);border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="ti ti-check" style="color:var(--green);font-size:18px"></i></div>
        <div><div style="font-weight:500;color:var(--green)">Abgeschlossen {{.Task.CompletedAt}}</div>
        {{if .Task.DurationStr}}<div style="font-size:12px;color:var(--muted)">Dauer: {{.Task.DurationStr}}</div>{{end}}</div>
      </div>
      {{if .Task.Notes}}<p style="font-size:13px;color:var(--muted);margin-top:10px;line-height:1.6">{{.Task.Notes}}</p>{{end}}
    </div>
    {{end}}
    {{if eq .Task.Status "in_progress"}}
    <div class="card" style="border-color:rgba(var(--accent-rgb),.3)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:32px;height:32px;background:rgba(var(--accent-rgb),.15);border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="ti ti-loader" style="color:var(--accent);font-size:18px"></i></div>
        <div><div style="font-weight:500;color:var(--accent)">In Bearbeitung{{if .Task.StartedAt}} seit {{.Task.StartedAt}}{{end}}</div></div>
      </div>
    </div>
    {{end}}
    {{if .Task.Description}}
    <div class="card">
      <div class="card-title"><i class="ti ti-file-description" style="color:var(--accent)"></i> Beschreibung</div>
      <p style="font-size:13px;line-height:1.7;color:var(--muted)">{{.Task.Description}}</p>
    </div>
    {{end}}
    {{if .Task.CanStart}}
    <div class="card" style="text-align:center;padding:24px">
      <i class="ti ti-player-play" style="font-size:32px;color:var(--muted);display:block;margin-bottom:10px;opacity:.5"></i>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Auftrag noch nicht gestartet</p>
      {{template "icon-button" (dict "Action" "start" "ShowLabel" true "Label" "Auftrag starten" "HxPost" (printf "/maintenance/tasks/%s/start-web" .Task.ID) "HxOnAfterRequest" "location.reload()")}}
    </div>
    {{end}}
    <!-- Zeiterfassung -->
    <div class="card">
      <div class="card-title"><i class="ti ti-clock"></i> Zeiterfassung</div>
      {{if .Running}}
      <div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:10px;margin-bottom:10px">
        <div style="font-size:12px;color:var(--green);font-weight:500">⏱ Läuft seit {{.Running.StartedAt.Format "15:04"}}</div>
      </div>
      {{template "icon-button" (dict "Action" "stop" "ShowLabel" true "Label" "Zeit stoppen" "Style" "width:100%;justify-content:center;margin-bottom:8px" "HxPost" (printf "/time/%s/stop-web" .Running.ID) "HxOnAfterRequest" "location.reload()")}}
      {{else}}
      {{template "icon-button" (dict "Action" "start" "ShowLabel" true "Label" "Zeit erfassen" "Style" "width:100%;justify-content:center;margin-bottom:8px" "HxPost" (printf "/maintenance/tasks/%s/time/start" .Task.ID) "HxTarget" "#time-result")}}
      {{end}}
      <div id="time-result"></div>
      {{range .TimeEntries}}
      <div class="li">
        <div class="li-text"><div class="li-title" style="font-size:12px">{{.Description}}</div><div class="li-sub">{{.UserName}} · {{.StartedAt.Format "02.01. 15:04"}}</div></div>
        <span style="font-size:12px;color:var(--green);font-weight:500">{{if .DurationMin}}{{.DurationMin}}min{{else}}läuft…{{end}}</span>
      </div>
      {{else}}<div style="font-size:12px;color:var(--muted);padding:4px 0">Keine Zeiteinträge</div>{{end}}
    </div>

    <!-- Anhänge -->
    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos & Dokumente</div>
      <div id="attachments-{{.Task.ID}}" data-attach-ref="maintenance_task:{{.Task.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)"><i class="ti ti-photo"></i>Galerie<input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)"><i class="ti ti-camera"></i>Kamera<input type="file" accept="image/*" capture="environment" style="display:none" onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
      </div>
    </div>

    {{template "record-history" .History}}
  </div>
  <!-- Details -->
  <div>
    <div class="card">
      <div class="card-title">Details</div>
      {{if .Task.RecordImageURL}}
      <img src="{{.Task.RecordImageURL}}" alt="Datensatzbild" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px;border:1px solid var(--border);margin-bottom:12px">
      {{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Typ</div><div class="li-title">{{.Task.TypeLabel}}</div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Priorität</div><div class="li-title"><span class="badge {{.Task.PriorityClass}}">{{.Task.Priority}}</span></div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Status</div><div class="li-title"><span class="badge {{.Task.StatusClass}}">{{.Task.StatusLabel}}</span></div></div></div>
      {{if .Task.InfraName}}<div class="li"><div class="li-text"><div class="li-sub">Infrastruktur</div><div class="li-title"><a href="/infrastructure/{{.Task.InfraID}}" style="color:var(--accent)">{{.Task.InfraName}}</a></div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Fällig am</div><div class="li-title" style="{{if eq .Task.Status "open"}}color:var(--amber){{end}}">{{.Task.DueDate}}</div></div></div>
      {{if .Task.AssigneeName}}<div class="li"><div class="li-text"><div class="li-sub">Zugewiesen</div><div class="li-title">{{.Task.AssigneeName}}</div></div></div>{{end}}
      {{if .Task.DurationStr}}<div class="li"><div class="li-text"><div class="li-sub">Dauer</div><div class="li-title" style="font-weight:600;color:var(--green)">{{.Task.DurationStr}}</div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Erstellt</div><div class="li-title" style="font-size:12px;color:var(--muted)">{{.Task.CreatedAt}}</div></div></div>
      <form hx-put="/records/maintenance_task/{{.Task.ID}}/people" hx-target="#people-result-task" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div class="form-group">
          <label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input">
            <option value="">Nicht gesetzt</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Zugewiesen</label>
          <select name="assigned_to" class="form-input">
            <option value="">Nicht zugewiesen</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Zugewiesene Gruppe</label>
          <select name="assigned_group_id" class="form-input" hx-get="/records/maintenance_task/{{.Task.ID}}/group-options" hx-trigger="load" hx-swap="innerHTML"><option value="__keep__">Lädt…</option></select>
        </div>
        <div id="people-result-task" style="font-size:12px;margin-bottom:8px"></div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
    </div>
    <div class="card">
      <div class="card-title">Beteiligte</div>
      <div id="record-parties" hx-get="/records/maintenance_task/{{.Task.ID}}/parties" hx-trigger="load" hx-swap="innerHTML"></div>
    </div>
    {{if .Task.CanComplete}}
    <div class="card">
      {{template "icon-button" (dict "Action" "done" "ShowLabel" true "Label" "Als erledigt markieren" "Style" "width:100%;justify-content:center" "OnClick" (printf "openCompleteForm('%s');window.scrollTo({top:0,behavior:'smooth'})" .Task.ID))}}
    </div>
    {{end}}
  </div>
</div>
</div>

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div>
</div>

<!-- ── Verknüpfungen ── -->
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div>

<!-- ── Historie ── -->
<div class="rec-pane" data-pane="history">{{template "record-history-slot" (dict "Module" "maintenance_task" "ID" .Task.ID)}}</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:6px">Auftrag</div>
<div class="act-item"><div class="act-dot {{.Task.PriorityDot}}"></div><div class="act-text">{{.Task.Title}}</div><span class="badge {{.Task.StatusClass}}" style="font-size:9px">{{.Task.StatusLabel}}</span></div>
{{range .TimeEntries}}<div class="act-item"><div class="act-dot d-green"></div><div class="act-text">{{.UserName}}</div><span style="font-size:10px;color:var(--muted)">{{if .DurationMin}}{{.DurationMin}}min{{else}}läuft{{end}}</span></div>{{end}}
{{end}}

{{block "scripts" .}}
<style>
.dck{border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:8px;background:var(--bg2)}
.dck.missing{border-color:var(--red);box-shadow:0 0 0 1px var(--red)}
.dck-head{display:flex;gap:8px;align-items:flex-start}
.dck-label{flex:1;font-weight:500;font-size:13px}
.dck-desc{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:pre-wrap}
.dck-spec{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 2px}
.dck-spec span{font-size:11px;background:var(--bg3);border:1px solid var(--border);border-radius:999px;padding:1px 8px;color:var(--muted)}
.dck-spec b{color:var(--text);font-weight:600}
.dck-in{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px}
.dck-in .form-input{max-width:180px}
.dck-in textarea.form-input{max-width:none;width:100%;min-height:60px;resize:vertical}
.dck-state{font-size:11.5px;font-weight:600}
.dck-state.ok{color:var(--green)}.dck-state.bad{color:var(--red)}
.dck-imgs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;align-items:center}
.dck-imgs .lbl{font-size:10.5px;color:var(--muted);width:100%}
.dck-img{position:relative;display:inline-block}
.dck-img img{width:64px;height:64px;object-fit:cover;border-radius:6px;border:1px solid var(--border);display:block}
.dck-img button{position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;border:1px solid var(--border);background:var(--bg2);color:var(--muted);display:flex;align-items:center;justify-content:center;padding:0;cursor:pointer;font-size:11px}
.dck-ref img{width:120px;height:90px}
.dck-add{height:64px;min-width:64px;padding:0 10px;border:1px dashed var(--border);border-radius:6px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:10.5px;color:var(--muted);cursor:pointer}
.dck-add:hover{border-color:var(--accent);color:var(--accent)}
.dck-add i{font-size:20px}
.dck-add.busy{opacity:.5;pointer-events:none}
.cp-row{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,1fr);gap:4px 12px;padding:8px 0;border-bottom:1px solid var(--border);font-size:12.5px}
.cp-row:last-child{border-bottom:0}
.cp-row .m{font-size:11px;color:var(--muted)}
@media(max-width:700px){.cp-row{grid-template-columns:1fr}}
</style>
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){const el=document.getElementById(id); if(el) el.style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id$="-menu"]'))document.querySelectorAll('[id$="-menu"]').forEach(m=>m.style.display='none');});
function toggleEdit(){const f=document.getElementById('edit-form');f.style.display=f.style.display==='none'?'block':'none';if(f.style.display==='block')f.scrollIntoView({behavior:'smooth',block:'nearest'});}
async function apiData(url, options){const res=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));let payload=null;try{payload=await res.json();}catch(e){payload=null;}if(!res.ok)throw new Error((payload&&(payload.error||payload.message))||('HTTP '+res.status));return payload&&payload.data!==undefined?payload.data:payload;}
// auto=true: beim Laden der Seite nur die faelligen Punkte vorbereiten (kein Assistent)
async function openCompleteForm(taskID, auto){const box=document.getElementById('complete-form');const due=await loadDueChecklist(taskID);
  // Abschluss-Assistent (Material, Zeit, wer war dabei, Kommentar); fällige Checklistenpunkte vorher hier ausfüllen
  if(!due){box.style.display='none';if(!auto)pdhComplete('maintenance',taskID);return;}
  box.style.display='block';if(!auto)box.scrollIntoView({behavior:'smooth',block:'nearest'});}
async function loadDefaultDuration(taskID){try{const d=await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/default-duration');const input=document.getElementById('complete-duration');if(input && !input.value && d && d.default_duration_min>0)input.value=d.default_duration_min;}catch(e){console.warn(e);}}

// ── Checkliste: Checkbox, Messwert (Soll/Min/Max), Freitext; Bilder zur Darstellung + Fotos zur Dokumentation
var dckItems = {};
function dckNum(v){return (v===null||v===undefined)?'':String(v).replace('.',',');}
function dckParse(v){v=String(v||'').trim().replace(',','.');if(v==='')return null;const n=Number(v);return isFinite(n)?n:NaN;}
function dckSpecHtml(item){
  if(item.item_type!=='number')return '';
  const u=item.unit?' '+escapeHtml(item.unit):'';const p=[];
  if(item.target_value!==null&&item.target_value!==undefined)p.push('<span>Soll <b>'+escapeHtml(dckNum(item.target_value))+u+'</b></span>');
  if(item.min_value!==null&&item.min_value!==undefined)p.push('<span>Min <b>'+escapeHtml(dckNum(item.min_value))+u+'</b></span>');
  if(item.max_value!==null&&item.max_value!==undefined)p.push('<span>Max <b>'+escapeHtml(dckNum(item.max_value))+u+'</b></span>');
  return p.length?'<div class="dck-spec">'+p.join('')+'</div>':'';
}
// Bewertung gegen Min/Max: null = keine Grenzen oder kein Wert
function dckRange(item,value){
  const hasMin=item.min_value!==null&&item.min_value!==undefined, hasMax=item.max_value!==null&&item.max_value!==undefined;
  const n=dckParse(value);
  if(n===null)return null;
  if(isNaN(n))return 'nan';
  if(!hasMin&&!hasMax)return null;
  return (!hasMin||n>=item.min_value)&&(!hasMax||n<=item.max_value);
}
function dckCheckMeasure(input){
  const item=dckItems[input.dataset.itemId];const st=input.parentNode.querySelector('.dck-state');if(!item||!st)return;
  const r=dckRange(item,input.value);
  if(r===null){st.textContent='';st.className='dck-state';}
  else if(r==='nan'){st.textContent='keine Zahl';st.className='dck-state bad';}
  else if(r){st.innerHTML='<i class="ti ti-circle-check"></i> im Bereich';st.className='dck-state ok';}
  else{st.innerHTML='<i class="ti ti-alert-triangle"></i> außerhalb '+(item.min_value!==null&&item.min_value!==undefined?escapeHtml(dckNum(item.min_value)):'…')+' – '+(item.max_value!==null&&item.max_value!==undefined?escapeHtml(dckNum(item.max_value)):'…')+(item.unit?' '+escapeHtml(item.unit):'');st.className='dck-state bad';}
  input.closest('.dck').classList.remove('missing');
}
function dckImg(img,removable){return '<span class="dck-img"><a href="'+escapeHtml(img.url)+'" target="_blank" rel="noopener"><img src="'+escapeHtml(img.url)+'" alt="'+escapeHtml(img.filename)+'" loading="lazy"></a>'+(removable?'<button type="button" title="Foto entfernen" aria-label="Foto entfernen" onclick="dckDeletePhoto(\''+escapeHtml(img.id)+'\',this)"><i class="ti ti-x"></i></button>':'')+'</span>';}
async function loadDueChecklist(taskID){const box=document.getElementById('due-checklist-box');try{const items=await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/due-checklist');if(!items||items.length===0){box.innerHTML='<div style="padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--muted)">Keine fälligen Vorlagen-Checklistenpunkte.</div>';return 0;}dckItems={};items.forEach(i=>{dckItems[i.template_item_id]=i;});box.innerHTML='<div class="card-title" style="margin:0 0 8px 0"><i class="ti ti-checklist"></i> Fällige Checklistenpunkte</div>'+items.map(renderDueChecklistItem).join('');box.querySelectorAll('.due-check-value[data-measure]').forEach(dckCheckMeasure);return items.length;}catch(e){box.innerHTML='<div style="color:var(--red)">Fällige Checkliste konnte nicht geladen werden: '+escapeHtml(e.message)+'</div>';return 0;}}
function renderDueChecklistItem(item){
  const id=escapeHtml(item.template_item_id);
  const req=item.required?'<span style="color:var(--red);font-size:10px" title="Pflichtpunkt">✱</span> ':'';
  const last=item.last_done_at?'<div class="dck-desc">Zuletzt: '+escapeHtml(new Date(item.last_done_at).toLocaleDateString('de-DE'))+'</div>':'';
  const desc=item.description?'<div class="dck-desc">'+escapeHtml(item.description)+'</div>':'';
  const refs=(item.ref_images||[]);
  const refHtml=refs.length?'<div class="dck-imgs dck-ref"><span class="lbl">Darstellung</span>'+refs.map(i=>dckImg(i,false)).join('')+'</div>':'';
  let input='';
  if(item.item_type==='number'){
    input='<div class="dck-in"><input type="text" inputmode="decimal" class="form-input due-check-value" data-measure="1" data-item-id="'+id+'" value="'+escapeHtml(item.value||'')+'" placeholder="Messwert" oninput="dckCheckMeasure(this)">'+(item.unit?'<span style="font-size:12px;color:var(--muted)">'+escapeHtml(item.unit)+'</span>':'')+'<span class="dck-state"></span></div>';
  }else if(item.item_type==='text'){
    input='<div class="dck-in"><textarea class="form-input due-check-value" data-suggest="check" data-item-id="'+id+'" placeholder="Freitext" oninput="this.closest(\'.dck\').classList.remove(\'missing\')">'+escapeHtml(item.value||'')+'</textarea></div>';
  }else{
    input='<div class="dck-in"><label style="display:flex;gap:8px;align-items:center;font-size:13px;cursor:pointer"><input type="checkbox" class="due-check-done" data-item-id="'+id+'" style="width:18px;height:18px"'+(item.done?' checked':'')+' onchange="this.closest(\'.dck\').classList.remove(\'missing\')"> erledigt</label></div>';
  }
  const docs=(item.doc_images||[]);
  const docHtml='<div class="dck-imgs dck-docs" data-item-id="'+id+'"><span class="lbl">Fotos zur Dokumentation</span>'+docs.map(i=>dckImg(i,true)).join('')
    +'<label class="dck-add" title="Foto aufnehmen oder auswählen"><i class="ti ti-camera-plus"></i><span>Foto</span><input type="file" accept="image/*" capture="environment" multiple hidden onchange="dckUploadPhotos(\''+id+'\',this)"></label></div>';
  return '<div class="dck" data-item-id="'+id+'" data-type="'+escapeHtml(item.item_type)+'" data-required="'+(item.required?'1':'')+'"><div class="dck-head"><div class="dck-label">'+req+escapeHtml(item.label)+desc+last+'</div><span class="badge b-gray" style="font-size:10px">'+escapeHtml(item.interval_days)+' Tage</span></div>'+dckSpecHtml(item)+refHtml+input+docHtml+'</div>';
}
// Dokumentationsfotos haengen am Ergebnis des Punkts (wird bei Bedarf angelegt)
async function dckUploadPhotos(itemID,input){
  if(!input.files||!input.files.length)return;
  const add=input.closest('.dck-add');add.classList.add('busy');
  try{
    const r=await apiData('/api/v1/maintenance-checklists/tasks/'+MAINT_TASK_ID+'/items/'+encodeURIComponent(itemID)+'/result',{method:'POST'});
    const fd=new FormData();[...input.files].forEach(f=>fd.append('files',f));
    const saved=await apiData('/api/v1/attachments/maint_check_result/'+encodeURIComponent(r.id),{method:'POST',body:fd})||[];
    if(saved.length<input.files.length)alert('Nicht alle Dateien wurden übernommen (nur Bilder bis 20 MB).');
    saved.filter(a=>a.is_image).forEach(a=>add.insertAdjacentHTML('beforebegin',dckImg({id:a.id,url:a.url,filename:a.filename},true)));
  }catch(e){alert('Foto konnte nicht gespeichert werden: '+e.message);}
  input.value='';add.classList.remove('busy');
}
async function dckDeletePhoto(id,btn){
  if(!confirm('Foto entfernen?'))return;
  try{await apiData('/api/v1/attachments/'+encodeURIComponent(id),{method:'DELETE'});btn.closest('.dck-img').remove();}
  catch(e){alert('Fehler: '+e.message);}
}
async function submitMaintenanceCompletion(form,taskID){
  const result=document.getElementById('complete-result');
  const values={};const done={};const missing=[];
  document.querySelectorAll('#due-checklist-box .dck').forEach(card=>{
    const id=card.dataset.itemId, type=card.dataset.type;
    card.classList.remove('missing');
    let filled;
    if(type==='checkbox'){const cb=card.querySelector('.due-check-done');done[id]=cb.checked;values[id]=cb.checked?'erledigt':'';filled=cb.checked;}
    else{const v=card.querySelector('.due-check-value').value.trim();values[id]=v;filled=v!=='';
      if(type==='number'&&filled&&isNaN(dckParse(v))){card.classList.add('missing');missing.push(dckItems[id].label+' (keine Zahl)');return;}}
    if(card.dataset.required&&!filled){card.classList.add('missing');missing.push(dckItems[id].label);}
  });
  if(missing.length){result.innerHTML='<span style="color:var(--red)">Bitte ausfüllen: '+escapeHtml(missing.join(', '))+'</span>';const first=document.querySelector('#due-checklist-box .dck.missing');if(first)first.scrollIntoView({behavior:'smooth',block:'center'});return false;}
  const out=Object.keys(values).filter(id=>dckRange(dckItems[id],values[id])===false).map(id=>dckItems[id].label);
  if(out.length&&!confirm('Außerhalb von Min/Max:\n– '+out.join('\n– ')+'\n\nTrotzdem so übernehmen?'))return false;
  result.textContent='Speichere Checkliste...';
  try{if(Object.keys(values).length>0){await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/checklist-results',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values,done})});}result.textContent='';document.getElementById('complete-form').style.display='none';loadChecklistProtocol(taskID);pdhComplete('maintenance',taskID);}catch(e){result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>';}return false;}
// Protokoll der erfassten Punkte (inkl. Dokumentationsfotos)
async function loadChecklistProtocol(taskID){
  const card=document.getElementById('checklist-protocol');if(!card)return;
  try{
    const items=await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/checklist-results')||[];
    if(!items.length){card.style.display='none';return;}
    document.getElementById('checklist-protocol-body').innerHTML=items.map(it=>{
      const u=it.unit?' '+escapeHtml(it.unit):'';let val;
      if(it.item_type==='checkbox')val=it.done?'<span style="color:var(--green)"><i class="ti ti-square-check"></i> erledigt</span>':'<span class="m">nicht erledigt</span>';
      else if(it.item_type==='number')val=it.value?'<b>'+escapeHtml(it.value)+'</b>'+u+(it.in_range===true?' <span style="color:var(--green)" title="im Bereich"><i class="ti ti-circle-check"></i></span>':it.in_range===false?' <span style="color:var(--red)" title="außerhalb Min/Max"><i class="ti ti-alert-triangle"></i> außerhalb</span>':''):'<span class="m">–</span>';
      else val=it.value?'<span style="white-space:pre-wrap">'+escapeHtml(it.value)+'</span>':'<span class="m">–</span>';
      const who=it.checked_at?'<div class="m">'+escapeHtml(it.checked_by||'')+(it.checked_by?' · ':'')+escapeHtml(new Date(it.checked_at).toLocaleString('de-DE',{dateStyle:'short',timeStyle:'short'}))+'</div>':'';
      const docs=(it.doc_images||[]).length?'<div class="dck-imgs">'+it.doc_images.map(i=>dckImg(i,false)).join('')+'</div>':'';
      return '<div class="cp-row"><div>'+escapeHtml(it.label)+who+'</div><div>'+val+dckSpecHtml(it)+'</div><div>'+docs+'</div></div>';
    }).join('');
    card.style.display='';
  }catch(e){card.style.display='none';console.warn('Checklisten-Protokoll',e);}
}
function escapeHtml(s){return String(s||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}

// ── Durchgeführte Maßnahmen + Ersatzteile (Ausführungsformular) ─────────
var MAINT_TASK_ID = '{{.Task.ID}}';
var maPartsCache = null;
function escMa(s){return String(s||'').replace(/[&<>'"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]);});}

async function loadMaintActions(){
  var box = document.getElementById('maint-actions-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/maintenance/tasks/'+MAINT_TASK_ID+'/actions', {credentials:'same-origin'});
    var json = await res.json();
    var actions = json.data || json || [];
    box.innerHTML = actions.length ? actions.map(function(a){
      var t = new Date(a.created_at);
      var timeStr = t.toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escMa(a.description)+'</div><div class="li-sub">'+timeStr+' · '+escMa(a.created_by_name)+'</div></div></div>';
    }).join('') : '<div style="padding:4px 0">Noch keine Maßnahmen erfasst</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function addMaintAction(){
  var input = document.getElementById('ma-new-action');
  var description = input.value.trim();
  if(!description) return;
  try{
    var res = await fetch('/api/v1/maintenance/tasks/'+MAINT_TASK_ID+'/actions', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({description:description})
    });
    var json = await res.json();
    if(!res.ok) throw new Error(json.error||'Fehler');
    input.value='';
    loadMaintActions();
  }catch(e){ alert('Fehler: '+e.message); }
}

async function loadMaintPartsList(){
  var box = document.getElementById('maint-parts-list');
  if(!box) return;
  try{
    var res = await fetch('/api/v1/maintenance/tasks/'+MAINT_TASK_ID+'/pending-parts', {credentials:'same-origin'});
    var json = await res.json();
    var pending = json.data || json || [];
    box.innerHTML = pending.length ? pending.map(function(p){
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escMa(p.part_name)+' <span style="color:var(--muted)">('+escMa(p.part_number)+')</span></div><div class="li-sub">'+p.qty+' Stk · '+escMa(p.storage_name)+'</div></div><button type="button" class="btn" style="font-size:11px;color:var(--red)" onclick="removeMaintPendingPart(THISID)"><i class="ti ti-x"></i></button></div>'.replace('THISID', "'"+p.id+"'");
    }).join('') : '<div style="padding:4px 0">Noch keine Ersatzteile vorgemerkt</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function removeMaintPendingPart(id){
  try{
    var res = await fetch('/api/v1/maintenance/tasks/'+MAINT_TASK_ID+'/pending-parts/'+id, {method:'DELETE', credentials:'same-origin'});
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    loadMaintPartsList();
  }catch(e){ alert('Fehler beim Entfernen: '+e.message); }
}

async function loadMaintPartsCache(){
  if(maPartsCache) return maPartsCache;
  var res = await fetch('/api/v1/inventory/', {credentials:'same-origin'});
  var json = await res.json();
  maPartsCache = json.data || json || [];
  return maPartsCache;
}
async function loadMaintStorageOptions(selectEl){
  try{
    var res = await fetch('/api/v1/storage/', {credentials:'same-origin'});
    var json = await res.json();
    var tree = json.data || json;
    var options = [];
    function walk(nodes, prefix){
      (nodes||[]).forEach(function(n){
        var label = prefix ? prefix+' > '+n.name : n.name;
        options.push({id:n.id, label:label});
        if(n.children && n.children.length) walk(n.children, label);
      });
    }
    walk(Array.isArray(tree) ? tree : (tree.children||[]), '');
    selectEl.innerHTML = '<option value="">Lagerort wählen...</option>' + options.map(function(o){return '<option value="'+o.id+'">'+escMa(o.label)+'</option>';}).join('');
  }catch(e){
    selectEl.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}
function openMaintPartModal(){
  document.getElementById('maint-part-modal').style.display='flex';
  document.getElementById('ma-part-search').value='';
  document.getElementById('ma-part-id').value='';
  document.getElementById('ma-part-selected').textContent='';
  document.getElementById('ma-part-results').style.display='none';
  document.getElementById('ma-part-error').style.display='none';
  document.getElementById('ma-part-qty').value='1';
  loadMaintStorageOptions(document.getElementById('ma-part-location'));
}
function closeMaintPartModal(){ document.getElementById('maint-part-modal').style.display='none'; }
async function filterMaintParts(){
  var q = document.getElementById('ma-part-search').value.trim().toLowerCase();
  var box = document.getElementById('ma-part-results');
  if(!q){ box.style.display='none'; return; }
  var parts = await loadMaintPartsCache();
  var matches = parts.filter(function(p){
    return (p.name||'').toLowerCase().indexOf(q)!==-1 || (p.part_number||'').toLowerCase().indexOf(q)!==-1;
  }).slice(0,20);
  box.innerHTML = matches.length ? matches.map(function(p){
    return '<div style="padding:6px 8px;cursor:pointer;font-size:12px;border-bottom:1px solid var(--border)" onclick="selectMaintPart(\''+p.id+'\',\''+escMa(p.name).replace(/'/g,"\\'")+'\')">'+escMa(p.name)+' <span style="color:var(--muted)">('+escMa(p.part_number)+')</span></div>';
  }).join('') : '<div style="padding:6px 8px;font-size:12px;color:var(--muted)">Keine Treffer</div>';
  box.style.display='block';
}
function selectMaintPart(id,label){
  document.getElementById('ma-part-id').value=id;
  document.getElementById('ma-part-selected').textContent='Ausgewählt: '+label;
  document.getElementById('ma-part-results').style.display='none';
  document.getElementById('ma-part-search').value='';
}
async function bookMaintPart(){
  var partId = document.getElementById('ma-part-id').value;
  var locationId = document.getElementById('ma-part-location').value;
  var qty = parseFloat(document.getElementById('ma-part-qty').value);
  var errEl = document.getElementById('ma-part-error');
  errEl.style.display='none';
  if(!partId){ errEl.textContent='Bitte ein Ersatzteil auswählen'; errEl.style.display='block'; return; }
  if(!locationId){ errEl.textContent='Bitte einen Lagerort auswählen'; errEl.style.display='block'; return; }
  if(!qty || qty<=0){ errEl.textContent='Bitte eine gültige Menge angeben'; errEl.style.display='block'; return; }
  try{
    var res = await fetch('/api/v1/maintenance/tasks/'+MAINT_TASK_ID+'/pending-parts', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({part_id:partId, storage_node_id:locationId, qty:qty})
    });
    var json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    closeMaintPartModal();
    loadMaintPartsList();
  }catch(e){ errEl.textContent='Fehler: '+e.message; errEl.style.display='block'; }
}

if({{if .Task.CanComplete}}true{{else}}false{{end}}){
  if(document.readyState !== 'loading'){ loadMaintActions(); loadMaintPartsList(); openCompleteForm(MAINT_TASK_ID, true); }
  else document.addEventListener('DOMContentLoaded', function(){ loadMaintActions(); loadMaintPartsList(); openCompleteForm(MAINT_TASK_ID, true); });
}
if(document.readyState !== 'loading') loadChecklistProtocol(MAINT_TASK_ID);
else document.addEventListener('DOMContentLoaded', function(){ loadChecklistProtocol(MAINT_TASK_ID); });
</script>
{{end}}
