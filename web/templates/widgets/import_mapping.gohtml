{{/*
Gemeinsame Bausteine der Import-Vorschauen (Excel/CSV, Web/REST, Modbus,
MQTT-Sniffer, OPC UA, SQL): Wert einer Anlage zuordnen, Liste der
Zuordnungen und das Skript dazu. Vorher stand derselbe Code sechsmal da.

  {{template "import-mark-panel" (dict "Title" "Spalte markieren" "SourceLabel" "Spalte")}}
  {{template "import-mappings-table" (dict "Mappings" .Mappings "CanWrite" .CanWrite
      "SourceHeader" "Spalte" "Empty" "Noch keine Spalten markiert." "Mono" false)}}
  {{template "import-mapping-js" (dict "ConnectionID" .ConnectionID)}}

Die Seite oeffnet den Dialog mit importMarkOpen(quellwert).
Optionen der Tabelle: "Intro" (Hinweis oben), "ReceivedLabel" (Standard
"Aktualisiert"), "ShowCreated" (Spalte "Angelegt").
*/}}

{{define "import-mark-panel"}}
<div class="card" id="mark-panel" style="{{if .Style}}{{css .Style}}{{else}}margin-bottom:14px{{end}}" hidden>
  <div class="card-title">{{or .Title "Wert markieren"}}</div>
  <div class="form-group">
    <label class="form-label">{{.SourceLabel}}</label>
    <input id="mark-source" class="form-input" readonly>
  </div>
  {{template "infra-tree-picker" (dict "TargetID" "mark-infra-id" "SelectedLabelID" "mark-infra-selected" "Label" "Infrastruktur" "Required" true)}}
  <div class="form-group">
    <label class="form-label">Bezeichnung</label>
    <input id="mark-name" class="form-input" maxlength="150" placeholder="z.B. Temperatur Halle 1" required>
  </div>
  <div class="form-group">
    <label class="form-label">Zuordnung / Notiz <span style="color:var(--muted);font-weight:400">(optional)</span></label>
    <textarea id="mark-note" class="form-input" maxlength="500" placeholder="z.B. Einheit, Kontext, Verwendungszweck"></textarea>
  </div>
  <div style="display:flex;gap:8px">
    <button type="button" class="btn" id="mark-cancel">Abbrechen</button>
    <button type="button" class="btn btn-primary" id="mark-submit"><i class="ti ti-map-pin"></i> Zuordnung speichern</button>
  </div>
  <p id="mark-error" role="alert" style="font-size:12px;color:var(--red);margin:10px 0 0"></p>
</div>
{{end}}

{{define "import-mappings-table"}}
{{$th := "text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)"}}{{$td := "padding:6px 10px;border-bottom:1px solid var(--border)"}}
<div class="card" style="overflow-x:auto{{if .Intro}};margin-top:14px{{end}}">
  <div class="card-title">Zuordnungen · {{len .Mappings}}</div>
  {{with .Intro}}<p style="font-size:11px;color:var(--muted);margin:0 0 10px">{{.}}</p>{{end}}
  {{if .Mappings}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="{{css $th}}">{{.SourceHeader}}</th>
        <th style="{{css $th}}">Bezeichnung</th>
        <th style="{{css $th}}">Infrastruktur</th>
        <th style="{{css $th}}">Zuordnung</th>
        <th style="{{css $th}}">Letzter Wert</th>
        <th style="{{css $th}};white-space:nowrap">{{or .ReceivedLabel "Aktualisiert"}}</th>
        {{if .ShowCreated}}<th style="{{css $th}};white-space:nowrap">Angelegt</th>{{end}}
      </tr>
    </thead>
    <tbody>
      {{$d := .}}
      {{range .Mappings}}
      <tr data-mapping-id="{{.ID}}" data-mapping-name="{{.Name}}"
          {{if $d.CanWrite}}oncontextmenu="showContextMenu(event, mappingContextItems(this)); return false;"{{end}}>
        <td style="{{css $td}};word-break:break-all{{if $d.Mono}};font-family:monospace{{end}}">{{.SourceRef}}</td>
        <td style="{{css $td}}">{{.Name}}</td>
        <td style="{{css $td}}">{{.InfrastructureName}}</td>
        <td style="{{css $td}}">{{.Note}}</td>
        <td style="{{css $td}};font-family:monospace;word-break:break-all">{{if .LastValue}}{{.LastValue}}{{else}}<span style="color:var(--muted)">–</span>{{end}}</td>
        <td style="{{css $td}};white-space:nowrap">{{if .LastReceivedAt}}{{.LastReceivedAt}}{{else}}<span style="color:var(--muted)">noch kein Wert</span>{{end}}</td>
        {{if $d.ShowCreated}}<td style="{{css $td}};white-space:nowrap">{{.CreatedAt}}</td>{{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:10px 0">{{.Empty}}</div>
  {{end}}
</div>
{{end}}

{{define "import-mapping-js"}}
<script>
// Zuordnungs-Dialog der Import-Vorschauen (widgets/import_mapping.gohtml)
function importMarkOpen(sourceRef){
  const panel = document.getElementById('mark-panel');
  if(!panel) return;
  document.getElementById('mark-source').value = sourceRef;
  document.getElementById('mark-name').value = '';
  document.getElementById('mark-note').value = '';
  document.getElementById('mark-error').textContent = '';
  const pickerRoot = document.querySelector('.infra-picker[data-target="mark-infra-id"]');
  if(pickerRoot) clearInfraPicker(pickerRoot);
  panel.hidden = false;
  panel.scrollIntoView({behavior:'smooth', block:'start'});
}

document.addEventListener('DOMContentLoaded', function(){
  const cancelBtn = document.getElementById('mark-cancel');
  const submitBtn = document.getElementById('mark-submit');
  if(cancelBtn) cancelBtn.addEventListener('click', function(){
    document.getElementById('mark-panel').hidden = true;
  });
  if(submitBtn) submitBtn.addEventListener('click', async function(){
    const errorEl = document.getElementById('mark-error');
    errorEl.textContent = '';
    const payload = {
      source_ref: document.getElementById('mark-source').value,
      infrastructure_id: document.getElementById('mark-infra-id').value,
      name: document.getElementById('mark-name').value.trim(),
      note: document.getElementById('mark-note').value.trim()
    };
    if(!payload.infrastructure_id){ errorEl.textContent = 'Bitte eine Infrastruktur auswählen'; return; }
    if(payload.name.length < 2){ errorEl.textContent = 'Bitte eine Bezeichnung eingeben'; return; }
    submitBtn.disabled = true;
    try{
      const response = await fetch('/import/connections/{{.ConnectionID}}/mappings', {
        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){ return {}; });
      if(!response.ok) throw new Error(result.error || 'Zuordnung konnte nicht gespeichert werden');
      location.reload();
    }catch(e){
      errorEl.textContent = e.message;
      submitBtn.disabled = false;
    }
  });
});

function mappingContextItems(row){
  return [
    {heading: row.dataset.mappingName},
    {label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){
      if(!confirm('Zuordnung "' + row.dataset.mappingName + '" wirklich löschen?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/import/connections/{{.ConnectionID}}/mappings/' + row.dataset.mappingId + '/delete-web';
      document.body.appendChild(form);
      form.submit();
    }}
  ];
}
</script>
{{end}}
