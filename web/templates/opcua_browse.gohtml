{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">OPC-UA-Vorschau · {{.ConnectionName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a></p>
</div>

{{if .Notice}}<div class="card" role="status" style="margin-bottom:14px">{{.Notice}}</div>{{end}}

{{if not .Applicable}}
<div class="card" role="status">
  Diese Verbindung ist keine OPC-UA-Verbindung.
</div>
{{else}}

<div class="card" style="margin-bottom:14px">
  <div class="card-title">Quelle</div>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0">
    <dt style="color:var(--muted)">Endpunkt</dt><dd style="margin:0;word-break:break-all">{{if .EndpointURL}}{{.EndpointURL}}{{else}}<span style="color:var(--red)">nicht konfiguriert</span>{{end}}</dd>
  </dl>
  {{if .CanWrite}}
  <form method="POST" action="/import/connections/{{.ConnectionID}}/nodes/refresh" style="margin-top:12px">
    <button type="submit" class="btn btn-primary"><i class="ti ti-refresh"></i> Alle Zuordnungen aktualisieren</button>
  </form>
  <p style="font-size:11px;color:var(--muted);margin:8px 0 0">Liest für jede Zuordnung den aktuellen Wert ihrer NodeID neu ein.</p>
  {{end}}
</div>

{{if .Error}}
<div class="card" role="alert" style="margin-bottom:14px">
  {{.Error}}
</div>
{{end}}

{{if .Fields}}
<div class="card" style="overflow-x:auto;margin-bottom:14px">
  <div class="card-title">Namespace · {{len .Fields}} Variable(n)</div>
  <p style="font-size:11px;color:var(--muted);margin:0 0 10px">Begrenzt auf die ersten Ebenen/Knoten, damit ein großer Server nicht blockiert.</p>
  <table style="border-collapse:collapse;width:100%;font-size:12px">
    <thead>
      <tr>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Pfad</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">NodeID</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Wert</th>
        {{if .CanWrite}}<th style="text-align:center;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Aktion</th>{{end}}
      </tr>
    </thead>
    <tbody>
      {{range .Fields}}
      <tr>
        <td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">{{.Path}}</td>
        <td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all;font-family:monospace">{{.NodeID}}</td>
        <td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">{{.Value}}</td>
        {{if $.CanWrite}}<td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:center"><button type="button" class="btn-icon" style="width:22px;height:22px;min-width:22px" onclick="markNode('{{.NodeID}}')" title="Wert markieren"><i class="ti ti-map-pin" style="font-size:12px"></i></button></td>{{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
</div>

{{if .CanWrite}}
{{template "import-mark-panel" (dict "Title" "Wert markieren" "SourceLabel" "NodeID")}}
{{end}}
{{else}}
{{if not .Error}}<div class="card" role="status">Keine Variablen im durchsuchten Bereich des Namespace gefunden.</div>{{end}}
{{end}}

{{template "import-mappings-table" (dict "Mappings" .Mappings "CanWrite" .CanWrite "SourceHeader" "NodeID" "Empty" "Noch keine Knoten markiert." "Mono" true)}}
{{end}}
{{end}}

{{define "scripts"}}
<script>
function markNode(nodeID){ importMarkOpen(nodeID); }
</script>
{{template "import-mapping-js" (dict "ConnectionID" .ConnectionID)}}
{{end}}
