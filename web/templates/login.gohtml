<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>PDH – {{t "Anmelden"}}</title>
{{if .Brand.AppLogo}}<link rel="icon" href="{{.Brand.AppLogo}}"><link rel="manifest" href="/site.webmanifest">{{else}}<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">{{end}}
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0f1117;--bg2:#1a1d27;--bg3:#222536;--accent:#4f6ef7;--accent2:#7c3aed;--on-accent:#fff;--text:#e8eaf6;--muted:#6b7280;--border:#2a2d3e;--red:#ef4444;--font:'DM Sans',system-ui,sans-serif}
body{background:var(--bg);color:var(--text);font-family:var(--font);display:flex;align-items:center;justify-content:center;min-height:100vh}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:32px;width:100%;max-width:380px}
.logo{display:flex;align-items:center;gap:12px;margin-bottom:28px}
.logo-icon{width:38px;height:38px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;color:#fff}
.logo-text{font-size:18px;font-weight:600}
.logo-sub{font-size:12px;color:var(--muted)}
h2{font-size:16px;font-weight:500;margin-bottom:20px}
.form-group{margin-bottom:14px}
label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}
input{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:9px 13px;color:var(--text);font-size:14px;font-family:var(--font);outline:0}
input:focus{border-color:var(--accent)}
.btn{width:100%;background:var(--accent);border:0;border-radius:8px;padding:10px;color:var(--on-accent);font-size:14px;font-family:var(--font);cursor:pointer;margin-top:4px}
.btn:hover{opacity:.9}
.langs{display:flex;gap:6px;justify-content:flex-end;margin:-14px -10px 14px 0}
.langs button{background:none;border:1px solid transparent;border-radius:6px;padding:4px;cursor:pointer;line-height:0}
.langs button.on,.langs button:hover{border-color:var(--accent)}
.lang-flag{width:24px;height:16px;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.25)}
.notice{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#6ee7b7;padding:10px;border-radius:8px;font-size:12px;margin-bottom:14px;line-height:1.5}
.hint{font-size:12px;color:var(--muted);margin:-8px 0 16px;line-height:1.5}
.hint-inline{color:var(--muted)}
.rules{font-size:12px;color:var(--muted);margin:0 0 14px 18px;line-height:1.6}
.link{display:block;text-align:center;font-size:12px;color:var(--muted);margin-top:14px;text-decoration:none}
.link:hover{color:var(--accent)}
.error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;padding:10px;border-radius:8px;font-size:12px;margin-bottom:14px}
</style>
<style>{{.Brand.ThemeCSS}}</style>
{{with .Brand.DefaultLook.FontHref}}<link rel="stylesheet" href="{{.}}">{{end}}
<style>{{.Brand.DefaultLook.CSS}} body{zoom:var(--ui-scale)}</style>
<!-- Farbschema: Firmenstandard (Anmeldeseite immer dunkel) -->
<script>document.documentElement.dataset.palette = {{.Brand.ThemeID}};</script>
</head>
<body>
<div class="card">
  <form class="langs" method="post" action="/lang" aria-label="{{t "Sprache"}}">
    <input type="hidden" name="back" value="{{if eq .Mode "forgot"}}/login/forgot{{else if eq .Mode "change"}}/login/change{{else}}/login{{end}}">
    {{$cur := lang}}{{range langs}}<button type="submit" name="lang" value="{{.Code}}" title="{{.Name}}" aria-label="{{.Name}}"{{if eq .Code $cur}} class="on" aria-current="true"{{end}}>{{template "lang-flag" .Code}}</button>{{end}}
  </form>
  <div class="logo">
    {{if .Brand.AppLogo}}<img src="{{.Brand.AppLogo}}" alt="" style="width:38px;height:38px;object-fit:contain;border-radius:8px">{{else}}<div class="logo-icon">P</div>{{end}}
    <div><div class="logo-text">{{or .Brand.AppName "PDH"}}</div><div class="logo-sub">Prozess Data Hub</div></div>
  </div>
  {{if eq .Mode "forgot"}}
  <h2>{{t "Passwort vergessen"}}</h2>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  {{if .Notice}}<div class="notice">{{.Notice}}</div>
  {{else}}
  <p class="hint">{{t "Gib deine E-Mail-Adresse oder deinen Benutzernamen ein. Du bekommst einen Link, mit dem du ein neues Passwort vergibst."}}</p>
  <form method="POST" action="/login/forgot">
    <div class="form-group">
      <label>{{t "E-Mail oder Benutzername"}}</label>
      <input type="text" name="email" placeholder="{{t "name@beispiel.de oder Benutzername"}}" required autofocus autocomplete="username">
    </div>
    <button type="submit" class="btn">{{t "Link anfordern"}} →</button>
  </form>
  {{end}}
  <a class="link" href="/login">← {{t "Zurück zur Anmeldung"}}</a>
  {{else if eq .Mode "reset"}}
  <h2>{{t "Neues Passwort vergeben"}}</h2>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  <form method="POST" action="/login/reset">
    <input type="hidden" name="token" value="{{.Token}}">
    <div class="form-group">
      <label>{{t "Neues Passwort"}}</label>
      <input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password" autofocus>
    </div>
    <div class="form-group">
      <label>{{t "Neues Passwort wiederholen"}}</label>
      <input type="password" name="password2" required minlength="8" maxlength="72" autocomplete="new-password">
    </div>
    {{template "login-rules" .Rules}}
    <button type="submit" class="btn">{{t "Passwort speichern"}} →</button>
  </form>
  <a class="link" href="/login">← {{t "Zurück zur Anmeldung"}}</a>
  {{else if eq .Mode "change"}}
  <h2>{{t "Passwort ändern"}}</h2>
  {{if .Notice}}<div class="notice">{{.Notice}}</div>{{end}}
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  <p class="hint">{{t "Erst mit dem neuen Passwort geht es weiter. Merke es dir gut – ab jetzt meldest du dich damit an."}}</p>
  <form method="POST" action="/login/change">
    <input type="hidden" name="next" value="{{.Next}}">
    <div class="form-group">
      <label>{{t "Neues Passwort"}}</label>
      <input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password" autofocus>
    </div>
    <div class="form-group">
      <label>{{t "Neues Passwort wiederholen"}}</label>
      <input type="password" name="password2" required minlength="8" maxlength="72" autocomplete="new-password">
    </div>
    {{template "login-rules" .Rules}}
    <button type="submit" class="btn">{{t "Passwort speichern"}} →</button>
  </form>
  <a class="link" href="/login">← {{t "Zurück zur Anmeldung"}}</a>
  {{else}}
  <h2>{{t "Anmelden"}}</h2>
  {{if .Error}}<div class="error">{{.Error}}</div>{{end}}
  {{if .Notice}}<div class="notice">{{.Notice}}</div>{{end}}
  {{if .Next}}<div class="notice">{{t "Nach der Anmeldung geht es direkt weiter zur gescannten Seite."}}</div>{{end}}
  <form method="POST" action="/login">
    {{if .Next}}<input type="hidden" name="next" value="{{.Next}}">{{end}}
    <div class="form-group">
      <label>{{t "E-Mail oder Benutzername"}}</label>
      <input type="text" name="email" placeholder="{{t "name@beispiel.de oder Benutzername"}}" required autofocus>
    </div>
    <div class="form-group">
      <label>{{t "Passwort"}}</label>
      <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
    </div>
    <button type="submit" class="btn">{{t "Anmelden"}} →</button>
  </form>
  <a class="link" href="/login/forgot">{{t "Passwort vergessen?"}}</a>
  <div style="display:flex;align-items:center;gap:10px;margin:18px 0;color:var(--muted);font-size:11px">
    <div style="flex:1;height:1px;background:var(--border)"></div>{{t "ODER"}}<div style="flex:1;height:1px;background:var(--border)"></div>
  </div>
  <form method="POST" action="/login/rfid" onsubmit="return true">
    {{if .Next}}<input type="hidden" name="next" value="{{.Next}}">{{end}}
    <div class="form-group">
      <label>{{t "RFID-Karte"}}</label>
      <input type="text" name="uid" id="rfid-input" placeholder="{{t "Karte an den Leser halten …"}}" autocomplete="off">
    </div>
  </form>
  <script>
    // Die meisten RFID-Leser tippen die UID gefolgt von Enter/Return wie
    // eine Tastatur - das Formular sendet sich dadurch von selbst ab,
    // sobald die Karte gescannt wurde.
    var rfidInput = document.getElementById('rfid-input');
    rfidInput.addEventListener('keydown', function(e){
      if(e.key === 'Enter'){ e.preventDefault(); this.form.submit(); }
    });
  </script>
  {{end}}
</div>
</body>
</html>
{{define "login-rules"}}{{if .}}<div class="hint-inline" style="font-size:12px;margin-bottom:4px">{{t "Das Passwort braucht:"}}</div><ul class="rules">{{range .}}<li>{{.}}</li>{{end}}</ul>{{end}}{{end}}
