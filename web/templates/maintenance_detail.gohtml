{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
  {{template "icon-button" (dict "Action" "back" "Href" "/maintenance")}}
  <div style="flex:1">
    <h1 style="font-size:18px;font-weight:600">{{.Task.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">
      {{.Task.TypeLabel}} · fällig {{.Task.DueDate}}{{if .Task.InfraName}} · {{.Task.InfraName}}{{end}}
    </p>
  </div>
  <span class="badge {{.Task.PriorityClass}}" style="font-size:12px;padding:4px 12px">{{.Task.Priority}}</span>
  <span class="badge {{.Task.StatusClass}}" style="font-size:12px;padding:4px 12px">{{.Task.StatusLabel}}</span>
  <div class="widget-icon-toolbar compact">
    {{template "icon-button" (dict "Action" "edit" "OnClick" "toggleEdit();closeMenu('maint-menu')")}}
    {{if .Task.CanComplete}}
    {{template "icon-button" (dict "Action" "done" "Label" "Abschließen" "OnClick" (printf "openCompleteForm('%s')" .Task.ID))}}
    {{end}}
    {{if .Task.CanStart}}
    {{template "icon-button" (dict "Action" "start" "HxPost" (printf "/maintenance/tasks/%s/start-web" .Task.ID) "HxOnAfterRequest" "location.reload()")}}
    {{end}}
  <form method="POST" action="/maintenance/tasks/{{.Task.ID}}/delete-web" onsubmit="return confirm('Auftrag löschen?')">
    {{template "icon-button" (dict "Action" "delete" "Type" "submit" "Label" "Löschen")}}
  </form>
  </div>
</div>

<!-- Bearbeiten -->
<div id="edit-form" style="display:none" class="card">
  <div class="card-title">Auftrag bearbeiten</div>
  <form hx-put="/maintenance/tasks/{{.Task.ID}}/edit-web" hx-target="#edit-result" hx-swap="innerHTML">
    <div class="grid2">
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Titel</label><input name="title" class="form-input" value="{{.Task.Title}}" required></div>
      <div class="form-group"><label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low" {{if eq .Task.Priority "low"}}selected{{end}}>Low</option>
          <option value="medium" {{if eq .Task.Priority "medium"}}selected{{end}}>Medium</option>
          <option value="high" {{if eq .Task.Priority "high"}}selected{{end}}>High</option>
          <option value="critical" {{if eq .Task.Priority "critical"}}selected{{end}}>Critical</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Fällig am</label><input name="due_date" type="date" class="form-input" value="{{.Task.DueDateISO}}"></div>
      {{template "infra-tree-picker" (dict "TargetID" "task-infra-id" "SelectedLabelID" "task-infra-selected" "Label" "Infrastruktur" "Value" .Task.InfraID "SelectedLabel" .Task.InfraName)}}
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Beschreibung</label><textarea name="description" class="form-input" rows="3" style="resize:vertical">{{.Task.Description}}</textarea></div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Notizen</label><textarea name="notes" class="form-input" rows="2" style="resize:vertical">{{.Task.Notes}}</textarea></div>
    </div>
    <div id="edit-result" style="margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Auftrag bearbeiten"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "toggleEdit()")
        (dict "Action" "save" "ShowLabel" true "Type" "submit")
      )
    )}}
  </form>
</div>

<!-- Abschließen -->
{{if .Task.CanComplete}}
<div id="complete-form" style="display:none" class="card">
  <div class="card-title">Auftrag durchführen und abschließen</div>
  <form onsubmit="return submitMaintenanceCompletion(this,'{{.Task.ID}}')">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Dauer (Minuten)</label><input id="complete-duration" name="duration_min" type="number" class="form-input" placeholder="Standarddauer wird geladen" min="0"></div>
      <div class="form-group"><label class="form-label">Abschlussnotiz</label><input name="notes" class="form-input" placeholder="Was wurde gemacht?"></div>
    </div>
    <div id="due-checklist-box" style="margin:10px 0;font-size:12px;color:var(--muted)">Fällige Checklistenpunkte werden geladen...</div>
    <div class="card" style="background:var(--bg3);margin:10px 0;padding:12px">
      <div style="font-size:12px;font-weight:600;margin-bottom:8px">Nach Abschluss</div>
      <label style="display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted);margin-bottom:6px"><input type="checkbox" name="ask_inventory" checked> Nach verwendeten Ersatzteilen fragen</label>
      <label style="display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted)"><input type="checkbox" name="ask_time" checked> Nach Zeiteintrag fragen / Dauer übernehmen</label>
    </div>
    <div id="complete-result" style="font-size:12px;margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Auftrag abschließen"
      "Style" "width:100%;justify-content:flex-end"
      "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('complete-form').style.display='none'")
        (dict "Action" "done" "ShowLabel" true "Type" "submit" "Label" "Abschließen")
      )
    )}}
  </form>
</div>
{{end}}

<div class="grid2" style="grid-template-columns:1fr 300px;gap:14px;align-items:start">
  <div>
    {{if eq .Task.Status "done"}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:32px;height:32px;background:rgba(16,185,129,.15);border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="ti ti-check" style="color:var(--green);font-size:18px"></i></div>
        <div><div style="font-weight:500;color:var(--green)">Abgeschlossen {{.Task.CompletedAt}}</div>
        {{if .Task.DurationStr}}<div style="font-size:12px;color:var(--muted)">Dauer: {{.Task.DurationStr}}</div>{{end}}</div>
      </div>
      {{if .Task.Notes}}<p style="font-size:13px;color:var(--muted);margin-top:10px;line-height:1.6">{{.Task.Notes}}</p>{{end}}
    </div>
    {{end}}
    {{if eq .Task.Status "in_progress"}}
    <div class="card" style="border-color:rgba(79,110,247,.3)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:32px;height:32px;background:rgba(79,110,247,.15);border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="ti ti-loader" style="color:var(--accent);font-size:18px"></i></div>
        <div><div style="font-weight:500;color:var(--accent)">In Bearbeitung{{if .Task.StartedAt}} seit {{.Task.StartedAt}}{{end}}</div></div>
      </div>
    </div>
    {{end}}
    {{if .Task.Description}}
    <div class="card">
      <div class="card-title"><i class="ti ti-file-description" style="color:var(--accent)"></i> Beschreibung</div>
      <p style="font-size:13px;line-height:1.7;color:var(--muted)">{{.Task.Description}}</p>
    </div>
    {{end}}
    {{if .Task.CanStart}}
    <div class="card" style="text-align:center;padding:24px">
      <i class="ti ti-player-play" style="font-size:32px;color:var(--muted);display:block;margin-bottom:10px;opacity:.5"></i>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Auftrag noch nicht gestartet</p>
      {{template "icon-button" (dict "Action" "start" "ShowLabel" true "Label" "Auftrag starten" "HxPost" (printf "/maintenance/tasks/%s/start-web" .Task.ID) "HxOnAfterRequest" "location.reload()")}}
    </div>
    {{end}}
    <!-- Zeiterfassung -->
    <div class="card">
      <div class="card-title"><i class="ti ti-clock"></i> Zeiterfassung</div>
      {{if .Running}}
      <div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:10px;margin-bottom:10px">
        <div style="font-size:12px;color:var(--green);font-weight:500">⏱ Läuft seit {{.Running.StartedAt.Format "15:04"}}</div>
      </div>
      {{template "icon-button" (dict "Action" "stop" "ShowLabel" true "Label" "Zeit stoppen" "Style" "width:100%;justify-content:center;margin-bottom:8px" "HxPost" (printf "/time/%s/stop-web" .Running.ID) "HxOnAfterRequest" "location.reload()")}}
      {{else}}
      {{template "icon-button" (dict "Action" "start" "ShowLabel" true "Label" "Zeit erfassen" "Style" "width:100%;justify-content:center;margin-bottom:8px" "HxPost" (printf "/maintenance/tasks/%s/time/start" .Task.ID) "HxTarget" "#time-result")}}
      {{end}}
      <div id="time-result"></div>
      {{range .TimeEntries}}
      <div class="li">
        <div class="li-text"><div class="li-title" style="font-size:12px">{{.Description}}</div><div class="li-sub">{{.UserName}} · {{.StartedAt.Format "02.01. 15:04"}}</div></div>
        <span style="font-size:12px;color:var(--green);font-weight:500">{{if .DurationMin}}{{.DurationMin}}min{{else}}läuft…{{end}}</span>
      </div>
      {{else}}<div style="font-size:12px;color:var(--muted);padding:4px 0">Keine Zeiteinträge</div>{{end}}
    </div>

    <!-- Checkliste -->
    {{if .ChecklistItems}}
    <div class="card">
      <div class="card-title"><i class="ti ti-checklist" style="color:var(--accent)"></i> Checkliste</div>
      <form method="POST" action="/maintenance/tasks/{{.Task.ID}}/checklist">
        {{range .ChecklistItems}}
        <div class="li" style="flex-direction:column;align-items:stretch;gap:6px;padding:10px 0">
          <div style="display:flex;align-items:center;gap:8px">
            <div style="font-size:13px;font-weight:500;flex:1">
              {{if .Required}}<span style="color:var(--red);font-size:10px">✱</span> {{end}}{{.Label}}
            </div>
            <span style="font-size:10px;color:var(--muted)">{{.Type}}</span>
          </div>
          {{if eq .Type "checkbox"}}
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px">
            <input type="checkbox" name="item_{{.ID}}" value="1" style="width:16px;height:16px">
            <span style="color:var(--muted)">Erledigt</span>
          </label>
          {{else if eq .Type "number"}}
          <div style="display:flex;align-items:center;gap:8px">
            <input type="number" name="item_{{.ID}}" class="form-input" style="max-width:160px" placeholder="Messwert eingeben" {{if .CompareValue}}step="0.01"{{end}}>
            {{if .CompareUnit}}<span style="font-size:12px;color:var(--muted)">{{.CompareUnit}}</span>{{end}}
          </div>
          {{else if eq .Type "image"}}
          <label style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)">
            <i class="ti ti-camera"></i>Foto aufnehmen
            <input type="file" accept="image/*" capture="environment" name="item_{{.ID}}" style="display:none">
          </label>
          {{else}}
          <input type="text" name="item_{{.ID}}" class="form-input" placeholder="{{.Label}}">
          {{end}}
        </div>
        {{end}}
        {{template "icon-button-toolbar" (dict
          "Class" "end"
          "Label" "Checkliste"
          "Style" "width:100%;justify-content:flex-end;padding-top:10px;border-top:1px solid var(--border)"
          "Items" (list
            (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Checkliste speichern")
          )
        )}}
      </form>
    </div>
    {{end}}
    <!-- Anhänge -->
    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos & Dokumente</div>
      <div id="attachments-{{.Task.ID}}" data-attach-ref="maintenance_task:{{.Task.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)"><i class="ti ti-photo"></i>Galerie<input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-size:12px;color:var(--muted)"><i class="ti ti-camera"></i>Kamera<input type="file" accept="image/*" capture="environment" style="display:none" onchange="uploadFiles(this,'maintenance_task','{{.Task.ID}}')"></label>
      </div>
    </div>

    {{template "record-history" .History}}
  </div>
  <!-- Details -->
  <div>
    <div class="card">
      <div class="card-title">Details</div>
      {{if .Task.RecordImageURL}}
      <img src="{{.Task.RecordImageURL}}" alt="Datensatzbild" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px;border:1px solid var(--border);margin-bottom:12px">
      {{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Typ</div><div class="li-title">{{.Task.TypeLabel}}</div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Priorität</div><div class="li-title"><span class="badge {{.Task.PriorityClass}}">{{.Task.Priority}}</span></div></div></div>
      <div class="li"><div class="li-text"><div class="li-sub">Status</div><div class="li-title"><span class="badge {{.Task.StatusClass}}">{{.Task.StatusLabel}}</span></div></div></div>
      {{if .Task.InfraName}}<div class="li"><div class="li-text"><div class="li-sub">Infrastruktur</div><div class="li-title"><a href="/infrastructure/{{.Task.InfraID}}" style="color:var(--accent)">{{.Task.InfraName}}</a></div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Fällig am</div><div class="li-title" style="{{if eq .Task.Status "open"}}color:var(--amber){{end}}">{{.Task.DueDate}}</div></div></div>
      {{if .Task.AssigneeName}}<div class="li"><div class="li-text"><div class="li-sub">Zugewiesen</div><div class="li-title">{{.Task.AssigneeName}}</div></div></div>{{end}}
      {{if .Task.DurationStr}}<div class="li"><div class="li-text"><div class="li-sub">Dauer</div><div class="li-title" style="font-weight:600;color:var(--green)">{{.Task.DurationStr}}</div></div></div>{{end}}
      <div class="li"><div class="li-text"><div class="li-sub">Erstellt</div><div class="li-title" style="font-size:12px;color:var(--muted)">{{.Task.CreatedAt}}</div></div></div>
      <form hx-put="/records/maintenance_task/{{.Task.ID}}/people" hx-target="#people-result-task" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div class="form-group">
          <label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input">
            <option value="">Nicht gesetzt</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Zugewiesen</label>
          <select name="assigned_to" class="form-input">
            <option value="">Nicht zugewiesen</option>
            {{range .Users}}<option value="{{.ID}}" {{if eq .ID $.Task.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}
          </select>
        </div>
        <div id="people-result-task" style="font-size:12px;margin-bottom:8px"></div>
        {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Style" "width:100%;justify-content:center")}}
      </form>
    </div>
    {{if .Task.CanComplete}}
    <div class="card">
      {{template "icon-button" (dict "Action" "done" "ShowLabel" true "Label" "Als erledigt markieren" "Style" "width:100%;justify-content:center" "OnClick" (printf "openCompleteForm('%s');window.scrollTo({top:0,behavior:'smooth'})" .Task.ID))}}
    </div>
    {{end}}
  </div>
</div>
{{end}}

{{define "context-list"}}
<div style="font-size:11px;color:var(--muted);margin-bottom:6px">Auftrag</div>
<div class="act-item"><div class="act-dot {{.Task.PriorityDot}}"></div><div class="act-text">{{.Task.Title}}</div><span class="badge {{.Task.StatusClass}}" style="font-size:9px">{{.Task.StatusLabel}}</span></div>
{{range .TimeEntries}}<div class="act-item"><div class="act-dot d-green"></div><div class="act-text">{{.UserName}}</div><span style="font-size:10px;color:var(--muted)">{{if .DurationMin}}{{.DurationMin}}min{{else}}läuft{{end}}</span></div>{{end}}
{{end}}

{{block "scripts" .}}
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){const el=document.getElementById(id); if(el) el.style.display='none';}
document.addEventListener('click',e=>{if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id$="-menu"]'))document.querySelectorAll('[id$="-menu"]').forEach(m=>m.style.display='none');});
function toggleEdit(){const f=document.getElementById('edit-form');f.style.display=f.style.display==='none'?'block':'none';if(f.style.display==='block')f.scrollIntoView({behavior:'smooth',block:'nearest'});}
async function apiData(url, options){const res=await fetch(url,Object.assign({credentials:'same-origin'},options||{}));let payload=null;try{payload=await res.json();}catch(e){payload=null;}if(!res.ok)throw new Error((payload&&(payload.error||payload.message))||('HTTP '+res.status));return payload&&payload.data!==undefined?payload.data:payload;}
async function openCompleteForm(taskID){const box=document.getElementById('complete-form');box.style.display='block';box.scrollIntoView({behavior:'smooth',block:'nearest'});await loadDefaultDuration(taskID);await loadDueChecklist(taskID);}
async function loadDefaultDuration(taskID){try{const d=await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/default-duration');const input=document.getElementById('complete-duration');if(input && !input.value && d && d.default_duration_min>0)input.value=d.default_duration_min;}catch(e){console.warn(e);}}
async function loadDueChecklist(taskID){const box=document.getElementById('due-checklist-box');try{const items=await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/due-checklist');if(!items||items.length===0){box.innerHTML='<div style="padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--muted)">Keine fälligen Vorlagen-Checklistenpunkte.</div>';return;}box.innerHTML='<div class="card-title" style="margin:0 0 8px 0"><i class="ti ti-checklist"></i> Fällige Checklistenpunkte</div>'+items.map(renderDueChecklistItem).join('');}catch(e){box.innerHTML='<div style="color:var(--red)">Fällige Checkliste konnte nicht geladen werden: '+escapeHtml(e.message)+'</div>';}}
function renderDueChecklistItem(item){const req=item.required?'<span style="color:var(--red);font-size:10px">✱</span> ':'';const last=item.last_done_at?'<div style="font-size:10px;color:var(--muted)">Zuletzt: '+escapeHtml(item.last_done_at)+'</div>':'';let input='';if(item.item_type==='number'){input='<input type="number" step="0.01" class="form-input due-check-value" data-item-id="'+escapeHtml(item.template_item_id)+'" placeholder="Messwert">';}else if(item.item_type==='text'){input='<input type="text" class="form-input due-check-value" data-item-id="'+escapeHtml(item.template_item_id)+'" placeholder="Wert / Notiz">';}else{input='<label style="display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted)"><input type="checkbox" class="due-check-done" data-item-id="'+escapeHtml(item.template_item_id)+'"> erledigt</label><input type="hidden" class="due-check-value" data-item-id="'+escapeHtml(item.template_item_id)+'" value="erledigt">';}return '<div class="li" style="flex-direction:column;align-items:stretch;gap:6px"><div style="display:flex;gap:8px"><div style="flex:1;font-weight:500;font-size:13px">'+req+escapeHtml(item.label)+'</div><span class="badge b-gray" style="font-size:10px">'+escapeHtml(item.interval_days)+' Tage</span></div>'+last+input+'</div>';}
async function submitMaintenanceCompletion(form,taskID){const result=document.getElementById('complete-result');result.textContent='Speichere Checkliste...';try{const values={};const done={};document.querySelectorAll('#due-checklist-box .due-check-value').forEach(i=>{values[i.dataset.itemId]=i.value||'';});document.querySelectorAll('#due-checklist-box .due-check-done').forEach(i=>{done[i.dataset.itemId]=i.checked;});if(Object.keys(values).length>0){await apiData('/api/v1/maintenance-checklists/tasks/'+taskID+'/checklist-results',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values,done})});}result.textContent='Schließe Auftrag ab...';const res=await fetch('/maintenance/tasks/'+taskID+'/complete-web',{method:'POST',headers:{'HX-Request':'true'},body:new FormData(form),credentials:'same-origin'});const text=await res.text();if(!res.ok)throw new Error(text.replace(/<[^>]*>/g,'').trim()||'Abschluss fehlgeschlagen');const askInv=form.querySelector('[name="ask_inventory"]')?.checked;const askTime=form.querySelector('[name="ask_time"]')?.checked;if(askInv||askTime){let msg='Auftrag abgeschlossen. ';if(askInv)msg+='Bitte verwendete Ersatzteile im Ersatzteillager buchen. ';if(askTime)msg+='Zeiteintrag/Dauer bitte in der Zeiterfassung prüfen.';alert(msg);}location.reload();}catch(e){result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>';}return false;}
function escapeHtml(s){return String(s||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
</script>
{{end}}
