{{template "base" .}}
{{define "content"}}
<style>
.hb{display:grid;grid-template-columns:240px 1fr;gap:18px;align-items:start}
.hb-toc{position:sticky;top:0;max-height:calc(100vh - 140px);overflow-y:auto;background:var(--bg2);border:1px solid var(--stroke,var(--border));border-radius:8px;padding:8px;box-shadow:var(--shadow-card,none)}
.hb-toc a{display:block;position:relative;padding:6px 10px;border-radius:4px;font-size:12.5px;color:var(--text);opacity:.85}
.hb-toc a:hover{background:var(--fill-hover,var(--bg3));opacity:1}
.hb-toc a.active{background:var(--fill-hover,var(--bg3));opacity:1;font-weight:600}
.hb-toc a.active::before{content:"";position:absolute;left:0;top:50%;width:3px;height:14px;margin-top:-7px;border-radius:2px;background:var(--accent)}
.hb-toc .n{display:inline-block;width:22px;color:var(--muted)}
.hb-body{min-width:0}
.hb-ch{background:var(--bg2);border:1px solid var(--stroke,var(--border));border-radius:8px;box-shadow:var(--shadow-card,none);padding:18px 22px;margin-bottom:14px;scroll-margin-top:12px}
.hb-ch h2{font-size:17px;font-weight:600;margin-bottom:10px;display:flex;gap:8px;align-items:center}
.hb-ch h2 i{color:var(--accent)}
.hb-ch h3{font-size:13.5px;font-weight:600;margin:16px 0 6px;display:flex;gap:6px;align-items:center}
.hb-ch p,.hb-ch li{font-size:13px;line-height:1.6}
.hb-ch p{margin:6px 0}
.hb-ch ul,.hb-ch ol{margin:6px 0 6px 20px}
.hb-ch li{margin:2px 0}
.hb-ch code{font-family:monospace;background:var(--bg3);padding:1px 5px;border-radius:4px;font-size:12px}
.hb-ch kbd{font-family:monospace;font-size:11.5px;border:1px solid var(--border);border-bottom-width:2px;border-radius:4px;padding:0 5px;background:var(--bg3)}
.hb-ch table{font-size:12.5px;margin:8px 0}
.hb-ch td,.hb-ch th{padding:5px 8px;vertical-align:top}
.hb-ch pre{font-family:monospace;font-size:12px;line-height:1.5;background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:8px 10px;margin:6px 0;overflow-x:auto;white-space:pre;max-width:100%}
.hb-hide{display:none}
mark{background:rgba(245,158,11,.35);color:inherit;border-radius:3px}
@media (max-width:900px){.hb{grid-template-columns:1fr}.hb-toc{position:static;max-height:none}}
@media print{
  .sidebar,.context,.topbar,.hb-toc,.hb-tools,.global-footer,.hb-shot-tools{display:none!important}
  .app{display:block!important}.main{overflow:visible!important;padding:0!important}
  body{height:auto!important;overflow:visible!important;background:#fff;color:#000}
  .hb{display:block}.hb-ch{border:0;padding:0 0 12px}
  .hb-fig,.hb-howto{break-inside:avoid}
  .hb-ch pre{white-space:pre-wrap;overflow:visible}
  .hb-hide{display:block!important}
}
</style>

<div class="rec-head hb-tools">
  <div class="t">
    <h1><i class="ti ti-book"></i> PDH-Handbuch</h1>
    <div class="sub">Schritt für Schritt durch alle Module{{if .Version}} · Stand Version {{.Version}}{{end}} · Abschnitte mit <i class="ti ti-refresh"></i> erzeugt das System automatisch</div>
  </div>
  <div class="search-box" style="min-width:260px">
    <i class="ti ti-search" style="color:var(--muted)"></i>
    <input id="hb-q" type="search" placeholder="Im Handbuch suchen …" style="flex:1;background:none;border:0;outline:0;color:var(--text);font-size:13px;font-family:var(--font)">
  </div>
  <button type="button" class="btn btn-small" onclick="window.print()"><i class="ti ti-printer"></i> Drucken / PDF</button>
</div>

<div class="hb">
  <nav class="hb-toc hb-tools" id="hb-toc" aria-label="Inhaltsverzeichnis"></nav>
  <div class="hb-body" id="hb-body">
    {{template "help-chapters" .}}
    <div id="hb-none" class="hb-ch" style="display:none;text-align:center;color:var(--muted)">Keine Treffer.</div>
  </div>
</div>
{{end}}

{{/* Eigene Bildschirmfotos je Kapitel (Anhaenge mit fester Kapitel-UUID) */}}
{{define "hb-shots"}}
<div class="hb-shots">
  <div data-attach-ref="help:{{.Ref}}" style="display:flex;flex-wrap:wrap;gap:8px;min-height:0"></div>
  {{if .Can}}
  <label class="btn btn-small hb-shot-tools" style="cursor:pointer;margin-top:6px"><i class="ti ti-photo-plus"></i> Bildschirmfoto zu diesem Kapitel hinzufügen
    <input type="file" accept="image/*" multiple style="display:none" onchange="uploadFiles(this,'help','{{.Ref}}')"></label>
  {{end}}
</div>
{{end}}

{{define "help-chapters"}}
{{template "hb-fig-style"}}
{{$s := .Shots}}{{$can := .CanShots}}

<section class="hb-ch" id="start" data-title="Erste Schritte" data-pages="dashboard account">
  <h2><i class="ti ti-rocket"></i> Erste Schritte</h2>
  <p>Der <b>PDH – Pulse Data Hub</b> ist das gemeinsame Werkzeug für Instandhaltung, Lager und Einkauf: Hier werden Störungen gemeldet und gelöst, Wartungen geplant, Ersatzteile verwaltet und im Team gechattet.</p>
  <div class="hb-howto"><b><i class="ti ti-map-2"></i> Rundgang durch PDH</b>Ein geführter Rundgang zeigt dir in zwei Minuten das Wichtigste – Sprechblasen erklären Navigation, Dashboard, Melden, Seitenleiste und dein Konto.
    <ol class="hb-steps">
      <li>Starten: <button type="button" class="btn btn-small btn-primary" onclick="pdhTour.start('basics')"><i class="ti ti-map-2"></i> Rundgang starten</button> – oder oben im Benutzermenü <b>Rundgang durch PDH</b>. Beim ersten Besuch bietet das Dashboard ihn einmal von selbst an.</li>
      <li><b>Weiter</b> (oder Pfeil rechts) führt zum nächsten Schritt, <b>Zurück</b> (Pfeil links) zum vorigen. <b>Beenden</b> oder Esc bricht jederzeit ab.</li>
      <li>Für einzelne Seiten gibt es eigene Rundgänge – <b>Dashboard</b>, <b>Störungen</b> und <b>Wartung</b>: rechts im Hilfe-Reiter <b>Rundgang für diese Seite</b>. Auf Seiten ohne eigenen Rundgang startet dort der allgemeine.</li>
    </ol></div>
  {{template "hb-fig-layout"}}
  <h3><i class="ti ti-map"></i> So findest du dich zurecht</h3>
  <ul>
    <li><b>Links</b> wählst du das Modul, z. B. Störungen oder Ersatzteile. Die Einträge sind in Gruppen sortiert (Instandhaltung, Material &amp; Anlagen, Personal, Verwaltung, Daten, Hilfe &amp; Links); offen ist immer nur die Gruppe der geöffneten Seite – ein Klick auf eine andere Überschrift klappt diese auf und die übrigen zu.</li>
    <li><b>Navigation anpassen</b> (oben im Benutzermenü): Einträge per Ziehen in andere Gruppen oder eine andere Reihenfolge bringen, ganze Gruppen mit <i class="ti ti-arrow-up"></i> <i class="ti ti-arrow-down"></i> nach oben oder unten verschieben, Gruppennamen anklicken zum Umbenennen, mit <b>Gruppe</b> eigene Gruppen anlegen, mit <i class="ti ti-trash"></i> löschen (die Einträge wandern nach oben). <b>Fertig</b> speichert die Anordnung an deinem Konto – sie gilt auf jedem Gerät; <b>Standard</b> stellt den Firmenstandard wieder her (siehe <a href="#admin">Standards für alle</a>). Neue Funktionen erscheinen automatisch in ihrer Vorgabe-Gruppe.</li>
    <li><b>Oben</b> findest du die <b>Uhr</b> mit Wochentag und Datum, daneben kleine Symbolknöpfe in Gruppen: <i class="ti ti-share"></i> Im Chat teilen, <i class="ti ti-messages"></i> Chat und <i class="ti ti-brain"></i> Copilot, dann <i class="ti ti-device-desktop"></i> Hell/Dunkel und die Sprache, ganz rechts dein Konto. Was ein Knopf tut, zeigt ein kurzer Hinweis, wenn du mit der Maus darauf zeigst. Uhr und Benutzermenü sind immer sichtbar. Ist der Bildschirm zu schmal (Smartphone, große Schrift), blendet PDH die übrigen Knöpfe der Reihe nach aus. „Im Chat teilen“, „Hell/Dunkel“ und „Suche, Hilfe &amp; mehr“ findest du dann im Benutzermenü, Chat und Copilot als Reiter in der rechten Seitenleiste. Ein Klick auf die Uhr öffnet die <b>Zeiterfassung</b>; fährst du mit der Maus darüber, siehst du auch die Kalenderwoche.</li>
    <li><b>Rechts</b> liegen senkrechte Reiter (Chat, Suche, Copilot, Aktivität, Hilfe). Ein Klick klappt die Leiste auf, ein zweiter wieder zu.</li>
    <li><b>Wer ist online?</b> Der Reiter <b>Aktivität</b> zeigt oben alle, die PDH gerade geöffnet haben (grüner Punkt), darunter aufklappbar die übrigen mit „zuletzt gesehen“ (z. B. „vor 20 Min.“, „gestern 14:10“). Die Liste aktualisiert sich alle 30 Sekunden; Terminals (Systembenutzer) erscheinen nicht.</li>
    <li><b>Nur was du darfst:</b> Die Navigation zeigt einen Bereich nur, wenn du dort wenigstens ein Recht hast. Ohne Recht für Tickets, Störungen, Wartung, Aufgaben, Kalender, Ersatzteile und Lager, IT-Assets oder Hersteller &amp; Lieferanten fehlt der Eintrag ganz. Fehlt dir einer, fragt dein Administrator unter <b>Rollen &amp; Rechte</b> nach.</li>
    <li><b>Breite ändern:</b> Mit der Maus an den Innenrand der Navigation oder der aufgeklappten rechten Seitenleiste fahren – der Rand färbt sich, der Mauszeiger wird zu <b>↔</b>. Dann ziehen. Dein Browser merkt sich die Breite. <b>Doppelklick</b> auf den Rand stellt die Standardbreite wieder her. Mit der Tastatur: Rand mit Tab anwählen, dann Pfeiltasten. Auf Smartphone und Tablet entfällt das, dort fahren die Leisten über den Inhalt.</li>
    <li>Der <b>Hilfe-Reiter</b> rechts zeigt dir immer das passende Kapitel zur Seite, auf der du gerade bist.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-palette"></i> So stellst du Farben, Design-Stil, Schrift, Größe, Zeilenhöhe und Hell/Dunkel ein</b>
    {{template "hb-fig-look"}}
    <ol class="hb-steps">
      <li>Oben rechts der Knopf <b>Hell/Dunkel</b> (<i class="ti ti-device-desktop"></i> / <i class="ti ti-sun"></i> / <i class="ti ti-moon"></i>) schaltet bei jedem Klick weiter: System, Hell, Dunkel. „System“ folgt der Einstellung deines Geräts.</li>
      <li>Oben rechts auf deinen Namen → Bereich <b>Darstellung</b>: einen Farbkreis antippen, bei <i class="ti ti-layout-grid"></i> den <b>Design-Stil</b> wählen – <b>Fiori</b> (Standard) sieht aus wie SAP, <b>Fluent</b> wie Windows 11 –, eine <b>Schriftart</b> wählen und mit <b>−</b> / <b>+</b> alles kleiner oder größer machen (70 bis 160 %). Du siehst die Änderung sofort.</li>
      <li>Darunter bei <i class="ti ti-line-height"></i> <b>Zeilenhöhe</b> mit <b>−</b> / <b>+</b> die Zeilen in Tabellen und Listen niedriger oder höher machen (70 bis 150 %). Die Schrift in den Zeilen wird dabei automatisch mit kleiner oder größer – niedrig zeigt mehr Zeilen auf einen Blick, hoch ist am Touchscreen leichter zu treffen.</li>
      <li><b>Speichern</b> – dann gilt deine Darstellung ab jetzt immer, auf allen Geräten, an denen du dich anmeldest. Ohne Speichern ist beim nächsten Seitenaufruf wieder die gespeicherte Einstellung da.</li>
      <li><b>Standard</b> (dann Speichern) stellt alles auf den Firmenstandard zurück. Das Gebäude-Symbol <i class="ti ti-building"></i> setzt nur das Farbschema zurück.</li>
    </ol>
    Hell/Dunkel merkt sich nur dein Browser. Fehlen Farbkreise, Design-Stil und Schriftart im Menü, hat der Administrator die eigene Wahl abgeschaltet – Größe und Zeilenhöhe kannst du trotzdem ändern. Am Terminal gilt die Einstellung für alle, die das Terminal benutzen.</div>
  <h3><i class="ti ti-layout-dashboard"></i> Dein Dashboard mit Widgets</h3>
  <p>Die Startseite stellst du dir selbst zusammen – aus <b>Widgets</b> für Schnellzugriffe, Kennzahlen, Listen und Persönliches. Jedes Widget aktualisiert sich von selbst; ein Klick auf eine Zahl oder einen Eintrag führt direkt dorthin.</p>
  {{template "hb-fig-widgets"}}
  <div class="hb-howto"><b><i class="ti ti-layout-dashboard"></i> So stellst du dein Dashboard zusammen</b>
    <ol class="hb-steps">
      <li>Oben im Benutzermenü <b>Dashboard anpassen</b> (von jeder Seite aus – PDH wechselt dafür aufs Dashboard). Der <b>Widget-Katalog</b> öffnet sich, die Widgets bekommen einen gestrichelten Rahmen.</li>
      <li>Ein Widget aus dem Katalog <b>ins Raster ziehen</b> – oder auf <b>+</b> tippen, dann landet es am Ende.</li>
      <li>Widgets im Raster an die gewünschte Stelle <b>ziehen</b> (am Handy kurz halten, dann ziehen). <i class="ti ti-arrows-horizontal"></i> ändert die Breite (1 bis 4 Spalten), <i class="ti ti-x"></i> entfernt das Widget.</li>
      <li><i class="ti ti-settings"></i> öffnet die Einstellungen: eigene Überschrift, bei <b>Eigene Links</b> je Zeile <code>Name | Adresse</code>, bei <b>Anlagen-Schnellübersicht</b> welche Übersicht und ob nur Auffälliges erscheint.</li>
      <li><b>Fertig</b> speichert – deine Zusammenstellung gilt an deinem Konto auf allen Geräten. <b>Abbrechen</b> verwirft die Änderungen, <b>Standard</b> stellt den Firmenstandard wieder her.</li>
    </ol></div>
  <table>
    <tr><td><b>Schnellzugriff</b></td><td><b>Schnellaktionen</b> (große Knöpfe: Neu anlegen, Störung melden, Ticket, Zeit erfassen, Ersatzteil suchen …), <b>Eigene Links</b>, <b>Scannen</b> (QR-Code oder Barcode mit der Handy-Kamera – siehe unten)</td></tr>
    <tr><td><b>Tabelle und Zeitstrahl</b></td><td>Die Widgets <b>Tabelle offener Vorgänge</b> und <b>Zeitstrahl</b> (unter „Listen“) zeigen alle offenen Störungen, Tickets, Wartungen und Aufgaben. Über beiden wählst du wie im Leitstand, was angezeigt wird (Störungen, Tickets, Wartung, Aufgaben, nur überfällige, nur ohne Zuständigen) – dein Browser merkt sich die Auswahl. Eine Zeile antippen öffnet den Vorgang; im Zeitstrahl verschiebst du den Termin per Ziehen. Beide gibt es je einmal – wer sie nicht braucht, nimmt sie unter <b>Dashboard anpassen</b> heraus.</td></tr>
    <tr><td><b>Kennzahlen</b></td><td>Offene Tickets, Aktive Störungen, Wartung fällig, Nachbestellen, Meine Aufgaben, Meine Stunden, Verlauf 14 Tage (Tickets und Störungen pro Tag)</td></tr>
    <tr><td><b>Listen</b></td><td><b>Mir zugewiesen</b> (das Dringendste zuerst, Überfälliges rot), Aktuelle Störungen, Wartungen nächste 7 Tage, Bestellliste (Teile unter Mindestbestand, mit dem Lagerplatz, an dem die meisten liegen), <b>Anlagen-Schnellübersicht</b> (Ampel einer <a href="#watch">Schnellübersicht</a> mit NOK-Bauteilen und Störungen)</td></tr>
    <tr><td><b>Dokumente</b></td><td>Unter „Listen“: Bilder, PDF, Word- (.docx) und Excel-Dateien (.xlsx, .xls, .csv) anzeigen, z. B. Arbeitsanweisungen oder Aushänge. Unter <i class="ti ti-settings"></i> <b>Dateien hinzufügen</b>, mit ↑ ordnen, mit ✕ entfernen; Wechselzeit und Höhe einstellen. Mehrere Dateien wechseln sich ab – Maus darüber hält an, ‹ › blättert, ↗ öffnet die Datei. Hochladen braucht das Recht <i>Dokumente für Dashboard und Leitstand hochladen</i>.</td></tr>
    <tr><td><b>Schichtplan</b></td><td>Unter „Listen“: der Schichtplan wie im Planer – Schichten × Tage mit den eingeteilten Namen, darunter Sonderdienste und Bereitschaft (mit Telefonnummer, wenn bei der Dienstart eingestellt). Die Namen stehen groß, damit man sie auch aus Abstand lesen kann; die Felder sind immer so breit, dass Name und Telefonnummer ganz zu sehen sind (bei wenig Platz seitlich schieben). Oben Woche blättern, Schichtmodell und Feldhöhe wählen; <b>Planer</b> öffnet die Einteilung. Braucht das Recht <i>Schichtplan sehen</i>.</td></tr>
    <tr><td><b>Schichtplan Team</b></td><td>Unter „Listen“: alle aus deiner Abteilung mit ihrer Schicht der nächsten 7 Tage, Urlaub und Abwesenheit stehen in der Zelle. Du stehst oben. Den Grund einer Abwesenheit sieht nur, wer alle Abwesenheiten sehen darf, Entwürfe nur, wer Schichten plant. Braucht das Recht <i>Schichtplan sehen</i>.</td></tr>
    <tr><td><b>Persönlich</b></td><td><b>Mein Kalender</b> (deine nächsten 7 Tage auf einen Blick: Schicht, Urlaub, dir zugewiesene fällige Vorgänge – Überfälliges mit ⚠ bei „Heute“ – und deine Prüfpflichten; ein Eintrag öffnet ihn; Recht <i>Widget „Mein Kalender“</i>), Meine Schichten (7 Tage), Notizzettel (nur für dich sichtbar; einfach hineinschreiben – wird automatisch gespeichert, auch ohne <b>Dashboard anpassen</b>)</td></tr>
  </table>
  <p>Du siehst im Katalog nur Widgets, für die du die Berechtigung hast – z. B. „Bestellliste“ nur mit <i>Lager ansehen</i>. Am Handy stehen kleine Kennzahlen zu zweit nebeneinander, alles andere über die volle Breite.</p>
  <div class="hb-howto" id="hb-scan"><b><i class="ti ti-scan"></i> So scannst du mit dem Handy</b>
    <ol class="hb-steps">
      <li>Einmalig das Widget <b>Scannen</b> (Katalog → Schnellzugriff) aufs Dashboard legen.</li>
      <li><b>Code scannen</b> antippen und den Kamerazugriff erlauben. QR-Code oder Barcode in den Rahmen halten – PDH erkennt ihn von selbst und öffnet das Passende.</li>
      <li>Kann der Browser nicht live scannen (z. B. iPhone), öffnet sich stattdessen die Kamera für ein Foto; PDH liest den Code daraus. Klappt auch das nicht, die Nummer unter dem Strichcode eintippen.</li>
    </ol>
    Der QR-Code einer Anlage öffnet ihre Infoseite mit den offenen Vorgängen, ein Etikett oder eine Kanban-Karte die Buchung, eine EAN oder Teilenummer das Ersatzteil. Ein <b>Handscanner</b> (Tastatur-Modus) schreibt einfach ins Feld darunter – mit Enter geht es weiter.</div>
  <h3><i class="ti ti-device-mobile"></i> Am Smartphone und Tablet</h3>
  {{template "hb-fig-mobile"}}
  <p>Das PDH passt sich der Bildschirmgröße an – es gibt keine eigene App, der Browser genügt.</p>
  <div class="hb-howto"><b><i class="ti ti-device-mobile"></i> So bedienst du das PDH am Smartphone</b>
    <ol class="hb-steps">
      <li><b>☰</b> oben links öffnet die Navigation. Ein Modul antippen – oder daneben auf die abgedunkelte Fläche tippen, um sie zu schließen.</li>
      <li>Oben rechts: <i class="ti ti-messages"></i> Chat, <i class="ti ti-device-desktop"></i> Hell/Dunkel, <i class="ti ti-layout-sidebar-right"></i> Suche, Copilot, Aktivität und Hilfe, <i class="ti ti-user"></i> dein Menü (dort auch <b>Im Chat teilen</b> und die Darstellung). Die <b>Flagge</b> daneben stellt die Sprache um: Deutsch, Englisch, Rumänisch, Türkisch oder Mazedonisch.</li>
      <li>Breite Tabellen kannst du <b>seitlich wischen</b>. Reiter auf Detailseiten ebenso.</li>
      <li>Wo es am PC ein Rechtsklick-Menü gibt, <b>lange drücken</b> (etwa eine halbe Sekunde).</li>
      <li>Ist dir alles zu klein: Menü → Darstellung → <b>+</b> und <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-device-tablet"></i> Am Tablet</b>
    Die Navigation bleibt links. Chat, Suche und Hilfe öffnen sich als Leiste von rechts über dem Inhalt (Knopf <i class="ti ti-layout-sidebar-right"></i> oder Chat), damit genug Platz bleibt. Neue Chat-Nachrichten öffnen die Leiste dort nicht von selbst – du siehst die Zahl am Chat-Knopf.</div>
  <div class="hb-howto"><b><i class="ti ti-apps"></i> So legst du das PDH wie eine App auf den Startbildschirm</b>
    <ol class="hb-steps">
      <li>PDH im Browser öffnen und anmelden.</li>
      <li><b>iPhone/iPad (Safari):</b> Teilen-Symbol → <b>Zum Home-Bildschirm</b>. <b>Android (Chrome):</b> Menü ⋮ → <b>App installieren</b> bzw. <b>Zum Startbildschirm hinzufügen</b>.</li>
      <li>Das PDH-Symbol startet jetzt ohne Adressleiste, wie eine App.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-arrow-back-up"></i> Zurück zur vorherigen Seite</b>
    Der Pfeil <i class="ti ti-arrow-left"></i> oben links bringt dich immer dorthin zurück, woher du gekommen bist. Fährst du mit der Maus darüber, siehst du das Ziel.</div>
  <div class="hb-howto"><b><i class="ti ti-app-window"></i> Verknüpfungen öffnen, ohne die Seite zu verlassen</b>
    Klickst du z. B. in einem Ticket auf die Anlage, öffnet sie sich rechts im <b>PDH-Viewer</b>. Mit <kbd>Esc</kbd> schließt du ihn wieder. <kbd>Strg</kbd>+Klick öffnet stattdessen einen neuen Tab.</div>
  <div class="hb-howto" id="hb-statusbar"><b><i class="ti ti-progress"></i> Die Statusleiste unten</b>
    Ganz unten siehst du, was PDH gerade macht – im Balken steht die Tätigkeit und der Fortschritt in Prozent, z. B. „Speichere: Anlegen … 62 %“. Bei Uploads und Downloads ist es der echte Fortschritt, sonst läuft der Balken gleichmäßig bis 90 % und springt bei Abschluss auf <b>Fertig 100 %</b>. Blau = arbeitet, grün = fertig, gelb = Hinweis, rot = Fehler (rechts steht, was schiefging). Hintergrund-Aktualisierungen, z. B. von Widgets, zeigt die Leiste nicht an.</div>
  {{template "hb-shots" (dict "Ref" (index $s "start") "Can" $can)}}
</section>

<section class="hb-ch" id="records" data-title="Arbeiten mit Datensätzen" data-pages="">
  <h2><i class="ti ti-layout-dashboard"></i> Arbeiten mit Datensätzen</h2>
  <p>Egal ob Störung, Ersatzteil oder Anlage – jeder Datensatz ist gleich aufgebaut. Wer ein Modul kennt, kennt alle.</p>
  {{template "hb-fig-rows"}}
  <div class="hb-howto"><b><i class="ti ti-list-details"></i> So arbeitest du mit Listen und Tabellen</b>
    <ol class="hb-steps">
      <li><b>Zeile anklicken</b> (oder mit Tab anwählen und Enter). Die Zeile klappt auf, darunter erscheinen die Knöpfe.</li>
      <li><b>Ansehen</b> zeigt den Datensatz in der Schnellansicht über der Liste – die Liste bleibt, wo sie ist. <b>Bearbeiten</b> öffnet ihn. <b>Fertigstellen</b> (je nach Modul <b>Beheben</b>, <b>Abschließen</b>, <b>Erledigen</b> oder <b>Durchführen</b>) startet den Abschluss-Assistenten.</li>
      <li>Weitere Knöpfe des Moduls stehen rechts daneben, z. B. Status bei IT-Assets oder Bestätigen und Löschen in der Zeiterfassung.</li>
      <li>Nochmal klicken klappt die Zeile wieder zu. Ein <b>Doppelklick</b> öffnet den Datensatz direkt.</li>
    </ol>
    Im Anlagenbaum klappt der kleine <b>Pfeil</b> die Unteranlagen auf, ein Klick auf die Zeile zeigt die Knöpfe.</div>
  <div class="hb-howto"><b><i class="ti ti-keyboard"></i> Text-Vorschläge beim Tippen</b>In Titeln, Beschreibungen, Maßnahmen, Ursachen, Lösungen, Kommentaren, Schulungsinhalten und Freitext-Punkten von Checklisten schlägt PDH vor, wie es weitergehen könnte – gelernt aus allem, was im Betrieb schon geschrieben wurde. Grau angezeigt wird die Ergänzung der aktuellen Zeile (ganze Formulierung, nächstes Wort oder Wortende), darunter weitere passende Formulierungen.
    <ul>
      <li><b>Tab</b> übernimmt den markierten Vorschlag, <b>↑ ↓</b> wählen, <b>Esc</b> schließt; ein Klick geht auch. <b>Enter</b> bleibt Enter (außer du hast mit den Pfeilen gewählt).</li>
      <li>Was übernommen wird, rückt künftig weiter nach oben; neue Texte lernt PDH spätestens nach 10 Minuten dazu.</li>
    </ul></div>
  {{template "hb-fig-detail"}}
  <table>
    <tr><td><b>Übersicht</b></td><td>das Wichtigste auf einen Blick</td></tr>
    <tr><td><b>Stammdaten</b></td><td>hier wird bearbeitet – alles in einem Formular, unten rechts <b>Speichern</b></td></tr>
    <tr><td><b>Feldsätze</b></td><td>zusätzliche Felder, die eure Administration festlegt (<a href="#fieldsets">mehr</a>)</td></tr>
    <tr><td><b>Dokumente</b></td><td>Fotos (Galerie oder Kamera) und Dateien – bei Ersatzteilen auch Datenblatt und Benutzerhandbuch aus dem Internet (<a href="#part-docs">siehe Ersatzteile</a>)</td></tr>
    <tr><td><b>Verknüpfungen</b></td><td>alles, was mit dem Datensatz zusammenhängt – Anlage, Vorgänge, Ersatzteile, Firmen, Chat</td></tr>
    <tr><td><b>Historie</b></td><td>wer hat wann was geändert</td></tr>
  </table>
  <p><b>Listen</b> haben oben ebenfalls Reiter (z. B. nach Status oder Kategorie) mit der Anzahl der Einträge. Die Kennzahl-Kacheln sind anklickbar und filtern die Liste. Darunter filtern die <b>#-Schlagworte</b> nach <a href="#categories">Kategorie</a>.</p>
  <h3><i class="ti ti-hash"></i> Kopfleiste: Kategorien und Status</h3>
  {{template "hb-fig-meta"}}
  <p>Direkt über den Reitern stehen die <a href="#categories">Kategorien</a> (#Energie, #Optimierung …) – antippen setzt oder entfernt sie. Bei <b>Stammdaten</b> (Anlagen, Ersatzteile, Lagerplätze, Hersteller &amp; Lieferanten) zeigt die Leiste außerdem, ob der Datensatz <b>gesperrt</b>, <b>deaktiviert</b> oder <b>zum Löschen vorgemerkt</b> ist. Über <b>Status</b> änderst du das (<a href="#cleanup">mehr</a>).</p>
  <h3 id="sort"><i class="ti ti-arrows-sort"></i> Listen sortieren</h3>
  <p>Über Verläufen, Maßnahmen, Kommentaren und Protokoll-Listen steht die Leiste <b>Sortieren:</b>. Damit bringst du die Einträge in die Reihenfolge, die du gerade brauchst – zum Beispiel um zu sehen, was an einer Anlage am häufigsten vorkommt.</p>
  {{template "hb-fig-sort"}}
  <div class="hb-howto"><b><i class="ti ti-arrows-sort"></i> So sortierst du eine Liste</b>
    <ol class="hb-steps">
      <li>Über der Liste die gewünschte Sortierung antippen. Auf dem Handy und in schmalen Fenstern ist es ein <b>Auswahlfeld</b> – dort die Sortierung auswählen.</li>
      <li><b>Neueste zuerst</b> und <b>Älteste zuerst</b> ordnen nach Datum. <b>Nach Person</b> sammelt die Einträge je Name (bei den KVP-Maßnahmen: je verantwortliche Person, nicht je Person, die die Maßnahme eingetragen hat), <b>Nach Art</b> je Art des Eintrags (z. B. „Status geändert“). Bei den Maßnahmen im KVP gibt es zusätzlich <b>Nach Termin</b>.</li>
      <li><b>Häufigste zuerst</b> und <b>Gleiches zusammen</b> fassen gleiche Einträge zu einer Zeile zusammen, z. B. „12× Lager läuft heiß – zuletzt 18.11.2026“. Auf die Zeile tippen klappt die einzelnen Einträge auf.</li>
      <li>PDH <b>merkt sich deine Wahl</b> für jede Art von Liste. Beim nächsten Mal ist sie schon eingestellt. Am Spiegelserver gilt die Wahl nur für diesen Aufruf und wird nicht gespeichert.</li>
    </ol>
    <b>Was heißt „gleich“?</b> Gleich ist ein Text, wenn er sich nur in Groß- und Kleinschreibung, Umlauten, Satzzeichen oder Leerzeichen unterscheidet. Ähnliche Texte mit anderen Wörtern werden <b>nicht</b> zusammengelegt. In der Historie eines Datensatzes heißt „gleich“: dieselbe Änderung am selben Feld.</div>
  <div class="hb-howto"><b><i class="ti ti-history"></i> So liest du die Historie</b>
    <ol class="hb-steps">
      <li>Am Datensatz den Reiter <b>Historie</b> öffnen. Zuerst stehen die neuesten 30 Einträge.</li>
      <li>Mit <b>Weitere laden</b> kommen die nächsten dazu.</li>
      <li>Sortierung wie oben wählen. Berücksichtigt werden höchstens die neuesten 5000 Einträge; sind es mehr, steht ein Hinweis da.</li>
    </ol>
    Die Historie eines Datensatzes sieht, wer den Datensatz selbst sehen darf (bei Aufgaben und Wartungen: wer den Bereich ansehen oder bearbeiten darf). In der <a href="#infrastructure">Anlagen-Historie</a> stehen die Sortierung und die Filter nebeneinander; beim Umschalten bleiben die Filter erhalten.</div>
  <p>Unverändert bleiben die kurzen Auszüge wie „Letzte Bewegungen“, „Letzte Buchungen“ und „Letzte Scans“ – sie zeigen nur die jüngsten Einträge.</p>
  <h3 id="creation"><i class="ti ti-circle-plus"></i> Vorgänge anlegen: der Erstellungs-Assistent</h3>
  <p>Neue Tickets, Störungen, Aufgaben und Wartungsaufträge legst du überall im gleichen Stil wie beim Abschließen Schritt für Schritt an. Jeder Weg zum Anlegen öffnet diesen Assistenten:</p>
  <ul>
    <li><b>Neu anlegen</b> in der Navigation und als Schnellaktion auf dem Dashboard (im Auswahlschritt auch „KVP-Idee“ für alle, öffnet den <a href="#kvp">Einreich-Assistenten</a>) – Aufgaben und Wartungen legen dort nur <b>Administratoren und Manager</b> an, alle anderen Tickets und Störungen,</li>
    <li>die Schnellaktionen <b>Störung melden</b> und <b>Ticket anlegen</b>,</li>
    <li><b>Neu</b> in der Ticket- und Störungsliste, <b>Neue Aufgabe</b>, in der Wartung <b>Einzelauftrag</b>,</li>
    <li>auf einer Projektseite das <b>+</b> bei den Aufgaben – die Aufgabe gehört dann gleich zum Projekt, danach bleibst du auf der Projektseite,</li>
    <li>im <a href="#dashboard">Leitstand</a> die Kacheln – dort ohne Zuweisung, siehe unten.</li>
  </ul>
  <p>Mit dem Recht „Rüstzeiten: erfassen …“ steht unter <b>Neu anlegen</b> auch die Kachel <b>Rüstzeit</b> – wie das geht, steht unten und im Kapitel <a href="#ruestzeiten">Rüstzeiten</a>. Im Leitstand gibt es sie nicht.</p>
  <p>Die <b>Kostenstelle</b> übernimmt PDH bei Tickets und Störungen wie bisher aus der gewählten Anlage.</p>
  <div class="hb-howto"><b><i class="ti ti-circle-plus"></i> So legst du einen Vorgang an</b>
    <ol class="hb-steps">
      <li><b>Art</b> wählen (entfällt, wenn du aus einer Liste startest).</li>
      <li><b>Was?</b> Titel, Beschreibung und Priorität (bei Störungen Schweregrad und Symptome, bei Wartungen die Art). Bei einer Störung zeigt PDH schon beim Tippen <b>ähnliche gelöste Fälle</b> mit ihrer Lösung. Mit <b>Foto aufnehmen</b> oder <b>Bild wählen</b> hängst du bis zu fünf Fotos an – sie stehen danach unter <b>Dokumente</b> am Vorgang (auch im Leitstand).</li>
      <li><b>Wo?</b> die Anlage – sie bestimmt auch, welche Abteilung den Vorgang sieht; bei Wartungsaufträgen Pflicht.</li>
      <li><b>Wer?</b> eine Person oder eine ganze <b>Gruppe</b> zuweisen, „Ich selbst“ oder offen lassen; optional Verantwortliche/n.</li>
      <li><b>Wann?</b> Fälligkeit per Schnellwahl (heute, morgen, 3 Tage, 1–2 Wochen, Standardfrist) oder Datum; bei Aufgaben auch der Start.</li>
      <li>Zusammenfassung prüfen – <b>Anlegen</b> öffnet den neuen Vorgang, <b>Anlegen &amp; nächster</b> beginnt gleich den nächsten derselben Art.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-exchange-2"></i> So legst du eine Rüstzeit über „Neu anlegen“ an</b>
    <ol class="hb-steps">
      <li><b>Neu anlegen</b> → Kachel <b>Rüstzeit</b>.</li>
      <li><b>Was?</b> den <b>Grund</b> antippen, z. B. „Produktumstellung“. Ein Vermerk ist freiwillig.</li>
      <li><b>Wo?</b> die Anlage wählen – sie ist Pflicht. An einer Anlage läuft immer höchstens eine Rüstzeit.</li>
      <li><b>Wann?</b> <b>Läuft gerade</b>: Der Beginn ist schon jetzt eingetragen. <b>Nachtragen</b>: zusätzlich das <b>Ende</b> oder die <b>Dauer</b> in Minuten eintragen.</li>
      <li><b>Anlegen</b> öffnet die Rüstzeit. Eine laufende Rüstzeit beendest du dort mit <b>Beenden</b>.</li>
    </ol>
    Einen Schritt „Wer?“ gibt es hier nicht: Zugeordnet wird von selbst der Schichtführer im Dienst, verantwortlich ist der Anlagenverantwortliche.</div>
  <h3 id="completion"><i class="ti ti-circle-check"></i> Vorgänge abschließen: der Abschluss-Assistent</h3>
  <p>Tickets, Störungen, Aufgaben und Wartungen schließt du immer mit dem <b>grünen Haken</b> ab – auf der Detailseite oder in der Liste: Zeile anklicken → <b>Fertigstellen</b> (bzw. <b>Beheben</b>, <b>Abschließen</b>, <b>Erledigen</b>, <b>Durchführen</b>). Ein Assistent führt dich in fünf kurzen Schritten durch; erst wenn alles da ist, geht es weiter.</p>
  {{template "hb-fig-completion"}}
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du einen Vorgang ab</b>
    <ol class="hb-steps">
      <li><b>Material:</b> Verwendete Ersatzteile suchen, Lagerort und Menge wählen, <b>Reservieren</b> – die Menge wird sofort vom Lagerplatz abgebucht (<a href="#reservation">Reservierung</a>). Zu viel reserviert? <b>Zurückbuchen</b> an der Position. Ohne Teile: <b>Kein Material verwendet</b> ankreuzen. <b>OK – weiter</b>.</li>
      <li><b>Zeit:</b> Beginn und Dauer angeben (Schnellwahl 15 min bis 8 h). Läuft dein Timer für diesen Vorgang, wird er automatisch gestoppt. Hast du schon Zeit erfasst, ist weitere Zeit freiwillig.</li>
      <li><b>Wer war dabei?</b> Mitarbeitende ankreuzen, die mitgearbeitet haben. Vorgeschlagen werden die Abteilungen aus den Core-Einstellungen (z. B. Instandhaltung, Elektro); <b>Alle Abteilungen anzeigen</b> zeigt alle. Niemand? Einfach weiter.</li>
      <li><b>Kommentar:</b> kurz, was gemacht wurde – erscheint als Maßnahme im Verlauf. Bei Tickets, Störungen und Aufgaben optional die <b>Ursache</b>.</li>
      <li><b>Fertig</b> macht die Reservierungen zum Verbrauch und schließt ab. <b>Geht noch weiter</b> speichert Zeit, Reservierung und Kommentar – der Vorgang bleibt <i>in Bearbeitung</i>, z. B. bei Schichtende oder wenn Teile fehlen.</li>
    </ol>
    Die Ausgewählten bekommen denselben Zeitraum als <b style="color:var(--amber)">gelben Eintrag</b> in ihre Zeiterfassung und einen Chat-Hinweis von „Service“. Erst wenn sie ihn mit dem <b style="color:var(--green)">grünen Haken</b> bestätigen, zählt die Zeit (<a href="#time">mehr</a>).</div>
  <ul>
    <li>Bei <b>Wartungen</b> mit Checkliste ist die <b>Checkliste der erste Schritt</b> des Assistenten – Punkt für Punkt mit Foto je Punkt, auch am Leitstand. Beim Abschluss entsteht das Wartungsprotokoll als PDF an Auftrag und Anlage (<a href="#maintenance">mehr</a>).</li>
    <li>Kann der Vorgang nicht geschlossen werden (z. B. fehlt dir die Berechtigung zum Abschließen), wird das Erfasste trotzdem gespeichert und der Grund angezeigt.</li>
    <li><b>Administration:</b> Die vorgeschlagenen Abteilungen stellst du unter <b>Core-Einstellungen → Abschluss-Assistent: Wer war dabei?</b> ein (Teilwort genügt, „Elektro“ passt auf „Elektrowerkstatt“).</li>
  </ul>
  {{template "hb-shots" (dict "Ref" (index $s "records") "Can" $can)}}
</section>

<section class="hb-ch" id="categories" data-title="Kategorien (#)" data-pages="categories">
  <h2><i class="ti ti-hash"></i> Kategorien (#)</h2>
  <p>Kategorien sind Schlagworte, die quer über alle Module gelten – zum Beispiel <b>#Energie</b>, <b>#Optimierung</b>, <b>#Zufriedenheit</b>, <b>#Versuch</b>, <b>#Produktiv</b> und <b>#Efficio</b>. So findest du z. B. alle Energie-Themen auf einen Blick: Tickets, Störungen, Aufgaben, Projekte, Wartungen, Anlagen, Ersatzteile, Lagerplätze und Firmen.</p>
  <div class="hb-howto"><b><i class="ti ti-hash"></i> So vergibst du eine Kategorie</b>
    <ol class="hb-steps">
      <li>Datensatz öffnen (z. B. ein Ticket).</li>
      <li>Oben über den Reitern auf das graue Schlagwort tippen – es wird farbig und ist gesetzt.</li>
      <li>Nochmal antippen entfernt es wieder. Mehrere Kategorien gleichzeitig sind möglich.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-search"></i> So findest du alles zu einer Kategorie</b>
    <ol class="hb-steps">
      <li>Navigation → <b>Kategorien</b>.</li>
      <li>Links die Kategorie wählen – rechts erscheinen alle Datensätze, sortiert nach Modul.</li>
      <li>Ein Klick öffnet den Datensatz im PDH-Viewer.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So filterst du eine Liste nach Kategorie</b>
    <ol class="hb-steps">
      <li>Jede Liste (Tickets, Störungen, Aufgaben, Projekte, Wartung, Ersatzteile, Hersteller &amp; Lieferanten) und die Bäume von Infrastruktur und Lager zeigen oben eine Zeile mit <b>#-Schlagworten</b> und der Anzahl der Treffer.</li>
      <li>Schlagwort antippen – die Liste zeigt nur noch diese Kategorie. Status- und Suchfilter bleiben erhalten; im Baum bleibt der Weg zu den Treffern sichtbar.</li>
      <li>Nochmal antippen oder <b>× alle</b> hebt den Filter auf.</li>
    </ol></div>
  <p>Mit der Berechtigung <i>Kategorien verwalten</i> legst du auf derselben Seite neue Kategorien an, änderst Name, Farbe und Symbol oder deaktivierst eine Kategorie. Deaktivierte Kategorien können nicht mehr neu vergeben werden, bestehende Zuordnungen bleiben sichtbar. Jede Änderung steht in der Historie des Datensatzes.</p>
  {{template "hb-shots" (dict "Ref" (index $s "categories") "Can" $can)}}
</section>

<section class="hb-ch" id="dashboard" data-title="Leitstand &amp; Meldungen" data-pages="assignments-new assignments leitstaende">
  <h2><i class="ti ti-layout-dashboard"></i> Leitstand &amp; Meldungen</h2>
  <p>Am <b>Leitstand</b> (z. B. am Terminal in der Halle) meldet jede und jeder schnell ein Problem – ohne sich lange durchzuklicken.</p>
  <p>Es kann <b>mehrere Leitstände</b> geben, z. B. einen je Abteilung oder Team. Welcher erscheint: am Terminal der direkt gewählte (Benutzer → Terminal), sonst der seiner <b>Gruppe</b>, sonst der seiner <b>Abteilung</b>, sonst der <b>Standard-Leitstand</b>. Ein Bildschirm ohne Anmeldung öffnet die Adresse des Leitstands (z. B. <code>/global/b/instandhaltung</code>) und merkt sie sich.</p>
  <div class="hb-howto"><b><i class="ti ti-device-tv"></i> So richtest du einen Leitstand für eine Abteilung oder ein Team ein</b> (Recht „Leitstand verwalten“)
    <ol class="hb-steps">
      <li>Navigation → <b>Leitstände</b> → <b>Neuer Leitstand</b>. Name eingeben – die <b>Adresse</b> schlägt PDH vor.</li>
      <li>Bei <b>Was der Leitstand zeigt</b> die <b>Abteilung</b> und/oder <b>Gruppe / Team</b> wählen und die <b>Vorgangsarten</b> ankreuzen. Ohne Auswahl zeigt er alles.</li>
      <li><b>Bausteine</b> zusammenstellen: hinzufügen, an der Griffleiste <i class="ti ti-grip-vertical"></i> ziehen, Breite (¼ bis ganz) und Überschrift wählen, mit <i class="ti ti-x"></i> entfernen. Zur Auswahl: Neu anlegen, Vorgänge, Zeitstrahl, Kennzahlen, Aktuelle Störungen, Fällige Wartung, <b>Schichtplan</b> (wie im Planer: Schichten × Tage mit Namen, darunter Sonderdienste mit Telefon; Woche, Modell und Feldhöhe oben wählen), <b>Kalender</b> (wie unter Übersicht → Kalender: Schichten, Sonderdienste wie Bereitschaft, Abwesenheit und fällige Vorgänge – oben im Baustein Zeitraum, Abteilung, Gruppe, Person und Arten wählen; ohne Anmeldung nur lesbar, Abwesenheit ohne Grund; Gäste sehen genau das, was am Leitstand eingestellt ist – keine anderen Arten, Abteilungen oder Personen, keine Auswahllisten von Abteilungen, Gruppen und Personen), Hinweistext, Andere Leitstände (Knöpfe zum Umschalten), <b>Dokumente</b> (Bilder, PDF, Word- und Excel-Dateien direkt im Baustein hochladen, mit ↑ ordnen; mehrere wechseln sich nach der eingestellten Zeit ab, ‹ › blättert von Hand, ↗ öffnet die Datei; braucht zum Hochladen das Recht <i>Dokumente für Dashboard und Leitstand hochladen</i>), <b>Webseite</b> (eine externe Seite eingebettet, z. B. Anlagenvisualisierung oder Wetter: Adresse mit <code>https://</code> oder eine eigene PDH-Seite wie <code>/planner</code>, dazu Höhe in Pixeln und auf Wunsch „neu laden alle … Minuten“; bleibt das Feld leer, verbietet die Seite das Einbetten – dann hilft nur <b>↗ öffnen</b> im Baustein).</li>
      <li>Optional <b>Weiterblättern</b>: nach so vielen Sekunden (mindestens 10) zum nächsten Leitstand – für mehrere im Kreis bei jedem den nächsten eintragen. Oben rechts läuft die Zeit mit. Berührt jemand den Bildschirm, beginnt die Zeit neu; ist ein Formular offen, bleibt er stehen.</li>
      <li>Optional <b>Dazwischen Grafana-Dashboards zeigen</b>: Dashboards aus der <a href="#statistics">Statistik</a> ankreuzen und an der Griffleiste <i class="ti ti-grip-vertical"></i> in die Reihenfolge ziehen. Der Bildschirm zeigt dann diesen Leitstand → die Dashboards bildschirmfüllend (je gleich lange) → den nächsten Leitstand; ohne nächsten wieder diesen. In Grafana neu angelegte Dashboards stehen mit „neu in Grafana“ automatisch dabei und kommen beim Speichern in die Statistik. Grafana braucht am Bildschirm eine Anmeldung mit dem Recht <i>Statistik ansehen</i>.</li>
      <li>Unten bei <b>Direktlink</b> <b>Vollbild</b> und <b>Kioskmodus</b> ankreuzen, <b>Kopieren</b> und den Link am Hallenbildschirm öffnen oder als Lesezeichen/Autostart eintragen. Kioskmodus zeigt nur den Inhalt, ohne Kopfzeile und Knöpfe; die Maus bewegen blendet unten rechts <b>Kiosk beenden</b> ein. Vollbild verlangen manche Browser erst nach einer Berührung („Tippen für Vollbild“). Beim Weiterblättern bleibt beides eingeschaltet.</li>
      <li><b>Vollbild</b> (oben im Leitstand, ⛶) bleibt an – auch beim Weiterblättern und beim Wechsel über „Andere Leitstände“ –, bis es jemand bewusst ausschaltet (⛶ erneut oder Esc). Der Bildschirm merkt sich die Wahl: Nach einem Neustart erscheint „Tippen für Vollbild“.</li>
      <li><b>Speichern</b> – Terminals der Abteilung bzw. Gruppe zeigen ihn sofort; ein Terminal mit eigenem Leitstand startet direkt dort (<b>Zur Startseite</b> führt trotzdem aufs Dashboard).</li>
    </ol>
    Auch der Standard-Leitstand lässt sich so bearbeiten. Überschrift und Untertitel änderst du auch direkt im Leitstand mit <b>✎</b>. Ein Terminal bekommt einen bestimmten Leitstand im Benutzerstamm (Feld <b>Leitstand</b> bei Systemnutzern).</div>
  <p>Der Leitstand sieht aus wie das übrige PDH: dasselbe Farbschema aus dem <b>Erscheinungsbild</b> (Firmenfarbe), Hell und Dunkel wie eingestellt. Die Arten haben überall dieselbe Farbe – <span style="color:#f97316">■</span> Störung, <span style="color:#0ea5e9">■</span> Ticket, <span style="color:#c99a3c">■</span> Wartung, <span style="color:#8b5cf6">■</span> Aufgabe; Rot bleibt für <b>überfällig</b> reserviert.</p>
  <p>Auch hier legst du mit dem <a href="#creation">Erstellungs-Assistenten</a> an, groß und fingerfreundlich – nur <b>ohne Zuweisung</b>: Statt „Wer kümmert sich?“ fragt der Leitstand <b>Wer meldet?</b>. Den Vorgang verteilen danach die Broker.</p>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So meldest du eine Störung am Leitstand</b>
    <ol class="hb-steps">
      <li>Die Kachel <b>Neue Störung</b> oder <b>Neues Ticket</b> antippen. Administratoren und Manager sehen auch <b>Neue Aufgabe</b> und <b>Neue Wartung</b>; bei Wartungen zeigt der Leitstand zuerst die geplanten zum Starten, „+ Neue Wartung anlegen“ öffnet den Assistenten.</li>
      <li><b>Was?</b> Kurzen <b>Titel</b> und eine <b>Beschreibung</b> mit mehr als drei Wörtern, Priorität bzw. Schweregrad (bei Störungen auch Symptome, bei Wartungen die Art).</li>
      <li><b>Wo?</b> Die <b>Anlage</b> suchen und antippen – Pflicht, nur bei Aufgaben optional.</li>
      <li><b>Wer meldet?</b> Dich selbst auswählen. Meldet jemand ohne PDH-Konto (z. B. Besucher), zusätzlich den Namen unter „Abweichender Melder“ eintragen.</li>
      <li><b>Wann?</b> (nicht bei Störungen) Fälligkeit per Schnellwahl oder Datum.</li>
      <li><b>Anlegen</b> – der Assistent zeigt, an welche Broker die Meldung ging, und schließt sich. <b>Anlegen &amp; nächster</b> beginnt gleich die nächste Meldung derselben Art.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So wählst du aus, was der Leitstand zeigt</b>
    <ol class="hb-steps">
      <li>Oben stehen die offenen Vorgänge als große <b>Kacheln</b> – je Vorgang Art, Titel, Priorität, Fälligkeit, <b>Ersteller</b> (wer gemeldet bzw. angelegt hat), Zuständiger und Status –, darunter der <b>Zeitstrahl</b>. Beide haben eine eigene Auswahl. Eine Kachel antippen öffnet darunter die Knöpfe zum Bearbeiten, nochmal antippen schließt sie.</li>
      <li>Die Knöpfe <b>Störungen</b>, <b>Tickets</b>, <b>Wartung</b> und <b>Aufgaben</b> antippen, um eine Art ein- oder auszublenden.</li>
      <li><b>Nur überfällig</b> bzw. <b>Nur ohne Zuständigen</b> zeigt nur diese Vorgänge.</li>
      <li>Wartungen, die noch nicht anstehen (Fälligkeit minus Vorlauf des Plans liegt nach heute), blendet die Tabelle aus – z. B. den nächsten Auftrag, den ein Wartungsplan direkt nach dem Fertigmelden anlegt. <b>Geplante Wartungen</b> zeigt sie an; im Zeitstrahl und unter „Neue Wartung“ stehen sie immer.</li>
      <li>Rechts über den Vorgängen steht, wie viele Vorgänge gerade angezeigt werden (z. B. „4 von 9“); im Zeitstrahl steht die Zahl der ausgeblendeten. Die Auswahl merkt sich der Browser am Leitstand.</li>
      <li>In der Kopfzeile schaltet <b>☰ Tabelle</b> / <b>▦ Kacheln</b> zwischen Kacheln und Tabelle um, <b>📅 Zeitstrahl</b> blendet den Zeitstrahl aus und wieder ein. Ohne Zeitstrahl füllen die Vorgänge den ganzen restlichen Bildschirm.</li>
      <li>Bei <b>Aa Größe</b> mit <b>−</b> / <b>+</b> die Kacheln bzw. die Tabellenzeilen und die Wartungsliste kleiner oder größer machen (70 bis 150 %). Die Schrift passt sich dabei an: klein zeigt mehr Vorgänge auf einen Blick, groß ist von weitem besser lesbar. Ohne gespeicherten Wert gilt die Zeilenhöhe aus deinem Konto, wenn du angemeldet bist, sonst 100 %.</li>
      <li>Ansicht, Zeitstrahl und Größe merkt sich der Leitstand an diesem Gerät.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-id-badge-2"></i> So öffnest du einen Vorgang am Leitstand</b>
    <ol class="hb-steps">
      <li>Einen Balken im Zeitstrahl doppelt antippen.</li>
      <li>Ist am Leitstand niemand angemeldet, fragt er nach der <b>RFID-Karte</b>. Karte scannen, die Seite öffnet sich mit deinen Rechten.</li>
      <li>Das ist <b>keine dauerhafte Anmeldung</b>: Oben rechts steht <b>Zurück zum Leitstand</b>. Der Zugang endet damit, bei Inaktivität (Override-Zeit unter <b>Core-Einstellungen → Auto-Logout</b>), beim Schließen des Browsers oder sobald jemand den Leitstand wieder aufruft.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So meldest du am Leitstand fertig</b>
    <ol class="hb-steps">
      <li>Den Vorgang antippen – darunter erscheinen die Werkzeuge (<b>Annehmen</b>, <b>Fertig</b>, für Administratoren und Manager auch <b>Verwerfen</b>). Nochmal antippen klappt sie wieder zu. Ein Balken im Zeitstrahl öffnet dieselben Werkzeuge. <b>Fertig</b> wählen.</li>
      <li>Bei <b>Wer führt aus?</b> deinen Namen wählen und <b>Fertigmeldung starten</b>. In der Liste stehen die Mitarbeitenden aus Instandhaltung und IT. Ein Kommentar ist hier nicht nötig.</li>
      <li>Der <a href="#completion">Abschluss-Assistent</a> führt durch Material, Zeit, wer dabei war, und Kommentar – genau wie im PDH, nur im Namen der gewählten Person. Oben steht, für wen die Fertigmeldung läuft.</li>
      <li><b>Fertig</b> schließt den Vorgang ab (Status „Gelöst“ bzw. „Erledigt“). <b>Geht noch weiter</b> speichert Zeit und Kommentar, der Vorgang steht dann auf <i>In Arbeit</i>.</li>
    </ol>
    Die Freigabe gilt nur für diesen einen Vorgang und höchstens 20 Minuten. Wer am Leitstand fertig melden darf (Instandhaltung und IT), darf dort auch abschließen – unabhängig vom Bearbeiten- und Abschluss-Recht seiner Rolle.<br>
    <b>Nur am Terminal:</b> Ist unter <b>Core-Einstellungen → Leitstand: Wer führt aus?</b> „Personenauswahl nur am Terminal“ eingeschaltet, gibt es die Namensliste nur an angemeldeten Terminals. An allen anderen Geräten steht stattdessen das Feld <b>RFID-Karte</b> – dann wie früher die Karte scannen.</div>
  <div class="hb-howto"><b><i class="ti ti-hourglass"></i> Was die Leitstand-Aktionen am Status ändern</b>
    <ul>
      <li><b>Annehmen</b> – Vorgang wird zugewiesen und steht auf <i>In Arbeit</i>. Als Zuständiger ist die Person vorgeschlagen, die ausführt.</li>
      <li><b>Geht noch weiter</b> (im Assistenten) bzw. erneutes <b>Annehmen</b> – zurück auf <i>In Arbeit</i>.</li>
      <li><b>Fertig</b> – <i>Gelöst</i> (Störung, Ticket, Aufgabe) bzw. <i>Erledigt</i> (Wartung); der Vorgang verschwindet vom Leitstand.</li>
      <li><b>Verwerfen</b> – Störungen und Tickets werden ohne Maßnahme geschlossen, Wartungen übersprungen, Aufgaben geschlossen.</li>
    </ul></div>
  <h3><i class="ti ti-inbox"></i> Was danach passiert: Broker</h3>
  {{template "hb-fig-broker"}}
  <p>Meldungen aus dem Leitstand sind nie zugewiesen. Auch sonst kann jeder Vorgang ohne Zuständigen angelegt werden, egal ob über <b>Neu anlegen</b>, die Modulseite oder die Schnittstelle. Das gilt für Störungen, Tickets, Aufgaben und Wartungen. Jeder <b>Broker</b> der jeweiligen Art bekommt dann eine Chat-Nachricht vom Melder und kann den Vorgang übernehmen oder jemandem zuweisen. Im Verlauf des Vorgangs steht, an wen er verteilt wurde. Wer Broker ist (für Tickets, Störungen, Aufgaben und/oder Wartungen), legt die Benutzerverwaltung im <a href="#users">Benutzerstamm</a> fest. Ist für eine Art kein Broker hinterlegt, bleibt der Vorgang offen. Der Leitstand und die Bestätigung im Chat weisen darauf hin.</p>
  <p>Aus Wartungsplänen automatisch erzeugte Aufträge lösen keine Chat-Nachricht aus. Sie erscheinen auf der Seite <b>Zuweisung</b>, sobald ihr Vorlauf begonnen hat.</p>
  <h3 id="push"><i class="ti ti-bell-ringing"></i> Push-Alarm aufs Handy</h3>
  <p>Neue Störungen und Tickets kommen als Nachricht aufs Handy der Bereitschaft – mit Inhalt und den Knöpfen <b>Annehmen</b> und <b>Ansehen</b>. Wer zuerst annimmt, wird zuständig, der Vorgang steht auf <i>In Arbeit</i>, und bei allen anderen verschwindet die Nachricht. Ist beim Anlegen <b>Anlage steht</b> angehakt (im Assistenten bei „Wo?“, im Easy-Mode „Anlage steht“), meldet sich das Handy immer wieder, bis jemand annimmt; in der geöffneten PDH-App liegt der Alarm bildschirmfüllend über allem.</p>
  <div class="hb-howto"><b><i class="ti ti-device-mobile"></i> So bekommst du Push-Alarme aufs Handy</b>
    <ol class="hb-steps">
      <li><b>iPhone</b> (ab iOS 16.4): PDH in Safari öffnen → Teilen → <b>Zum Home-Bildschirm</b>, dann PDH vom Home-Bildschirm aus starten. <b>Android</b>: PDH in Chrome öffnen.</li>
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> → Karte <b>Push-Benachrichtigungen aufs Handy</b> → <b>Auf diesem Gerät einschalten</b> → Benachrichtigungen <b>erlauben</b>. Steht dort „Push ist im PDH noch ausgeschaltet“, muss es erst ein Administrator einschalten.</li>
      <li><b>Probe senden</b> – die Nachricht sollte gleich ankommen. Für Alarme die Benachrichtigungen von Chrome bzw. PDH in den Handy-Einstellungen auf „Mit Ton“ bzw. „Wichtig“ stellen.</li>
      <li>Kommt ein Alarm: <b>Annehmen</b> direkt in der Nachricht antippen – oder die Nachricht antippen, dann öffnet sich der Alarm bildschirmfüllend mit großem <b>Annehmen</b>-Knopf. Steht dort „Angenommen von …“, kümmert sich schon jemand.</li>
    </ol>
    Benachrichtigt wirst du nur, wenn du in einer der gewählten Benutzergruppen bist; eigene Meldungen lösen bei dir keine Nachricht aus. Am iPhone gibt es keine Knöpfe in der Nachricht – dort antippen und auf der Alarmseite annehmen. Ganz über dem Sperrbildschirm wie ein Anruf kann eine Web-App den Alarm nicht zeigen; er bleibt aber stehen und meldet sich erneut.</div>
  <div class="hb-howto"><b><i class="ti ti-settings"></i> So richtest du Push ein (Administratoren)</b>
    <ol class="hb-steps">
      <li>Unter <b>Abteilungen &amp; Gruppen</b> eine Gruppe anlegen, z. B. „Bereitschaft Instandhaltung“, und die Personen eintragen.</li>
      <li><b>Core-Einstellungen → Push-Benachrichtigungen aufs Handy</b>: einschalten und je Gruppe anhaken, ob sie bei <b>Störungen</b> und/oder <b>Tickets</b> benachrichtigt wird.</li>
      <li>Für „Anlage steht“ festlegen, wie oft der Alarm wiederholt wird (Standard alle 60 Sekunden) und wie lange höchstens (Standard 120 Minuten). <b>Speichern</b>.</li>
    </ol>
    Push braucht eine <b>https</b>-Adresse (z. B. über den Cloudflare-Tunnel). Benachrichtigt werden nur Vorgänge, die nach dem Einschalten angelegt werden. Der Alarm endet, sobald jemand annimmt, der Vorgang erledigt oder anderweitig zugewiesen ist oder die Höchstdauer um ist. In der Historie des Vorgangs steht, dass benachrichtigt wurde und wer angenommen hat.</div>
  {{template "hb-shots" (dict "Ref" (index $s "dashboard") "Can" $can)}}
  <div class="hb-howto"><b><i class="ti ti-user-check"></i> So weist du als Broker zu</b>Bist du Broker (Benutzerstamm) oder Administrator, steht in der Navigation oben <b>Zuweisung</b>. Andere sehen diese Seite nicht. Dort laufen <b>alle</b> offenen Vorgänge <b>ohne Zuweisung</b> auf – Störungen, Tickets, Aufgaben und Wartungen. Zuweisen kannst du die Arten, für die du Broker bist (Administratoren alle); bei den übrigen steht, wer zuweist. Sie sind nach Art sortiert, die neuesten zuerst. Zu jedem Vorgang stehen Priorität, Anlage, Ersteller und Wartezeit dabei. Wartungen erscheinen, sobald ihr Vorlauf begonnen hat.
    <ol class="hb-steps">
      <li><b>Zuweisung</b> in der Navigation öffnen.</li>
      <li>Beim Vorgang unter <b>Zuweisen an …</b> eine Person, eine Gruppe oder <b>Mir selbst</b> wählen.</li>
      <li><b>Zuweisen</b> – die Zeile zeigt „Zugewiesen an …“. Der neue Zuständige bekommt einen Hinweis im Chat.</li>
      <li>War ein anderer Broker schneller, steht dort „Schon vergeben“. Es wird dann nichts überschrieben.</li>
      <li>Ein Klick auf den Titel öffnet den Vorgang. Dort kannst du auch Verantwortliche und weitere Angaben setzen.</li>
    </ol>
    Unter <b>Neu anlegen</b> stehen dieselben Vorgänge kurz als Schnelleinstieg. <b>Zur Zuweisung</b> führt von dort auf die Seite.</div>
</section>

<section class="hb-ch" id="faults" data-title="Störungen" data-pages="faults">
  <h2><i class="ti ti-alert-triangle"></i> Störungen</h2>
  <p>Eine Störung ist ein technisches Problem an einer Anlage. Die Seite <b>Störungen</b> ist aufgebaut wie der KVP – mit <b>Dashboard</b>, <b>Störungen</b>, <b>Board</b> und <b>Regeln &amp; Einstellungen</b> (siehe <a href="#work-views">Tickets</a>); frisch gemeldete Störungen sind gelb markiert. Sie durchläuft fünf Schritte:</p>
  {{template "hb-fig-fault"}}
  <p>Eine Störung mit der Kategorie <b>Störung durch Rüsten</b> entsteht von selbst, wenn eine Rüstzeit zu lange dauert (<a href="#ruestzeiten">mehr</a>). Sie hat hohen Schweregrad, die Anlage gilt als stehend.</p>
  <div class="hb-howto"><b><i class="ti ti-check"></i> So löst du eine Störung</b>
    <ol class="hb-steps">
      <li>Störung öffnen, im Reiter <b>Copilot</b> bei Bedarf eine Analyse starten oder Fragen stellen.</li>
      <li>Im Reiter <b>Maßnahmen &amp; Ersatzteile</b> zwischendurch festhalten, was gemacht wurde, und benötigte Teile <b>reservieren</b> – sie sind damit sofort für dich aus dem Lager gebucht.</li>
      <li><b>Beheben &amp; abschließen</b> (Karte oben in der Übersicht, in der Liste oder auf dem Board): Der <a href="#completion">Abschluss-Assistent</a> fragt Material, Zeit, wer dabei war und den Kommentar ab.</li>
      <li><b>Fertig</b> – die reservierten Teile werden zum Verbrauch der Störung, die Störung wandert ins Archiv. Oder <b>Geht noch weiter</b>, wenn die Arbeit noch nicht beendet ist.</li>
    </ol></div>
  <p>Die Übersicht zeigt Verantwortliche, Zuständige (auch externe Firmen), Termin, Anlage und Kostenstelle. Ändern geht im Reiter <b>Bearbeiten</b>, die Zeit erfasst du im Reiter <b>Zeit</b> (siehe <a href="#work-views">Detailseite</a>).</p>
  <p><b>Automatisches Ticket zur Störung:</b> Standardmäßig bekommt eine Störung <b>kein</b> eigenes Ticket. Ein Administrator kann das unter <b>Server-Einstellungen → Störungen → Ticket zu jeder Störung anlegen</b> einschalten (wirkt sofort). Dann entsteht das Ticket erst, wenn die Störung einer <b>Person oder Gruppe zugewiesen</b> ist – auf der Störung steht bis dahin „Ticket wird angelegt, sobald …“. Das Ticket übernimmt Zuweisung, Gruppe, Anlage und Kostenstelle. Wird die Störung vorher erledigt, entfällt es.</p>
  <div class="hb-howto"><b><i class="ti ti-brain"></i> Copilot und ähnliche Fälle</b>PDH vergleicht jede Störung mit allen bereits gelösten: Titel, Beschreibung und Symptome werden inhaltlich verglichen (Wortformen und Umlaute egal, seltene Fachbegriffe zählen mehr); dieselbe Anlage zählt deutlich, eine Anlage an derselben Linie etwas mehr. Die passendsten Fälle stehen rechts in der Leiste mit ihrer <b>Ähnlichkeit in Prozent</b> – auch ohne Analyse; ein Klick öffnet den Fall, die Lösung steht im Tooltip.
    Die <b>Copilot-Analyse</b> bekommt diese Fälle samt Ursache, Lösung und durchgeführten Maßnahmen sowie den Anlagenpfad mit und stützt sich zuerst darauf. Die <b>Konfidenz</b> ist nur hoch, wenn ähnliche Fälle die Einschätzung tragen. Je mehr Störungen sauber mit Ursache, Lösung und Maßnahmen abgeschlossen werden, desto besser werden die Vorschläge.
    <br>Klappt die Analyse oder der Chat nicht, steht der genaue Grund direkt darunter (z. B. Modell unbekannt, API-Schlüssel ungültig, Ollama nicht erreichbar) – das Modell und den Schlüssel trägt ein Administrator unter <b>Server-Einstellungen → Copilot</b> ein (Standard für Anthropic: <code>claude-opus-5-5</code>). Dort prüft <b>Verbindung testen</b>, welcher Schlüssel aktiv ist und ob Anthropic ihn annimmt. Meldet Anthropic, der Schlüssel sei <i>keinem Workspace zugeordnet</i> („anthropic-workspace-id header“), dort zusätzlich die <b>Anthropic-Workspace-ID</b> eintragen. Sie steht in der Claude Console unter <i>Settings → Workspaces</i>. Danach den Server neu starten.</div>
  <div class="hb-howto"><b><i class="ti ti-bulb"></i> Automatische Vorschläge bei Störungen und Tickets</b>Sobald du eine offene Störung oder ein offenes Ticket öffnest oder mit <b>Beheben</b> bzw. <b>Abschließen</b> den Assistenten startest, sucht der Copilot selbst in euren Daten. Findet er etwas, <b>blinkt der Copilot-Reiter rechts gelb</b> – im Assistenten zusätzlich der gelbe Knopf <b>„Copilot: … Vorschläge“</b>.
    <ol class="hb-steps">
      <li>Gelb blinkenden <b>Copilot</b>-Reiter (oder den gelben Knopf im Assistenten) anklicken – die Leiste klappt auf, das Blinken hört auf.</li>
      <li><b>⚠ Mögliche Dopplung</b>: Diese offenen Störungen oder Tickets beschreiben vermutlich dasselbe. Vorher hineinschauen – vielleicht kümmert sich schon jemand darum.</li>
      <li><b>💡 Bewährte Lösungen</b>: gelöste Störungen <i>und</i> Tickets mit Ursache, Lösung, Maßnahmen und verbauten Teilen, die ähnlichsten zuerst (Prozent). Gleiche Lösungen stehen nur einmal da – mit „2× so gelöst“ und den weiteren Fällen unter „auch“.</li>
      <li><b>📦 Oft benötigte Ersatzteile</b>: was bei diesen Fällen verbaut wurde, mit aktuellem Bestand (rot = nichts da). Ein Klick öffnet Teil oder Fall in der Schnellansicht – auch über dem Assistenten.</li>
    </ol>
    Die Vorschläge kommen direkt aus der Datensammlung, ohne KI und sofort. Eine Störung und das daraus erstellte Ticket gelten als ein Vorgang – sie erscheinen nicht als Dopplung voneinander und gelöste Fälle nur einmal. Für Rückfragen unten im Copilot fragen. Du siehst nur Fälle, die du sehen darfst.</div>
  <div class="hb-howto"><b><i class="ti ti-message-question"></i> Den Copilot nach euren Daten fragen</b>Den Copilot in der rechten Seitenleiste kannst du auf jeder Seite fragen – z. B. „Welche Störungen hatte Presse 3 in den letzten 30 Tagen?“, „Haben wir noch Lager 6205 und wo liegen sie?“ oder „Welche Wartungen sind diese Woche fällig?“. Er sucht dafür selbst in Störungen, Tickets, Aufgaben, Wartungen, Projekten, Anlagen, Ersatzteilen und den Messwerten aus dem Import. Links in der Antwort öffnen den Vorgang; darunter steht, welche PDH-Daten er benutzt hat. Auf einer Störung bezieht er deren Kontext mit ein. Eine Störung und das daraus erstellte Ticket behandelt er als <b>einen</b> Vorgang – er zählt sie nicht doppelt und nennt beide Links.
    <br>Der Copilot sieht nur, was du auch sehen darfst (deine Rechte und Abteilungs-Sicht), und ändert nichts. Er hat keinen Internetzugang; allgemeines Fachwissen kennzeichnet er als solches. Das selbstständige Nachschlagen gibt es mit Claude (Anthropic-Schlüssel); mit Ollama bekommt er vorab die Suchtreffer zur Frage.</div>
  <div class="hb-howto"><b><i class="ti ti-users"></i> Verantwortlich und Zugewiesen</b>Jeder Vorgang hat zwei Zuständigkeiten: <b>Verantwortlich</b> – wer dafür geradesteht und den Überblick behält – und <b>Zugewiesen</b> – wer die Arbeit macht. Das gilt einheitlich für Tickets, Störungen, Wartungspläne und -aufträge, Aufgaben (hier auch mehrere Zugewiesene), Projekte und IT-Assets. Aufträge aus einem Wartungsplan übernehmen beide Personen und die Gruppe aus dem Plan. Zusätzlich lässt sich eine <b>Gruppe</b> zuweisen (Feld „Zugewiesene Gruppe“): Alle Mitglieder sehen den Vorgang im Dashboard unter <b>Mir zugewiesen</b> und bekommen die Änderungshinweise im Chat. Auf der Seite <b>Neu anlegen</b> stehen im Feld „Zugewiesen an“ unter den Personen auch die <b>Gruppen</b> – so landet ein neuer Auftrag direkt bei einem Team.</div>
  <p>Die <b>Maßnahmen</b> einer Störung lassen sich über der Liste sortieren, z. B. nach Person oder „Häufigste zuerst“ (<a href="#sort">mehr</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "faults") "Can" $can)}}
</section>

<section class="hb-ch" id="tickets" data-title="Tickets" data-pages="tickets">
  <h2><i class="ti ti-ticket"></i> Tickets</h2>
  <p>Tickets sind Aufträge und Anfragen, z. B. „Tür klemmt“ oder „Neuer Arbeitsplatz einrichten“. Sie haben Priorität, Status, Termin und Beteiligte. Wie bei Störungen schlägt der Copilot bei offenen Tickets selbst Dopplungen, bewährte Lösungen und Ersatzteile vor – der Copilot-Reiter blinkt dann gelb (siehe <a href="#faults">Störungen → Automatische Vorschläge</a>).</p>
  <p id="work-views">Tickets, Störungen, Aufgaben und Wartungen sind aufgebaut wie der <a href="#kvp">KVP</a> – mit diesen Reitern oben auf der Seite:</p>
  {{template "hb-fig-workboard"}}
  <ul>
    <li><b>Dashboard</b> (Start): Kennzahlen des Jahres – offen, überfällig, ohne Zuweisung, angelegt, erledigt (mit Anteil termingerecht) und Ø Durchlaufzeit. Dazu der <b>Ablauf</b> nach Status, die <b>letzten 12 Monate</b> (angelegt/erledigt), die Anlagen mit den meisten Vorgängen, wer am meisten erledigt hat und <b>Braucht Aufmerksamkeit</b> (Überfälliges und Dringendes ohne Zuständigen). Mit den Pfeilen wechselst du das Jahr. Jede Kennzahl führt in die passende Liste.</li>
    <li><b>Tickets</b> (bzw. Störungen, Aufgaben, Aufträge): die Liste mit <b>Filter-Chips</b> und Anzahl – <b>Alle offenen</b>, <b>Meine</b>, <b>Ohne Zuweisung</b>, je Status, <b>Überfällig</b> (Aufgaben: <b>Ohne Projekt</b>, Wartung: <b>Fällig</b> – bis einschließlich heute – und <b>Geplant</b>) und <b>Archiv</b>. Dazu Suche, Priorität, Anlage (bei Aufgaben auch Projekt) und Kategorien. Zeile antippen – sie klappt auf mit <b>Ansehen</b>, <b>Bearbeiten</b> und <b>Abschließen</b>, <b>Beheben</b>, <b>Erledigen</b> bzw. <b>Durchführen</b> (siehe <a href="#records">Arbeiten mit Datensätzen</a>).</li>
    <li><b>Board</b>: eine Spalte je Status, Überfälliges und Wichtiges oben, rechts die in den letzten 7 Tagen erledigten. Jede Karte hat den Knopf zum <a href="#completion">Abschluss-Assistenten</a>.</li>
    <li><b>Archiv</b> (Chip): alles Abgeschlossene mit Suche (auch in der Lösung), Anlage und Zeitraum, seitenweise; <b>Lösung &amp; Ursache</b> klappt direkt auf.</li>
    <li><b>Regeln &amp; Einstellungen</b>: die Regeln des Moduls, die <b>Standard-Frist</b> (Tage nach Anlage, wenn kein Termin angegeben ist – ändern darf, wer Rollen &amp; Rechte verwaltet) und die <b>Broker</b>.</li>
  </ul>
  <p>Angelegt wird weiterhin mit dem <a href="#creation">Erstellungs-Assistenten</a> (<b>Neu</b>), abgeschlossen mit dem <a href="#completion">Abschluss-Assistenten</a>.</p>
  <p>Die <b>Detailseite</b> eines Tickets, einer Störung oder Aufgabe ist aufgebaut wie ein KVP-Vorschlag. In der <b>Übersicht</b> steht oben die Karte <b>Ticket bearbeiten</b> (bei Störungen <b>Störung beheben</b>, bei Aufgaben <b>Aufgabe erledigen</b>). Daneben steht die Karte <b>Details</b> zum Nachlesen. Ist der Vorgang abgeschlossen, zeigt die Karte das an und führt ins Archiv. Alles Änderbare liegt in eigenen Reitern:</p>
  <ul>
    <li><b>Bearbeiten</b> – Zuständigkeit (Verantwortlich, Zugewiesen, Gruppe), Termin, Anlage und Kostenstelle. Bei Tickets auch der Status, bei Aufgaben die Farbe im Gantt.</li>
    <li><b>Maßnahmen &amp; Ersatzteile</b> – festhalten, was gemacht wurde, und Teile reservieren.</li>
    <li><b>Zeit</b> – Zeit starten und stoppen, darunter alle Zeiteinträge.</li>
    <li><b>Kommentare</b> (Tickets) – für die Abstimmung im Team.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-edit"></i> So änderst du Zuständigkeit, Termin oder Anlage</b>
    <ol class="hb-steps">
      <li>Reiter <b>Bearbeiten</b> öffnen. Oder in der Karte <b>Details</b> auf <i class="ti ti-edit"></i> <b>Bearbeiten</b> tippen.</li>
      <li>Felder ändern – auch mehrere auf einmal. Jede Einstellung steht wie in den Windows-Einstellungen in einer eigenen Zeile: links, worum es geht, rechts das Feld.</li>
      <li>Unten rechts <b>Speichern</b> antippen. Links daneben erscheint die Meldung, ob es geklappt hat. Gespeichert wird nur, was du geändert hast. Jede Änderung steht danach in der <b>Historie</b>.</li>
    </ol>
    Den Status <b>Gelöst</b> oder <b>Geschlossen</b> setzt du nicht hier, sondern mit dem Abschluss-Assistenten.</div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du ein Ticket ab</b>
    <b>Bearbeiten &amp; abschließen</b> antippen – in der Karte oben in der Übersicht oder in der Liste (Zeile aufklappen → <b>Abschließen</b>). Der <a href="#completion">Abschluss-Assistent</a> fragt nacheinander Material, Zeit, wer dabei war und den Kommentar ab. Am Ende <b>Fertig</b> oder <b>Geht noch weiter</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-bell-ringing"></i> Alarm-Tickets (Schwellwerte)</b>
    <p>Überschreitet eine Messstelle einen <a href="#energiedaten-schwellwerte">Schwellwert</a>, legt das PDH ein Ticket an. Oben auf der Ticketseite steht ein Hinweis, dass es ein Alarm-Ticket ist. Ein Alarm-Ticket lässt sich nur <b>lösen, schließen, archivieren oder verwerfen</b>, wenn das Feld <b>Ursache</b> ausgefüllt ist. Sonst erscheint die Meldung „Bitte beschreiben, warum der Alarm kam (Feld Ursache).“</p>
    <ol class="hb-steps">
      <li>Ticket öffnen und im <a href="#completion">Abschluss-Assistenten</a> das Feld <b>Ursache (Pflicht bei Alarm-Tickets)</b> ausfüllen.</li>
      <li>Wie gewohnt abschließen. Die Regel gilt auch beim Archivieren, beim Verwerfen im Leitstand und beim Status-Wechsel.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-inbox"></i> Tipp für Broker</b>
    Dein Eingang ist die Seite <b>Zuweisung</b> (Navigation oben). Dort weist du direkt zu (<a href="#dashboard">mehr</a>). In der Ticketliste zeigt der Filter <b>Ohne Zuweisung</b> dieselben Tickets.</div>
  <p><b>Maßnahmen</b> und <b>Kommentare</b> eines Tickets haben eine Sortier-Leiste (<a href="#sort">mehr</a>). Ein Kommentar darf bis zu 4000 Zeichen lang sein.</p>
  {{template "hb-shots" (dict "Ref" (index $s "tickets") "Can" $can)}}
</section>

<section class="hb-ch" id="tasks" data-title="Aufgaben &amp; Projekte" data-pages="tasks projects">
  <h2><i class="ti ti-list-check"></i> Aufgaben &amp; Projekte</h2>
  <p><b>Aufgaben</b> sind To-dos mit Zuständigen, Termin und Priorität. Sie können zu einem Projekt oder einer Anlage gehören oder aus einer Störung entstehen – der Reiter <b>Verknüpfungen</b> zeigt die Zusammenhänge. Die Seite <b>Aufgaben</b> hat dieselben Reiter wie Tickets (siehe <a href="#work-views">Tickets</a>); jede Zeile zeigt auch das Projekt, der Reiter <b>Projekte</b> führt zur Projektübersicht.</p>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So schließt du eine Aufgabe ab</b>
    <b>Erledigen</b> (in der Liste, auf dem Board, im Projekt oder oben in der Aufgabe) – der <a href="#completion">Abschluss-Assistent</a> fragt nacheinander Material, Zeit, wer dabei war und den Kommentar ab. Am Ende <b>Fertig</b> oder <b>Geht noch weiter</b>.</div>
  <p><b>Projekte</b> sind das übergeordnete Aufgabenmanagement – so wie ein Wartungsplan seine Aufträge bündelt. Die Projektübersicht zeigt je Projekt eine Karte mit <b>Fortschrittsbalken</b> (erledigte von allen Aufgaben), überfälligen Aufgaben und dem nächsten Termin.</p>
  <div class="hb-howto"><b><i class="ti ti-timeline"></i> So arbeitest du mit einem Projekt</b>
    <ol class="hb-steps">
      <li>Projekt öffnen: oben steht <b>Aufgaben im Projekt</b> mit Fortschritt. <b>Neue Aufgabe</b> legt eine Aufgabe direkt im Projekt an; unter <b>Bestehende Aufgabe zuordnen</b> holst du vorhandene dazu.</li>
      <li>Die Aufgaben stehen darunter als Karten, gruppiert nach <b>Überfällig</b>, <b>In Arbeit</b>, <b>Offen</b>, <b>Wartet</b> und <b>Erledigt</b> – jede mit <b>Erledigen</b>.</li>
      <li><b>Anstehend</b> öffnet die Aufgaben-Liste gefiltert auf dieses Projekt.</li>
    </ol></div>
  <p>Zusätzlich zeigt das Projekt seine Aufgaben im <b>Zeitstrahl</b>. Ein Doppelklick auf eine Aufgabe im Zeitstrahl öffnet sie zur Bearbeitung. Der Rand der Balken zeigt, ob eine Aufgabe läuft, fällig, überfällig, nicht zugewiesen oder beendet ist (<a href="#timeline-style">Zeitstrahl-Darstellung</a>).</p>
  <p>Die <b>Maßnahmen</b> einer Aufgabe lassen sich über der Liste sortieren (<a href="#sort">mehr</a>).</p>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> Wer welche Projekte sieht</b>
    <ol class="hb-steps">
      <li>Alle Projekte sieht, wer das Recht <b>„Projekte: ansehen“</b> hat – auch auf eine Abteilung begrenzt. Dann gilt die Abteilung der Anlage oder der zugewiesenen Gruppe.</li>
      <li>Ohne dieses Recht fehlt der Menüpunkt <b>Projekte</b>. Die Projektübersicht zeigt dann nur <b>Meine Projekte</b>: Projekte, die du angelegt hast, für die du verantwortlich oder zugewiesen bist oder die deiner Gruppe zugewiesen sind.</li>
      <li>Den Knopf <b>Neues Projekt</b> gibt es nur mit dem Recht <b>Projekte bearbeiten</b> (<code>projects.edit</code>).</li>
      <li>Wer an einem Projekt beteiligt ist, sieht es immer. Der Projektname an einer Aufgabe bleibt für alle sichtbar.</li>
      <li>Zähler – die Reiter der Projektübersicht, Kategorien und die Vorgänge eines Partners – zählen nur Projekte, die du sehen darfst.</li>
      <li>Aufgaben, Partner und Anlagen-Kommentare verknüpfst du nur mit Projekten, die du sehen darfst. Ein schon verknüpftes Projekt bleibt beim Speichern erhalten.</li>
      <li>Ein Projekt-Link im Chat zeigt den Projektnamen nur, wenn der Absender das Projekt sehen darf.</li>
    </ol></div>
  {{template "hb-shots" (dict "Ref" (index $s "tasks") "Can" $can)}}
</section>

<section class="hb-ch" id="kvp" data-title="KVP – Verbesserungen" data-pages="kvp">
  <h2><i class="ti ti-bulb"></i> KVP – Kontinuierliche Verbesserung</h2>
  <p>Im <b>KVP</b> reicht jede/r Verbesserungsideen ein – vom wackeligen Regal bis zur schnelleren Rüstzeit. Einreichen dürfen alle. Alle Vorschläge sieht, wer das Recht <b>„KVP: alle Vorschläge ansehen“</b> hat; ohne dieses Recht zeigt die Seite nur <b>Meine Vorschläge</b> und <b>Idee einreichen</b>. Jede Idee bekommt innerhalb der <b>Rückmeldefrist</b> (Vorgabe 14 Tage) eine begründete Entscheidung und wird danach im <b>PDCA-Zyklus</b> umgesetzt: <b>Plan</b> → <b>Do</b> → <b>Check</b> → <b>Act</b>.</p>
  {{template "hb-fig-kvp"}}
  <div class="hb-howto"><b><i class="ti ti-bulb"></i> So reichst du eine Idee ein</b>
    <ol class="hb-steps">
      <li><b>KVP</b> → <b>Idee einreichen</b> – oder <b>Neu anlegen</b> → Kachel <b>KVP-Idee</b>, oder die Schnellaktion „Idee einreichen“ im Dashboard. Es öffnet sich der Einreich-Assistent; mit <b>OK – weiter</b> geht es Schritt für Schritt.</li>
      <li><b>Thema</b> antippen.</li>
      <li><b>Was stört?</b> Titel und Ist-Zustand – beides Pflicht.</li>
      <li><b>Vorschlag</b>: wie geht es besser (Pflicht) und was bringt es (Nutzen).</li>
      <li><b>Wo?</b> Anlage oder Bereich – freiwillig. <b>Team</b>: Miteinreichende ankreuzen. Mit dem Recht „KVP steuern“ kannst du hier für jemand anderen einreichen.</li>
      <li><b>Einreichen</b> öffnet den Vorschlag; <b>Einreichen &amp; nächste</b> beginnt gleich die nächste Idee. Im Reiter <b>Vorher/Nachher</b> ein Foto vom Ist-Zustand anhängen. Jede Entscheidung bekommst du per Chat von „Service“.</li>
    </ol>
    Solange der Vorschlag noch nicht bewertet wird, kannst du ihn unter <b>Vorschlag bearbeiten</b> ändern.</div>
  <div class="hb-howto"><b><i class="ti ti-scale"></i> So wird bewertet und entschieden</b> (Recht „KVP steuern“)
    <ol class="hb-steps">
      <li>Im Vorschlag oben bei <b>Nächster Schritt</b> auf <b>Weiter</b> tippen. Der Assistent fragt zuerst die <b>Bewertung</b> ab: Nutzen und Aufwand (je 1–5), geschätzte Einsparung und Kosten sowie <b>Setzt um</b>. PDH ordnet den Vorschlag in die Matrix ein: <b>Quick Win</b>, <b>Großprojekt</b>, <b>Lückenfüller</b> oder <b>Fragwürdig</b>.</li>
      <li>Dann <b>Wie geht es weiter?</b> – <b>Bewertung beginnen</b>, <b>Annehmen</b>, <b>Zurückstellen</b> oder <b>Ablehnen</b>, immer mit Begründung – und <b>Fertig</b>. <b>Nur speichern</b> hält die Bewertung fest, ohne zu entscheiden. Die Einreichenden werden benachrichtigt; bei Annahme auch die/der Umsetzungsverantwortliche.</li>
    </ol>
    Ist die Frist überschritten, steht der Vorschlag rot im Dashboard und PDH erinnert die Bewertenden täglich.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> So wird umgesetzt (PDCA)</b> – mit dem Assistenten unter <b>Nächster Schritt</b> → <b>Weiter</b>
    <ol class="hb-steps">
      <li><b>Plan:</b> Ursache (5×Warum), messbares Ziel und Termin, dann Maßnahmen – jede mit <b>wer</b> und <b>bis wann</b>. Zum Schluss <b>Umsetzung starten</b>.</li>
      <li><b>Do:</b> erledigte Maßnahmen abhaken (das darf auch, wer für die Maßnahme eingetragen ist). Erst wenn alle erledigt sind, geht es zu <b>Wirksamkeit prüfen</b>.</li>
      <li><b>Check:</b> <b>wirksam</b> oder <b>nicht wirksam</b> mit Ergebnis festhalten. Wirksam → <b>Standardisieren</b>; nicht wirksam → <b>neuer PDCA-Zyklus</b> zurück in Plan.</li>
      <li><b>Act:</b> beschreiben, was zum Standard wurde (Arbeitsanweisung, Checkliste, Schulung …), tatsächliche Einsparung und ggf. Prämie – dann <b>Abschließen</b>.</li>
    </ol>
    Wie im Abschluss-Assistenten: <b>Fertig</b> schaltet weiter, <b>Nur speichern – geht noch weiter</b> sichert nur die Angaben. Fehlt für einen Schritt noch etwas, nennt PDH es bei der Auswahl und schaltet nicht weiter; das bereits Eingegebene bleibt gespeichert. Einzelne Angaben lassen sich auch direkt in den Reitern <b>Bewertung</b> und <b>PDCA &amp; Maßnahmen</b> ändern. <b>A3-Report</b> druckt den ganzen Vorschlag auf einer Seite zum Aushängen.</div>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> Wer welche Vorschläge sieht</b>
    <ol class="hb-steps">
      <li>Mit „KVP: alle Vorschläge ansehen“ siehst du alle Ideen samt Kennzahlen, Dashboard und PDCA-Board. Das Recht kann auf eine Abteilung der Anlage begrenzt sein; dann sind Dashboard-Kennzahlen über alle Ideen ausgeblendet, Liste, Board und Zähler zeigen die sichtbaren Ideen.</li>
      <li>Ohne das Recht siehst du nur Ideen, an denen du beteiligt bist: eingereicht, miteingereicht, angelegt, bewertet, verantwortlich oder für eine Maßnahme eingetragen. Kennzahlen (Einsparungen, Prämien, Zahlen je Person) und das Board fehlen. Das Widget „KVP-Vorschläge“ auf der Startseite erscheint ebenfalls nur mit dem Recht.</li>
      <li>Die Zähler der Reiter und Filter zählen nur Ideen, die du sehen darfst. „Meine“ zeigt alle Ideen, an denen du beteiligt bist – auch über eine Maßnahme.</li>
      <li>Detail, A3-Report, Kommentare, Historie und die Liste der Anhänge einer Idee öffnen sich mit dem Recht oder wenn du beteiligt bist. Wer den Link einer Datei hat, kann sie weiterhin öffnen.</li>
    </ol></div>
  <p>Das <b>Dashboard</b> zeigt Kennzahlen des Jahres (Vorschläge je Mitarbeitende/n, Annahmequote, Ø Zeit bis zur Entscheidung, Beteiligung, Einsparungen und Prämien), den Ablauf, die letzten 12 Monate, die Themen, die Nutzen-Aufwand-Matrix und alles Überfällige. Das <b>PDCA-Board</b> zeigt die Vorschläge in Umsetzung als Karten. Unter <b>Regeln &amp; Vorlagen</b> stehen die KVP-Regeln; dort stellt die KVP-Steuerung die Rückmeldefrist ein.</p>
  <p>Die <b>Maßnahmen</b> im Schritt „Do“ sind ab Werk <b>nach Termin</b> geordnet; die Kommentare haben dieselbe Sortier-Leiste (<a href="#sort">mehr</a>). Assistent, Abhak-Ansicht und A3-Report bleiben nach Termin sortiert.</p>
  {{template "hb-shots" (dict "Ref" (index $s "kvp") "Can" $can)}}
</section>

<section class="hb-ch" id="ruestzeiten" data-title="Rüstzeiten" data-pages="setup">
  <h2><i class="ti ti-arrows-exchange-2"></i> Rüstzeiten</h2>
  <p>Eine <b>Rüstzeit</b> ist die Zeit, in der eine Anlage umgerüstet, gereinigt oder mit neuen Hilfsmitteln bestückt wird. Sie ist ein Vorgang wie ein Ticket: mit Nummer (<b>RZ-0001</b>), Anlage, Grund, Beginn und Ende. Sie hat die Status <b>Rüsten</b> (läuft), <b>Beendet</b> und <b>Störung durch Rüsten</b>. Läuft sie zu lange, meldet PDH von selbst eine Störung. Alles hier ist ein Zusatz: Ohne Rüsttasten an einer Anlage bleibt alles wie bisher.</p>
  {{template "hb-fig-ruesten"}}
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So richtest du Rüsttasten ein</b> (Recht „Rüstzeiten: erfassen, korrigieren, Katalog und Höchstdauer pflegen“)
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> öffnen → Karte <b>Rüstzeiten: Rüsttasten</b>. Zuerst gibt es die <b>Rüstgründe</b>, z. B. „Formatwechsel“ oder „Reinigung“. Der Grund bestimmt, wie eine Rüstzeit in der Auswertung eingeordnet wird.</li>
      <li>Bei <b>Neue Rüsttaste</b> einen Namen (höchstens 60 Zeichen) eintragen und den Grund wählen → anlegen.</li>
      <li>Anlage öffnen → Reiter <b>Rüsttasten</b> → passende Tasten anhaken → speichern. An einer Halle oder Linie zugeordnet, gilt die Taste für alle Anlagen darunter (dort steht „über …“).</li>
    </ol>
    Ein Grund oder eine Taste, die schon verwendet wird, lässt sich nur ausblenden. Endgültig löschen darf nur der Bereichsadministrator der Rüstzeiten.</div>
  <div class="hb-howto"><b><i class="ti ti-clock-cog"></i> So stellst du die Höchstdauer ein</b>
    <ol class="hb-steps">
      <li><b>Core-Einstellungen</b> → Karte <b>Rüstzeiten: Höchstdauer und Karenzzeit</b>. Die <b>maximale Rüstzeit</b> (Standard 120 Minuten) gilt für alle Anlagen als Obergrenze. Die <b>Karenzzeit</b> (Standard 15 Minuten) ist die Schonfrist danach, bevor eine Störung entsteht.</li>
      <li>Soll eine Anlage kürzer rüsten, trägst du an der Anlage im Reiter <b>Rüsttasten</b> bei <b>Höchstdauer Rüsten (Minuten)</b> einen eigenen Wert ein. Darunter steht, welcher Wert gerade <b>wirksam</b> ist und woher er kommt.</li>
      <li>Ein eigener Wert über der maximalen Rüstzeit gilt nicht. Dann erscheint der Hinweis, dass die maximale Rüstzeit gilt – trage einen kleineren Wert ein.</li>
      <li>Maximale Rüstzeit und Karenzzeit sind jeweils höchstens 10080 Minuten (7 Tage). Beide Werte und der Katalog (Rüstgründe und Rüsttasten) gelten für den <b>ganzen Betrieb</b>, nicht je Abteilung. Wer „Rüstzeiten: erfassen, korrigieren, Katalog und Höchstdauer pflegen“ auch nur in einer Abteilung hat, kann sie ändern.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-hand-finger"></i> So rüstest du an der Anlage</b> (ohne Anmeldung im Easy-Modus oder angemeldet auf der Anlagenseite)
    <ol class="hb-steps">
      <li>QR-Code der Anlage scannen. Unter <b>Rüsten</b> stehen die Rüsttasten der Anlage.</li>
      <li>Passende Rüsttaste <b>einmal antippen</b> – die Rüstzeit läuft. Die Seite zeigt, was gerade gerüstet wird.</li>
      <li>Ist die Anlage fertig, auf <b>Fertig</b> tippen. Eine Notiz ist freiwillig.</li>
      <li>Im Easy-Modus gibt es über den Tasten das freiwillige Feld <b>Kürzel/Name</b> (darf leer bleiben). Es steht bei der laufenden Rüstzeit und in der Rüstzeit selbst.</li>
      <li>Vergessen zu tippen? Unter <b>Rüstzeit nachtragen</b> Rüsttaste wählen, <b>Beginn</b> und <b>Ende</b> (oder die Dauer in Minuten) eintragen und auf <b>Nachtragen</b> tippen. Möglich sind höchstens 14 Tage zurück und höchstens 7 Tage Dauer; nicht in der Zukunft. Eine nachgetragene Rüstzeit startet nie ein zweites, paralleles Rüsten.</li>
    </ol>
    Die Taste der laufenden Rüstzeit ist hervorgehoben und lässt sich nicht noch einmal antippen. Eine andere Taste beendet die laufende Rüstzeit und beginnt sofort die neue. Soll mit derselben Taste neu begonnen werden, zuerst auf <b>Fertig</b> tippen und dann die Taste erneut antippen.
    Zu viele Antippen hintereinander bremst PDH: je Anlage sind 30 Vorgänge in 10 Minuten möglich. Je Anlage läuft höchstens eine Rüstzeit.</div>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So erfasst und korrigierst du eine Rüstzeit im PDH</b> (Recht „Rüstzeiten: erfassen …“)
    <ol class="hb-steps">
      <li><b>Rüstzeiten</b> → <b>Neu</b> – oder die Schnellaktion „Rüstzeit erfassen“ im Dashboard. Schritt für Schritt geht es auch über <b>Neu anlegen</b> → Kachel <b>Rüstzeit</b> (siehe <a href="#creation">Erstellungs-Assistent</a>).</li>
      <li><b>Anlage</b> und <b>Grund</b> wählen, <b>Beginn</b> eintragen. Ohne Ende läuft die Rüstzeit weiter; mit <b>Ende</b> oder <b>Dauer</b> wird sie nachgetragen.</li>
      <li><b>Rüstzeit anlegen</b> öffnet die Detailseite. Dort beendest du eine laufende Rüstzeit mit <b>Beenden</b>.</li>
      <li>Beginn, Ende, Grund und Notiz korrigierst du im Reiter <b>Bearbeiten</b>. Bei einer beendeten Rüstzeit ist das <b>Ende</b> Pflicht – sie wird nie wieder geöffnet; fehlt das Ende, erscheint eine Meldung und nichts wird geändert. Hat die Rüstzeit schon eine Störmeldung ausgelöst, bleiben Beginn und Ende gesperrt.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Was passiert bei Überschreitung</b>
    <ol class="hb-steps">
      <li>Läuft die Rüstzeit länger als die Höchstdauer, zeigt die Seite „Höchstdauer überschritten“. Noch ist alles ruhig.</li>
      <li>Nach Höchstdauer <b>plus Karenzzeit</b> legt PDH <b>genau eine</b> Störmeldung „Störung durch Rüsten: …“ mit hohem Schweregrad an. Die Rüstzeit bekommt den Status <b>Störung durch Rüsten</b>, die Anlage gilt als stehend.</li>
      <li>Für die Rüstzeit verantwortlich ist der <b>Anlagenverantwortliche</b>, zugeordnet ist der <b>Schichtführer</b>, der gerade Dienst hat. Für die Störmeldung gilt die Störungsrichtlinie wie bei jeder Störung.</li>
      <li>Die Rüstzeit zählt <b>bis zur Störmeldung</b>; die Zeit danach läuft als Störung. Den Status der Anlage bestimmt immer die neueste Rüstzeit.</li>
    </ol>
    Auf einem Spiegelserver läuft diese Überwachung nicht.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer darf was bei Rüstzeiten?</b>
    <ul>
      <li><b>Rüstzeiten: ansehen</b> – Liste, Detailseite und Historie.</li>
      <li><b>Rüstzeiten: erfassen, korrigieren, Katalog und Höchstdauer pflegen</b> – Rüstzeiten anlegen und ändern, Rüsttasten und Gründe pflegen, Höchstdauer an der Anlage setzen.</li>
      <li><b>Rüstzeiten: Bereichsadministrator</b> – alle Rechte des Bereichs und als Einziger endgültig löschen.</li>
    </ul>
    Wer bisher Anlagen sehen oder bearbeiten durfte, hat die passenden Rechte automatisch bekommen.</div>
  <p>Wie bei Tickets gibt es Feldsätze, Kategorien, Verknüpfungen, Anhänge und eine Historie. Die Rüstzeiten einer Anlage stehen auch in deren Historie (Filter „Rüstzeiten“).</p>
  {{template "hb-shots" (dict "Ref" (index $s "ruestzeiten") "Can" $can)}}
</section>

<section class="hb-ch" id="maintenance" data-title="Wartung" data-pages="maintenance checklists">
  <h2><i class="ti ti-tool"></i> Wartung</h2>
  <p>Ein <b>Wartungsplan</b> sagt, was wie oft an welcher Anlage gemacht wird – z. B. „alle 2 Wochen“ oder „alle 6 Monate“. Zu jedem aktiven Plan gibt es immer <b>genau einen offenen Auftrag</b>: den nächsten Termin. PDH legt ihn selbst an – beim Anlegen des Plans, nach jedem Abschluss oder Überspringen und stündlich für Pläne, denen einer fehlt. Doppelte Aufträge entstehen nicht.</p>
  <p>Die Wartung ist aufgebaut wie Tickets und der KVP (siehe <a href="#work-views">Tickets</a>):</p>
  <ul>
    <li><b>Dashboard</b>, <b>Aufträge</b> und <b>Board</b> – Kennzahlen, Liste mit Filter-Chips und Status-Spalten. Unter <b>Alle offenen</b> stehen die Aufträge, deren Vorlauf begonnen hat oder die in den nächsten 7 Tagen fällig sind; der Chip <b>Geplant</b> zeigt die späteren.</li>
    <li><b>Jahresplan</b> – je Plan eine Zeile, je Monat eine Spalte: ✓ erledigt, ● offen (rot, wenn überfällig), ○ geplant. Ein Klick öffnet den Auftrag bzw. den Plan.</li>
    <li><b>Pläne</b> – alle Pläne mit Intervall, Checklisten samt Takt und nächstem Termin.</li>
    <li><b>Rundgänge</b> – die Kontrollrundgänge mit ihren Stationen und dem Knopf <b>Rundgang starten</b> (siehe unten).</li>
    <li><b>Checklisten</b> – die Vorlagen bearbeiten.</li>
    <li><b>Regeln &amp; Einstellungen</b> – Regeln, Standard-Frist und Broker für Wartungen.</li>
  </ul>
  <p>Das <b>Archiv</b> ist der Chip <b>Archiv</b> unter <b>Aufträge</b> – mit den erledigten Checklisten, siehe unten.</p>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So führst du eine Wartung durch</b>
    <ol class="hb-steps">
      <li>Unter <b>Aufträge</b> oder auf dem <b>Board</b> bei der Wartung <b>Durchführen</b> antippen – oder im Auftrag den großen Knopf <b>Wartung durchführen</b>. Am <a href="#dashboard">Leitstand</a> geht es genauso über <b>Fertig</b> und die Karte.</li>
      <li>Zuerst kommt die <b>Checkliste</b>: ein Punkt nach dem anderen, darüber der Name der Checkliste. Abhaken, Messwert eintragen (PDH zeigt sofort, ob er zwischen Min und Max liegt) oder Text schreiben. Jeder Punkt wird beim <b>Weiter</b> sofort gespeichert – wirst du unterbrochen, geht es später am offenen Punkt weiter.</li>
      <li>Mit <i class="ti ti-camera-plus"></i> <b>Foto</b> hängst du Bilder direkt an den Punkt – am Handy öffnet sich die Kamera. Das geht überall gleich, auch am Leitstand.</li>
      <li>Danach Material (oder „kein Material“), Zeit (vorgeschlagen ist die geplante Dauer), wer dabei war und ein Kommentar – er wird als Maßnahme gespeichert. Ohne ausgefüllte Pflichtpunkte (✱) lässt sich nicht abschließen.</li>
      <li><b>Fertig</b>: PDH zeigt „Nächster Termin: …“ und legt den Folgeauftrag an. <b>Geht noch weiter</b> speichert alles und lässt den Auftrag offen.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-file-check"></i> Was nach dem Fertigmelden passiert</b>
    <ul>
      <li><b>Wartungsprotokoll als PDF</b> – am Auftrag und als Kopie an der Anlage (Reiter <b>Dokumente</b>): Firmenlogo, Datum, Ausführende(r) und Beteiligte, die Checklisten mit Werten, Vorgaben und Fotos, Maßnahmen, Ersatzteile und Bemerkung.</li>
      <li><b>Rückmeldung im Chat</b> an Verantwortliche, Zugewiesene und wer den Auftrag angelegt hat: wer erledigt hat, ob alles in Ordnung war (⚠ bei Abweichungen), nächster Termin und Links. Wer selbst erledigt hat, bekommt keine Nachricht.</li>
      <li>Der Auftrag zeigt danach das Ergebnis je Checkliste mit Werten, Fotos, Protokoll und dem Link zum Folgeauftrag.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock-open"></i> Wer darf eine Wartung fertig melden?</b>Wer dem Auftrag <b>zugewiesen</b> ist, ihn <b>verantwortet</b> oder zur <b>zugewiesenen Gruppe</b> gehört – auch ohne die Rollenrechte „Wartung bearbeiten/abschließen“. Ist niemand zugewiesen, darf ihn jeder übernehmen (außer Betrachtern). Andere brauchen die Rollenrechte. Am Leitstand genügt die Karte (Instandhaltung/IT). Die Arbeitszeit fragt der Assistent ab – eine eigene Zeiterfassung im Auftrag gibt es nicht.</div>
  {{template "hb-fig-maintenance"}}
  <div class="hb-howto"><b><i class="ti ti-calendar-plus"></i> So legst du einen Wartungsplan an</b>
    <ol class="hb-steps">
      <li><b>Neuer Plan</b> antippen (oder in einem Plan <i class="ti ti-copy"></i> zum Kopieren).</li>
      <li><b>Was</b>: Anlage, Name und Art.</li>
      <li><b>Wann</b>: „alle N Tage / Wochen / Monate / Jahre“ und der <b>nächste Termin</b>. Der <b>Vorlauf (Tage)</b> legt fest, ab wann der Auftrag unter Aufträge („Alle offenen“) und am Leitstand erscheint – bei 0 erst am Fälligkeitstag.</li>
      <li><b>Nach der Durchführung</b>: <b>ab Durchführung</b> (Erledigt-Datum + Intervall) oder <b>fester Rhythmus</b> (die Termine bleiben im Takt, z. B. für Prüffristen; nach langer Überfälligkeit rechnet PDH bis heute weiter). Monate und Jahre rechnet PDH kalendergenau (15.01. → 15.02.).</li>
      <li><b>Wer</b>: Zugewiesen, Gruppe, Verantwortlich (bekommt die Rückmeldung) und die geplante Dauer.</li>
      <li><b>Checklisten</b> hinzufügen und je Checkliste den <b>Takt</b> wählen – „bei jedem Termin“ oder z. B. „alle 1 Monate“. Darunter steht, wann sie zuletzt abgefragt wurde. Die Vorschau zeigt die nächsten Termine.</li>
      <li><b>Speichern</b>. Der erste Auftrag ist sofort da. Änderungen am Plan übernimmt der offene Auftrag, solange daran noch nichts erfasst ist.</li>
    </ol>
    Ein Plan, der eine Zeit nicht gebraucht wird, lässt sich <b>ruhen lassen</b> – sein offener Auftrag verschwindet, beim <b>Aktivieren</b> kommt er wieder. Aufträge ohne Plan legst du mit <b>Einzelauftrag</b> an.</div>
  <div class="hb-howto"><b><i class="ti ti-archive"></i> Erledigte Checklisten im Archiv ansehen</b>
    <ol class="hb-steps">
      <li>Unter <b>Aufträge</b> den Chip <b>Archiv</b> öffnen. Die neuesten Wartungen stehen oben, je Seite 50 – mit „Ältere“ blätterst du weiter.</li>
      <li>Eingrenzen mit <b>Suche</b> (Titel, Anlage, Plan, Bemerkung), <b>Anlage</b> (inklusive Unteranlagen und Rundgang-Stationen), <b>Plan</b>, Zeitraum <b>von/bis</b>, <b>erledigt/übersprungen</b> und <b>nur mit Abweichungen</b> – dann <b>Filtern</b>.</li>
      <li>Jede Zeile zeigt, wer die Wartung ausgeführt hat, Abweichungen (⚠ außerhalb Min/Max, nicht abgehakt), die Zahl der Fotos und das Protokoll-PDF.</li>
      <li>Auf <i class="ti ti-chevron-right"></i> oder <b>Punkte</b> tippen: Die Checkliste klappt auf – jeder Punkt mit Wert, Vorgabe, wer ihn wann erfasst hat und den Fotos. Bei Rundgängen nach Stationen gegliedert.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-route"></i> Kontrollrundgang</b>Ein Kontrollrundgang führt nacheinander über mehrere Anlagen – z. B. der Schichtrundgang durch Halle 2. Jede <b>Station</b> ist eine Anlage mit einer kurzen Checkliste. Termine, Anstehend, Jahresplan, Leitstand, Protokoll-PDF und Rückmeldung laufen wie bei jedem Wartungsplan.
    <ol class="hb-steps">
      <li>Reiter <b>Rundgänge</b> → <b>Neuer Rundgang</b>.</li>
      <li>Name und <b>Bereich</b> wählen (Halle, Linie …) – die Stationen liegen darunter. Intervall, Vorlauf und Zuständige wie bei einem Plan.</li>
      <li>Stationen hinzufügen: <b>Anlage</b> und <b>Checkliste</b> wählen, <b>Station hinzufügen</b>. <b>Alle Unteranlagen</b> übernimmt alle Anlagen direkt unter dem Bereich mit der gewählten Checkliste auf einmal. Die gleiche Checkliste darf an vielen Anlagen stehen.</li>
      <li>Mit den Pfeilen die <b>Reihenfolge</b> festlegen – so wird der Rundgang abgefragt. Jede Station kann ihren eigenen Takt haben (z. B. der Kran nur monatlich); nicht fällige Stationen fallen beim Termin weg.</li>
      <li>Durchführen: im Reiter <b>Rundgänge</b> auf <b>Rundgang starten</b> (oder unter Aufträge, am Leitstand). Oben steht <b>Station 2 von 5</b> mit dem Namen der Anlage.</li>
      <li>Ist an einer Station etwas nicht in Ordnung: <i class="ti ti-alert-triangle"></i> <b>Mangel melden</b>. Die Störung wird mit dieser Anlage angelegt, danach geht es im Rundgang weiter.</li>
      <li>Unterbrochen? Alles Erfasste ist gespeichert – <b>Rundgang fortsetzen</b> macht beim offenen Punkt weiter. Im Protokoll und im Auftrag stehen die Ergebnisse je Station.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-check"></i> Checklisten einrichten</b>
    <ol class="hb-steps">
      <li>Reiter <b>Checklisten</b> öffnen und eine Checkliste anlegen – am besten je Takt eine eigene, z. B. „Säge – jedes Mal“ und „Säge – monatlich“.</li>
      <li>Punkte hinzufügen: Name eintragen, Art wählen und <b>+ Punkt</b>. Du bleibst danach im Anlegen – Art, Pflicht und Einheit bleiben stehen, der Cursor steht wieder im Namensfeld, so legst du mehrere Punkte hintereinander an. Die Arten:
        <ul>
          <li><b>Abhaken</b> – erledigt / nicht erledigt.</li>
          <li><b>Messwert</b> – mit Einheit und den Vorgaben <b>Soll</b>, <b>Min</b> und <b>Max</b>; die Felder erscheinen beim Anlegen direkt, sobald „Messwert“ gewählt ist.</li>
          <li><b>Freitext</b> – Beobachtungen, Zählerstände o. Ä.</li>
        </ul>
        <b>Pflicht</b> (✱) heißt: ohne diesen Punkt kein Abschluss.</li>
      <li>Mit <i class="ti ti-photo-plus"></i> <b>Bild</b> Fotos oder Skizzen zur <b>Darstellung</b> hinterlegen (z. B. wo der Messpunkt sitzt). Sie erscheinen bei der Durchführung über dem Eingabefeld.</li>
      <li>Die Reihenfolge der Punkte lässt sich ändern. Eine Checkliste kann in mehreren Plänen stecken.</li>
    </ol></div>
  <p>Die <b>Maßnahmen</b> einer Wartung stehen jetzt immer im Reiter <b>Übersicht</b> – auch vor dem Abschließen, dort nur zum Lesen. Eingetragen werden sie weiter beim Abschließen. Sortieren geht wie in <a href="#sort">Listen sortieren</a> beschrieben.</p>
  {{template "hb-shots" (dict "Ref" (index $s "maintenance") "Can" $can)}}
</section>

<section class="hb-ch" id="infrastructure" data-title="Infrastruktur &amp; IT" data-pages="infrastructure it it-net it-categories hmi">
  <h2><i class="ti ti-hierarchy-2"></i> Infrastruktur &amp; IT</h2>
  <p>Der Anlagenbaum bildet euren Betrieb ab: Gebäude → Linien → Anlagen → Geräte. Er startet zugeklappt; mit dem Pfeil klappst du einen Ast auf, die übrigen Äste klappen dabei zu. Kommst du zurück, ist der zuletzt geöffnete Ast wieder offen. <b>Alle aufklappen</b> zeigt den ganzen Baum. In der Anlagenauswahl (z. B. beim Melden) gilt das genauso; beim Suchen werden alle Treffer aufgeklappt.</p>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer darf was bei der Infrastruktur?</b>Unter <b>Rollen &amp; Rechte</b> (Gruppe „Infrastruktur &amp; Anlagen“) gibt es drei Rechte:
    <ul>
      <li><b>Infrastruktur ansehen</b> – Anlagenbaum, Stammkarte, Historie und Kommentare. Ohne dieses Recht fehlt der Menüpunkt. Die Anlagenauswahl beim Melden von Tickets oder Störungen funktioniert trotzdem.</li>
      <li><b>Infrastruktur anlegen, bearbeiten &amp; deaktivieren</b> – Stammdaten, Unteranlagen, Kopieren, Massenbearbeitung, Bauteile und Meldetexte. Schließt Ansehen und Prüfpflichten ein.</li>
      <li><b>Prüfpflichten &amp; Gefährdungsbeurteilungen pflegen und erledigen</b> – im Reiter <b>Prüfungen &amp; GBU</b> anlegen, ändern und Durchführungen erfassen, ohne die Stammdaten der Anlage zu ändern.</li>
    </ul>
    Die Rolle <b>Anlagenverantwortliche/r</b> hat alle drei Rechte und dazu alles, was Techniker dürfen, außerdem Tickets, Störungen und Wartung bearbeiten und abschließen. Sie steht im Rang zwischen Techniker und Manager. Rechte und Rolle lassen sich unter <b>Rollen &amp; Rechte</b> anpassen, einzelne Personen über <b>Einzelrechte</b> im Benutzerstamm.</div>
  <div class="hb-howto"><b><i class="ti ti-stack-push"></i> So legst du viele Anlagen auf einmal an</b>
    <ol class="hb-steps">
      <li>Oben auf <b>Sammelanlegen</b> tippen – oder eine Anlage antippen und unten <b>Sammelanlegen</b> wählen, dann ist sie schon als übergeordnetes Element gewählt.</li>
      <li><b>Ebene 1</b>: Typ wählen (z. B. Anlage), dazu Präfix, von und bis – z. B. „Presse “ von 1 bis 6.</li>
      <li><b>Ebene 2</b> (optional): z. B. Geräte „Motor “ von 1 bis 3 unter jeder Presse. Mit „Namen der Ebene 1 voranstellen“ heißen sie „Presse 1 Motor 1“ usw.</li>
      <li><b>Anlegen</b>. Neue Elemente übernehmen Standort, Kostenstelle und Abteilung des übergeordneten Elements; den Rest ergänzt du in den Stammdaten.</li>
    </ol>
    Elemente gleichen Namens werden nicht doppelt angelegt.</div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> So kopierst du eine Anlage</b>
    <ol class="hb-steps">
      <li>Die Anlage im Baum antippen und unten <b>Kopieren</b> wählen.</li>
      <li><b>Ziel</b> (übergeordnetes Element) und <b>Name</b> wählen – für mehrere Kopien Präfix, von und bis, z. B. „Linie “ von 2 bis 4.</li>
      <li>„mit allen Unteranlagen“ kopiert den ganzen Ast mit.</li>
    </ol>
    Kopiert werden Typ, Beschreibung, Standort, Hersteller, Modell, Partner, Kostenstelle, Abteilung und bei Trockenkammern die Bauteil-Positionen. Seriennummer, Inbetriebnahme, Vorgänge und Historie bleiben leer.</div>
  <p>Zu jeder Anlage gibt es:</p>
  <ul>
    <li><b>Übersicht</b> – die wichtigsten Stammdaten auf einen Blick und die Unteranlagen (anklickbar).</li>
    <li><b>Stammdaten</b> – alle Angaben in einem Formular: Name, Typ, übergeordnetes Element, Standort, Beschreibung, Hersteller, Modell, Seriennummer, „In Betrieb seit“, Lieferant, Servicepartner (Auswahl aus den Lieferanten), Kostenstelle, Abteilung und <b>Verantwortlich</b>. Ohne eigene Angabe gelten Abteilung und Verantwortliche/r des übergeordneten Elements – die Stammkarte zeigt dann „geerbt von …“. Neue Tickets, Störungen, Wartungsaufträge und Aufgaben an der Anlage ohne eigene Angabe bekommen diese Person als <b>Verantwortlich</b> (abschaltbar unter Core-Einstellungen → „Verantwortliche aus der Infrastruktur“).</li>
    <li><b>Anlagen-Historie</b> – das „Lebenslauf-Buch“ der Anlage: alle Störungen, Tickets, Wartungen, Maßnahmen, verbrauchten Ersatzteile und Kommentare. Mit Filter, Suche und <b>CSV-Export</b>. Wichtige Hinweise lassen sich als Kommentar <b>anheften</b>.</li>
    <li><b>Verknüpfungen</b> – offene Vorgänge, passende Ersatzteile, Firmen.</li>
    <li><b>HMI</b> – Fernzugriff auf die Bediengeräte der Anlage (VNC), je nach Berechtigung nur ansehen oder bedienen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Anlage an</b>
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> → <b>Hinzufügen</b>. Für eine Unteranlage geht es schneller über das <b>+</b> in der Zeile im Baum oder auf der Anlage über <b>Untergeordnete Anlagen → Hinzufügen</b>.</li>
      <li><b>Name</b>, <b>Typ</b> und – falls nötig – <b>Übergeordnet</b> und <b>Standort</b> eintragen → <b>Anlegen &amp; weiter</b>.</li>
      <li>Die neue Anlage öffnet sich im Reiter <b>Stammdaten</b>. Hersteller, Modell, Seriennummer, Partner, Kostenstelle und Abteilung ergänzen → <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-edit"></i> So änderst du eine Anlage</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>Stammdaten</b> (oder auf der Übersicht <b>Bearbeiten</b>).</li>
      <li>Felder ändern. Über <b>Typ</b> und <b>Übergeordnet</b> lässt sich eine Anlage auch umordnen, z. B. an eine andere Linie hängen – mit allen Unteranlagen.</li>
      <li><b>Speichern</b>. Die Änderung steht im Reiter <b>Änderungen</b>.</li>
    </ol>
    Eine Anlage kann nicht unter sich selbst oder unter eine ihrer eigenen Unteranlagen gehängt werden.</div>
  <h3 id="obligations"><i class="ti ti-clipboard-check"></i> Prüfpflichten &amp; Gefährdungsbeurteilungen</h3>
  <p>Im Reiter <b>Prüfungen &amp; GBU</b> jeder Anlage stehen wiederkehrende <b>Prüfpflichten</b> (z. B. DGUV V3, UVV, Druckbehälter, Leitern) und <b>Gefährdungsbeurteilungen</b> nach ArbSchG §5. Bald Fälliges ist gelb, Überfälliges rot; die Zahl am Reiter zeigt, wie viele anstehen. Oben auf der Seite <b>Infrastruktur</b> stehen alle fälligen Einträge über alle Anlagen.</p>
  <p>Im Reiter <b>Meldetexte</b> legst du fest, welche vorformulierten Meldungen der <a href="#hb-easy-texts">Easy-Mode</a> an dieser Anlage als Tasten anbietet.</p>
  <div class="hb-howto" id="hb-chamber"><b><i class="ti ti-temperature"></i> So pflegst du eine Trockenkammer</b>
    <ol class="hb-steps">
      <li>Trockenkammer anlegen wie ein Gebäude: <b>Hinzufügen</b> bzw. <b>Unteranlage hinzufügen</b> → Typ <b>Trockenkammer</b>. Eine bestehende Anlage stellst du unter <b>Stammdaten</b> → Typ um.</li>
      <li>Reiter <b>Bauteile</b> öffnen. Dort gibt es je eine Karte für <b>Motoren</b>, <b>Klappenmotoren</b>, <b>Heizungsstellventile</b>, <b>Heizungspumpen</b>, <b>Torrollen</b> und <b>Tordichtungen</b>.</li>
      <li>Je Karte rechts die <b>Anzahl</b> eintragen und <b>Übernehmen</b> – es entsteht je Stück eine Kachel (Motor 1, Motor 2 …), von links nach rechts.</li>
      <li>In jeder Kachel: <b>Typ (Ersatzteil)</b> – Teilenummer oder Bezeichnung tippen und aus der Liste wählen –, <b>NOK</b> anhaken, wenn das Bauteil defekt ist, <b>Letzter Wechsel</b> und <b>Ursache</b> eintragen. Dann <b>… speichern</b> unter der Karte.</li>
    </ol>
    NOK-Kacheln sind rot; am Reiter steht, wie viele Bauteile NOK sind. Wird die Anzahl verringert, fallen die hinteren Kacheln mit ihren Angaben weg (PDH fragt vorher nach). Jede Änderung steht in der Historie der Anlage, z. B. „Motor 2: NOK, Wechsel 01.10.2026, Ursache: Lagerschaden“.</div>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Prüfpflicht oder GBU an</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>Prüfungen &amp; GBU</b> → bei Prüfpflichten bzw. Gefährdungsbeurteilungen <b>Hinzufügen</b>.</li>
      <li>Bezeichnung, Grundlage, Prüfer/Firma und <b>Intervall</b> in Monaten eintragen (0 = einmalig).</li>
      <li><b>Zuletzt erledigt</b> eintragen – die nächste Fälligkeit rechnet PDH selbst aus – oder die <b>nächste Fälligkeit</b> direkt angeben.</li>
      <li><b>Erinnern (Tage vorher)</b> und die <b>verantwortliche Person</b> wählen → <b>Speichern</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-circle-check"></i> So erfasst du eine Durchführung</b>
    <ol class="hb-steps">
      <li>Eintrag anklicken → <b>Erledigt erfassen</b>.</li>
      <li>Datum, Ergebnis (<b>ohne</b> oder <b>mit Mängeln</b>) und Bemerkung, z. B. Prüfbericht-Nr. → <b>Durchführung speichern</b>.</li>
      <li>Die nächste Fälligkeit ist neu gesetzt; unter <b>Nachweise</b> stehen alle Durchführungen. Den Prüfbericht unter <b>Dokumente</b> ablegen.</li>
    </ol>
    <b>Erinnerung:</b> Die verantwortliche Person – ohne Eintrag alle Admins – bekommt im Chat eine Nachricht von „Service“, sobald der Vorlauf beginnt, und noch einmal, wenn die Fälligkeit überschritten ist. Neu anlegen, Durchführungen und Löschen stehen im Reiter <b>Änderungen</b>.</div>
  <p><b>IT-Assets</b> (PCs, Netzwerk, Steuerungen) haben Hersteller und Lieferant und können einer Anlage zugeordnet werden.</p>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> Wer darf den Anlagenbaum ändern?</b>Anlegen, Bearbeiten und Deaktivieren von Gebäuden, Linien, Anlagen und Geräten braucht die Berechtigung <b>Infrastruktur anlegen, bearbeiten &amp; deaktivieren</b> (Kategorie „Infrastruktur“). Standardmäßig haben sie Administratoren und Manager; weiteren Rollen gibst du sie unter <b>Rollen &amp; Berechtigungen</b>. Ohne sie fehlen die Knöpfe „Hinzufügen“ und „Bearbeiten“ – ansehen, kommentieren und Vorgänge zuordnen geht weiterhin.</div>
  <h3 id="hmi"><i class="ti ti-device-desktop-analytics"></i> HMI-Fernzugriff</h3>
  <p>Über den Reiter <b>HMI</b> einer Anlage siehst du den Bildschirm ihrer Bediengeräte direkt im Browser – ohne eigenes VNC-Programm. Die Verbindung läuft immer über den PDH-Server; das VNC-Passwort bleibt dort und wird nie an den Browser gegeben. Jeder Zugriff wird mit Name, Zeit, Art und Dauer protokolliert („Letzte Zugriffe“).</p>
  <ul>
    <li><b>HMI ansehen</b> – nur zuschauen. Tastatur, Maus und Zwischenablage verwirft der Server, auch wenn der Browser sie schicken würde.</li>
    <li><b>HMI bedienen</b> – mit Tastatur und Maus arbeiten, sofern am HMI „Bedienen erlaubt“ ist. Deine Eingaben wirken direkt auf die Anlage.</li>
    <li><b>HMI-Verbindungen einrichten</b> – HMIs anlegen, ändern, löschen. Bei Rechten auf Abteilungsebene gilt das nur für Anlagen dieser Abteilung.</li>
  </ul>
  <p>Standardmäßig dürfen Administratoren, Manager und Techniker ansehen; bedienen und einrichten nur Administratoren. Weitere Rollen bekommen die Rechte unter <b>Rollen &amp; Berechtigungen</b> (Kategorie „Infrastruktur“).</p>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So richtest du ein HMI ein</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>HMI</b> → <b>HMI hinzufügen</b>.</li>
      <li><b>Name</b>, <b>Adresse</b> (IP oder Rechnername im Anlagennetz), <b>Port</b> (meist 5900) und das <b>VNC-Passwort</b> des Panels eintragen. Der PDH-Server muss das HMI im Netz erreichen können.</li>
      <li><b>Bedienen erlaubt</b> abwählen, wenn an diesem HMI niemand aus der Ferne eingreifen soll – dann ist für alle nur Ansehen möglich.</li>
      <li><b>Ansehen am Terminal</b> und <b>Bedienen am Terminal</b> legen fest, wer das HMI am <a href="#terminal">Anlagenterminal</a> ansehen bzw. bedienen darf (Jeder, Nur mit Karte, Niemand). Bei ausgeschaltetem „Bedienen erlaubt“ gilt am Terminal beim Bedienen immer „Niemand“.</li>
      <li><b>Speichern</b>. Beim Ändern bleibt das Passwort, wenn du das Feld leer lässt.</li>
    </ol>
    Unterstützt werden VNC ohne Anmeldung und mit VNC-Passwort. Verlangt das HMI ein anderes Verfahren (z. B. VeNCrypt/TLS oder Benutzer + Passwort), meldet der Viewer das.</div>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> So greifst du auf ein HMI zu</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → Reiter <b>HMI</b> → <b>Ansehen</b> oder <b>Bedienen</b>. Der Viewer öffnet sich in einem neuen Tab.</li>
      <li>Oben stehen Modus und Verbindungsstatus. <b>Anpassen</b> schaltet zwischen Fenstergröße und Originalgröße um, <b>Vollbild</b> nutzt den ganzen Bildschirm, <b>Strg+Alt+Entf</b> (nur beim Bedienen) sendet die Tastenkombination ans HMI.</li>
      <li>Mit <b>Bedienen</b> bzw. <b>Nur ansehen</b> wechselst du den Modus; die Verbindung wird dafür neu aufgebaut.</li>
      <li>Tab schließen oder Zurück beendet die Verbindung. Auch die automatische Abmeldung bei Inaktivität trennt sie.</li>
    </ol>
    Am HMI bleibt eine laufende Sitzung bestehen – der Zugriff aus PDH verbindet immer „geteilt“.</div>
  <div class="hb-howto"><b><i class="ti ti-building-bank"></i> So suchst du eine Anlage nach Kostenstelle</b>
    <ol class="hb-steps">
      <li>In der Infrastruktur-Auswahl (z. B. beim Anlegen eines Tickets) rechts neben dem Suchfeld <b>Nach Kostenstelle</b> wählen.</li>
      <li>Die Kostenstelle aufklappen. Darunter steht ihre Infrastruktur mit dem gewohnten Baum. Die Zahl neben der Kostenstelle zeigt, wie viele Teile dazugehören.</li>
      <li>Die Anlage anklicken. <b>Nach Standort</b> schaltet zurück auf den Baum Gebäude → Linie → Anlage → Gerät.</li>
    </ol>
    Hat ein Teil keine eigene Kostenstelle, gehört es zur Kostenstelle darüber. Hat ein Teil eine andere Kostenstelle als sein Gebäude, steht es bei seiner eigenen Kostenstelle, mit dem Hinweis, wo es steht („in Halle 1 › Linie A“). Teile ganz ohne Kostenstelle stehen unter <b>Ohne Kostenstelle</b>. Die Suche findet auch Kostenstellen. Der Browser merkt sich die gewählte Ansicht.</div>
  <h3><i class="ti ti-device-desktop-pin"></i> Terminal-Standort: Auswahl öffnet sich am richtigen Ort</h3>
  {{template "hb-fig-terminal"}}
  <p>Steht ein Terminal (Systembenutzer) fest in einer Halle oder an einer Linie, kannst du ihm diesen Standort geben. Wer dort ein Ticket, eine Störung oder eine Wartung anlegt, sieht die Infrastruktur-Auswahl schon bis zu diesem Standort aufgeklappt und hervorgehoben – die genaue Anlage wählt man dann mit einem Klick. Das gilt auch, wenn sich jemand kurz mit dem eigenen Konto am Terminal anmeldet.</p>
  <div class="hb-howto"><b><i class="ti ti-map-pin"></i> So stellst du den Standort eines Terminals ein</b>
    <ol class="hb-steps">
      <li><b>Benutzer</b> → den Systembenutzer des Terminals öffnen → Reiter <b>Stammdaten</b> (Berechtigung <i>Benutzer verwalten</i>).</li>
      <li>Unter <b>Systemnutzer</b> erscheint <b>Standort des Terminals</b>: im Baum Gebäude, Linie oder Anlage antippen.</li>
      <li>Darunter wählst du bei Bedarf einen <b>Leitstand</b>, den das Terminal immer zeigt. „– über Gruppe/Abteilung –“ heißt: der Leitstand seiner Gruppe oder Abteilung, sonst der Standard.</li>
      <li><b>Speichern</b>. Auf der Übersicht steht jetzt „Terminal-Standort“; die Änderung erscheint in der Historie.</li>
    </ol>
    Wird die Anlage später gelöscht, ist der Standort automatisch wieder leer – dann klappt der Baum wie gewohnt ganz auf.</div>
  <h3 id="it-net"><i class="ti ti-network"></i> Netz-Abgleich (IT-Assets aus UniFi, Omada und SNMP)</h3>
  <p>Das PDH liest Geräte aus eurem Netz und legt Switches, Access Points und Gateways selbst als IT-Assets (Kategorie Netzwerk) an. Es gibt drei Quellen: <b>UniFi</b>, <b>Omada</b> (TP-Link) und <b>SNMP v3</b> für Geräte ohne Controller (Switches anderer Hersteller, Drucker, USV, NAS). Du kannst eine, zwei oder alle drei einschalten; jede läuft für sich. Die Seite findest du unter <b>IT-Assets</b> → <b>Netz-Abgleich</b>; neben dem Knopf steht die Zahl offener Vorschläge.</p>
  {{template "hb-fig-itnet"}}
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So schaltest du den Abgleich ein</b>
    <ol class="hb-steps">
      <li><b>IT-Assets</b> → <b>Netz-Abgleich</b> öffnen. Die Seite zeigt den Stand je Quelle (<b>UniFi</b>, <b>Omada</b>, <b>SNMP v3</b>). Ist eine Quelle noch nicht verbunden, folge dem Link zum Reiter <b>UniFi</b>, <b>Omada</b> oder <b>SNMP</b> der Server-Einstellungen und richte sie dort ein (dafür braucht es das Recht <code>system.unifi</code>, <code>system.omada</code> bzw. <code>system.snmp</code>). Bei SNMP heißt „verbunden“: Es gibt mindestens ein Zugangsprofil.</li>
      <li>Im Formular <b>Einstellungen</b> hat jede Quelle einen eigenen Schalter. Die gewünschten Quellen einschalten und speichern.</li>
      <li>Unter <b>Einstellungen</b> das <b>Intervall (Sekunden)</b> (30 bis 3600, Standard 60), die allgemeine <b>Karenz bis zum Alarm (Minuten)</b> (1 bis 1440, Standard 5; sie gilt, wenn weder Kategorie noch Gerät eine eigene Karenz haben), <b>Verantwortlich – Benutzer</b> oder die Gruppe und die <b>Priorität der Alarm-Tickets</b> (Standard hoch) festlegen. Ohne Angabe ist die Gruppe „IT“ verantwortlich, sonst die Bereichsadministratoren IT.</li>
      <li><b>Jetzt abgleichen</b> startet sofort einen Lauf über alle eingeschalteten Quellen; der Knopf ist nur aktiv, solange mindestens eine Quelle eingeschaltet ist, und nicht während einer Wartungssperre. Je Quelle zeigt die Seite letzten Lauf, Fehlertext und die Zahl der Geräte und Clients.</li>
    </ol>
    <b>Netzgeräte</b> entstehen und aktualisieren sich von selbst: IP, MAC, Modell, Firmware (mit Marke „Update“), Zustand online/offline/unbekannt, Uplink und Ports (alle 15 Minuten). Name (nur beim Anlegen), Standort, Notizen, Verantwortliche und Status überschreibt der Abgleich nie. UniFi liefert keine Seriennummer.</div>
  <div class="hb-howto"><b><i class="ti ti-access-point"></i> Omada als zweite Quelle</b>
    <ul>
      <li>Die Verbindung richtest du in den <b>Server-Einstellungen</b> im Reiter <b>Omada</b> ein (<a href="#hb-omada">So bindest du einen Omada-Controller an</a>). Danach auf der Seite <b>Netz-Abgleich</b> den Schalter für Omada einschalten.</li>
      <li>Switches, Access Points und Gateways aus Omada werden IT-Assets mit dem Hersteller <b>TP-Link</b>. Verbundene Geräte (Clients) erscheinen nur als Vorschläge – wie bei UniFi.</li>
      <li>Die Liste der <b>Vorschläge</b> gilt für UniFi und Omada; die Spalte <b>Quelle</b> zeigt, woher ein Vorschlag stammt. Sehen beide Quellen denselben Client (gleiche MAC-Adresse), steht er nur einmal in der Liste.</li>
      <li>Schaltest du eine Quelle aus, verschwinden ihre Vorschläge aus der Liste. Sie bleiben gespeichert und sind wieder da, wenn du die Quelle einschaltest.</li>
      <li>Bei Omada-Geräten gibt es <b>keine Anschluss-Tabelle</b> (Ports) und <b>keinen Hinweis „Update verfügbar“</b>.</li>
      <li>Meldet Omada einen Zustand, den das PDH nicht kennt, gilt das Gerät als „unbekannt“. Ein unbekannter Zustand löst <b>nie</b> ein Ausfall-Ticket aus.</li>
      <li>Kennt das PDH ein Gerät schon aus einer anderen Quelle (gleiche MAC-Adresse, z. B. ein Omada-Access-Point an einem UniFi-Switch), erscheint es nicht noch einmal als Vorschlag – es entsteht kein zweites Asset.</li>
      <li>Das PDH liest nur. Am Omada-Controller ändert es nichts.</li>
    </ul>
    <b>Wichtig:</b> Die Omada-Anbindung ist nach der Dokumentation des Herstellers gebaut und noch nicht an einem echten Controller erprobt. Prüfe nach dem ersten Abgleich, ob Geräte, Zustände und Vorschläge stimmen.</div>
  <div class="hb-howto" id="it-net-snmp"><b><i class="ti ti-list-details"></i> So bindest du ein Gerät per SNMP v3 an</b>
    Für Geräte, die an keinem Controller hängen. Das PDH fragt jedes Gerät einzeln: Bist du da, wie heißt du, welche Firmware, welche Anschlüsse. Es liest nur – am Gerät ändert es nichts.
    <ol class="hb-steps">
      <li>Am Gerät <b>SNMP v3</b> einschalten und einen Benutzer zum Lesen anlegen – mit Anmeldung <b>und</b> Verschlüsselung (oft „authPriv“ genannt) und zwei Kennwörtern. Hat das Gerät eine Liste erlaubter Abfrager, trage dort den PDH-Server ein – im Verbund <b>beide Server</b>.</li>
      <li><b>Server-Einstellungen → Reiter SNMP</b>: ein <b>Zugangsprofil</b> mit genau diesen Angaben anlegen (<a href="#hb-snmp">So legst du ein SNMP-Zugangsprofil an</a>). Ein Profil gilt für viele Geräte.</li>
      <li><b>IT-Assets → Netz-Abgleich</b> → Karte <b>SNMP-Geräte</b>: <b>Adresse</b> (IP oder Name im Haus), <b>Port</b> (üblich 161) und <b>Zugangsprofil</b> eintragen, dann <b>Gerät hinzufügen</b>.</li>
      <li>In der Zeile <b>Prüfen</b> drücken. Kontrolle: Unter dem Gerät steht „Das Gerät antwortet“ mit Name, Modell, Firmware, Seriennummer, MAC und Zahl der Anschlüsse. Bei einem Fehler steht dort der Grund, z. B. „Keine Antwort“ oder „Zugang abgelehnt – Profil prüfen“. Prüfen speichert nichts.</li>
      <li>Im Formular <b>Einstellungen</b> den Schalter <b>Abgleich mit SNMP einschalten</b> setzen und speichern. Beim nächsten Lauf wird das Gerät ein IT-Asset (Kategorie Netzwerk, am Asset änderbar) und steht mit Link in der Liste.</li>
    </ol>
    <ul>
      <li><b>Zeile bedienen:</b> <b>Ausschalten</b> fragt das Gerät nicht mehr; sein Asset bleibt und steht auf „unbekannt“. <b>Bearbeiten</b> ändert Adresse, Port oder Profil – das Asset bleibt dasselbe. <b>Entfernen</b> nimmt das Gerät aus der Liste; das IT-Asset bleibt bestehen und wird nicht mehr abgeglichen. Entfernen darf nur der Bereichsadministrator IT (<code>it.admin</code>); hat das Gerät schon ein IT-Asset, muss er das Recht für dessen Abteilung haben – sonst fehlt der Knopf.</li>
      <li><b>Was das PDH liest:</b> bei jedem Lauf, ob das Gerät antwortet; alle 15 Minuten Modell, Firmware, MAC und die Anschlüsse (Name, aktiv/getrennt, Geschwindigkeit). Den Namen übernimmt es nur beim Anlegen, die Seriennummer nur, wenn das Feld noch leer ist. Fehlt dem Gerät eine Angabe, bleibt das Feld leer.</li>
      <li><b>Zustände:</b> Antwortet das Gerät, ist es <b>online</b>. <b>Offline</b> wird ein Gerät erst, wenn es dem gerade fragenden Server schon einmal geantwortet hat und dann keine Antwort mehr kommt (auch wenn es die Anfrage abweist, weil sein SNMP-Dienst aus ist) – nach der Karenz entsteht ein Ausfall-Ticket wie bei den anderen Quellen. Hat es diesem Server noch nie geantwortet, bleibt es <b>unbekannt</b> mit dem Hinweis „Hat diesem Server noch nie geantwortet – Adresse, Profil und Freischaltung für diesen Server prüfen“. Unbekannt ist es auch, wenn es den Zugang ablehnt (falsches Kennwort, falscher Benutzer), sich sein Name nicht auflösen lässt oder der PDH-Server selbst gerade nicht senden kann. Aus „unbekannt“ entsteht <b>nie</b> ein Ticket; der Grund steht in der Spalte „Letzter Fehler / Hinweis“.</li>
      <li><b>Nach Neustart, Update oder Pause:</b> Das PDH merkt sich nicht über einen Neustart hinweg, welche Geräte geantwortet haben. Nach einem Neustart, einem Update, einer Wartungssperre oder einer Pause von mehr als 3 Intervallen (mindestens 5 Minuten) muss jedes Gerät erst wieder einmal antworten, bevor es „offline“ werden kann. Ein Ausfall-Ticket, das schon offen ist, bleibt dabei offen und endet erst, wenn das Gerät wieder antwortet.</li>
      <li><b>Schutz vor falschem Alarm:</b> Antwortet in einem Lauf <b>keines</b> von mindestens 3 eingeschalteten Geräten, liegt es am PDH-Server (Netz weg oder nicht freigeschaltet). Dann stehen alle auf „unbekannt“, es entsteht kein Ticket, und an der Quelle steht „Kein Gerät antwortet – Netz des PDH-Servers oder Freischaltung prüfen“. Bei 1 oder 2 Geräten gibt es diesen Schutz nicht; dort schützt die Karenz. Steht dort „Kein Gerät konnte gefragt werden – Zugangsprofile und Adressen prüfen“, ging gar keine Anfrage hinaus: Die Kennwörter der Profile sind nicht lesbar oder die Namen lassen sich nicht auflösen.</li>
      <li><b>Meldung bei Totalausfall:</b> Antwortet länger als die allgemeine Karenz kein Gerät, bekommen die Verantwortlichen des Netz-Abgleichs <b>eine</b> Nachricht: „SNMP: Seit … antwortet kein Gerät. Entweder ist das Netz des PDH-Servers gestört oder alle SNMP-Geräte sind ausgefallen.“ Es entsteht kein Ticket je Gerät. Die nächste Nachricht kommt erst, nachdem zwischendurch wieder ein Gerät geantwortet hat.</li>
      <li><b>Verbund (zwei Server):</b> Gefragt wird vom gerade aktiven Server und von dessen <b>eigener</b> Adresse, nicht von der gemeinsamen. Geräte mit einer Liste erlaubter Abfrager müssen deshalb beide Server eintragen. Fehlt der zweite Server bei einem Gerät, ist es nach einer Umschaltung „unbekannt“ statt online – es entsteht kein Ticket, aber ein Ausfall dieses Geräts fällt dann auch nicht auf, bis du den Server am Gerät freischaltest.</li>
      <li><b>Viele Geräte:</b> Schafft das PDH in einem Lauf nicht alle Geräte (viele antworten nicht), behalten die nicht gefragten ihren bisherigen Zustand mit dem Hinweis „In diesem Lauf nicht gefragt“. Der nächste Lauf beginnt bei ihnen.</li>
      <li><b>Doppelte:</b> Kennt das PDH ein Gerät schon aus UniFi oder Omada (gleiche MAC-Adresse), entsteht kein zweites Asset; in der Liste steht der Hinweis „schon über UniFi bekannt“. Steht dasselbe Gerät zweimal in der Liste (z. B. mit Name und mit IP-Adresse), wird nur ein Eintrag ein Asset; am anderen steht „doppelt in der Liste“. Ein von Hand angelegtes Asset mit gleicher MAC-Adresse wird verknüpft.</li>
      <li><b>Getrenntes Asset:</b> Hast du am Asset <b>Quelle trennen</b> gewählt oder das Gerät entfernt und neu aufgenommen, entsteht kein neues Asset. In der Liste steht dann „Das IT-Asset ist vom Abgleich getrennt – am Asset ‚Wieder verbinden‘ wählen“ mit einem Link zum Asset. Nach <b>Wieder verbinden</b> gleicht das PDH es beim nächsten Lauf wieder ab.</li>
      <li><b>Was SNMP nicht kann:</b> keine <b>Vorschläge</b> (SNMP kennt keine Clients), kein <b>Uplink</b>, kein Hinweis <b>„Update verfügbar“</b>, kein PoE, kein Suchlauf durchs Netz. Das PDH spricht <b>kein SNMP v1/v2c</b> (unverschlüsselt) und bietet <b>kein MD5 und kein DES</b> an. SHA-1 ist wählbar, gilt aber als veraltet.</li>
      <li>Grenzen: höchstens 200 Geräte und nur Adressen im eigenen Netz.</li>
    </ul>
    <b>Wichtig:</b> SNMP v3 ist im Labor geprüft und <b>noch nicht an echten Switches und Druckern erprobt</b>. Prüfe nach dem ersten Abgleich, ob Name, Modell, Zustand und Anschlüsse stimmen.</div>
  <div class="hb-howto"><b><i class="ti ti-device-desktop-plus"></i> So übernimmst du einen Vorschlag</b>
    <ol class="hb-steps">
      <li>Auf der Seite <b>Netz-Abgleich</b> die Liste der <b>Vorschläge</b> öffnen. Clients (PCs, Drucker, Telefone …) werden nie von allein angelegt. Vorschläge kommen aus UniFi und Omada; SNMP liefert keine.</li>
      <li><b>Übernehmen</b> wählen und die <b>Kategorie</b> angeben (angeboten werden alle aktiven Kategorien außer Netzwerk). Ob das Gerät überwacht startet, steht in der Kategorie unter <b>Überwachen</b> (siehe <a href="#it-categories">IT-Kategorien</a>). Ab Werk starten Workstation, Telefon und Tablet unüberwacht, alle anderen werden überwacht.</li>
      <li>Oder <b>Ausblenden</b>: Der Client verschwindet aus der Liste und steht im Reiter <b>Ausgeblendet</b>, von wo du ihn zurückholen kannst. Das gilt für den Client, auch wenn ihn beide Quellen sehen. Vorschläge, die 30 Tage nicht mehr gesehen wurden, fallen von selbst weg.</li>
    </ol>
    Dafür brauchst du das Recht „Netz-Abgleich einrichten und Vorschläge übernehmen“ (<code>it.netsync</code>); es haben automatisch alle Rollen, die IT-Assets bearbeiten dürfen.</div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So löst du ein Ausfall-Ticket</b>
    <ol class="hb-steps">
      <li>Ist ein überwachtes, aktives Gerät länger als seine Karenz offline, entsteht das Ticket <b>Netzgerät offline: &lt;Name&gt;</b>; es nennt die wirksame Karenz („Karenz: N min“). Die Karenz kommt zuerst vom Gerät, sonst von der Kategorie, sonst aus den Einstellungen des Netz-Abgleichs.</li>
      <li>Kommt das Gerät zurück, steht am Ticket der Kommentar „Wieder erreichbar seit …“. Das Ticket bleibt offen, bis du es löst.</li>
      <li>Zum Abschließen <b>Bearbeiten &amp; abschließen</b> wählen und im <a href="#completion">Abschluss-Assistenten</a> das Feld <b>Ursache (Pflicht bei Alarm-Tickets)</b> ausfüllen. Ohne Ursache lässt sich das Ticket nicht lösen.</li>
    </ol>
    Fällt dasselbe Gerät bei offenem Ticket erneut aus, kommt ein Eintrag auf dasselbe Ticket. Kein Alarm entsteht, wenn die Quelle selbst nicht erreichbar ist (Zustand „unbekannt“), während eines Firmware-Updates und nicht für Ports oder Firmware.</div>
  <p>In der Liste <b>IT-Assets</b> zeigen Marken den Zustand (grün online, rot offline, grau unbekannt, „Quelle getrennt“); der Filter <b>Nur offline</b> lässt sich mit den Kategorie-Filtern verbinden. Auf dem Gerät zeigt die Karte <b>Netz</b> Zustand seit, zuletzt gesehen, Firmware, Uplink, die <b>Karenz bis zum Alarm</b> und die Port-Tabelle. Bei SNMP-Geräten steht in der Spalte <b>Anschluss</b> der Name des Anschlusses (z. B. Gi0/1); die Spalte PoE erscheint nur, wenn das Gerät PoE meldet. Mit dem Knopf <b>Nicht mehr überwachen</b> (Recht „IT-Assets bearbeiten“) schaltest du den Alarm für ein einzelnes Gerät ab, mit <b>Überwachen</b> wieder ein. <b>Quelle trennen</b> lässt das Asset bestehen, gleicht es aber nicht mehr ab; <b>Wieder verbinden</b> macht das rückgängig; ob das Gerät danach überwacht wird, bestimmt wieder die Kategorie.</p>
  <h3 id="it-categories"><i class="ti ti-category"></i> IT-Kategorien</h3>
  <p>Jedes IT-Asset gehört zu einer Kategorie, z. B. Server, Netzwerk, Workstation, Drucker, Telefon, Tablet oder Sonstiges. Die Kategorien pflegst du unter <b>IT-Assets</b> → <b>Kategorien</b>. Die Seite sieht, wer „IT-Infrastruktur ansehen“ darf; ändern darf nur, wer „IT-Kategorien pflegen“ hat (<code>it.categories</code>).</p>
  {{template "hb-fig-itcat"}}
  <div class="hb-howto"><b><i class="ti ti-category-plus"></i> So legst du eine Kategorie an</b>
    <ol class="hb-steps">
      <li><b>IT-Assets</b> → <b>Kategorien</b> → <b>Neue Kategorie</b>.</li>
      <li><b>Name</b> eintragen, z. B. „Kamera“. Mit <b>Reihenfolge</b> bestimmst du die Stelle in Listen und Filtern (kleine Zahl = weiter vorn).</li>
      <li>Bei <b>Symbol</b> den Namen aus der Symbolbibliothek eintragen, z. B. <code>ti-camera</code>; die Vorschau daneben zeigt es sofort. Leer = Standardsymbol.</li>
      <li>Das Häkchen <b>Neu übernommene Geräte überwachen</b> ist vorgesetzt, dann löst ein Ausfall ein Ticket aus. Nimm es heraus, wenn das für diese Kategorie nicht gelten soll.</li>
      <li><b>Anlegen</b>. Die Kategorie steht ab sofort in den Formularen der IT-Assets und beim <b>Übernehmen</b> im Netz-Abgleich zur Wahl.</li>
    </ol>
    Eine Kategorie bearbeitest du mit dem Stift, mit <b>Ausblenden</b> nimmst du sie aus der Auswahl für neue Assets, mit <b>Einblenden</b> holst du sie zurück. Assets, die sie schon nutzen, behalten sie und zeigen sie weiter an. <b>Löschen</b> geht nur bei Kategorien ohne Assets und nur für den Bereichsadministrator IT („IT: Bereichsadministrator“, <code>it.admin</code>). <b>Netzwerk</b> und <b>Sonstiges</b> sind fest und lassen sich weder ausblenden noch löschen.</div>
  <div class="hb-howto"><b><i class="ti ti-clock-pause"></i> So stellst du die Karenz für eine Kategorie ein</b>
    <ol class="hb-steps">
      <li><b>IT-Assets</b> → <b>Kategorien</b>, bei der Kategorie den Stift wählen.</li>
      <li>Bei <b>Karenz (Minuten)</b> die Minuten eintragen (1 bis 1440), die ein überwachtes Gerät offline sein darf, bevor das Ausfall-Ticket entsteht. Leer = allgemeiner Wert aus dem Netz-Abgleich; die Liste zeigt ihn dann als „allgemein“.</li>
      <li><b>Speichern</b>. Die Spalte <b>Karenz</b> zeigt den neuen Wert.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-clock-check"></i> So stellst du die Karenz für ein einzelnes Gerät ein</b>
    <ol class="hb-steps">
      <li>Das IT-Asset öffnen und zur Karte <b>Netz</b> gehen. Dort steht „Karenz bis zum Alarm: N min“ mit der Herkunft: eigener Wert, Kategorie oder allgemein.</li>
      <li>Bei <b>Eigene Karenz (Minuten)</b> die Minuten eintragen und <b>Speichern</b>. Leer speichern entfernt den eigenen Wert; dann gilt wieder der Wert der Kategorie bzw. der allgemeine Wert.</li>
    </ol>
    Dafür brauchst du das Recht „IT-Infrastruktur bearbeiten“ für dieses Asset. Es gilt immer die Reihenfolge: eigener Wert am Gerät, dann Kategorie, dann der allgemeine Wert.</div>
  <p>In der <b>Anlagen-Historie</b>, bei den <b>Prüfnachweisen</b> und bei den <b>HMI-Zugriffen</b> einer Anlage gibt es die Sortier-Leiste (<a href="#sort">mehr</a>). „Häufigste zuerst“ zählt dieselbe Maßnahme auch über verschiedene Störungen der Anlage hinweg; berücksichtigt werden höchstens die neuesten 2000 Einträge. Die Historie einer Anlage sieht, wer die Anlage sehen darf.</p>
  <div class="hb-howto"><b><i class="ti ti-cpu"></i> Reiter „ESPPDH“ an der Anlage</b>
    <ol class="hb-steps">
      <li>Hängt an der Anlage ein ESPPDH-Gerät, gibt es den Reiter <b>ESPPDH</b> – mit dem Recht „ESPPDH: Sensorwerte ansehen“ oder „ESPPDH: Geräte und Zustand ansehen“.</li>
      <li>Je Gerät: online/offline, Handshake, die letzten Werte nach Gruppen mit Einheit und Alter. Graue Werte sind veraltet. Der Reiter lädt alle 10 Sekunden neu.</li>
      <li>Der Name führt zur Geräteseite (nur mit „ESPPDH: Geräte und Zustand ansehen“), <b>Webseite des Geräts</b> direkt aufs Gerät (nur im Netz der Geräte).</li>
    </ol></div>
  {{template "hb-shots" (dict "Ref" (index $s "infrastructure") "Can" $can)}}
</section>

<section class="hb-ch" id="firma" data-title="Firmenstammdaten" data-pages="infrastructure">
  <h2><i class="ti ti-building"></i> Firmenstammdaten</h2>
  <p>Das PDH kennt eure Firma einmal: Name, Anschrift, Kontakt, Pflichtangaben und Bank. Die Angaben gelten für das ganze Unternehmen und stehen im Reiter <b>Firma</b> an jedem <b>obersten Knoten</b> der Infrastruktur – überall dieselben. Werke hängt ihr unter den obersten Knoten.</p>
  <div class="hb-howto"><b><i class="ti ti-building"></i> So geht's: Firmenstammdaten pflegen</b>
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> öffnen und einen obersten Knoten anklicken (z. B. das Werk oder die Firma).</li>
      <li>Reiter <b>Firma</b> wählen. Name mit Rechtsform, Anschrift und Kontakt eintragen.</li>
      <li>Unter <b>Pflichtangaben</b> Sitz, Registergericht und -nummer, Geschäftsführung und USt-IdNr. eintragen – sie gehören in geschäftliche Mails und Briefe.</li>
      <li><b>Speichern</b>. Rechts zeigt die Vorschau Briefkopf und Mail-Fußzeile.</li>
    </ol>
  </div>
  <h3>Wo die Angaben erscheinen</h3>
  <ul>
    <li><b>Mails des PDH</b> – Absender ist der Firmenname (außer in den Server-Einstellungen ist beim Absender schon ein eigener Name eingetragen; beim Versand über Microsoft 365 bestimmt das Postfach den Namen). Darunter steht eine Fußzeile mit Ansprechpartner, Anschrift und Pflichtangaben.</li>
    <li><b>Ansprechpartner</b> ist, wer die Mail oder den Ausdruck auslöst – mit Name, Funktion, Telefon und E-Mail aus dem Benutzerstamm. Fehlt das Telefon, steht die Firmennummer mit der Durchwahl dahinter. Automatische Mails (Statusmeldungen, Bestellvorschlag, Kennwort vergessen) nennen den allgemeinen Firmenkontakt.</li>
    <li><b>Druckkopf</b> jeder Seite und <b>Wartungsprotokoll</b> – Firmenname und Anschrift; das Protokoll nennt im Fuß Pflichtangaben und Ansprechpartner.</li>
    <li><b>M365-Signaturen</b> – {Firma} kommt beim Übertragen der Werte nach Microsoft 365 aus den Stammdaten. {Firmenanschrift}, {Firmentelefon} und {Website} stehen als fester Text in der Signatur-Regel: nach einer Änderung die Regel neu übertragen.</li>
  </ul>
  <div class="hb-note"><i class="ti ti-lock"></i> Bearbeiten darf, wer das Recht <b>Firmenstammdaten bearbeiten</b> hat – und zwar für das ganze Unternehmen, nicht nur für eine Abteilung. Ansehen darf jeder, der die Infrastruktur sieht. Ohne eingetragenen Firmennamen sehen Mails und Ausdrucke aus wie bisher.</div>
  {{template "hb-shots" (dict "Ref" (index $s "firma") "Can" $can)}}
</section>

<section class="hb-ch" id="kiosk" data-title="Kiosk-Terminals" data-pages="kiosk-terminals">
  <h2><i class="ti ti-device-desktop-share"></i> Kiosk-Terminals</h2>
  <p>Ein <b>Kiosk-Terminal</b> (hmi-kiosk) ist der kleine Rechner mit Bildschirm am Bedienplatz einer Anlage. Ist der Anlage ein Terminal zugeordnet, holst du ein HMI aus PDH direkt auf diesen Bildschirm: Reiter <b>HMI</b> → <b>Am Terminal zeigen</b>. Die Browser-Ansicht (<b>Ansehen</b>/<b>Bedienen</b>) bleibt daneben bestehen.</p>
  <ul>
    <li><b>Am Terminal zeigen</b> – das Terminal öffnet das HMI nur zum Ansehen.</li>
    <li><b>Am Terminal bedienen</b> – mit Tastatur und Maus am Terminal. Nur wenn am HMI „Bedienen erlaubt“ ist und du <b>HMI bedienen</b> darfst. Ist die Kachel am Terminal selbst auf „nur ansehen“ eingestellt, bleibt es dort beim Ansehen.</li>
  </ul>
  <p>Das VNC-Passwort schickt der PDH-Server direkt an das Terminal; es erscheint nie im Browser und wird nirgends protokolliert. Am Terminal steht in der Leiste „Anlage / HMI – von PDH: dein Name“. Jeder Befehl steht unter <b>Letzte Zugriffe</b> mit „am Terminal …“ und gegebenenfalls dem Grund, warum es nicht geklappt hat.</p>
  <div class="hb-howto"><b><i class="ti ti-message-circle"></i> Was die Meldungen bedeuten</b>
    <ul>
      <li><b>geöffnet</b> – das HMI startet am Terminal (dauert ein paar Sekunden).</li>
      <li><b>belegt</b> – am Terminal läuft schon eine Sitzung, auch eine Daueranzeige. PDH nennt das HMI und – falls bekannt – seit wann; hält ein anderes Terminal das HMI, steht dessen Name dabei. Erst dort beenden, dann noch einmal.</li>
      <li><b>Angaben abgelehnt</b> – das Terminal prüft die VNC-Anmeldung am HMI vorab. Meist ist das VNC-Passwort des HMI falsch; PDH zeigt den Grund vom Terminal.</li>
      <li><b>zu viele Fehlversuche</b> – nach mehreren falschen Schlüsseln sperrt das Terminal PDH eine Weile. Später erneut versuchen und den Schlüssel prüfen.</li>
      <li><b>läuft gerade ein Befehl</b> – an dasselbe Terminal geht immer nur ein Befehl gleichzeitig. Kurz warten.</li>
      <li><b>nicht bereit</b> – PDH zeigt den Grund, den das Terminal nennt: Wartung, laufende Sicherung, eine Sitzung startet gerade oder das HMI ist vom Terminal aus nicht erreichbar. Kurz warten bzw. die Ursache beheben.</li>
      <li><b>Schlüssel abgelehnt</b> oder <b>Fingerabdruck stimmt nicht</b> – die Verbindung muss unter <b>Kiosk-Terminals</b> neu eingetragen werden.</li>
      <li><b>nicht erreichbar</b> – Terminal aus, Netzwerk unterbrochen oder falsche Adresse.</li>
    </ul></div>
  <p>Die Software für das Terminal (Raspberry-Pi-Abbild, Windows-Setup als EXE/MSI und Updates) holst du über den Link <b>Terminal-Software herunterladen</b> – er steht auf der Seite „Kiosk-Terminals“ und beim Systembenutzer unter „Gekoppelte Geräte“.</p>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So verbindest du ein Terminal mit PDH</b>
    <ol class="hb-steps">
      <li>Am Terminal die Admin-Seite öffnen (<code>https://&lt;Terminal&gt;:8443</code>) → <b>Netzwerk → Fernsteuerung (PDH)</b> → <b>Schlüssel erzeugen</b>. Den Schlüssel (beginnt mit <code>hmik_</code>) kopieren – er wird nur einmal angezeigt. Daneben steht der <b>Fingerabdruck</b>.</li>
      <li>In PDH <b>Core-Einstellungen → Kiosk-Terminals</b> (oder Navigation → Kiosk-Terminals) → <b>Terminal hinzufügen</b>: Name, Adresse (<code>https://10.1.2.3:8443</code>), Schlüssel und Fingerabdruck (mit oder ohne Doppelpunkte) eintragen, <b>Speichern</b>.</li>
      <li><b>Verbindung prüfen</b> zeigt Name und Version des Terminals und ob es gerade belegt ist.</li>
      <li>Die Anlage öffnen → Reiter <b>Stammdaten</b> → <b>Kiosk-Terminal</b> wählen → <b>Speichern</b>. Jede Anlage hat höchstens ein Terminal; ein Terminal darf mehreren Anlagen dienen.</li>
    </ol>
    Der Schlüssel wird verschlüsselt gespeichert und nie wieder angezeigt („gesetzt“). Beim Ändern bleibt er, wenn du das Feld leer lässt – aber nur, solange Adresse und Fingerabdruck gleich bleiben. Änderst du eines davon, verwirft PDH den bisherigen Schlüssel und verlangt einen neuen; so kann niemand den Schlüssel (und damit die VNC-Passwörter) auf ein anderes Gerät umlenken. Das Ergebnis von „Verbindung prüfen“ steht direkt beim Terminal. Erzeugst du am Terminal einen neuen Schlüssel, gilt der alte nicht mehr – dann hier neu eintragen. PDH vertraut nur dem Terminal mit genau diesem Fingerabdruck; ein fremdes Gerät unter derselben Adresse bekommt weder Schlüssel noch Passwort. Inaktive Terminals sind in den Anlagen nicht wählbar und nehmen keine Befehle an.</div>
  <div class="hb-howto"><b><i class="ti ti-device-desktop"></i> PDH auf dem Terminal (PDH-Terminalmodus)</b>
    <ol class="hb-steps">
      <li>Für das Terminal einen <b>Systembenutzer</b> in PDH anlegen (<b>Benutzer</b>, Haken „Systemnutzer“) – am besten mit dem Standort der Anlage (siehe <a href="#infrastructure">Terminal-Standort</a>).</li>
      <li>Am Terminal auf der Admin-Seite eine <b>Web-Kachel</b> mit der PDH-Adresse anlegen.</li>
      <li>Die Kachel einmal öffnen und als dieser Systembenutzer anmelden. Die Anmeldung bleibt im Profil des Terminals.</li>
      <li>Wer am Terminal etwas erledigen will, meldet sich über <b>Anmelden zur Erledigung</b> (Karte oder eigenes Konto) kurz an; danach kehrt PDH zum Systembenutzer zurück.</li>
    </ol>
    Nach einer Wartung von PDH sind auch Systembenutzer abgemeldet – dann die Kachel öffnen und den Systembenutzer neu anmelden. Das gilt für die Web-Kachel mit Benutzer-Anmeldung, nicht für gekoppelte PDH-Terminals: Sie bleiben angemeldet (siehe <a href="#terminal">Anlagenterminal</a>).</div>
  <p>Rechte: <b>HMI am Kiosk-Terminal der Anlage zeigen</b> (<code>hmi.kiosk</code>) haben standardmäßig Administratoren, Manager, Techniker und Anlagenverantwortliche. Gilt ein Recht nur für eine Abteilung, gilt es auch hier nur für deren Anlagen. Anlagen ein Terminal zuordnen dürfen Personen mit <b>HMI-Verbindungen einrichten</b> (<code>hmi.manage</code>) für diese Anlage. Terminals selbst einrichten, ändern, prüfen und löschen dürfen nur Personen, die <code>hmi.manage</code> <b>ohne Abteilungsbegrenzung</b> haben (standardmäßig Administratoren) – ein Terminal kann Anlagen mehrerer Abteilungen dienen.</p>
  {{template "hb-shots" (dict "Ref" (index $s "kiosk") "Can" $can)}}
</section>

<section class="hb-ch" id="terminal" data-title="Anlagenterminal" data-pages="">
  <h2><i class="ti ti-device-tablet"></i> Anlagenterminal</h2>
  <p>Das <b>Anlagenterminal</b> ist ein Bildschirm an der Anlage (Wandterminal), an dem jede Person ohne Anmeldung sieht, was an dieser Anlage und ihren Unteranlagen gerade los ist, und etwas melden kann. Es ist für den Einsatz mit Touch gedacht: große Flächen, wenig Text, kein PDH-Menü.</p>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So richtest du ein Terminal ein</b>
    <ol class="hb-steps">
      <li>Einen <b>Systembenutzer</b> für das Terminal anlegen (<b>Benutzer</b>, Haken „Systemnutzer“) und in seinen Stammdaten den <b>Terminal-Standort</b> wählen – das ist die Anlage, für die das Terminal gilt. Das Terminal zeigt diese Anlage und alle ihre Unteranlagen, sonst nichts.</li>
      <li>Auf der Seite dieses Benutzers in der Karte <b>Gekoppelte Geräte</b> auf <b>Gerät koppeln</b> klicken. PDH zeigt einen Code im Format <code>XXXX-XXXX</code>. Er ist <b>10 Minuten</b> gültig und nur einmal verwendbar; ein neuer Code ersetzt den noch offenen.</li>
      <li>Am PDH-Terminal (Raspberry Pi) die Admin-Seite öffnen: die obere rechte Ecke des Bildschirms 5 Sekunden lang drücken, dann das Admin-Passwort eingeben. Auf der Seite <b>PDH</b> die PDH-Adresse und den Code eintragen und auf <b>Koppeln</b> klicken.</li>
      <li>Das Terminal meldet sich ab jetzt bei jedem Start selbst bei <code>/terminal</code> an. Dafür musst du dort nichts mehr anmelden.</li>
    </ol>
    Den Code nur an der Admin-Seite des PDH-Terminals eingeben. Die Seite ist nur für Systembenutzer gedacht – andere Benutzer sehen den Hinweis, dass die Seite für Terminal-Benutzer bestimmt ist. Ist dem Benutzer keine Anlage zugeordnet oder die Anlage ausgeblendet, steht auf dem Terminal „Diesem Terminal ist keine Anlage zugeordnet“.</div>
  <p>Am gekoppelten PDH-Terminal gibt es oben rechts ein kleines <b>Zahnrad</b>. Es öffnet die Einstellungen des Terminals (die lokale Admin-Seite) und erscheint in allen Ansichten, auch im Schoner und in der Folienschau. Im Browser an einem normalen PC fehlt es.</p>
  <h3>Rüsten am Terminal</h3>
  <p>Hat die Anlage des Terminals <b>Rüsttasten</b> (an der Anlage selbst oder an einer Halle oder Linie darüber zugeordnet, siehe <a href="#ruestzeiten">Rüstzeiten</a>), steht auf der Seite <b>Neu</b> unterhalb von <b>Störung</b> und <b>Ticket</b> die Kachel <b>Rüsten</b>. Sie öffnet eine eigene Terminalseite: Rüsttaste <b>einmal antippen</b> startet das Rüsten, <b>Fertig</b> beendet es, unter <b>Rüstzeit nachtragen</b> wählst du Rüsttaste, <b>Beginn</b> (vor 15 Minuten bis vor 8 Stunden) und <b>Dauer</b> per Antippen. Die Seite füllt den Bildschirm (Querformat, Hochformat) und läuft unabhängig vom Easy-Modus. Es rüstet immer die am Terminal <b>angemeldete Person</b> (Karte oder manuelle Anmeldung); ohne Anmeldung zeigt die Kachel „Bitte zuerst anmelden“. Das Recht „Rüstzeiten: erfassen …“ (<code>setup.edit</code>) für die Abteilung der Anlage braucht der <b>Terminal-Benutzer</b> (Rolle Terminal), die angemeldete Person ist nur die, die rüstet; fehlt es dem Terminal-Benutzer, steht dort „Keine Berechtigung zum Rüsten“. Auch die Meldeseite des Easy-Modus passt sich jetzt der Bildschirmgröße an.</p>
  <h3>Störung und Ticket am Terminal</h3>
  <p>Die Kacheln <b>Störung</b> und <b>Ticket</b> auf der Seite <b>Neu</b> öffnen eigene Terminalseiten und brauchen keinen Easy-Modus. Zuerst am Terminal <b>anmelden</b> (Karte oder Benutzer und Passwort) – gemeldet wird immer im Namen dieser Person. Dann Meldetext antippen (die Meldetexte der Anlage, siehe Easy-Modus) oder selbst schreiben, <b>Art</b> und <b>Zustand der Anlage</b> wählen (bei „Anlage steht“ löst PDH den Alarm wie sonst aus), bei Bedarf eine Unteranlage und ein Foto, dann <b>Melden</b>. Der Terminal-Benutzer braucht dafür <code>faults.edit</code> bzw. <code>tickets.edit</code> für die Abteilung der Anlage (die Rolle Terminal bringt beides mit).</p>
  <h3>Rolle „Terminal“ und Halle begrenzen</h3>
  <p>Für den Systembenutzer eines Terminals gibt es die fertige Rolle <b>Terminal</b> (Schlüssel <code>terminal</code>). Sie darf <b>Tickets, Störungen und Rüstzeiten ansehen und melden</b> (<code>tickets.view</code>, <code>tickets.edit</code>, <code>faults.view</code>, <code>faults.edit</code>, <code>setup.view</code>, <code>setup.edit</code>) und sonst nichts: kein Löschen, kein Administrieren. Ein eigenes Recht „anlegen“ gibt es nicht, Anlegen hängt am Bearbeiten-Recht. Ohne Begrenzung gilt die Rolle für <b>alle</b> Abteilungen.</p>
  <div class="hb-howto"><b><i class="ti ti-building-factory"></i> So begrenzt du das Terminal auf eine Halle</b>
    <p>PDH begrenzt Rechte nach <b>Abteilung</b> (mit Unterabteilungen); die Abteilung einer Anlage kommt von der Anlage oder vom nächsten Elternknoten. Die Halle muss also als Abteilung angelegt und an ihren Anlagen eingetragen sein.</p>
    <ol class="hb-steps">
      <li>Den Systembenutzer des Terminals öffnen, Rolle <b>Terminal</b> wählen und speichern.</li>
      <li><b>Administration → Rollen &amp; Berechtigungen</b> öffnen. In der Berechtigungs-Matrix die Spalte <b>Terminal</b> suchen.</li>
      <li>Bei jedem der sechs Rechte (Tickets, Störungen und Rüstzeiten: ansehen und bearbeiten) unter dem Häkchen auf das kleine Gebäudesymbol tippen, die Abteilung (z. B. <b>Halle 1</b>) wählen und <b>Übernehmen</b>. Der Knopf zeigt dann den Abteilungsnamen.</li>
    </ol>
    Die Begrenzung an der Rolle gilt für alle Terminal-Benutzer mit dieser Rolle. Brauchen zwei Hallen unterschiedliche Terminals, gib dem Terminal-Benutzer die Rechte stattdessen als <b>Einzelrechte</b> mit Abteilung (Benutzerstamm) und lass die Rolle ohne Abteilung. Die Auswahl über den Anlagenbaum gibt es für Rechte nicht, nur über die Abteilung.</div>
  <h3>Gerät sperren</h3>
  <p>Ist ein Terminal verloren gegangen oder soll es nicht mehr angemeldet sein, sperrst du es in der Karte <b>Gekoppelte Geräte</b> auf der Seite des Systembenutzers. Dort steht jedes gekoppelte Gerät mit <b>aktiv</b> oder <b>gesperrt</b> und dem Zeitpunkt, zu dem es zuletzt angemeldet war. Die Karte <b>Gekoppelte Geräte</b> sehen nur Benutzer mit dem Recht zur Benutzerverwaltung. Mit <b>Sperren</b> und einer Bestätigung wird das Gerät gesperrt.</p>
  <ul>
    <li>Die Sperre wirkt <b>innerhalb von 30 Sekunden</b>; danach ist das Terminal abgemeldet.</li>
    <li>Soll dasselbe Terminal wieder angemeldet werden, klicke <b>Gerät koppeln</b>, und gib den neuen Code am Terminal ein (wie oben).</li>
    <li>Eine Wartung von PDH meldet gekoppelte Geräte nicht ab.</li>
  </ul>
  <h3>Was am Terminal passiert</h3>
  <ul>
    <li><b>Bildschirmschoner</b> – Anlagenname und Uhrzeit. Eine Berührung öffnet die Störungsinfo. Wird eine Karte gelesen, öffnet sich die Störungsinfo ebenfalls und die Person ist gleich angemeldet.</li>
    <li><b>Störungsinfo</b> – die offenen Störungen und die offenen Tickets der Anlage und ihrer Unteranlagen, die neuesten zuerst (je höchstens 50, dazu „… und N weitere“). Bei Einträgen aus Unteranlagen steht der Weg dorthin (Pfad unterhalb der Terminal-Anlage) vor dem Alter. Die Seite aktualisiert sich alle 30 Sekunden von selbst. Welche Listen das Terminal zeigt, hängt von den Rechten des <b>Terminal-Benutzers</b> ab (auch wenn sich jemand kurz per Override am Terminal anmeldet): <b>Störungen ansehen</b> für die Störungsliste, <b>Tickets ansehen</b> für die Ticketliste, jeweils für die Abteilung der Anlage. Fehlt eines der Rechte, steht an der Stelle „Keine Berechtigung für Störungen“ bzw. „… für Tickets“; fehlen beide, zeigt das Terminal nur „Keine Berechtigung“. Unten führt <b>Neu</b> weiter.</li>
    <li><b>Neu</b> – <b>Störung</b> und <b>Ticket</b> öffnen vorerst beide die Meldeseite des Easy-Mode der Anlage (eine eigene Ticket-Meldung ist noch nicht verfügbar). Ist der <b>Easy-Mode</b> in den Core-Einstellungen ausgeschaltet, sind <b>Störung</b> und <b>Ticket</b> abgeblendet und das Terminal weist darauf hin („Melden am Terminal ist ausgeschaltet“) – so landet am Wandbildschirm niemand auf der Anmeldeseite. <b>Stillstand</b> ist noch nicht verfügbar. <b>Zurück</b> geht zur Störungsinfo.</li>
  </ul>
  <h3>Kartenleser und Kartensitzung</h3>
  <p>Ist am Terminal ein Kartenleser angeschlossen, meldet sich eine Person mit ihrer registrierten Karte an: Karte auflegen, dann zeigt das Terminal unten <b>Angemeldet: Name</b>. Die Kartensitzung endet nach <b>2 Minuten</b> ohne Berührung, mit dem Knopf <b>Abmelden</b> oder sobald das Terminal zum Bildschirmschoner zurückkehrt. Eine nicht registrierte Karte meldet niemanden an: das Terminal zeigt kurz <b>Karte nicht registriert</b>. Nach 10 unbekannten Karten innerhalb einer Minute bittet das Terminal, kurz zu warten. Der Kartenleser gehört zum gekoppelten Terminal; in einem normalen Browser gibt es ihn nicht.</p>
  <h3>Anmeldung ohne Kartenleser</h3>
  <p>Mit Kartenleser bleibt die Karte der normale Weg; dazu zeigt das Terminal den Knopf <b>Mit Benutzer und Passwort</b> (je Terminal abschaltbar). Meldet das Terminal <b>keinen Kartenleser</b> oder einen gestörten Leser, gilt die <b>Anmeldeart</b> des Terminals. Sie wird am Systembenutzer des Terminals eingestellt:</p>
  <ul>
    <li><b>Kartennummer + PIN</b> (Standard) – Felder <b>Kartennummer</b> und <b>PIN</b> mit Ziffernfeld (0–9, A–F).</li>
    <li><b>Benutzer + Passwort</b> – der Dialog mit Benutzername und Passwort ist sofort offen.</li>
    <li><b>Nur Kartennummer</b> – nur das Feld <b>Kartennummer</b>. Wer eine Kartennummer kennt, kann sich als diese Person anmelden; diese Art nur an gut einsehbaren Terminals verwenden.</li>
    <li><b>Keine</b> – das Terminal zeigt <b>Kein Kartenleser – Anmeldung nicht möglich</b>; auch der Knopf entfällt.</li>
  </ul>
  <p>Die <b>Terminal-PIN</b> (4 bis 8 Ziffern, nicht lauter gleiche und keine Zahlenfolge wie 1234) setzt jede Person unter <b>Mein Konto</b>; Benutzerverwalter können sie auch am Benutzer setzen oder entfernen. Nach <b>5</b> falschen PINs ist die PIN <b>15 Minuten</b> gesperrt (an allen Terminals); am Terminal erscheint dann nur <b>Anmeldung fehlgeschlagen</b>; die Sperrzeit (<b>PIN gesperrt bis HH:MM</b>) siehst du als Benutzerverwalter beim Benutzer. Ändert sich die Anmeldeart oder der Knopf, übernimmt das Terminal das <b>sofort</b>, ohne Neuladen. Bei Fehlern erscheint kurz <b>Anmeldung fehlgeschlagen</b>, bei zu vielen Versuchen <b>Bitte kurz warten</b>.</p>
  <h3>Benachrichtigung beim Kartenlesen (Windows-Terminal)</h3>
  <p>Wird an einem Windows-Terminal eine Karte gelesen, während das Terminalfenster im Hintergrund ist, zeigt das Terminal, wer angemeldet wurde. Welche Art der Benachrichtigung gilt, stellst du am Systembenutzer des Terminals ein (Terminal-Block, <b>Benachrichtigung beim Kartenlesen</b>). Mehrere Arten lassen sich zusammen wählen:</p>
  <ul>
    <li><b>Windows-Mitteilung</b> – eine Mitteilung von Windows.</li>
    <li><b>Fenster in der Mitte</b> (Vorgabe) – ein Fenster in der Bildschirmmitte, das nach 4 Sekunden schließt.</li>
    <li><b>Leiste oben</b> – eine Leiste am oberen Bildschirmrand, die nach 4 Sekunden schließt.</li>
    <li><b>Terminal nach vorn</b> – das Terminalfenster kommt in den Vordergrund.</li>
    <li><b>Keine Benachrichtigung</b> – schließt alle anderen Arten aus.</li>
  </ul>
  <p>Ist nichts angehakt, gilt die Vorgabe (Fenster in der Mitte). Die Einstellung wirkt nur an Windows-Terminals in der Betriebsart Zusatz und gilt am Terminal sofort, ohne Neuladen.</p>
  <h3>Globales Terminal (Infobildschirm)</h3>
  <p>Ein Terminal lässt sich zum <b>Infobildschirm</b> machen: Am Systembenutzer des Terminals das Kästchen <b>Globales Terminal (Infobildschirm)</b> anhaken und speichern. Das Terminal zeigt dann eine Folienschau, ohne Anmeldung und ohne Kartenleser. Die Folien pflegst du unter <b>Administration → Infobildschirm</b> (siehe Kapitel <a href="#infobildschirm">Infobildschirm</a>); dafür brauchst du das Recht <b>Infobildschirm bearbeiten</b>. Die Umschaltung gilt am Terminal sofort, ohne Neuladen; ältere Terminals zeigen weiter die Störungsinfo.</p>
  <p>Rührt niemand das Terminal an, kehrt es nach der <b>Rückkehrzeit</b> von Störungsinfo und „Neu“ zum Bildschirmschoner zurück.</p>
  <div class="hb-howto"><b><i class="ti ti-clock"></i> So stellst du die Rückkehrzeit ein</b>
    <ol class="hb-steps">
      <li><b>Für alle Terminals:</b> <b>Core-Einstellungen</b> → Karte <b>Anlagenterminal: Rückkehrzeit</b> → Sekunden eintragen → <b>Speichern</b>. Erlaubt sind 30 bis 3600 Sekunden, ohne Eintrag gelten <b>120</b> Sekunden. Die Karte sehen und ändern kann nur, wer Benutzer verwalten darf.</li>
      <li><b>Für ein einzelnes Terminal:</b> den Systembenutzer öffnen und im Terminal-Block <b>Rückkehrzeit zum Bildschirmschoner</b> eintragen. <b>Leer</b> heißt: die globale Einstellung gilt.</li>
    </ol>
    Werte außerhalb von 30 bis 3600 oder Text lehnt PDH mit einer Meldung ab; der bisherige Wert bleibt. Ein geänderter Wert gilt für das Terminal sofort, ohne Neuladen.</div>
  <h3>HMI am Terminal: Ansehen und Bedienen</h3>
  <p>Je HMI-Verbindung (Anlage → Reiter <b>HMI</b> → HMI anlegen oder bearbeiten) legst du fest, wer das HMI am Terminal ansehen und bedienen darf. Die Felder werden gespeichert; das HMI selbst erscheint am Terminal erst mit einem späteren Ausbau.</p>
  <ul>
    <li><b>Ansehen am Terminal</b>: <b>Jeder</b> (Standard) · <b>Nur mit Karte</b> · <b>Niemand</b>.</li>
    <li><b>Bedienen am Terminal</b>: <b>Niemand</b> · <b>Nur mit Karte</b> (Standard) · <b>Jeder</b>.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Vorsicht bei „Jeder“</b>Sobald HMIs am Terminal angezeigt werden, kann bei <b>Bedienen am Terminal</b> „Jeder“ jede Person am Terminal das HMI ohne Karte bedienen – ihre Eingaben wirken direkt auf die Anlage. PDH warnt schon jetzt im Formular in Rot. Nutze das nur, wenn der Bildschirm für Unbefugte nicht erreichbar ist.</div>
  <p>Ist beim HMI <b>Bedienen erlaubt</b> ausgeschaltet, gilt am Terminal beim Bedienen immer „Niemand“, auch wenn etwas anderes gespeichert ist. Das Formular weist darauf hin.</p>
  <div class="hb-howto"><b><i class="ti ti-cpu"></i> Sensoren am Terminal abfragen (Instandhalter)</b>
    <ol class="hb-steps">
      <li>Mit der Karte am Terminal anmelden.</li>
      <li>Mit dem Recht <b>ESPPDH: Sensorwerte ansehen</b> für diese Anlage erscheint unten der Bereich <b>Sensoren</b>: die ESPPDH-Geräte und Lebenszeichen (Handshake) der Anlage samt Unteranlagen mit ihren letzten Werten. Er lädt alle 10 Sekunden neu.</li>
      <li>Nach dem Abmelden verschwindet der Bereich sofort.</li>
    </ol></div>
  {{template "hb-shots" (dict "Ref" (index $s "terminal") "Can" $can)}}
</section>

<section class="hb-ch" id="infobildschirm" data-title="Infobildschirm" data-pages="terminal-slides">
  <h2><i class="ti ti-slideshow"></i> Infobildschirm</h2>
  <p>Der <b>Infobildschirm</b> ist ein Terminal, das keine Anlage zeigt, sondern eine <b>Folienschau</b> für den ganzen Betrieb: ein Bild (z. B. ein Aushang), ein Text (z. B. eine Mitteilung) oder die aktuellen Störungen und Tickets ausgewählter Anlagen. Die Folien laufen der Reihe nach, jede so lange, wie ihre Dauer sagt. Das Terminal braucht dafür weder eine Anmeldung noch einen Kartenleser.</p>
  <div class="hb-howto"><b><i class="ti ti-slideshow"></i> So richtest du den Infobildschirm ein</b>
    <ol class="hb-steps">
      <li>Am Systembenutzer des Terminals das Kästchen <b>Globales Terminal (Infobildschirm)</b> anhaken und speichern (siehe <a href="#terminal">Anlagenterminal</a>).</li>
      <li>In der Navigation <b>Administration → Infobildschirm</b> öffnen. Den Eintrag siehst du nur mit dem Recht <b>Infobildschirm bearbeiten</b> (Vorgabe: Administratoren und Manager).</li>
      <li>Oben <b>Bildfolie</b>, <b>Textfolie</b> oder <b>Vorgänge</b> wählen und das Formular ausfüllen, dann <b>Speichern</b>.</li>
    </ol></div>
  <ul>
    <li><b>Bild</b> – eine Datei als JPEG, PNG oder WebP, höchstens 5 MB. Der Titel ist freiwillig. Beim Bearbeiten bleibt das jetzige Bild, wenn du keine neue Datei wählst.</li>
    <li><b>Text</b> – Titel und Text, zusammen mindestens eines von beiden. Der Text hat höchstens 2000 Zeichen; Zeilenumbrüche bleiben erhalten. Es ist reiner Text, Formatierungen oder HTML werden nicht ausgeführt.</li>
    <li><b>Vorgänge</b> – die offenen Störungen und Tickets. Wähle eine oder mehrere <b>Anlagen</b> (jeweils mit ihren Unteranlagen); ohne Auswahl gelten alle. Mit den beiden Kästchen schaltest du <b>Störungen</b> und <b>Tickets</b> einzeln ab. Das Terminal zeigt höchstens 12 je Art und nur, was der Terminal-Benutzer sehen darf.</li>
    <li><b>Statistik Störungen / Tickets / Rüstzeiten</b> – Kennzahlen und ein Säulendiagramm für die gewählten Anlagen samt Unteranlagen (ohne Auswahl alle). Zeitraum <b>7 Tage</b> (je Tag) oder <b>letzte 5 Wochen</b> (je Kalenderwoche, die laufende eingeschlossen). Die Zahlen erneuern sich, wenn die Folie erscheint (höchstens einmal pro Minute neu berechnet). Störungen: offene, neue und erledigte, dazu die mittlere Dauer bis zur Lösung (Stillstandszeiten werden nicht erfasst). Tickets: offene je Status, neue und erledigte. Rüstzeiten: laufende, Anzahl und mittlere Dauer. Gezählt wird nur, was der Terminal-Benutzer ansehen darf (Störungen, Tickets, Rüstzeiten ansehen, je Abteilung der Anlage).</li>
    <li><b>Grafana-Dashboard</b> – bettet ein Dashboard ein: ein Vorschlag aus der Statistik, ein Pfad unter <code>/grafana/…</code> oder eine volle https-Adresse (http nur für localhost; keine Platzhalter oder Zugangsdaten). Der Bildschirm darf nur PDH selbst und diese Adresse einbetten; kommt eine neue Adresse hinzu, lädt der Bildschirm einmal neu. Der Terminal-Benutzer braucht das Recht <b>Statistik ansehen</b> (die Rolle Terminal hat es nicht, weil Grafana nicht nach Anlagen getrennt ist), sonst bleibt die Fläche leer; die Verwaltung weist darauf hin.</li>
    <li><b>Dauer</b> – 5 bis 600 Sekunden, ohne Eintrag 15.</li>
    <li><b>Aktiv</b> – nur aktive Folien laufen. Mit dem Haken aus bleibt die Folie gespeichert, wird aber nicht gezeigt.</li>
  </ul>
  <p>In der Liste ändern die Pfeile <b>Hoch</b> und <b>Runter</b> die Reihenfolge, <b>Bearbeiten</b> öffnet das Formular, und der Papierkorb löscht die Folie nach einer Rückfrage. Bei Bildfolien zeigt die Liste eine Vorschau. Jede Änderung erreicht alle Infobildschirme sofort, ohne Neuladen.</p>
  <p>Ungültige Eingaben (zu langer Text, falsche Bildart, ein Bild über 5 MB, eine Dauer außerhalb von 5 bis 600) lehnt PDH mit einer Meldung im Formular ab; gespeichert wird dann nichts.</p>
  <div class="hb-howto"><b><i class="ti ti-hand-finger"></i> So bedient man den Infobildschirm</b>
    <ul>
      <li><b>Weiterblättern</b> – auf eine freie Fläche tippen oder mit dem Finger nach links wischen. Die Dauer der nächsten Folie beginnt dann neu.</li>
      <li><b>Vorgang ansehen</b> – in einer Vorgänge-Folie einen Eintrag antippen. Die Ansicht zeigt Titel, Status, Anlage, Beschreibung, wann der Vorgang erstellt und zuletzt geändert wurde und die letzten fünf Verlaufseinträge. Sie ist nur zum Lesen: keine Anhänge, keine Knöpfe außer <b>Zurück</b>. Nach der Rückkehrzeit des Terminals geht es von selbst zur Folienschau zurück.</li>
      <li><b>Nicht freigegeben</b> – ein Vorgang, der nicht zu einer Anlage einer aktiven Vorgänge-Folie gehört oder den der Terminal-Benutzer nicht sehen darf, lässt sich nicht öffnen.</li>
      <li><b>Ohne Folien</b> zeigt der Bildschirm „Keine Folien eingerichtet“.</li>
    </ul></div>
  <p>Ein globales Terminal liest keine Karten und hat keine Anmeldung; die Wege dafür sind gesperrt. Schaltest du das Kästchen am Systembenutzer aus, wird der Bildschirm von selbst wieder zum normalen Anlagenterminal. Ein Terminalprogramm mit Zwischenspeicher bekommt die Folien samt Bildern nach jeder Änderung mitgeschickt (je Bild höchstens 5 MB, insgesamt höchstens 50 MB); ältere Terminalprogramme ignorieren das. Statistik- und Grafana-Folien laufen nur, solange PDH erreichbar ist: sie kommen nicht in den Zwischenspeicher, ein Terminal ohne Verbindung überspringt sie.</p>
  {{template "hb-shots" (dict "Ref" (index $s "infobildschirm") "Can" $can)}}
</section>

<section class="hb-ch" id="watch" data-title="Anlagen-Schnellübersicht" data-pages="plant-watch">
  <h2><i class="ti ti-eye"></i> Anlagen-Schnellübersicht</h2>
  <p>Die <b>Anlagen-Schnellübersicht</b> (Navigation → Material &amp; Anlagen) zeigt Anlagen, auf die ihr ein besonderes Augenmerk legt, auf einen Blick – z. B. alle Trockenkammern mit ihren Motoren, Klappenmotoren, Heizungsventilen und -pumpen. Je Anlage gibt es eine Karte mit Ampel:</p>
  <ul>
    <li><b>Rot – Handlungsbedarf:</b> eine kritische Störung ist offen oder ein Bauteil steht auf NOK.</li>
    <li><b>Gelb – beobachten:</b> eine Störung ist offen, eine Wartung oder eine Prüfpflicht ist überfällig.</li>
    <li><b>Grün – alles OK.</b></li>
  </ul>
  <p>Gezählt wird immer die Anlage mit allen Unteranlagen. Bei Trockenkammern steht je Bauteilgruppe eine Reihe nummerierter Kästchen: grün = OK, rot = NOK, grün ist der Standard. Mit der Maus darauf (oder lange tippen) siehst du Typ, letzten Wechsel und Ursache. Mit dem Recht <b>Infrastruktur bearbeiten</b> schaltet <b>ein Klick</b> das Bauteil von grün (OK) auf rot (NOK) und wieder zurück – die Änderung steht in der Historie der Anlage. Ohne das Recht öffnet der Klick den Reiter <b>Bauteile</b>. Bei anderen Anlagen stehen die Unteranlagen und Geräte mit eigenem Ampelpunkt darunter. Sind der Anlage oder ihren Unteranlagen <b>Energiewerte</b> zugeordnet (Import-Zuordnungen aus MQTT, Modbus, OPC-UA … mit Bezeichnungen wie Energie, kWh, Leistung, Strom, Verbrauch, Gas, Wärme, Druckluft), zeigt die Karte den letzten Messwert mit <i class="ti ti-bolt"></i>; Werte älter als ein Tag sind grau. Die Karten aktualisieren sich jede Minute von selbst. <b>Nur Auffälliges</b> blendet alle grünen Karten aus.</p>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Schnellübersicht an</b>
    <ol class="hb-steps">
      <li><b>Anlagen-Schnellübersicht</b> öffnen → <b>Neue Übersicht</b>.</li>
      <li><b>Name</b> eintragen, z. B. „Trockenkammern“, und optional ein Symbol (z. B. <code>ti-temperature</code>).</li>
      <li>Unter <b>Ganze Anlagentypen</b> z. B. „alle Trockenkammer“ anhaken – dann erscheinen auch später angelegte Trockenkammern automatisch. Oder unter <b>Einzelne Anlagen &amp; Geräte</b> gezielt Anlagen wählen (das Suchfeld filtert die Liste).</li>
      <li>Mit dem Recht zum Einrichten: unter <b>Freigeben für Gruppen</b> bzw. <b>für einzelne Benutzer</b> festlegen, wer die Übersicht sieht.</li>
      <li><b>Speichern</b>. Die Übersicht steht oben als Reiter; mehrere Übersichten wechselst du dort.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer sieht und ändert was?</b>
    <ul>
      <li>Die Seite braucht das Recht <b>Infrastruktur ansehen</b>.</li>
      <li>Jede/r kann eigene Übersichten anlegen – sie sind nur für sie/ihn selbst sichtbar.</li>
      <li>Mit dem Recht <b>Anlagen-Schnellübersichten einrichten und für Benutzer/Gruppen freigeben</b> (Administratoren, Manager, Anlagenverantwortliche) gibst du Übersichten für Gruppen oder einzelne Personen frei und kannst alle Übersichten bearbeiten und löschen. Wer in einer freigegebenen Gruppe ist, sieht die Übersicht automatisch.</li>
    </ul>
    Löschen entfernt nur die Übersicht – die Anlagen und ihre Daten bleiben unverändert.</div>
  <p><b>Handshake:</b> Jede Karte zeigt die Lebenszeichen der Anlage samt Unteranlagen – ESPPDH-Geräte und Heartbeats von Steuerungen (z. B. TIA-Baustein) – mit ihrem Zähler, der sichtbar weiterläuft (alle 10 Sekunden). Steht ein Zähler, wird die Karte gelb („Handshake steht“). Den Zähler eines ESPPDH-Geräts siehst du mit dem Recht „ESPPDH: Sensorwerte ansehen“, sonst nur „läuft“ oder „steht“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "watch") "Can" $can)}}
</section>

<section class="hb-ch" id="qrcodes" data-title="QR-Codes an Anlagen &amp; Geräten" data-pages="asset-info">
  <h2><i class="ti ti-qrcode"></i> QR-Codes an Anlagen &amp; Geräten</h2>
  <p>Jede Anlage der Infrastruktur und jedes IT-Asset hat einen eigenen QR-Code. Er führt auf eine <b>Infoseite</b>, die fürs Handy gebaut ist: Stammdaten, alle <b>offenen Störungen, Tickets, Aufträge/Aufgaben und Wartungen</b> und große Knöpfe zum Neuanlegen.</p>
  <div class="hb-howto"><b><i class="ti ti-scan"></i> So arbeitest du mit dem QR-Code an der Maschine</b>
    <ol class="hb-steps">
      <li>QR-Code mit der Handy-Kamera scannen. Bist du nicht angemeldet, öffnet sich bei Anlagen der <b>Easy-Mode</b> (siehe unten) – oben rechts <b>Anmelden</b>, danach geht es direkt auf die Infoseite.</li>
      <li>Einen offenen Vorgang antippen: Er klappt auf – <b>Ansehen</b>, <b>Bearbeiten</b> oder <b>Beheben</b>/<b>Abschließen</b>/<b>Erledigen</b>/<b>Durchführen</b> startet den gewohnten Abschluss-Assistenten Schritt für Schritt.</li>
      <li>Hilfen dazu: oben in der Kopfleiste <i class="ti ti-brain"></i> <b>Copilot</b> klappt die Vorschläge auf und zu (blinkt gelb, wenn es welche gibt), <i class="ti ti-messages"></i> <b>Chat</b> genauso.</li>
      <li>Oder oben <b>Störung melden</b>, <b>Ticket</b>, <b>Aufgabe</b> bzw. <b>Wartung</b> antippen. Anlage (und beim IT-Asset das Gerät) sind schon eingetragen. Nach dem Speichern kommst du zurück auf die Infoseite.</li>
    </ol></div>
  <p>Bei Anlagen mit Unteranlagen zeigt die Seite auch die Vorgänge der Unteranlagen (mit deren Namen); „nur diese Anlage“ blendet sie aus. Über <b>Unteranlagen</b> und den Pfeil zur übergeordneten Anlage wechselst du direkt zur nächsten Infoseite. Ein IT-Asset zeigt die Vorgänge, die diesem Gerät zugeordnet sind, und verweist auf die Anlage, bei der es steht. Wartungen für ein IT-Asset gehen nur, wenn es einer Anlage zugeordnet ist.</p>
  <h3 id="easy-mode"><i class="ti ti-hand-finger"></i> Easy-Mode: melden ohne Anmeldung</h3>
  <p>Damit wirklich jeder eine Störung melden kann – auch ohne Konto und in der eigenen Sprache –, öffnet der QR-Code einer Anlage für Nicht-Angemeldete eine einfache Meldeseite. Sie erscheint in der <b>Sprache des Handys</b> (Deutsch, Englisch, Rumänisch, Türkisch, Mazedonisch; oben umschaltbar) und zeigt die <b>letzten 5 Meldungen</b> der Anlage sowie zwei große Tasten <b>Störung +</b> und <b>Ticket +</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So meldest du im Easy-Mode</b>
    <ol class="hb-steps">
      <li>QR-Code scannen → <b>Störung +</b> (etwas ist kaputt) oder <b>Ticket +</b> (etwas wird gebraucht).</li>
      <li><b>Was ist zu melden?</b> – einen der vorgegebenen <b>Meldetexte</b> antippen (falls für die Anlage hinterlegt) und/oder in der eigenen Sprache schreiben. Mit Meldetext ist der eigene Text freiwillig. Darunter mit <b>Foto aufnehmen</b> oder <b>Bild wählen</b> bis zu drei Fotos vom Problem anhängen (freiwillig).</li>
      <li><b>Elektrisch</b> oder <b>Mechanisch</b> antippen. Gibt der Meldetext das schon vor, entfällt dieser Schritt.</li>
      <li><b>Anlage läuft</b> oder <b>Anlage steht</b> antippen – fertig, die Meldung ist da.</li>
    </ol>
    Die Meldung wird automatisch ins Deutsche übersetzt (Copilot). In der Störung bzw. im Ticket steht der <b>deutsche Text immer oben</b>, darunter das Original, dann die Art und ob die Anlage steht. „Anlage steht“ bekommt hohe Priorität. Ersteller ist „Service“, in der Historie steht „QR-Code (Easy-Mode)“. Nach dem Namen fragt der Easy-Mode nicht. Mit Meldetext ist dieser der Titel der Meldung, ein eigener Text steht als Ergänzung darunter. Ohne eingerichteten Copilot bleibt der Text in der Originalsprache mit Hinweis.</div>
  <p><b>Rüsten im Easy-Mode:</b> Sind der Anlage Rüsttasten zugeordnet, stehen sie zusätzlich unter <b>Rüsten</b>. Eine Taste antippen startet die Rüstzeit, <b>Fertig</b> beendet sie, <b>Rüstzeit nachtragen</b> erfasst eine schon beendete (<a href="#ruestzeiten">mehr</a>).</p>
  <div class="hb-howto" id="hb-easy-texts"><b><i class="ti ti-message-2"></i> So hinterlegst du Meldetexte für den Easy-Mode</b>
    <ol class="hb-steps">
      <li><b>Infrastruktur</b> öffnen → unten <b>Easy-Mode: Meldetexte</b> → bei <b>Neuer Meldetext</b> den Text auf Deutsch eintragen, z. B. „Band steht“ oder „Öl tritt aus“.</li>
      <li>Wählen, ob der Text für <b>Störung &amp; Ticket</b>, nur Störung oder nur Ticket gilt, und ob er <b>immer elektrisch</b> bzw. <b>immer mechanisch</b> ist – dann fragt der Easy-Mode das nicht mehr. <b>Anlegen</b>.</li>
      <li>Anlage öffnen → Reiter <b>Meldetexte</b> → passende Texte anhaken → <b>Zuordnung speichern</b>. Einen Text an einer Halle oder Linie zuordnen, dann gilt er für alle Anlagen darunter (dort steht „über …“).</li>
      <li>Fehlt ein Text, im Reiter unten direkt <b>Anlegen und zuordnen</b> – er kommt in den Katalog und gilt gleich an dieser Anlage.</li>
      <li>Die <b>Reihenfolge</b> der Tasten legst du im Katalog mit <i class="ti ti-chevron-up"></i> / <i class="ti ti-chevron-down"></i> fest – sie gilt für alle Anlagen. Neue Texte kommen ans Ende.</li>
    </ol>
    Im Easy-Mode erscheinen die Texte als große Tasten in der <b>Sprache des Handys</b> (automatisch übersetzt, wenn unter Server-Einstellungen → Übersetzung ein Dienst eingerichtet ist, sonst auf Deutsch). In der Meldung steht immer der deutsche Text. Ändern oder Löschen geht im Katalog; gelöschte Texte verschwinden von allen Anlagen.</div>
  <div class="hb-howto"><b><i class="ti ti-hand-finger"></i> So testest du den Easy-Mode (Admins)</b>
    <ol class="hb-steps">
      <li>Anlage öffnen → oben <b>Easy-Mode testen</b>. Die Meldeseite öffnet sich in einem neuen Tab – genau so, wie sie nach dem QR-Scan aussieht.</li>
      <li>Oben steht gelb <b>Testansicht (Admin)</b>. Sprache oben umschalten, um die Seite in anderen Sprachen zu sehen.</li>
      <li>Eine Testmeldung durchspielen. Sie wird echt angelegt, der Titel beginnt aber mit <b>„TEST:“</b> – danach in Störungen bzw. Tickets wiederfinden und löschen.</li>
    </ol>
    Der Knopf funktioniert auch, wenn der Easy-Mode ausgeschaltet ist – so lässt er sich vor dem Einschalten ausprobieren.</div>
  <p>Der Easy-Mode lässt sich unter <b>Core-Einstellungen → Easy-Mode</b> abschalten; dann führen QR-Codes wie früher zur Anmeldung. Zum Schutz vor Missbrauch nimmt PDH je Gerät höchstens 6 Meldungen in 10 Minuten und je Anlage 30 in der Stunde an. Im Easy-Mode sieht man nur Titel, Zeitpunkt und Status der letzten Meldungen – keine Namen und keine anderen Seiten.</p>
  <div class="hb-howto"><b><i class="ti ti-printer"></i> So druckst du QR-Etiketten</b>
    <ol class="hb-steps">
      <li>Einzeln: in der Anlage bzw. im IT-Asset oben auf <i class="ti ti-printer"></i> – oder auf der Infoseite unter <b>QR-Code dieser Seite → Etikett drucken</b>.</li>
      <li>Für eine Anlage samt allen Unteranlagen: im Menü <i class="ti ti-dots"></i> der Anlage <b>QR-Etiketten inkl. Unteranlagen</b>. Für den ganzen Bestand: in der Liste Infrastruktur bzw. IT oben <b>QR-Etiketten</b>.</li>
      <li>Format wählen und <b>Drucken</b> – oder ohne Druckdialog <b>Direkt drucken</b> auf einen eingerichteten Drucker (<a href="#printers">Drucker</a>). Die Formate sind dieselben wie bei den <a href="#storage">Lager-Etiketten</a>.</li>
    </ol></div>
  <p>Auf der Infoseite und auf dem Etikett erscheint nur, was die Person sehen darf (Modulrechte und Abteilungs-Sicht). Der Link im QR-Code nutzt die <b>öffentliche Adresse</b> aus den Server-Einstellungen – damit er auch vom Handy aus funktioniert.</p>
  {{template "hb-shots" (dict "Ref" (index $s "qrcodes") "Can" $can)}}
</section>

<section class="hb-ch" id="inventory" data-title="Ersatzteile" data-pages="inventory inventory-scan">
  <h2><i class="ti ti-package"></i> Ersatzteile</h2>
  <p>Die Ersatzteilliste hat oben Reiter je <b>Kategorie</b> und Kacheln für „unter Mindestbestand“, „kritisch“, „leer“ und „ohne Lieferant“.</p>
  <h3><i class="ti ti-building-factory-2"></i> Hersteller und Lieferant sind zwei verschiedene Dinge</h3>
  {{template "hb-fig-partner"}}
  <div class="hb-howto"><b><i class="ti ti-photo"></i> So bekommt ein Teil ein Bild</b>
    <ol class="hb-steps">
      <li>Teil öffnen → Reiter <b>Stammdaten</b> → <b>Bild im Internet suchen</b>.</li>
      <li>Der Suchbegriff ist schon ausgefüllt (Hersteller + Teilenummer) – bei Bedarf anpassen.</li>
      <li>Auf das passende Bild klicken – es wird übernommen und im PDH gespeichert.</li>
    </ol>
    Alternativ: Bild-URL einfügen, Datei hochladen oder mit der Kamera fotografieren.</div>
  <h3 id="part-docs"><i class="ti ti-file-search"></i> Datenblatt und Benutzerhandbuch</h3>
  <p>Zu jedem Teil kann PDH das <b>aktuelle Datenblatt</b> und das <b>Benutzerhandbuch</b> aus dem Internet holen und unter <b>Dokumente</b> ablegen. Die Dateien liegen danach im PDH – sie sind auch dann da, wenn der Hersteller seine Seite umbaut.</p>
  {{template "hb-fig-partdocs"}}
  <div class="hb-howto"><b><i class="ti ti-file-search"></i> So holst du Datenblatt und Handbuch</b>
    <ol class="hb-steps">
      <li>Teil öffnen → Reiter <b>Dokumente</b> → <b>Datenblatt &amp; Handbuch suchen</b>.</li>
      <li>Hersteller und Typ sind schon eingetragen (aus den Stammdaten). Am besten findet PDH mit <b>Hersteller + Hersteller-Teilenummer</b> – bei Bedarf anpassen und <b>Suchen</b>. Die Suche dauert bis zu einer Minute.</li>
      <li>Die Treffer stehen getrennt nach <b>Datenblatt</b> und <b>Benutzerhandbuch</b>. <span class="badge b-green">Hersteller</span> heißt: direkt vom Hersteller. Mit <b>Ansehen</b> öffnest du das PDF vorher im Browser.</li>
      <li><b>Übernehmen</b> lädt das PDF herunter. Es erscheint unter Dokumente mit dem Etikett <b>Datenblatt</b> oder <b>Benutzerhandbuch</b>, dem Stand und einem Link zur Quelle.</li>
    </ol>
    Du hast das PDF schon selbst gefunden? Die Adresse unten im Fenster einfügen, Art wählen, <b>Übernehmen</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> So bleibt es aktuell</b>
    <ol class="hb-steps">
      <li>Beim Dokument auf <b>Aktualisieren</b> – oder oben auf <b>Alle aktualisieren</b> für alle Dokumente des Teils.</li>
      <li>PDH lädt das Dokument erneut von der Quelle. Hat der Anbieter eine <b>neue Fassung</b>, wird die alte Datei ersetzt und im Verlauf vermerkt. Sonst ändert sich nur das Datum bei „Stand“.</li>
    </ol></div>
  <p><b>Wie wird gesucht?</b> Ist unter Server-Einstellungen → Copilot ein Anthropic-Schlüssel hinterlegt, sucht <b>Claude</b> im Internet – zuerst beim Hersteller, dann bei seriösen Händlern. Sonst sucht PDH über DuckDuckGo. Angezeigt werden in beiden Fällen nur Adressen, hinter denen PDH wirklich ein PDF gefunden hat. Manche Anbieter geben Dokumente nur nach Anmeldung heraus – dann das PDF selbst herunterladen und über <b>Dokument</b> hochladen. Nutzungsrechte des Anbieters beachten. Suchen und übernehmen kann, wer Ersatzteile bearbeiten darf.</p>
  <div class="hb-howto"><b><i class="ti ti-qrcode"></i> So buchst du per QR-Code am Lagerplatz</b>
    <ol class="hb-steps">
      <li>Den QR-Code auf dem Lagerplatz-Etikett mit dem Smartphone scannen – oder im Teil oben auf <b>Buchen</b>. Es öffnet sich die <b>Buchungserfassung</b> mit Bild, Beschreibung und Bestand. Der Lagerplatz des Etiketts ist schon gewählt.</li>
      <li>Buchungsart antippen:
        <b>Einbuchung</b> (Wareneingang),
        <b>Ausbuchung</b> (Entnahme),
        <b>Reservierung</b> (zurücklegen),
        <b>Sonstiges</b> (Zugang oder Abgang mit Grund, z. B. Ausschuss, Rücksendung) oder
        <b>Korrektur</b> (gezählten Bestand eintragen, PDH bucht die Differenz).</li>
      <li>Bei <b>Ausbuchung</b> und <b>Reservierung</b> wählst du, wofür: einen offenen <b>Vorgang</b> (Störung, Ticket, Aufgabe, Wartung – deine eigenen stehen oben, tippen zum Suchen) oder eine <b>Anlage</b> aus dem Infrastruktur-Baum. Ohne Zuordnung bucht PDH nicht.</li>
      <li>Menge eingeben – <b>Buchen</b>. Mehr als am Lagerplatz liegt, lässt sich nicht ausbuchen.</li>
    </ol>
    Eine Reservierung auf eine Anlage steht beim Teil unter <b>Reservierungen</b>: <b>Verbraucht</b> bucht sie als Entnahme, <b>Zurückbuchen</b> legt sie zurück. Etiketten, die vor dieser Version gedruckt wurden, öffnen noch das Teil – dort führt <b>Buchen</b> zur Erfassung.
    Rechte: „Ersatzteile ein-/ausbuchen und reservieren“ für Einbuchung, Ausbuchung, Reservierung; „Bestandskorrekturen und sonstige Buchungen“ für Sonstiges und Korrektur.</div>
  <h3 id="reservation"><i class="ti ti-bookmark"></i> Ersatzteile reservieren</h3>
  <p>Teile für eine Störung, ein Ticket, eine Aufgabe oder eine Wartung werden <b>reserviert</b>: Die Menge wird sofort vom gewählten Lagerplatz <b>abgebucht</b>. So kann sie niemand anderes mehr verplanen. Der Bestand zeigt dann nur noch die freie Menge, die reservierte steht <b>in Klammern</b> daneben – z. B. <b>6 <span class="res-q">(4)</span></b> / 2 Stk: 6 frei, 4 reserviert, Mindestbestand 2. Das gilt in der Ersatzteilliste, beim Teil, je Lagerplatz und bei der Teilesuche im Abschluss-Assistenten.</p>
  <div class="hb-howto"><b><i class="ti ti-bookmark"></i> So reservierst du und buchst zurück</b>
    <ol class="hb-steps">
      <li>Im Vorgang bei <b>Ersatzteile</b> auf <b>Ersatzteil reservieren</b> (oder im Abschluss-Assistenten beim Schritt Material): Teil suchen, Lagerplatz und Menge wählen, <b>Reservieren</b>. Liegt dort nicht genug, lehnt PDH ab und nennt die freie Menge.</li>
      <li>Die Position trägt jetzt die Kennzeichnung <span class="res-q">reserviert</span>.</li>
      <li>Nicht alles gebraucht? An der Position <b>Zurückbuchen</b> und die Menge angeben – auch teilweise. Das <i class="ti ti-x"></i> bucht die ganze Position zurück.</li>
      <li>Beim <b>Fertig</b> im Abschluss-Assistenten wird der Rest zum <b>Verbrauch</b> des Vorgangs. Doppelt abgebucht wird nichts.</li>
    </ol>
    Wird ein Vorgang <b>verworfen, archiviert oder gelöscht</b>, ohne dass das Material verbucht wurde, gehen offene Reservierungen automatisch an ihren Lagerplatz zurück.</div>
  <p>Beim Teil zeigt der Reiter <b>Lager &amp; Bewegungen</b> die Karte <b>Reservierungen</b>: für welchen Vorgang, an welchem Lagerplatz, von wem. Mit <b>Zurückbuchen</b> lässt sich dort direkt zurückbuchen. In den Bewegungen erscheinen <span class="badge b-amber">Reservierung</span> und <span class="badge b-blue">Rückbuchung Reservierung</span>. Nach dem Abschluss wird daraus <i>Abgang</i>, eine vorherige Teil-Rückbuchung zählt als <i>Zugang</i>. Reservierungen entstehen nur über Vorgänge, nicht über die manuelle Buchung. Vor dieser Version vorgemerkte Teile sind noch nicht abgebucht und werden wie bisher erst beim Abschluss gebucht.</p>
  <div class="hb-howto"><b><i class="ti ti-truck-delivery"></i> So buchst du einen Lieferschein mit dem Smartphone</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Scannen</b> → Reiter <b>Lieferschein</b>.</li>
      <li><b>Seite fotografieren</b> – jede Seite einzeln, gerade von oben und gut ausgeleuchtet. Ein PDF vom Lieferanten geht über <b>Fotos / PDF wählen</b>.</li>
      <li><b>Lieferschein erkennen</b>. Nach 20 bis 60 Sekunden steht jede Position mit Vorschlag da: <b>Zugang buchen</b> zu einem gefundenen Teil (grün: über Teile-, Hersteller- oder Lieferanten-Nummer gefunden) oder <b>Neu anlegen + buchen</b>.</li>
      <li>Oben Lieferant und <b>Lagerort für alle</b> prüfen, bei Bedarf je Position Menge, Teil oder Lagerort ändern, Unpassendes auf <b>Überspringen</b> stellen.</li>
      <li><b>Zugänge buchen</b> – alle Positionen werden zusammen gebucht, mit der Lieferschein-Nr. als Beleg.</li>
    </ol>
    Mit gewähltem Lieferanten merkt sich PDH dessen Artikelnummern am Teil – der nächste Lieferschein findet die Teile dann direkt. Fotos und Ergebnis bleiben unter <b>Scannen → Letzte Scans</b> erhalten.</div>
  <div class="hb-howto"><b><i class="ti ti-camera-search"></i> So erkennst du ein Bauteil per Foto</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Scannen</b> → Reiter <b>Bauteil erkennen</b>.</li>
      <li>Das Teil fotografieren, am besten zusätzlich das Typenschild bzw. Etikett (bis zu drei Fotos).</li>
      <li><b>Bauteil erkennen</b>. PDH zeigt Bezeichnung, Hersteller, Typ und Merkmale – und darunter passende Teile <b>im Lager</b> mit Bestand.</li>
      <li>Passt ein Teil: <b>Öffnen</b> oder <b>Buchen</b>. Sonst unten <b>Als neues Teil anlegen</b> – die Felder sind vorausgefüllt.</li>
      <li>Unter <b>Teilebild</b> zeigt PDH passende Bilder aus dem Internet (gesucht nach Hersteller und Teilenummer). Das erste ist ausgewählt, ein Klick wählt ein anderes, <b>Suchen</b> mit anderem Begriff sucht neu. Statt dessen geht auch <b>Eigenes Foto</b> oder <b>Kein Bild</b>.</li>
      <li><b>Teil anlegen</b>. Lässt sich das Internet-Bild nicht laden, nimmt PDH dein Foto.</li>
    </ol>
    Große Handyfotos sind kein Problem: PDH verkleinert sie vor der Erkennung selbst.
    „Unsicher“ heißt: lieber ein weiteres Foto vom Typenschild machen. Nummern übernimmt PDH nur, wenn sie im Bild lesbar sind. Für beides braucht es das Recht „Lager bearbeiten“ und Claude als Copilot (Server-Einstellungen → Copilot).</div>
  <div class="hb-howto"><b><i class="ti ti-truck-off"></i> Rückstand und Bestellvorschlag beim Lieferschein</b>Steht auf dem Lieferschein eine bestellte Menge oder ein Rückstand, zeigt die Position <b>Rückstand …</b> (rot), und oben steht, wie viele Positionen nicht vollständig geliefert sind. Gebucht wird immer nur die gelieferte Menge. Lag ein gefundenes Teil unter Mindestbestand, steht <b>im Bestellvorschlag</b> daneben. Nach dem Buchen listet die Seite die Teile dieses Lieferanten, die <b>noch unter Mindestbestand</b> liegen – mit Link zum Bestellvorschlag.</div>
  <div class="hb-howto"><b><i class="ti ti-barcode"></i> So findest du ein Teil per Barcode</b>
    <ol class="hb-steps">
      <li><b>Ersatzteile</b> → <b>Barcode</b> und den Strichcode auf Teil oder Verpackung fotografieren.</li>
      <li>Ist die Nummer eindeutig einem Teil zugeordnet – EAN, Teilenummer, Hersteller- oder Lieferanten-Artikelnummer –, öffnet sich das Teil direkt im Reiter <b>Lager &amp; Bewegungen</b> zum Buchen. Sonst zeigt die Liste alle Treffer. Ein QR-Code von einem PDH-Etikett oder einer Kanban-Karte öffnet direkt die Buchungserfassung bzw. die Karte.</li>
    </ol>
    Die EAN trägst du in den <b>Stammdaten</b> des Teils ein – auch per Barcode-Knopf neben dem Feld. PDH prüft die Prüfziffer. Beim Lieferschein- und Bauteil-Scan wird eine erkannte EAN bei neuen Teilen übernommen und bei vorhandenen ohne EAN ergänzt. Kann der Browser keine Barcodes lesen (z. B. Safari auf dem iPhone), fragt PDH nach der Nummer zum Eintippen.</div>
  <p>Die <b>Lagerbewegungen</b> eines Teils lassen sich sortieren, z. B. nach Person oder Art (<a href="#sort">mehr</a>). „Letzte Bewegungen“ und „Letzte Buchungen“ bleiben kurze Auszüge.</p>
  {{template "hb-shots" (dict "Ref" (index $s "inventory") "Can" $can)}}
</section>

<section class="hb-ch" id="storage" data-title="Lager, Lagerplätze &amp; Etiketten" data-pages="storage labels-designer">
  <h2><i class="ti ti-building-warehouse"></i> Lager, Lagerplätze &amp; Etiketten</h2>
  <p>Das Lager ist gegliedert in Lagerort → Regal → Fach → Platz. Über <i class="ti ti-external-link"></i> öffnest du einen Platz mit Bestand, Bewegungen und Dokumenten.</p>
  <h3><i class="ti ti-printer"></i> Etiketten</h3>
  <p>So sieht ein Etikett im Standard aus – der QR-Code öffnet mit dem Handy direkt die <b>Buchungserfassung</b> des Teils an diesem Lagerplatz:</p>
  <figure class="hb-fig" style="display:flex;justify-content:center">
    <div style="width:62mm;height:29mm;background:#fff;color:#111;display:flex;gap:1.5mm;padding:1.5mm 2mm;border:1px solid #ccc;border-radius:2px;text-align:left;font-family:Arial,sans-serif">
      <div style="height:100%;aspect-ratio:1/1;flex-shrink:0">{{.SampleQR}}</div>
      <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;line-height:1.12">
        <div style="font-weight:700;font-size:9pt;border-bottom:.3mm solid #000">Fach 3</div>
        <div style="font-size:7pt;font-weight:600">Rillenkugellager 6205</div>
        <div style="display:flex;justify-content:space-between;align-items:flex-end">
          <div style="min-width:0;flex:1"><div style="font-size:5pt;color:#555">TEILE-NR.</div><div style="font-family:monospace;font-weight:700;font-size:8pt;word-break:break-all">4711-6205-2RSH-C3</div><div style="font-size:6pt;font-weight:700">SKF</div></div>
          <div style="text-align:right;font-size:6.5pt"><div style="font-size:5pt;color:#555">MINDESTMENGE</div><b style="font-size:8pt">4</b> Stück</div>
        </div>
      </div>
    </div>
  </figure>
  <div class="hb-howto"><b><i class="ti ti-printer"></i> So druckst du Etiketten</b>
    <ol class="hb-steps">
      <li>Im Teil auf <b>Etiketten</b> (alle Lagerplätze) oder auf das Drucker-Symbol an einem Lagerplatz – oder in der Etikettenansicht oben <b>📦 Lagerort wählen</b>: Lager, Regal, Fach oder Platz anhaken (gilt mit allen Unterplätzen, die Zahl nennt die Etiketten), „nur mit Bestand“ nach Bedarf, <b>Übernehmen</b>.</li>
      <li>Oben das <b>Format</b> deines Etikettendruckers wählen, ggf. Kopien.</li>
      <li><b>Drucken</b>: im Druckdialog Skalierung 100 % und keine Ränder einstellen.</li>
      <li>Oder ohne Druckdialog: rechts oben einen eingerichteten Drucker wählen und <b>Direkt drucken</b> (<a href="#printers">Drucker einrichten</a>).</li>
    </ol></div>
  <p>Verfügbare Formate <i class="ti ti-refresh" title="automatisch aus dem System"></i>:</p>
  <ul>{{range .LabelSizes}}<li>{{.Label}}</li>{{end}}</ul>
  <p>Bei A4-Bögen kannst du mit „Start bei Feld“ bereits benutzte Etiketten überspringen.</p>
  <div class="hb-howto"><b><i class="ti ti-layout-board-split"></i> So gestaltest du deine Etiketten (Designer)</b>
    <ol class="hb-steps">
      <li>In der Etikettenansicht oben <b>✎ Designer</b> (Recht „Lager bearbeiten“ oder „Drucker verwalten“). Oben rechts die <b>Etikettengröße</b> wählen – jede Größe hat ihr eigenes Layout.</li>
      <li>Rechts unter <b>Felder</b> anhaken, was aufs Etikett soll: QR-Code, Logo, Lagerplatz, Lagerpfad, Bezeichnung, Kategorie, Teilenummer, Hersteller, Hersteller-Teilenr., Mindestmenge, EAN oder ein Freitext.</li>
      <li>Felder auf dem Etikett mit der Maus <b>verschieben</b>, an der Ecke unten rechts die <b>Größe</b> ändern. Pfeiltasten verschieben um 0,1 mm (mit Umschalt um 1 mm).</li>
      <li>Für das gewählte Feld rechts genau einstellen: Position und Größe in mm, <b>Schriftgröße</b>, fett, Festbreite, Ausrichtung, <b>maximale Zeichenzahl</b> (längere Texte enden mit „…“), maximale <b>Zeilen</b>, Präfix (z. B. „Min “) und Linie darunter.</li>
      <li><b>Speichern</b>. Ab jetzt drucken Browser, Netzwerkdrucker, Zebra und Dymo nach diesem Layout. <b>Standard</b> stellt die ursprüngliche Gestaltung wieder her.</li>
    </ol>
    Die Vorschau zeigt ein echtes Teil aus dem Lager. Zebra und Dymo drucken das Logo nicht. Hat der Drucker ein anderes Etikettenmaß eingestellt, wird das Layout maßstäblich angepasst.</div>
  <div class="hb-howto"><b><i class="ti ti-stack-push"></i> So legst du viele Fächer und Plätze auf einmal an</b>
    <ol class="hb-steps">
      <li>Oben auf <b>Sammelanlegen</b> tippen – oder am Lagerort, Regal oder Fach auf <i class="ti ti-stack-push"></i>, dann ist das Ziel schon gewählt.</li>
      <li><b>Ziel</b> wählen: den Lagerort, das Regal oder das Fach, in das die neuen Einträge kommen.</li>
      <li><b>Ebene 1</b>: Art wählen (z. B. Fächer), dazu <b>Präfix</b>, <b>von</b> und <b>bis</b>. Beispiel: Präfix „A“, von „01“, bis „12“ ergibt A01 bis A12. Buchstaben gehen auch: von „A“ bis „F“.</li>
      <li><b>Ebene 2</b> (optional): z. B. Plätze von 1 bis 10 – sie entstehen in <b>jedem</b> Eintrag der Ebene 1. Mit „Namen der Ebene 1 voranstellen“ heißen die Plätze z. B. A01-1, A01-2 …</li>
      <li>Unter den Feldern siehst du, was entsteht und wie viele es sind. <b>Anlegen</b> und bestätigen.</li>
      <li>Der Dialog bleibt offen und zeigt das Ergebnis, z. B. „Sammelanlegen: 18 angelegt“; das Ziel ist im Baum grün markiert und aufgeklappt. <b>Weitere anlegen</b> für die nächste Reihe – oder <b>Fertig</b>.</li>
    </ol>
    Was es unter dem Ziel schon gibt, wird nicht doppelt angelegt, sondern übernommen. So ergänzt du z. B. nachträglich Plätze in bestehenden Fächern: Ziel = Regal, Ebene 1 = die vorhandenen Fächer, Ebene 2 = die neuen Plätze. Höchstens 500 je Reihe und 2000 auf einmal.</div>
  <div class="hb-howto" id="hb-storage-edit"><b><i class="ti ti-edit"></i> So änderst du die Lagerstruktur</b>
    <ol class="hb-steps">
      <li>Am Lagerort, Regal, Fach oder Platz auf <i class="ti ti-edit"></i> <b>Bearbeiten</b> tippen.</li>
      <li><b>Art</b> ändern, z. B. ein Fach zum Platz oder ein Regal zum Fach. Angeboten wird nur, was zur Lage und zu den Unterknoten passt: Lagerort → Regal → Fach → Platz (Ebenen dürfen übersprungen werden).</li>
      <li><b>Liegt in</b> ändern, um den Knoten zu verschieben – alles darunter wandert mit, auch der Bestand. „ganz oben“ macht ihn zum Lagerort.</li>
      <li>Name, Standort bzw. Kapazität und Beschreibung anpassen → <b>Speichern</b>.</li>
    </ol>
    Geht etwas nicht (z. B. ein Fach mit Plätzen darunter soll selbst ein Platz werden), steht der Grund direkt unter der Zeile. Jede Änderung steht in der Historie des Knotens.</div>
  <div class="hb-howto" id="hb-storage-delete"><b><i class="ti ti-trash"></i> So löschst du einen Lagerort, ein Regal, Fach oder einen Platz</b>
    <ol class="hb-steps">
      <li>In der Zeile auf <i class="ti ti-trash"></i> tippen – oder unter <b>Bearbeiten</b> auf <b>Löschen</b> – und bestätigen.</li>
      <li>Liegt dort oder darunter noch <b>Bestand</b>, löscht PDH nichts und nennt die Teile. Zuerst umlagern oder ausbuchen.</li>
      <li>Ohne Bestand wird der Knoten mit allen Unterknoten <b>sofort gelöscht</b>. Verweisen alte Buchungen darauf, wird er stattdessen <b>ausgeblendet</b>, damit die Lagerhistorie vollständig bleibt.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> So kopierst du ein Regal oder Fach</b>
    <ol class="hb-steps">
      <li>Am Eintrag auf <i class="ti ti-copy"></i> <b>Kopieren</b> tippen.</li>
      <li><b>Ziel</b> wählen – angeboten werden nur passende Ebenen.</li>
      <li><b>Name</b> der Kopie eintragen. Für mehrere Kopien Präfix, von und bis ausfüllen, z. B. „Regal “ von 2 bis 5.</li>
      <li>„mit allen Unterknoten“ kopiert Fächer und Plätze mit. Bestand und Buchungen werden nicht kopiert.</li>
    </ol></div>
  <p>Die <b>Lagerbewegungen</b> eines Lagerorts lassen sich sortieren (<a href="#sort">mehr</a>). Die Historie eines Lagerorts sieht, wer den Lagerort sehen darf.</p>
  {{template "hb-shots" (dict "Ref" (index $s "storage") "Can" $can)}}
</section>

<section class="hb-ch" id="printers" data-title="Drucker" data-pages="printers">
  <h2><i class="ti ti-printer"></i> Drucker</h2>
  <p>Unter <b>Navigation → Drucker</b> richtet ein Administrator Etiketten- und Netzwerkdrucker ein. Eingerichtete, aktive Drucker erscheinen danach in der Etiketten-Druckansicht unter <b>Direkt drucken</b> – ohne Druckdialog und ohne Skalierungsprobleme.</p>
  <ul>
    <li><b>Zebra ZT4xx</b> (ZT410/411/420/421) – im Netzwerk. PDH schickt die Etiketten als ZPL an Port 9100 und fragt den Druckerzustand ab.</li>
    <li><b>Dymo LabelWriter</b> – meist per USB am PC. Gedruckt wird über <b>DYMO Connect</b> auf dem PC, an dem du gerade sitzt.</li>
    <li><b>Netzwerkdrucker</b> – Büro- und Multifunktionsgeräte über IPP (empfohlen, mit Zustand und Tonerstand) oder RAW 9100, z. B. für Etiketten auf A4-Bögen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So richtest du einen Drucker ein</b>
    <ol class="hb-steps">
      <li><b>Navigation → Drucker</b>, beim passenden Typ auf <b>… hinzufügen</b>.</li>
      <li>Name und Standort eintragen. Zebra und Netzwerkdrucker: IP-Adresse (am besten fest vergeben). Zebra zusätzlich Etikettengröße, Auflösung (Typenschild, z. B. 203 dpi) und Material. Dymo: den Druckernamen genau wie in DYMO Connect und den Etikettentyp.</li>
      <li><b>Speichern</b>, dann <b>Prüfen</b>. Die Prüfung zeigt, ob der Drucker erreichbar ist, seinen Zustand (z. B. Papier oder Farbband leer, Kopf offen) und beim Netzwerkdrucker den Tonerstand.</li>
      <li><b>Testdruck</b> – passt das Etikett, ist der Drucker fertig.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-tag"></i> Dymo: an welchem PC?</b>Dymo-Drucker hängen am PC, nicht im Netz. „Prüfen“ und „Testdruck“ laufen deshalb an dem PC, an dem du die Seite geöffnet hast – dort muss DYMO Connect installiert sein und laufen. „Prüfen“ listet die angeschlossenen Dymo-Drucker mit ihrem genauen Namen.</div>
  <div class="hb-howto"><b><i class="ti ti-adjustments"></i> Druckbild stimmt nicht?</b>Zebra: blasser Druck → <b>Schwärzung</b> erhöhen; verschmiert → Schwärzung senken oder <b>Geschwindigkeit</b> verringern. Beides setzt PDH bei jedem Druck neu. Der Stern <i class="ti ti-star"></i> macht einen Drucker zum Standard seines Typs; ein Standard-Etikettendrucker (Zebra oder Dymo) ist in der Druckansicht vorausgewählt.</div>
  <p>Rechte: Einrichten und prüfen dürfen Personen mit <code>printers.manage</code> (Administratoren). Direkt drucken dürfen alle mit <code>printers.use</code> – das haben alle Rollen.</p>
  {{template "hb-shots" (dict "Ref" (index $s "printers") "Can" $can)}}
</section>

<section class="hb-ch" id="purchasing" data-title="Beschaffung, Kanban &amp; Einkauf" data-pages="procurement purchases purchase">
  <h2><i class="ti ti-shopping-cart"></i> Beschaffung, Kanban &amp; Einkauf</h2>
  {{template "hb-fig-purchase"}}
  <p>Unter <b>Material &amp; Anlagen → Beschaffung &amp; Einkauf</b> (auch über Core-Einstellungen) findest du die <b>Kanban-Tafel</b>, den <b>Bestellvorschlag</b>, die offenen <b>Bestellungen</b> und die <b>Rahmenverträge</b>.</p>
  <h3><i class="ti ti-layout-kanban"></i> Kanban</h3>
  <p>Mit Kanban wird ein Teil über eine feste Zahl <b>Karten</b> mit fester Menge nachbestellt – z. B. 2 Karten à 50 Stück (Zwei-Behälter-Prinzip). Jede Karte ist <span class="badge b-green">voll</span>, <span class="badge b-red">leer – zu bestellen</span> oder <span class="badge b-amber">bestellt</span>.</p>
  <div class="hb-howto"><b><i class="ti ti-toggle-right"></i> So aktivierst du Kanban für ein Teil</b>
    <ol class="hb-steps">
      <li>Ersatzteil öffnen → Reiter <b>Kanban</b>.</li>
      <li><b>Anzahl Karten</b>, <b>Menge je Karte</b>, Lieferzeit und den <b>Kanban-Lagerplatz</b> (dort wird geliefert) eintragen. Lieferant und <b>Rahmenvertrag</b> wählen, falls vorhanden.</li>
      <li><b>Kanban aktivieren</b>. PDH legt die Karten an – so viele voll, wie der Bestand hergibt.</li>
      <li><b>Karten drucken</b> und je eine an jeden Behälter hängen.</li>
    </ol>
    Mit „automatisch leer melden“ meldet PDH volle Karten selbst leer, sobald der Bestand nicht mehr für sie reicht. Ohne diesen Haken scannt man die Karte am leeren Behälter und tippt <b>Karte leer melden</b>. <b>Abschalten</b> stoppt den Kreislauf, Karten und Einstellungen bleiben.</div>
  <div class="hb-howto"><b><i class="ti ti-shopping-cart-check"></i> So bestellst du</b>
    <ol class="hb-steps">
      <li>Reiter <b>Bestellvorschlag</b>: Leere Karten stehen dort nach Lieferant – mit Menge, Vertragspreis und Wert. Mit <b>E-Mail</b> öffnet sich eine fertige Bestellung an den Lieferanten.</li>
      <li>Positionen auswählen, <b>Bestellnummer</b> und ggf. Liefertermin eintragen – <b>Als bestellt melden</b>. Ohne Termin rechnet PDH mit der Lieferzeit.</li>
      <li>Kommt die Ware: im Reiter <b>Bestellungen</b> auf <b>Geliefert</b>, die Kanban-Karte scannen oder die Ware ganz normal einbuchen. Die Karte ist wieder voll, die Menge am Kanban-Lagerplatz gebucht.</li>
    </ol>
    Überfällige Bestellungen sind rot markiert. Teile ohne Kanban stehen weiter unter „Unter Mindestbestand“ und im täglichen Bestellvorschlag per E-Mail – Kanban-Teile nicht, die bestellt der Kreislauf.</div>
  <h3><i class="ti ti-file-certificate"></i> Rahmenverträge</h3>
  <p>Reiter <b>Rahmenverträge</b> → <b>Neuer Rahmenvertrag</b>: Vertragsnummer, Lieferant, Laufzeit und ggf. Vertragsvolumen. Danach die <b>Positionen</b> mit Teilenummer, Vertragspreis und Rahmenmenge. Ein Kanban-Regelkreis mit Vertrag bestellt zum Vertragspreis und zählt die abgerufene Menge hoch. Der Status zeigt <b>läuft bald ab</b> (unter 31 Tagen), <b>abgelaufen</b> und <b>(fast) ausgeschöpft</b>.</p>
  <h3><i class="ti ti-mail"></i> Täglicher Bestellvorschlag</h3>
  <p>Sinkt der Bestand eines Teils ohne Kanban auf oder unter den Mindestbestand, erscheint es im <b>Bestellvorschlag</b> (Ersatzteile → Bestellvorschlag) – sortiert nach Einkäufer und Lieferant, mit Menge und Wert. Jeder Einkäufer bekommt ihn zusätzlich jeden Morgen per E-Mail.</p>
  <ul>
    <li>Den <b>Einkäufer</b> legst du im Teil fest (Reiter Lieferanten &amp; Einkauf).</li>
    <li>Die Menge ist die Nachbestellmenge, aufgerundet auf die Mindestabnahme des Lieferanten.</li>
    <li>Gesperrte Lieferanten werden übersprungen.</li>
  </ul>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Beschaffung“): <b>ansehen</b>, <b>Kanban-Regelkreise einrichten</b>, <b>bestellen</b> und <b>Rahmenverträge pflegen</b> lassen sich je Rolle getrennt vergeben.</p>
  {{template "hb-shots" (dict "Ref" (index $s "purchasing") "Can" $can)}}
  <h3><i class="ti ti-truck-delivery"></i> Bestellvorgänge</h3>
  <p>Ein <b>Bestellvorgang</b> begleitet eine Bestellung bei einem Lieferanten durch fünf Schritte: <b>Angebot → Bestellung → Auftragsbestätigung (AB) → Lieferung → Rechnung OK</b>. Oben siehst du, wo der Vorgang steht; gelb markiert PDH Abweichungen.</p>
  <div class="hb-howto"><b><i class="ti ti-shopping-cart"></i> So führst du einen Bestellvorgang</b> (Recht „Bestellvorgänge anlegen und bearbeiten“)
    <ol class="hb-steps">
      <li>Navigation → <b>Bestellvorgänge</b> → Lieferant wählen, kurz beschreiben, <b>Anlegen</b>.</li>
      <li><b>Positionen</b>: Ersatzteil-Nummer eintippen (Vorschlagsliste) – Bezeichnung und Einheit kommen aus dem Teil. Freie Positionen ohne Ersatzteil gehen auch.</li>
      <li><b>Angebot</b>: Angebotsnummer, Datum und je Position Menge und Preis eintragen, <b>Speichern</b>.</li>
      <li><b>Angebot → Bestellung</b> übernimmt Mengen und Preise; anpassen, dann <b>Als bestellt markieren</b>. Ohne eigene Bestellnummer gilt die Vorgangsnummer.</li>
      <li><b>Auftragsbestätigung</b>: AB-Nummer, Datum, Liefertermin und je Position AB-Menge und -Preis eintragen – oder <b>AB wie Bestellung</b>, wenn alles passt. Weicht die AB ab (Menge, Preis, Termin nach Wunschtermin), steht es gelb daneben und in der Historie.</li>
      <li><b>Lieferung</b>: Lieferschein-Nr. eintragen, je Position die gelieferte Menge und den Lagerort, <b>Wareneingang buchen</b>. Weniger als bestellt = Teillieferung; der Rest bleibt offen. Die Menge wird ins Lager gebucht, volle Kanban-Karten werden zurückgesetzt. Mehr als laut AB meldet PDH als Überlieferung.</li>
      <li><b>Rechnung OK – Vorgang abschließen</b>. Die Rechnung wird in <b>ELO</b> bearbeitet – das Feld für die Rechnungs- oder ELO-Nummer darf leer bleiben (Recht „Rechnung OK setzen“).</li>
    </ol>
    Den Vorgang findest du auch beim <b>Ersatzteil</b> (Reiter Lieferanten &amp; Einkauf) und beim <b>Lieferanten</b> (Reiter Bestellungen). Dokumente (Angebot, AB, Lieferschein) hängst du unten an. Stornieren geht jederzeit; endgültig löschen nur der Bereichsadministrator Beschaffung – gebuchte Lagerbewegungen bleiben dann erhalten.</div>
</section>

<section class="hb-ch" id="partners" data-title="Hersteller &amp; Lieferanten" data-pages="directory">
  <h2><i class="ti ti-building-factory-2"></i> Hersteller &amp; Lieferanten</h2>
  <p>Hier stehen alle Firmen, mit denen ihr arbeitet – mit Ansprechpartnern, Telefonnummern und Verträgen.</p>
  <ul>
    <li><b>Übersicht</b> – alle Nummern auf einen Blick: Zentrale, <b>Support-Hotline</b> (mit Zeiten), Service, <b>Ersatzteile</b>, Notfall.</li>
    <li><b>Portale &amp; Shop</b> – Links zu Kundenportalen und Onlineshops. Mit „Einbetten“ öffnen sie sich im PDH. Hinterlegte Zugangsdaten sieht nur, wer die Berechtigung hat.</li>
    <li><b>Anlagen, Ersatzteile, IT</b> – wofür die Firma Hersteller, Lieferant oder Servicepartner ist.</li>
    <li><b>Vorgänge</b> – wo die Firma als externe Firma beteiligt ist.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-phone"></i> Schnell die richtige Nummer finden</b>
    Firma öffnen → <b>Übersicht</b> → Karte „Erreichbarkeit“. Für Ersatzteile gibt es eine eigene Telefonnummer und E-Mail.</div>
  {{template "hb-shots" (dict "Ref" (index $s "partners") "Can" $can)}}
</section>

<section class="hb-ch" id="chat" data-title="Chat &amp; Teams" data-pages="chat">
  <h2><i class="ti ti-messages"></i> Chat &amp; Teams</h2>
  {{template "hb-fig-chat"}}
  <p>Chatten kannst du auf jeder Seite über den <b>Chat-Reiter</b> rechts. Kommt eine neue Nachricht, öffnet sich die Leiste von selbst – außer du tippst gerade etwas oder hast den Chat stummgeschaltet.</p>
  <ul>
    <li><b>Chats</b> – mit einer Person oder einer Gruppe. <b>Teams</b> haben Kanäle mit Beiträgen und Antworten.</li>
    <li><b>@Name</b> erwähnt jemanden, <kbd>Enter</kbd> sendet, <kbd>Shift</kbd>+<kbd>Enter</kbd> macht eine neue Zeile, <kbd>↑</kbd> bearbeitet deine letzte Nachricht.</li>
    <li>Dateien und Fotos per Büroklammer oder einfach ins Fenster ziehen.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-share"></i> Eine Seite mit Kollegen teilen</b>
    <ol class="hb-steps">
      <li>Auf der Seite (z. B. einer Störung) oben <b>Im Chat teilen</b> klicken.</li>
      <li>Rechts die Unterhaltung wählen – Titel und Link sind schon eingetragen.</li>
      <li>Absenden. Die anderen sehen eine Karte, die den Datensatz öffnet.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-trash"></i> So löschst du eine Nachricht</b>
    <ol class="hb-steps">
      <li>Am Rechner mit der Maus über die Nachricht fahren, am Handy die Nachricht antippen.</li>
      <li>Das <b>Papierkorb</b>-Symbol wählen und die Rückfrage bestätigen.</li>
      <li>Die Nachricht erscheint für alle als „Nachricht gelöscht“; Dateien und Reaktionen daran sind weg.</li>
    </ol>
    Eigene Nachrichten darf jeder löschen, Chat-Administratoren alle. Das geht im Chat-Reiter rechts genauso wie auf der Chat-Seite.</div>
  <h3><i class="ti ti-bell"></i> Hinweise von „Service“</h3>
  <p><b>Beim Anlegen</b> eines Tickets, einer Störung, einer Aufgabe, eines Projekts, einer Wartung oder eines KVP-Vorschlags bestätigt „Service“ dir das im Chat. Die Nachricht nennt, wer zuständig ist oder an welche Broker der Vorgang ging. Wer als Zuständige/r, Verantwortliche/r oder über eine Gruppe eingetragen wurde, bekommt „Neu für dich“. Aus Wartungsplänen automatisch erzeugte Aufträge melden sich nicht.</p>
  <p>Ändert jemand ein <b>Ticket</b>, eine <b>Störung</b>, eine <b>Aufgabe</b>, ein <b>Projekt</b> oder eine <b>Wartung</b>, schickt der Absender <b>Service</b> (mit dem PDH-Logo) einen kurzen Hinweis an alle Beteiligten: Ersteller/in, Verantwortliche/n und Zugewiesene. Wer die Änderung selbst gemacht hat, bekommt keinen Hinweis. Der Hinweis nennt, was sich geändert hat (z. B. „Status: offen → in Arbeit“, neuer Kommentar) und enthält eine Karte zum Vorgang. Mehrere Änderungen kurz hintereinander werden zu einer Nachricht zusammengefasst.</p>
  <p>Die Hinweise sind nur zur Information – auf „Service“ zu antworten ist nicht nötig. Abschalten kannst du sie unter <b>Mein Konto → Konto &amp; Dienste</b>. „Service“ informiert Administratoren außerdem über <a href="#cleanup">Bereinigungsläufe</a> und <a href="#backup">Datensicherungen</a>.</p>
  {{template "hb-shots" (dict "Ref" (index $s "chat") "Can" $can)}}
</section>

<section class="hb-ch" id="time" data-title="Zeiterfassung" data-pages="time">
  <h2><i class="ti ti-clock"></i> Zeiterfassung</h2>
  <p>In Störungen, Tickets und Aufgaben startest und stoppst du deine Zeit mit <b>Zeit erfassen</b>; bei Wartungen fragt der Assistent die Zeit ab. Vergessene Zeiten trägst du in der Zeiterfassung nach. Schichten, Urlaub und Wartungstermine plant der <a href="#planner">Planer</a>.</p>
  <div class="hb-howto"><b><i class="ti ti-clock-exclamation" style="color:var(--amber)"></i> So bestätigst du Zeiten, die Kollegen für dich eingetragen haben</b>
    <ol class="hb-steps">
      <li>Hat dich jemand beim Abschluss eines Vorgangs als „dabei“ eingetragen, bekommst du einen Chat-Hinweis von „Service“.</li>
      <li>In der <b>Zeiterfassung</b> steht oben die gelbe Karte <b>Zu bestätigen</b>; in der Liste ist der Eintrag gelb hinterlegt.</li>
      <li>Stimmt die Zeit: grüner Haken <b>Bestätigen</b>. Passt sie nicht: <i class="ti ti-edit"></i> korrigieren und dann bestätigen. Warst du nicht dabei: <i class="ti ti-trash"></i> löschen.</li>
    </ol>
    Unbestätigte Zeiten zählen noch nicht – weder in den Wochen- und Monatssummen noch im Export.</div>
  <p><i class="ti ti-tool"></i> <b>Tätigkeit</b>: Beim Starten, beim manuellen Erfassen und beim Bearbeiten wählst du optional eine Tätigkeit (z. B. Rüsten, Reinigung). Die Zeit zählt dann auf die Kostenstelle der Tätigkeit; in der Liste steht die Tätigkeit unter der Beschreibung. Die Tätigkeiten pflegt die Verwaltung unter <a href="#costcenters">Kostenstellen</a>.</p>
  {{template "hb-shots" (dict "Ref" (index $s "time") "Can" $can)}}
</section>

<section class="hb-ch" id="planner" data-title="Planer: Schichten, Urlaub &amp; Wartung" data-pages="planner">
  <h2><i class="ti ti-calendar-time"></i> Planer: Schichten, Urlaub &amp; Wartung</h2>
  <p>Unter <b>Instandhaltung → Planer</b> planst du Schichten, Urlaub und Wartungstermine an einer Stelle. Feiertage (Bundesland in den Einstellungen) und Betriebsruhe sind überall markiert.</p>
  <h3><i class="ti ti-calendar-week"></i> Schichtplan</h3>
  <p>Eine Woche: oben die Tage, links die Schichten des Schichtmodells. Das Modell wählst du rechts. In jedem Feld stehen die eingeteilten Mitarbeiter. Ein rot umrandetes Feld hat weniger Leute als die Mindestbesetzung.</p>
  <div class="hb-howto"><b><i class="ti ti-hand-click"></i> So teilst du Mitarbeiter ein</b>
    <ol class="hb-steps">
      <li>Woche mit den Pfeilen wählen, rechts das <b>Schichtmodell</b>.</li>
      <li>Auf das Feld klicken (Schicht × Tag). Die Liste zeigt alle Mitarbeiter: wer Urlaub hat (rot) und wer schon in einer anderen Schicht steht (gelb).</li>
      <li>Haken setzen oder entfernen – <b>Übernehmen</b>. Wer schon in einer anderen Schicht steht, wechselt in diese.</li>
    </ol>
    <b>Vorwoche übernehmen</b> kopiert die Einteilung der Vorwoche – vorhandene Einträge und Urlaubstage bleiben. Mit Abteilung und Gruppe oben filterst du die Anzeige.</div>
  <div class="hb-howto"><b><i class="ti ti-hand-move"></i> So ziehst du Einteilungen</b>
    <ol class="hb-steps">
      <li><b>Verschieben:</b> einen Namen anfassen und auf einen anderen Tag oder in eine andere Schicht ziehen.</li>
      <li><b>Kopieren:</b> dabei <b>Strg</b> drücken – am Tablet vorher unten <b>Kopieren</b> einschalten.</li>
      <li><b>Über mehrere Tage:</b> den Namen am <b>rechten Rand</b> anfassen und bis zum letzten Tag ziehen – z. B. Montag einteilen und bis Freitag durchziehen; die Person steht dann jeden Tag in dieser Schicht.</li>
    </ol>
    Tage mit genehmigtem Urlaub und Tage, an denen die Person schon eine andere Schicht hat, überspringt PDH und sagt es dir. Unten bei <b>Feldhöhe</b> stellst du ein, wie hoch die Namensfelder sind (Klein bis Sehr groß oder Automatisch) – dein Browser merkt es sich.</div>
  <h3><i class="ti ti-star"></i> Sonderdienste, Bereitschaft &amp; Zusatzaufgaben</h3>
  <p>Unter den Schichten stehen die <b>Sonderdienste</b>, z. B. Rufbereitschaft, Ersthelfer oder eine Zusatzaufgabe. Sie gelten zusätzlich zur Schicht; eine Person kann an einem Tag mehrere haben. Einteilen, Ziehen und Verlängern geht wie bei den Schichten.</p>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> So legst du eine Dienstart an</b> (Recht „Sonderdienste einteilen“)
    <ol class="hb-steps">
      <li>Planer → <b>Einstellungen</b> → <b>Sonderdienste, Bereitschaft &amp; Zusatzaufgaben</b>.</li>
      <li>Name, Kürzel, Art (Bereitschaft, besondere Tätigkeit, Zusatzaufgabe), Farbe und ggf. Mindestbesetzung eintragen.</li>
      <li>Bei <b>Nötige Qualifikation</b> eine Qualifikation aus dem Personalstamm wählen (z. B. „Ersthelfer“, „Elektrofachkraft“). Dann bietet der Schichtplan nur Personen an, die diesen Nachweis haben und deren Nachweis am Tag noch gilt.</li>
      <li>Haken bei <i class="ti ti-phone"></i> <b>Telefon</b>: Bei der Einteilung steht die Telefonnummer der Person mit dabei – dienstliches Handy, sonst Durchwahl, sonst Telefon aus dem Benutzer. Ideal für Rufbereitschaft; sichtbar im Schichtplan, Kalender, Schichtplan-Widget und Leitstand.</li>
      <li><b>Anlegen</b>. Löschen geht nur ohne Einteilungen – sonst wird die Dienstart abgeschaltet.</li>
    </ol>
    Die Qualifikationen pflegst du je Person unter <b>Benutzer → Nachweise</b>.</div>
  <h3><i class="ti ti-beach"></i> Urlaub &amp; Abwesenheit</h3>
  <div class="hb-howto"><b><i class="ti ti-send"></i> So beantragst du Urlaub</b>
    <ol class="hb-steps">
      <li>Reiter <b>Urlaub &amp; Abwesenheit</b> → Art, von, bis, ggf. halber erster oder letzter Tag und Vertretung.</li>
      <li><b>Absenden</b>. Deine Führungskraft (sonst alle mit Genehmigungsrecht) bekommt eine Nachricht.</li>
      <li>Du wirst über die Entscheidung benachrichtigt. Oben siehst du Anspruch, genommen, beantragt und Rest.</li>
    </ol>
    Gezählt werden Arbeitstage Mo–Fr ohne Feiertage und Betriebsruhe. Krankmeldungen gelten sofort. Beantragte Einträge kannst du selbst stornieren.</div>
  <p>Wer genehmigt, sieht <b>Offene Anträge</b> mit Hinweisen: eingeteilte Schichten im Zeitraum und Kollegen der Abteilung, die gleichzeitig fehlen. Beim Genehmigen können die Schichten im Zeitraum gleich entfernt werden. Darunter: Teamkalender je Monat und die <b>Urlaubsansprüche</b> je Person (Anspruch und Übertrag). Ohne das Recht „Abwesenheitsgrund aller sehen“ zeigt PDH bei Kollegen nur „abwesend“.</p>
  <h3><i class="ti ti-tool"></i> Wartungsplanung</h3>
  <p>Monatskalender mit offenen Wartungen und Prüfpflichten. Je Tag steht, wie viele Leute im Dienst sind (<i class="ti ti-users"></i>) und wie viele Stunden Wartung geplant sind. <span style="color:var(--red)">Rot</span>: Die zugewiesene Person ist abwesend. <span style="color:var(--amber)">Gelb</span>: Sie hat an dem Tag keine Schicht oder niemand ist zugewiesen. Ein Klick öffnet den Dialog zum <b>Verschieben</b> und <b>Zuweisen</b> – oben in der Auswahl stehen die Leute, die an dem Tag Dienst haben.</p>
  <h3><i class="ti ti-template"></i> Schichtmodelle &amp; Vorlagen</h3>
  <div class="hb-howto"><b><i class="ti ti-wand"></i> So legst du ein Schichtmodell aus einer Vorlage an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Schichtmodelle &amp; Vorlagen</b> → Vorlage wählen, z. B. <b>3-Schicht</b>, <b>4-Schicht Kontischicht</b> oder <b>12-Stunden Tag/Nacht</b> – <b>Übernehmen</b>.</li>
      <li>PDH legt die Schichten (Zeiten, Farben) und das Rotationsmuster mit Mannschaften an. Zeiten, Mindestbesetzung und Pausen kannst du danach ändern.</li>
      <li>Unter <b>Plan erzeugen</b> Zeitraum wählen, Mitarbeiter anhaken und jeder eine <b>Mannschaft</b> (M1, M2 …) geben – <b>Plan erzeugen</b>.</li>
      <li>Der Plan ist zuerst ein <b>Entwurf</b> (gestrichelt, nur für Planende sichtbar). Passt er, unten <b>Veröffentlichen</b>.</li>
    </ol>
    Ein Rotationsmuster legt für jeden Tag des Zyklus die Schicht fest. Mannschaft 2 läuft um den Versatz verschoben, Mannschaft 3 um den doppelten. Vorhandene Einteilungen und genehmigter Urlaub werden beim Erzeugen nie überschrieben.</div>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Schichtplanung“): <b>Planer ansehen</b>, <b>Schichten planen</b>, <b>eigene Abwesenheit beantragen</b>, <b>Abwesenheiten genehmigen</b>, <b>Abwesenheitsgrund aller sehen</b>. Verschieben und Zuweisen von Wartungen braucht „Wartung bearbeiten“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "planner") "Can" $can)}}
</section>

<section class="hb-ch" id="calendar" data-title="Kalender" data-pages="calendar">
  <h2><i class="ti ti-calendar-event"></i> Kalender</h2>
  <p>Unter <b>Instandhaltung → Kalender</b> siehst du auf einen Blick, wer wann was hat: je Mitarbeiter eine Zeile, je Tag eine Spalte – Urlaub und Abwesenheit, Schichten, fällige Wartungen, Prüfpflichten, Tickets, Störungen, Aufgaben und laufende Projekte (als Balken). Vorgänge stehen bei der zugewiesenen Person (Aufgaben bei allen Zuständigen), sonst bei der verantwortlichen; ohne beides unten in <b>Ohne Person</b>. Vorgänge stehen am Tag ihrer Fälligkeit, ohne Fälligkeit am Tag ihrer Anlage. Überfällige (mit ⚠) und ältere ohne Fälligkeit stehen in der Spalte <b>heute</b>, solange sie offen sind.</p>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So stellst du den Kalender ein</b>
    <ol class="hb-steps">
      <li>Zeitraum: Der Kalender zeigt immer <b>ganze Wochen ab Montag</b> (Standard 2 Wochen) mit der <b>Kalenderwoche</b> oben. Mit den Pfeilen blätterst du, oben wählst du Start und Länge (1 bis 6 Wochen); <b>Diese Woche</b> springt zurück.</li>
      <li>Was angezeigt wird: die runden Schalter (Urlaub, Schichten, Wartungen …) an- oder abwählen. Die Zahl daneben zeigt, wie viele Einträge es gibt.</li>
      <li>Wen: Abteilung, Gruppe oder eine Person wählen. „nur Personen mit Einträgen“ blendet leere Zeilen aus.</li>
    </ol>
    PDH merkt sich deine Auswahl. <i class="ti ti-restore"></i> setzt sie zurück. Ein Klick auf einen Eintrag öffnet ihn.</div>
  <p><span style="box-shadow:inset 0 0 0 2px var(--red);padding:0 6px;border-radius:3px">Rot umrandet</span> sind <b>Überschneidungen</b>: Die Person ist abwesend (genehmigt oder beantragt), hat am selben Tag aber eine Schicht oder einen fälligen Auftrag. <span style="box-shadow:inset 0 0 0 2px var(--amber);padding:0 6px;border-radius:3px">Gelb</span>: ein fälliger Auftrag an einem Tag, an dem die Person keine Schicht hat. Den Grund zeigt der Hinweis beim Darüberfahren. Ohne das Recht „Abwesenheitsgrund aller sehen“ steht bei Kollegen nur „abwesend“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "calendar") "Can" $can)}}
  <div class="hb-howto"><b><i class="ti ti-hand-move"></i> So änderst du im Kalender per Ziehen</b>
    <ol class="hb-steps">
      <li><b>Schicht oder Sonderdienst</b> auf einen anderen Tag oder zu einer anderen Person ziehen (Strg bzw. <b>Kopieren</b> = kopieren). Am rechten Rand gezogen gilt sie an jedem Tag bis dorthin.</li>
      <li><b>Urlaub/Abwesenheit</b> am rechten Rand ziehen: nach rechts verlängern, nach links verkürzen, vor den Beginn = früher anfangen. Die Urlaubstage werden neu gezählt. Das dürfen Genehmigende – und du selbst, solange dein Antrag noch nicht genehmigt ist.</li>
      <li><b>Störung, Ticket, Aufgabe oder Wartung</b> auf einen anderen Tag ziehen: die Fälligkeit wird auf diesen Tag gelegt (die Uhrzeit bleibt) und steht in der Historie.</li>
    </ol>
    Ziehen geht nur mit dem passenden Recht (Schichten planen, Sonderdienste einteilen, Abwesenheiten genehmigen bzw. den Vorgang bearbeiten). Derselbe Kalender steht auch als Baustein <b>Kalender</b> im Leitstand – mit Auswahl oben im Baustein.</div>
  <p><b>Projekte</b> stehen ganz oben – je Projekt eine Zeile mit einem durchgehenden Balken von Beginn bis Ende, unabhängig von Personen.</p>
</section>

<section class="hb-ch" id="ms" data-title="Managementsysteme" data-pages="ms ms-doc ms-handbook ms-process ms-instruction ms-form">
  <h2><i class="ti ti-certificate-2"></i> Managementsysteme</h2>
  <p>Unter <b>Managementsysteme</b> in der Navigation stehen eure gelenkten Dokumente: <b>Handbücher</b>, <b>Prozessbeschreibungen</b>, <b>Verfahrens-</b> und <b>Arbeitsanweisungen</b>, <b>Formblätter &amp; Vorlagen</b> sowie <b>Leitlinien</b> – je Managementsystem (Qualität ISO 9001, Umwelt 14001, Arbeitsschutz 45001, Energie 50001, Informationssicherheit 27001, integriertes System). Gültig ist immer die <b>freigegebene Fassung</b>. Ältere Fassungen bleiben mit Änderungsgrund und Freigabe erhalten.</p>
  <div class="hb-howto"><b><i class="ti ti-file-plus"></i> So legst du ein Dokument an und gibst es frei</b>
    <ol class="hb-steps">
      <li><b>Neues Dokument</b> → Art, Managementsystem und Titel. Die Nummer vergibt PDH (z. B. <b>QM-PB-004</b>), das Dokument startet als <b>Entwurf</b> mit passender Gliederung (z. B. Zweck, Geltungsbereich, Verantwortlichkeiten, Ablauf).</li>
      <li>Reiter <b>Bearbeiten &amp; Freigabe</b>: Inhalt schreiben – rechts steht die Vorschau. <code>## Überschrift</code>, <code>- Liste</code>, <code>1. Schritt</code>, <code>**fett**</code>, Tabellen mit <code>| Spalte | Spalte |</code>. Normbezug und <b>Änderungsgrund</b> eintragen, <b>Speichern</b>.</li>
      <li><b>Zur Prüfung geben</b> – alle mit Freigaberecht bekommen eine Nachricht.</li>
      <li>Die prüfende Person liest und <b>gibt frei</b> oder schickt es mit Anmerkung <b>zur Überarbeitung zurück</b>. Die eigene Fassung kann niemand selbst freigeben (Vier-Augen-Prinzip).</li>
    </ol>
    Ändern heißt immer: <b>Neue Fassung beginnen</b>. Sie startet mit dem gültigen Inhalt; bis zur Freigabe bleibt die alte Fassung gültig. Vorlagen, Original-Dateien oder Prozessgrafiken hängst du unter <b>Dateien</b> an.</div>
  <div class="hb-howto"><b><i class="ti ti-eye-check"></i> Kenntnisnahme und Überprüfung</b>
    Unter <b>Stammdaten</b> legst du fest, wer die Fassung lesen muss (<b>alle</b> oder eine <b>Abteilung</b>) und alle wie viele Monate das Dokument überprüft wird. Nach jeder Freigabe bekommen die Betroffenen eine Nachricht; oben im Dokument steht <b>Gelesen und verstanden</b>. Der Reiter <b>Kenntnisnahme</b> zeigt, wer schon bestätigt hat. Ist die Überprüfung fällig, ist das Dokument in der Liste rot markiert – prüfen und eine neue Fassung freigeben lassen (auch ohne inhaltliche Änderung, Grund „Überprüft“). <b>Mitgeltende Dokumente</b> verknüpfst du ebenfalls in den Stammdaten.</div>
  <p>Rechte (Rollen &amp; Rechte, Gruppe „Managementsysteme“): <b>lesen</b> (alle), <b>anlegen und bearbeiten</b>, <b>prüfen, freigeben und zurückziehen</b>, <b>Systeme verwalten</b> (Knopf <b>Systeme</b>: eigene Systeme wie Lebensmittelsicherheit ergänzen). Wer nur lesen darf, sieht ausschließlich freigegebene Dokumente.</p>
  {{template "hb-shots" (dict "Ref" (index $s "ms") "Can" $can)}}
</section>

<section class="hb-ch" id="costcenters" data-title="Kostenstellen &amp; Tätigkeiten" data-pages="costcenters">
  <h2><i class="ti ti-building-bank"></i> Kostenstellen &amp; Tätigkeiten</h2>
  <p>Unter <b>Navigation → Kostenstellen</b> (oder Core-Einstellungen → Kostenstellen &amp; Tätigkeiten) pflegst du Kostenstellen, ihre Unterstellen und die Tätigkeiten für die Zeiterfassung. Dafür brauchst du das Recht <i>Kostenstellen, Unterstellen &amp; Tätigkeiten verwalten</i>.</p>
  <p>Das <b>Dashboard</b> zeigt für das gewählte Jahr: Anzahl der Kostenstellen und Tätigkeiten, die gebuchten Stunden, die Stunden je Kostenstelle und je Tätigkeit sowie offene Tickets und Störungen je Kostenstelle. Unterstellen zählen bei ihrer Hauptkostenstelle mit.</p>
  <div class="hb-howto"><b><i class="ti ti-building-bank"></i> So legst du eine Unterstelle an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Kostenstellen</b> → <b>Kostenstelle oder Unterstelle anlegen</b>.</li>
      <li>Nummer und Name eintragen, z. B. „4110“ und „Elektrowerkstatt“.</li>
      <li>Bei <b>Gehört zu</b> die Hauptkostenstelle wählen, z. B. „4100 Instandhaltung“. Leer lassen = Hauptkostenstelle.</li>
      <li>Optional Verantwortliche/n und Beschreibung, dann <b>Anlegen</b>.</li>
    </ol>
    Eine Unterstelle gehört immer direkt zu einer Hauptkostenstelle. Wer eine Hauptkostenstelle deaktiviert, deaktiviert ihre Unterstellen mit.</div>
  <div class="hb-howto"><b><i class="ti ti-tool"></i> So legst du Tätigkeiten an</b>
    <ol class="hb-steps">
      <li>Reiter <b>Tätigkeiten</b> → <b>Tätigkeit anlegen</b>.</li>
      <li>Name eintragen (z. B. „Rüsten“), optional eine Nummer.</li>
      <li><b>Kostenstelle</b>: leer = die Tätigkeit gilt für alle. Mit Kostenstelle wird jede Zeit mit dieser Tätigkeit dort gebucht.</li>
      <li>Mit <i class="ti ti-chevron-up"></i>/<i class="ti ti-chevron-down"></i> die Reihenfolge in der Zeiterfassung festlegen; <i class="ti ti-eye-off"></i> blendet eine Tätigkeit aus, ohne gebuchte Zeiten zu verlieren.</li>
    </ol></div>
  <p>Auf welche Kostenstelle eine Zeit zählt: zuerst die der Tätigkeit, sonst die der gebuchten Anlage.</p>
  {{template "hb-shots" (dict "Ref" (index $s "costcenters") "Can" $can)}}
</section>

<section class="hb-ch" id="users" data-title="Benutzer &amp; Mein Konto" data-pages="users account orgchart org_units">
  <h2><i class="ti ti-users"></i> Benutzer &amp; Mein Konto</h2>
  <div class="hb-howto"><b><i class="ti ti-user-circle"></i> So stellst du dein Profilbild ein</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> (oder im eigenen Benutzerstamm auf das runde Bild oben links).</li>
      <li>Auf das runde Bild tippen <i class="ti ti-camera"></i> und ein Foto wählen – am Handy geht auch direkt die Kamera. JPG, PNG oder GIF, höchstens 8 MB.</li>
      <li>Fertig: Das Bild wird quadratisch zugeschnitten und erscheint im Chat, in der Kopfleiste, in der Benutzerliste, im Organigramm und bei „Aktivität“. <b>×</b> am Bild entfernt es wieder; dann stehen wieder die Initialen da.</li>
    </ol>
    Mit dem Recht <i>Benutzer verwalten</i> kannst du im Benutzerstamm auch das Bild anderer Personen setzen oder entfernen. Beim Speichern entfernt PDH Zusatzdaten aus dem Foto (z. B. den Aufnahmeort).</div>
  <p><i class="ti ti-bell-ringing"></i> Unter <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> schaltest du auch <a href="#push">Push-Alarme aufs Handy</a> ein.</p>
  <div class="hb-howto"><b><i class="ti ti-user-cog"></i> Eigene Daten pflegen</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b>.</li>
      <li>Reiter <b>Privat</b>: Anschrift, private Telefonnummer, Notfallkontakt – das sehen nur du und berechtigte Personen.</li>
      <li>Reiter <b>Nachweise</b>: Führerschein, Qualifikationen und Lehrgänge mit Ablaufdatum – das PDH warnt 60 Tage vorher.</li>
      <li>Reiter <b>Konto &amp; Dienste</b>: Chat-Hinweise zu Änderungen an deinen Vorgängen ein- oder ausschalten, Passwort und verbundene Dienste.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-key"></i> So änderst du dein Passwort</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b>.</li>
      <li>In der Karte <b>Passwort ändern</b> das aktuelle Passwort und zweimal das neue eingeben. Unter dem Feld steht, was das Passwort braucht (Richtlinie, siehe unten).</li>
      <li><b>Passwort speichern</b>. Ab der nächsten Anmeldung gilt das neue Passwort.</li>
    </ol>
    Meldest du dich bisher nur per Karte oder Microsoft an, heißt die Karte <b>Passwort festlegen</b> – dann ist kein aktuelles Passwort nötig.</div>
  <div class="hb-howto"><b><i class="ti ti-password"></i> Passwort ändern müssen</b>In diesen Fällen fragt PDH bei der Anmeldung mit Passwort zuerst nach einem neuen Passwort:
    <ul>
      <li><b>Erstanmeldung</b> – ein Administrator hat dein Konto mit einem Passwort angelegt.</li>
      <li>Ein Administrator hat dein Passwort im <b>Benutzerstamm</b> geändert oder den Wechsel verlangt.</li>
      <li>Dein Passwort ist <b>abgelaufen</b> (Höchstalter der Richtlinie).</li>
    </ul>
    <ol class="hb-steps">
      <li>Wie gewohnt mit Benutzername und Passwort anmelden.</li>
      <li>Es erscheint <b>Passwort ändern</b>. Zweimal das neue Passwort eingeben – es muss sich vom bisherigen unterscheiden und die angezeigten Regeln erfüllen.</li>
      <li><b>Passwort speichern</b> – du bist angemeldet und landest dort, wo du hinwolltest.</li>
    </ol>
    Bis dahin gibt es keine Anmeldung, auch nicht über die Schnittstelle oder die Override-Anmeldung am Terminal. Für die Seite hast du 15 Minuten, sonst einfach neu anmelden. Karte, Microsoft und Nextcloud funktionieren weiter; Systembenutzer (Terminals) sind ausgenommen.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud-plus"></i> Für Administratoren: Nextcloud-Konto anlegen</b>
    <ol class="hb-steps">
      <li>Im <b>Benutzerstamm</b> die Person öffnen, Reiter <b>Stammdaten</b>.</li>
      <li>Beim Feld <b>Nextcloud-Benutzer</b> auf <b>Nextcloud-Konto anlegen</b> tippen und bestätigen.</li>
      <li>PDH legt in Nextcloud ein Konto mit dem Benutzernamen, Namen und der E-Mail der Person an und trägt es ins Feld ein. Das <b>Startpasswort</b> steht einmalig daneben – an die Person weitergeben, sie ändert es in Nextcloud.</li>
    </ol>
    Den Knopf gibt es nur, wenn unter <a href="#server">Server-Einstellungen → Nextcloud</a> Adresse und Zugang eingetragen sind und die Person noch kein Nextcloud-Konto hat. Der dort eingetragene Nextcloud-Benutzer braucht Admin-Rechte in Nextcloud. Gibt es das Konto in Nextcloud schon, wird es nur verknüpft.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> Für Administratoren: Nextcloud mit Microsoft 365</b>
    <ol class="hb-steps">
      <li><b>Einmalig in Nextcloud:</b> <b>Core-Einstellungen → Microsoft 365</b> → Karte <b>Nextcloud</b> → <b>In Nextcloud einrichten</b>. PDH nimmt Tenant, Client-ID und Secret aus den Server-Einstellungen. Danach zeigt die Nextcloud-Anmeldung den Knopf <b>Mit Microsoft anmelden</b>. Das braucht den Update-Agenten und Nextcloud auf demselben Server; sonst auf dem Nextcloud-Server <code>sudo bash scripts/configure-nextcloud-microsoft-login.sh</code> ausführen.</li>
      <li><b>Einmalig in Entra:</b> In der App-Registrierung die Redirect-URI eintragen, die die Karte anzeigt (<code>…/apps/user_oidc/code</code>). Unter <b>Tokenkonfiguration</b> den optionalen Anspruch <b>email</b> fürs ID-Token hinzufügen.</li>
      <li><b>Core-Einstellungen → Microsoft 365</b> → Karte <b>Nextcloud</b>: <b>Nextcloud-Konten anlegen</b> anhaken.</li>
      <li><b>Jetzt abgleichen</b>. Jede zugeordnete Person ohne Nextcloud-Konto bekommt eines. Die Meldung oben zeigt, wie viele.</li>
    </ol>
    Die Nextcloud-Benutzer-ID ist dann die Microsoft-E-Mail. So findet die Microsoft-Anmeldung das Konto, und es braucht kein Startpasswort. Auch der Knopf <b>Nextcloud-Konto anlegen</b> im Benutzerstamm nimmt dann die Microsoft-E-Mail. Vorhandene Nextcloud-Konten bleiben, wie sie sind. In Microsoft deaktivierte Personen und Gastkonten bekommen kein Konto. Wer in Nextcloud noch kein Konto hat, kann sich dort auch mit Microsoft nicht anmelden. So entscheidet PDH, wer Nextcloud bekommt.</div>
  <div class="hb-howto"><b><i class="ti ti-user-cog"></i> Für Administratoren: Passwort im Benutzerstamm setzen</b>
    <ol class="hb-steps">
      <li>Benutzer öffnen (oder neu anlegen) und unter <b>Neues Passwort</b> ein vorläufiges Passwort eintragen – es muss die Richtlinie erfüllen.</li>
      <li>Speichern und das Passwort der Person mitteilen. Sie muss es bei der nächsten Anmeldung ändern (abschaltbar in der Richtlinie).</li>
      <li>Ohne neues Passwort geht es mit <b>Passwortwechsel verlangen</b>; <b>Erlassen</b> nimmt den Wechselzwang wieder weg. Den Stand zeigt das Schild „Wechsel bei nächster Anmeldung“ bzw. „Passwort abgelaufen“.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-lock-question"></i> Passwort vergessen?</b>
    <ol class="hb-steps">
      <li>Auf der Anmeldeseite unter dem Anmelden-Knopf auf <b>Passwort vergessen?</b>.</li>
      <li>E-Mail-Adresse oder Benutzernamen eingeben und <b>Link anfordern</b>.</li>
      <li>In der E-Mail auf <b>Neues Passwort vergeben</b> klicken, das neue Passwort zweimal eingeben und speichern. Danach wie gewohnt anmelden.</li>
    </ol>
    Der Link gilt eine Stunde und nur einmal. Keine E-Mail bekommen? Spam-Ordner prüfen. Im Konto muss eine E-Mail-Adresse stehen – sonst vergibt ein Administrator im Benutzerstamm ein neues Passwort. Systembenutzer (Terminals) können ihr Passwort nicht selbst zurücksetzen.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> So verbindest du Microsoft 365 (geschäftlich und privat)</b>
    <ol class="hb-steps">
      <li>Oben rechts auf deinen Namen → <b>Mein Konto</b>. Dort gibt es zwei Karten: <b>Microsoft 365 · Geschäftlich</b> und <b>Microsoft 365 · Privat</b>.</li>
      <li><b>Geschäftskonto verbinden</b> für dein Firmen-/Schulkonto, <b>Privates Konto verbinden</b> für Outlook.com, Hotmail, Live oder Microsoft 365 Single/Family. Du kannst beide gleichzeitig verbinden.</li>
      <li>Bei Microsoft anmelden und die Freigabe bestätigen – danach kommst du automatisch zurück ins PDH.</li>
      <li>Je Konto unter <b>Outlook-Kalender</b> anhaken, was in diesen Kalender geschrieben wird (Schichten, Aufgaben, Wartungen, Tickets &amp; Störungen), und ob Termine als <b>Busy-Blocker</b> ins PDH geholt werden. <b>Kalenderauswahl speichern</b>, dann <b>Jetzt synchronisieren</b>.</li>
    </ol></div>
  <p>Schichten stehen in Outlook mit den Uhrzeiten aus dem Schichtplan (Ortszeit), auch Nachtschichten über die Zeitumstellung. Busy-Blocker aus beiden Konten erscheinen im Schichtwochenplan als <b>O</b> („Outlook belegt“). Betreffzeilen werden nie übernommen, und eine Zuweisung bleibt trotzdem möglich. <b>Teams</b> gibt es nur über das Geschäftskonto. <b>Konto trennen</b> löscht die importierten Blocker dieses Kontos; bereits in Outlook eingetragene Termine bleiben dort stehen.</p>
  <p>In der <b>Benutzerliste</b> öffnet <i class="ti ti-dots"></i> direkt die Bearbeitung. Der Benutzerstamm hat die Reiter Übersicht, Stammdaten, Privat, Nachweise, Einzelrechte, Zuständigkeiten, Feldsätze und Historie. <b>Einzelrechte</b> erlauben oder verbieten einzelne Funktionen abweichend von der Rolle; „Admin machen“ sehen nur Administratoren. <b>Zuständigkeiten</b> listet alle offenen Vorgänge, in denen die Person zugewiesen oder verantwortlich ist – auch über eine zugewiesene Gruppe (Rolle „Gruppe“). Ist die Person Broker, steht darunter <b>Wartet auf Zuweisung (als Broker)</b>: offene Vorgänge ihrer Arten, die noch niemandem gehören. Die gelbe Zahl am Reiter zeigt, wie viele. Zugewiesen wird über <b>Zur Zuweisung</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-mail"></i> So prüfst du den E-Mail-Versand und schaltest Statusmeldungen per E-Mail ein</b>
    <ol class="hb-steps">
      <li>Den Benutzerstamm der Person öffnen (oder <b>Mein Konto</b>), Reiter <b>Übersicht</b>, Karte <b>E-Mail</b>.</li>
      <li><b>Testmail senden</b> – daneben steht, ob die Mail rausging oder was nicht stimmt.</li>
      <li><b>Statusmeldungen auch per E-Mail</b> anhaken. Ab dann kommen die Hinweise von PDH-System (neu angelegt, geändert, zugewiesen) zusätzlich per E-Mail, mit Link zum Vorgang.</li>
    </ol>
    Die Karte sieht die Person selbst und wer ihre Stammdaten bearbeiten darf. Die E-Mail kommt nur, solange auch die Chat-Hinweise eingeschaltet sind (<b>Konto &amp; Dienste</b>). Der Versand muss unter <a href="#server">Server-Einstellungen → E-Mail</a> eingerichtet sein.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> So richtest du die Nextcloud-App mit Zertifikat ein</b>
    <ol class="hb-steps">
      <li><b>Mein Konto</b> → Reiter <b>Konto &amp; Dienste</b> → Karte <b>Zertifikat für die Nextcloud-App</b>.</li>
      <li>Bei <b>Gerät</b> z. B. „Handy“ eintragen → <b>Zertifikat ausstellen</b>. Das <b>Passwort</b> erscheint direkt darunter.</li>
      <li><b>.p12</b> herunterladen, am besten gleich auf dem Gerät.</li>
      <li><b>Android:</b> Datei antippen bzw. Einstellungen → Sicherheit → Verschlüsselung &amp; Anmeldedaten → Zertifikat installieren → <b>VPN- und App-Nutzerzertifikat</b>, Passwort eingeben. Beim Anmelden in der Nextcloud-App das Zertifikat auswählen.<br><b>iPhone:</b> in der Nextcloud-App beim Anmelden das Client-Zertifikat aus „Dateien“ importieren. Über die iOS-Einstellungen installierte Zertifikate nutzt die App nicht.<br><b>Windows/Mac:</b> der Nextcloud-Desktop-Client fragt beim Einrichten nach dem Zertifikat → Datei und Passwort angeben.</li>
    </ol>
    Oben in der Karte steht, ob Nextcloud überhaupt nach Zertifikaten fragt („Zertifikatspflicht aktiv“). Steht dort „nicht eingerichtet“, hat die .p12 noch keine Wirkung – dann bitte die Administration den dort genannten Befehl ausführen lassen. Für jedes Gerät ein eigenes Zertifikat. Geht ein Gerät verloren: dort <b>Sperren</b>. Das Passwort zeigt <b>Passwort</b> jederzeit wieder an. Fehlt die Karte, hat die Administration die Selbstbedienung ausgeschaltet; dann stellt sie das Zertifikat aus.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> Sprache</b>PDH gibt es auf Deutsch, Englisch, Rumänisch, Türkisch und Mazedonisch. Jede Person wählt ihre Sprache über die <b>Flagge</b> oben rechts (auf der Anmeldeseite oben in der Karte); die Wahl wird im Benutzerstamm gespeichert und gilt bei der nächsten Anmeldung auf jedem Gerät. Die <b>Vorwahl</b> trägt die Benutzerverwaltung im Benutzerstamm unter <b>Stammdaten → Sprache</b> ein. Ohne Eintrag nimmt PDH die Sprache des Browsers. Die Umstellung erfolgt schrittweise. Übersetzt sind bisher: Navigation, Kopfzeile, Menüs, Seitenleiste, Anmeldung, das <b>Dashboard</b> mit allen Widgets sowie der <b>Erstellungs-Assistent</b> (auch im Leitstand) und der <b>Abschluss-Assistent</b> samt ihren Meldungen. Der Leitstand folgt der Sprache des Browsers bzw. der zuletzt gewählten Flagge. Noch nicht übersetzte Seiten und dieses Handbuch erscheinen vorerst auf Deutsch; was du selbst eingibst (Titel, Kommentare) und der Verlauf bleiben in der Sprache, in der sie geschrieben wurden.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> So schaltest du die Live-Übersetzung ein</b>Die Live-Übersetzung übersetzt <b>alles auf der Seite</b> in deine Sprache – auch Seiten, die noch nicht übersetzt sind, und Inhalte wie Titel, Beschreibungen, Maßnahmen, Kommentare und Chat. Auch was später nachgeladen wird, wird übersetzt.
    <ol class="hb-steps">
      <li><b>Mein Konto</b> (bzw. als Benutzerverwaltung den Benutzer) öffnen → <b>Stammdaten</b>.</li>
      <li>Bei <b>Live-Übersetzung</b> „Alle Texte automatisch übersetzen“ anhaken.</li>
      <li>Unter <b>Übersetzen in</b> die Sprache wählen – z. B. Polnisch, Kroatisch oder Arabisch. Ohne Auswahl gilt die Sprache der Oberfläche.</li>
      <li><b>Speichern</b>. Ab der nächsten Seite wird übersetzt.</li>
    </ol>
    Schneller geht das An- und Ausschalten im Benutzermenü oben rechts: <b>Live-Übersetzung einschalten/ausschalten</b>. Beim ersten Aufruf einer Seite dauert es einen Moment (unten steht „Übersetze …“); danach kommen die Texte aus dem Zwischenspeicher sofort. Eingabefelder und was du gerade schreibst, bleiben unverändert – gespeichert wird immer der Originaltext. Die Texte gehen zum Übersetzen an den eingestellten Dienst (DeepL oder Copilot). Steht im Menü ein ⚠, hat ein Administrator noch keinen Dienst eingerichtet (<b>Server-Einstellungen → Übersetzung</b>).</div>
  <div class="hb-howto"><b><i class="ti ti-users-group"></i> Abteilungen &amp; Gruppen</b>Unter <b>Abteilungen &amp; Gruppen</b> (Navigation, Recht „Benutzer verwalten“) pflegst du beide zentral:
    <ul>
      <li><b>Abteilungen</b> mit Leitung. Jede Person gehört zu höchstens einer – im Benutzerstamm unter <b>Stammdaten → Abteilung</b> auswählen. Umbenennen wirkt sofort bei allen Mitarbeitenden. Kommt aus dem Microsoft-Abgleich eine neue Abteilung, legt PDH sie automatisch an.</li>
      <li><b>Gruppen</b> bündeln Personen quer zu Abteilungen (z. B. „Elektro Frühschicht“, „Ersthelfer“), optional mit Abteilung und Leitung. Mitglieder wählst du in der Gruppe oder im Benutzerstamm unter <b>Stammdaten → Gruppen</b>; eine Person kann in mehreren Gruppen sein. Vorgänge lassen sich einer Gruppe zuweisen; in der <b>Benutzerliste</b> filterst du nach Abteilung und Gruppe.</li>
      <li>Abteilungen bilden eine <b>Hierarchie</b>: Jede kann eine <b>übergeordnete Abteilung</b> haben. Die Struktur steht im <b>Organigramm</b> unter den Rollen.</li>
      <li><b>Rollen</b> ordnest du unter <b>Rollen &amp; Rechte</b> in der Tabelle <b>Rollen</b> einer Abteilung zu (Spalte „Abteilung (Sichtbarkeit)“).</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock-access"></i> Rechte je Abteilung</b>Die Abteilung eines Vorgangs ergibt sich aus seiner <b>Anlage</b>: Im Anlagenbaum trägst du unter <b>Bearbeiten → Abteilung</b> ein, zu welcher Abteilung eine Anlage gehört. Unteranlagen ohne eigene Angabe <b>erben</b> sie von oben (in der Übersicht als „geerbt“ markiert).
    <ul>
      <li>Hat eine <b>Rolle eine Abteilung</b>, sehen ihre Benutzer nur Tickets, Störungen, Wartungen, Aufgaben, Projekte und IT-Assets dieser Abteilung und ihrer Unterabteilungen – in Listen, Detailseiten, im Dashboard (Kennzahlen, Verlauf, Listen, Zeitstrahl), in der Anlagen-Historie und über die Schnittstelle. Am <b>Leitstand</b> gilt das, sobald eine eingeschränkte Person angemeldet ist; die öffentliche Tafel ohne Anmeldung zeigt alles.</li>
      <li>Nicht eingeschränkt sind die vom Administrator eingerichteten <b>Datenexporte</b> (sie laufen auch ohne angemeldete Person nach Zeitplan); der <b>Outlook-Kalender</b> enthält ohnehin nur eigene Vorgänge.</li>
      <li>Immer sichtbar bleiben Vorgänge <b>ohne Anlage</b> oder ohne Abteilung sowie alles, woran man <b>selbst beteiligt</b> ist (erstellt, verantwortlich, zugewiesen – auch über eine Gruppe).</li>
      <li><b>Übergeordnete</b> Abteilungen – vorbelegt Instandhaltung, IT, Office und GL – und Rollen <b>ohne Abteilung</b> (z. B. Administrator) sehen alles. Das Kennzeichen setzt du unter <b>Abteilungen &amp; Gruppen</b>.</li>
    </ul></div>
  {{template "hb-shots" (dict "Ref" (index $s "users") "Can" $can)}}
</section>

<section class="hb-ch" id="templates" data-title="Vorlagen &amp; Signaturen" data-pages="m365">
  <h2><i class="ti ti-brand-office"></i> Vorlagen &amp; Signaturen</h2>
  <p>Unter <b>Navigation → Vorlagen &amp; Signaturen</b> liegen die Firmenvorlagen für Word, Excel und PowerPoint. Jede Person kann sie dort herunterladen. Ist eine SharePoint-Bibliothek eingerichtet, stehen sie auch direkt in Word, Excel und PowerPoint unter <b>Neu</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-upload"></i> So stellst du eine Vorlage bereit</b>
    <ol class="hb-steps">
      <li>Reiter <b>Vorlagen</b> → <b>Vorlage hochladen</b>: Datei wählen (.dotx, .docx, .xltx, .xlsx, .potx, .pptx), Kategorie und Beschreibung eintragen, <b>Hochladen</b>.</li>
      <li>Neue Fassung: bei der Vorlage <b>Bearbeiten</b>, Datei unter <b>Neue Version</b> wählen, <b>Speichern</b>. Die Versionsnummer zählt hoch.</li>
      <li>Mit SharePoint: <b>Mit SharePoint abgleichen</b>. Neue und geänderte Vorlagen werden hochgeladen, ausgeblendete und gelöschte dort entfernt.</li>
    </ol>
    <b>Ausblenden</b> nimmt eine Vorlage aus der Liste, ohne sie zu löschen. Das Recht „Microsoft-365-Vorlagen &amp; E-Mail-Signaturen verwalten“ braucht man zum Hochladen und Ändern; Herunterladen darf jede Person.</div>
  <div class="hb-howto"><b><i class="ti ti-signature"></i> So richtest du E-Mail-Signaturen ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Signaturen</b> → <b>Neue Signatur</b>. Bei <b>Gilt für</b> eine Abteilung wählen oder „alle“ lassen.</li>
      <li>Das HTML anpassen. Die Knöpfe fügen Platzhalter ein, z. B. <code>{Name}</code>, <code>{Position}</code>, <code>{Telefon}</code>, <code>{Mobil}</code>, <code>{E-Mail}</code>, <code>{Firma}</code>. Rechts siehst du die Vorschau für eine ausgewählte Person.</li>
      <li><b>Speichern</b>. Unten im Reiter zuerst <b>Werte nach Microsoft 365 übertragen</b>, dann <b>Exchange-Skript herunterladen</b>.</li>
      <li>Das Skript in PowerShell ausführen: <code>Connect-ExchangeOnline</code>, dann <code>.\pdh-signaturen.ps1</code>. Ab dann hängt Exchange die Signatur an jede ausgehende Mail.</li>
    </ol>
    Die Werte kommen aus dem Benutzerstamm. Was dort leer ist, nimmt PDH aus Microsoft 365. Den Firmennamen für <code>{Firma}</code> trägst du im Reiter <b>Einstellungen</b> ein. Nach Änderungen an einer Signatur das Skript neu herunterladen und ausführen. Nach Änderungen im Benutzerstamm genügt <b>Werte nach Microsoft 365 übertragen</b>.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Für Administratoren: einmalige Einrichtung</b>
    <ul>
      <li>In der Entra-App-Registrierung des PDH unter <b>API-Berechtigungen → Microsoft Graph → Anwendungsberechtigungen</b> diese Rechte hinzufügen und die <b>Administratorzustimmung erteilen</b>: <b>Sites.ReadWrite.All</b> (für SharePoint) und <b>User.ReadWrite.All</b> (für Werte nach Microsoft 365).</li>
      <li>Reiter <b>Einstellungen</b>: SharePoint-Site und Bibliothek eintragen, <b>Speichern &amp; prüfen</b>. Den dort angezeigten Befehl <code>Add-SPOOrgAssetsLibrary</code> einmalig in der SharePoint-Online-PowerShell ausführen. Bis die Vorlagen in Office erscheinen, kann es bis zu 24 Stunden dauern.</li>
      <li>Vor dem Übertragen unter <b>Core-Einstellungen → Microsoft 365</b> einmal <b>Jetzt abgleichen</b>. Nur zugeordnete Personen werden übertragen.</li>
      <li>Personen, die aus einem lokalen Active Directory synchronisiert werden, kann PDH in Microsoft 365 nicht ändern. Diese Werte im lokalen AD pflegen.</li>
    </ul></div>
  <p>Exchange erlaubt höchstens 5000 Zeichen je Signatur. Die Liste zeigt, wie viele eine Signatur braucht. Bilder wie das Logo nur als Link auf eine öffentlich erreichbare Adresse einbinden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "templates") "Can" $can)}}
</section>

<section class="hb-ch" id="trainings" data-title="Schulungen &amp; Qualifikationen" data-pages="trainings">
  <h2><i class="ti ti-school"></i> Schulungen &amp; Qualifikationen</h2>
  <p>Die <b>Schulungsmatrix</b> zeigt je Person, welche Schulungen und Qualifikationen sie braucht und ob ein gültiger, unterschriebener Nachweis vorliegt: <span style="color:var(--green)">gültig</span>, <span style="color:var(--amber)">läuft bald ab</span>, <span style="color:var(--red)">abgelaufen</span> bzw. <span style="color:var(--red)">fehlt</span>, oder <b>Termin geplant</b>. Pflichtfelder sind umrandet; in der Zelle steht, bis wann der Nachweis gilt. Jede Person sieht ihren eigenen Stand unter <b>Meine Schulungen</b> und im Benutzerstamm im Reiter <b>Schulungen</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-books"></i> Katalog einrichten</b> (Recht „Schulungen &amp; Qualifikationen verwalten“)
    <ol class="hb-steps">
      <li><b>Schulungen</b> → Reiter <b>Katalog</b> → <b>Neu im Katalog</b>: Bezeichnung, Art (Schulung/Unterweisung oder Qualifikation), <b>Verantwortlich</b>, Wiederholung in Monaten (0 = einmalig) und wie viele Tage vor Ablauf sie fällig wird.</li>
      <li>Unter <b>Pflicht für</b> ankreuzen, wer sie braucht: Rollen, Abteilungen, Gruppen oder einzelne Personen. Die Pflichtschulungen einer Rolle stehen auch unter <b>Rollen &amp; Rechte</b> in der Tabelle <b>Rollen</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-signature"></i> So entsteht ein Nachweis</b>
    <ol class="hb-steps">
      <li><b>Automatisch bei Fälligkeit:</b> Braucht jemand die Schulung und hat keinen gültigen Nachweis mehr (oder bald nicht mehr), legt PDH einen offenen Nachweis mit allen Fälligen an und schreibt dem/der Verantwortlichen im Chat. Ist schon ein offener Nachweis da, kommen neu Fällige dazu. Ohne Verantwortliche/n geht der Hinweis an die Administratoren. Manuell geht es über <b>Neuer Nachweis</b>.</li>
      <li>Im Nachweis <b>Datum</b>, <b>Schulende/n</b> und den <b>Inhalt in Stichpunkten</b> eintragen (eine Zeile je Punkt) und speichern. Teilnehmende einzeln, als ganze Gruppe oder Abteilung hinzufügen; wer nicht da war, mit <i class="ti ti-user-minus"></i> entfernen.</li>
      <li>Jede/r Teilnehmende <b>unterschreibt am Bildschirm</b> (Finger, Stift oder Maus) – am gemeinsamen Tablet der/des Schulenden oder am eigenen Gerät. Zum Schluss unterschreibt die/der Schulende.</li>
      <li><b>Abschließen &amp; archivieren</b> erscheint erst, wenn alles vollständig ist. Danach ist der Nachweis unveränderlich und zählt in der Matrix. <b>Drucken</b> erzeugt das Nachweisblatt mit allen Unterschriften.</li>
    </ol></div>
  <p>Ändern sich nach dem Unterschreiben Datum, Inhalt oder Schulende/r, verfallen die Unterschriften – unterschrieben wird immer genau das, was geschult wurde. Für den nächsten Termin legt <b>Wiedervorlage (leeres Formular)</b> einen neuen Nachweis mit gleicher Schulung, Ort, Schulende/r und Teilnehmenden an; Datum, Inhalt und Unterschriften sind leer. Mit <b>vom letzten Termin</b> übernimmst du bei Bedarf die Stichpunkte des letzten archivierten Termins.</p>
  <p>Die Ja/Nein-Fähigkeiten für den Schichtplan (Rufbereitschaft, Schlüsseldienst usw.) und die Nachweise im Benutzerstamm (Führerschein, externe Zertifikate) bleiben davon unabhängig.</p>
  {{template "hb-shots" (dict "Ref" (index $s "trainings") "Can" $can)}}
</section>

<section class="hb-ch" id="fieldsets" data-title="Feldsätze" data-pages="">
  <h2><i class="ti ti-forms"></i> Feldsätze</h2>
  <p>Feldsätze sind Zusatzfelder, die eure Administration festlegt – z. B. bei Motoren „Leistung“ und „Schutzart“. Sie erscheinen im Reiter <b>Feldsätze</b>; dort auf <b>Bearbeiten</b> klicken, ausfüllen, speichern.</p>
  <p>Ein Feldsatz gilt entweder für einzelne ausgewählte Datensätze oder automatisch (für alle oder eine bestimmte Kategorie).</p>
  <h3>Module <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <ul>{{range .FieldModules}}<li>{{.Label}}{{if .MatchLabel}} – automatisch nach {{.MatchLabel}}{{end}}</li>{{end}}</ul>
  <h3>Feldtypen <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <p>{{$tl := .TypeLabels}}{{range $i, $t := .FieldTypes}}{{if $i}}, {{end}}{{index $tl $t}}{{end}}</p>
  {{template "hb-shots" (dict "Ref" (index $s "fieldsets") "Can" $can)}}
</section>

<section class="hb-ch" id="cleanup" data-title="Sperren, Deaktivieren &amp; Löschen" data-pages="cleanup">
  <h2><i class="ti ti-trash-x"></i> Sperren, Deaktivieren &amp; Löschen</h2>
  <p>Stammdaten – <b>Anlagen, Ersatzteile, Lagerplätze, Hersteller &amp; Lieferanten</b> – werden im PDH <b>nie direkt gelöscht</b>. Sonst würden Störungen, Buchungen und Historien plötzlich ins Leere zeigen. Stattdessen gibt es drei Stufen, alle über <b>Status</b> oben auf der Detailseite:</p>
  <table>
    <tr><td><b><i class="ti ti-lock"></i> Sperren</b></td><td>Der Datensatz bleibt sichtbar, kann aber nicht mehr geändert werden (z. B. Anlage während eines Umbaus). Kommentare sind weiter möglich. Auf gesperrte Ersatzteile und Lagerplätze kann <b>nichts gebucht</b> werden – weder in der Ersatzteilliste noch bei der Materialentnahme in Vorgängen oder über Schnittstellen.</td></tr>
    <tr><td><b><i class="ti ti-circle-off"></i> Deaktivieren</b></td><td>Verschwindet aus Listen und Auswahlfeldern, bleibt aber vollständig erhalten und kann jederzeit wieder aktiviert werden.</td></tr>
    <tr><td><b><i class="ti ti-trash-x"></i> Zum Löschen vormerken</b></td><td>Wird sofort deaktiviert. Beim nächsten <b>Bereinigungslauf</b> prüft PDH, ob er noch verwendet wird.</td></tr>
  </table>
  {{template "hb-fig-cleanup"}}
  <div class="hb-howto"><b><i class="ti ti-trash-x"></i> So merkst du einen Datensatz zum Löschen vor</b>
    <ol class="hb-steps">
      <li>Datensatz öffnen → oben rechts <b>Status</b>.</li>
      <li>Optional einen <b>Grund</b> eintragen (z. B. „Anlage verschrottet“) – er steht später in der Historie.</li>
      <li><b>Zum Löschen vormerken</b> und bestätigen. Rückgängig machst du es über <b>Status → Löschvormerkung aufheben</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So startest du den Bereinigungslauf (Administration)</b>
    <ol class="hb-steps">
      <li>Navigation → <b>Bereinigung</b>. Im Reiter <b>Vormerkungen</b> steht bei jedem Datensatz schon vorab, was passieren wird: <i>wird gelöscht</i> oder <i>wird ausgeblendet</i> – mit Grund, z. B. „3 × Störungen, Lagerbestand 5“.</li>
      <li>Einzelne Vormerkungen bei Bedarf <b>aufheben</b>.</li>
      <li><b>Bereinigungslauf starten</b>. Unbenutzte Datensätze werden endgültig gelöscht, noch verwendete <b>ausgeblendet</b>.</li>
      <li>Alle Administratoren bekommen von <b>„Service“</b> eine Chat-Nachricht mit dem Ergebnis.</li>
    </ol></div>
  <p>Die Reiter <b>Gesperrt</b>, <b>Deaktiviert</b> und <b>Ausgeblendet</b> zeigen alle betroffenen Stammdaten – dort lassen sie sich mit einem Klick entsperren, aktivieren oder wieder einblenden. Der <b>Verlauf</b> zeigt jeden Bereinigungslauf mit Details. Ersatzteile findest du außerdem über den Listenfilter „Deaktiviert“ bzw. „Gesperrt“, Firmen über den Reiter „Inaktiv“.</p>
  <p>Auch Schnittstellen können keine Stammdaten löschen: Eine Löschanforderung über die API wird automatisch zur Löschvormerkung.</p>
  <p>Im Reiter <b>Verlauf</b> haben beide Listen eine Sortier-Leiste (<a href="#sort">mehr</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "cleanup") "Can" $can)}}
</section>

<section class="hb-ch" id="backup" data-title="Datensicherung &amp; Wiederherstellung" data-pages="backup">
  <h2><i class="ti ti-database-export"></i> Datensicherung &amp; Wiederherstellung</h2>
  <p>Unter <b>Navigation → Datensicherung</b> (Berechtigung <i>Datensicherung &amp; Wiederherstellung</i>, standardmäßig nur Administratoren) sicherst du das PDH und spielst Sicherungen zurück.</p>
  {{template "hb-fig-backup"}}
  <table>
    <tr><td><b>Datenbank</b></td><td>alle Stammdaten, Vorgänge, Benutzer, Rechte, Einstellungen und Chat-Nachrichten</td></tr>
    <tr><td><b>Anhänge &amp; Bilder</b></td><td>Dokumente, Datensatz- und Ersatzteilbilder, Handbuch-Bildschirmfotos</td></tr>
    <tr><td><b>Chat-Dateien</b></td><td>im Chat geteilte Dateien</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So erstellst du eine Sicherung</b>
    <ol class="hb-steps">
      <li>Reiter <b>Sicherungen</b> → unter „Jetzt sichern“ die Bestandteile anhaken.</li>
      <li><b>Sicherung erstellen</b>. Sie läuft im Hintergrund; der Fortschritt steht im <b>Protokoll</b>.</li>
      <li>Fertige Sicherungen kannst du <b>herunterladen</b> und extern aufbewahren (z. B. auf einem anderen Server).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-calendar-time"></i> So richtest du eine automatische Sicherung ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Zeitpläne</b> → „Neuer Zeitplan“.</li>
      <li>Name, <b>Häufigkeit</b> (täglich, wöchentlich mit Wochentag, monatlich mit Tag 1–28) und <b>Uhrzeit</b> wählen. Die Uhrzeit ist die Ortszeit des Servers (Vorgabe 03:00). Wähle keine Zeit zwischen 02:00 und 02:59: Bei der Umstellung auf Sommerzeit gibt es diese Stunde nicht, die Sicherung fiele aus.</li>
      <li>Bestandteile anhaken und festlegen, wie viele Sicherungen <b>aufbewahrt</b> werden – ältere werden automatisch entfernt.</li>
      <li>Speichern. Mit <b>Jetzt ausführen</b> testest du den Zeitplan sofort. Schlägt eine geplante Sicherung fehl, meldet sich „Service“ per Chat bei allen Administratoren. Lief derselbe Zeitplan vor weniger als 90 Minuten schon, lässt das PDH den geplanten Lauf aus – so entsteht bei der Umstellung auf Winterzeit keine doppelte Sicherung.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-restore"></i> So stellst du eine Sicherung wieder her</b>
    <ol class="hb-steps">
      <li>Bei der gewünschten Sicherung auf <b>Wiederherstellen</b> (fremde Sicherung vorher mit <b>Sicherung hochladen</b> einspielen).</li>
      <li>Bestandteile wählen – z. B. nur die Anhänge.</li>
      <li><b>WIEDERHERSTELLEN</b> eintippen und bestätigen.</li>
    </ol>
    PDH legt vorher automatisch eine <b>Sicherheitskopie</b> des aktuellen Stands an. Die Datenbank wird in einem Schritt zurückgespielt – geht etwas schief, bleibt der bisherige Stand unverändert. Alle Administratoren werden per Chat über Beginn und Ergebnis informiert.</div>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> Automatische Vollsicherung bei jedem Update</b>
    Startet das PDH nach einem Update zum ersten Mal, sichert es <b>vor</b> allen Datenbank-Änderungen den kompletten bisherigen Stand (Datenbank, Anhänge, Chat-Dateien) – egal ob über <b>Core-Einstellungen → Update installieren</b>, den Installer oder von Hand aktualisiert wurde. Die Sicherung erscheint in der Liste als <b>Vor Update</b>; aufbewahrt werden die letzten 5 (einstellbar unter <b>Zeitpläne → Automatisch bei jedem Update</b>, dort auch abschaltbar). Schlägt die Sicherung fehl (z. B. Speicher voll), wird das Update <b>nicht</b> angewendet und im Server-Protokoll steht der Grund. Nur im Notfall lässt sich das mit der Umgebungsvariablen <code>PDH_SKIP_UPDATE_BACKUP=1</code> übergehen.</div>
  <p><b>Wichtig:</b> Eine Sicherung aus einer <b>neueren</b> PDH-Version kann erst nach einem Update eingespielt werden. Ältere Sicherungen werden beim Einspielen automatisch auf den aktuellen Stand gebracht. Sicherungsprotokoll und Zeitpläne selbst werden nicht überschrieben.</p>
  <p>Im Reiter <b>Protokoll</b> lassen sich die Sicherungen sortieren (<a href="#sort">mehr</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "backup") "Can" $can)}}
</section>

<section class="hb-ch" id="drives" data-title="Netzlaufwerke" data-pages="core-settings">
  <h2><i class="ti ti-server-2"></i> Netzlaufwerke</h2>
  <p>Unter <b>Core-Einstellungen → Netzlaufwerke</b> bindet PDH Freigaben aus dem Firmennetz ein – Windows-Freigaben und NAS (<b>SMB/CIFS</b>), <b>NFS</b> oder ein Verzeichnis, das der Server schon eingebunden hat (<b>Lokaler Pfad</b>). Jedes Laufwerk liegt danach unter <code>/mnt/pdh/&lt;name&gt;</code>.</p>
  {{template "hb-fig-drives"}}
  <div class="hb-howto"><b><i class="ti ti-plug"></i> So bindest du ein Laufwerk ein</b> (Recht „Rollen &amp; Rechte verwalten“)
    <ol class="hb-steps">
      <li><b>Laufwerk hinzufügen</b>: Name, Art und Freigabe eintragen – z. B. <code>\\nas\instandhaltung</code> oder <code>nas:/export/pdh</code>.</li>
      <li>Bei SMB Benutzername, Passwort und ggf. Domäne angeben. Das Passwort wird verschlüsselt gespeichert. Klappt es nicht, unter Optionen z. B. <code>vers=3.0</code> oder <code>vers=2.1</code> eintragen.</li>
      <li>Ankreuzen, wofür das Laufwerk dient (siehe unten), dann <b>Speichern &amp; einbinden</b>. <b>Testen</b> prüft, ob PDH lesen und schreiben darf; <b>Durchsuchen</b> zeigt die Ordner und kopiert Pfade.</li>
      <li>Kann PDH nicht schreiben, nennt „Testen“ den Grund: <b>Zugriff verweigert</b> – der eingetragene Benutzer darf in der Freigabe nicht schreiben (am NAS ändern); war das Laufwerk vor dem Update auf 0.82.5 eingebunden und läuft PDH nicht als Benutzer „pdh“, das Laufwerk einmal öffnen und <b>Speichern</b> drücken (nicht „Trennen“ – das schaltet das automatische Einbinden aus); <b>nur lesend eingebunden</b> – Freigabe am NAS schreibbar stellen, dann Trennen und neu einbinden; <b>kein Speicherplatz frei</b>; <b>Verbindung gestört</b> – nach ein paar Minuten erneut testen.</li>
    </ol>
    Mit „automatisch einbinden“ verbindet PDH das Laufwerk nach jedem Neustart und alle 5 Minuten wieder, falls die Verbindung abbricht. Fällt ein Laufwerk aus, bekommen die Administratoren eine Chat-Nachricht und PDH arbeitet lokal weiter.</div>
  <table>
    <tr><td><b><i class="ti ti-database"></i> Globaler Datenspeicher</b></td><td>Die Standardablage: Import- und Export-Pfade <b>ohne</b> führenden Schrägstrich (z. B. <code>Exporte/zaehler.xlsx</code>) liegen hier. Sicherungen und Dokumente landen ebenfalls hier, wenn dafür kein eigenes Laufwerk gewählt ist.</td></tr>
    <tr><td><b><i class="ti ti-database-import"></i> Import &amp; Export</b></td><td>Das Laufwerk erscheint als Vorschlag in den Feldern <b>Quellpfad</b> und <b>Zielpfad</b> der Import- und Export-Verbindungen.</td></tr>
    <tr><td><b><i class="ti ti-database-export"></i> Datensicherung</b></td><td>Neue Sicherungen werden im Ordner <code>PDH-Sicherungen</code> des Laufwerks gespeichert. Ältere Sicherungen bleiben im lokalen Ordner.</td></tr>
    <tr><td><b><i class="ti ti-files"></i> Dokumentenablage</b></td><td>Jeder neue Anhang (Foto, Dokument) wird zusätzlich nach Vorgang sortiert abgelegt: <code>PDH-Dokumente/Tickets/Tür klemmt (a1b2c3d4)/Foto.jpg</code>. <b>Vorhandene Dokumente übertragen</b> legt einmalig alle bisherigen Anhänge ab. PDH behält seine eigene Kopie.</td></tr>
  </table>
  <div class="hb-howto" id="hb-drives-nextcloud"><b><i class="ti ti-cloud"></i> So zeigst du ein Laufwerk in Nextcloud</b>
    <ol class="hb-steps">
      <li>Der <a href="#hb-nc-sync">Abgleich mit Nextcloud</a> ist eingeschaltet, Nextcloud liegt auf demselben Server.</li>
      <li>Beim Laufwerk <b>in Nextcloud zeigen</b> anhaken und speichern.</li>
      <li>Unter <b>Rollen &amp; Rechte</b> (Kategorie „System &amp; Sicherheit“) festlegen, wer es sieht: <b>Netzlaufwerke in Nextcloud nutzen</b>. Wer auch die Daten des PDH ändern darf, bekommt zusätzlich <b>Netzlaufwerke in Nextcloud: auch PDH-Daten bearbeiten</b>.</li>
      <li>Nach etwa 20 Sekunden steht das Laufwerk in Nextcloud unter <b>Dateien → PDH-Laufwerke</b>.</li>
    </ol>
    Ein Laufwerk mit einer Aufgabe (Datenspeicher, Import &amp; Export, Datensicherung, Dokumentenablage) ist in Nextcloud <b>nur lesbar</b>, damit niemand versehentlich Daten des PDH ändert. Mit dem zweiten Recht ist es beschreibbar. Laufwerke ohne Aufgabe sind für alle mit dem ersten Recht beschreibbar, außer sie sind „schreibgeschützt“. Ohne eines der Rechte sieht man in Nextcloud kein Laufwerk – das Sicherungslaufwerk enthält Zugangsdaten. Name und Pfad dürfen nur Buchstaben, Ziffern, Punkt, Binde- und Unterstrich enthalten (der Name auch Leerzeichen und Klammern). Bei einem lokalen Pfad muss der Webserver-Benutzer <code>www-data</code> selbst darauf zugreifen dürfen.</div>
  <p>Datenspeicher, Datensicherung und Dokumentenablage gibt es je einmal. Ein schreibgeschütztes Laufwerk eignet sich nur für Import &amp; Export. Eingebunden wird über den Update-Agenten: bei Docker-Installationen ist das ab dieser Version eingerichtet (nach dem Update einmal <code>docker compose up -d</code>); bei Installationen ohne Docker <code>sudo ./install-update-agent.sh</code> erneut ausführen, damit die Mount-Werkzeuge installiert werden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "drives") "Can" $can)}}
</section>

<section class="hb-ch" id="netzwerk" data-title="Netzwerk (VLANs und WLANs)" data-pages="network">
  <h2><i class="ti ti-network"></i> Netzwerk (VLANs und WLANs)</h2>
  <p>Unter <b>Administration → Netzwerk</b> stehen die Netze und WLANs eures Betriebs an einer Stelle: welches Netz wofür da ist, welche VLAN-Nummer und welchen Adressbereich es hat und welche WLANs dazugehören. Andere Bereiche wählen daraus, statt WLAN-Namen und Kennwörter selbst zu führen – z. B. ein Messgerät, das in ein bestimmtes WLAN soll. Das PDH richtet damit <b>nichts</b> an Switches, Access Points oder der Firewall ein; die Seite ist ein Verzeichnis. Ist UniFi oder Omada angebunden, liest das PDH die Netze und WLANs von dort und schlägt sie dir vor – du musst sie nicht abtippen.</p>
  {{template "hb-fig-netzwerk"}}
  <div class="hb-howto"><b><i class="ti ti-download"></i> So übernimmst du Netze und WLANs vom Controller</b>
    <ol class="hb-steps">
      <li>Die Seite <b>Netzwerk</b> öffnen. Ist UniFi oder Omada eingerichtet, erscheint oben der Block <b>Vom Controller gefunden</b>. Er lädt nach ein paar Sekunden nach.</li>
      <li>Jede Zeile ist <b>NEU</b> (gibt es im PDH noch nicht) oder <b>ANDERS</b> (gibt es schon, aber mit anderen Werten). Einträge, die schon übereinstimmen, werden nur gezählt (<b>stimmt überein</b>).</li>
      <li>Bei <b>NEU</b> drückst du <b>Übernehmen</b>, bei <b>ANDERS</b> <b>Angleichen</b>. Zweck, Notiz und der Haken „Für ESPPDH-Geräte nutzbar“ bleiben dabei, wie sie sind. Mit <b>Alle übernehmen</b> geht alles auf einmal.</li>
      <li>Willst du einen Vorschlag nicht, drücke <b>Ausblenden</b>. Er kommt erst wieder, wenn er sich am Controller ändert.</li>
      <li><b>Neu abfragen</b> holt den aktuellen Stand vom Controller. Sonst gilt das Ergebnis 5 Minuten.</li>
    </ol>
    <p>Übernommene Einträge zeigen <b>aus UniFi</b> bzw. <b>aus Omada</b>. Gibt es einen Eintrag am Controller nicht mehr, steht <b>am Controller nicht mehr vorhanden</b> dabei – das PDH löscht nie von selbst etwas.</p>
    <p><b>WLAN-Kennwörter</b> – was die Hinweise in der Zeile bedeuten:</p>
    <ul>
      <li><b>„Kennwort ✓“:</b> Der Controller gibt das Kennwort heraus. Das PDH übernimmt es verschlüsselt mit.</li>
      <li><b>„Controller gibt das Kennwort nicht heraus – bitte von Hand eintragen“:</b> Nach dem Übernehmen das Kennwort über <b>Bearbeiten</b> eintragen.</li>
      <li><b>„offen“</b> (ohne Kennwort) oder <b>„Anmeldung mit Benutzer (Enterprise)“:</b> Solche WLANs sind <b>für ESPPDH nicht nutzbar</b>.</li>
      <li><b>„Kennwort geändert“</b> siehst du nur, wenn der Controller das Kennwort herausgibt.</li>
    </ul>
    <p>Den Haken „Für ESPPDH-Geräte nutzbar“ setzt das PDH <b>nie</b> von selbst.</p>
    <p><b>Wenn eine Zeile nicht übernommen wird:</b> Hat sich der Vorschlag inzwischen geändert (anderer Benutzer, neuer Stand am Controller), lehnt das PDH ab: „Der Vorschlag hat sich inzwischen geändert – bitte die Liste ansehen und erneut wählen.“ Es wurde dann nichts übernommen. Pro Controller steht bei einem Problem eine eigene Zeile, z. B. „UniFi-Network-Anwendung zu alt – Netze und WLANs gibt es ab Version 10.0“. Am Spiegelserver fragt der Block den Controller nicht ab und verweist auf den aktiven Server.</p></div>
  <div class="hb-howto"><b><i class="ti ti-sitemap"></i> So trägst du ein Netz ein</b>
    <ol class="hb-steps">
      <li><b>Neues Netz</b> drücken und einen <b>Namen</b> eintragen, z. B. „Büro“, „Maschinen“ oder „Gäste“.</li>
      <li>Wenn vorhanden die <b>VLAN-Nummer</b> (1 bis 4094) und den <b>Adressbereich</b> eintragen, z. B. <code>10.10.20.0/24</code>. Beides darf leer bleiben.</li>
      <li>Bei <b>Zweck</b> kurz notieren, was in diesem Netz hängt. <b>Anlegen</b>.</li>
    </ol>
    <p>Jede VLAN-Nummer und jeder Name kommt nur einmal vor.</p></div>
  <div class="hb-howto"><b><i class="ti ti-wifi"></i> So trägst du ein WLAN ein</b>
    <ol class="hb-steps">
      <li><b>Neues WLAN</b> drücken und den <b>WLAN-Namen (SSID)</b> genau so eintragen, wie ihn die Geräte sehen (Groß- und Kleinschreibung zählt).</li>
      <li>Das <b>Kennwort</b> eintragen (8 bis 63 Zeichen). Leer lassen nur bei einem offenen WLAN.</li>
      <li>Bei <b>Netz</b> wählen, in welchem Netz das WLAN landet. <b>Versteckt</b> ankreuzen, wenn das WLAN seinen Namen nicht aussendet.</li>
      <li>Nur wenn ESPPDH-Geräte in dieses WLAN sollen: <b>Für ESPPDH-Geräte nutzbar</b> ankreuzen (siehe unten). Sonst leer lassen.</li>
      <li><b>Anlegen</b>. Zum Ändern <b>Bearbeiten</b>: Bleibt das Kennwort-Feld leer, gilt das gespeicherte weiter.</li>
    </ol>
    <p>Das Kennwort wird verschlüsselt gespeichert und auf keiner Seite angezeigt – auch nicht für Administratoren. Wer es nachlesen muss, schaut am Access Point oder im Controller nach. <b>Ausnahme:</b> In der Firmware von ESPPDH-Geräten steht das Kennwort lesbar. Deshalb gibt es den Haken „Für ESPPDH-Geräte nutzbar“.</p></div>
  <p><b>ESPPDH-Geräte</b> nehmen ihr WLAN von hier – aber nur WLANs mit Haken <b>Für ESPPDH-Geräte nutzbar</b>. Ab Werk ist der Haken aus; ist er gesetzt, steht in der Liste <span class="badge b-blue">ESPPDH</span>. Beim Anlegen (<b>Neues Gerät</b>) und auf der Seite des Geräts wählst du eines dieser WLANs (<a href="#esppdh">mehr</a>). Name und Kennwort kommen beim Bau der Firmware von dieser Seite. Änderst du das Kennwort, zeigt die Seite des Geräts „Konfiguration seit dem letzten Bau geändert“ – dann die Firmware neu bauen und flashen.</p>
  <ul>
    <li><b>Wer ESPPDH-Geräte bauen darf, kann das WLAN-Kennwort lesen:</b> Er lädt die Firmware herunter, und darin steht es. Am besten ein eigenes WLAN nur für Geräte anlegen und nur dieses freigeben – nie das Büro-WLAN.</li>
    <li><b>Haken später entfernt:</b> Geräte in diesem WLAN lassen sich dann nicht mehr speichern und nicht mehr bauen; ihre Seite sagt „Das WLAN … ist nicht mehr für ESPPDH-Geräte freigegeben“. Schon gebaute Firmware lässt sich weiter herunterladen, und die Geräte behalten das Kennwort. Soll es niemand mehr nutzen können, das Kennwort am Access Point ändern.</li>
  </ul>
  <h3><i class="ti ti-server"></i> Dieser Server: Adresse und DNS</h3>
  <p>Die Karte <b>Dieser Server</b> zeigt die Netzwerkdaten des Servers: Netzwerkkarte, Adresse (<b>fest</b>, <b>automatisch (DHCP)</b> oder <b>unbekannt</b>), gemeinsame Adresse im Verbund und wo sie gerade liegt, Gateway, DNS-Server und IPv6. Im Verbund steht daneben die Karte des Partners; <b>Auf «Name» öffnen</b> führt zu dessen Seite. Die Karte des Partners zeigt „unbekannt“, bis beide Server auf dieser Version sind.</p>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> So stellst du die Adresse fest ein oder änderst die DNS-Server</b>
    <ol class="hb-steps">
      <li>Im Verbund <b>zuerst den Spiegel</b> ändern, dann den aktiven Server. Öffne die Seite dafür über die <b>eigene Adresse</b> des Servers, nicht über die gemeinsame.</li>
      <li>Auf der Karte <b>Jetzige Adresse fest einstellen</b> drücken (gibt es nur bei automatischer Adresse) oder <b>DNS-Server ändern</b> (1 bis 3 Adressen). Beim Ändern der DNS-Server wird die jetzige Adresse ebenfalls fest.</li>
      <li>Das PDH zeigt vorab, was passiert. Am aktiven Server ist die gemeinsame Adresse kurz weg, und der Ausfallschutz steht solange in Wartung. Die automatische Netzwerkeinrichtung des Servers (cloud-init) wird abgeschaltet.</li>
      <li>Das PDH prüft, ob jeder DNS-Server antwortet. Antwortet einer nicht, wird <b>nichts</b> geschrieben.</li>
      <li>Danach läuft ein <b>Countdown von 2 Minuten</b>. Kommt die Seite wieder, drücke <b>Seite erreichbar – Einstellung behalten</b>. Am aktiven Server erscheint der Knopf erst, wenn auch die gemeinsame Adresse wieder da ist – meist nach wenigen Sekunden; bis dahin steht dort „Die gemeinsame Adresse … ist noch nicht zurück“.</li>
    </ol>
    <p><b>Ohne Bestätigung</b> stellt der Server die vorige Einstellung nach den 2 Minuten selbst wieder her – auch wenn zwischendurch das PDH, der Update-Agent oder der ganze Server neu startet. Die Wartung des Ausfallschutzes schaltet er dann ebenfalls wieder aus, auch später, falls es nicht gleich ging. Eine Wartung, die jemand anderes eingeschaltet hat, bleibt unberührt.</p>
    <p>Steht kurz <b>„Stand gerade nicht lesbar – wird weiter abgefragt“</b>, baut der Server gerade seine Verbindung neu auf. Der Countdown läuft weiter, und du kannst trotzdem bestätigen.</p>
    <p><b>Gesperrt</b> ist die Änderung, solange ein PDH-Update, eine Wartung, ein Rollentausch oder eine frühere Änderung noch läuft. Am aktiven Server ist sie außerdem gesperrt, solange er den Partner nicht sieht („Der Partner-Server ist gerade nicht erreichbar …“) – dann zuerst die Verbindung der Server in Ordnung bringen. Es gibt die Änderung nur für Administratoren mit dem Recht „Server-Einstellungen“, nur auf Ubuntu-Servern, deren Netzwerk mit netplan eingerichtet ist (bei Ubuntu Server ab Werk so), und nicht im Docker-Testsystem (dort nur ein Hinweis). Die Adresse und das Gateway selbst lassen sich hier nicht ändern. Auf der Konsole geht es weiter mit <code>pdh-static-ip.sh</code> (siehe <a href="#ausfallschutz">Ausfallschutz</a>).</p></div>
  <h3>Rechte</h3>
  <ul>
    <li><b>Netzwerk: VLANs und WLANs pflegen</b> (<code>system.network</code>) – Seite sehen, auch die Karte „Dieser Server“ und die Vorschläge vom Controller, Netze und WLANs anlegen, übernehmen und ändern, auch den Haken „Für ESPPDH-Geräte nutzbar“ setzen. Adresse fest einstellen und DNS ändern dürfen nur Administratoren mit dem Recht „Server-Einstellungen“. Es haben automatisch alle Rollen, die die UniFi-Anbindung verwalten dürfen. Die Rechte von ESPPDH allein reichen dafür nicht.</li>
    <li><b>Netzwerk: VLANs und WLANs löschen</b> (<code>system.network_admin</code>, Bereichsadministrator) – endgültig löschen. Wird ein Netz gelöscht, bleiben seine WLANs und stehen danach ohne Netz da.</li>
  </ul>
  <p>Auf dem Spiegelserver ist die Seite nur zum Lesen da – bis auf die Karte <b>Dieser Server</b>: <b>Jetzige Adresse fest einstellen</b> und <b>DNS-Server ändern</b> gehen an jedem Server für diesen Server selbst. Vorschläge vom Controller übernimmst du am aktiven Server.</p>
  {{template "hb-shots" (dict "Ref" (index $s "netzwerk") "Can" $can)}}
</section>

<section class="hb-ch" id="server" data-title="Server-Einstellungen &amp; Ersteinrichtung" data-pages="server-config server-logs">
  <h2><i class="ti ti-adjustments-cog"></i> Server-Einstellungen &amp; Ersteinrichtung</h2>
  <p>Im Reiter <b>VPN</b> richtest du das WireGuard-VPN ins Maschinennetz ein (Dienst auf dem Server, Gateways, ausgehende Tunnel, alle Geräte) – siehe <a href="#hb-vpn-setup">VPN ins Maschinennetz</a>.</p>
  <h3><i class="ti ti-rocket"></i> Ersteinrichtung</h3>
  {{template "hb-fig-setup"}}
  <p>Beim allerersten Start braucht das PDH keine vorbereitete <code>.env</code>-Datei. Der Anmelde-Schlüssel wird automatisch erzeugt. Findet das PDH keine Datenbank oder noch keinen Benutzer, öffnet sich im Browser unter <code>http://&lt;server&gt;:8090/setup</code> der <b>Einrichtungsassistent</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-list-numbers"></i> So richtest du das PDH ein</b>
    <ol class="hb-steps">
      <li><b>Einrichtungscode</b> eingeben. Er schützt die Einrichtung vor Unbefugten und steht im Server-Protokoll (<code>docker compose logs app</code> bzw. <code>journalctl -u pdh</code>) und in der Datei <code>setup-code.txt</code>.</li>
      <li><b>Datenbank</b> (nur wenn keine erreichbar ist): <i>Automatisch anlegen</i> – mit dem PostgreSQL-Administrator (meist <code>postgres</code>) legt das PDH einen eigenen Datenbank-Benutzer mit sicherem Zufallspasswort und die Datenbank an. Oder <i>vorhandene Zugangsdaten</i> eintragen; fehlt nur die Datenbank, legt das PDH sie an. <b>Verbindung testen</b> prüft die Angaben vorab.</li>
      <li><b>Administrator</b> anlegen (Passwort mindestens 10 Zeichen) und die <b>öffentliche Adresse</b> bestätigen.</li>
      <li><b>Einrichtung abschließen</b> – das PDH legt die Datenbankstruktur an, startet und leitet zur Anmeldung weiter.</li>
    </ol></div>
  <p>Startet die Datenbank nur etwas später (z. B. nach einem Neustart des Servers), wartet der Assistent und macht von selbst weiter.</p>
  <h3><i class="ti ti-adjustments-cog"></i> Server-Einstellungen im Betrieb</h3>
  <p>Unter <b>Navigation → Server-Einstellungen</b> (nur Administratoren) stehen alle Werte, die früher von Hand in der <code>.env</code> gepflegt wurden – in Reitern: Server, Datenbank, Sicherheit, E-Mail, Copilot, Übersetzung, Microsoft 365, Nextcloud, Störungen, Cloudflare-Tunnel, Protokoll, Updates &amp; Sicherung. Dazu kommen eigene Reiter wie Erscheinungsbild, Passwörter, VPN, <b>UniFi</b> (nur mit dem Recht „Namen im Haus eintragen (UniFi)“), <b>Omada</b> (nur mit dem Recht „Omada-Controller anbinden“), <b>ESPPDH</b> (eigene Mess- und Zählgeräte, <a href="#esppdh">mehr</a>) und Ausfallschutz.</p>
  <p><b>Gespeichert wird in der Datenbank</b> – Passwörter, Schlüssel und Tokens verschlüsselt. In der <code>.env</code> bleiben nur der <b>Datenbank-Zugang</b> und der Schlüssel <code>PDH_SETTINGS_KEY</code>, ohne die das PDH die Datenbank nicht erreichen bzw. die Geheimnisse nicht entschlüsseln kann. <b>Diese Datei deshalb unbedingt mitsichern</b> – eine Datenbank-Sicherung allein genügt für die verschlüsselten Werte nicht.</p>
  <div class="hb-howto"><b><i class="ti ti-database-import"></i> Übernahme einer bestehenden .env</b>
    Beim Start überträgt das PDH alle Werte der <code>.env</code>, die noch nicht in der Datenbank stehen, automatisch dorthin und kommentiert sie in der Datei aus (daneben liegt eine Sicherungskopie <code>.env.bak-…</code>, die die alten Werte im Klartext enthält – nach Prüfung löschen). Trägt jemand später wieder einen Wert in die <code>.env</code> ein, zeigt die Seite einen Hinweis mit <b>jetzt übernehmen</b>. Werte, die Docker (<code>.env.docker</code>) oder systemd von außen setzen, haben Vorrang, bis du sie übernimmst (siehe unten).</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> So holst du Microsoft-, Nextcloud- und andere Zugangsdaten aus der .env.docker</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> öffnen. Stehen noch sicherheitsrelevante Werte in <code>.env.docker</code>, erscheint oben ein gelber Hinweis; die betroffenen Reiter haben einen gelben Punkt.</li>
      <li><b>Alle in die Datenbank übernehmen</b> – oder im Reiter (z. B. <b>Microsoft 365</b>) <b>In die Datenbank übernehmen</b>. Die Werte werden verschlüsselt gespeichert und gelten ab sofort aus der Datenbank; die Felder sind jetzt bearbeitbar.</li>
      <li>Im Reiter <b>Verbindung testen</b> (Microsoft 365, Nextcloud, Übersetzung, E-Mail, Datenbank, Copilot). Der Punkt am Reiter wird <span style="color:var(--green)">grün</span>.</li>
      <li>Bei Grün erscheint <b>Aus .env.docker entfernen</b>: Der Update-Agent kommentiert die Zeilen in <code>.env.docker</code> aus – ohne den Wert. Ohne Update-Agent die Zeilen von Hand löschen.</li>
    </ol>
    In <code>.env.docker</code> bleiben nur Werte, die Docker selbst braucht: Datenbank-Zugang, Update-Agent-Token, Grafana-Passwörter, Port und Projektname. Den Schlüssel <code>PDH_SETTINGS_KEY</code> (in <code>pdh.env</code> bzw. <code>.env</code>) unbedingt mitsichern – ohne ihn sind die verschlüsselten Werte nach einer Wiederherstellung nicht lesbar.</div>
  <table>
    <tr><td><span class="rec-sub">Datenbank</span></td><td>in der Datenbank gespeichert – hier änderbar</td></tr>
    <tr><td><span class="rec-sub">Datei</span></td><td>steht (noch) in der Einstellungsdatei – beim Datenbank-Zugang immer so</td></tr>
    <tr><td><span class="rec-sub">Standard</span></td><td>nicht gesetzt, es gilt der Standardwert</td></tr>
    <tr><td><span class="rec-sub">Umgebung</span></td><td>von außen vorgegeben (Docker <code>.env.docker</code>, systemd) – hat Vorrang vor der Datenbank und ist hier nur lesbar. Leere Einträge wie <code>PDH_COPILOT_ANTHROPICKEY=</code> zählen nicht, dann gilt der Wert aus der Datenbank</td></tr>
    <tr><td><i class="ti ti-refresh"></i></td><td>wirkt erst nach einem <b>Neustart</b> – der Knopf <b>Server neu starten</b> erledigt das in wenigen Sekunden</td></tr>
  </table>
  <p>Steht oben rot <b>„Die Einstellungsdatei ist für den PDH-Dienst nicht beschreibbar“</b>, nennt die Meldung den Grund – etwa „Die Datei gehört „root“, PDH läuft als „michael“.“ – und den Befehl, der das am Server behebt. Eine gelbe Meldung warnt, wenn die Datei für andere Benutzer des Servers lesbar ist; sie enthält Kennwörter und Schlüssel, deshalb den angezeigten Befehl <code>sudo chmod 600 …</code> ausführen.</p>
  <div class="hb-howto"><b><i class="ti ti-user-shield"></i> So richtest du den PDH-Administrator in Nextcloud ein</b>
    <p><b>Meist ist nichts zu tun.</b> Liegt Nextcloud auf demselben Server und kennt das PDH noch keinen Nextcloud-Benutzer, richtet es das Konto <b>pdhNCadmin</b> selbst ein – wenige Minuten nach dem Start, danach alle 15 Minuten, bis es klappt. Es übernimmt dabei die Adresse, die in Nextcloud eingetragen ist, wenn oben noch keine steht, und meldet das allen Administratoren. Die Karte zeigt solange den Hinweis mit der Uhr. Danach einmal <b>Neu starten</b>. Ablage und Deck schaltet das PDH dabei nicht von selbst ein. Von Hand geht es so:</p>
    <ol class="hb-steps">
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b>: oben die <b>Nextcloud-Adresse</b> eintragen und speichern.</li>
      <li>Karte <b>PDH-Administrator in Nextcloud</b> → Benutzername (Vorgabe <b>pdhNCadmin</b>) → <b>In Nextcloud einrichten</b>. Das PDH legt das Konto als Nextcloud-Admin an, erzeugt ein zufälliges Passwort und trägt Benutzer und Passwort selbst bei <b>Benutzer</b> / <b>App-Passwort</b> ein.</li>
      <li>Oben <b>Neu starten</b>, damit Ablage und Deck das Konto übernehmen.</li>
    </ol>
    Klappt das Einrichten nicht, steht der Grund rot in der Karte unter <b>Letzter Versuch</b>. Häufig hängt Nextcloud im Wartungsmodus (Meldung „503“): Dann auf dem Server <code>sudo -u www-data php /var/www/nextcloud/occ maintenance:mode --off</code> ausführen und erneut einrichten.
    Der Eintrag <b>Nextcloud</b> in der Navigation (Gruppe „Hilfe &amp; Links“) öffnet die <b>Nextcloud-Adresse</b> aus diesem Reiter. Ist keine eingetragen, fehlt der Eintrag.
    Das Passwort kennt nur das PDH. Alle 6 Stunden prüft es die Anmeldung. Hat jemand das Passwort in Nextcloud geändert oder das Konto aus der Gruppe <b>admin</b> genommen, setzt das PDH sein Passwort und die Rechte wieder und meldet das allen Administratoren. <b>Neues Passwort</b> tauscht es jederzeit aus. <b>Nicht mehr verwalten</b> beendet den Abgleich, Konto und Passwort bleiben. Braucht den Update-Agenten und Nextcloud auf demselben Server. Gilt in Nextcloud Zwei-Faktor-Pflicht für Admins, das Konto davon ausnehmen.</div>
  <div class="hb-howto" id="hb-nc-sync"><b><i class="ti ti-arrows-exchange"></i> So gleichst du Benutzer, Rollen und Gruppen mit Nextcloud ab</b>
    <p>Das PDH hat Vorrang. Es überträgt seine Benutzer nach Nextcloud und überschreibt dort, was abweicht.</p>
    <ol class="hb-steps">
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b> → Karte <b>Abgleich mit Nextcloud</b> → <b>Einschalten</b>. Hat das PDH eine neue Nextcloud selbst verbunden, ist der Abgleich schon an.</li>
      <li>Der erste Lauf beginnt nach wenigen Sekunden. Danach läuft er alle 30 Minuten und etwa 20 Sekunden nach jeder Änderung an Benutzern, Gruppen, Abteilungen, Rollen oder Netzlaufwerken. <b>Jetzt abgleichen</b> startet ihn sofort.</li>
      <li>Die Karte zeigt den letzten Lauf: Personen, angelegte, geänderte und gesperrte Konten, rot die Fehler, gelb die Hinweise.</li>
    </ol>
    <ul>
      <li><b>Konten:</b> Jeder aktive Benutzer bekommt ein Nextcloud-Konto (Terminal-Konten nicht). Name, E-Mail und Sprache kommen aus dem PDH. Wer im PDH deaktiviert wird, ist in Nextcloud gesperrt – gelöscht wird nie.</li>
      <li><b>Microsoft:</b> Ist die Person einem Microsoft-Konto zugeordnet und „Mit Microsoft anmelden“ für Nextcloud eingerichtet, ist ihre Microsoft-E-Mail die Nextcloud-Benutzer-ID. Sie meldet sich dann ohne eigenes Passwort an.</li>
      <li><b>Passwort:</b> Sonst setzt du in der Benutzerkarte mit <b>Neues Startpasswort</b> ein Passwort. Es wird nur einmal angezeigt.</li>
      <li><b>Gruppen:</b> In Nextcloud entstehen die Gruppen „PDH“ (alle), „PDH-Rolle: …“, „Abteilung: …“ und „Gruppe: …“. Wer dort Mitglied ist, bestimmt allein das PDH. Benennst du im PDH um, heißt die Gruppe in Nextcloud genauso; löschst du sie, verschwindet sie dort. Eigene Nextcloud-Gruppen bleiben unberührt.</li>
      <li><b>Administratoren:</b> In Nextcloud ist Administrator, wer im PDH die Rolle Administrator hat <b>und</b> in der Benutzerkarte den Haken <b>Administrator in Nextcloud</b> trägt. Den Haken setzen nur Administratoren. Ohne Haken nimmt der Abgleich der Person die Administrator-Rechte in Nextcloud. Beim <b>Einschalten</b> sperrt sich niemand aus: PDH-Administratoren, deren verknüpftes Nextcloud-Konto dort schon Administrator ist, bekommen den Haken von selbst, und die Meldung nennt ihre Namen. Wer es nicht bleiben soll, bekommt den Haken danach in der Benutzerkarte wieder weg. Das Dienstkonto des PDH bleibt immer Administrator.</li>
      <li><b>Apps:</b> Liegt Nextcloud auf demselben Server, richtet der Abgleich die Apps ein, die das PDH braucht: Kalender und Kontakte immer, Deck mit eingeschaltetem Deck-Abgleich, „External storage“ mit einem freigegebenen Netzlaufwerk, „OpenID Connect“ mit der Microsoft-Anmeldung. Er schaltet nie eine App ab. Administratoren installieren in Nextcloud wie gewohnt weitere Apps.</li>
      <li><b>Vorhandene Konten:</b> Gibt es in Nextcloud schon ein Konto mit demselben Namen, wird es übernommen. Ist es dort Administrator und fehlt der Haken, bleibt es unberührt, und die Karte nennt es gelb.</li>
    </ul>
    <b>Ausschalten</b> beendet den Abgleich. Konten, Gruppen und Laufwerke in Nextcloud bleiben dann, wie sie sind. Einschalten und starten darf, wer das Recht <b>Nextcloud-Abgleich einstellen und starten</b> hat. Am Spiegel und während der Wartung läuft kein Abgleich.</div>
  <div class="hb-howto"><b><i class="ti ti-palette"></i> So bekommt Nextcloud den PDH-Look</b>
    <ol class="hb-steps">
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b>. Unten zeigt die Karte <b>Nextcloud im PDH-Look</b> die Vorschau: Name, Firmenfarbe und Logo aus dem Reiter <b>Erscheinungsbild</b>.</li>
      <li><b>An Nextcloud übertragen</b> – dafür braucht der eingetragene Nextcloud-Benutzer Admin-Rechte in Nextcloud.</li>
      <li>Klappt das bei eurer Nextcloud-Version nicht: <b>occ-Skript herunterladen</b>, auf den Nextcloud-Server kopieren und dort <code>sudo bash nextcloud-theming-pdh.sh /var/www/nextcloud</code> ausführen.</li>
      <li>Nextcloud im Browser neu laden (Strg+F5).</li>
    </ol>
    Ändert sich das Erscheinungsbild des PDH (Farbe, Logo, Name), einfach erneut übertragen.</div>
  <div class="hb-howto" id="hb-nc-mail"><b><i class="ti ti-mail-forward"></i> So verschickt Nextcloud Mails über das PDH</b>
    <p>Nextcloud schickt Mails für neue Konten, Freigaben, „Passwort vergessen“ und Benachrichtigungen. Damit sie immer auf demselben Weg gehen wie die Mails des PDH – auch über Microsoft 365 –, nimmt das PDH sie auf dem eigenen Server an (die <b>Mail-Brücke</b>) und gibt sie weiter.</p>
    <ol class="hb-steps">
      <li>Zuerst im Reiter <b>E-Mail</b> den Mailversand einrichten und mit <b>Testmail an mich</b> prüfen. Ohne Mailversand im PDH zeigt die Karte den Hinweis „Erst Mailversand im PDH einrichten“.</li>
      <li>Server-Einstellungen → Reiter <b>Nextcloud</b> → Karte <b>Mailversand über das PDH</b> → <b>Mailversand über das PDH einrichten</b>. Das trägt die Brücke in Nextcloud ein. Liegt Nextcloud auf demselben Server, macht das PDH es nach dem Start auch von selbst.</li>
      <li>Die Karte zeigt, ob die Brücke läuft, wann Nextcloud zuletzt angeschlossen wurde, wann die letzte Mail weitergegeben wurde und – falls etwas schiefging – den letzten Fehler. Die Einzelheiten stehen im Server-Protokoll (Bereich „mail“).</li>
    </ol>
    <ul>
      <li><b>Immer gleich:</b> Ändert jemand im Reiter <b>E-Mail</b> den Versandweg (SMTP-Server, Verschlüsselung oder Microsoft 365), gilt das sofort auch für Nextcloud – ohne Neustart und ohne Nacharbeit.</li>
      <li><b>Absender:</b> Die Mails kommen von der Absenderadresse des PDH. Der Name („Nextcloud“) bleibt; die ursprüngliche Nextcloud-Adresse steht als Antwortadresse darin. Anhänge bleiben unverändert.</li>
      <li><b>Sicher:</b> Die Brücke hört nur auf diesem Server (127.0.0.1) zu und verlangt eine Anmeldung mit einem zufälligen Passwort, das verschlüsselt im PDH liegt. Sie nimmt höchstens 25 MB je Mail, 50 Empfänger je Mail und 300 Mails je Stunde an. Eine andere als eine lokale Adresse lehnt das PDH ab.</li>
      <li><b>Pausen:</b> Am Spiegelserver und während der Wartung nimmt die Brücke nichts an; Nextcloud versucht es später erneut.</li>
      <li><b>Microsoft 365:</b> Geht der Versand über Microsoft 365, landen die Mails von Nextcloud unter „Gesendete Elemente“ des PDH-Postfachs. Mails über 4 MB (Anhänge eingerechnet) nimmt Microsoft nicht an.</li>
      <li><b>Port belegt:</b> Belegt auf dem Server ein anderes Programm den Port der Brücke, meldet die Karte „Port belegt – Nextcloud-Mails gehen nicht über das PDH“; ein fremdes lokales Programm auf diesem Port könnte sonst Nextcloud-Mails mitlesen, darum den Port frei halten oder in den Server-Einstellungen eine andere lokale Adresse eintragen.</li>
      <li><b>Adresse ändern oder abschalten:</b> Reiter <b>E-Mail</b> → <b>Mail-Brücke für Nextcloud</b> (Standard <code>127.0.0.1:2525</code>, „aus“ schaltet ab), speichern und das PDH neu starten; danach den Knopf in der Karte erneut drücken.</li>
    </ul>
    Den Knopf und die Anzeige sieht und bedient, wer die Server-Einstellungen öffnen darf.</div>
  <div class="hb-howto"><b><i class="ti ti-mail"></i> Beispiel: E-Mail-Versand einrichten</b>
    <ol class="hb-steps">
      <li>Reiter <b>E-Mail</b>: SMTP-Server, Port, Verschlüsselung, Benutzer, Passwort und Absender eintragen.</li>
      <li><b>Speichern</b> – E-Mail-Einstellungen gelten sofort.</li>
      <li><b>Testmail an mich</b> schickt eine Nachricht an deine eigene Adresse.</li>
    </ol>
    „Passwort vergessen?“ verschickt seine Links nur, wenn E-Mail eingerichtet ist und im Reiter <b>Server</b> die <b>Öffentliche Adresse</b> steht. Der Link wird bewusst nur daraus gebaut, nie aus der Adresse der Anfrage.</div>
  <div class="hb-howto"><b><i class="ti ti-brand-windows"></i> So versendest du E-Mails über Microsoft 365</b>
    <ol class="hb-steps">
      <li>Im Microsoft Entra Admin Center die App-Registrierung des PDH öffnen → <b>API-Berechtigungen</b> → <b>Microsoft Graph</b> → <b>Anwendungsberechtigungen</b> → <b>Mail.Send</b> hinzufügen und <b>Administratorzustimmung erteilen</b>.</li>
      <li>Im Reiter <b>Microsoft 365</b> müssen Tenant-ID, Client-ID und Client-Secret dieser App stehen.</li>
      <li>Reiter <b>E-Mail</b>: <b>Versandweg</b> auf <code>graph</code> stellen und als <b>Absender</b> das Postfach eintragen, aus dem der PDH sendet (z. B. <code>pdh@firma.de</code>). SMTP-Server, Benutzer und Passwort bleiben leer.</li>
      <li><b>Speichern</b> und <b>Testmail an mich</b> schicken.</li>
    </ol>
    Dafür muss „Authentifiziertes SMTP“ im Tenant nicht eingeschaltet sein. Mail.Send erlaubt der App zunächst das Senden aus jedem Postfach – deine Microsoft-Administration kann das per Zugriffsrichtlinie auf das PDH-Postfach beschränken.</div>
  <div class="hb-howto"><b><i class="ti ti-password"></i> So stellst du die Passwort-Richtlinie ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Passwörter</b> öffnen.</li>
      <li><b>Mindestlänge</b> (8–72), <b>Höchstalter</b> in Tagen (0 = läuft nie ab) und <b>Wiederverwendung sperren</b> (die letzten N Passwörter, 0 = aus) eintragen.</li>
      <li>Ankreuzen, was das Passwort braucht: <b>Großbuchstaben</b>, <b>Kleinbuchstaben</b>, <b>Ziffer</b>, <b>Sonderzeichen</b>.</li>
      <li>Festlegen, wann gewechselt werden muss: bei der <b>Erstanmeldung</b> und/oder nachdem ein <b>Administrator das Passwort</b> geändert hat. Mit <b>jetzt alle Benutzer … zum Wechsel zwingen</b> müssen einmalig alle mit Passwort beim nächsten Anmelden ein neues vergeben.</li>
      <li><b>Speichern</b> – die Richtlinie gilt sofort für jedes neue Passwort, ein Neustart ist nicht nötig. Bestehende Passwörter bleiben gültig, bis sie geändert werden oder ablaufen.</li>
    </ol>
    Unter dem Knopf steht, wie viele Benutzer ihr Passwort gerade ändern müssen.</div>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So prüfst du den Copilot-Zugang</b>
    <ol class="hb-steps">
      <li>Reiter <b>Copilot</b> → <b>Verbindung testen</b>.</li>
      <li>Oben steht, mit welchem Schlüssel der Server <b>gerade läuft</b> und welcher <b>eingestellt</b> ist, mit Quelle (Datenbank oder Umgebung). Angezeigt werden nur Anfang, Ende und Länge des Schlüssels.</li>
      <li>Darunter steht, ob Anthropic den Schlüssel annimmt und ob das eingestellte Modell verfügbar ist. Der Test kostet nichts.</li>
    </ol>
    Typische Ursachen für <i>„API key is invalid“</i>: Der neue Schlüssel ist gespeichert, aber der Server wurde <b>nicht neu gestartet</b>. Oder in <code>.env.docker</code> steht noch ein <b>alter Schlüssel</b>, der Vorrang vor der Datenbank hat – der Test zeigt das an. Oder der Schlüssel wurde in der Claude Console widerrufen bzw. unvollständig kopiert – dann einen neuen erzeugen und eintragen.</div>
  <div class="hb-howto"><b><i class="ti ti-language"></i> So richtest du den Dienst für die Live-Übersetzung ein</b>
    <ol class="hb-steps">
      <li>Reiter <b>Übersetzung</b>: Bei <b>Dienst</b> „auto“ lassen (empfohlen) oder „deepl“ bzw. „copilot“ wählen.</li>
      <li>Für DeepL den <b>DeepL-API-Schlüssel</b> aus dem DeepL-Konto eintragen (kostenlose Schlüssel enden auf <code>:fx</code>). Ohne Schlüssel übersetzt der Copilot-Anbieter (Reiter Copilot).</li>
      <li><b>Speichern</b> – wirkt sofort.</li>
    </ol>
    Bei „auto“ übersetzt DeepL alle Sprachen, die es kann; Mazedonisch, Kroatisch, Serbisch, Bosnisch, Albanisch, Persisch und Vietnamesisch übernimmt der Copilot. Fällt DeepL aus, springt der Copilot ein. Jeder Text wird je Sprache nur einmal übersetzt und für alle Benutzer zwischengespeichert; ein halbes Jahr nicht mehr gebrauchte Übersetzungen werden gelöscht.</div>
  <div class="hb-howto" id="hb-cloudflare-api"><b><i class="ti ti-world-cog"></i> So pflegst du DNS, Proxy und Tunnel-Ziele bei Cloudflare im PDH</b>
    <ol class="hb-steps">
      <li>Im Cloudflare-Dashboard oben rechts <b>Mein Profil → API-Tokens → Token erstellen</b>. Rechte: <b>Zone lesen</b>, <b>DNS bearbeiten</b>, <b>Zonen-Einstellungen bearbeiten</b> (Zone) und <b>Cloudflare Tunnel bearbeiten</b> (Konto). Auf die eigene Domain beschränken. Den Wert einmal kopieren.</li>
      <li>Server-Einstellungen → Reiter <b>Cloudflare-Tunnel</b>: <b>API-Token</b> und <b>Domain</b> (z. B. <code>firma.de</code>) eintragen und speichern. Der Token wird verschlüsselt gespeichert.</li>
      <li>In der Karte <b>DNS, Proxy und Tunnel-Ziele</b> auf <b>Stand von Cloudflare laden</b>.</li>
      <li><b>PDH, Nextcloud und MQTT über den Tunnel:</b> Die Tabelle zeigt für den Hostnamen des PDH, die Nextcloud-Adresse und jeden <a href="#mqttbroker">MQTT-Broker mit eigenem Namen</a>, ob das Ziel im Tunnel und der DNS-Name stimmen. <b>Einrichten</b> legt beides an. Zeigt ein DNS-Eintrag woanders hin, fragt das PDH vorher nach.</li>
      <li><b>Ziele im Tunnel:</b> Öffentlichen Namen und Ziel am Server eintragen (z. B. <code>http://localhost:80</code>) → <b>Ziel speichern</b>. Das PDH legt den DNS-Namen gleich mit an. Bei einem selbst ausgestellten Zertifikat am Ziel „Zertifikat des Ziels nicht prüfen“ anhaken.</li>
      <li><b>Verschlüsselung der Domain:</b> Zwischen Cloudflare und Server wählen (empfohlen: Full oder Full strict) und „immer HTTPS“. Das gilt für die ganze Domain.</li>
      <li><b>DNS-Einträge:</b> Einträge der Arten A, AAAA, CNAME und TXT anlegen und löschen. Ein Klick auf <b>an</b>/<b>aus</b> in der Spalte Proxy schaltet um, ob der Name über Cloudflare läuft oder direkt auf den Server zeigt. Namen, die auf den Tunnel zeigen, laufen immer über den Proxy.</li>
    </ol>
    Das PDH ändert bei Cloudflare nichts von selbst – mit einer Ausnahme: Wird ein MQTT-Name scharf oder ändert sich sein WebSocket-Port, schreibt es dessen Tunnel-Zeile selbst (einen fremden DNS-Eintrag ersetzt es nie). Die Ziele im Tunnel heißen <code>127.0.0.1</code> statt <code>localhost</code>, weil <code>localhost</code> am Server oft zuerst die IPv6-Adresse ist. Jede Änderung geht als Nachricht an alle Administratoren und steht im Protokoll. Auch die Meldungen der Karte selbst (z. B. ein fehlendes Recht am Token) stehen im Protokoll, Bereich <b>cloudflare</b>. Die Karte sieht, wer das Recht <b>Cloudflare verwalten (DNS, Proxy, Tunnel)</b> hat. Meldet die Karte „lehnt den API-Token ab“, fehlt dem Token ein Recht oder die Domain. Die Ziele im Tunnel brauchen zusätzlich den Tunnel-Token. Zertifikate von Let's Encrypt holt das PDH ebenfalls über diese Anbindung – siehe <a href="#hb-zertifikate">Zertifikate, Namen im Haus und Full (strict)</a>.</div>
  <div class="hb-howto" id="hb-cloudflare-mtls"><b><i class="ti ti-shield-lock"></i> So behebst du: Nextcloud-App fragt über das Internet nach einem Zertifikat</b>
    <b>Ursache:</b> Bei Cloudflare ist für den Namen der Nextcloud „mTLS“ (Client-Zertifikate) eingeschaltet. Dann verlangt Cloudflare von jedem Gerät ein Zertifikat, das Cloudflare selbst ausgestellt hat. Die Zertifikate des PDH kennt Cloudflare nicht – die App fragt nach einem Zertifikat, das es nicht gibt. Ohne mTLS schützt von außen die Anmeldung; im Firmennetz gilt weiter die Zertifikatspflicht von nginx.
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Reiter Cloudflare-Tunnel</b> öffnen. Das Cloudflare-Token muss eingetragen sein.</li>
      <li>In der Karte <b>Client-Zertifikate bei Cloudflare (mTLS)</b> auf <b>mTLS-Stand laden</b> drücken.</li>
      <li>Die Liste zeigt je Name, ob mTLS an ist. Die Namen des PDH sind mit <i>PDH-Adresse</i> bzw. <i>Nextcloud-Adresse</i> gekennzeichnet.</li>
      <li>Beim Namen der Nextcloud auf <b>Abschalten</b> drücken und bestätigen. Nur dieser eine Name wird aus der Liste genommen. Alle Administratoren bekommen eine Nachricht.</li>
      <li>Steht danach ein Hinweis zu einer WAF-Regel, sperrt diese Regel weiter. Das PDH ändert keine Regeln – im Cloudflare-Dashboard unter <b>Sicherheit → WAF → Benutzerdefinierte Regeln</b> die Regel prüfen und abschalten.</li>
      <li>Die App auf dem Handy neu öffnen. Mit <b>Einschalten</b> lässt sich mTLS für einen Namen wieder zurückholen.</li>
    </ol>
    Fehlen dem Token Rechte, sagt die Karte das: Es braucht „SSL and Certificates: Edit“ (Zone) zum Ändern und „Zone WAF: Read“ zum Anzeigen der Regeln.
  </div>
  {{template "hb-fig-zertifikate"}}
  <div class="hb-howto" id="hb-zertifikate"><b><i class="ti ti-certificate"></i> Zertifikate, Namen im Haus und Full (strict) – nur ein Zusatz</b>
    Das ist ein <b>Zusatz wie Cloudflare auch</b>. Das PDH läuft ohne ihn unverändert weiter – nichts davon ist nötig.
    <ul>
      <li><b>Ohne Zertifikate</b> von Let's Encrypt arbeitet das PDH wie bisher.</li>
      <li><b>Ohne UniFi</b> trägst du die Namen im Haus von Hand am DNS-Server des Hauses ein: je Name ein Eintrag Typ A auf die mitwandernde Adresse des Servers. Die Karte zeigt dir die Liste.</li>
      <li><b>Ohne Cloudflare</b> gibt es diesen Weg zu Zertifikaten nicht. Die Prüfung läuft über einen DNS-Eintrag bei Cloudflare.</li>
    </ul>
    Die Karte <b>Zertifikate (Let's Encrypt)</b> steht in den Server-Einstellungen im Reiter <b>Cloudflare-Tunnel</b> unter <b>DNS, Proxy und Tunnel-Ziele</b> und lädt erst auf den Knopf <b>Zertifikate laden</b>. Dafür reicht das Recht „Zertifikate verwalten (Let's Encrypt)“ – das Cloudflare-Recht brauchst du nicht. Zum Holen braucht das PDH einen gespeicherten Cloudflare-API-Token mit <b>DNS bearbeiten</b>. Ohne Token zeigt die Karte nur den Hinweis zum Einrichten und die eingetragenen Namen, die du dort entfernen kannst.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> So holst du ein Zertifikat</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Reiter Cloudflare-Tunnel</b> öffnen und <b>Zertifikate laden</b> drücken.</li>
      <li>In der Karte <b>Zertifikate (Let's Encrypt)</b> die <b>E-Mail für Let's Encrypt</b> eintragen und <b>Speichern</b>.</li>
      <li>Zum Üben den Haken <b>Testumgebung (zum Ausprobieren)</b> setzen und speichern. Test-Zertifikate vertrauen Browser nicht und zeigen eine Warnung.</li>
      <li>Bei <b>Weiterer Name</b> den Namen eintragen (z. B. <code>pdh.firma.de</code>) und <b>Eintragen</b> drücken – oder einen <b>Vorschlag</b> anklicken.</li>
      <li><b>Jetzt holen</b> drücken. Die Zeile zeigt den Schritt (<i>wird geholt</i>); die Seite muss nicht offen bleiben. Danach steht dort <i>gültig bis …</i>.</li>
      <li>Für echte Zertifikate den Haken <b>Testumgebung</b> entfernen und speichern, den Namen mit dem Papierkorb-Knopf <b>Entfernen</b> und neu eintragen. Die Testumgebung gilt in dem Moment, in dem ein Name eingetragen wird. Entfernen darf nur, wer das Recht „Zertifikate: entfernen und widerrufen (Bereichsadministrator)“ hat.</li>
    </ol>
    <b>Erneuern und Warnungen:</b> Das PDH erneuert ein Zertifikat 30 Tage vor Ablauf von selbst (bei kurzlebigen Zertifikaten, wenn noch ein Drittel der Laufzeit bleibt). Es prüft 2 Minuten nach dem Start und danach alle 24 Stunden – nicht auf dem Spiegelserver und nicht im Wartungsfenster. Warnungen kommen ab 14 Tagen vor Ablauf, ab 7 Tagen täglich und bei Ablauf (beim nächsten Tagescheck, also bis zu 24 Stunden später). Es zählt das Zertifikat, das auf dem Server wirklich eingerichtet ist: Lässt sich ein erneuertes nicht einrichten, warnt das PDH nach dem Ablauf des bisherigen. Antwortet der Update-Agent nicht und ist ein erneuertes Zertifikat nach 24 Stunden noch nicht eingerichtet, bekommen die Administratoren einmal am Tag eine Nachricht.
    <br><b>Wo die Dateien liegen:</b> Je Name gibt es ein Zertifikat, die Dateien liegen unter <code>/etc/ssl/pdh/&lt;Name&gt;/</code>. Der Update-Agent schreibt sie und lädt nginx neu. Besteht <code>nginx -t</code> nicht, nimmt er alles zurück.
    <ul>
      <li><b>Für den PDH-Namen</b> schreibt der Agent eine eigene nginx-Seite. Steht in den Server-Einstellungen im Reiter Cloudflare-Tunnel als Ziel am Server <code>http://localhost:80</code> (der Tunnel erreicht das PDH über nginx), leitet die Seite Port 80 nicht auf https um. Maßgeblich ist diese Einstellung, nicht das Ziel, das bei Cloudflare eingetragen ist. Eine <code>pdh.conf</code>, die er nicht selbst geschrieben hat, fasst er nie an; bedient schon eine andere Seite den Namen, auch nicht.</li>
      <li><b>Für Nextcloud</b> tauscht er die beiden Zertifikatszeilen der vorhandenen Nextcloud-Seite aus. Eine Seite mit Port-80-Weiterleitung und einem Block für Port 443 geht auch. Hat die Seite nicht genau ein Zertifikat – z. B. die Standardseite aus dem Installationsskript, die nur Port 80 bedient – oder bedient die Datei auch andere Namen, bleibt sie unverändert. Eine Nextcloud-Seite legt der Agent nie selbst an.</li>
      <li><b>Kann der Agent die Seite nicht selbst einrichten</b> (fremde Seite, kein passendes Zertifikat in der Nextcloud-Seite, nginx fehlt noch), legt er die Zertifikatsdateien trotzdem ab und lädt nginx neu. Die Zeile in der Karte zeigt dann einen Hinweis, z. B. „Zertifikat liegt unter /etc/ssl/pdh/nc.firma.de/. Nextcloud-Seite hat nicht genau ein Zertifikat – nicht geändert (Datei nextcloud.conf). Bitte das Zertifikat dort von Hand eintragen.“ Trage die beiden Dateien <code>fullchain.pem</code> und <code>privkey.pem</code> dann von Hand in deine Seite ein. Erneuerungen kommen von selbst an die gleiche Stelle. Fehlt nginx, richtet das nächste Update es ein; danach richtet das PDH die Seite für den PDH-Namen beim nächsten Tagescheck selbst ein. Für Nextcloud bleibt es beim Hinweis, bis es eine Nextcloud-Seite mit Zertifikat gibt.</li>
      <li><b>Nach einem Rollentausch oder dem Rückspielen einer Sicherung</b> prüft der Tagescheck, ob noch eine nginx-Seite auf das Zertifikat verweist. Fehlt die Seite des PDH bzw. die Zertifikatszeilen der Nextcloud, richtet der Agent sie neu ein.</li>
    </ul>
    <b>Entfernen:</b> Solange <b>Full (strict)</b> eingeschaltet ist, geht es nicht. Die Karte meldet: „Full (strict) ist eingeschaltet. Zuerst „Zurückstellen“, dann den Namen entfernen“. Nutzt noch eine nginx-Seite das Zertifikat, lehnt der Agent ab („– nicht geändert“, mit Dateiname). Beim Entfernen gehen Seite bzw. Zertifikatszeilen auf den Stand davor zurück, die Dateien werden gelöscht und das Zertifikat wird bei Let's Encrypt widerrufen. Zeigt die Nextcloud-Seite inzwischen auf ein anderes Zertifikat, bleibt sie unverändert. Entfernen geht auch ohne Cloudflare-API-Token. Scheitert der Widerruf, wird der Name trotzdem entfernt und das Zertifikat läuft einfach ab.</div>
  <div class="hb-howto"><b><i class="ti ti-router"></i> So zeigen die Namen im Haus auf den Server</b>
    Im Firmennetz sollen die Namen direkt auf den Server zeigen, von außen weiter über Cloudflare. Dafür braucht jeder Name am DNS-Server des Hauses einen Eintrag Typ A auf die mitwandernde Adresse. Mit einer UniFi UDM Pro übernimmt das PDH das. Adresse und API-Schlüssel der UDM Pro trägst du in den Server-Einstellungen im eigenen Reiter <b>UniFi</b> ein. Den Reiter sieht, wer das Recht „Namen im Haus eintragen (UniFi)“ hat.
    <ol class="hb-steps">
      <li>In UniFi Network einen <b>API-Schlüssel</b> für die Netzwerk-Anwendung anlegen. Wo das geht, hängt von der Version ab – siehe die Hilfe von UniFi.</li>
      <li><b>Server-Einstellungen → Reiter UniFi</b> öffnen. <b>Adresse der UDM Pro</b> (z. B. <code>https://192.168.1.1</code>) und <b>API-Schlüssel</b> eintragen, bei Bedarf den <b>Standort</b>, und <b>Speichern</b>. Der Schlüssel wird verschlüsselt gespeichert und nie wieder angezeigt.</li>
      <li>Den angezeigten <b>Fingerabdruck</b> mit dem Zertifikat vergleichen, das der Browser auf der UDM Pro zeigt (SHA-256), und <b>Bestätigen</b>.</li>
      <li>In den Reiter <b>Cloudflare-Tunnel</b> wechseln und in der Karte <b>Zertifikate (Let's Encrypt)</b> je Name den Knopf <b>Im Haus eintragen</b> (Haus-Symbol) drücken. Kontrolle: Die Zeile zeigt <i>im Haus direkt</i> statt <i>über Cloudflare</i>. Die Anzeige kann einen Moment nachhängen, weil das PDH den DNS selbst fragt.</li>
    </ol>
    Mit einem anderen DNS-Server trägst du den Eintrag Typ A von Hand ein; die Liste steht in der Zertifikate-Karte unter <b>Namen im Haus</b>. Ist bei der mitwandernden Adresse ein <b>IPv6-Ende</b> eingetragen, steht dort auch der IPv6-Eintrag (Typ AAAA) zum Eintragen von Hand. Er ändert sich, wenn der Anbieter das Präfix wechselt – dann musst du ihn nachtragen.
    <br><b>IPv6 mit UniFi</b>
    <ul>
      <li>Alle 5 Minuten trägt das PDH an der UDM Pro für <b>jeden</b> Namen, der auf die mitwandernde Adresse zeigt, einen IPv6-Eintrag (Typ AAAA) ein. Das gilt auch für Namen, die du dort von Hand angelegt hast und die das PDH sonst nicht verwaltet. Wechselt der Anbieter das Präfix, zieht das PDH den Eintrag nach.</li>
      <li>Ein von Hand angelegter IPv6-Eintrag, der schon auf eine Adresse mit dem eingestellten Ende zeigt, wird mit nachgezogen.</li>
      <li>Ein IPv6-Eintrag, der woandershin zeigt, wird <b>nie von selbst</b> geändert. Die Karte zeigt dann einen Hinweis und den Knopf <b>Überschreiben</b> für IPv6. Er fragt mit Name, alter und neuer Adresse nach. Den Knopf gibt es bei den Namen, die das PDH verwaltet, und in der Liste <b>Weitere Namen an der UDM Pro</b>. Hat sich der Eintrag inzwischen geändert, ändert der Knopf nichts – dann die Seite neu laden. Das Überschreiben bei IPv4 ändert nur den IPv4-Eintrag, wie bisher.</li>
      <li>Ist ein IPv6-Eintrag an der UDM Pro abgeschaltet, legt das PDH für den Namen nichts an und ändert nichts; die Karte zeigt einen Hinweis. Abgeschaltete Einträge Typ A zählen nicht als „zeigt auf den Server“.</li>
      <li>Löschen darf das PDH nur IPv6-Einträge, die es selbst angelegt hat. Leerst du das Feld <b>IPv6-Ende</b>, entfernt das PDH seine Einträge nach etwa 10 Minuten. Ebenso, wenn ein Name nicht mehr auf den Server zeigt: Es löscht erst, wenn es das zweimal hintereinander gesehen hat.</li>
      <li>Hast du einen solchen Eintrag an der UDM Pro selbst geändert, lässt das PDH ihn in Ruhe und zeigt einen Hinweis.</li>
      <li>Eintragen und beide Knöpfe <b>Überschreiben</b> brauchen das Recht „Namen im Haus eintragen (UniFi)“.</li>
    </ul>
    <b>Kein Name stört einen anderen:</b> Eine Seite des Agenten hört nur dann auch auf IPv6, wenn alle anderen Seiten auf Port 443 das ebenfalls tun – sonst bekäme jeder Aufruf über IPv6 für deren Namen das falsche Zertifikat. Nach jeder neuen Seite prüft der Agent, ob alle anderen Namen über 127.0.0.1 und ::1 noch ihr Zertifikat bekommen. Ändert sich eines, versucht er die Seite ohne IPv6; hilft das nicht, nimmt er sie zurück und meldet „würde … stören“.
    Die nginx-Seite des PDH hört auf IPv6, wenn alle anderen Seiten das auch tun. Nimmt nginx die IPv6-Zeilen nicht an, hört die Seite nur auf IPv4; die Karte sagt es im Hinweis.
    Ein geholtes Zertifikat gilt nur für den Namen. Rufst du PDH oder Nextcloud im Haus über die Adresse auf (<code>https://10.…</code>), meldet der Browser deshalb einen Zertifikatsfehler – nimm den Namen.
    <ul>
      <li>Die Anbindung ist nach der Schnittstellenbeschreibung des Herstellers für UniFi Network 10.3 gebaut und <b>noch nicht an einem echten Gerät ausprobiert</b>. Ältere UniFi-Network-Versionen bieten diese Schnittstelle womöglich nicht – dann trägst du die Namen von Hand ein.</li>
      <li>Das PDH verbindet sich nur mit Adressen im eigenen Netz.</li>
      <li>Ändert sich die Adresse, musst du den API-Schlüssel neu eingeben. Ändert sich das Zertifikat des Geräts, musst du den Fingerabdruck neu bestätigen.</li>
      <li>Einen Eintrag, den jemand von Hand unter einem verwalteten Namen angelegt hat, überschreibt das PDH erst nach Rückfrage und löscht ihn beim Entfernen des Namens nicht. Gelöscht werden nur Einträge, die das PDH selbst angelegt hat.</li>
      <li>Ist die UDM Pro nicht erreichbar oder fehlt dem Schlüssel das Recht, nennt die Karte den Grund. Zertifikate und nginx bleiben davon unberührt.</li>
    </ul></div>
  <div class="hb-howto" id="hb-omada"><b><i class="ti ti-access-point"></i> So bindest du einen Omada-Controller an</b>
    Habt ihr Netzgeräte von TP-Link mit einem Omada-Controller im Haus, kann das PDH sie für den <a href="#it-net">Netz-Abgleich der IT-Assets</a> lesen. Die Zugangsdaten trägst du in den Server-Einstellungen im Reiter <b>Omada</b> ein. Den Reiter sieht, wer das Recht „Omada-Controller anbinden“ hat. Die Anbindung ist ein Zusatz – ohne sie läuft alles wie bisher.
    <ol class="hb-steps">
      <li>Am Omada-Controller unter <b>Einstellungen → Platform Integration → Open API</b> eine Anwendung im Modus <b>Client</b> anlegen. Die Rolle <b>Viewer</b> genügt, denn das PDH liest nur. Dort stehen danach <b>Omada-ID</b>, <b>Client-ID</b> und <b>Client-Secret</b>.</li>
      <li><b>Server-Einstellungen → Reiter Omada</b> öffnen. <b>Adresse des Controllers</b> eintragen (z. B. <code>https://192.168.1.2:8043</code> – nur https, private Adresse oder Name im Haus), dazu <b>Omada-ID</b>, <b>Client-ID</b> und <b>Client-Secret</b>. Den <b>Standort</b> nur eintragen, wenn der Controller mehrere hat; leer heißt „der einzige“. Dann <b>Speichern</b>. Das Secret wird verschlüsselt gespeichert und nie wieder angezeigt.</li>
      <li>Den angezeigten <b>Fingerabdruck</b> mit dem Zertifikat vergleichen, das der Browser auf dem Controller zeigt (SHA-256), und <b>Bestätigen</b>. Danach spricht das PDH nur noch mit einem Controller, der genau diesen Fingerabdruck zeigt.</li>
      <li><b>Verbindung prüfen</b> drücken. Kontrolle: Die Karte meldet „Anmeldung in Ordnung – N Geräte am Standort gefunden.“ Bei einem Fehler nennt sie den Grund, z. B. falsche Zugangsdaten oder mehrere Standorte.</li>
      <li>Unter <b>IT-Assets → Netz-Abgleich</b> den Schalter für Omada einschalten.</li>
    </ol>
    <ul>
      <li>Die Omada-Anbindung ist nach der Dokumentation des Herstellers gebaut und <b>noch nicht an einem echten Controller erprobt</b>.</li>
      <li>Das PDH verbindet sich nur mit Adressen im eigenen Netz und ändert am Controller nichts.</li>
      <li>Ändert sich die Adresse, musst du das Client-Secret neu eingeben und den Fingerabdruck neu bestätigen. Ändert sich das Zertifikat des Controllers, musst du den Fingerabdruck neu bestätigen.</li>
      <li><b>Adresse leer speichern</b> entfernt die Anbindung samt Zugangsdaten.</li>
      <li>Am Spiegelserver und während einer Wartungssperre lässt sich die Anbindung nicht ändern.</li>
      <li>Speichern und Bestätigen stehen im Server-Protokoll und gehen als Meldung an die Administratoren – ohne das Secret.</li>
    </ul></div>
  <div class="hb-howto" id="hb-snmp"><b><i class="ti ti-network"></i> So legst du ein SNMP-Zugangsprofil an</b>
    Mit SNMP v3 fragt das PDH Geräte ohne Controller für den <a href="#it-net">Netz-Abgleich der IT-Assets</a>. Ein <b>Zugangsprofil</b> ist ein SNMP-Benutzer mit zwei Kennwörtern; es gilt für beliebig viele Geräte. Die Profile stehen in den Server-Einstellungen im Reiter <b>SNMP</b>. Den Reiter sieht, wer das Recht „SNMP-Zugangsprofile verwalten“ hat. SNMP ist ein Zusatz – ohne läuft alles wie bisher.
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Reiter SNMP</b> öffnen. Unter <b>Neues Zugangsprofil</b> einen <b>Namen</b> (z. B. „Switches“) und den <b>SNMP-Benutzer</b> eintragen, wie er am Gerät angelegt ist.</li>
      <li><b>Anmeldung</b>: Verfahren wählen (Vorschlag SHA-256) und das Kennwort der Anmeldung eintragen. <b>Verschlüsselung</b>: Verfahren wählen (Vorschlag AES-128) und das Kennwort der Verschlüsselung eintragen. Beides muss zum Gerät passen. Kennwörter haben mindestens 8 Zeichen. <b>Nimm lange, zufällige Kennwörter – mindestens 16 Zeichen.</b> Grund: Wer ein Gerät in die Liste eintragen darf, kann das Profil an eine beliebige Adresse im Haus schicken; ein kurzes Kennwort ließe sich aus einer solchen Anfrage erraten.</li>
      <li><b>Profil anlegen</b>. Kontrolle: Das Profil steht in der Liste mit Benutzer, Verfahren und „0 Geräte“.</li>
      <li>Unter <b>IT-Assets → Netz-Abgleich</b> die Geräte hinzufügen und mit <b>Prüfen</b> testen (<a href="#it-net-snmp">So bindest du ein Gerät per SNMP v3 an</a>).</li>
    </ol>
    <ul>
      <li><b>Ändern:</b> In der Zeile des Profils <b>Ändern</b> aufklappen. Leere Kennwort-Felder bleiben unverändert („hinterlegt – nur zum Ändern eingeben“). Kennwörter werden verschlüsselt gespeichert und nie wieder angezeigt.</li>
      <li><b>Löschen</b> darf nur der Bereichsadministrator (Recht „SNMP: Zugangsprofile löschen (Bereichsadministrator)“) – und nur, solange kein Gerät das Profil nutzt. Sonst meldet die Karte „wird noch von N Geräten genutzt“: Gib den Geräten erst ein anderes Profil oder entferne sie aus der Liste.</li>
      <li><b>Verfahren:</b> Das PDH spricht nur angemeldet und verschlüsselt. MD5, DES und SNMP v1/v2c gibt es nicht. <b>SHA-1</b> trägt den Hinweis „veraltet“ – nur wählen, wenn das Gerät nichts anderes kann.</li>
      <li><b>Verbund:</b> Der gerade aktive Server fragt von seiner eigenen Adresse. Geräte mit einer Liste erlaubter Abfrager müssen beide Server eintragen.</li>
      <li>Am Spiegelserver und während einer Wartungssperre lassen sich die Profile nicht ändern.</li>
      <li>Anlegen, Ändern und Löschen stehen im Server-Protokoll und gehen als Meldung an die Administratoren – ohne Kennwörter.</li>
      <li>SNMP v3 ist im Labor geprüft und <b>noch nicht an echten Switches und Druckern erprobt</b>.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> So schaltest du Full (strict) ein und stellst es zurück</b>
    Mit <b>Full (strict)</b> prüft Cloudflare das Zertifikat am Server. Der Tunnel läuft dann verschlüsselt bis zu nginx.
    <b>Achtung:</b> Die Verschlüsselung gilt für <b>alle</b> Namen der Domain, die über Cloudflare laufen – auch für solche, die nicht über den Tunnel gehen (z. B. eine Firmenseite bei einem Hoster). Die brauchen dann selbst ein gültiges Zertifikat, sonst sind sie nicht mehr erreichbar.
    <ol class="hb-steps">
      <li>Jeder verwaltete Name braucht ein gültiges, eingerichtetes Zertifikat der <b>echten</b> Umgebung (kein Test-Zertifikat). Vorher bleibt der Knopf grau.</li>
      <li><b>Tunnel und Domain auf Full (strict) umstellen</b> drücken und bestätigen. Das PDH prüft zuerst jeden Namen auf dem Server; klappt das nicht, ändert es nichts. Alle Administratoren bekommen eine Nachricht.</li>
      <li>Zum Zurückgehen <b>Zurückstellen</b> drücken. Die Tunnel-Ziele werden genau so zurückgeschrieben, wie sie vor dem Einschalten waren. <b>Ziele, die danach hinzugekommen oder geändert worden sind, gehen verloren.</b></li>
    </ol>
    Solange Full (strict) an ist, zeigt die Cloudflare-Karte für die eingetragenen Namen das Ziel <code>https://localhost:443</code> als eingerichtet.</div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> Zertifikate im Ausfallschutz-Verbund</b>
    <ul>
      <li>Die Zertifikate werden auf den zweiten Server gespiegelt und stehen in der Sicherung.</li>
      <li>Ein entferntes Zertifikat samt Schlüssel bleibt standardmäßig 14 Tage (einstellbar) im Papierkorb der Spiegelung am Partner (nur für root lesbar).</li>
      <li>Wurden die Rollen seit dem Start mindestens einmal getauscht (jedes Update tauscht sie), schlägt die Spiegelung beim <b>ersten</b> Zertifikat einmal Alarm: <i>„Quelle ssl-pdh: Der Ordner ist neu dazugekommen, seit dieser Server aktiv wurde – einen eigenen Beleg gibt es dafür noch nicht. Auf dem Partner wird nichts gelöscht. Ist dieser Server vollständig: sudo pdh-ha mirror confirm“</i>. Das ist erwartet und kein Fehler. Bis zur Bestätigung werden die Zertifikate auf den zweiten Server kopiert, Löschungen (ein entferntes Zertifikat) aber nicht.</li>
      <li>Hat der Partner dort außerdem schon Zertifikatsdateien, kann ein zweiter Alarm erscheinen: <i>„Der Partner hat dort schon Dateien ohne Beleg“</i>. Derselbe Befehl löst beide.</li>
      <li>Wird ein Zertifikat geholt, während erst einer der beiden Server die neue Version hat, meldet die Spiegelung für diese Quelle einen Fehler. Rollentausch und Update-Bereitschaft sind so lange gesperrt. Hol Zertifikate deshalb erst, wenn beide Server aktualisiert sind.</li>
      <li>Kommt ein erneuertes Zertifikat am zweiten Server an, lädt der dort nginx neu – nur wenn nginx dort eingerichtet ist.</li>
      <li>Sobald es Zertifikate gibt, installiert und startet das Update nginx auf beiden Servern.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-check"></i> So bestätigst du den Alarm der Spiegelung beim ersten Zertifikat</b>
    <ol class="hb-steps">
      <li>Auf dem <b>aktiven</b> Server (der, den du gerade benutzt) in einer Konsole ausführen: <code>sudo pdh-ha mirror confirm</code>.</li>
      <li>Erwartet: Der Alarm endet, und <code>sudo pdh-ha mirror status</code> zeigt die Quelle ohne Warnung.</li>
    </ol>
    Bestätige nur, wenn dieser Server vollständig ist. Danach werden auch Löschungen auf den zweiten Server übertragen.</div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn etwas nicht klappt</b>
    <ul>
      <li><b>API-Token fehlt oder darf die Domain nicht ändern:</b> Die Karte nennt das fehlende Recht; es beginnt kein Auftrag.</li>
      <li><b>Prüf-Eintrag wird nicht sichtbar:</b> Abbruch nach 2 Minuten, der Eintrag wird gelöscht, ein altes Zertifikat bleibt.</li>
      <li><b>Let's Encrypt lehnt ab:</b> Abbruch, der Eintrag wird gelöscht, der Grund steht in der Karte.</li>
      <li><b>Kontingent erschöpft:</b> Das PDH merkt sich die Sperrzeit und versucht es danach neu.</li>
      <li><b>nginx-Prüfung schlägt fehl:</b> Die vorigen Dateien kommen zurück, die Dienste laufen weiter, der Fehler steht in der Karte.</li>
      <li><b>Update-Agent nicht erreichbar:</b> Das Zertifikat bleibt gespeichert, die Karte zeigt „noch nicht eingerichtet“, der nächste Lauf holt es nach.</li>
      <li><b>Rollentausch mitten im Ablauf:</b> Der neue aktive Server räumt Prüf-Einträge auf und beginnt bei Bedarf neu.</li>
      <li><b>Datei und Datenbank weichen ab:</b> Das PDH richtet das Zertifikat neu aus der Datenbank ein. Ebenso, wenn keine nginx-Seite mehr auf das Zertifikat des PDH bzw. der Nextcloud verweist.</li>
      <li><b>Hinweis „… Bitte das Zertifikat dort von Hand eintragen“ an der Zeile:</b> Kein Fehler – die Dateien liegen bereit, nur die nginx-Seite trägst du selbst ein (siehe oben).</li>
      <li><b>Alarm „Quelle ssl-pdh: Der Ordner ist neu dazugekommen, seit dieser Server aktiv wurde …“ oder „Der Partner hat dort schon Dateien ohne Beleg“:</b> Das ist beim ersten Zertifikat im Verbund erwartet und kein Fehler. Auf dem aktiven Server <code>sudo pdh-ha mirror confirm</code> ausführen; der Befehl löst beide Alarme. Bis dahin werden Zertifikate kopiert, Löschungen aber nicht.</li>
      <li><b>Fingerabdruck der UDM Pro geändert:</b> Es gibt keine Verbindung, bis du den neuen Fingerabdruck bestätigst.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-cloud-lock"></i> So machst du das PDH über einen Cloudflare-Tunnel erreichbar</b>
    Der Tunnel macht das PDH aus dem Internet erreichbar, ohne dass in der Firewall ein Port geöffnet wird. Du brauchst ein Cloudflare-Konto mit eurer Domain.
    <ol class="hb-steps">
      <li>Im Cloudflare-Zero-Trust-Dashboard <b>Networks → Tunnels → Create a tunnel → Cloudflared</b>, Name z. B. „PDH“.</li>
      <li>Den angezeigten Installationsbefehl (oder nur den langen Token) kopieren und im Reiter <b>Cloudflare-Tunnel</b> bei <b>Tunnel-Token</b> einfügen. <b>Speichern</b>.</li>
      <li>Im Dashboard unter <b>Public Hostname</b> die Adresse festlegen (z. B. <code>pdh.firma.de</code>) und als Service das <b>Ziel im Tunnel</b> eintragen (Standard: HTTP, <code>localhost:8090</code>). Den Hostnamen auch im PDH eintragen.</li>
      <li><b>Skript für Linux</b> bzw. <b>Skript für Windows</b> herunterladen, auf den PDH-Server kopieren (bei Docker auf den Host) und ausführen: <code>sudo bash pdh-cloudflared.sh</code> bzw. in einer PowerShell als Administrator <code>powershell -ExecutionPolicy Bypass -File .\pdh-cloudflared.ps1</code>.</li>
      <li>Im Reiter <b>Server</b> die <b>Öffentliche Adresse</b> auf <code>https://pdh.firma.de</code> setzen und im Reiter Cloudflare-Tunnel <b>Tunnel prüfen</b>.</li>
    </ol>
    Das Skript installiert <code>cloudflared</code>, richtet es als Dienst ein (startet mit dem Server) und ersetzt einen vorhandenen Tunnel-Dienst. Es enthält den Token – nach der Einrichtung löschen. Ein neuer Token (z. B. nach „Refresh token“ im Dashboard): eintragen, Skript neu herunterladen und erneut ausführen.</div>
  <ul>
    <li><b>Passwörter und Schlüssel</b> werden nie angezeigt. Feld leer lassen = unverändert; „Wert entfernen“ löscht ihn.</li>
    <li><b>Datenbank</b>: Änderungen werden vor dem Speichern getestet. Nur wenn du sicher bist, „Trotzdem speichern“ anhaken.</li>
    <li><b>Sicherheit</b>: „Neuen Anmelde-Schlüssel erzeugen“ meldet nach dem Neustart alle Benutzer ab. Den Schlüssel für Portal-Passwörter nach dem ersten Gebrauch nicht mehr ändern.</li>
    <li>Jede Änderung meldet „Service“ per Chat an alle Administratoren (ohne die Werte selbst).</li>
  </ul>
  <h3><i class="ti ti-color-swatch"></i> Erscheinungsbild: Farbschema, Design-Stil, Schrift &amp; Größe</h3>
  <p>Im Reiter <b>Erscheinungsbild</b> legst du oben den <b>Firmenstandard</b> fest: Farbschema, Design-Stil, Schriftart und Größe. Jeder Benutzer kann im Benutzermenü davon abweichen und das an seinem Konto speichern; Hell oder Dunkel wählt ohnehin jeder selbst – jedes Schema hat Farben für beide.</p>
  {{template "hb-fig-theme"}}
  <table>
    <tr><td><b>Vorlagen</b></td><td>PDH-Blau (Standard), Petrol, Industriegrün, Signalorange, Bordeaux, Violett, Anthrazit – geprüft gut lesbar in Hell und Dunkel</td></tr>
    <tr><td><b>Firmenfarbe</b></td><td>eine eigene Farbe (z. B. aus dem Firmenlogo). Das PDH passt die Helligkeit je Modus automatisch an, damit Schrift und Schaltflächen lesbar bleiben.</td></tr>
    <tr><td><b>Home Assistant</b></td><td>aus der Theme-Galerie oder per Datei übernommene Themes (z. B. Nordic, Metro, iOS) – mit Hintergrund-, Karten-, Text- und Rahmenfarben</td></tr>
    <tr><td><b>Design-Stil</b></td><td><b>Fiori</b> (Standard) wie SAP: weiße Kopfleiste und Navigation, Karten mit Schatten, Knöpfe mit blauer Schrift, durchgehend unterstrichene Reiter. <b>Fluent</b> wie Windows 11: Navigation und Kopfzeile auf grauem Grund, feine Linien, kleine Ecken. Das Farbschema gilt in beiden Stilen. Der Stil wirkt auch auf Anmeldeseite, Easy-Mode und Leitstand.</td></tr>
    <tr><td><b>Schriftart</b></td><td>DM Sans (Standard), System, Inter, Roboto (wie Home Assistant), Atkinson Hyperlegible (besonders gut lesbar), Source Sans 3, Verdana</td></tr>
    <tr><td><b>Größe</b></td><td>70 bis 160 % – vergrößert die ganze Oberfläche, z. B. 120 % für Terminals oder Tablets in der Halle</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-color-swatch"></i> So stellst du das Firmen-Farbschema ein</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>, Karte <b>Farbschema, Design-Stil &amp; Schrift</b>.</li>
      <li>Ein Schema antippen – oder bei <b>Firmenfarbe</b> auf das Farbfeld klicken und eine Farbe wählen. Darunter <b>Design-Stil</b>, <b>Schriftart</b> und <b>Größe</b> wählen. Die Seite zeigt alles sofort zur Probe.</li>
      <li>Mit <b>Benutzer dürfen … ein eigenes Farbschema, einen eigenen Design-Stil und eine eigene Schrift wählen</b> legst du fest, ob jeder im Benutzermenü umstellen darf. Die Größe darf jeder anpassen.</li>
      <li><b>Speichern</b> – ab dem nächsten Seitenaufruf sehen alle, die nichts Eigenes gespeichert haben, den neuen Standard (auch auf der Anmeldeseite).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-layout-grid"></i> So nimmst du ein Theme aus der Galerie (am einfachsten)</b>
    <ol class="hb-steps">
      <li><b>Erscheinungsbild</b> → Karte <b>Theme-Galerie aus Home Assistant</b>. Dort liegen bekannte Community-Themes bereit: <b>Nordic</b>, <b>Caule Themes Pack</b>, <b>iOS Themes</b> und <b>Metro &amp; Fluent</b>.</li>
      <li>Eine Familie aufklappen. Jede Kachel zeigt links die dunkle, rechts die helle Variante.</li>
      <li><b>Übernehmen</b> legt das Theme oben bei den Farbschemata ab (für die Auswahl der Benutzer). <b>Als Standard</b> übernimmt es und macht es sofort zum Firmenstandard.</li>
    </ol>
    Die Farben sind bereits ausgelesen – es wird nichts aus dem Internet geladen. Urheber und Quelle stehen bei jeder Familie.</div>
  <div class="hb-howto"><b><i class="ti ti-home"></i> So übernimmst du ein eigenes Theme aus Home Assistant</b>
    <ol class="hb-steps">
      <li>In Home Assistant die Theme-Datei holen: im Konfigurationsordner unter <code>themes/</code>, z. B. <code>themes/nordic/nordic.yaml</code> (per Datei-Editor, Samba oder Studio Code Server).</li>
      <li>Im PDH unter <b>Erscheinungsbild → Theme aus Home Assistant übernehmen</b> die Datei wählen – oder ihren Inhalt in das Textfeld einfügen – und <b>Übernehmen</b>.</li>
      <li>Das Theme erscheint oben bei den Farbschemata (Hinweis „aus Home Assistant“). Antippen und <b>Speichern</b>, um es zum Firmenstandard zu machen.</li>
    </ol>
    Hat das Theme getrennte Farben für Hell und Dunkel (<code>modes: light/dark</code>), werden beide übernommen. Hat es nur einen Satz Farben, gilt er für den passenden Modus; im anderen Modus kommen nur die Akzentfarben mit. Schriften, Rundungen, Zustandsfarben und card-mod werden nicht übernommen. Eine erneute Übernahme mit gleichem Namen ersetzt das Theme; <b>Entfernen</b> löscht es (war es Firmenstandard, gilt wieder PDH-Blau).</div>
  <h3 id="timeline-style"><i class="ti ti-timeline"></i> Erscheinungsbild: Zeitstrahl</h3>
  <p>In allen Zeitstrahlen – <b>Dashboard</b>, <b>Leitstand</b> und <b>Projekte</b> – stehen offene und laufende Vorgänge als einzelne Balken. Erledigte fasst ein <b>Sammler „✓ Erledigt (Anzahl)“</b> ganz oben zusammen; ein Klick darauf zeigt sie einzeln, ein weiterer Klick klappt sie wieder zu (der Browser merkt sich das je Zeitstrahl).</p>
  <p>Der Rand eines Balkens zeigt, wie es um den Vorgang steht. Die Füllfarbe bleibt die Farbe der Vorgangsart bzw. der Aufgabe.</p>
  <div class="tl-legend" style="margin:6px 0 10px">
    <span class="tl-running"><i></i>läuft (in Bearbeitung) – gelb</span><span class="tl-due"><i></i>fällig – rot</span><span class="tl-overdue"><i></i>überfällig – roter, blinkender Rand</span>
    <span class="tl-unassigned"><i></i>nicht zugewiesen – lila</span><span class="tl-done"><i></i>beendet – grüner Rand, Balken ausgegraut</span>
  </div>
  <p>Treffen mehrere Zustände zu, gilt der wichtigste: <b>beendet</b> vor <b>überfällig</b> vor <b>fällig</b> vor <b>nicht zugewiesen</b> vor <b>läuft</b>. „Nicht zugewiesen“ heißt: weder eine Person noch eine Gruppe (bei Aufgaben: keine Beteiligten). Balken ohne echten Termin (geschätzt, blass) werden nie fällig oder überfällig. Wer Bewegung nicht verträgt (Systemeinstellung „Bewegung reduzieren“), sieht den überfälligen Rand ohne Blinken.</p>
  <div class="hb-howto"><b><i class="ti ti-timeline"></i> So stellst du den Zeitstrahl ein</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>, Karte <b>Zeitstrahl</b>.</li>
      <li>Je Zustand die <b>Farbe</b> wählen, dazu die Farbe, mit der beendete Balken <b>ausgegraut</b> werden.</li>
      <li><b>Randstärke</b> (0,5 – 6 px), <b>Randhelligkeit</b> (dunkler bis heller, wirkt auf alle Ränder) und <b>Balkenhöhe</b> (12 – 48 px) mit den Schiebern einstellen.</li>
      <li>Bei <b>„Fällig“ ab</b> festlegen, wie viele Tage vor dem Termin der rote Rand beginnt (Standard: heute und morgen).</li>
      <li>Die <b>Vorschau</b> zeigt sofort, wie es aussieht. <b>Speichern</b> – gilt für alle Benutzer und den Leitstand. <b>Standard</b> stellt die Vorgabe wieder her.</li>
    </ol></div>
  <h3><i class="ti ti-palette"></i> Erscheinungsbild: Name und Logos</h3>
  <p>Darunter legst du den Anzeigenamen und drei Logos fest:</p>
  <table>
    <tr><td><b>App-Logo</b></td><td>Seitenleiste, Anmeldeseite und Symbol im Browser-Tab (ohne eigenes Logo erscheint dort das blaue PDH-Symbol <img src="/favicon.svg" alt="" width="16" height="16" style="vertical-align:-3px">)</td></tr>
    <tr><td><b>Logo für Exporte</b></td><td>PDF-Exporte (oben rechts) und Excel-Exporte (neben der Tabelle)</td></tr>
    <tr><td><b>Logo für Druck</b></td><td>Kopfzeile jeder gedruckten Seite (mit Name, Seitentitel und Druckdatum), Bestellvorschlag-E-Mail und – wenn eingeschaltet – Lagerplatz-Etiketten</td></tr>
  </table>
  <div class="hb-howto"><b><i class="ti ti-upload"></i> So setzt du das Firmenlogo</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Erscheinungsbild</b>.</li>
      <li>Beim <b>App-Logo</b> eine PNG-, JPG- oder GIF-Datei wählen (max. 2 MB, am besten quadratisch mit transparentem Hintergrund) und <b>Hochladen</b>.</li>
      <li>Exporte und Druck verwenden es automatisch mit („wie App-Logo“). Für einen anderen Ausdruck – z. B. ein breites Schwarzweiß-Logo – dort ein eigenes Logo hochladen.</li>
    </ol>
    SVG-Dateien werden aus Sicherheitsgründen nicht angenommen. Die Logos gehören zur Datensicherung (Bestandteil „Anhänge &amp; Bilder“).</div>
  <h3><i class="ti ti-file-analytics"></i> Protokoll ansehen und filtern</h3>
  <p>Das PDH protokolliert ausführlich: jeden Seitenaufruf mit Benutzer, Dauer und Status, An- und Abmeldungen (auch fehlgeschlagene), Fehler sowie Datensicherung, Bereinigung, Einstellungsänderungen und Benachrichtigungen. Passwörter und Tokens in Adressen werden dabei unkenntlich gemacht, von RFID-Karten stehen nur die letzten 4 Zeichen im Protokoll.</p>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So findest du einen Fehler</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Protokoll ansehen</b> (Berechtigung <i>Server-Protokoll ansehen</i>, standardmäßig nur Administratoren).</li>
      <li>Oben die Kachel <b>Fehler (24 h)</b> antippen – oder Zeitraum, Stufe, Bereich, Benutzer, Pfad, HTTP-Status, Request-ID oder einen Suchbegriff wählen und <b>Filtern</b>. Die Felder <b>von</b> und <b>bis</b> erscheinen, wenn du beim Zeitraum <b>frei wählen …</b> nimmst.</li>
      <li>Eine Zeile antippen zeigt alle Details (IP, Browser, Abfrage, Fehlermeldung …). <b>Alle Einträge dieser Anfrage</b> zeigt, was während genau dieses Aufrufs passiert ist.</li>
      <li>Bereich oder Benutzer in einer Zeile antippen filtert direkt danach. <b>Live</b> aktualisiert die Liste alle 5 Sekunden.</li>
    </ol></div>
  <ul>
    <li><b>Bereiche:</b> <code>http</code> (Seitenaufrufe), <code>auth</code> (Anmeldungen), <code>backup</code>, <code>bereinigung</code>, <code>konfiguration</code>, <code>benachrichtigung</code>, <code>einrichtung</code>, <code>system</code> (Rest).</li>
    <li><b>Herunterladen:</b> die gefilterte Liste als CSV (für Excel) oder JSON, oder eine ganze Tagesdatei.</li>
    <li><b>Einstellungen</b> im Reiter <b>Protokoll</b>: Stufe (debug/info/warn/error), ob alle oder nur fehlerhafte Seitenaufrufe protokolliert werden, Aufbewahrung in Tagen und Ordner – sofort wirksam.</li>
  </ul>
  <p>Das <b>Server-Protokoll</b> lässt sich sortieren (<a href="#sort">mehr</a>). „Älteste zuerst“ dreht nur die zuletzt geladenen Zeilen um; ein Hinweis über der Liste sagt das.</p>
  {{template "hb-shots" (dict "Ref" (index $s "server") "Can" $can)}}
</section>

<section class="hb-ch" id="versions" data-title="Versionen &amp; Updates" data-pages="core-settings">
  <h2><i class="ti ti-versions"></i> Versionen &amp; Updates</h2>
  <p>PDH steht für <b>Pulse Data Hub</b>. Die installierte Version steht links oben unter dem Namen (z. B. <b>v{{.CurrentVersion}}</b>). Jede Version hat eine Nummer <b>Haupt.Neben.Korrektur</b>: Die mittlere Zahl steigt mit neuen Funktionen, die letzte bei reinen Fehlerkorrekturen.</p>
  {{template "hb-fig-update"}}
  <div class="hb-howto"><b><i class="ti ti-download"></i> So installierst du ein Update</b>
    <ol class="hb-steps">
      <li><b>Core-Einstellungen</b> öffnen. Im Kasten <b>GitHub-Updates</b> siehst du die <b>installierte Version</b> und die <b>Version auf GitHub</b> (auf dem eingestellten Update-Zweig, Standard <code>main</code>). PDH prüft regelmäßig selbst (einstellbar); sofort geht es mit <b>Commit-Vergleich</b>. Nach einem Update oder einem anderen Update-Zweig gilt der alte Commit-Vergleich nicht mehr: Mit automatischer Prüfung erneuert PDH ihn von selbst, sonst einmal <b>Commit-Vergleich</b> klicken. Bis dahin bleibt <b>Update installieren</b> gesperrt.</li>
      <li>Ist ein Update da, listet <b>Neu in … Version(en)</b> alle Änderungen seit deiner Version – lies sie vor dem Installieren.</li>
      <li><b>Update installieren</b> klicken und bestätigen. Zuerst läuft ein <b>Countdown</b> (Band „Automatische Wartung in …“), dann sperrt der <b>Wartungsbildschirm</b> kurz alle Eingaben, der Dienst startet neu und prüft sich. Klappt etwas nicht, kommt der alte Stand automatisch zurück. Danach ist die Seite wieder da (nach einer Minute neu laden, falls nicht). Rufst du mitten im Update eine Seite auf, die es erst in der neuen Version gibt, steht dort <b>„Das PDH wird gerade aktualisiert“</b>; die Seite lädt von selbst neu.</li>
    </ol>
    <b>Mit zwei Servern</b> aktualisiert derselbe Knopf <b>alle Rechner des Verbunds</b> (Spiegel und Zeuge ziehen mit) – siehe <a href="#ausfallschutz">Update im Verbund und Wartungsfenster</a>. Dort richtest du auch ein <b>Wartungsfenster</b> ein, das nachts automatisch aktualisiert.<br>
    Vor den Datenbank-Änderungen legt PDH automatisch eine Vollsicherung an (<a href="#backup">mehr</a>). Danach steht die neue Nummer in der Kopfzeile.<br>
    <b>Am Server von Hand:</b> nicht nur <code>git pull</code> – das holt die Dateien, baut das Programm aber nicht neu, und neue Seiten passen dann nicht zum alten Programm (z. B. „Template-Fehler … can't evaluate field …“). Richtig ist im PDH-Verzeichnis <code>sudo PDH_UPDATE_MODE=systemd bash install_update.sh</code> (bei Docker <code>PDH_UPDATE_MODE=docker</code>) – holt, baut und startet neu.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud"></i> So aktualisierst du Nextcloud</b>
    <ol class="hb-steps">
      <li><b>Core-Einstellungen</b> → Kachel <b>Nextcloud-Updates</b> (neben „GitHub-Updates“) → <b>Updates prüfen</b>. Die Kachel zeigt die installierte Version, ein verfügbares System-Update und alle App-Updates.</li>
      <li><b>Alle Apps aktualisieren</b> spielt die App-Updates ein – Nextcloud bleibt dabei erreichbar.</li>
      <li><b>System-Update (inkl. Apps)</b> aktualisiert Nextcloud selbst mit dem offiziellen Updater und danach die Apps. Nextcloud ist dabei einige Minuten im Wartungsmodus; vorher sollte eine Sicherung von Nextcloud bestehen.</li>
      <li>Den Fortschritt zeigt die Kachel nach dem Neuladen der Seite; danach erneut <b>Updates prüfen</b>.</li>
    </ol>
    Das klappt, wenn Nextcloud auf demselben Server wie das PDH läuft und der Update-Agent eingerichtet ist. Liegt Nextcloud woanders als in <code>/var/www/nextcloud</code>, das Verzeichnis in der Kachel eintragen.</div>
  <div class="hb-howto"><b><i class="ti ti-tool"></i> Update hängt bei „Go … laden“ oder meldet „missing $GOPATH“</b>
    <ol class="hb-steps">
      <li>Am Server prüfen, ob in <code>/opt/pdh-server/.env</code> die Zeile <code>GOPATH=/var/cache/pdh-updater/go</code> steht. Wenn nicht, die Zeile eintragen.</li>
      <li>Den Update-Agenten neu starten: <code>sudo systemctl restart pdh-update-agent</code>.</li>
      <li>Das Update in den Core-Einstellungen erneut starten. Fehlermeldungen von Go erscheinen jetzt in der Ausgabe des Updates.</li>
    </ol>
    Ab Version 0.80.9 setzt das Update diese Angabe selbst.</div>
  <p><b>Ohne Versionsnummer auf GitHub:</b> Zeigt <b>Version auf GitHub</b> „nicht angegeben“, stammt der Stand auf GitHub aus der Zeit vor der Versionierung. Ob ein Update da ist, entscheidet dann weiter der Commit-Vergleich.</p>
  <p><b>Lizenz:</b> PDH steht unter der GNU Affero General Public License, Version 3 oder später (AGPL-3.0-or-later). Den Quellcode gibt es unter <a href="https://github.com/strobobaer/pdh-server" target="_blank" rel="noopener">github.com/strobobaer/pdh-server</a>. Was PDH für dich erzeugt – z. B. SCL-Bausteine, ESPHome-YAML, Berichte und Exporte – gehört dir und fällt nicht unter die AGPL (Ausnahme in <code>LICENSE-EXCEPTION.md</code>).</p>
  <h3>Änderungsprotokoll <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  <p class="rec-sub">Was sich in welcher Version geändert hat – neueste zuerst. {{if .CurrentVersion}}Installiert ist Version {{.CurrentVersion}}.{{end}}</p>
  {{range $i, $r := .Releases}}
  <details class="hb-release"{{if lt $i 2}} open{{end}}>
    <summary><b>Version {{$r.Version}}</b>{{if $r.Date}} <span class="rec-sub">· {{$r.Date}}</span>{{end}}{{if eq $r.Version $.CurrentVersion}} <span class="hb-badge">installiert</span>{{end}}</summary>
    {{range $r.Sections}}<p style="margin:6px 0 2px"><b>{{.Title}}</b></p><ul>{{range .Items}}<li>{{.}}</li>{{end}}</ul>{{end}}
  </details>
  {{else}}<p class="rec-sub">Kein Änderungsprotokoll vorhanden.</p>{{end}}
  {{template "hb-shots" (dict "Ref" (index $s "versions") "Can" $can)}}
</section>

<section class="hb-ch" id="admin" data-title="Administration" data-pages="roles icons pki core-settings">
  <h2><i class="ti ti-settings"></i> Administration</h2>
  <ul>
    <li><b>Rollen &amp; Rechte</b> – was welche Rolle darf; Ausnahmen je Person unter Einzelrechte im Benutzerstamm (siehe unten).</li>
    <li><b>Core-Einstellungen</b> – Standards für alle (siehe unten), Fristen, Updates (<a href="#versions">mehr</a>), Microsoft-365-Abgleich samt Nextcloud-Konten (<a href="#users">mehr</a>), Hersteller &amp; Lieferanten, Feldsätze.</li>
    <li><b>Import / Export</b> – Daten aus Maschinen und Systemen (MQTT, OPC UA, Modbus, SQL, Excel, Web) übernehmen und Exporte planen (<a href="#connections">mehr</a>).</li>
    <li><b>Steuerungsbaustein (TIA Portal)</b> – das Recht <code>import.tia</code> „Steuerungsbaustein (TIA Portal) herunterladen“ steht in der Gruppe „Daten &amp; Schnittstellen“ und liegt bei allen Rollen mit „Import ansehen“. Mit Kennwort oder angelegten Zuordnungen braucht es zusätzlich „Import verwalten“ (<a href="#tiabaustein">mehr</a>).</li>
    <li><b>Energiedaten</b> – Messstellen, Minutenwerte, Schwellwerte und der Efficio-Export; die Rechte <code>energy.view</code>, <code>energy.edit</code>, <code>energy.thresholds</code> und <code>energy.admin</code> stehen in der Gruppe „Daten &amp; Schnittstellen“, die Einstellungen ändert nur der Bereichsadministrator (<a href="#energiedaten">mehr</a>).</li>
    <li><b>Netz-Abgleich (IT-Assets)</b> – das Recht <code>it.netsync</code> „Netz-Abgleich einrichten und Vorschläge übernehmen“ steht in der Gruppe „IT“ und liegt bei allen Rollen mit „IT-Assets bearbeiten“; die Verbindung zu UniFi braucht <code>system.unifi</code>, die zu Omada <code>system.omada</code>, die SNMP-Zugangsprofile <code>system.snmp</code>. Die SNMP-Geräteliste pflegt, wer <code>it.netsync</code> hat; ein Gerät aus der Liste entfernen darf nur der Bereichsadministrator IT (<code>it.admin</code>) (<a href="#it-net">mehr</a>).</li>
    <li><b>IT-Kategorien</b> – das Recht <code>it.categories</code> „IT-Kategorien pflegen“ steht in der Gruppe „IT“ und liegt bei allen Rollen mit „IT: Bereichsadministrator“ (<code>it.admin</code>), mit deren Abteilung; die Seite ansehen darf, wer „IT-Infrastruktur ansehen“ hat. Eine Kategorie endgültig löschen darf nur der Bereichsadministrator IT (<a href="#it-categories">mehr</a>).</li>
    <li><b>Abgleich</b> – Meldungen aus einer fremden Datenbank als Tickets oder Störmeldungen übernehmen und Änderungen zurückschreiben; Profile löscht nur der Bereichsadministrator des Abgleichs (<a href="#abgleich">mehr</a>).</li>
    <li><b>App-Zugang</b> – die Rechte <code>app.use</code> „App: nutzen“, <code>app.create</code> „App: Vorgänge anlegen“, <code>app.cockpit</code> „App: Cockpits verwalten“, <code>app.sensors.view</code> „App: Telefon-Sensoren ansehen“ und <code>app.admin</code> „App: Geräte freigeben und sperren (Bereichsadministrator)“ stehen in der Gruppe „App“. „App: nutzen“ haben alle Rollen, <code>app.create</code> und <code>app.admin</code> Administrator und Manager. Die Gruppe <b>App-Administratoren</b> bekommt die APP-Tickets; wer dort Mitglied ist, prüft und gibt Telefone frei (<a href="#pdh-app">mehr</a>).</li>
    <li><b>Drucker</b> – Etiketten- und Netzwerkdrucker einrichten, prüfen und testen (<a href="#printers">mehr</a>).</li>
    <li><b>Datensicherung</b> – Sicherungen, Zeitpläne und Wiederherstellung (<a href="#backup">mehr</a>).</li>
    <li><b>Bereinigung</b> – Löschvormerkungen prüfen und den Bereinigungslauf starten (<a href="#cleanup">mehr</a>).</li>
    <li><b>Kategorien</b> – Schlagworte für alle Module anlegen und pflegen (<a href="#categories">mehr</a>).</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-users-group"></i> So setzt du Darstellung, Menü und Dashboard als Standard für alle</b> (Recht „Standards für alle festlegen“)
    <ol class="hb-steps">
      <li>Richte alles bei dir ein: Benutzermenü → <b>Darstellung</b> (Farbe, Design-Stil, Schrift, Größe – mit <b>Speichern</b>), <b>Navigation anpassen</b> und <b>Dashboard anpassen</b>.</li>
      <li><b>Core-Einstellungen</b> → Karte <b>Standards für alle</b>.</li>
      <li>In der passenden Zeile <b>Meine als Standard</b> bzw. <b>Meins als Standard</b> drücken. Ab jetzt sehen das alle, die nichts Eigenes gespeichert haben – und der <b>Leitstand</b> zeigt diese Darstellung.</li>
      <li>Soll es wirklich für <b>alle</b> gelten, vorher <b>auch eigene Einstellungen aller ersetzen</b> anhaken. Dann werden gespeicherte eigene Einstellungen verworfen.</li>
      <li><b>Werksvorgabe</b> stellt die Auslieferung von PDH wieder her.</li>
    </ol>
    Danach kann jeder – auch du – wieder für sich anpassen. <b>Standard</b> im Benutzermenü holt jederzeit den Firmenstandard zurück.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> So setzt du Rechte für eine Rolle</b> (Recht „Rollen &amp; Rechte verwalten“)
    <ol class="hb-steps">
      <li><b>Rollen &amp; Rechte</b> öffnen. Oben stehen die <b>Rollen</b> mit Rang, Abteilung (wer sie hat, sieht nur Vorgänge dieser Abteilung), Pflichtschulungen und Anzahl Benutzer – darunter legst du eine neue Rolle an.</li>
      <li>In der <b>Berechtigungs-Matrix</b> oben ins Suchfeld tippen (z. B. „Wartung“ oder <code>tickets.edit</code>) – oder die Gruppen mit <b>Alle auf</b> / <b>Alle zu</b> bzw. einem Klick auf die Gruppenzeile auf- und zuklappen. PDH merkt sich, was zu ist.</li>
      <li>Häkchen in der Zeile eines Rechts setzt es für die Rolle in der Spalte – sofort gespeichert. Das Häkchen in der <b>Gruppenzeile</b> setzt oder entfernt die ganze Gruppe; „–“ heißt: nur ein Teil.</li>
    </ol>
    Rollen mit gleichem oder höherem Rang als deinem sind grau. Rechte, die du selbst nicht hast, kannst du nicht vergeben (<i class="ti ti-lock"></i>) – nur Administratoren dürfen alles. Das gilt auch für <b>Einzelrechte</b> im Benutzerstamm.</div>
  <div class="hb-howto"><b><i class="ti ti-building"></i> So gilt ein Recht nur in einer Abteilung</b>
    <ol class="hb-steps">
      <li>In der Matrix mit der Maus über das Häkchen fahren (am Tablet antippen) – darunter erscheint <i class="ti ti-building"></i>.</li>
      <li><i class="ti ti-building"></i> antippen, bei <b>Recht gilt in</b> die Abteilung wählen, <b>Übernehmen</b>. Unter dem Häkchen steht jetzt der Name der Abteilung.</li>
      <li>Das Recht gilt dann für Vorgänge und Stammdaten dieser Abteilung <b>und ihrer Unterabteilungen</b> (über die Anlage bzw. die zugewiesene Gruppe). Vorgänge ohne Anlage zählen wie überall.</li>
    </ol>
    Beispiel: „Störungen bearbeiten“ nur in <i>Instandhaltung Halle 2</i>, „Störungen sehen“ überall. Bei <b>Einzelrechte</b> im Benutzerstamm wählst du neben „Erlaubt“ ebenso eine Abteilung. Wer ein Recht selbst nur in einer Abteilung hat, kann es auch nur dort weitergeben.</div>
  <div class="hb-howto"><b><i class="ti ti-crown"></i> Bereichsadministrator</b>
    <ol class="hb-steps">
      <li>Jeder Bereich hat ein Recht <b>„… : Bereichsadministrator“</b> (z. B. <code>faults.admin</code>, <code>inventory.admin</code>). Es schließt <b>alle Rechte des Bereichs</b> ein – auch auf eine Abteilung begrenzbar.</li>
      <li>Nur der Bereichsadministrator darf <b>endgültig löschen</b>: Stammdaten über <b>Status → Endgültig löschen</b> (noch verwendete werden stattdessen ausgeblendet), außerdem Wartungsaufträge, Aufgaben, Projekte und KVP-Vorschläge.</li>
      <li>Alle anderen können Stammdaten weiter <b>zum Löschen vormerken</b>; der Bereinigungslauf erledigt den Rest.</li>
    </ol>
    Anfangs hat nur die Rolle Administrator alle Bereichsadministrator-Rechte. Ein ausdrückliches Verbot eines Einzelrechts gilt auch gegen den Bereichsadministrator.</div>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> Rechte „Projekte: ansehen“ und „KVP: alle Vorschläge ansehen“</b>
    <ol class="hb-steps">
      <li>Die Rechte <code>projects.view</code> und <code>kvp.view</code> bestimmen, wer Projekte bzw. alle KVP-Vorschläge sieht – auch der Bereichsadministrator. Sie gelten überall oder nur in einer Abteilung (Projekt: Abteilung der Anlage oder der zugewiesenen Gruppe; KVP: Abteilung der Anlage). Vorgänge ohne Abteilung sieht, wer das Recht irgendwo hat.</li>
      <li>Mit dem Update haben alle bisherigen Rollen beide Rechte; es ändert sich nichts, bis du sie einer Rolle entziehst. Neu angelegte Rollen bekommen sie nicht von selbst.</li>
      <li>Wer das Recht verliert, sieht nur noch Projekte und Vorschläge, an denen er beteiligt ist. Beteiligte sehen ihren Vorgang immer. „Projekte bearbeiten“ und „KVP steuern“ wirken ohne das Ansehen-Recht nur an eigenen Vorgängen.</li>
      <li>Ohne „Projekte: ansehen“ fehlt der Menüpunkt Projekte; Liste, Detail, Zeitstrahl der Anlage, Kalender, Schnittstelle und Copilot zeigen nur sichtbare Projekte. Einreichen von KVP-Ideen dürfen weiter alle.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-exchange-2"></i> Rechte für Rüstzeiten</b> (Gruppe „Infrastruktur &amp; Anlagen“)
    <ul>
      <li><b>„Rüstzeiten: ansehen“</b> (<code>setup.view</code>): Liste, Detailseite und Historie.</li>
      <li><b>„Rüstzeiten: erfassen, korrigieren, Katalog und Höchstdauer pflegen“</b> (<code>setup.edit</code>): Rüstzeiten und Rüsttasten anlegen und ändern, Höchstdauer an der Anlage setzen.</li>
      <li><b>„Rüstzeiten: Bereichsadministrator“</b> (<code>setup.admin</code>): alle Rechte der Rüstzeiten und als Einziger endgültig löschen.</li>
    </ul>
    Sie gelten überall oder nur in einer Abteilung. Wer Anlagen sehen darf, darf Rüstzeiten sehen; wer Anlagen bearbeiten darf, auch erfassen. Die Werte für maximale Rüstzeit und Karenzzeit stehen in den Core-Einstellungen (<a href="#ruestzeiten">mehr</a>).</div>
  <div class="hb-howto"><b><i class="ti ti-topology-star-3"></i> Rechte für das Datennetz</b> (Gruppe „Datennetz“)
    <ul>
      <li><b>„Datennetz: Clients und Ziele sehen“</b> (<code>datanet.view</code>): die Seite Datennetz mit Clients und Zuständen und die Prüfung des Datennetzes.</li>
      <li><b>„Datennetz: Clients anlegen und sperren“</b> (<code>datanet.edit</code>): Clients anlegen, sperren und die Programme laden.</li>
      <li><b>„Datennetz: Clients löschen (Bereichsadministrator)“</b> (<code>datanet.admin</code>): alle Rechte des Datennetzes, Datennetz ein- und ausschalten, Schlüssel und Tailscale-API-Token eintragen, mit „Tags korrigieren“ Tags bei Tailscale setzen und als Einziger Clients endgültig entfernen.</li>
      <li><b>Datennetz-Rechte gelten immer für alle Clients.</b> Clients gehören keiner Abteilung; eine Abteilungsbeschränkung bei <code>datanet.*</code> hat deshalb keine Wirkung.</li>
    </ul>
    Beim Update bekamen „sehen“ und „anlegen und sperren“ alle Rollen, die überall „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ oder den Abgleich-Bereichsadministrator haben. Den Bereichsadministrator bekamen die Rolle Administrator, die Abgleich-Bereichsadministratoren und die Rollen, die überall Server-Einstellungen bearbeiten dürfen und schon in einem anderen Bereich Bereichsadministrator sind. Alle anderen Rollen, auch solche nur mit „VPN nutzen“, bekamen nichts. Die Rechte gelten überall oder nur in einer Abteilung; das Ein- und Ausschalten braucht das Recht überall (<a href="#datennetz">mehr</a>).</div>
  <div class="hb-howto"><b><i class="ti ti-cpu"></i> Rechte für ESPPDH</b> (Gruppe „Daten &amp; Schnittstellen“)
    <ul>
      <li><b>„ESPPDH: Geräte und Zustand ansehen“</b> (<code>esppdh.view</code>): Liste, Seite des Geräts, Verlauf der Bauten und die Konfiguration ohne Kennwörter.</li>
      <li><b>„ESPPDH: Sensorwerte ansehen (Anlage und Terminal)“</b> (<code>esppdh.values</code>): Reiter „ESPPDH“ an der Anlage, Sensoren am Anlagenterminal nach Kartenanmeldung und der Zähler auf der Schnellübersicht. Ab 0.82.11 bei Administrator, Manager, Anlagenverantwortlichen und Technikern.</li>
      <li><b>„ESPPDH: Geräte anlegen, ändern, sperren, bauen und flashen“</b> (<code>esppdh.edit</code>): dazu Firmware herunterladen und das Kennwort des Notzugangs sehen.</li>
      <li><b>„ESPPDH: Geräte löschen (Bereichsadministrator)“</b> (<code>esppdh.admin</code>): alle Rechte von ESPPDH und als Einziger Geräte endgültig löschen.</li>
    </ul>
    <p>Die Rechte gelten überall oder nur in einer Abteilung; maßgeblich ist die Anlage des Geräts. Beim Update bekamen „ansehen“ und „anlegen, ändern …“ alle Rollen und Personen mit „Import verwalten“ – mit derselben Abteilung. Den Bereichsadministrator bekamen die Rollen, die überall „Import verwalten“ und „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ haben. Wem „Import verwalten“ einzeln verboten ist, dem sind alle drei ESPPDH-Rechte verboten; wem nur „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ einzeln verboten ist, dem nur der Bereichsadministrator. Den Reiter <b>ESPPDH</b> der Server-Einstellungen bedienen Administratoren mit „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ (<a href="#esppdh">mehr</a>).</p></div>
  <div class="hb-howto"><b><i class="ti ti-tool"></i> Rechte für Update und Wartung</b>
    <ul>
      <li><b>„Wartungsfenster einstellen“</b> (Kategorie „System &amp; Sicherheit“): Wartungsfenster einrichten und fehlerhafte Versionen wieder zulassen (<a href="#ausfallschutz">mehr</a>). Beim Update bekamen es alle Rollen, die „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ hatten.</li>
      <li><b>„Automatische Wartung abbrechen“</b>: Wer es hat, bleibt während der Sperre angemeldet und darf auf dem Wartungsbildschirm abbrechen und zurücksetzen. Das Recht umfasst auch das <b>Absagen</b> der Wartungsfenster-Nachfrage und das <b>Abbrechen</b> eines Updates vor der Sperre. <b>Durchführen</b> braucht dasselbe Recht wie „Update installieren“ (Rollen &amp; Berechtigungen verwalten). Beim Update bekamen es alle Rollen mit „Rollen &amp; Berechtigungen verwalten“ und alle Bereichsadministratoren.</li>
      <li><b>Explorer (Import/Export)</b>: Werte der Maschine ansehen braucht „Import ausführen“ bzw. „Export ausführen“, testweise schreiben oder senden zusätzlich „Import verwalten“ bzw. „Export verwalten“.</li>
    </ul>
    Als Ausgangspunkt zählt nur ein Recht, das überall gilt – eines, das auf eine Abteilung begrenzt ist, reicht nicht. Beide Rechte lassen sich wie alle anderen vergeben, aber nur an Personen, die sie selbst haben.</div>
  <div class="hb-howto"><b><i class="ti ti-cloud"></i> Rechte für Nextcloud</b>
    <ul>
      <li><b>„Nextcloud-Abgleich einstellen und starten“</b> (<code>system.nextcloud_sync</code>): den Abgleich von Benutzern, Rollen, Gruppen und Laufwerken ein- und ausschalten und sofort starten (<a href="#hb-nc-sync">mehr</a>).</li>
      <li><b>„Netzlaufwerke in Nextcloud nutzen“</b> (<code>system.nextcloud_drives</code>): die freigegebenen Netzlaufwerke in Nextcloud sehen. Laufwerke mit einer PDH-Aufgabe sind dabei nur lesbar (<a href="#hb-drives-nextcloud">mehr</a>).</li>
      <li><b>„Netzlaufwerke in Nextcloud: auch PDH-Daten bearbeiten“</b> (<code>system.nextcloud_drives_write</code>): diese Laufwerke in Nextcloud auch beschreiben.</li>
      <li><b>„Cloudflare verwalten (DNS, Proxy, Tunnel)“</b> (<code>system.cloudflare</code>): DNS-Einträge, Proxy, Verschlüsselung der Domain und Ziele im Tunnel bei Cloudflare ändern (<a href="#hb-cloudflare-api">mehr</a>).</li>
    </ul>
    Alle vier stehen in der Kategorie „System &amp; Sicherheit“. Mit dem Update bekommen sie die Rollen, die überall die Server-Einstellungen pflegen dürfen. Das Kennzeichen <b>Administrator in Nextcloud</b> in der Benutzerkarte setzen nur Administratoren.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> Rechte für Zertifikate</b>
    <ul>
      <li><b>„Zertifikate verwalten (Let's Encrypt)“</b> (<code>system.certs</code>): Karte über <b>Zertifikate laden</b> öffnen, Namen eintragen, Zertifikate holen und erneuern, Full (strict) ein- und ausschalten (dafür zusätzlich „Cloudflare verwalten (DNS, Proxy, Tunnel)“) (<a href="#hb-zertifikate">mehr</a>).</li>
      <li><b>„Zertifikate: entfernen und widerrufen (Bereichsadministrator)“</b> (<code>system.certs_admin</code>): von den Zertifikat-Rechten allein genug, um die Karte zu sehen und zu bedienen, und als Einziges berechtigt, Namen zu entfernen – auch ohne Cloudflare-API-Token.</li>
      <li><b>„Namen im Haus eintragen (UniFi)“</b> (<code>system.unifi</code>): die UniFi-Anbindung im Reiter <b>UniFi</b> der Server-Einstellungen einrichten und Namen im Haus eintragen, auch die IPv6-Einträge (Typ AAAA) und beide Knöpfe „Überschreiben“.</li>
    </ul>
    Alle drei stehen in der Kategorie „System &amp; Sicherheit“. Mit dem Update bekommen sie alle Rollen, die „Cloudflare verwalten (DNS, Proxy, Tunnel)“ überall haben – niemand wird ausgesperrt. Die Karte hat im Reiter Cloudflare-Tunnel einen eigenen Knopf <b>Zertifikate laden</b>; das Cloudflare-Recht braucht man dafür nicht, den Reiter selbst öffnet, wer die Server-Einstellungen sehen darf.</div>
  <div class="hb-howto"><b><i class="ti ti-access-point"></i> Recht für die Omada-Anbindung</b>
    <b>„Omada-Controller anbinden“</b> (<code>system.omada</code>, Kategorie „System &amp; Sicherheit“): den Reiter <b>Omada</b> der Server-Einstellungen sehen, Adresse und Zugangsdaten speichern, den Fingerabdruck bestätigen und die Verbindung prüfen (<a href="#hb-omada">mehr</a>). Mit dem Update bekommen es alle Rollen und Benutzer, die „Namen im Haus eintragen (UniFi)“ haben – mit derselben Abteilung. Wem das UniFi-Recht einzeln entzogen ist, dem ist auch dieses entzogen. Niemand wird ausgesperrt, niemand bekommt mehr als bisher. Den Abgleich selbst schaltet ein, wer <code>it.netsync</code> hat.</div>
  <div class="hb-howto"><b><i class="ti ti-network"></i> Rechte für SNMP</b>
    <ul>
      <li><b>„SNMP-Zugangsprofile verwalten“</b> (<code>system.snmp</code>, Kategorie „System &amp; Sicherheit“): den Reiter <b>SNMP</b> der Server-Einstellungen sehen, Zugangsprofile anlegen und ändern (<a href="#hb-snmp">mehr</a>). Mit dem Update bekommen es alle Rollen und Benutzer, die „Namen im Haus eintragen (UniFi)“ haben – mit derselben Abteilung. Wem das UniFi-Recht einzeln entzogen ist, dem ist auch dieses entzogen.</li>
      <li><b>„SNMP: Zugangsprofile löschen (Bereichsadministrator)“</b> (<code>system.snmp_admin</code>): als Einziges berechtigt, ein Zugangsprofil endgültig zu löschen; allein genug, um den Reiter zu sehen und zu bedienen. Mit dem Update bekommen es nur Rollen, die überall sowohl <code>system.snmp</code> als auch „Zertifikate: entfernen und widerrufen (Bereichsadministrator)“ haben.</li>
      <li><b>Geräteliste</b> auf der Seite Netz-Abgleich: hinzufügen, prüfen, ein-/ausschalten und bearbeiten mit <code>it.netsync</code>. <b>Entfernen</b> nur mit „IT: Bereichsadministrator“ (<code>it.admin</code>); das IT-Asset bleibt dabei bestehen.</li>
    </ul>
    Niemand wird ausgesperrt, niemand bekommt mehr als bisher.</div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> Rechte für die Datei-Spiegelung</b>
    <ul>
      <li><b>„Datei-Spiegelung einstellen“</b> (<code>system.file_mirror</code>, Kategorie „System &amp; Sicherheit“): Spiegelung und „Nextcloud mitnehmen“ ein- und ausschalten, Werte ändern und <b>Jetzt abgleichen</b> (<a href="#hb-dateispiegelung">mehr</a>).</li>
      <li><b>„Datei-Spiegelung: Löschen am Partner freigeben und Papierkorb leeren“</b> (<code>system.file_mirror_admin</code>): <b>Dieser Server ist vollständig</b> bestätigen und den <b>Papierkorb leeren</b>. Wer beides darf, kann den Rückweg über den Papierkorb selbst beenden – darum nur wenigen geben.</li>
    </ul>
    Die beiden Rechte sind <b>eigenständig</b>: Das zweite schließt das erste nicht ein, anders als ein Bereichsadministrator. Wer einstellen und bestätigen soll, braucht beide. Sie gelten systemweit. Beim Update bekamen beide alle Rollen, die „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“ überall hatten.</div>
  <p><b>Was ohne Recht geht:</b> Störungen und Tickets melden, kommentieren, Zeiten erfassen und Chat. Alles andere – bearbeiten, Status ändern, abschließen, anlegen von Aufgaben, Projekten, Wartungen, IT-Geräten, Ersatzteilen und Lagerorten – braucht das passende Recht. Wer an einem Vorgang beteiligt ist (zugewiesen, verantwortlich, angelegt oder über die Gruppe), darf diesen Vorgang auch ohne das Recht bearbeiten. Fehlt ein Recht, meldet PDH „Keine Berechtigung“ mit dem Namen des Rechts.</p>
  <p><b>Historie:</b> Die Historie eines Datensatzes sieht, wer den Datensatz selbst sehen darf. Das gilt auch für Anlagen und Lagerorte. Bei Aufgaben und Wartungen sieht sie, wer die Aufgabe oder Wartung öffnen darf – wie die Seite selbst. Das Löschen einer Maßnahme über die Schnittstelle (API) prüft, ob die Maßnahme zu dem Vorgang gehört, unter dem sie gelöscht wird. Die Sortierung von Listen ist für alle gleich und braucht kein eigenes Recht (<a href="#sort">mehr</a>).</p>
  <p>Server-Einstellungen wie Datenbank, E-Mail, Microsoft 365 oder Nextcloud pflegst du unter <b>Server-Einstellungen</b> (<a href="#server">mehr</a>) – die <code>.env</code>-Datei muss dafür niemand mehr von Hand bearbeiten.</p>
  <h3>Berechtigungen <i class="ti ti-refresh" title="automatisch aus dem System"></i></h3>
  {{range .PermGroups}}
  <p style="margin-top:8px"><b>{{.Category}}</b></p>
  <ul>{{range .Items}}<li>{{.Label}} <code>{{.Key}}</code></li>{{end}}</ul>
  {{else}}<p class="rec-sub">Berechtigungen konnten nicht geladen werden.</p>{{end}}
  {{if $can}}<p class="rec-sub hb-shot-tools"><i class="ti ti-photo-plus"></i> Als Administrator kannst du unter jedem Kapitel eigene Bildschirmfotos hinzufügen – so wird das Handbuch zu eurem Handbuch.</p>{{end}}
  <h3 id="icons"><i class="ti ti-icons"></i> Symbole anpassen</h3>
  <p>Alle Symbole kommen aus einer Bibliothek mit rund 5.900 Symbolen (Tabler Icons), die der PDH-Server selbst ausliefert – es wird nichts aus dem Internet nachgeladen, PDH sieht also auch ohne Internetzugang vollständig aus. Unter <b>Verwaltung → Symbole</b> legst du fest, welches Symbol wofür steht: Navigation, Vorgangsarten und Datensätze, Anlagentypen, Lagertypen, IT-Typen und Knöpfe.</p>
  <div class="hb-howto"><b><i class="ti ti-icons"></i> So tauschst du ein Symbol aus</b>
    <ol class="hb-steps">
      <li><b>Verwaltung → Symbole</b> öffnen (nur Administratoren).</li>
      <li>Auf das Symbol links neben dem Eintrag klicken – die Auswahl öffnet sich. Suchbegriff eintippen (englisch, z. B. <i>tool</i>, <i>factory</i>, <i>plug</i>) und das passende Symbol anklicken. Wer den Namen kennt, trägt ihn direkt ins Feld ein.</li>
      <li><b>Speichern</b> – die Änderung gilt sofort für alle. <i class="ti ti-restore"></i> setzt einen Eintrag auf die Vorgabe zurück, <b>Alles zurücksetzen</b> alle.</li>
    </ol>
    Geänderte Einträge sind farbig umrandet. In Auswahllisten (Ausklapplisten) zeigen Browser keine Symbole – dort steht nur der Name.</div>
  <div class="hb-howto"><b><i class="ti ti-code"></i> Für Administratoren: Code-Editor (code-server)</b>Unter <b>Core-Einstellungen → Code-Editor</b> öffnet sich VS Code im Browser mit dem PDH-Quellcode, unter derselben Adresse wie das PDH: <code>…/code/</code>, z. B. <code>https://pdh.strobl-home.net/code/</code>.
    <ol class="hb-steps">
      <li>Als Administrator im PDH anmelden. Ein eigenes Passwort für den Editor gibt es nicht – die PDH-Anmeldung gilt.</li>
      <li><b>Core-Einstellungen → Code-Editor (code-server)</b>. Der Editor öffnet sich in einem neuen Tab mit dem Ordner <code>/workspace/pdh</code>.</li>
      <li>Dateien bearbeiten wie in VS Code. Unter <b>Terminal → Neues Terminal</b> stehen <code>go</code>, <code>git</code> und <code>make</code> bereit, z. B. <code>go test ./...</code>.</li>
    </ol>
    Andere Rollen kommen nicht hinein. Das Terminal läuft mit vollen Rechten im Container und sieht den Quellcode des Servers – Änderungen wirken erst nach einem Update bzw. Neubau. Git: Name und E-Mail einmalig im Terminal setzen (<code>git config --global user.name …</code>). <b>Einrichten:</b> bei der Docker-Installation automatisch mit dem Update; bei der Installation ohne Docker (systemd) einmalig auf dem Server im PDH-Verzeichnis <code>sudo bash scripts/install-code-server.sh</code> ausführen – danach baut jedes Update den Editor mit. Abschalten: <code>sudo bash scripts/install-code-server.sh --remove</code>. Steht nginx vor dem PDH und meldet der Editor <i>„WebSocket close with status code 1006“</i>, einmalig <code>sudo bash scripts/configure-pdh-nginx-websockets.sh</code> ausführen.</div>
  <div class="hb-howto"><b><i class="ti ti-route"></i> Für Administratoren: n8n und pgAdmin unter der PDH-Adresse</b>n8n (Automatisierung) und pgAdmin (Datenbank) laufen auf dem Server als eigene Container und sind über das PDH erreichbar: <code>…/n8n/</code> und <code>…/pgadmin/</code>, verlinkt unter <b>Core-Einstellungen</b>.
    <ol class="hb-steps">
      <li>Auf dem Server im PDH-Verzeichnis <code>sudo bash scripts/configure-pdh-admin-tools.sh</code> ausführen. Das Skript findet die Container, trägt sie im PDH ein, richtet die WebSockets in nginx ein und startet das PDH neu.</li>
      <li>Meldet es, dass n8n noch nicht für <code>/n8n/</code> eingestellt ist: die angezeigten Zeilen (<code>N8N_PATH</code>, <code>WEBHOOK_URL</code> …) in die Compose-Datei von n8n übernehmen und dort <code>docker compose up -d</code>.</li>
      <li>Die alte Seite „code-server“ in nginx macht den Code-Editor <b>ohne PDH-Anmeldung</b> erreichbar. Abschalten mit <code>sudo bash scripts/configure-pdh-admin-tools.sh --disable-old-code-site</code> und im Cloudflare-Tunnel den alten Hostnamen entfernen.</li>
    </ol>
    Nur Administratoren kommen hinein. pgAdmin und n8n behalten zusätzlich ihre eigene Anmeldung. Solange Code-Editor, n8n oder pgAdmin in einem Tab offen sind, meldet das PDH Administratoren <b>nicht wegen Inaktivität ab</b> – auch wenn der PDH-Tab daneben unberührt bleibt. Erst etwa 10 Minuten nach dem Schließen der Werkzeug-Tabs gilt wieder die normale Abmeldezeit. Ausnahme sind die <b>Webhooks</b> von n8n (<code>…/n8n/webhook/…</code>): Sie sind ohne Anmeldung erreichbar, damit externe Dienste n8n aufrufen können.</div>
  <div class="hb-howto"><b><i class="ti ti-certificate"></i> Für Administratoren: Zertifikate für Nextcloud</b>Unter <b>Core-Einstellungen → Zertifikate (Nextcloud)</b> stellt die eigene Zertifizierungsstelle des PDH drei Arten aus, jeweils als passwortgeschützte <b>.p12</b>:
    <ul>
      <li><b>Persönlich (Nextcloud-App)</b> – je Person und Gerät. Mit eingeschalteter <b>Selbstbedienung</b> stellen die Mitarbeitenden sie unter Mein Konto selbst aus.</li>
      <li><b>Gerät / Firma</b> – ein Zertifikat für mehrere Geräte. Sperren trifft alle zugleich.</li>
      <li><b>Server (Nextcloud)</b> – für Nextcloud unter eigenem Namen oder eigener IP im Firmennetz. <b>Kette</b> und <b>Schlüssel</b> in nginx eintragen; auf den Geräten einmal die CA installieren (<code>…/pki/ca.crt</code>).</li>
    </ul>
    <ol class="hb-steps">
      <li>Damit nginx nur Geräte mit Zertifikat hereinlässt, auf dem Nextcloud-Server einmalig <code>sudo bash scripts/configure-nextcloud-client-certs.sh --site /etc/nginx/sites-available/nextcloud.conf</code> ausführen. Zugriffe über den Cloudflare-Tunnel und vom PDH selbst sind ausgenommen. Im Verbund läuft der Befehl auf <b>beiden</b> Servern, und die eigenen Serveradressen nimmst du mit <code>--exempt</code> aus. Ob es geklappt hat, zeigt oben auf der Zertifikatsseite die Zeile <b>Zertifikatspflicht</b> (siehe unten).</li>
      <li>Zertifikate ausstellen bzw. ausstellen lassen, auf den Geräten einrichten (siehe „So richtest du die Nextcloud-App mit Zertifikat ein“ im Kapitel <a href="#users">Benutzer</a>).</li>
      <li>Verlorene Geräte: Zertifikat <b>sperren</b>. nginx holt die Sperrliste alle 6 Stunden, sofort mit <code>sudo systemctl start pdh-pki-crl</code>.</li>
    </ol>
    <p><b>Zertifikatspflicht – steht nginx richtig?</b> Oben auf der Zertifikatsseite (und in der Karte „Zertifikat für die Nextcloud-App“ unter Mein Konto) prüft das PDH, ob Nextcloud überhaupt nach einem Zertifikat fragt. Dazu verbindet es sich kurz mit der Nextcloud-Adresse und sendet kein Zertifikat; gespeichert oder geändert wird nichts. Das Ergebnis bleibt einige Minuten gemerkt.</p>
    <ul>
      <li><b>Aktiv</b> – nginx fragt nach PDH-Zertifikaten. Alles in Ordnung.</li>
      <li><b>Nicht eingerichtet</b> – Nextcloud fragt kein Zertifikat ab, die .p12 hat so keine Wirkung. Der Befehl steht gleich darunter; einmal auf dem Nextcloud-Server ausführen.</li>
      <li><b>Nicht prüfbar</b> – Nextcloud ist nicht eingerichtet oder vom PDH aus nicht erreichbar. Der Grund steht dabei.</li>
    </ul>
    <p><b>Server-Zertifikat oder Let's Encrypt?</b> Für die öffentliche Nextcloud-Adresse gilt das Let's-Encrypt-Zertifikat aus Server-Einstellungen → Reiter <b>Cloudflare-Tunnel</b>. Ein Server-Zertifikat aus dem PDH brauchst du nur für interne Namen ohne öffentliches Zertifikat, etwa <code>nextcloud.local</code> oder eine IP. Bei „Server (Nextcloud)“ steht dazu ein Hinweis; gibt es das Let's-Encrypt-Zertifikat schon, nennt er dessen Namen.</p>
    Die ausführliche Anleitung mit Cloudflare, Server-Zertifikat und Fehlersuche steht in <code>docs/nextcloud-zertifikate.md</code>. Achtung: Die Zertifizierungsstelle hängt am Geheimnis <code>PDH_AUTH_JWTSECRET</code>; wird es geändert, müssen alle Zertifikate neu ausgestellt werden.</div>
  {{template "hb-shots" (dict "Ref" (index $s "admin") "Can" $can)}}
</section>

<section class="hb-ch" id="statistics" data-title="Statistik (Grafana)" data-pages="statistics">
  <h2><i class="ti ti-chart-histogram"></i> Statistik (Grafana)</h2>
  <p>Unter <b>Navigation → Statistik</b> stehen große Kacheln. Jede öffnet ein Auswertungs-Dashboard aus Grafana – direkt im PDH oder in einem neuen Tab. Oben wechselst du mit den Schaltflächen zwischen den Dashboards; <i class="ti ti-maximize"></i> schaltet auf Vollbild. Dafür brauchst du das Recht <i>Statistik (Grafana-Dashboards) ansehen</i>.</p>
  <p>Mitgeliefert ist das Dashboard <b>PDH Übersicht</b>: offene Störungen und Tickets, neue Störungen je Woche, Störungen je Anlage, gebuchte Stunden je Kostenstelle, Tätigkeit und Art.</p>
  <div class="hb-howto"><b><i class="ti ti-layout-grid"></i> So fügst du eine Kachel hinzu (Administratoren)</b>
    <ol class="hb-steps">
      <li>In Grafana das gewünschte Dashboard öffnen und die Adresse aus der Browserzeile kopieren.</li>
      <li>Im PDH: <b>Core-Einstellungen → Grafana &amp; Statistik → Dashboard hinzufügen</b>.</li>
      <li><b>Titel</b>, optional Untertitel, und die <b>Adresse</b> einfügen. Ein Pfad wie <code>/d/abc123/name</code> genügt, wenn oben die Grafana-Adresse stimmt.</li>
      <li><b>Symbol</b> und <b>Farbe</b> antippen – die Vorschau zeigt die Kachel. <b>Kiosk-Ansicht</b> blendet die Grafana-Menüs aus; <b>Automatisch aktualisieren</b> lädt die Werte z. B. alle 5 Minuten neu.</li>
      <li><b>Speichern</b>. Mit <i class="ti ti-chevron-up"></i>/<i class="ti ti-chevron-down"></i> die Reihenfolge der Kacheln ändern, mit <i class="ti ti-eye-off"></i> ausblenden.</li>
    </ol></div>
  <p><b>Neu in Grafana:</b> Dashboards, die in Grafana angelegt werden, erscheinen unter Core-Einstellungen → Grafana &amp; Statistik automatisch im Kasten <b>Neu in Grafana</b> – <b>Übernehmen</b> legt die Kachel mit Titel und Ordner an. Auch im Leitstand-Editor beim Weiterblättern stehen sie gleich zur Wahl.</p>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> Grafana-Adresse und Anmeldung</b>
    Bei der Docker-Installation läuft Grafana <b>hinter dem PDH</b> unter <code>/grafana/</code> – gleiche Adresse und gleiches HTTPS wie das PDH, auch über den Cloudflare-Tunnel. Angemeldet ist man automatisch mit dem PDH-Konto: PDH-Administratoren sind in Grafana Admin, wer Kostenstellen verwaltet ist Editor, alle anderen dürfen nur ansehen. Unter Core → Grafana bleibt die Adresse deshalb leer; der grüne Punkt zeigt, ob Grafana läuft. Ein separates Grafana lässt sich dort als Adresse eintragen.<br><b>Installation ohne Docker (systemd):</b> Grafana einmalig auf dem Server einrichten – im PDH-Verzeichnis <code>sudo bash scripts/install-grafana.sh</code>. Das Skript startet Grafana als lokalen Container, legt den Nur-Lese-Benutzer an und verbindet es mit dem PDH.</div>
  <p>Notfall-Zugang direkt am Server: <code>http://127.0.0.1:3000/grafana/</code>, Benutzer <code>admin</code>, Passwort <code>PDH_GRAFANA_ADMIN_PASSWORD</code> aus <code>.env.docker</code>. Von außen ist Port 3000 bewusst nicht erreichbar. Grafana liest die PDH-Daten nur und sieht keine Passwörter oder Schlüssel.</p>
  {{template "hb-shots" (dict "Ref" (index $s "statistics") "Can" $can)}}
</section>

<section class="hb-ch" id="connections" data-title="Import, Export &amp; Verbindungsseite" data-pages="import export">
  <h2><i class="ti ti-database-import"></i> Import, Export &amp; Verbindungsseite</h2>
  <p>Eine <b>Verbindung</b> ist der Zugang zu einer Maschine oder einem System (MQTT, OPC UA, Modbus, SQL, Excel/CSV, Web/REST). Ein Klick auf den Namen in der Liste unter <b>Import</b> bzw. <b>Export</b> öffnet ihre eigene Seite mit den Reitern:</p>
  <ul>
    <li><b>Übersicht</b> – Einstellungen (Passwörter und Schlüssel werden nie angezeigt), Zustand der letzten Prüfung und was im Hintergrund läuft.</li>
    <li><b>Prüfungen</b> – <b>Jetzt prüfen</b> testet Pflichtangaben, Erreichbarkeit im Netz, TLS-Zertifikat, Anmeldung bzw. Datei, jede Abfrage, Zuordnungen ohne oder mit veraltetem Wert und ob die Hintergrund-Abrufe laufen. Fehler stehen mit Grund in der Tabelle.</li>
    <li><b>Abfragen</b> (nur Import) – beliebig viele benannte Abfragen je Verbindung: ein SQL-SELECT, ein Web-Endpunkt, ein Modbus-Registerblock, eine OPC-UA-Knotenliste oder eine Excel-/CSV-Zeile. Jede kann <b>automatisch alle … Minuten</b> laufen. MQTT liefert Werte von selbst und braucht keine Abfragen.</li>
    <li><b>Zuordnungen</b> bzw. <b>Felder</b> – welcher Wert zu welcher Anlage gehört, mit letztem Wert und Zeitpunkt.</li>
    <li><b>Vorlagen</b> – Abfragen und Zuordnungen einer Verbindung als Vorlage speichern und auf eine andere Verbindung desselben Typs anwenden.</li>
    <li><b>Explorer</b> (MQTT, OPC UA, Modbus TCP) – die Werte der Maschine live ansehen und einzelne Werte testweise schreiben. Eine Sitzung dauert höchstens 15 Minuten, pro Benutzer sind drei und auf dem Server 20 Sitzungen offen. Ansehen darf, wer die Verbindung ausführen darf (<b>Import ausführen</b> bzw. <b>Export ausführen</b>), denn der Explorer belastet das echte Gerät. Schreiben braucht zusätzlich <b>Import verwalten</b> bzw. <b>Export verwalten</b>, fragt vorher nach und steht danach im Verlauf der Verbindung. Auf dem Spiegelserver ist der Explorer nur lesend. Bei Modbus wählst du Bereich, Start und Anzahl, siehst jedes Register in allen Datentypen und stellst die Byte- und Wortreihenfolge um (z. B. CDAB bei WAGO); mit „Live verfolgen“ liest der Explorer im gewählten Takt (mindestens 1 Sekunde) und je Verbindung sind höchstens zwei Zugriffe gleichzeitig möglich. Mit <b>Als Zuordnung übernehmen</b> (im Export: <b>Als Zielfeld übernehmen</b>) machst du aus einem Wert direkt eine Zuordnung, ohne die Seite zu verlassen: bei MQTT ein ganzes Thema oder ein einzelnes JSON-Feld, bei OPC UA einen Knoten, bei Modbus ein Register mit Datentyp und Reihenfolge. Der Knopf erscheint nur mit dem Recht <b>Import verwalten</b> bzw. <b>Export verwalten</b>. Bestehende Zuordnungen bleiben unverändert gültig. Zuordnungen mit Reihenfolge (Modbus) oder JSON-Pfad (MQTT, <code>thema#pfad</code>) versteht erst Version 0.80.11 und neuer – im Verbund beide Server gleich aktualisieren. Im Reiter <b>Zuordnungen</b> einer Modbus- oder OPC-UA-Verbindung holt <b>Werte jetzt aktualisieren</b> alle Werte sofort (braucht <b>Import verwalten</b>). Der alte Sniffer, „Namespace durchsuchen“ und „Register lesen“ sind im Explorer aufgegangen, alte Lesezeichen führen dorthin.</li>
    <li><b>Werkzeuge</b> – Vorschau, Broker-Status usw. der Verbindung. Der Broker-Status zeigt die Adressen für Geräte und – wenn der Broker einen <a href="#mqttbroker">eigenen Namen</a> hat – die Prüfliste. Bei MQTT auch <b>TIA-Baustein herunterladen</b> für Siemens-Steuerungen (<a href="#tiabaustein">mehr</a>).</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-database-search"></i> So holst du einen Wert per Abfrage</b>
    <ol class="hb-steps">
      <li>Verbindung öffnen, Reiter <b>Abfragen</b>.</li>
      <li>Unten eine <b>Vorlage</b> „Übernehmen“ oder die Abfrage selbst eintragen. Platzhalter in &lt;spitzen Klammern&gt; durch eure Namen ersetzen.</li>
      <li>Ein Intervall eintragen (0 = nur von Hand) und <b>Speichern &amp; ausführen</b>. Das Ergebnis erscheint als Tabelle.</li>
      <li>Neben der gewünschten Spalte auf <i class="ti ti-map-pin"></i> klicken und die Anlage wählen. Zugeordnet wird die erste bzw. letzte Zeile des Ergebnisses.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-copy"></i> Mehrere gleiche Maschinen</b>Eine Maschine fertig einrichten, im Reiter <b>Vorlagen</b> als Vorlage speichern und auf der Verbindungsseite der nächsten Maschine <b>anwenden</b>. Abfragen und Zuordnungen entstehen dort genauso; schon Vorhandenes wird nicht doppelt angelegt.</div>
  {{template "hb-fig-explorer"}}
  <div class="hb-howto"><b><i class="ti ti-radar"></i> So findest du einen MQTT-Wert</b>
    <ol class="hb-steps">
      <li>Verbindung öffnen, Reiter <b>Explorer</b>, bei Bedarf einen <b>Filter</b> eintragen (<code>+</code> und <code>#</code> sind Platzhalter) und <b>Start</b> drücken.</li>
      <li>Im Themenbaum das Thema anklicken: rechts stehen letzter Wert, Anzahl, Zeit und ob der Wert gehalten (retained) ist.</li>
      <li>Ist der Wert JSON, auf das gewünschte Feld klicken und <b>Als Zuordnung übernehmen</b> drücken. Dann die Anlage wählen.</li>
      <li><b>Testsenden</b>: Thema und Inhalt eintragen und senden. <b>Der gesendete Inhalt steht danach im Verlauf der Verbindung – bitte keine Geheimnisse oder Kennwörter senden.</b></li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-sitemap"></i> So erkundest du einen OPC-UA-Server</b>
    <ol class="hb-steps">
      <li>Im Reiter <b>Explorer</b> die Knoten Schritt für Schritt <b>aufklappen</b>. Ein Klick zeigt Wert, Datentyp, Zeitstempel, Qualität und Zugriffsrechte.</li>
      <li><b>Verfolgen</b> nimmt einen Knoten in die Live-Liste auf; so siehst du mehrere Werte gleichzeitig.</li>
      <li><b>Als Zuordnung übernehmen</b> macht den Knoten zur Zuordnung.</li>
      <li><b>Testweise schreiben</b>: Wert eintragen und bestätigen. Knoten, die nur lesbar sind, lehnt der Explorer ab.</li>
    </ol>
    <p><b>Achtung:</b> Das PDH verbindet sich mit OPC UA immer ohne Verschlüsselung (Sicherheitsrichtlinie None). Meldet sich die Verbindung mit Benutzer und Passwort an, gehen beide im Klartext übers Netz; der Explorer zeigt dazu einen Hinweis. Solche Verbindungen nur in getrennten Anlagennetzen verwenden.</p></div>
  <div class="hb-howto"><b><i class="ti ti-binary"></i> So deutest du Modbus-Register</b>
    <ol class="hb-steps">
      <li>Im Reiter <b>Explorer</b> Einheit (Unit-ID), Bereich (Holding, Input, Coils, Discrete), Start und Anzahl eintragen und <b>Lesen</b>.</li>
      <li>Auf eine Zeile klicken: Das Register erscheint in allen Datentypen (INT16 bis FLOAT64) und in allen vier Reihenfolgen.</li>
      <li>Die <b>Reihenfolge</b> so lange umschalten, bis der Wert stimmt. Bei WAGO ist es meist <b>CDAB</b>.</li>
      <li><b>Als Zuordnung übernehmen</b>. Das geht nur mit der Einheit (Unit-ID) der Verbindung; für eine andere Einheit die Verbindung anpassen.</li>
      <li><b>Testweise schreiben</b> geht für Coils und Holding Register, aber nur mit der Einheit (Unit-ID) der Verbindung – bei einer anderen Einheit ist das Formular gesperrt, Einheit 0 (Rundruf) nie erlaubt. Die Rückfrage nennt die Einheit.</li>
    </ol>
    <table><thead><tr><th>Reihenfolge</th><th>Bedeutung</th></tr></thead><tbody>
      <tr><td>ABCD</td><td>Bytes und Wörter in Lese-Reihenfolge (Big Endian)</td></tr>
      <tr><td>CDAB</td><td>Wörter vertauscht, Bytes normal (häufig bei WAGO)</td></tr>
      <tr><td>BADC</td><td>Bytes je Wort vertauscht</td></tr>
      <tr><td>DCBA</td><td>alles umgekehrt (Little Endian)</td></tr>
    </tbody></table></div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Rechte und Grenzen im Explorer</b>
    <ul>
      <li>Ansehen: <b>Import ausführen</b> bzw. <b>Export ausführen</b>. Testweise schreiben oder senden: zusätzlich das Bearbeiten-Recht (<b>Import verwalten</b> bzw. <b>Export verwalten</b>), mit Rückfrage und Eintrag im Verlauf der Verbindung.</li>
      <li>Auf dem Spiegelserver ist Schreiben gesperrt.</li>
      <li>Eine Sitzung endet nach 15 Minuten; höchstens 3 je Benutzer, 20 je Server und 2 gleichzeitige Zugriffe je Gerät (gilt für OPC UA und Modbus). Für MQTT gelten nur die Sitzungsgrenzen.</li>
    </ul></div>
  <p>Ansehen darf, wer Import bzw. Export sehen darf; prüfen und ausführen, wer ausführen darf; ändern, wer bearbeiten darf.</p>
  <p>Beim Export gibt es außerdem die Art <b>Efficio-CSV (Energiedaten)</b>: Sie liefert die Minutenwerte der <a href="#energiedaten">Messstellen</a> als CSV und legt sie zum Abholen, auf einem Netzlaufwerk oder per FTP/SFTP ab. Statt der Vorschau gibt es dort die Seite <b>Dateien &amp; Protokoll</b> (<a href="#energiedaten">Efficio-Export einrichten</a>).</p>
  <p><b>Kennwörter</b> von Verbindungen werden verschlüsselt gespeichert und nie wieder angezeigt. Beim Bearbeiten das Kennwortfeld <b>leer lassen</b> – dann bleibt das gespeicherte Kennwort.</p>
  <p>Bei <b>MSSQL</b>-Verbindungen gibt es zusätzlich: den <b>Weg</b> (Direkt, ein ausgehender VPN-Tunnel oder ein Client des <a href="#datennetz">Datennetzes</a>; über VPN und Datennetz mit eigenem Abfragetakt von 5 bis 30 Minuten und eigener Zeitgrenze – beim Datennetz bitte den Port eintragen, eine benannte Instanz geht dort nicht), den <b>Fingerabdruck</b> des Serverzertifikats (einmal lesen und bestätigen) und den Schalter <b>Schreiben erlaubt</b>. Ohne diesen Schalter schreibt das PDH nie in die Datenbank. Wird der Weg geändert, stehen scharfe Profile des <a href="#abgleich">Abgleichs</a> wieder auf „Getestet“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "connections") "Can" $can)}}
</section>

<section class="hb-ch" id="mqttbroker" data-title="MQTT-Broker unter eigenem Namen" data-pages="import server-config">
  <h2><i class="ti ti-server-2"></i> MQTT-Broker unter eigenem Namen</h2>
  <p>Der <b>integrierte MQTT-Broker</b> einer MQTT-Verbindung kann einen eigenen Namen bekommen, z. B. <code>mqtt.firma.de</code> – wie das PDH und die Nextcloud. Geräte, Steuerungen und Apps tragen dann den Namen ein statt einer IP-Adresse, und die Verbindung ist mit einem gültigen Zertifikat verschlüsselt. Ohne Namen bleibt alles, wie es ist.</p>
  {{template "hb-fig-mqttname"}}
  <table class="hb-table">
    <thead><tr><th>Adresse</th><th>Wo</th><th>Wofür</th></tr></thead>
    <tbody>
      <tr><td><code>mqtt://name:1883</code></td><td>im Haus</td><td>Steuerungen und Geräte ohne TLS – der bisherige Port läuft unverändert weiter</td></tr>
      <tr><td><code>mqtts://name:8883</code></td><td>im Haus und über VPN</td><td>verschlüsselt (TLS-Port); das Zertifikat kommt aus der Zertifikatsliste und erneuert sich ohne Neustart</td></tr>
      <tr><td><code>wss://name/</code></td><td>im Haus und von außen</td><td>WebSocket über Port 443 – für Apps und Dienste, dieselbe Adresse drinnen und draußen</td></tr>
    </tbody>
  </table>
  <div class="hb-howto"><b><i class="ti ti-world-www"></i> So geht's: Broker unter eigenem Namen erreichbar machen</b>
    <ol class="hb-steps">
      <li><b>Import</b> → MQTT-Verbindung mit „Integrierter Broker“ bearbeiten.</li>
      <li><b>Name des Brokers (Subdomain)</b> eintragen, z. B. <code>mqtt.firma.de</code>. Dazu einen <b>WebSocket-Port</b> (z. B. 8083) und, wenn Geräte per mqtts verbinden sollen, einen <b>TLS-Port</b> (z. B. 8883). Die Felder „TLS-Zertifikat“ und „TLS-Schlüssel“ (Dateipfade) bleiben leer. Speichern.</li>
      <li>Der Name ist jetzt <b>vorgemerkt</b>. Das PDH richtet von selbst ein, was du darfst: Zertifikat holen (Recht „Zertifikate“), Namen im Haus eintragen (Recht „UniFi“) und die Ports in der Firewall des Servers öffnen. Das Zertifikat dauert ein bis zwei Minuten.</li>
      <li><b>Werkzeuge</b> → <b>Broker-Status</b> öffnen. Unter den Client-Einstellungen steht die <b>Prüfliste</b>. Oben steht der <b>Stand</b>: „vorgemerkt“ oder „scharf“. Was das PDH nicht selbst darf, steht in der Zeile mit dem genauen Eintrag, z. B. „A mqtt.firma.de → 192.0.2.15“ für den DNS im Haus.</li>
      <li>Sind Zertifikat und Firewall grün, schaltet das PDH den Namen <b>scharf</b> – auch ohne Eintrag im DNS im Haus (dann gehen Geräte im Haus den Weg über das Internet bzw. den Tunnel; die Zeile nennt den Eintrag zum Nachtragen): Es schreibt die nginx-Seite für <code>wss://name/</code> und die Zeile im Cloudflare-Tunnel (Recht „Cloudflare“). Hast du einen Eintrag von Hand nachgeholt, drücke <b>Einrichten / erneut prüfen</b>.</li>
      <li>Vorher ändert das PDH nichts an nginx und am Tunnel – ein halb eingerichteter Name kann den Zugang zum PDH so nicht stören. Änderst du später nur den WebSocket-Port, zieht das PDH die Tunnel-Zeile selbst nach.</li>
      <li>Oben stehen die fertigen Adressen zum Kopieren. In Steuerung, Gerät oder App eintragen, Benutzer und Kennwort wie bisher.</li>
    </ol>
  </div>
  <h3>Was die Prüfliste zeigt</h3>
  <ul>
    <li><b>Stand</b> – <b>vorgemerkt</b> (neuer oder geänderter Name, noch keine nginx-Seite und keine Tunnel-Zeile) oder <b>scharf</b>. Namen, die schon vor Version 0.82.15 eingerichtet waren, sind scharf.</li>
    <li><b>Zertifikat</b> – fehlt, wird geholt, gültig bis … oder die Fehlermeldung von Let's Encrypt. Ein Zertifikat gibt es nur, wenn Cloudflare eingerichtet ist (die Prüfung läuft über den DNS-Eintrag) und der Name in eurer Domain liegt.</li>
    <li><b>Name im Haus</b> – zeigt der Name im Firmennetz auf diesen Server? Sonst gehen Geräte im Haus den Umweg über das Internet oder finden den Broker gar nicht. Mit UniFi zählt der Eintrag an der UDM Pro – auch wenn der Server selbst zusätzlich einen DNS außerhalb des Hauses fragt. Zeigt der Name über IPv6 weiter nach außen, steht das als Hinweis dabei: Geräte, die IPv6 bevorzugen, erreichen <code>mqtt</code> und <code>mqtts</code> dann nicht.</li>
    <li><b>Tunnel (von außen)</b> – Ziel im Cloudflare-Tunnel und DNS-Eintrag. Dieselbe Zeile steht als <b>MQTT</b> in den Server-Einstellungen im Reiter Cloudflare-Tunnel.</li>
    <li><b>TLS-Port (mqtts)</b> – läuft, ist aus oder wartet auf das Zertifikat. Ist der Port schon von einem anderen Programm belegt, steht das hier; die übrigen Ports des Brokers laufen trotzdem. Dann einen anderen TLS-Port eintragen und die Verbindung speichern.</li>
    <li><b>WebSocket über 443 (wss)</b> – das PDH schreibt dafür eine eigene nginx-Seite. Auch auf dem zweiten Server des Verbunds; nach einem Rollentausch zieht er sie innerhalb weniger Minuten nach.</li>
    <li><b>Firewall am Server</b> – lässt die Firewall des Servers (ufw) den MQTT-Port und den TLS-Port durch? Diese Zeile gibt es auch bei einem Broker ohne eigenen Namen.</li>
  </ul>
  <div class="hb-howto" id="hb-mqtt-firewall"><b><i class="ti ti-shield-check"></i> So geht's: Ports in der Firewall öffnen</b>
    <ol class="hb-steps">
      <li>Nichts tun: Bei jedem Start des Brokers (Speichern oder Aktivieren der Verbindung, Neustart des PDH) öffnet das PDH den MQTT-Port und den TLS-Port in der Firewall des Servers selbst.</li>
      <li>Steht in der Prüfliste trotzdem „gesperrt“: <b>Ports öffnen</b> drücken.</li>
      <li>Kann das PDH die Firewall nicht ändern, nennt die Zeile den Befehl, z. B. <code>sudo ufw allow 1883/tcp &amp;&amp; sudo ufw allow 8883/tcp</code>. Ihn am Server ausführen – im Verbund auf beiden Servern – und <b>Neu prüfen</b> drücken.</li>
    </ol>
    Das PDH ändert die Firewall über den Update-Agenten. Ohne Update-Agent, im Docker-Betrieb oder mit einer anderen Firewall als ufw geht es nur von Hand. Im Verbund öffnet jeder Server seine eigene Firewall, sobald dort das PDH den Broker startet. Geöffnet wird nur im Server; ins Internet gibt das PDH keinen Port frei. Der WebSocket-Port bleibt zu, weil <code>wss</code> über Port 443 läuft. Das PDH schließt nie einen Port: Nach einem Portwechsel den alten am Server mit <code>sudo ufw delete allow 1883/tcp</code> entfernen.</div>
  <p>Die Prüfliste sieht, wer die Verbindung bearbeiten darf (<code>import.write</code>); damit geht auch <b>Ports öffnen</b>. Die anderen Knöpfe brauchen zusätzlich das Recht der jeweiligen Aktion: <code>system.certs</code> (Zertifikat), <code>system.unifi</code> (im Haus eintragen), <code>system.cloudflare</code> (Tunnel). Fehlt es dir, steht dort, wer es einrichten kann.</p>
  <div class="hb-note"><b>Von außen ohne WebSocket nur über VPN.</b> Reines MQTT (Port 1883 oder 8883) geht nicht durch den Cloudflare-Tunnel, und das PDH öffnet dafür keinen Port ins Internet. Geräte außer Haus verbinden sich per <code>wss://name/</code> – oder über das VPN und dann wie im Haus.</div>
  <ul>
    <li><b>Keep-Alive:</b> Bei <code>wss</code> höchstens 60 Sekunden einstellen. Cloudflare trennt Verbindungen, auf denen 100 Sekunden nichts läuft.</li>
    <li><b>Cloudflare, UniFi und Zertifikate sind Zusatz.</b> Ist etwas davon nicht eingerichtet, läuft der Broker trotzdem; die Prüfliste nennt, was dann nicht geht.</li>
    <li><b>Full (strict)</b> bleibt möglich: Der Name hat eine eigene Seite mit Zertifikat auf Port 443.</li>
    <li><b>Name ändern oder entfernen:</b> Das PDH räumt die nginx-Seite des alten Namens weg. Das Zertifikat bleibt in der Zertifikatsliste, bis du es dort entfernst.</li>
    <li><b>Je Name ein Broker.</b> Der Name des PDH und der Nextcloud ist nicht erlaubt.</li>
  </ul>
  {{template "hb-shots" (dict "Ref" (index $s "mqttbroker") "Can" $can)}}
</section>

<section class="hb-ch" id="tiabaustein" data-title="Steuerung per MQTT anbinden (TIA Portal)" data-pages="import">
  <h2><i class="ti ti-cpu"></i> Steuerung per MQTT anbinden (TIA Portal)</h2>
  <p>Das PDH erzeugt für eine <b>Siemens-Steuerung</b> fertige Bausteine, die Werte aus einem eigenen Datenbaustein per MQTT an den Broker senden. Die Werte kommen als Zuordnungen im PDH an – ohne dass du SCL schreiben musst. Es wird nur <b>gesendet</b>, nichts empfangen.</p>
  {{template "hb-fig-tia"}}
  <ul>
    <li><b>Steuerung:</b> S7-1500; S7-1200 ab Firmware 4.2. Das TIA Portal muss V17 oder neuer sein.</li>
    <li><b>Eigenständig</b> (TCON/TSEND/TRCV): braucht nichts weiter, sendet aber <b>ohne TLS</b>. Nur im geschützten Werksnetz einsetzen.</li>
    <li><b>Mit Siemens-Bibliothek LMQTT:</b> sendet auch <b>mit TLS</b> (Port 8883). Die Bibliothek holst du bei Siemens: <a href="https://support.industry.siemens.com/cs/ww/de/view/109748872" target="_blank" rel="noopener">Beitrag 109748872</a>. Das Bibliotheks-Paket „Bibliotheken für Kommunikation für SIMATIC Controller“ (Beitrag 109780503) enthält den Baustein <code>LMQTT_Client</code>. Die Namen der Bibliothek im Baustein sind für die dort beschriebene Version geschrieben; bei einer anderen Version prüfst du sie anhand der Liste „Vor dem Einsatz prüfen“ in der Datei <code>LIESMICH.txt</code>.</li>
    <li>Beide Bausteine haben dieselben Ein- und Ausgänge. Du kannst die Variante später wechseln.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-download"></i> So bekommst du den Baustein</b> (Recht „Steuerungsbaustein (TIA Portal) herunterladen“)
    <ol class="hb-steps">
      <li>Im TIA Portal einen <b>Datenbaustein</b> mit den Werten anlegen, die du senden willst (optimierter Zugriff). Rechtsklick → <b>Quelle aus Baustein generieren</b>. Nutzt der Baustein PLC-Datentypen, die abhängigen Bausteine mit auswählen. Das Ergebnis ist eine Datei <code>.db</code>.</li>
      <li>Im PDH die MQTT-Verbindung öffnen, Reiter <b>Werkzeuge</b> → <b>TIA-Baustein herunterladen</b>.</li>
      <li>Die Quelle hochladen und <b>Prüfen</b> drücken. Das PDH zeigt, welche Werte gesendet werden und was nicht (mit Grund). Das Prüfen geht auch auf dem Spiegelserver, das Herunterladen nicht.</li>
      <li>Variante, Steuerung, Broker-Adresse, Port, Topic und Heartbeat eintragen. Hat der Broker einen <a href="#mqttbroker">eigenen Namen</a>, ist er vorbelegt; mit dem Haken <b>TLS</b> setzt die Seite den Namen und den TLS-Port ein. Die Größengrenze je Nachricht ist 4096 Byte (erlaubt: 1024 bis 16384).</li>
      <li>Optional <b>Beim Herunterladen die Zuordnungen anlegen</b> ankreuzen (braucht das Recht „Import verwalten“). Dann entsteht je Wert eine Zuordnung, dazu der Heartbeat.</li>
      <li><b>Herunterladen</b> drücken. Du bekommst eine ZIP-Datei.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-cpu"></i> So bringst du den Baustein in die Steuerung</b>
    <ol class="hb-steps">
      <li>ZIP entpacken. Lies zuerst <code>LIESMICH.txt</code> – dort stehen deine Werte (Broker, Topic, Teile).</li>
      <li>Mit der LMQTT-Variante: Bibliothek LMQTT öffnen und den Baustein <code>LMQTT_Client</code> samt Datentypen in die Steuerung kopieren.</li>
      <li>Im TIA Portal unter <b>Externe Quellen</b> die Dateien hinzufügen: <code>1_PDH_…_Typ.udt</code>, <code>2_PDH_…_Konfig.db</code>, <code>3_PDH_MQTT_….scl</code>, <code>4_…_aus_Typ.db</code>.</li>
      <li>Von deinem bisherigen Datenbaustein <b>vorher eine Kopie sichern</b> (z. B. das Projekt archivieren) oder ihn löschen: „Bausteine aus Quelle generieren“ überschreibt den Datenbaustein gleichen Namens. Datei 4 legt ihn <b>nur mit den gesendeten Variablen</b> neu an. Was in der <code>LIESMICH.txt</code> unter „NICHT GESENDET“ steht, fehlt darin – trage es dort von Hand wieder ein oder halte es anderswo, bevor du übersetzt. Hattest du Variablen als <b>remanent</b> (Retain) eingestellt, stellst du das danach neu ein; das steht dann auch in der <code>LIESMICH.txt</code>.</li>
      <li>Jede Quelle mit <b>Bausteine aus Quelle generieren</b> übersetzen, <b>in dieser Reihenfolge 1 bis 4</b>.</li>
      <li>Im Konfigurations-Baustein (<code>PDH_…_Konfig</code>) Broker, Benutzer und Kennwort prüfen. Steht dort <code>PASSWORT_EINTRAGEN</code>, trägst du das Kennwort des Brokers ein.</li>
      <li>Den Funktionsbaustein in <b>OB1</b> aufrufen: <code>enable := TRUE</code>, <code>trigger</code> mit deiner Bedingung zum Senden (steigende Flanke), <code>daten := "&lt;dein DB&gt;"</code>.</li>
      <li><code>hwId</code> ist die <b>Hardware-Kennung der PROFINET-Schnittstelle</b> (Gerätekonfiguration → Schnittstelle → Eigenschaften; oft 64). <code>connId</code> muss in der Steuerung einmalig sein.</li>
      <li>Übersetzen und laden. Am Ausgang <code>statusText</code> siehst du, was der Baustein tut.</li>
      <li>Im PDH an der Verbindung prüfen: Die Zuordnungen bekommen Werte und der Heartbeat läuft.</li>
    </ol></div>
  <h3>Kennwort</h3>
  <p>Das Kennwort der Verbindung steht <b>nur</b> in der Datei, wenn du <b>Kennwort der Verbindung mitliefern</b> ankreuzt. Das geht nur mit dem Recht „Import verwalten“ und wird im Verlauf der Verbindung festgehalten. Sonst steht <code>PASSWORT_EINTRAGEN</code> in der Datei. Gib die ZIP-Datei mit Kennwort nicht weiter.</p>
  <h3>Große Datenmengen: mehrere Nachrichten</h3>
  <p>Passen die Werte nicht in eine Nachricht, teilt der Baustein sie auf. Jede Nachricht trägt <code>part</code> und <code>parts</code> (auch bei nur einer: 1 von 1) und denselben Zeitstempel <code>ts</code> aus der Steuerungsuhr. Alle Teile kommen aus demselben Abbild der Werte. Die Zuordnungen im PDH lesen den Wert über den JSON-Pfad, egal in welchem Teil er steht. Grenzen: höchstens 50 Teile, 2000 Einzelwerte, Quelldatei höchstens 1 MiB. Text zählt mit seiner Höchstlänge (Vorgabe 254 Zeichen). Mit Retain behält der Broker nur den <b>letzten Teil</b>, weil alle Teile an dasselbe Topic gehen – bei mehreren Teilen Retain besser auslassen.</p>
  <h3>Zuordnungen und erneut herunterladen</h3>
  <p>Lädst du mit <b>Zuordnungen anlegen</b> erneut herunter, entstehen <b>keine Doppelten</b>. Vorhandene Zuordnungen bleiben unverändert – nur der Heartbeat übernimmt ein geändertes Intervall.</p>
  <h3>Statuscodes</h3>
  <table>
    <thead><tr><th>Status</th><th>Bedeutung</th></tr></thead>
    <tbody>
      <tr><td><code>16#7000</code></td><td>aus (<code>enable</code> = FALSE)</td></tr>
      <tr><td><code>16#7001</code></td><td>verbinde</td></tr>
      <tr><td><code>16#7002</code></td><td>warte auf Broker</td></tr>
      <tr><td><code>16#7003</code></td><td>bereit</td></tr>
      <tr><td><code>16#7004</code></td><td>sende</td></tr>
      <tr><td><code>16#8001</code></td><td>TCON-Fehler (nur eigenständig): Adresse, Hardware-Kennung, Verbindungsnummer prüfen</td></tr>
      <tr><td><code>16#8002</code></td><td>Sendefehler</td></tr>
      <tr><td><code>16#8003</code></td><td>Empfangsfehler (nur eigenständig)</td></tr>
      <tr><td><code>16#81xx</code></td><td>Broker lehnt ab; xx ist der Rückgabecode (05 = Benutzer oder Kennwort falsch)</td></tr>
      <tr><td><code>16#8005</code></td><td>keine Antwort vom Broker</td></tr>
      <tr><td><code>16#8006</code></td><td>Verbindung eingeschlafen (keine Antwort auf PING; nur eigenständig)</td></tr>
      <tr><td><code>16#8007</code></td><td>beim Trigger nicht verbunden – es wird nichts zwischengespeichert</td></tr>
      <tr><td><code>16#8008</code></td><td>Nachricht zu lang</td></tr>
      <tr><td><code>16#8009</code></td><td>Uhrzeit nicht lesbar</td></tr>
      <tr><td><code>16#82xx</code></td><td>Fehler der Bibliothek LMQTT (<code>16#8201</code> beim Verbinden, <code>16#8202</code> beim Senden); ihr Status steht am Ende von <code>statusText</code></td></tr>
    </tbody>
  </table>
  <p>Nach einem Fehler trennt der Baustein, wartet 5 Sekunden und verbindet neu.</p>
  <h3>„Steuerung meldet sich nicht“</h3>
  <p>Der Baustein sendet in festem Abstand einen <b>Heartbeat</b> (Vorgabe 60 Sekunden, nie mit Retain). Mit <code>heartbeatInterval := T#0s</code> am Baustein schaltest du den Heartbeat aus; dann darf es die Heartbeat-Zuordnung nicht geben, sonst meldet sie „meldet sich nicht“. Beim Herunterladen mit Heartbeat 0 und „Zuordnungen anlegen“ schaltet das PDH die Überwachung einer vorhandenen Heartbeat-Zuordnung ab. Änderst du das Topic, bleibt die alte Heartbeat-Zuordnung bestehen – lösche sie, sonst meldet sie „meldet sich nicht“. Kommt der letzte Heartbeat vor länger als <b>drei Intervallen</b>, zeigt das PDH „Steuerung meldet sich nicht“: als Hinweis oben auf der Verbindungsseite, als Marke in der Zeile der Zuordnung und in der Übersicht der Zuordnungen. Vor dem ersten Heartbeat zählt der Zeitpunkt, an dem die Zuordnung angelegt wurde. Prüfe dann: Läuft die Steuerung? Ist der Broker erreichbar? Ist <code>enable</code> gesetzt? Was sagt <code>statusText</code>?</p>
  <div class="hb-howto"><b><i class="ti ti-test-pipe"></i> Tipp: Ausprobieren mit PLCSIM</b>Übersetzen, Aufruf und Aufbau der Nachricht kannst du in PLCSIM prüfen. Ob das einfache PLCSIM eine echte TCP-Verbindung ins Netz aufbaut, hängt von der Version ab. Teste das vorher mit einem einfachen <code>TCON</code>. Klappt es nicht, nimm für die Netzprüfung PLCSIM Advanced oder eine echte Steuerung.</div>
  <p>Der Heartbeat enthält einen Zähler (<code>count</code>). Das PDH zeigt ihn als <b>Handshake</b> auf der Anlagen-Schnellübersicht und am Terminal: Läuft er weiter, ist die Steuerung verbunden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "tiabaustein") "Can" $can)}}
</section>

<section class="hb-ch" id="esppdh" data-title="ESPPDH – eigene Mess- und Zählgeräte" data-pages="esppdh server-config">
  <h2><i class="ti ti-cpu"></i> ESPPDH – eigene Mess- und Zählgeräte</h2>
  <p>Mit <b>ESPPDH</b> baust du kleine Messgeräte selbst: eine ESP-Platine (ESP32 oder ESP8266), daran ein Stromzähler, eine Stromzange, ein Energiemesser oder eine Lichtschranke. Das PDH erstellt die Firmware für das Gerät; danach sendet das Gerät seine Werte an den eingebauten MQTT-Broker des PDH, die meisten alle 10 Sekunden.</p>
  <p>ESPPDH <b>misst für die Betriebsführung, nicht für die Abrechnung</b>. Die Geräte sind nicht geeicht – für Rechnungen gilt weiter der geeichte Zähler. ESPPDH ist ein Zusatz: Ohne es läuft das PDH wie bisher. Im Docker-Betrieb gibt es ESPPDH nicht. ESPPDH baut auf <b>ESPHome</b> auf (Lizenz GPLv3 bzw. MIT).</p>
  <p>Gibst du Geräte mit ESPPDH-Firmware an Dritte weiter, gilt für die Firmware die Lizenz von ESPHome (GPLv3): die YAML-Konfiguration (ohne Kennwörter, unter <b>Aktionen</b>) und die ESPHome-Version mitgeben.</p>
  <p>Du findest es unter <b>Navigation → Daten → ESPPDH</b> oder auf der Seite <b>Import</b> über den Verweis „ESPPDH – eigene Mess- und Zählgeräte“.</p>
  <div class="hb-howto"><b><i class="ti ti-route"></i> Der Weg zum fertigen Gerät</b>
    <ol class="hb-steps">
      <li><a href="#hb-esp-env">Umgebung einrichten</a> – einmal je Server.</li>
      <li><a href="#netzwerk">WLAN für Geräte freigeben</a> – einmal je WLAN, auf der Seite Netzwerk.</li>
      <li><a href="#hb-esp-new">Gerät anlegen</a>.</li>
      <li><a href="#hb-esp-blocks">Bausteine wählen und anschließen</a>.</li>
      <li><a href="#hb-esp-build">Firmware bauen</a>.</li>
      <li><a href="#hb-esp-flash">Firmware aufspielen (flashen)</a>.</li>
      <li><a href="#hb-esp-check">Im Explorer prüfen</a>, ob die Werte ankommen.</li>
    </ol></div>

  <h3 id="hb-esp-env"><i class="ti ti-tool"></i> Umgebung einrichten</h3>
  <p>Die Firmware baut das PDH am Server mit ESPHome. Dafür braucht jeder Server einmal eine eigene Umgebung. Das machen Administratoren mit dem Recht „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“.</p>
  <div class="hb-howto"><b><i class="ti ti-download"></i> So richtest du ESPPDH ein</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → Reiter <b>ESPPDH</b> öffnen.</li>
      <li><b>Umgebung einrichten</b> drücken und bestätigen. Das PDH lädt ESPHome aus dem Internet. Der Server braucht dafür Internet und Python 3.12 oder neuer (z. B. Ubuntu 24.04). Fehlt Python ganz, installiert das PDH es nach.</li>
      <li>Warten: Die Einrichtung läuft im Hintergrund und dauert einige Minuten. Die Karte zeigt „Umgebung wird eingerichtet …“ und aktualisiert sich selbst. Fertig ist es bei „Umgebung eingerichtet: ESPHome …“.</li>
      <li><b>Einschalten</b> drücken. Erst dann lassen sich Geräte anlegen.</li>
    </ol>
    <p>Ist der Knopf grau, fehlt der Update-Agent – ohne ihn lässt sich die Umgebung nicht einrichten. Klappt die Einrichtung nicht, steht der Grund rot in der Karte.</p></div>
  <ul>
    <li><b>Im Verbund (Ausfallschutz) auf beiden Servern einrichten.</b> Jeder Server baut mit seiner eigenen Umgebung, und bei jedem Update tauschen die Server die Rollen. Auf dem Spiegelserver geht „Umgebung einrichten“ genauso; ein- und ausschalten nur am aktiven Server.</li>
    <li><b>Updates:</b> Die ESPHome-Version, die mit dem PDH kommt, ist die <b>Mindestversion</b> (Grundumgebung). Ein PDH-Update hebt ESPHome nur an, wenn die Umgebung älter ist; eine neuere, vom PDH selbst geholte Version bleibt (siehe <a href="#hb-esp-aktuell">ESPHome bleibt von selbst aktuell</a>). Läuft gerade eine Einrichtung, wartet das Update bis zu 15 Minuten darauf. „veraltet“ steht in der Karte nur, wenn die Umgebung älter als die Mindestversion ist.</li>
    <li><b>Internet und Platz:</b> Das Einrichten, ein Update mit neuer ESPHome-Version und der erste Bau je Platinentyp laden aus dem Internet – der erste Bau mehrere hundert MB. Ein Bau braucht mindestens 2 GB freien Platz; die Karte zeigt, wie viel frei ist.</li>
    <li><b>Ausschalten:</b> Danach lassen sich keine Geräte anlegen und keine Firmware bauen. Wartende Bauten bricht das PDH ab, ein laufender Bau läuft zu Ende. Vorhandene Geräte senden weiter; du kannst sie weiter ändern, sperren und löschen.</li>
  </ul>

  <h3 id="hb-esp-aktuell"><i class="ti ti-refresh"></i> ESPHome bleibt von selbst aktuell</h3>
  <p>Jeder Server prüft <b>einmal am Tag</b> selbst, ob es eine neuere ESPHome-Version gibt. Er probt sie aus und schaltet nur um, wenn die Probe klappt. Sonst bleibt alles wie es war. Firmware von Geräten wird dabei <b>nie von selbst neu gebaut</b> oder aufgespielt.</p>
  <div class="hb-howto"><b><i class="ti ti-list-check"></i> Das geschieht jeden Tag</b>
    <ol class="hb-steps">
      <li><b>Prüfen:</b> Das PDH sucht die neueste stabile Version. Sie muss neuer sein als die laufende und mindestens <b>3 Tage</b> veröffentlicht sein (fehlerhafte Ausgaben werden meist in diesen Tagen ersetzt).</li>
      <li><b>Daneben einrichten:</b> Die neue Version bekommt eine eigene Umgebung neben der laufenden. Die laufende wird nicht angefasst, Bauten gehen weiter.</li>
      <li><b>Probe:</b> Das PDH prüft die Konfiguration der Musterkonfigurationen und jedes nicht gesperrten Geräts mit der neuen Version. Am aktiven Server baut es zusätzlich <b>einmal je verwendeter Chip-Familie</b> probeweise eine Firmware (das Ergebnis wird verworfen). Dafür nimmt es ein Gerät, dessen letzter Bau geklappt hat. Hat eine Chip-Familie kein solches Gerät, gibt es für sie keinen Probebau; das Ergebnis nennt das. Ein Server ohne Geräte macht keinen Probebau.</li>
      <li><b>Umschalten:</b> Klappt alles, nutzt das PDH ab jetzt die neue Version. Die bisherige bleibt als vorige Version liegen, ältere werden gelöscht.</li>
    </ol>
    <p>Ein Gerät, das schon mit der laufenden Version nicht durchgeht, zählt nicht gegen die neue. Das gilt auch für den Probebau: Scheitert er, baut das PDH dasselbe Gerät mit der laufenden Version. Scheitert es auch dort, wird es übersprungen.</p>
    <p>Ein echter Bau und eine Probe laufen nie zugleich. Wird während der Probe ein Bau gestartet, wartet er nur, bis der laufende Prüfschritt fertig ist. Dann ist er vor den übrigen Prüfungen dran. Solange er wartet, lässt er sich abbrechen.</p></div>
  <div class="hb-howto"><b><i class="ti ti-adjustments"></i> So bedienst du es</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → Reiter <b>ESPPDH</b> öffnen.</li>
      <li><b>ESPHome selbst aktuell halten</b> mit <b>Ausschalten</b> oder <b>Einschalten</b> umstellen. Ab Werk ist es an. Aus: Die Version ändert sich nur noch mit <b>Jetzt prüfen</b> oder durch ein PDH-Update auf eine neuere Mindestversion.</li>
      <li><b>Jetzt prüfen</b> startet die Prüfung sofort. Die 3 Tage Wartezeit gelten weiter; eine gescheiterte Version wird dabei erneut versucht. Solange geprüft wird („Prüfung läuft …“), sind die Knöpfe grau.</li>
      <li><b>Zurück zur vorigen Version</b> (steht nur da, solange es eine vorige Version gibt) bestätigen. Die Version, die du verlässt, gilt dann als gescheitert; die nächste tägliche Prüfung kommt erst 24 Stunden später. Während einer Prüfung geht das nicht.</li>
    </ol>
    <p>Die Karte zeigt, welche Version läuft, die Mindestversion, wann zuletzt geprüft wurde und mit welchem Ergebnis, den freien Platz und die zuletzt gescheiterte Version samt Ausgabe („Ausgabe anzeigen“). Die Knöpfe sind grau, wenn der Update-Agent fehlt. Ist er zu alt, steht in der Karte „Der Update-Agent ist zu alt – zuerst das PDH aktualisieren“: Dann zuerst das PDH aktualisieren.</p></div>
  <ul>
    <li><b>Wenn die Probe scheitert:</b> Die neue Version wird entfernt und mit dem Ende der Ausgabe vermerkt. Das PDH baut weiter mit der bisherigen Version. Die ESPPDH-Bereichsadministratoren (Recht <code>esppdh.admin</code>) bekommen <b>eine Meldung</b> je Version. Dasselbe gilt, wenn sich die neue Version nicht einrichten lässt, z. B. weil pip scheitert.</li>
    <li><b>Zu wenig Platz</b> zählt nicht gegen die neue Version. Für eine neue Version braucht der Server 3 GB freien Platz, für den Probebau 2 GB. Fehlt der Platz, zeigt die Karte einen Hinweis. Der nächste Lauf versucht es erneut.</li>
    <li><b>Neustart während der Probe:</b> Wird das PDH während einer Probe beendet oder neu gestartet, zählt das nicht gegen die neue Version. Es gibt keine Meldung. Bald nach dem Start prüft das PDH erneut.</li>
    <li><b>Neuer Versuch:</b> Eine gescheiterte Version wird <b>nicht täglich</b> wiederholt, sondern erst nach einem PDH-Update (das PDH kann dann angepasst sein) oder mit „Jetzt prüfen“. Das PDH merkt sich <b>alle</b> gescheiterten Versionen, nicht nur die letzte. Eine noch neuere Version wird ganz normal geprüft.</li>
    <li><b>Höchstens vier Umgebungen:</b> die Grundumgebung aus dem PDH (Mindestversion), die laufende, die vorige und eine neue Version in der Probe.</li>
    <li><b>Der Update-Agent stuft nie von selbst herab.</b> Zurück geht es nur auf die eine aufbewahrte vorige Version, und nie, während eine Umgebung eingerichtet wird.</li>
    <li><b>Zwei Server im Verbund:</b> Jeder Server prüft für sich und hat seine eigene Umgebung. Für kurze Zeit können sie verschiedene Versionen haben. Am Spiegelserver lässt sich der Schalter nicht umstellen; „Jetzt prüfen“ und „Zurück zur vorigen Version“ gehen dort. Der Spiegel macht nur die Konfigurationsprüfung, keinen Probebau.</li>
    <li><b>Ohne Internet</b> bleibt die Version, wie sie ist. Die Karte vermerkt, dass die Prüfung nicht möglich war. Das PDH läuft unverändert.</li>
    <li><b>Am Gerät:</b> Wurde die Firmware mit einer älteren ESPHome-Version gebaut als die, die der Server jetzt hat, zeigt die Seite des Geräts einen Hinweis. Neu bauen und flashen ist möglich, aber nicht nötig – das entscheidest du.</li>
  </ul>

  <h3 id="hb-esp-new"><i class="ti ti-plus"></i> Gerät anlegen</h3>
  <div class="hb-howto"><b><i class="ti ti-cpu"></i> So legst du ein Gerät an</b>
    <ol class="hb-steps">
      <li>Vorher, einmal je WLAN: Auf der Seite <a href="#netzwerk">Netzwerk</a> beim WLAN der Geräte <b>Bearbeiten</b>, den Haken <b>Für ESPPDH-Geräte nutzbar</b> setzen und speichern. Das darf, wer die Seite Netzwerk pflegt (<code>system.network</code>). Für „Kabel“ ist das nicht nötig.</li>
      <li><b>ESPPDH</b> öffnen und <b>Neues Gerät</b> drücken.</li>
      <li><b>Name</b> eintragen, z. B. „Presse 3 – Stromzähler“.</li>
      <li><b>Kennung</b> eintragen: 3 bis 32 Zeichen aus a–z, 0–9 und „-“, das „-“ nicht am Anfang oder Ende. Leer lassen – dann bildet das PDH sie aus dem Namen. Die Kennung steht im Thema und im Zugang am Broker und <b>lässt sich später nicht ändern</b>.</li>
      <li><b>Anlage</b> wählen. Sie zählt auch für die Rechte: Wer ESPPDH nur in einer Abteilung darf, sieht und ändert nur Geräte an deren Anlagen.</li>
      <li><b>Broker (Verbindung)</b> wählen. Zur Wahl stehen nur MQTT-Verbindungen mit „Integrierter Broker“. Gibt es noch keine, unter <b>Import</b> eine anlegen.</li>
      <li><b>Platine</b> wählen (siehe Tabelle). Bei „Andere Platine“ die <b>Platinen-Kennung von ESPHome</b> eintragen, z. B. <code>nodemcuv2</code>.</li>
      <li><b>WLAN oder Kabel</b> wählen. Zur Wahl stehen nur die WLANs, die auf der Seite <a href="#netzwerk">Netzwerk</a> für ESPPDH-Geräte freigegeben sind; ist noch keines freigegeben, sagt das Formular es. „Kabel“ geht nur mit Platinen mit Ethernet; bei <b>Netz am Kabel</b> kannst du das Netz angeben.</li>
      <li><b>Anlegen</b> drücken. Die Kennwörter für den Zugang am Broker und für den Notzugang vergibt das PDH selbst. Danach öffnet sich die Seite des Geräts.</li>
    </ol></div>
  <table><thead><tr><th>Platine</th><th>Netz</th><th>TLS</th><th>USB-Flash im Browser</th></tr></thead><tbody>
    <tr><td>ESP32 DevKit</td><td>WLAN</td><td>ja</td><td>ja</td></tr>
    <tr><td>ESP32-S3 DevKitC</td><td>WLAN</td><td>ja</td><td>ja</td></tr>
    <tr><td>ESP32-C3 DevKitM</td><td>WLAN</td><td>ja</td><td>ja</td></tr>
    <tr><td>ESP8266 D1 mini</td><td>WLAN</td><td>nein</td><td>ja</td></tr>
    <tr><td>WT32-ETH01 (Ethernet)</td><td>Kabel oder WLAN</td><td>ja</td><td>ja</td></tr>
    <tr><td>Olimex ESP32-POE (Ethernet)</td><td>Kabel oder WLAN</td><td>ja</td><td>ja</td></tr>
    <tr><td>Andere Platine</td><td>WLAN</td><td>ja, außer ESP8266</td><td>nein – herunterladen</td></tr>
  </tbody></table>
  <ul>
    <li><b>Andere Platine:</b> Das PDH prüft dann keine Pins. Es kennt auch keinen Spannungsteiler vor dem Analog-Pin – die Stromzange zeigt dann womöglich falsche Werte – und keine Grenze für serielle Anschlüsse. Wenn möglich, eine Platine aus der Liste nehmen.</li>
    <li><b>ESP8266</b> kann nicht verschlüsselt verbinden. Hat der Broker TLS und dazu einen Port ohne TLS, erscheint <b>ohne TLS (Port …)</b> zum Ankreuzen – das Gerät sendet dann unverschlüsselt. Besser: eine ESP32-Platine.</li>
  </ul>

  <h3 id="hb-esp-blocks"><i class="ti ti-puzzle"></i> Bausteine wählen und anschließen</h3>
  <p>Ein <b>Baustein</b> ist das, was am Gerät hängt: ein Zähler, eine Zange, ein Energiemesser oder ein Sensor. Ein Gerät hat bis zu 24 Bausteine.</p>
  <div class="hb-howto"><b><i class="ti ti-puzzle"></i> So fügst du einen Baustein hinzu</b>
    <ol class="hb-steps">
      <li>Auf der Seite des Geräts unter <b>Bausteine</b> bei <b>Baustein</b> die Art wählen und <b>Hinzufügen</b> drücken.</li>
      <li>Die Felder ausfüllen. Beim Pin schlägt das Feld die Pins der Platine vor, z. B. <code>GPIO4</code> oder beim D1 mini <code>D5</code>. Kommazahlen mit Komma und ohne Tausenderpunkt, z. B. <code>22,5</code>.</li>
      <li><b>Speichern</b>. Das PDH prüft alles wie beim Bau. Passt ein Pin nicht zur Platine oder ist er doppelt belegt, steht oben „Nicht gespeichert – bitte prüfen“ mit dem Grund.</li>
    </ol>
    <p>Mit <i class="ti ti-arrow-up"></i> und <i class="ti ti-arrow-down"></i> änderst du die Reihenfolge, mit <i class="ti ti-trash"></i> entfernst du einen Baustein. Beides gilt erst nach dem Speichern.</p></div>
  <p>Jeder Baustein bekommt eine <b>feste Nummer</b> je Art, z. B. <code>s0-1</code>, <code>s0-2</code>. Sie bleibt, auch wenn du andere Bausteine löschst oder verschiebst, denn sie steht im Thema: <code>esppdh/&lt;kennung&gt;/&lt;baustein&gt;-&lt;nr&gt;/&lt;wert&gt;</code>, z. B. <code>esppdh/presse3-strom/s0-1/zaehlerstand</code>. Nur wenn du den Baustein mit der höchsten Nummer löschst, bekommt der nächste neue dieser Art dieselbe Nummer wieder.</p>
  <table><thead><tr><th>Baustein</th><th>Felder</th><th>Werte (Ende des Themas)</th></tr></thead><tbody>
    <tr><td><b>S0-Zähler</b> (<code>s0</code>) – Impulsausgang eines Stromzählers</td><td>Pin; Impulse je kWh (Vorgabe 1000, steht auf dem Zähler)</td><td><code>leistung</code> (W), <code>zaehlerstand</code> (kWh)</td></tr>
    <tr><td><b>Stromzange SCT-013</b> (<code>sct013</code>)</td><td>Analog-Pin; Zangentyp (5A/1V, 30A/1V, 50A/1V oder 100A/50mA – steht auf der Zange); Bürdenwiderstand (Ω), nur bei 100A/50mA; Netzspannung (V, Vorgabe 230)</td><td><code>strom</code> (A), <code>scheinleistung</code> (VA)</td></tr>
    <tr><td><b>PZEM-004T</b> (<code>pzem</code>) – Energiemesser, Version 3</td><td>RX-Pin; TX-Pin; Adresse (Vorgabe 1)</td><td><code>spannung</code> (V), <code>strom</code> (A), <code>leistung</code> (W), <code>energie</code> (kWh)</td></tr>
    <tr><td><b>Stückzähler</b> (<code>counter</code>) – z. B. Lichtschranke</td><td>Pin; Entprellzeit (ms, Vorgabe 50); Flanke (Vorgabe „fallend“)</td><td><code>stueckzahl</code> (Stk)</td></tr>
  </tbody></table>
  <ul>
    <li>Die Stromzange braucht einen Pin, der analog messen kann; die anderen Bausteine nehmen digitale Pins. Das Feld schlägt jeweils nur passende Pins vor.</li>
    <li><b>Nach einem Neustart beginnt das Gerät bei 0.</b> Zählerstand (S0) und Stückzahl zählt das Gerät seit seinem Start; es speichert sie nicht. Neu starten wird es nach einem Stromausfall oder Ausstecken, nach dem Flashen und nach einem Absturz. Fallen nur Broker, PDH oder WLAN aus, startet es <b>nicht</b> neu: Es zählt weiter und sendet wieder, sobald die Verbindung steht. Die Energie des PZEM-004T zählt der PZEM selbst; sie bleibt.</li>
    <li>Die <b>Scheinleistung</b> der Stromzange ist Strom mal eingetragene Netzspannung, keine gemessene Wirkleistung. Genauer misst der PZEM-004T.</li>
  </ul>
  <div class="hb-howto"><b><i class="ti ti-bolt"></i> Sicherheit: Netzspannung nur durch eine Elektrofachkraft</b>
    <p>PZEM-004T und Stromzangen sitzen an Leitungen mit 230 V. Den PZEM anschließen, eine Zange um einen Leiter legen oder einen Verteiler öffnen darf <b>nur eine Elektrofachkraft</b>. Die ESP-Platine selbst läuft mit Kleinspannung (USB oder Netzteil). Ihre Pins vertragen höchstens 3,3 V.</p></div>
  <p><b>S0-Zähler:</b> S0+ des Zählers an den Pin des Bausteins, S0− an GND. Der Pin hat einen Pull-up eingebaut.</p>
  {{template "hb-fig-esp-s0"}}
  <p><b>Stromzange SCT-013:</b> Die Zange kommt um <b>einen</b> Leiter (L oder N), nicht um das ganze Kabel – sonst heben sich die Ströme auf und die Zange misst 0. Ein Ende der Zange an den Analog-Pin. Das andere Ende an eine Vorspannung auf halber Versorgung: zwei gleiche Widerstände (z. B. je 10 kΩ) zwischen 3,3 V und GND, an ihrer Mitte ein Kondensator (z. B. 10 µF) gegen GND. Beim Typ 100A/50mA gehört zusätzlich der Bürdenwiderstand zwischen die beiden Enden der Zange; seinen Wert trägst du bei „Bürdenwiderstand (Ω)“ ein. Die Typen mit 1V haben die Bürde schon eingebaut.</p>
  <p><b>Bürde bemessen:</b> höchstens 2000 geteilt durch den größten Strom in A – bei 100 A also 20 Ω. Eine größere Bürde schneidet hohe Ströme ab und kann bei vollem Strom den Pin überlasten. Die Zange so wählen, dass ihr Nennstrom über dem größten Strom liegt. <b>ESP32-C3:</b> Sein Analog-Pin misst nur bis etwa 2,5 V. Eine 1-V-Zange misst dort nur bis etwa 60 % ihres Nennstroms (30A/1V bis etwa 18 A), und die Bürde darf höchstens 1200 geteilt durch den Strom sein. Für größere Ströme eine andere Platine nehmen.</p>
  {{template "hb-fig-esp-sct"}}
  <p><b>PZEM-004T:</b> Ihn gibt es für 10 A – dann fließt der Strom durch den PZEM, er wird in Reihe angeschlossen – und für 100 A mit Stromwandler um einen Leiter. TX des PZEM an den RX-Pin, RX des PZEM an den TX-Pin – über Kreuz – und GND an GND. Die Schnittstelle des PZEM ist für 5 V gebaut, die Pins des ESP vertragen nur 3,3 V: den PZEM mit 3,3 V vom ESP versorgen, wenn er damit läuft, sonst einen Pegelwandler dazwischen setzen. ESPPDH kann die Adresse eines PZEM nicht einstellen. Mehrere PZEM an denselben zwei Pins brauchen deshalb vorher mit einem anderen Werkzeug je eine eigene Adresse – dabei immer nur einen PZEM anschließen (ab Werk haben alle die Adresse 1). Sonst jedem PZEM ein eigenes Pin-Paar geben. Wie viele serielle Anschlüsse die Platine dafür hat, prüft das PDH beim Speichern (nicht bei „Andere Platine“).</p>
  {{template "hb-fig-esp-pzem"}}
  <p><b>Stückzähler mit Lichtschranke:</b> Der Sensorausgang oder ein Kontakt schaltet zwischen Pin und GND; der Pin hat einen Pull-up. Direkt an den Pin dürfen nur ein potentialfreier Kontakt oder ein Ausgang, der nur nach GND schaltet und selbst keine Spannung ausgibt (offener Kollektor). <b>Sensoren mit 24 V nie direkt anschließen</b> – dazwischen ein Koppelrelais oder Optokoppler, dessen Kontakt zwischen Pin und GND schaltet. <b>Flanke:</b> „fallend“ ist der Normalfall und zählt, wenn der Sensor schaltet (Teil kommt an); „steigend“ zählt, wenn er wieder öffnet (Teil ist durch). <b>Entprellzeit:</b> Kürzere Impulse und Prellen zählen nicht – bei schnellen Teilen kleiner einstellen.</p>
  {{template "hb-fig-esp-counter"}}

  <h3 id="hb-esp-build"><i class="ti ti-hammer"></i> Firmware bauen</h3>
  <div class="hb-howto"><b><i class="ti ti-hammer"></i> So baust du die Firmware</b>
    <ol class="hb-steps">
      <li>Gerät und Bausteine speichern. Steht oben „Für die Firmware fehlt noch:“, erst das ergänzen und speichern.</li>
      <li>Unter <b>Zugang am Broker</b> die Zeile <b>Broker</b> prüfen: Für diese Adresse und diesen Port wird die Firmware gebaut. Das Gerät muss den Server darunter erreichen.</li>
      <li>In der Karte <b>Firmware</b> auf <b>Firmware bauen</b> drücken. Der Bau steht in der Schlange („wartet“) – es baut immer nur ein Gerät zur Zeit.</li>
      <li>Der Verlauf erscheint darunter und aktualisiert sich alle 2 Sekunden. Am Ende steht <b>fertig</b> – oder <b>fehlgeschlagen</b>, dann steht der Grund unten im Verlauf.</li>
    </ol>
    <p>Der erste Bau je Platinentyp lädt Werkzeuge aus dem Internet (mehrere hundert MB) und dauert deshalb länger. Ein Bau darf höchstens 30 Minuten dauern, danach bricht das PDH ihn ab. <b>Abbrechen</b> beendet einen wartenden oder laufenden Bau. Unter <b>Letzte Läufe</b> zeigt <b>Verlauf</b> ältere Läufe. Kennwörter schwärzt das PDH im Verlauf.</p></div>
  <ul>
    <li><b>Welche Adresse?</b> Hat der Broker einen <a href="#mqttbroker">eigenen Namen</a>, nimmt die Firmware den Namen. Sonst nimmt sie die Adresse, unter der du das PDH gerade geöffnet hast. Der Lauf zeigt sie als „Firmware für …“. Im Verbund (Ausfallschutz) muss das der Name oder die mitwandernde Adresse sein, nie die feste Adresse eines Servers – sonst findet das Gerät den Broker nach einem Rollentausch nicht.</li>
    <li><b>localhost geht nicht:</b> Steht als Broker <code>localhost</code> oder <code>127.0.0.1</code>, baut das PDH nicht. Dann am Broker einen Namen eintragen oder das PDH über seine Adresse im Netz öffnen und neu bauen.</li>
    <li><b>„Konfiguration seit dem letzten Bau geändert“</b> zeigt die Karte, sobald sich etwas geändert hat, das in die Firmware geht: Name, Platine, WLAN oder Kabel, das WLAN-Kennwort (auch auf der Seite Netzwerk), Broker-Adresse, Port oder TLS, das MQTT-Kennwort sowie die Bausteine mit ihren Feldern und ihrer Reihenfolge. Die Firmware auf dem Gerät passt dann nicht mehr: neu bauen und aufspielen. Anlage, Notiz und „Netz am Kabel“ gehen nicht in die Firmware und lösen den Hinweis nicht aus.</li>
    <li>Firmware bauen geht nur am aktiven Server. Am Spiegelserver sind die Seiten nur lesbar.</li>
    <li><b>Konfiguration (YAML, ohne Kennwörter)</b> unter <b>Aktionen</b> lädt die ESPHome-Konfiguration des Geräts zum Nachsehen herunter.</li>
  </ul>

  <h3 id="hb-esp-flash"><i class="ti ti-usb"></i> Firmware aufspielen (flashen)</h3>
  <div class="hb-howto"><b><i class="ti ti-usb"></i> So flashst du per USB</b>
    <ol class="hb-steps">
      <li>Die Seite des Geräts in <b>Chrome oder Edge</b> öffnen, und zwar über die <b>https-Adresse</b> des PDH. Nur dann erscheint der Knopf <b>Per USB flashen</b>.</li>
      <li>Das Gerät per USB-Kabel an diesen Rechner anschließen.</li>
      <li>In der Karte <b>Firmware</b> unter <b>Firmware aufspielen</b> auf <b>Per USB flashen</b> drücken und den Anschluss wählen.</li>
      <li>Im Fenster (es ist englisch) „Install …“ und dann „Install“ wählen. Das Gerät wird gelöscht und neu beschrieben. Die Seite dabei offen lassen.</li>
      <li>Das Gerät startet neu und meldet sich am Broker. Seite neu laden: Oben steht dann <b>verbunden</b>. Sonst siehe <a href="#hb-esp-silent">Wenn sich das Gerät nicht meldet</a>.</li>
    </ol>
    <p>Platinen ohne USB-Buchse (z. B. WT32-ETH01) schließt du über einen USB-Seriell-Wandler mit 3,3 V an; wie die Platine in den Flash-Modus kommt, steht beim Hersteller.</p></div>
  <ul>
    <li><b>Ohne Chrome oder Edge oder ohne https</b> steht dort „USB-Flash braucht Chrome oder Edge und eine https-Adresse des PDH“. Dann mit <b>Firmware zum ersten Flashen</b> die Datei herunterladen (<code>esppdh-&lt;kennung&gt;-factory.bin</code>) und mit einem anderen Werkzeug (z. B. esptool) ab Adresse 0 aufspielen.</li>
    <li><b>Andere Platine:</b> kein USB-Flash im Browser, nur herunterladen.</li>
    <li><b>Update-Datei (über das Netz)</b> (<code>…-ota.bin</code>) ist für spätere Updates über das Netz gedacht. Das kann ESPPDH noch nicht – bis dahin jedes Gerät per USB neu flashen.</li>
    <li><b>Nach einer Änderung erst neu bauen.</b> Passt die Firmware nicht mehr zur Konfiguration, fehlt der Knopf „Per USB flashen“; dort steht „Per USB flashen geht erst nach einem neuen Bau“.</li>
    <li>Die Firmware enthält WLAN- und MQTT-Kennwort. Nur für dieses Gerät verwenden und die Datei nicht weitergeben.</li>
  </ul>

  <h3 id="hb-esp-check"><i class="ti ti-radar"></i> Im Explorer prüfen</h3>
  <p>Liste und Seite des Geräts zeigen den <b>Zustand</b> am Broker:</p>
  <table><thead><tr><th>Zustand</th><th>Bedeutung</th></tr></thead><tbody>
    <tr><td><span class="badge b-green">verbunden</span></td><td>Das Gerät ist gerade am Broker angemeldet.</td></tr>
    <tr><td><span class="badge b-gray">nicht verbunden</span></td><td>Gerade nicht angemeldet. Der Zusatz sagt mehr, z. B. „Noch keine Firmware gebaut“, „Der Broker läuft an diesem Server nicht“ oder – gelb – „Nicht verbunden. Hat es sich noch nie gemeldet: Freigabe für … Port … prüfen.“</td></tr>
    <tr><td><span class="badge b-red">gesperrt</span></td><td>Das Gerät ist gesperrt und kann sich nicht anmelden.</td></tr>
  </tbody></table>
  <p>Das PDH weiß nur, ob das Gerät <b>jetzt</b> verbunden ist – nicht, wann es sich zuletzt gemeldet hat. Der Zustand gilt beim Öffnen der Seite; zum Auffrischen die Seite neu laden. Am Spiegelserver steht „Spiegel – den Zustand kennt nur der aktive Server“.</p>
  <div class="hb-howto"><b><i class="ti ti-radar"></i> So siehst du die Werte des Geräts</b>
    <ol class="hb-steps">
      <li>Auf der Seite des Geräts unter <b>Zugang am Broker</b> bei <b>Nachrichten</b> das Thema <code>esppdh/&lt;kennung&gt;/#</code> mit <i class="ti ti-copy"></i> kopieren. Ohne https markiert der Knopf das Thema nur – dann mit <kbd>Strg</kbd>+<kbd>C</kbd> kopieren.</li>
      <li><b>Explorer der Verbindung öffnen</b> (braucht das Recht „Import ausführen“).</li>
      <li>Das Thema in den Themenfilter einfügen und <b>Starten</b> drücken.</li>
      <li>Im Themenbaum stehen <code>status</code> und je Baustein seine Werte, z. B. <code>s0-1/zaehlerstand</code>. Die meisten Werte kommen alle 10 Sekunden. Die Leistung des S0-Zählers kommt nur, wenn Impulse eintreffen – bei kleiner Last seltener; kommt 5 Minuten lang kein Impuls, meldet das Gerät 0. Den Zählerstand gibt es ab dem ersten Impuls.</li>
    </ol>
    <p><code>esppdh/&lt;kennung&gt;/status</code> zeigt <code>online</code>, solange das Gerät verbunden ist, und <code>offline</code>, sobald es sich abmeldet oder seine Verbindung abreißt.</p></div>

  <h3 id="hb-esp-silent"><i class="ti ti-help-circle"></i> Wenn sich das Gerät nicht meldet</h3>
  <p>Zuerst die Hinweise oben auf der Seite des Geräts lesen. Dann der Reihe nach prüfen:</p>
  <ol>
    <li><b>Nachrichten speichern am Broker an?</b> Das Gerät meldet seinen Zustand als gespeicherte Nachricht. Ist an der Verbindung „Retained Messages erlauben“ aus, weist der Broker das Gerät ab. Die Seite des Geräts zeigt dann einen roten Hinweis mit dem Weg zu den Einstellungen der Verbindung: dort einschalten und speichern.</li>
    <li><b>Verbindung eingeschaltet?</b> Ist sie aus, läuft ihr Broker nicht.</li>
    <li><b>Freigabe in der Firewall:</b> Liegt das Gerät in einem anderen Netz (VLAN) als der Server, muss die Firewall zwischen den Netzen durchlassen: <b>von</b> dem Netz des Geräts (Adressbereich auf der Seite <a href="#netzwerk">Netzwerk</a>) <b>zu</b> der Adresse des Brokers, <b>Port</b> wie unter „Zugang am Broker“ (z. B. 1883 ohne TLS, 8883 mit TLS), Protokoll <b>TCP</b>. Ist auf der Seite Netzwerk der Adressbereich eingetragen und liegt der Server nicht darin, nennt die Seite des Geräts die nötige Freigabe selbst. Die Firewall des Servers selbst öffnet das PDH in der Regel von allein (<a href="#hb-mqtt-firewall">mehr</a>).</li>
    <li><b>Name im Haus:</b> Hat der Broker einen Namen, muss er im Netz des Geräts auf den Server zeigen. Das zeigt an der Verbindung <b>Werkzeuge → Broker-Status</b> die Prüfliste.</li>
    <li><b>TLS</b> geht nur mit ESP32-Platinen und nur, wenn der Broker einen Namen mit TLS-Port hat – das Zertifikat kommt von Let's Encrypt. Die Firmware vertraut nur den Stammzertifikaten von Let's Encrypt. Wechselt Let's Encrypt sie einmal, brauchen die Geräte eine neue Firmware: neu bauen und flashen. Verschlüsselt der Broker nur mit einem eigenen Zertifikat (Dateipfade), können ESPPDH-Geräte ihn nicht nutzen.</li>
    <li><b>ESP8266</b> (D1 mini) kann kein TLS und verbindet nur über den Port ohne TLS.</li>
    <li><b>Neues MQTT-Kennwort vergeben?</b> Dann passt die alte Firmware nicht mehr: neu bauen und flashen.</li>
    <li><b>WLAN-Kennwort falsch oder WLAN außer Reichweite?</b> Dann hilft der Notzugang.</li>
  </ol>
  <div class="hb-howto"><b><i class="ti ti-wifi"></i> So hilft der Notzugang (nur bei WLAN)</b>
    <ol class="hb-steps">
      <li>Findet das Gerät sein WLAN nicht, öffnet es nach etwa anderthalb Minuten ein eigenes WLAN: <code>esppdh-&lt;kennung&gt;</code> (bei langen Kennungen gekürzt). Name und Kennwort stehen auf der Seite des Geräts unter <b>Notzugang</b> – das Kennwort nur für alle, die Geräte ändern dürfen.</li>
      <li>Mit Handy oder Laptop in dieses WLAN gehen. Es öffnet sich eine Seite des Geräts (englisch); sonst im Browser <code>http://192.168.4.1</code> aufrufen.</li>
      <li>Dort das richtige WLAN wählen, sein Kennwort eintragen und speichern. Das Gerät verbindet sich dann damit.</li>
      <li>Danach auch im PDH richtigstellen (WLAN auf der Seite des Geräts bzw. Kennwort auf der Seite Netzwerk). Sonst steht beim nächsten Flashen wieder das alte WLAN in der Firmware.</li>
    </ol></div>

  <h3 id="hb-esp-lock"><i class="ti ti-lock"></i> Gerät sperren, neues Kennwort, löschen</h3>
  <p>Unter <b>Aktionen</b> auf der Seite des Geräts:</p>
  <ul>
    <li><b>Sperren</b> – für ein verlorenes oder ausgebautes Gerät. Der Broker trennt es sofort, und es kann sich nicht mehr anmelden. <b>Entsperren</b> lässt es wieder zu.</li>
    <li><b>Neues MQTT-Kennwort</b> – das Gerät wird sofort getrennt. Danach die Firmware neu bauen und flashen. Das Kennwort des Notzugangs bleibt.</li>
    <li><b>Gerät löschen</b> – nur der Bereichsadministrator (<code>esppdh.admin</code>). Der Zugang am Broker endet sofort; Bausteine, Bauten und Firmware sind danach weg. Das lässt sich nicht rückgängig machen.</li>
  </ul>
  <p><b>Warnung „… ließen sich gerade nicht neu lesen“:</b> Die Aktion ist gespeichert, aber der Broker ist noch nicht auf dem neuen Stand. Beim Sperren, beim neuen Kennwort und beim Löschen nimmt das PDH den Zugang des Geräts vorsorglich heraus; ob das Gerät wirklich getrennt ist, steht erst nach einem gelungenen Abgleich fest. Dann die Aktion gleich noch einmal ausführen oder das Gerät einmal speichern – nach dem Löschen ein anderes Gerät derselben Verbindung. Kommt die Warnung immer wieder, steht der Grund im Server-Protokoll.</p>
  <p>Eine Verbindung, an der noch Geräte hängen, lässt sich nicht löschen.</p>

  <h3 id="hb-esp-sec"><i class="ti ti-shield-lock"></i> Sicherheit</h3>
  <ul>
    <li>Jedes Gerät hat einen <b>eigenen Zugang</b> am Broker (Benutzer <code>esppdh-&lt;kennung&gt;</code>, zugleich Client-ID) und darf nur unter seinem Thema <code>esppdh/&lt;kennung&gt;/</code> senden und lesen. Benutzernamen, die mit <code>esppdh-</code> beginnen, sind am Broker deshalb für Geräte reserviert.</li>
    <li>Die Kennwörter stehen <b>verschlüsselt</b> im PDH. Das MQTT-Kennwort zeigt das PDH nie an, das Kennwort des Notzugangs nur denen, die Geräte ändern dürfen. Der Broker kennt vom MQTT-Kennwort nur einen Prüfwert, nie das Kennwort selbst.</li>
    <li><b>Wechsel des Schlüssels</b> (Schlüssel für Portal-Passwörter, oder der Anmelde-Schlüssel, wenn jener leer ist): Die Geräte behalten ihren Zugang am Broker, brauchen aber vor dem nächsten Bau der Firmware je ein <b>Neues MQTT-Kennwort</b> – die Seite des Geräts sagt es. Das Kennwort der Verbindung (Broker) und die WLAN-Kennwörter auf der Seite Netzwerk müssen danach neu eingetragen werden.</li>
    <li>Die <b>Firmware enthält WLAN- und MQTT-Kennwort</b>. Herunterladen und flashen darf deshalb nur, wer Geräte ändern darf (<code>esppdh.edit</code>). Wer welche Firmware geholt hat, steht im Server-Protokoll. Firmware-Dateien nicht weitergeben.</li>
    <li><b>WLAN-Kennwort:</b> Wer Geräte bauen darf, kann das Kennwort des gewählten WLANs aus der Firmware lesen. Deshalb stehen nur WLANs zur Wahl, die auf der Seite <a href="#netzwerk">Netzwerk</a> für ESPPDH-Geräte freigegeben sind. Am besten ein eigenes WLAN nur für Geräte verwenden. Wird die Freigabe entfernt, lassen sich Geräte in diesem WLAN nicht mehr speichern und bauen; schon gebaute Firmware bleibt herunterladbar (Per USB flashen im Browser geht erst wieder mit Freigabe).</li>
    <li>Erlaubt der Broker <b>anonyme Verbindungen</b>, kann jeder im Netz auch unter dem Thema eines Geräts senden und dessen Werte vortäuschen – die Themen-Rechte schützen nur vor anderen Geräten. Die Seite des Geräts warnt dann; besser an der Verbindung „Anonyme Verbindungen erlauben“ ausschalten.</li>
    <li>Ohne TLS gehen Werte und Anmeldung <b>unverschlüsselt</b> durchs Netz. Dann das Gerät nur in einem geschützten Netz betreiben – besser eine ESP32-Platine und den Broker mit Namen und TLS-Port.</li>
  </ul>

  <h3><i class="ti ti-key"></i> Rechte</h3>
  <ul>
    <li><b>ESPPDH: Geräte und Zustand ansehen</b> (<code>esppdh.view</code>) – Liste, Seite des Geräts, Verlauf der Bauten und die Konfiguration ohne Kennwörter.</li>
    <li><b>ESPPDH: Sensorwerte ansehen (Anlage und Terminal)</b> (<code>esppdh.values</code>) – Reiter „ESPPDH“ an der Anlage, Sensoren am Terminal, Zähler auf der Schnellübersicht.</li>
    <li><b>ESPPDH: Geräte anlegen, ändern, sperren, bauen und flashen</b> (<code>esppdh.edit</code>) – dazu Firmware herunterladen und das Kennwort des Notzugangs sehen.</li>
    <li><b>ESPPDH: Geräte löschen (Bereichsadministrator)</b> (<code>esppdh.admin</code>) – alle Rechte von ESPPDH und als Einziger Geräte löschen.</li>
  </ul>
  <p>Die Rechte gelten überall oder nur in einer Abteilung; maßgeblich ist die Anlage des Geräts. Wer sie mit dem Update bekommen hat, steht unter <a href="#admin">Administration</a>.</p>
  <p>Auch die Liste „Letzte Läufe“ (Bauläufe) hat eine Sortier-Leiste (<a href="#sort">mehr</a>).</p>
  <h3>Webseite des Geräts, Adresse und Handshake</h3>
  <div class="hb-howto"><b><i class="ti ti-world-www"></i> So schaust du auf die Webseite eines Geräts</b>
    <ol class="hb-steps">
      <li>Beim Anlegen oder unter „Bearbeiten“ ist <b>Webseite des Geräts</b> angekreuzt (Vorgabe). Das Gerät bekommt dann eine eigene Webseite (Port 80) mit Benutzer <code>pdh</code> und eigenem Kennwort.</li>
      <li>Firmware neu bauen und aufspielen. Erst dann meldet das Gerät seine <b>Adresse</b> und seinen <b>Handshake</b> (Laufzeit in Sekunden, zählt alle 10 Sekunden hoch).</li>
      <li>Auf der Geräteseite steht im Bereich <b>Werte</b> der Knopf <b>Webseite des Geräts</b>. Er erscheint nur, wenn die gemeldete Adresse zur Verbindung des Geräts passt. Die Seite ist nur im Netz der Geräte erreichbar.</li>
      <li>Das Kennwort zeigt <b>Kennwort anzeigen</b> (Recht „ESPPDH: Geräte anlegen, ändern, sperren, bauen und flashen“). Jedes Anzeigen steht im Server-Protokoll.</li>
    </ol></div>
  <p>Über die Webseite lässt sich weder schalten noch Firmware aufspielen. ESP8266: Die Webseite braucht Internet am Browser (für die eingebaute Seite fehlt der Speicher). Der <b>Handshake</b> zeigt grün „läuft“, solange das Gerät innerhalb von 30 Sekunden einen neuen Zähler schickt, sonst rot „steht seit …“.</p>
  {{template "hb-shots" (dict "Ref" (index $s "esppdh") "Can" $can)}}
</section>

<section class="hb-ch" id="energiedaten" data-title="Energiedaten &amp; Messstellen" data-pages="energy">
  <h2><i class="ti ti-gauge"></i> Energiedaten &amp; Messstellen</h2>
  <p>Unter <b>Messstellen</b> (Navigation → Daten) legst du fest, welcher importierte Wert zu welcher Anlage gehört und wie er weiterverwendet wird – zum Beispiel ein Zählerstand für Strom, Gas, Wasser oder Druckluft. Die Seite ist zugleich <b>Zuweisungstabelle</b> und <b>Übersicht</b> über alle Messstellen aller Anlagen. Sie ist ein Zusatz: Ohne Messstellen ändert sich am PDH nichts.</p>
  {{template "hb-fig-energie"}}
  <p>Eine <b>Messstelle</b> hat eine <b>Messstellen-ID</b> (frei wählbar, so wie das empfangende System sie kennt), eine Bezeichnung, eine Anlage, eine Einheit und eine <b>Art</b>:</p>
  <table><thead><tr><th>Art</th><th>Bedeutung</th></tr></thead><tbody>
    <tr><td>Zählerstand</td><td>Der Wert wächst, z. B. Kilowattstunden seit Inbetriebnahme.</td></tr>
    <tr><td>Verbrauch</td><td>Jede Lesung ist der Verbrauch seit der vorigen Lesung. Kommen in einer Minute mehrere Lesungen, zählt das PDH sie zusammen; kommt keine, hat die Minute keinen Wert.</td></tr>
    <tr><td>Momentanwert</td><td>Der Wert gilt nur jetzt, z. B. Leistung oder Temperatur.</td></tr>
  </tbody></table>
  <p><b>Tipp:</b> Liefert die Quelle einen fortlaufenden Zählerstand, der mit jeder Lesung weiterzählt, wähle die Art <b>Zählerstand</b> – nicht Verbrauch. Den Verbrauch je Intervall liefert dann der Export (<b>Zuwachs im Intervall</b>) oder eine berechnete Messstelle. <b>Verbrauch</b> passt nur, wenn jede Lesung schon die Menge seit der vorigen Lesung ist.</p>
  <p>Der <b>Faktor</b> (Vorgabe 1) rechnet den Quellwert um, z. B. von Wh in kWh. <b>Exportieren</b> bestimmt, ob die Messstelle in den Export geht; <b>Aktiv</b> schaltet sie ganz ab. Das PDH legt jede Minute kurz nach der vollen Minute die Werte der eben abgeschlossenen Minute ab, mit deren Ende als Zeitpunkt: Der Wert „12:16“ enthält die Lesungen von 12:15:00 bis 12:15:59. Eine Exportzeile „12:15“ im 15-Minuten-Abstand umfasst damit genau 12:00 bis 12:15. Eine Lesung gehört zu der Minute, in der sie ankam, und zählt genau einmal. Bei Zählerstand und Momentanwert gilt die letzte Lesung bis zum Ende der Minute. Ist sie älter als die eingestellte Frist (Vorgabe 15 Minuten, einstellbar) oder keine Zahl, gibt es für diese Minute <b>keinen Wert</b> – nie eine 0. Minutenwerte bleiben 400 Tage erhalten. Beide Zeiten lassen sich im Reiter <b>Einstellungen</b> ändern (<a href="#energiedaten-vorgaben">Vorgaben einstellen</a>).</p>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du eine Messstelle an</b>
    <ol class="hb-steps">
      <li>Unter <b>Messstellen</b> ganz unten auf <b>Neue Messstelle</b> klicken.</li>
      <li><b>Messstellen-ID</b>, Bezeichnung, Einheit, Art und bei Bedarf den Faktor eintragen.</li>
      <li>Die <b>Anlage</b> im Baum wählen – wie überall im PDH.</li>
      <li>Als <b>Quelle</b> den Import-Wert wählen: Die Liste enthält jeden importierten Wert jeder Verbindung (Verbindung · Datenpunkt). Eine Quelle darf mehreren Messstellen zugewiesen werden.</li>
      <li><b>Speichern</b>. Ändern geht mit dem Stift in der Zeile, direkt in der Tabelle.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-math-function"></i> So rechnest du eine Messstelle aus anderen</b>
    <ol class="hb-steps">
      <li>Neue Messstelle anlegen und bei <b>Quelle</b> auf <b>Formel aus anderen Messstellen</b> umschalten.</li>
      <li>Die Formel mit den Messstellen-IDs in eckigen Klammern schreiben, z. B. <code>[GESAMT] - [LINIE-A] - [LINIE-B]</code>. Erlaubt sind <code>+</code>, <code>-</code>, <code>*</code>, <code>/</code> (auch <code>−</code> <code>×</code> <code>÷</code>), Klammern und Zahlen.</li>
      <li>Speichern. Unbekannte IDs und Zirkelbezüge (A rechnet mit B, B mit A) weist das PDH mit einer Meldung ab, z. B. „Zirkelbezug: [A] → [B] → [A]“. Zählerstände und Verbräuche lassen sich nur untereinander verrechnen, Momentanwerte nur mit Momentanwerten.</li>
    </ol>
    <p>Berechnete Messstellen sind in der Tabelle mit <b>berechnet</b> gekennzeichnet, ihre Formel steht in der Spalte <b>Quelle</b>. Sie werden jede Minute mitberechnet und wie echte Messwerte abgelegt. Fehlt ein Bezugswert, gibt es für diese Minute keinen Wert. Änderst du bei einer Messstelle Quelle, Faktor oder Art oder die Formel einer berechneten Messstelle, haben die berechneten Messstellen, die sie nutzen, in dieser einen Minute keinen Wert. Danach rechnen sie normal weiter. So wird der Sprung vom alten zum neuen Wert nicht als Verbrauch gezählt. Eine Messstelle, die in der Formel einer anderen steht, lässt sich weder löschen noch umbenennen – die Meldung nennt die Messstellen, in denen sie verwendet wird.</p></div>
  <div class="hb-howto"><b><i class="ti ti-filter"></i> So findest du Messstellen</b>
    <p>Über der Tabelle filterst du nach <b>Anlage</b> (mit Unteranlagen), echt oder berechnet, exportieren, aktiv, Einheit, Art, Verbindung und Suchtext. <b>Nur ohne aktuellen Wert</b> zeigt Messstellen, deren letzter Wert älter als die eingestellte Frist (Vorgabe 15 Minuten) ist oder fehlt – der schnelle Weg zu Messstellen, deren Quelle nicht mehr liefert. Ein Klick auf eine Spaltenüberschrift sortiert, ein zweiter dreht die Reihenfolge um. Filter und Sortierung stehen in der Adresse; du kannst die Seite so als Lesezeichen speichern oder weitergeben.</p></div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Rechte</b>
    <ul>
      <li><b>Messstellen sehen</b> (<code>energy.view</code>): Seite und Tabelle ansehen.</li>
      <li><b>Messstellen pflegen</b> (<code>energy.edit</code>): anlegen und ändern. Das Recht gilt für die Anlagen der eigenen Abteilung; an einer fremden Anlage lässt sich keine Messstelle anlegen oder ändern.</li>
      <li><b>Schwellwerte pflegen</b> (<code>energy.thresholds</code>): Schwellwerte an Messstellen anlegen und ändern. Das Recht haben alle Rollen, die Messstellen pflegen dürfen. Schwellwerte löschen darf nur der Bereichsadministrator.</li>
      <li><b>Messstellen löschen</b> (<code>energy.admin</code>, Bereichsadministrator): endgültig löschen, samt Minutenwerten – und die Einstellungen der Energiedaten ändern.</li>
    </ul>
    <p>Wer nur ansehen darf, sieht keine Bearbeiten-Knöpfe. Auf dem Spiegelserver ist die Seite nur lesend.</p>
    <p>Den Efficio-Export steuern die vorhandenen Export-Rechte: Dateien und Protokoll sehen und herunterladen mit <b>Export ansehen</b> (<code>export.read</code>), einrichten, testen und „Jetzt exportieren“ mit <b>Export verwalten</b> (<code>export.write</code>).</p></div>
  <div class="hb-howto" id="energiedaten-vorgaben"><b><i class="ti ti-adjustments"></i> So stellst du die Vorgaben ein</b> (Recht „Messstellen löschen“, also Bereichsadministrator)
    <ol class="hb-steps">
      <li>Unter <b>Messstellen</b> auf den Reiter <b>Einstellungen</b> wechseln. Wer nur ansehen darf, sieht die Werte, kann sie aber nicht ändern.</li>
      <li>Oben stehen die Werte für <b>alle Messstellen</b>: <b>Quellwert gilt als veraltet nach … min</b> (Vorgabe 15) und <b>Minutenwerte aufbewahren … Tage</b> (Vorgabe 400).</li>
      <li>Darunter stehen die <b>Vorgaben für neue Efficio-Exporte</b>: Lauf-Takt (15 min), Zeilenabstand (1 min), Dateilänge (1 Tag), Aufbewahrung (30 Tage), Zeitformat, Zeitbezug (Ortszeit), Dezimalkomma, Kopfzeile, Zeichensatz und Dateiname (<code>efficio</code>).</li>
      <li><b>Speichern</b>. Das PDH prüft die Eingaben und sagt, was nicht passt – zum Beispiel, wenn der Zeilenabstand den Lauf-Takt nicht teilt (10 Minuten bei einem Lauf alle 15 Minuten geht nicht).</li>
    </ol>
    Neue Efficio-Exporte übernehmen diese Vorgaben in ihre Felder; dort lassen sie sich je Export ändern. Schon eingerichtete Exporte bleiben unverändert. Die neuen Zeiten gelten ab dem nächsten Lauf.</div>
  {{template "hb-fig-efficio"}}
  <div class="hb-howto"><b><i class="ti ti-file-export"></i> So richtest du den Efficio-Export ein</b> (Recht „Export verwalten“)
    <ol class="hb-steps">
      <li>Unter <b>Messstellen</b> bei jeder Messstelle, die ins Energiemanagement soll, <b>Exportieren</b> anhaken.</li>
      <li><b>Export</b> öffnen, bei <b>Typ</b> <b>Efficio-CSV (Energiedaten)</b> wählen und einen Namen vergeben.</li>
      <li>Festlegen, wie oft die Datei ergänzt wird (<b>Datei ergänzen alle … min</b>, Vorgabe 15) und in welchem Abstand sie Zeilen enthält (<b>Zeilen im Abstand von … min</b>, Vorgabe 1). Der Abstand muss den Takt teilen. <b>Max. Länge der Datei in Tagen</b> (Vorgabe 1) bestimmt, wann eine neue Datei beginnt; 0 heißt eine Datei je Lauf. Dazu Zeitformat, Dezimalkomma, Kopfzeile und Zeichensatz.</li>
      <li><b>Wert je Zeile</b> wählen: <b>Wert zum Ende des Intervalls</b> schreibt den Zählerstand bzw. Momentanwert am Intervallende und bei Verbrauch die Summe im Intervall. <b>Zuwachs im Intervall</b> schreibt bei Zählerständen den Unterschied zum vorigen Intervall; fehlt der vorige Wert oder ist der Stand gesunken, fehlt die Zeile.</li>
      <li><b>Zeitbezug</b> wählen: <b>Ortszeit</b> (Vorgabe), <b>UTC</b> oder <b>Ortszeit mit Zeitzonenangabe</b> (z. B. <code>25.10.2026 02:15 +02:00</code>). Bei UTC beginnen die Tagesdateien um Mitternacht UTC und der Dateiname nutzt UTC. Mit Zeitzonenangabe oder UTC ist auch die doppelte Stunde bei der Zeitumstellung im Herbst eindeutig. Änderst du den Zeitbezug, beginnt beim nächsten Lauf eine neue Datei.</li>
      <li>Bei <b>Ablage</b> wählen: <b>Zum Abholen im PDH</b> (die Dateien liegen im PDH und bleiben die eingestellte <b>Aufbewahrung</b>, Vorgabe 30 Tage, einstellbar), <b>Netzlaufwerk</b> (ein Laufwerk mit „Import &amp; Export“ und optional ein Ordner darauf, der schon vorhanden sein muss) oder <b>FTP</b> bzw. <b>SFTP</b> mit Server, Port, Benutzer, Kennwort und Zielordner. Bei SFTP wählst du unter <b>Anmeldung</b> zwischen <b>Kennwort</b> und <b>Schlüssel</b>.</li>
      <li>Wer nur bestimmte Anlagen exportieren will, wählt sie im Anlagenbaum unter <b>Nur diese Anlagen</b> aus und drückt <b>Anlage hinzufügen</b> (mit Unteranlagen; die gewählten Anlagen erscheinen mit Namen und lassen sich mit dem Kreuz wieder entfernen). Einzelne Messstellen trägt man unter <b>Nur diese Messstellen</b> ein. Leer heißt alle Messstellen mit „Exportieren“.</li>
      <li>Speichern. Die Verbindung öffnen und <b>Dateien &amp; Protokoll</b> wählen.</li>
      <li><b>Verbindung testen</b> prüft die Ablage mit einer kleinen Testdatei. Bei <b>SFTP</b> zeigt das PDH dabei den <b>Fingerabdruck</b> des Servers. Vergleiche ihn mit dem Fingerabdruck, den dir die Betreiber nennen, und bestätige ihn – erst dann verbindet das PDH. Ändert sich der Fingerabdruck später, verbindet es nicht mehr, bis du den neuen bestätigst.</li>
      <li>Nur bei SFTP mit <b>Schlüssel</b>: In der Karte <b>Anmeldung mit Schlüssel</b> auf <b>Schlüssel erzeugen</b> drücken. Das PDH zeigt den <b>öffentlichen Schlüssel</b> – mit <b>Kopieren</b> übernehmen und beim Benutzer am SFTP-Server hinterlegen (Datei <code>authorized_keys</code>) oder den Betreibern des Servers schicken. Danach <b>Verbindung testen</b>. <b>Neuen Schlüssel erzeugen</b> ersetzt den bisherigen; der neue muss dann wieder am Server hinterlegt werden.</li>
      <li><b>Jetzt exportieren</b> startet einen Lauf von Hand. Die erzeugten Dateien lädst du dort herunter; darunter steht das Protokoll der letzten 30 Läufe mit Zeilen, fehlenden Werten und Hinweisen.</li>
    </ol>
    Das <b>Kennwort</b> für FTP/SFTP wird verschlüsselt gespeichert und nie angezeigt; beim Bearbeiten das Feld leer lassen, dann bleibt es. Der <b>private Schlüssel</b> für SFTP liegt ebenfalls verschlüsselt im PDH und wird nie angezeigt; mit Schlüssel sendet das PDH kein Kennwort. Wer die Verbindung bearbeiten darf (<code>export.write</code>), darf auch den Schlüssel erzeugen. Ist ein Wert nicht da (Gerät offline), fehlt die Zeile und das Protokoll nennt die Lücke – es wird nichts erfunden. <b>Ohne Messwerte entsteht keine Datei</b>, auch keine nur mit Kopfzeile. Kommt eine Datei nicht beim Ziel an, bricht das PDH die Zustellung für diesen Lauf ab und legt sie beim nächsten Lauf nach. Andere Exporte laufen dabei ungestört weiter. Auf dem Spiegelserver wird nichts exportiert.</div>
  <div class="hb-howto" id="energiedaten-schwellwerte"><b><i class="ti ti-bell-ringing"></i> So legst du einen Schwellwert an</b> (Recht „Schwellwerte pflegen“)
    <ol class="hb-steps">
      <li>Unter <b>Messstellen</b> in der Spalte <b>Schwellwerte</b> den Knopf mit der Zahl anklicken (z. B. „keine“ oder „2 · 1 Alarm“). Darunter öffnet sich die Liste der Schwellwerte dieser Messstelle.</li>
      <li>Auf <b>Neuer Schwellwert</b> klicken.</li>
      <li><b>Bezeichnung</b> eintragen. Bei <b>Bedingung</b> wählen, ob der Alarm bei <b>über dem Grenzwert</b> oder <b>unter dem Grenzwert</b> kommen soll.</li>
      <li><b>Grenzwert</b> eintragen – in der Einheit der Messstelle, z. B. 45 bei kW.</li>
      <li><b>Zeitraum (Minuten)</b> festlegen: So lange wird der Wert zusammengefasst und geprüft. <b>Rückschaltzeit (Minuten)</b> bestimmt, wie lange der Wert danach am Stück in Ordnung sein muss, bis der Alarm endet (Vorgabe 15).</li>
      <li><b>Tag am Ticket</b> und <b>Priorität des Tickets</b> wählen.</li>
      <li><b>Verantwortlich</b> (Person oder Gruppe) wählen. Bleibt das Feld leer, bekommt der Verantwortliche der Anlage die Nachricht.</li>
      <li><b>Aktiv</b> anhaken und speichern. Mit dem Haken lässt sich ein Schwellwert jederzeit ausschalten.</li>
    </ol>
    <p>In der Tabelle zeigt die Spalte <b>Schwellwerte</b> die Anzahl und die Alarme (z. B. „2 · 1 Alarm“). Der Filter <b>Nur mit offenem Alarm</b> zeigt nur Messstellen mit laufendem Alarm. Ändern geht mit dem Stift in der Liste; löschen (Papierkorb) darf nur der Bereichsadministrator.</p></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> So läuft ein Alarm ab</b>
    <p>Beispiel: Die Stromspitze einer Anlage soll nicht über <b>45 kW</b> liegen, Zeitraum <b>1 min</b>, Rückschaltung <b>15 min</b>.</p>
    <ol class="hb-steps">
      <li>Liegt der Wert eine Minute lang über 45 kW, legt das PDH <b>ein Ticket</b> an – mit dem Tag, der Anlage und der Priorität des Schwellwerts. Die Verantwortlichen bekommen eine Nachricht im Chat und per Mail.</li>
      <li>Solange der Alarm läuft, entsteht kein zweites Ticket.</li>
      <li>Der Alarm endet erst, wenn der Wert <b>15 Minuten am Stück</b> nicht mehr über 45 kW lag. Springt der Wert zwischendurch wieder darüber, beginnt die Zählung neu.</li>
      <li>Liegt der Wert wieder über der Grenze, während das Ticket noch offen ist, legt das PDH <b>kein neues Ticket</b> an. Es schreibt einen Eintrag „Erneut überschritten …“ ans Ticket und benachrichtigt die Verantwortlichen.</li>
    </ol></div>
  <p><b>So wertet das PDH aus:</b> Bei einem <b>Momentanwert</b> zählt der Mittelwert im Zeitraum, bei einem <b>Zählerstand</b> die Menge (Ende minus Anfang), bei einem <b>Verbrauch</b> die Summe. Geprüft wird ein Zeitraum nur, wenn <b>jede Minute</b> darin einen Wert hat. Fehlen Werte (Gerät offline), gibt es weder Alarm noch Rückschaltung; die Zählung der 15 Minuten beginnt nach der Lücke neu. Ein Zählerstand, der zurückgeht, wird nicht bewertet. Messstellen und Schwellwerte, die nicht aktiv sind, werden nicht überwacht; ein offener Alarm wird dann zurückgesetzt. Überwacht wird nur auf dem aktiven Server. Nach einer Pause holt das PDH die verpassten Minuten nach – höchstens 24 Stunden.</p>
  {{template "hb-shots" (dict "Ref" (index $s "energiedaten") "Can" $can)}}
</section>

<section class="hb-ch" id="abgleich" data-title="Abgleich mit Fremdsystemen" data-pages="sync">
  <h2><i class="ti ti-arrows-exchange"></i> Abgleich mit Fremdsystemen</h2>
  <p>Unter <b>Abgleich</b> (Navigation → Daten) holt das PDH Meldungen aus einer fremden SQL-Server-Datenbank und macht daraus <b>Tickets</b> oder <b>Störmeldungen</b>. Was du im PDH an einer solchen Meldung änderst, kann zurück in die fremde Zeile geschrieben werden. Der Abgleich ist ein Zusatz: Ohne Profil ändert sich am PDH nichts.</p>
  {{template "hb-fig-abgleich"}}
  <p><b>Was der Abgleich nie tut:</b> Er löscht nichts im Fremdsystem und legt dort keine Meldungen an. Geschrieben wird nur eine vorhandene Zeile über ihren Schlüssel und – wenn eingerichtet – ein neuer Kommentar in eine Nebentabelle.</p>
  <p>Ein <b>Profil</b> verbindet genau eine Tabelle des Fremdsystems mit Tickets oder Störmeldungen. Jedes Profil hat einen Zustand: <b>Entwurf</b> (wird eingerichtet), <b>Getestet</b>, <b>Scharf</b> (läuft im Takt) oder <b>Angehalten</b>. Jede Änderung an Quelle, Ziel oder Zuordnungen setzt das Profil zurück auf Entwurf.</p>
  <div class="hb-howto"><b><i class="ti ti-user-shield"></i> Vorbereitung im Fremdsystem</b>
    <ol class="hb-steps">
      <li>Im SQL Server einen <b>eigenen Datenbankbenutzer</b> für das PDH anlegen – nicht <code>sa</code>, nicht <code>db_owner</code>.</li>
      <li>Ihm nur geben, was nötig ist: <b>Lesen</b> auf der Meldungstabelle. Sollen Änderungen zurückgehen, zusätzlich <b>Ändern</b> auf der Meldungstabelle; für Kommentare <b>Lesen und Anfügen</b> auf der Kommentartabelle. <b>Löschen</b> braucht er nie.</li>
      <li>In der Firewall des fremden Netzes den Datenbank-Port für das PDH freigeben. Beim Ausfallschutz mit zwei Servern für <b>beide Serveradressen</b> – der aktive Server sendet mit seiner eigenen Adresse, nicht mit der mitwandernden. Die Prüfung der Verbindung nennt die Absenderadresse.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> Verbindung einrichten</b>
    <ol class="hb-steps">
      <li>Unter <b>Import</b> eine Verbindung vom Typ <b>MSSQL</b> anlegen: Host, Port, Datenbank, Benutzer, Kennwort.</li>
      <li><b>Weg</b>: im Regelfall <b>Direkt</b> (die Datenbank ist über das Netz erreichbar). Ein VPN-Tunnel ist nur zum Testen gedacht; über VPN gelten ein eigener Abfragetakt (5 bis 30 Minuten) und eine eigene Zeitgrenze je Abfrage.</li>
      <li><b>Fingerabdruck lesen und bestätigen</b>, damit das PDH nur mit diesem Server spricht.</li>
      <li>Sollen Änderungen zurückgehen: <b>Schreiben erlaubt</b> einschalten. Ohne den Schalter schreibt das PDH nie in diese Datenbank.</li>
      <li>Auf der Verbindungsseite <b>Jetzt prüfen</b>. Die Prüfung zeigt Tunnel, Adresse, Port, Anmeldung, Lese- und Schreibrecht einzeln und warnt, wenn der Benutzer mehr darf als nötig.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-plus"></i> So legst du ein Profil an</b>
    <ol class="hb-steps">
      <li><b>Abgleich</b> öffnen, unten Namen, Verbindung und Ziel (Ticket oder Störmeldung) wählen, <b>Profil anlegen</b>.</li>
      <li>Im Cockpit die fünf Schritte der Reihe nach durchgehen: <b>1 Quelle</b>, <b>2 Ziel</b>, <b>3 Zuordnungen</b>, <b>4 Test</b>, <b>5 Betrieb</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-database"></i> Schritt 1 – Quelle</b>
    <ol class="hb-steps">
      <li><b>Tabelle</b> mit den Meldungen wählen. Die Liste kommt direkt aus der Datenbank; <b>Erste Zeilen ansehen</b> zeigt bis zu 20 Zeilen zur Kontrolle.</li>
      <li><b>Schlüsselspalte(n)</b> ankreuzen – daran erkennt das PDH eine Meldung wieder. Vorgeschlagen wird der Primärschlüssel. Der Schlüssel muss eindeutig sein.</li>
      <li><b>Änderungen erkennen über</b>: am besten eine <code>rowversion</code>-Spalte, sonst eine Spalte mit der Änderungszeit. Ohne solche Spalte vergleicht das PDH jede Zeile.</li>
      <li>Auf Wunsch das <b>Anlagedatum</b> wählen: Meldungen von früher werden dann still als Historie angelegt, ohne Benachrichtigung; abgeschlossene davon gleich erledigt und archiviert.</li>
      <li>Die <b>Zeitzone</b> der Zeitangaben im Fremdsystem wählen, wenn sie von der des PDH-Servers abweicht.</li>
      <li><b>Quelle speichern</b>. Sobald Meldungen verknüpft sind, sind Verbindung, Tabelle und Schlüssel fest.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-target-arrow"></i> Schritt 2 – Ziel</b>
    <ol class="hb-steps">
      <li>Wählen, ob aus einer Meldung ein <b>Ticket</b> oder eine <b>Störmeldung</b> wird, und zu welcher <b>Abteilung</b> das Profil gehört.</li>
      <li><b>Vorgabewerte</b> eintragen – sie gelten, wenn das Fremdsystem für ein Feld nichts liefert.</li>
      <li>Mit <b>Filter</b> und <b>Zeitfenster</b> eingrenzen, welche Meldungen kommen. <b>Höchstens neue Meldungen je Lauf</b> schützt vor einer Flut: Kommen mehr, hält das Profil an und meldet es.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-left-right"></i> Schritt 3 – Zuordnungen</b>
    <ol class="hb-steps">
      <li>Je Feld im PDH die <b>Spalte im Fremdsystem</b> wählen und die <b>Richtung</b>: herein, hinaus oder beides. Ändern beide Seiten dasselbe Feld, gewinnt das PDH; der fremde Wert steht im Verlauf.</li>
      <li>Unter <b>Werte übersetzen</b> eintragen, was die Werte des Fremdsystems im PDH bedeuten, z. B. „hoch“ → Hoch.</li>
      <li>Ein <b>fester Wert</b> gilt statt einer Spalte, z. B. immer Status „Offen“.</li>
      <li>Sollen Kommentare zurück ins Fremdsystem, die <b>Kommentartabelle</b> und ihre Spalten eintragen.</li>
      <li><b>Zuordnungen speichern</b>. Ein Pflichtfeld ohne Zuordnung ist gelb markiert.</li>
    </ol></div>
  <p>Die Richtungen „hinaus“ und „beides“ sind gesperrt, solange an der Verbindung <b>Schreiben erlaubt</b> aus ist. Schlüsselspalten und Spalten, die die Datenbank selbst füllt, werden nie geändert.</p>
  <div class="hb-howto"><b><i class="ti ti-flask"></i> Schritt 4 – Test</b>
    <ol class="hb-steps">
      <li><b>Stufe 1 – Trockenlauf starten.</b> Das PDH liest die Meldungen und zeigt, was entstünde: wie viele neu, rückwirkend, geändert – und welche Zeilen Fehler haben (z. B. ein Wert ohne Übersetzung). Geschrieben wird nirgends.</li>
      <li>Schreibt das Profil zurück, vorher eine <b>Meldung für den Test hinaus</b> wählen. Der Trockenlauf zeigt dann den genauen Befehl, der an das Fremdsystem ginge.</li>
      <li><b>Stufe 2 – Schreibversuch starten</b> (nur wenn das Profil zurückschreibt). Das PDH ändert die gewählte Meldung in einer Transaktion, liest sie zur Kontrolle und <b>nimmt alles zurück</b>. Danach prüft es, dass die Meldung wie vorher ist.</li>
      <li>Hat die Tabelle <b>Auslöser (Trigger)</b>, zeigt das PDH erst ihre Namen und fragt nach. Auslöser können Wirkungen haben, die eine Rücknahme nicht aufhebt – im Zweifel mit dem Betreuer des Fremdsystems klären.</li>
      <li>Sind die nötigen Stufen bestanden, steht das Profil auf <b>Getestet</b>.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-bolt"></i> Schritt 5 – Betrieb</b>
    <ol class="hb-steps">
      <li><b>Scharf schalten.</b> Beim ersten Mal zeigt das PDH vorher, wie viele Meldungen der erste Lauf anlegen würde. Mit <b>Ja, scharf schalten</b> läuft der Abgleich im Takt.</li>
      <li>Den <b>Takt</b> hereinkommend auf 5 bis 30 Minuten stellen. Änderungen aus dem PDH gehen innerhalb weniger Sekunden zurück.</li>
      <li><b>Jetzt abgleichen</b> holt sofort, ohne auf den Takt zu warten. <b>Anhalten</b> stoppt das Profil; nichts geht verloren, nach <b>Fortsetzen</b> wird nachgeholt.</li>
      <li>Die <b>Warteliste</b> zeigt, was noch ins Fremdsystem geschrieben werden muss. Bei einem Fehler steht der Grund dabei; <b>Erneut versuchen</b> stößt den Eintrag sofort an.</li>
      <li><b>Letzte Läufe</b> zeigt je Lauf, was übernommen oder zurückgeschrieben wurde, und Fehler mit Meldung und Feld.</li>
    </ol></div>
  <p>An einem übernommenen Ticket bzw. einer Störmeldung steht oben die <b>Herkunft</b>: Profil, Nummer im Fremdsystem und der Stand des Abgleichs (aktuell, Änderungen warten oder der Fehler).</p>
  <p><b>Vorrang für die Benutzer:</b> Ist der Server stark ausgelastet (Prozessor, Arbeitsspeicher oder Datenbank), geht der Abgleich in <b>Warteposition</b>. Er läuft dann spätestens nach 30 Minuten mit kleiner Menge und holt auf, sobald die Last sinkt. Im Lauf steht der Grund.</p>
  <p><b>Wenn etwas nicht klappt:</b></p>
  <table>
    <tr><th>Anzeige</th><th>Was passiert</th><th>Was du tust</th></tr>
    <tr><td>Datenbank nicht erreichbar</td><td>Der Lauf wird übersprungen, die Warteliste bleibt. Die Pause wächst bis 15 Minuten.</td><td>Netz, Firewall und Fremdsystem prüfen; an der Verbindung <b>Jetzt prüfen</b>. Danach holt der Abgleich von selbst auf.</td></tr>
    <tr><td>Weg nicht bereit (Tunnel steht nicht)</td><td>Wie oben.</td><td>Den Tunnel unter <a href="#vpn">VPN</a> prüfen oder den Weg auf Direkt stellen.</td></tr>
    <tr><td>Wert ist nicht zugeordnet, Pflichtfeld leer</td><td>Nur diese Meldung scheitert; die anderen laufen weiter.</td><td>In Schritt 3 die Übersetzung oder einen Vorgabewert ergänzen.</td></tr>
    <tr><td>Fehlversuch in der Warteliste</td><td>Der Eintrag bleibt und wird wieder versucht. Nach fünf Versuchen steht ein Vermerk am Datensatz.</td><td>Grund lesen (Recht, Sperre, Pflichtfeld im Fremdsystem), beheben, <b>Erneut versuchen</b>.</td></tr>
    <tr><td>Schreiben ist an der Verbindung nicht erlaubt</td><td>Die Warteliste wartet unverändert.</td><td>An der Verbindung <b>Schreiben erlaubt</b> einschalten.</td></tr>
    <tr><td>Meldung im Fremdsystem nicht mehr vorhanden</td><td>Vermerk am Datensatz. Die Verknüpfung bleibt, im Fremdsystem wird nichts angelegt.</td><td>Nichts – das Ticket bleibt im PDH.</td></tr>
    <tr><td>Zu viele neue Meldungen</td><td>Das Profil hält an.</td><td>Filter oder Zeitfenster enger setzen oder die Obergrenze erhöhen, neu testen und scharf schalten.</td></tr>
    <tr><td>Weg der Verbindung geändert</td><td>Scharfe Profile der Verbindung stehen wieder auf Getestet.</td><td>Über den neuen Weg neu testen und scharf schalten. Verknüpfungen und Warteliste bleiben.</td></tr>
  </table>
  <p><b>Ausfallschutz:</b> Der Abgleich läuft nur am aktiven Server. Verknüpfungen, Warteliste und Läufe liegen in der Datenbank des PDH. Nach einem Rollentausch arbeitet der neue aktive Server dort weiter – nichts wird doppelt angelegt. Ein VPN-Tunnel steht nach einem Tausch nicht sicher; dann wird der Lauf übersprungen und gemeldet. Während eines Updates (Wartungssperre) ruht der Abgleich.</p>
  <p><b>Rechte:</b> sehen – <b>Abgleich: Profile, Läufe und Herkunft sehen</b>; einrichten und testen – <b>Profile einrichten und testen</b>; scharf schalten, anhalten, erneut versuchen – das gleichnamige Recht. Löschen darf nur der Bereichsadministrator des Abgleichs; dabei bleiben die Tickets im PDH und alle Daten im Fremdsystem. Die Rechte gelten überall oder nur in einer Abteilung.</p>
  <p>Das Protokoll der Läufe lässt sich sortieren – ebenso die Läufe des Efficio-Exports (<a href="#sort">mehr</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "abgleich") "Can" $can)}}
</section>

<section class="hb-ch" id="vpn" data-title="VPN ins Maschinennetz" data-pages="vpn">
  <h2><i class="ti ti-shield-lock"></i> VPN ins Maschinennetz</h2>
  <p>Über <b>VPN Maschinennetz</b> (Navigation → Material &amp; Anlagen) kommst du mit Laptop oder Handy von unterwegs ins Maschinennetz – z. B. um mit dem TIA-Portal auf eine Steuerung zu schauen. PDH nutzt dafür <b>WireGuard</b>, das direkt auf dem Server läuft. PDH kann dabei beides sein:</p>
  <ul>
    <li><b>Einwahl-Server:</b> Deine Geräte und die <b>Standort-Gateways</b> (Router im Maschinennetz, z. B. Teltonika, mGuard, eWON) wählen sich bei PDH ein. PDH verbindet beide – am Router muss kein Port offen sein.</li>
    <li><b>Client:</b> Ist im Maschinennetz schon ein WireGuard-Server, verbindet sich PDH als <b>ausgehender Tunnel</b> dorthin. Eingewählte Geräte erreichen die Netze dahinter ebenfalls.</li>
  </ul>
  <p>Eingewählte Geräte erreichen nur die Netze der Gateways und Tunnel, nicht einander. Oben rechts siehst du, ob das VPN läuft.</p>
  <div class="hb-howto" id="hb-vpn-status"><b><i class="ti ti-activity"></i> Steht die Verbindung?</b>
    Jedes Gerät, jedes Gateway und jeder Tunnel zeigt seinen Zustand – die Anzeige aktualisiert sich alle 10 Sekunden von selbst:
    <ul>
      <li><b style="color:var(--green)">verbunden</b> – in den letzten 3 Minuten Kontakt, dazu Absender-Adresse und Datenmenge.</li>
      <li><b style="color:var(--amber)">getrennt – letzter Kontakt vor …</b> – war verbunden, meldet sich aber nicht mehr (Gerät aus, Tunnel in der App beendet, Router nicht erreichbar).</li>
      <li><b style="color:var(--amber)">keine Antwort vom Server</b> – ein Tunnel zum Maschinennetz kommt nicht zustande: Endpunkt, Schlüssel und Freigabe am entfernten Server prüfen.</li>
      <li><b>noch nie verbunden</b> · <b>deaktiviert</b> · <b style="color:var(--red)">gesperrt</b>.</li>
    </ul>
    Oben steht die Zusammenfassung, z. B. „Tunnel 1/1 verbunden · Geräte 3/12 verbunden“. WireGuard meldet einen Abbruch nicht sofort: Erst nach etwa 3 Minuten ohne Kontakt gilt eine Verbindung als getrennt.</div>
  <div class="hb-howto" id="hb-vpn-toggle"><b><i class="ti ti-player-pause"></i> So aktivierst bzw. deaktivierst du eine Verbindung</b>
    <ol class="hb-steps">
      <li>Am Gerät, Gateway oder Tunnel auf <b>Deaktivieren</b> tippen – die Verbindung wird sofort getrennt, der Eintrag ist grau.</li>
      <li>Zum Wiederherstellen <b>Aktivieren</b> – nach wenigen Sekunden steht die Verbindung wieder.</li>
    </ol>
    Anders als <b>Sperren</b> bleiben Schlüssel und Konfiguration gültig; auf den Geräten und am Router muss nichts geändert werden. Eigene Geräte kann jede/r selbst (de)aktivieren, alles andere die Administration unter <b>Server-Einstellungen → VPN</b>. Jede Änderung steht im Protokoll.</div>
  <div class="hb-howto"><b><i class="ti ti-device-laptop"></i> So richtest du dein Gerät ein</b>
    <ol class="hb-steps">
      <li><b>VPN Maschinennetz</b> öffnen → unter <b>Meine Geräte</b> einen Namen eintragen, z. B. „Laptop Service“ → <b>Zugang anlegen</b>.</li>
      <li>Die App <b>WireGuard</b> installieren (App Store, Play Store oder wireguard.com).</li>
      <li>Handy: in der App <b>+</b> → <b>QR-Code scannen</b>. Laptop: <b>.conf herunterladen</b> und in der App <b>Tunnel aus Datei importieren</b>.</li>
      <li>Tunnel aktivieren. Die Steuerungen erreichst du jetzt unter ihren normalen Adressen im Maschinennetz.</li>
    </ol>
    Für jedes Gerät einen eigenen Zugang anlegen (höchstens 5). Geht ein Gerät verloren, den Zugang sofort <b>sperren</b> – die Verbindung bricht sofort ab. Kommen neue Netze dazu, die Konfiguration neu laden.</div>
  <div class="hb-howto" id="hb-vpn-setup"><b><i class="ti ti-settings"></i> So richtest du das VPN ein (nur Administratoren)</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → Reiter <b>VPN</b> öffnen. Den <b>öffentlichen Namen oder die IP</b> des Servers eintragen, UDP-Port (Standard 51820) und VPN-Netz prüfen → <b>Speichern</b> (noch ausgeschaltet lassen).</li>
      <li><b>Installationsskript für Linux</b> herunterladen, auf den Server kopieren und dort <code>sudo bash pdh-wireguard.sh</code> ausführen. Es installiert <code>wireguard-tools</code>, richtet den systemd-Dienst <code>pdh-wireguard</code> ein und öffnet den Port in ufw bzw. firewalld.</li>
      <li>Im Internet-Router den <b>UDP-Port</b> auf den Server weiterleiten und im Reiter <b>VPN</b> auf <b>eingeschaltet</b> stellen.</li>
      <li><b>Standort-Gateway</b> anlegen: Name und <b>Netze dahinter</b> (z. B. 192.168.10.0/24). Die angezeigte Konfiguration am Router als WireGuard-Schnittstelle einspielen, Weiterleitung ins LAN ohne NAT erlauben.</li>
      <li>Oder einen <b>Tunnel zum Maschinennetz</b> anlegen (siehe unten).</li>
    </ol>
    Nach einem PDH-Update oder einer Änderung des Ports das Installationsskript erneut ausführen. Unter <b>Alle Geräte</b> legst du Zugänge für andere an und sperrst sie; gesperrte Einträge lassen sich danach löschen. Das <b>Protokoll</b> zeigt, wer wann einen Zugang angelegt, angezeigt, heruntergeladen, gesperrt oder die Einstellungen geändert hat.</div>
  <div class="hb-howto" id="hb-vpn-import"><b><i class="ti ti-file-import"></i> So importierst du den Tunnel zum Maschinennetz</b>
    <ol class="hb-steps">
      <li>Am Router bzw. WireGuard-Server im Maschinennetz (mGuard, Teltonika, FRITZ!Box …) einen WireGuard-Zugang für PDH anlegen und dessen Konfiguration als <b>.conf</b> exportieren.</li>
      <li>Einmal das <b>Installationsskript</b> auf dem Server ausführen (siehe oben, Schritt 2). Den Rest der Einrichtung – öffentlicher Name, Port, <b>eingeschaltet</b> – braucht ein Tunnel <b>nicht</b>; das ist nur für Geräte und Gateways nötig, die sich bei PDH einwählen.</li>
      <li><b>Server-Einstellungen</b> → <b>VPN</b> → <b>Tunnel zum Maschinennetz</b> → <b>WireGuard-Konfiguration importieren</b>.</li>
      <li>Namen eintragen und die <b>.conf-Datei wählen</b> (oder ins Feld ziehen bzw. den Inhalt einfügen). <b>Prüfen</b> zeigt Endpunkt, Tunneladresse und Netze.</li>
      <li>Leitet die Konfiguration alles durch den Tunnel (<code>0.0.0.0/0</code>), unter <b>Netze dahinter</b> die Netze im Maschinennetz angeben, z. B. 192.168.20.0/24 → <b>Tunnel anlegen</b>.</li>
    </ol>
    PDH verbindet sich sofort. Erzeugt der Router später neue Schlüssel, am Tunnel <b>Neue Konfiguration einspielen</b> – Name und Protokoll bleiben. Eine DNS-Angabe in der Datei wird nicht übernommen.</div>
  <div class="hb-howto" id="hb-vpn-users"><b><i class="ti ti-users-plus"></i> So erstellst du Konfigurationen für die Benutzer</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen</b> → <b>VPN</b> → <b>Alle Geräte</b> → <b>Konfigurationen für Benutzer erstellen</b>.</li>
      <li>Gerätenamen eintragen (z. B. „Laptop“) und die <b>Personen anhaken</b> – das Suchfeld filtert, „alle angezeigten wählen“ hakt alle Treffer an.</li>
      <li><b>Zugänge erstellen</b>. Jede Person bekommt einen eigenen Zugang mit eigener Adresse und eigenen Schlüsseln.</li>
      <li><b>Alle als ZIP herunterladen</b>: je Person ein Ordner mit der .conf-Datei. Einzeln geht es über <b>Konfiguration</b> am Gerät, mit QR-Code fürs Handy.</li>
    </ol>
    Die Konfigurationen enthalten die privaten Schlüssel – nur auf sicherem Weg weitergeben. Wer das Recht „VPN nutzen“ hat, kann seine Konfiguration auch selbst unter <b>VPN Maschinennetz</b> laden. Die Netze der Gateways und Tunnel stehen in jeder Konfiguration; kommen neue dazu, die Konfiguration neu laden.</div>
  <div class="hb-howto"><b><i class="ti ti-shield-lock"></i> Wer darf was?</b>
    <ul>
      <li><b>VPN: eigene Zugänge ins Maschinennetz anlegen und nutzen</b> – eigene Geräte auf der Seite <b>VPN Maschinennetz</b> anlegen, Konfiguration laden, sperren. Anfangs nur Administratoren und Anlagenverantwortliche; weitere Rollen unter <b>Rollen &amp; Rechte</b>.</li>
      <li><b>Einrichtung</b> (Einstellungen, Gateways, ausgehende Tunnel, alle Geräte, Protokoll) – nur Administratoren mit dem Recht auf die <b>Server-Einstellungen</b>.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn das VPN nicht läuft</b>
    <ul>
      <li><b>„Dienst pdh-wireguard meldet sich nicht“:</b> Das Installationsskript wurde noch nicht ausgeführt oder der Dienst ist gestoppt – auf dem Server <code>systemctl status pdh-wireguard</code> und <code>journalctl -u pdh-wireguard</code> prüfen.</li>
      <li><b>„Ordner … nicht beschreibbar“:</b> Das Installationsskript (erneut) ausführen – es legt den Austauschordner mit den richtigen Rechten an.</li>
      <li><b>„WireGuard fehlt im Kernel“:</b> Der Server braucht Linux ab 5.6 (z. B. Ubuntu 22.04/24.04, Debian 12).</li>
      <li><b>„… überschneidet das Netz des Servers“:</b> Ein Netz hinter einem Gateway oder Tunnel (oder das VPN-Netz) liegt im LAN oder in einem Docker-Netz des Servers. Anderes VPN-Netz wählen bzw. die Netze genauer angeben. Das PDH-Docker-Netz liegt fest auf <code>172.31.254.0/24</code>; kollidiert gerade das, in <code>.env.docker</code> z. B. <code>PDH_DOCKER_SUBNET=172.30.254.0/24</code> eintragen und das Update erneut ausführen. Das Docker-Standardnetz <code>docker0</code> (<code>172.17.0.0/16</code>) verlegt das Installationsskript nach <code>172.31.255.0/24</code> – bei Tunneln mit Adressen in 172.17.x das Skript einmal erneut ausführen (Docker und die PDH-Container starten dabei neu).</li>
      <li><b>Gerät verbindet sich nie:</b> UDP-Port im Internet-Router prüfen und ob der öffentliche Name auf die richtige Adresse zeigt.</li>
      <li><b>Verbunden, aber Steuerung nicht erreichbar:</b> Am Gateway die Weiterleitung ins LAN erlauben; die Geräte im Maschinennetz brauchen den Router als Gateway.</li>
    </ul></div>
  <p>Ein <b>ausgehender Tunnel</b> kann auch der <b>Weg einer MSSQL-Verbindung</b> sein (Import → Verbindung → Weg), z. B. um den <a href="#abgleich">Abgleich mit einem Fremdsystem</a> zu testen. Der Abgleich baut und ändert keine Tunnel; steht der Tunnel nicht oder liegt die Adresse der Datenbank nicht in seinen Netzen, wird der Lauf übersprungen und gemeldet.</p>
  <p>Die VPN-Ereignisse lassen sich sortieren, z. B. nach Person oder Art (<a href="#sort">mehr</a>).</p>
  {{template "hb-shots" (dict "Ref" (index $s "vpn") "Can" $can)}}
</section>

<section class="hb-ch" id="datennetz" data-title="Datennetz" data-pages="datanet">
  <h2><i class="ti ti-topology-star-3"></i> Datennetz</h2>
  <p>Unter <b>Datennetz</b> (Navigation → Daten) erreicht das PDH Fremddatenbanken im Werk, ohne dass dort ein Port ins Internet offen sein muss. Ein kleines Programm, der <b>Daten-Client</b>, läuft neben der Datenbank und verbindet sie über ein privates Netz (Tailscale) mit dem PDH. Das Datennetz ist ein Zusatz: Ohne Client ändert sich am PDH nichts.</p>
  {{template "hb-fig-datennetz"}}
  <div class="hb-howto"><b><i class="ti ti-plug-connected"></i> So schaltest du das Datennetz ein</b>
    <ol class="hb-steps">
      <li>Auf tailscale.com im Admin unter <b>Settings → Keys</b> einen Schlüssel für <b>jeden PDH-Server</b> erzeugen: <i>Reusable</i> aus, <i>Pre-approved</i> an, Tag <code>tag:pdh</code>. Bei zwei Servern also zwei Schlüssel.</li>
      <li>Im PDH <b>Datennetz</b> öffnen, bei <b>Datennetz des PDH</b> den Haken <b>Datennetz einschalten</b> setzen, je Server den Schlüssel eintragen und <b>Speichern</b>. Der Schlüssel wird verschlüsselt abgelegt und nach der ersten Verbindung gelöscht.</li>
      <li>Nach kurzer Zeit steht der Zustand auf <b>Läuft</b> und jeder Server zeigt seine Adresse im Datennetz.</li>
      <li>Unter <b>Freigabe im Tailnet</b> die gezeigten Zeilen kopieren und im Tailscale-Admin unter <b>Access controls</b> in die Richtlinie eintragen. Sie erlauben dem PDH den Weg zu den Clients (nur die Ports der freigegebenen Datenbanken) und den Clients den Rückweg für ihre Meldungen. Die Ports ergeben sich aus den Clients; solange noch keiner Ports meldet, steht <code>&lt;PORT&gt;</code> als Platzhalter dort – danach die Zeilen noch einmal kopieren.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-device-desktop-plus"></i> So richtest du einen Daten-Client ein</b>
    <ol class="hb-steps">
      <li>Unter <b>Daten-Clients</b> einen Namen eintragen (z. B. „Werk Süd“) und <b>Client anlegen</b> wählen.</li>
      <li>Die Seite zeigt jetzt <b>einmal</b> das <b>Token</b> und die fertigen Befehle. <b>Das Token wird nur jetzt gezeigt</b> und steht danach nirgends mehr im PDH (gespeichert ist nur eine Prüfsumme).</li>
      <li>Unter <b>Programme für den Kunden</b> die Datei für Windows oder Linux laden und die angezeigte <b>SHA-256-Summe</b> mit der Datei vergleichen, bevor sie im Werk gestartet wird.</li>
      <li>Im Tailscale-Admin einen weiteren Einmal-Schlüssel erzeugen: <i>Reusable</i> aus, <i>Pre-approved</i> an, Tag <code>tag:pdh-data</code>. Er ersetzt im Befehl den Platzhalter <code>&lt;EINMAL-SCHLÜSSEL&gt;</code>.</li>
      <li><b>Windows:</b> Eingabeaufforderung <b>als Administrator</b> öffnen. Erst die Zeile mit <code>set /p PDH_DATANET_TOKEN=…</code> ausführen und das Token einfügen, dann die zweite Zeile mit <code>pdh-data-client-windows-amd64.exe install …</code> (der Name der geladenen Datei).</li>
      <li><b>Linux:</b> Erst die Zeile mit <code>read -rs …</code> ausführen und das Token einfügen, dann die zweite Zeile mit <code>sudo ./pdh-data-client-linux-amd64 install …</code>.</li>
      <li>Nach wenigen Minuten steht der Client in der Liste auf <b>Läuft</b>; die Ziele zeigen ihre Ports grün. Rot heißt: Die Datenbank ist vom Client aus nicht erreichbar.</li>
    </ol>
    Mit diesen zwei Zeilen bleibt das Token <b>nicht in der Shell-Historie</b>. Der einfache Befehl mit <code>--token</code> steht unter „Einfacher Befehl mit Token“, sollte aber die Ausnahme sein. Wer das Token als Datei übergeben will, nutzt <code>--token-file &lt;Datei&gt;</code>.</div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Windows meldet „Der Computer wurde durch Windows geschützt“</b>
    Das Programm ist nicht codesigniert, deshalb kann <b>SmartScreen</b> beim ersten Start warnen. Nach dem Vergleich der SHA-256-Summe auf <b>Weitere Informationen → Trotzdem ausführen</b> klicken.</div>
  <p><b>Wenn die Seite nach dem Anlegen neu geladen wird:</b> Der Browser fragt, ob er das Formular noch einmal senden soll. Das legt <b>keinen zweiten Client</b> an: Der Name ist bei aktiven Clients nur einmal erlaubt, es erscheint „Der Name ist schon vergeben“ und das Token wird nicht noch einmal gezeigt. Ein einfaches Neuladen der Seite (ohne erneutes Senden) zeigt nur die Liste.</p>
  <p><b>Token verpasst oder verloren?</b> Das Token lässt sich nicht erneut anzeigen. Den Client <b>sperren</b> und unter demselben oder einem neuen Namen <b>neu anlegen</b>. Danach den Client im Werk mit dem neuen Token noch einmal installieren (siehe unten).</p>
  <div class="hb-howto"><b><i class="ti ti-route"></i> So stellst du eine Verbindung auf den Weg „Datennetz“ um</b>
    <ol class="hb-steps">
      <li>Unter <b>Import</b> bzw. <b>Export</b> die Verbindung (SQL Server oder MySQL) öffnen.</li>
      <li>Beim <b>Weg</b> unter <b>Datennetz</b> den Client wählen. Der Eintrag erscheint nur, wenn das Datennetz läuft und der Client nicht gesperrt ist.</li>
      <li>Als <b>Port</b> die Portnummer der Datenbank eintragen, wie sie der Client freigibt (SQL Server meist 1433). Eine <b>benannte Instanz</b> ohne Port geht über das Datennetz nicht.</li>
      <li>Verbindung testen und speichern. Abfragetakt und Zeitgrenze gelten wie beim VPN.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> So sperrst oder entfernst du einen Client</b>
    <ol class="hb-steps">
      <li><b>Sperren</b> in der Zeile des Clients wählen und bestätigen. Offene Verbindungen werden <b>sofort getrennt</b>, das Token ist ungültig. Der Name wird wieder frei.</li>
      <li>Das Gerät auch im Tailscale-Admin unter <b>Machines</b> entfernen, sonst bleibt es im Tailnet. Auf dem Werksrechner den Client mit <code>pdh-data-client uninstall</code> entfernen.</li>
      <li><b>Entfernen</b> löscht den Eintrag endgültig und ist dem Bereichsadministrator des Datennetzes vorbehalten.</li>
    </ol>
    Updates des Clients folgen in einer späteren Version. Bis dahin: neue Datei laden, auf dem Werksrechner <code>uninstall</code> und danach <code>install</code> ausführen.</div>
  <div class="hb-howto"><b><i class="ti ti-stethoscope"></i> So prüfst du das Datennetz</b>
    <ol class="hb-steps">
      <li>Unter <b>Datennetz</b> beim Abschnitt <b>Datennetz prüfen</b> den Knopf <b>Datennetz prüfen</b> wählen. Die Prüfung dauert einige Sekunden, bei nicht erreichbaren Geräten bis zu einer Minute.</li>
      <li>Jede Zeile zeigt <b>✓</b> (in Ordnung), <b>⚠</b> (Warnung, sollte angesehen werden) oder <b>✗</b> (Fehler) und einen Klartext. Darunter steht, wie es weitergeht. Geprüft werden: dieser Server (im Datennetz? Adresse? Schlüssel fehlt? Anmeldefehler? trägt er <code>tag:pdh</code>?), andere PDH-Server (gemeldet, sichtbar, <code>tag:pdh</code>) und jeder Client (letzte Meldung, Tag <code>tag:pdh-data</code>, jeder gemeldete Port über das Datennetz erreichbar).</li>
      <li><b>Falscher Tag</b> ist der häufigste Fehler: Trägt ein Gerät z. B. <code>tag:pdh-test1</code> statt <code>tag:pdh</code>, lässt der Client das PDH <b>still nicht herein</b>, und im PDH steht bei der Anmeldung nur „EOF“. Die Prüfung nennt das Gerät und den Tag. Ändere den Tag im Tailscale-Admin unter <b>Machines</b> beim Gerät (<i>Edit ACL tags</i>) oder nutze <b>Tags korrigieren</b> (siehe unten).</li>
      <li><b>Port nicht erreichbar</b> heißt: Vom PDH kommt keine Verbindung zum Port des Clients zustande. Prüfe, ob der Client läuft, beide Geräte die richtigen Tags tragen und die Freigabe im Tailnet stimmt. <b>Verbindung wird sofort geschlossen</b> heißt: Der Client hat die Verbindung angenommen und gleich wieder beendet – meist wegen eines falschen Tags oder weil die Datenbank hinter dem Client nicht läuft.</li>
    </ol>
    <b>Mehr Einblick mit einem API-Token (optional):</b>
    <ol class="hb-steps">
      <li>Auf tailscale.com im Admin unter <b>Settings → Keys</b> bei <b>API access tokens</b> einen Token erzeugen (<i>Generate access token</i>). <b>Der Token läuft ab</b> (längstens nach 90 Tagen); Ablaufdatum notieren und rechtzeitig einen neuen eintragen. Meldet die Prüfung „Tailscale lehnt den API-Token ab“, ist er abgelaufen oder widerrufen.</li>
      <li>Im PDH bei <b>Datennetz des PDH</b> den Token bei <b>Tailscale-API-Token</b> eintragen und <b>Speichern</b>. Er wird verschlüsselt abgelegt und nie wieder angezeigt (nur „hinterlegt“). <b>Token löschen</b> entfernt ihn. Dafür ist der Bereichsadministrator des Datennetzes nötig.</li>
      <li>Mit Token liest die Prüfung zusätzlich die <b>Geräteliste</b> (online? Tags?) und die <b>Access controls</b>: Stehen <code>tag:pdh</code> und <code>tag:pdh-data</code> in den <code>tagOwners</code>? Erlaubt die Freigabe <code>tag:pdh</code> → <code>tag:pdh-data</code> (die Ports der Clients) und <code>tag:pdh-data</code> → <code>tag:pdh:8443</code>? Erlaubt die Richtlinie ohnehin alles (Quelle und Ziel <code>*</code>), steht dort „alles erlaubt“. Fehlt etwas, zeigt die Prüfung die <b>fehlenden Zeilen zum Kopieren</b>. <b>Das PDH ändert die Access controls nie selbst</b> – du trägst die Zeilen im Tailscale-Admin ein.</li>
      <li><b>Tags korrigieren</b>: Der Knopf erscheint, wenn ein PDH-Gerät oder ein Client den falschen Tag trägt. Er fragt vorher nach und ergänzt dann bei PDH-Geräten <code>tag:pdh</code> und bei Clients <code>tag:pdh-data</code>. Alle anderen Tags des Geräts bleiben stehen, auch <code>tag:pdh-test1</code>; entfernt wird nur der Tag der anderen Rolle (<code>tag:pdh-data</code> an einem PDH-Server, <code>tag:pdh</code> an einem Client). Geändert werden nur Geräte, die das PDH sicher über ihre <b>Adresse im Datennetz</b> zuordnen kann; findet es nur ein Gerät mit ähnlichem Namen, zeigt es einen Hinweis und ändert nichts. Das geht nur, wenn der Tag in den <code>tagOwners</code> steht, sonst erscheint ein Hinweis. Das Ergebnis nennt jedes Gerät; die Änderung steht im Ereignisprotokoll des Datennetzes. Auf dem <b>Spiegelserver</b> ist der Knopf gesperrt – bitte auf dem aktiven Server ausführen.</li>
    </ol>
    Das Ergebnis der Prüfung bleibt 30 Sekunden gespeichert (oben steht „Stand“); der Bereichsadministrator kann mit <b>Neu prüfen</b> sofort neu prüfen. Kann eine Freigabe wegen Gruppen, Hosts oder ipsets in den Access controls nicht sicher bewertet werden, zeigt die Prüfung ⚠ „nicht sicher prüfbar“ – dann bitte von Hand nachsehen. Der Zugriff auf Tailscale läuft nur, wenn du die Prüfung oder <b>Tags korrigieren</b> auslöst, nie im Hintergrund. Ohne API-Token funktioniert die Prüfung trotzdem, kennt dann aber nur, was das PDH selbst im Datennetz sieht.</div>
  <p><b>Datenschutz:</b> Bei tailscale.com liegen nur die Gerätenamen und Adressen der Teilnehmer. Die Inhalte der Datenbank laufen verschlüsselt direkt zwischen PDH und Client und liegen nie bei Tailscale. Der PDH und der Client senden zudem <b>keine Betriebsprotokolle</b> an Tailscale (log.tailscale.com); nur der Verbindungsaufbau selbst läuft über Tailscale.</p>
  <p><b>Rollentausch und Spiegelserver:</b> Jeder Server hat einen eigenen Knoten im Tailnet. Die Clients kennen mit jeder Meldung alle PDH-Server (Name <code>pdh-&lt;Servername&gt;</code> und Adresse) und versuchen sie der Reihe nach, bis einer antwortet. Nach einem Rollentausch meldet sich jeder Client also von selbst beim neuen aktiven Server; es muss nichts nachgearbeitet werden. Der Installationsbefehl nennt alle bekannten Server.</p>
  <p><b>Rechte:</b> sehen und prüfen – <b>Datennetz: Clients und Ziele sehen</b>; anlegen und sperren – <b>Datennetz: Clients anlegen und sperren</b>; Datennetz ein- und ausschalten, Schlüssel und API-Token eintragen, Tags korrigieren und Entfernen – nur der Bereichsadministrator (siehe <a href="#admin">Administration</a>).</p>
  <p><b>Wenn etwas nicht klappt:</b></p>
  <table>
    <tr><th>Anzeige</th><th>Was es heißt</th><th>Was du tust</th></tr>
    <tr><td>Datennetz ist ausgeschaltet</td><td>Weg „Datennetz“ ist gewählt, das Datennetz aber aus.</td><td>Unter Datennetz einschalten oder den Weg ändern.</td></tr>
    <tr><td>Anmeldung „EOF“ (im PDH-Protokoll oder bei der Anmeldung des Clients)</td><td>Meist trägt ein Gerät den falschen Tag, z. B. <code>tag:pdh-test1</code> statt <code>tag:pdh</code> (PDH-Server) oder <code>tag:pdh-data</code> (Client). Der Client weist das PDH dann still ab; sein Protokoll sagt „Verbindung von … abgewiesen“.</td><td>Unter Datennetz <b>Datennetz prüfen</b> wählen; die Zeile „Falscher Tag“ nennt das Gerät. Tag im Tailscale-Admin ändern oder <b>Tags korrigieren</b> nutzen.</td></tr>
    <tr><td>Datennetz nicht verbunden</td><td>Der PDH-Server hat noch keine Verbindung zum Tailnet.</td><td>Schlüssel für den Server prüfen (neu erzeugen und eintragen) und warten, bis der Zustand <b>Läuft</b> zeigt.</td></tr>
    <tr><td>Client nicht gefunden</td><td>Der Client wurde entfernt.</td><td>Einen anderen Client als Weg wählen.</td></tr>
    <tr><td>Client gesperrt</td><td>Der Client ist gesperrt.</td><td>Neuen Client anlegen und im Werk installieren.</td></tr>
    <tr><td>Client offline (noch nie gemeldet)</td><td>Der Client wurde angelegt, im Werk aber noch nicht gestartet.</td><td>Installation im Werk durchführen, Token und Einmal-Schlüssel prüfen.</td></tr>
    <tr><td>Client offline (letzter Kontakt …)</td><td>Der Client meldet sich nicht mehr.</td><td>Läuft der Rechner im Werk? Dienst und Internetzugang prüfen; Freigabe-Zeile im Tailnet prüfen.</td></tr>
    <tr><td>Port … bietet der Client nicht an</td><td>Der Port der Verbindung gehört nicht zu den Zielen des Clients.</td><td>Port der Verbindung prüfen oder den Client mit dem passenden <code>--target</code> neu installieren.</td></tr>
    <tr><td>Datenbank am Client nicht erreichbar</td><td>Der Client läuft, erreicht aber seine Datenbank nicht (Ziel rot).</td><td>Im Werk Datenbankdienst, Adresse und lokale Firewall prüfen.</td></tr>
    <tr><td>Beim Weg Datennetz bitte den Port eintragen</td><td>Eine benannte Instanz ohne Port ist über das Datennetz nicht möglich.</td><td>Den Port der Instanz eintragen.</td></tr>
    <tr><td>Andere Version als das PDH</td><td>Der Client ist älter oder neuer als der Server.</td><td>Die Datei von der Seite laden und den Client neu installieren (<code>uninstall</code>, dann <code>install</code>).</td></tr>
  </table>
  {{template "hb-shots" (dict "Ref" (index $s "datennetz") "Can" $can)}}
</section>

<section class="hb-ch" id="ausfallschutz" data-title="Ausfallschutz &amp; Wiederaufbau" data-pages="server-config">
  <h2><i class="ti ti-shield-check"></i> Ausfallschutz &amp; Wiederaufbau</h2>
  <p>Fällt der Server aus, brennt ab oder wird versehentlich etwas gelöscht, lässt sich alles wiederherstellen. Der Server sichert dafür laufend auf ein <b>Netzlaufwerk</b>: die <b>Datenbank</b> (PDH und Nextcloud), alle <b>Dateien und Einstellungen</b> von PDH, Nextcloud und n8n. Das läuft im Hintergrund über den Update-Agenten – auch wenn das PDH selbst gerade nicht läuft.</p>
  {{template "hb-fig-ausfallschutz"}}
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So schaltest du den Ausfallschutz ein</b>
    <ol class="hb-steps">
      <li>Unter <b>Core-Einstellungen → Netzlaufwerke</b> eine Freigabe mit der Rolle <b>Datensicherung</b> anlegen – am besten auf einem anderen Gerät als dem Server.</li>
      <li><b>Server-Einstellungen → Ausfallschutz</b> öffnen, das Laufwerk wählen, <b>eingeschaltet</b> wählen und speichern.</li>
      <li>Beim ersten Einschalten startet die Datenbank einmal neu – das PDH ist wenige Sekunden nicht erreichbar.</li>
      <li>Nach wenigen Minuten zeigt der Reiter die erste Übertragung und die erste Grundsicherung.</li>
    </ol></div>
  <p><b>Wie aktuell ist die Sicherung?</b> Die Datenbank höchstens <b>5 Minuten</b> alt (einstellbar), Dateien höchstens so alt wie der Dateiabgleich (Standard 60 Minuten). Jede Nacht kommt eine Grundsicherung dazu; aufbewahrt wird 14 Tage (einstellbar). Gelöschte oder überschriebene Dateien landen so lange im <b>Papierkorb</b> auf dem Laufwerk. Nextcloud wird im laufenden Betrieb abgeglichen, n8n dafür kurz angehalten.</p>
  <p>Die Freigabe enthält Zugangsdaten (<code>.env</code>, Nextcloud-<code>config.php</code>) – nur Administratoren dürfen darauf zugreifen.</p>
  <p>Mit zwei Servern zeigt der Reiter auf dem passiven Server den Hinweis „Beobachtung: würde pausieren – …“. In dieser Version läuft die Sicherung trotzdem weiter (siehe <a href="#spiegelbetrieb">Ausfallschutz mit zwei Servern</a>).</p>
  <p>Mit zwei Servern hält die <a href="#hb-dateispiegelung">Datei-Spiegelung</a> die Dateien zusätzlich auf dem zweiten Server aktuell. Sie ersetzt die Sicherung nicht: Was länger als die Papierkorb-Frist (14 Tage) gelöscht ist, gibt es nur noch in der Sicherung.</p>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> So baust du den Server wieder auf</b>
    <ol class="hb-steps">
      <li>Frischen Ubuntu-Server oder eine neue VM bereitstellen.</li>
      <li><b>pdh-vm-prepare.sh</b> im Reiter herunterladen, auf die VM kopieren und ausführen: <code>sudo bash pdh-vm-prepare.sh --wiederaufbau --share //nas/sicherung --user BENUTZER</code>. Es setzt Zeitzone, Firewall und Gast-Agent (Proxmox, VMware, Hyper-V), fragt das Passwort ab und bindet die Freigabe dauerhaft unter <code>/mnt/sicherung</code> ein. Mit <code>--restore</code> startet es den Wiederaufbau gleich mit.</li>
      <li>Das Skript liegt im Sicherungsordner (oder im Reiter herunterladen): <code>sudo bash /mnt/sicherung/PDH-Ausfallschutz/&lt;server&gt;/pdh-restore.sh --from /mnt/sicherung/PDH-Ausfallschutz/&lt;server&gt;</code></li>
      <li>Für einen <b>früheren Stand</b> (z. B. vor einem versehentlichen Löschen) zusätzlich <code>--time "2026-10-24 14:30:00"</code> angeben.</li>
      <li>Danach VPN-Installationsskript erneut ausführen, Cloudflare-Tunnel prüfen und den Ausfallschutz auf dem neuen Server wieder einschalten. Den Ausfallschutz mit zwei Servern danach neu einrichten – seine Schlüssel werden nicht mitgesichert.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So richtest du einen ganz neuen Server ein</b>
    <ol class="hb-steps">
      <li>Frische Ubuntu-VM (22.04 oder 24.04) anlegen, <b>pdh-vm-prepare.sh</b> darauf kopieren.</li>
      <li><code>sudo bash pdh-vm-prepare.sh --neu --hostname pdh</code> – installiert Postgres, PDH und den Update-Agenten.</li>
      <li>Im Browser die angezeigte Adresse <code>http://…:8090/setup</code> öffnen und den Einrichtungscode eingeben.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-server"></i> VM-Sicherung</b>
    Läuft das PDH in einer VM, sollte zusätzlich der Hypervisor (z. B. Proxmox, Hyper-V) die ganze VM regelmäßig auf ein anderes Ziel sichern. Im Reiter das Datum der letzten VM-Sicherung eintragen – oder eine Datei auf dem Netzlaufwerk nennen, die die VM-Sicherung bei jedem Lauf aktualisiert. Ist sie älter als eingestellt (Standard 7 Tage), meldet das PDH es den Administratoren.</div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn etwas nicht stimmt</b>
    <ul>
      <li><b>„WAL-Dateien stauen sich“:</b> Das Netzlaufwerk ist nicht erreichbar oder voll. Die Änderungen warten auf dem Server und werden nachgeholt, sobald das Laufwerk wieder da ist.</li>
      <li><b>„Letzte Grundsicherung ist älter als 26 Stunden“:</b> Fehlermeldung im Reiter prüfen, „Grundsicherung jetzt“ anstoßen.</li>
      <li><b>„nur bei systemd-Installationen“:</b> Der Ausfallschutz läuft auf Produktivservern (systemd); im Docker-Testsystem ist er nicht verfügbar.</li>
      <li><b>„braucht die Datenbank auf diesem Server“:</b> Die Datenbank liegt auf einem anderen Rechner – dort muss sie gesichert werden.</li>
      <li><b>„Sicherungsordner … gehört einem anderen Server“:</b> Zwei Server mit gleichem Namen sichern auf dasselbe Laufwerk. Jeder Server braucht einen eigenen Namen (<code>sudo hostnamectl set-hostname …</code>), danach im Reiter „Speichern“ – er sichert dann in einen neuen Ordner und beginnt sofort mit einer Grundsicherung.</li>
      <li><b>„rsync endete mit Fehler 23“:</b> Einzelne Dateien ließen sich nicht sichern; dahinter steht die erste Datei samt Grund. Verweise, die auf ihren eigenen Ordner zeigen (z. B. <code>uploads/uploads</code>), lässt die Sicherung selbst aus.</li>
    </ul></div>
  {{template "hb-shots" (dict "Ref" (index $s "ausfallschutz") "Can" $can)}}
</section>

<section class="hb-ch" id="spiegelbetrieb" data-title="Ausfallschutz mit zwei Servern" data-pages="server-config">
  <h2><i class="ti ti-server-2"></i> Ausfallschutz mit zwei Servern</h2>
  <p>Ein zweiter Server und ein <b>Zeuge</b> beobachten sich gegenseitig. Der Dienst <code>pdh-ha</code> läuft auf jedem Server und prüft über das LAN und über WireGuard, ob der andere noch da ist. Der Zeuge ist ein kleiner dritter Teilnehmer ohne Daten – er hilft nur bei der Entscheidung, wer aktiv ist.</p>
  <div class="hb-howto"><b><i class="ti ti-eye"></i> Was wirklich passiert – und was nur gemeldet wird</b>
    <ul>
      <li><b>Datenbank-Spiegel:</b> Ist er eingerichtet, schreibt der aktive Server jede Speicherung auch auf den passiven. Das läuft immer echt.</li>
      <li><b>Datei-Spiegelung:</b> Ist sie eingeschaltet, überträgt der aktive Server Anhänge, Einstellungen und auf Wunsch Nextcloud auf den passiven – immer echt (siehe <a href="#hb-dateispiegelung">Datei-Spiegelung</a>). Standard ist aus.</li>
      <li><b>PDH am Spiegel:</b> Das PDH läuft auch auf dem passiven Server – nur lesen (siehe „So arbeitest du am Spiegel“). <code>/health</code> zeigt dort <code>"mode": "spiegel"</code>.</li>
      <li><b>Rollen tauschen</b> und <b>Übernahme erzwingen</b> wirken immer echt.</li>
      <li><b>Automatische Umschaltung</b> bei einem Ausfall: Standard ist <b>Beobachtung</b>. Der Dienst meldet dann nur „würde jetzt: …“, Rollen bleiben, wie sie sind. Auf <b>echt</b> lässt sie sich erst nach der Pflicht-Testumschaltung stellen.</li>
      <li>Der <b>Cloudflare-Tunnel</b> läuft nur auf dem aktiven Server und wechselt mit der Rolle – über die öffentliche Adresse erreichst du immer den aktiven Server. Im LAN wechselt die <b>mitwandernde Adresse</b> mit, sobald sie eingeschaltet ist (siehe <a href="#hb-zugangsweg">Zugangsweg</a>). Ohne sie erreichst du das PDH nach einer Übernahme unter der eigenen Adresse des neuen aktiven Servers.</li>
    </ul></div>
  {{template "hb-fig-spiegelbetrieb"}}
  <div class="hb-howto"><b><i class="ti ti-eye"></i> So arbeitest du am Spiegel</b>
    <p>Der passive Server zeigt dir das PDH zum Nachsehen – etwa, wenn der aktive Server ausfällt. Du erkennst ihn am orangen Band oben auf jeder Seite.</p>
    <ol class="hb-steps">
      <li>Die Adresse des Spiegels im Browser öffnen und anmelden. Solange der aktive Server erreichbar ist, dürfen sich hier nur Administratoren anmelden. Alle anderen sehen „Bitte den aktiven Server verwenden“ mit einem Link dorthin. Ist die mitwandernde Adresse eingeschaltet, führt der Link auf sie – also immer zum gerade aktiven Server.</li>
      <li>Fällt der aktive Server aus, darf sich jeder anmelden – aber nur zum Lesen. Kann der Spiegel den Zustand nicht feststellen, bleibt es bei den Administratoren.</li>
      <li>Im Band liest du den <b>Datenstand</b>: „aktuell“ oder „vor 2 min“. Ist der aktive Server nicht erreichbar, steht dort „Daten vom“ mit Datum und Uhrzeit. „Status des aktiven Servers unbekannt“ heißt: Der Spiegel kann <code>pdh-ha</code> nicht lesen.</li>
      <li>Ansehen, suchen und Berichte öffnen geht wie gewohnt. Jede Änderung (Speichern, Anlegen, Löschen) lehnt der Spiegel ab: „Dieser Server ist der Spiegel – nur lesen. Änderungen bitte am aktiven Server.“ Bei einem Klick auf der Seite erscheint die Meldung im Hinweisfeld.</li>
      <li>Mit <b>öffnen</b> im Band springst du zum aktiven Server und arbeitest dort weiter.</li>
      <li>Übernimmt der Spiegel die Rolle (Rollen tauschen oder Übernahme erzwingen), startet das PDH hier nach etwa 10 Sekunden von selbst neu und ist schreibbar. Du bleibst angemeldet. Das Band verschwindet.</li>
    </ol>
    {{template "hb-fig-spiegelband"}}
    <p><b>Nicht verfügbar am Spiegel:</b> neue VPN-Schlüssel und Zertifizierungsstellen (der Reiter VPN zeigt „Im Spiegel nicht verfügbar“), Passwort vergessen oder ändern, Hintergrundaufgaben und Benachrichtigungen. Die Einstellungen des Ausfallschutzes änderst du immer am aktiven Server.</p>
    <p><b>Spiegel wartet auf das Update:</b> Hat der Spiegel ein neueres Programm als seine Datenbank, zeigt er nur Server-Einstellungen und Hilfe – und nur für Administratoren. Das ist normal, wenn du den Spiegel zuerst aktualisierst. Ist der aktive Server aktualisiert, startet das PDH am Spiegel kurz danach von selbst neu (meist innerhalb einer halben Minute) und zeigt wieder alle Seiten – du musst nichts tun.</p></div>
  <p>Die <b>Betriebsart</b> ergibt sich aus der Zahl der Teilnehmer: <b>Einzel</b> (ein Server), <b>Duo</b> (zwei Server, „Eingeschränkter Ausfallschutz“) und <b>Trio</b> (zwei Server und ein Zeuge). Neue Verbünde starten mit <b>Automatik aus (Wartung)</b>.</p>
  <div class="hb-howto"><b><i class="ti ti-network"></i> So stellst du feste IP-Adressen ein</b>
    <p>Die Server und der Zeuge kennen sich über ihre Adressen. Vergibt der Router per DHCP eine neue Adresse, finden sie sich nicht mehr. Deshalb jede Adresse fest einstellen – am besten, bevor der Verbund eingerichtet wird.</p>
    <ol class="hb-steps">
      <li>Am einfachsten geht es in der Oberfläche: <b>Administration → Netzwerk</b>, Karte <b>Dieser Server</b>, <b>Jetzige Adresse fest einstellen</b> (siehe <a href="#netzwerk">Netzwerk</a>). Oder auf jedem Server per SSH: <code>sudo bash /opt/pdh-server/scripts/pdh-static-ip.sh</code>. Das Skript zeigt die jetzige Adresse, das Gateway und die DNS-Server und fragt nach.</li>
      <li>Nach dem Bestätigen testet es die Einstellung: Ist die Verbindung noch da, <b>ENTER</b> drücken. Sonst geht nach 120 Sekunden alles automatisch zurück – auch über SSH ungefährlich.</li>
      <li>Im Router die Adresse aus dem DHCP-Bereich nehmen oder für den Server reservieren. Für den Zeugen-PC eine DHCP-Reservierung im Router anlegen.</li>
      <li>Netzlaufwerke (Freigaben) müssen von <b>beiden</b> Servern erreichbar sein – die Freigabe also für beide Adressen erlauben. Die Netzlaufwerk-Sicherung schaltet der neue aktive Server nach einer Übernahme nach etwa einer Minute selbst ein (eigener Ordner unter <code>PDH-Ausfallschutz/</code>, beginnend mit einer Grundsicherung).</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-server-2"></i> So fügst du den zweiten Server hinzu</b>
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Ausfallschutz</b> öffnen. Unter „Betriebsart“ die Adressen dieses Servers prüfen (LAN und WireGuard, du kannst sie ändern) und <b>Ausfallschutz einrichten</b> wählen. Beim ersten Einrichten startet das PDH dabei ggf. einmal kurz neu.</li>
      <li><b>Beitrittscode: zweiter Server</b> wählen. Der Code gilt 30 Minuten, nur einmal, und wird nur jetzt angezeigt.</li>
      <li><b>pdh-ha-join.sh</b> im Reiter herunterladen und auf den neuen Ubuntu-Server kopieren.</li>
      <li>Dort ausführen: <code>sudo bash pdh-ha-join.sh &lt;Code&gt;</code>. Das Skript holt den Quelltext von GitHub – der erste Server muss also eine dort veröffentlichte Version haben. Unter Ubuntu 22.04 ist das mitgelieferte Go zu alt (nötig: Go 1.21 oder neuer): vorher <code>sudo snap install go --classic</code> ausführen.</li>
      <li>Nach kurzer Zeit zeigt die Tabelle beide Server. Die Betriebsart steht auf <b>Duo</b>.</li>
      <li>Optional: <b>Automatik an</b> wählen. Dann trifft der Dienst Entscheidungen. Bei „Beobachtung“ zeigt er sie nur als Ereignis „würde jetzt: …“ an.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-database"></i> So richtest du den Datenbank-Spiegel ein</b>
    <ol class="hb-steps">
      <li>Den zweiten Server wie oben beitreten lassen – oder bei einem schon beigetretenen Server weitermachen.</li>
      <li>Auf dem zweiten Server ausführen: <code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt; --voll</code> (bei einem neuen Beitritt: <code>sudo bash pdh-ha-join.sh --voll &lt;Code&gt;</code>).</li>
      <li>Das Skript installiert PostgreSQL in derselben Version wie auf dem aktiven Server und das PDH-Programm. Dann kopiert es die Datenbank und die Einstellungen vom aktiven Server.</li>
      <li><b>Achtung:</b> Die Datenbank auf dem zweiten Server wird ersetzt. Liegen dort schon Datenbanken, zeigt das Skript sie an, sichert sie nach <code>/var/lib/pdh-ha/vorher</code> und fragt nach dem Hostnamen. Nur wer ihn eintippt, macht weiter.</li>
      <li>Im Reiter zeigt die Spalte <b>Datenbank</b> nun „schreibend“ und „Standby“, darunter „synchron“.</li>
      <li><b>Pflicht-Testumschaltung:</b> einmal <b>Rollen tauschen</b> und zurück. Prüfe dabei unter der Adresse des jeweils aktiven Servers, ob deine Daten da sind.</li>
    </ol>
    <p>Auf dem passiven Server läuft das PDH im <b>Spiegelmodus</b> (nur lesen). <code>pdh-ha</code> startet es dort, sobald die Datenbank als Standby läuft – ein paar Sekunden nach dem Hochfahren, nicht schon beim Booten.</p></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-exchange"></i> So tauschst du die Rollen</b>
    <ol class="hb-steps">
      <li>Am <b>aktiven</b> Server <b>Rollen tauschen</b> wählen.</li>
      <li>Der aktive Server stellt die Datenbank auf „nur lesen“ und wartet, bis der passive alles hat (höchstens 60 Sekunden). Erst dann gibt er ab. Klappt das nicht, bricht der Tausch ab und nichts ändert sich. Meist ist der Tausch nach etwa 5 Sekunden durch; über die mitwandernde Adresse sind Windows-Rechner nach rund 10 Sekunden wieder verbunden.</li>
      <li>Ist die <a href="#hb-dateispiegelung">Datei-Spiegelung</a> eingeschaltet, läuft gleich nach dem Umstellen auf „nur lesen“ – noch vor dem Warten auf die Datenbank – ein <b>letzter Abgleich</b> der Dateien (höchstens 120 Sekunden, einstellbar). Er gehört zur kurzen Sperre des Tauschs: PDH und Nextcloud stehen dabei schon. Der Tausch dauert dadurch länger als die üblichen 5 Sekunden, je nachdem, wie viel sich seit dem letzten Abgleich geändert hat. Klappt er nicht, bricht der Tausch ab und der Grund steht im Reiter.</li>
      <li>Das PDH ist für Sekunden nicht erreichbar und läuft danach auf dem anderen Server. Mit eingeschalteter mitwandernder Adresse und dem Tunnel bleibt die Adresse für alle gleich.</li>
    </ol>
    <p>Ohne Datei-Spiegelung fehlen nach einem Tausch auf dem anderen Server die neuen Anhänge – die Karte <b>Datei-Spiegelung</b> und die Prüfung vor einem Update weisen darauf hin.</p></div>
  <div class="hb-howto"><b><i class="ti ti-refresh-alert"></i> Synchron und asynchron</b>
    <ul>
      <li><b>Synchron</b> (Normalfall): Jede Speicherung liegt erst dann als gespeichert vor, wenn auch der passive Server sie hat. Es geht nichts verloren.</li>
      <li>Fällt der passive Server aus, <b>hängen Speicherungen</b> bis zu „asynchron nach“ (Standard 10 Sekunden). Dann schaltet der aktive Server auf <b>asynchron</b> und arbeitet weiter. Im Trio tut er das erst, wenn der Zeuge bestätigt hat, dass der passive Server jetzt <b>nicht aktuell</b> ist. Der Zeuge gibt ihm danach keine Stimme mehr.</li>
      <li>Kommt der passive Server zurück und hat aufgeholt, schaltet der aktive wieder auf synchron.</li>
      <li><b>Im Duo</b> (ohne Zeuge) bleibt ein Restrisiko: Fällt nur die Leitung zwischen den Servern aus und sehen beide noch das Gateway, können Speicherungen verloren gehen. Darum ist ein Zeuge empfohlen.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-git-fork"></i> Abgezweigte Daten prüfen</b>
    <p>Wurde eine Übernahme erzwungen, kann der alte Server Speicherungen haben, die der neue nicht kennt. Kommt er zurück, gliedert <code>pdh-ha</code> ihn als passiven Server ein – vorher sichert es diese Daten vollständig.</p>
    <ol class="hb-steps">
      <li>Im Reiter erscheint <b>Abgezweigte Daten</b> mit Zeitpunkt, Server und betroffenen Tabellen (z. B. „tickets: 3 neu“). Dazu kommt ein Alarm.</li>
      <li>Der Abzug liegt auf diesem Server unter <code>/var/lib/pdh-ha/abgezweigt/&lt;Eintrag&gt;/dump.sql.gz</code>.</li>
      <li>Zum Prüfen in eine eigene Datenbank einspielen, z. B. <code>sudo -u postgres createdb pruefung</code> und <code>zcat dump.sql.gz | sudo -u postgres psql pruefung</code>. Fehlende Einträge von Hand im PDH nachtragen.</li>
      <li>Danach im Reiter <b>GEPRÜFT</b> eintippen und <b>Geprüft – löschen</b> wählen. Automatisch wird nichts gelöscht.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-eye-check"></i> So fügst du einen Zeugen hinzu (Programm oder Container)</b>
    <ol class="hb-steps">
      <li>Erst den zweiten Server hinzufügen – ohne ihn wird der Zeuge abgelehnt („Zuerst den zweiten Server hinzufügen“).</li>
      <li><b>Beitrittscode: Zeuge</b> wählen.</li>
      <li><b>Als Programm</b> auf einem dritten Rechner: <code>sudo bash pdh-ha-join.sh --witness &lt;Code&gt;</code></li>
      <li><b>Als Container</b> (auf dem dritten Rechner, im PDH-Quelltext): im Ordner <code>deploy/ha-witness</code> ausführen: <code>PDH_HA_JOIN='&lt;Code&gt;' PDH_HA_ADDR=&lt;IP dieses Rechners&gt; docker compose up -d --build</code>. <code>PDH_HA_ADDR</code> ist die Adresse, unter der die Server den Zeugen erreichen (Port 7480) – ohne sie meldet der Container seine interne Adresse, die die Server nicht erreichen. Beide Angaben braucht nur der erste Start.<br><b>Unter Windows</b> (Docker Desktop, PowerShell) jeden Befehl einzeln eingeben: <code>$env:PDH_HA_JOIN='&lt;Code&gt;'</code>, <code>$env:PDH_HA_ADDR='&lt;IP dieses Rechners&gt;'</code>, <code>docker compose up -d --build</code>. Das Skript <code>pdh-ha-join.sh</code> ist nur für Linux. In der Windows-Firewall Port 7480 (TCP) für die Adressen beider Server freigeben.</li>
      <li>Die Betriebsart steht danach auf <b>Trio</b>, der Hinweis „kein Zeuge“ verschwindet.</li>
    </ol>
    <p><b>Wichtig:</b> Der Zeuge braucht <b>eigene Hardware und eigenen Strom</b>. Läuft er auf demselben Gerät oder an derselben Stromversorgung wie ein Server, fällt er mit aus – dann ist er wertlos. Erkennt das PDH gemeinsame Hardware, zeigt es eine Warnung.</p></div>
  <h3 id="hb-dateispiegelung"><i class="ti ti-copy"></i> Datei-Spiegelung und Nextcloud im Verbund</h3>
  <p>Die Datenbank wandert schon mit, die Dateien erst mit der <b>Datei-Spiegelung</b>. Ist sie eingeschaltet, überträgt der aktive Server seine Dateien fast in Echtzeit auf den passiven: neue Anhänge und Chat-Dateien nach wenigen Sekunden, alles andere mit dem <b>Abgleich</b> jede Minute. Die Richtung folgt der Rolle. Nach einem Tausch fehlt so keine Datei, nach einem harten Ausfall höchstens die letzten Sekunden bis zur letzten Minute.</p>
  <ul>
    <li><b>Immer gespiegelt</b> werden <code>uploads</code> und <code>chat_files</code> des PDH und <code>/etc/pdh</code> (mit den Skripten in <code>ha-hooks</code>).</li>
    <li><b>Nur mit „Nextcloud mitnehmen“</b> kommen dazu: der Nextcloud-Datenordner, der Programmordner (<code>/var/www/nextcloud</code> samt <code>config.php</code>), <code>/etc/nginx</code>, <code>/etc/ssl/pdh-nextcloud</code> und <code>/etc/letsencrypt</code>. Ohne diesen Haken bleiben nginx-Seiten und Zertifikate auf jedem Server, wie sie sind – Änderungen daran dann auf beiden Servern von Hand machen. Was es auf dem Server nicht gibt, entfällt.</li>
    <li><b>Nie gespiegelt</b> werden <code>/etc/pdh/ha/</code> (gehört zum Rechner), die <code>.env</code> (enthält Serverbezogenes – die Karte warnt, wenn sie sich unterscheidet) und <code>cloudflared</code> (das Token verteilt der Ausfallschutz selbst). Vorschaubilder von Nextcloud und unfertige Hochladungen bleiben ebenfalls weg.</li>
    <li><code>/etc/pdh/pdh.env</code> wird mitgespiegelt; die Karte vergleicht sie zusammen mit der <code>.env</code>. Serverbezogene Werte gehören deshalb in die <code>.env</code>, nie in <code>pdh.env</code> – vor allem das Token des Update-Agenten (<code>PDH_UPDATE_AGENT_TOKEN</code>). Steht es noch in <code>pdh.env</code>, am <b>aktiven</b> Server <code>sudo bash scripts/repair-update-agent-token.sh</code> ausführen: Es nimmt das Token dort heraus, der nächste Abgleich bringt die bereinigte Datei auf den passiven Server; danach das Skript auch am passiven Server ausführen. Nur am passiven Server ausgeführt, käme das Token mit dem nächsten Abgleich zurück.</li>
    <li>Mit „Nextcloud mitnehmen“ wird <code>/etc/nginx</code> <b>ganz</b> gespiegelt, auch die Seite des PDH. Darum in nginx keine serverbezogenen Zeilen wie <code>listen 192.0.2.5:443</code> verwenden, sondern <code>listen 443</code> bzw. die mitwandernde Adresse.</li>
    <li>Die Spiegelung läuft durch den verschlüsselten Kanal des Verbunds (Port 7480, mit den Zertifikaten der Server). Der Zeuge bekommt keine Dateien.</li>
    <li>Sie läuft nur am aktiven Server, auch bei <b>Automatik aus (Wartung)</b>. PDH und Nextcloud arbeiten weiter, wenn die Übertragung einmal scheitert.</li>
  </ul>
  {{template "hb-fig-dateispiegelung"}}
  <div class="hb-howto"><b><i class="ti ti-player-play"></i> So schaltest du die Datei-Spiegelung ein</b> (Recht „Datei-Spiegelung einstellen“)
    <ol class="hb-steps">
      <li>Vorher prüfen: Auf beiden Servern zeigt <code>id pdh</code> dieselben Zahlen bei <code>uid</code> und <code>gid</code>, mit „Nextcloud mitnehmen“ ebenso <code>id www-data</code> – die Spiegelung überträgt Besitzer und Gruppe als Nummer. Weichen sie ab, hält die Spiegelung die betroffenen Ordner an, meldet einmal einen Alarm, und die Karte zeigt beide Nummern (z. B. „Benutzerkennung pdh: hier 998, Partner 997“ oder „Gruppenkennung …“); erst nach dem Angleichen läuft sie weiter. Der Partner braucht so viel freien Platz, wie die Quellen groß sind; was dort schon liegt, rechnet die Prüfung nicht mit.</li>
      <li>Am <b>aktiven</b> Server <b>Server-Einstellungen → Ausfallschutz</b> öffnen, Karte <b>Datei-Spiegelung</b>.</li>
      <li><b>Dateien auf den zweiten Server spiegeln</b> ankreuzen und <b>Speichern</b>. Die übrigen Werte passen meist: Abstand des Abgleichs 60 s, Papierkorb 14 Tage, Alarm nach 5 min, Frist für den letzten Abgleich 120 s, Bandbreite unbegrenzt.</li>
      <li>Der <b>Erstabgleich</b> beginnt; die Karte zeigt den Fortschritt in Prozent. Bis er fertig ist, lehnt der Server <b>Rollen tauschen</b> ab („Erstabgleich der Dateien läuft – Rollentausch erst danach möglich“), und ein Update gilt nicht als „alles grün“.</li>
      <li>War ein Ordner auf dem Partner <b>schon gefüllt</b> – auf einem frischen Server meist <code>/etc/pdh</code>, mit Nextcloud auch <code>/etc/nginx</code> –, steht die Karte auf <b>wartet auf Bestätigung</b>. Die Dateien werden trotzdem übertragen, aber am Partner wird nichts gelöscht. Weiter mit „So bestätigst du …“ unten.</li>
      <li>Danach zeigt der Kopf der Karte <b>bereit</b>, am passiven Server <b>empfängt</b>. <b>Jetzt abgleichen</b> startet einen Abgleich sofort (auf der Konsole <code>sudo pdh-ha mirror run</code>, den Stand zeigt <code>sudo pdh-ha mirror status</code>).</li>
    </ol>
    <p><b>Gut zu wissen:</b> Eine neue Bandbreitengrenze bricht den laufenden Abgleich ab – während eines Tauschs also auch den Tausch. Die Frist für den letzten Abgleich sollte 150 s nicht übersteigen, sonst kann ein Update mit Rollentausch abbrechen. Ausschalten verwirft, was die Spiegelung über den Partner weiß: Nach dem Wiedereinschalten laufen Erstabgleich und Platzprüfung neu, und ein gefüllter Partner wartet wieder auf Bestätigung.</p></div>
  <div class="hb-howto"><b><i class="ti ti-shield-check"></i> So bestätigst du „Dieser Server ist vollständig“</b> (Recht „Datei-Spiegelung: Löschen am Partner freigeben und Papierkorb leeren“)
    <p>Welcher Server die vollständigen Dateien hat, weiß nur ihr. Darum löscht die Spiegelung am Partner erst, wenn dessen Stand belegt ist: Ein leerer Ordner auf dem Partner ist nach dem ersten Lauf von selbst belegt, ein gefüllter braucht deine Bestätigung.</p>
    <ol class="hb-steps">
      <li>Die Karte nennt die wartenden Quellen, z. B. „Wartet auf Bestätigung, auf dem Partner wird nichts gelöscht (1): nginx“. Dazu kommt einmal ein Alarm („Der Partner hat dort schon Dateien ohne Beleg“).</li>
      <li>Prüfen, dass der <b>aktive</b> Server wirklich alle Dateien hat. Bestätige nie am Server mit dem älteren Stand.</li>
      <li>Am aktiven Server <b>Dieser Server ist vollständig</b> wählen und die Rückfrage bestätigen. Auf der Konsole: <code>sudo pdh-ha mirror confirm</code>.</li>
      <li>Der nächste Abgleich löscht am Partner, was es hier nicht gibt. Abweichende Dateien wandern dort in den Papierkorb – 14 Tage lang zurückholbar.</li>
    </ol>
    <p>Der Knopf gilt nur für die Quellen, die die Karte beim Klick zeigte. Wird danach noch eine Quelle wartend, meldet sie sich einzeln und bleibt wartend. Meldet der Knopf „Keine Quelle genannt – bitte die Seite neu laden und erneut bestätigen“, genau das tun. Der Befehl ohne Liste nimmt alle wartenden Quellen und nennt sie in der Antwort.</p></div>
  <div class="hb-howto"><b><i class="ti ti-cloud"></i> So nimmst du Nextcloud in den Verbund</b>
    <p>Nextcloud ist dann auf beiden Servern startbereit, arbeitet aber nur auf dem aktiven. Für Browser, Desktop-Client und Handy-App bleibt es derselbe Server unter derselben Adresse. Das Skript liegt im PDH-Ordner unter <code>scripts/install-nextcloud-nginx-postgres.sh</code> und kennt dafür <code>--verbund</code> mit drei Fällen.</p>
    <ol class="hb-steps">
      <li><b>Am aktiven Server</b>, je nach Lage:
        <ul>
          <li><b>Neue Nextcloud:</b> <code>sudo bash scripts/install-nextcloud-nginx-postgres.sh --verbund aktiv-neu --domain cloud.firma.local --admin-pass … --db-pass … --data-dir /srv/nextcloud/data</code></li>
          <li><b>Vorhandene Nextcloud:</b> <code>sudo bash scripts/install-nextcloud-nginx-postgres.sh --verbund aktiv-vorhanden --install-dir /var/www/nextcloud --data-dir /srv/nextcloud/data</code> – prüft nur und ändert nichts.</li>
        </ul>
        Eine neue Nextcloud bekommt gleich die Apps <b>Kalender</b>, <b>Kontakte</b> und <b>Deck</b> (andere Auswahl: <code>--apps "calendar deck"</code>, keine: <code>--apps ""</code>). Das PDH verbindet sich danach selbst mit ihr und legt sein Konto <b>pdhNCadmin</b> an (siehe <a href="#server">Server-Einstellungen</a>).
        Der <b>Name</b> bei <code>--domain</code> ist die Adresse, unter der alle Nextcloud erreichen: ein Name oder die mitwandernde Adresse, nie die feste Adresse eines Servers. Das Skript startet PostgreSQL nicht neu und schaltet dessen Autostart nicht ein.</li>
      <li>Am Ende zeigt das Skript den <b>vollständigen Befehl für den passiven Server</b> (mit den Nummern von <code>www-data</code> und <code>pdh</code> und der PHP-Fassung). Ihn kopieren.</li>
      <li><b>Am passiven Server</b>: Den Nextcloud-Datenordner anlegen bzw. das Laufwerk dafür einhängen, dann den kopierten Befehl im PDH-Ordner ausführen (<code>--verbund passiv …</code>). Er installiert nur Pakete, PHP und nginx und legt leere Ordner an – ohne Datenbankzugriff. PHP-FPM bleibt aus. Verschiedene Nummern oder PHP-Fassungen lehnt er mit dem passenden Befehl ab.</li>
      <li><b>Zertifikat</b>: Nextcloud braucht ein Server-Zertifikat für den Namen bzw. die mitwandernde Adresse (<b>Core-Einstellungen → Zertifikate (Nextcloud)</b> → Server). Es liegt unter <code>/etc/ssl/pdh-nextcloud</code> und wird mitgespiegelt. Fehlt die mitwandernde Adresse darin, warnt die Karte.</li>
      <li>Am aktiven Server in der Karte <b>Datei-Spiegelung</b> den <b>Nextcloud-Datenordner</b> (und, falls abweichend, den Programmordner) eintragen, <b>Nextcloud mitnehmen</b> ankreuzen und <b>Speichern</b>. Der Erstabgleich füllt die Ordner am passiven Server.</li>
      <li>Steht in den Server-Einstellungen bei Nextcloud die feste Adresse eines Servers (<code>PDH_NEXTCLOUD_BASEURL</code>), warnt die Karte: dort den Namen oder die mitwandernde Adresse eintragen.</li>
      <li>Einmal <b>Rollen tauschen</b> und zurück. Dabei Web, Desktop-Client und App prüfen, auch einen Freigabe-Link und den Kalender.</li>
    </ol>
    <p><b>Was beim Wechsel passiert:</b> Am aktiven Server laufen PHP-FPM, der Nextcloud-Cron (alle 5 Minuten) und der Certbot-Zeitgeber, am passiven nicht; nginx und Redis laufen auf beiden. Erst wird die Datenbank schreibbar, dann startet Nextcloud. Die mitwandernde Adresse trägt der aktive Server selbst in <code>trusted_domains</code> ein. Im Browser musst du dich nach einem Wechsel eventuell neu anmelden; Clients mit App-Passwort melden sich von selbst wieder an. <b>Nextcloud löst nie eine Umschaltung aus:</b> Startet sie nach einem Wechsel nicht, kommt nur ein Alarm.</p>
    <p><code>pdh-ha</code> startet und stoppt <b>alle</b> PHP-FPM-Dienste des Servers (<code>php*-fpm</code>), auch die anderer PHP-Seiten. Andere PHP-Seiten gehören deshalb nicht auf diese Server. Schaltest du „Nextcloud mitnehmen“ wieder aus, läuft Nextcloud am aktiven Server wieder mit Autostart und Cron; am passiven bleibt sie aus, bis zur nächsten Übernahme.</p></div>
  <div class="hb-howto"><b><i class="ti ti-trash"></i> Papierkorb</b>
    <ul>
      <li>Was der Abgleich am passiven Server löscht oder überschreibt, legt er in den Papierkorb neben dem gespiegelten Ordner: <code>&lt;Ordner darüber&gt;/.pdh-papierkorb/&lt;Datum&gt;/&lt;Quelle&gt;/</code>, z. B. <code>/etc/.pdh-papierkorb/2026-11-09/nginx/</code>. Nur root kann ihn lesen.</li>
      <li>Nach <b>14 Tagen</b> (einstellbar) räumt der Server ihn von selbst auf. Zurückholen ist Handarbeit: die Datei aus dem Papierkorb am <b>passiven</b> Server holen und am <b>aktiven</b> Server an ihren Platz legen – am passiven Server überschreibt sie sonst der nächste Abgleich.</li>
      <li><b>Rückkehrer-Dateien:</b> Kommt ein früherer aktiver Server zurück, wird er passiv. Was er noch nicht übertragen hatte, landet in seinem Papierkorb. Die Karte nennt die Anzahl, gelöscht wird nichts still.</li>
      <li><b>Papierkorb leeren</b> am aktiven Server leert den Papierkorb des Partners endgültig (auf der Konsole am aktiven Server: <code>sudo pdh-ha mirror trash-empty</code>). Das braucht das Recht „Datei-Spiegelung: Löschen am Partner freigeben und Papierkorb leeren“.</li>
      <li>Ist der Nextcloud-Datenordner ein eigenes Laufwerk (Einhängepunkt), liegt sein Papierkorb im Ordner darüber und damit auf dem Systemlaufwerk. Dann dort auf freien Platz achten – oder den Datenordner eine Ebene tiefer anlegen (z. B. <code>/srv/ncdisk/data</code>, wenn das Laufwerk unter <code>/srv/ncdisk</code> hängt).</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-id"></i> Kennungsdatei <code>.pdh-mirror-id</code></b>
    <p>Jeder gespiegelte Ordner enthält die Datei <code>.pdh-mirror-id</code> (bei Nextcloud im Programmordner unter <code>config/</code>). Sie ist das Erkennungszeichen des Ordners. Fehlt sie oder passt sie nicht, gilt der Ordner als ein anderer – etwa nach einem Plattentausch oder wenn das Laufwerk nicht eingehängt ist. Dann löscht die Spiegelung nichts.</p>
    <ul>
      <li>Die Datei nicht löschen, nicht von Hand übertragen. Sie gehört dem Besitzer ihres Ordners (bei Nextcloud <code>www-data</code>), damit das Nextcloud-Update weiter klappt.</li>
      <li><b>Umzug per Kopie</b> (z. B. auf eine größere Platte): Die Kennung nicht mitkopieren, z. B. <code>rsync -a --exclude=.pdh-mirror-id alt/ neu/</code> (ohne „/“ davor, damit auch die Kennung in <code>config/</code> oder in einem Datenordner unter dem Programmordner wegbleibt). Sonst gilt die Kopie als derselbe Ordner, und der Abgleich löscht am Partner, was dort neuer ist.</li>
      <li>Sicherung, Wiederaufbau und Rückspielen nehmen die Kennung <b>nicht</b> mit. Nach einer Wiederherstellung auf einen neuen Datenträger meldet der Server „Der Quellordner ist ein anderer“; erst prüfen, dann bestätigen.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn bei der Datei-Spiegelung etwas nicht stimmt</b>
    <ul>
      <li><b>„Spiegelung gestört: …“</b>: Der Partner ist weg oder die Übertragung scheitert seit 5 Minuten (einstellbar). PDH und Nextcloud laufen weiter, die Spiegelung versucht es laufend neu. Der Kopf der Karte zeigt <b>gestört</b> und den Grund.</li>
      <li><b>„Zu wenig Platz am Partner: nötig …, frei …“</b>: Die Spiegelung bleibt stehen. Die Prüfung verlangt freien Platz in Höhe der ganzen Quelle, auch wenn der Partner dieselben Dateien schon hat – nach jedem Aus- und Einschalten wieder. Ausweg: am Partner Platz schaffen (Platte vergrößern oder aufräumen).</li>
      <li><b>„Erstabgleich der Dateien läuft“ sperrt Update und Rollentausch</b>: Das ist gewollt, dem zweiten Server fehlen noch Dateien. Hängt der Erstabgleich an einem Fehler, den erst ein Update behebt: Datei-Spiegelung ausschalten, Update einspielen, Spiegelung wieder einschalten. Der Erstabgleich beginnt dann neu.</li>
      <li><b>„Sofort-Übertragung eingeschränkt: zu viele Ordner …“</b>: Der Abgleich jede Minute läuft weiter. Auf beiden Servern <code>sudo sysctl -w fs.inotify.max_user_watches=524288</code> ausführen.</li>
      <li><b>„Ein Abgleich dauert länger als der eingestellte Abstand“</b>: kein Alarm, nur ein Hinweis. Bei sehr großen Ordnern den Abstand erhöhen oder die Verbindung prüfen.</li>
      <li><b>„Der Quellordner ist ein anderer“</b> (aktiver Server): Datenträger getauscht oder nicht eingehängt. Nicht eingehängt: erst einhängen, <b>dann</b> bestätigen – Einhängen allein reicht nicht. Getauscht: erst die Dateien zurückspielen, dann bestätigen. Bis dahin wird am Partner nichts gelöscht.</li>
      <li><b>„Der Zielordner ist ein anderer“</b> (passiver Server): Er nimmt nichts mehr an, der aktive Server meldet nach 5 Minuten „Spiegelung gestört“. Nicht eingehängt: einhängen, dann läuft es von selbst weiter. Nur bei einem gewollten Plattentausch: Spiegelung aus- und wieder einschalten; ein leerer Ordner ist danach von selbst belegt, ein gefüllter wartet auf Bestätigung.</li>
      <li><b>„Nextcloud-Datenordner nicht erreichbar (.ncdata/.ocdata fehlt)“</b>: Das Laufwerk mit den Nextcloud-Daten ist nicht eingehängt. Es wird nichts aufs Systemlaufwerk geschrieben; einhängen genügt. Nextcloud legt in ihrem Datenordner die Kennungsdatei <code>.ncdata</code> an (ältere Fassungen <code>.ocdata</code>) – daran erkennt die Spiegelung, dass der Ordner wirklich da ist.</li>
      <li><b>„Quelle nextcloud-data ist leer – nicht gespiegelt“</b>: Am aktiven Server fehlt im eingetragenen Nextcloud-Datenordner die Kennungsdatei. Prüfen, ob der Pfad stimmt (<code>datadirectory</code> in <code>config.php</code>) und das Laufwerk eingehängt ist.</li>
      <li><b>„Dieser Server wurde aktiv, bevor der Erstabgleich fertig war“</b>: Die Quelle läuft ohne Löschen am Partner. Nur bestätigen, wenn dieser Server wirklich vollständig ist.</li>
      <li><b>„Der Ordner ist neu dazugekommen, seit dieser Server aktiv wurde“</b>: Ein Ordner fehlte bei der Übernahme und ist erst danach entstanden (z. B. das erste Zertifikat für Nextcloud). Auch er läuft ohne Löschen am Partner, bis du bestätigst – ist der Ordner hier richtig und vollständig, einmal <b>Dieser Server ist vollständig</b> wählen.</li>
      <li><b>„wartet auf den zweiten Server“</b>: Der Partner ist nicht erreichbar. Sobald er zurück ist, läuft der Abgleich von selbst weiter; zu tun ist nichts.</li>
      <li>Am passiven Server zeigt die Karte <b>gestört</b> mit „Der Empfang wird abgelehnt: …“ – der Grund steht dahinter.</li>
      <li><b>„Letzter Abgleich der Dateien nicht fertig: …“</b>: Der Tausch ist abgebrochen, der bisherige aktive Server arbeitet weiter. Das dauert einige Sekunden länger als ein Abbruch ohne Spiegelung.</li>
      <li>Ein <b>früherer aktiver Server</b>, der noch sendet, wird abgelehnt; das Ereignis steht am Empfänger.</li>
      <li>Bricht eine Übertragung mitten in einer Datei ab, bleibt die alte Fassung gültig; der nächste Lauf holt nach.</li>
      <li><b>Nextcloud oder PHP verschieden</b> auf den beiden Servern: Die Karte warnt. Beide gleich halten, sonst startet Nextcloud nach einer Übernahme nicht.</li>
      <li><b><code>nginx -t</code> scheitert</b> am passiven Server: Er lädt nginx nicht neu, die alte Einstellung läuft weiter, es kommt ein Alarm.</li>
      <li><b>„Nach der Übernahme fehlen … Nextcloud-Dateien“</b>: Nach einem harten Ausfall vergleicht der neue aktive Server die neuesten Einträge von Nextcloud mit der Platte. Die Karte listet die fehlenden Dateien, der Alarm nennt die ersten Namen. Diese Dateien von den Clients neu hochladen lassen. Fehlende PDH-Anhänge meldet der Prüflauf nur als Anzahl.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-arrow-back-up"></i> Gescheiterter Tausch und Sonderfälle</b>
    <ul>
      <li><b>Rücknahme:</b> Scheitert ein Tausch, wird der bisherige aktive Server für einen Takt wieder aktiv, aber nur lesend, ohne mitwandernde Adresse und ohne Rollenskripte. Erst der nächste Takt schaltet Datenbank und Dienste ein und nimmt die Adresse.</li>
      <li><b>„Rücknahme hängt: …“</b>: Scheitert dieses Einschalten (z. B. Datenbank kurz nicht erreichbar), bleibt die Automatik an. Solange ist der Server aktiv, aber nur lesend, ohne Dienste und ohne mitwandernde Adresse. Es kommt ein Alarm, die Warnung steht dauerhaft im Status, und jeder Takt versucht es neu. Ist es gelungen, steht im Ereignisprotokoll „Rücknahme gelungen“.</li>
      <li><b>Netz weg während des Tauschs:</b> Sieht der abgebende Server den Partner nicht mehr (im Trio auch den Zeugen nicht), nimmt er den Tausch nicht zurück. Er bleibt abgeschottet, bis er wieder Sicht hat oder der Partner übernimmt. So werden nie zwei Server schreibbar.</li>
      <li><b>Restrisiko:</b> Geht genau in der Rücknahme der Herzschlag des Partners verloren, können beide Server kurz schreibbar sein – meist 1 bis 2 Sekunden, beim Start von Nextcloud bis 10 Sekunden länger. Im <b>Duo</b> (ohne Zeuge) reicht für die Rücknahme das erreichbare Gateway; dann kann es so lange dauern wie die Unterbrechung zwischen den Servern. Im synchronen Betrieb hängen Speicherungen in dieser Zeit, Dateien schützt das aber nicht. Darum ist ein Zeuge empfohlen.</li>
      <li><b>Rollenskripte</b> laufen nur bei einem echten Rollenwechsel, nicht beim Neustart von <code>pdh-ha</code> oder nach einem Update ohne Wechsel.</li>
      <li><b>Alarm zu einem offenen Update-Auftrag am passiven Server:</b> Der Partner ist schon aktiv und führt diesen Auftrag nicht. Am passiven Server <code>sudo pdh-ha update abort</code> ausführen. Ist der Partner älter, ihn zuerst aktualisieren. Ist die Datenbank dort danach gestoppt (eingefrorener Rückfallstand), bindet sie sich nicht von selbst an: den Stand behalten (nichts tun) oder <code>sudo pg_ctlcluster &lt;Version&gt; &lt;Name&gt; start</code> (startet nur lesend), dann <code>sudo pdh-ha rejoin</code>. Bleibt sie gestoppt, kommt nach einer Minute ein Alarm und eine dauerhafte Warnung.</li>
      <li><b>Abgebrochenes Zurückspulen (pg_rewind):</b> Der Datenordner kann halb zurückgespult sein und startet nicht. Weg: <code>sudo pdh-ha rejoin</code> – das kopiert die Datenbank neu vom Partner. Ist kein Partner erreichbar, bleibt nur die Wiederherstellung aus der Sicherung; <code>pdh-restore.sh</code> entfernt dabei die Markierung <code>&lt;Datenordner&gt;.rewind-laeuft</code> selbst.</li>
    </ul></div>
  <h3 id="hb-verbund-update"><i class="ti ti-refresh"></i> Update im Verbund und Wartungsfenster</h3>
  <p>Mit zwei Servern (und Zeuge) bringt <b>ein Auslöser alle Rechner auf denselben Stand</b>: per Knopf in den Core-Einstellungen oder automatisch im Wartungsfenster. Geht etwas schief, setzt das System <b>immer auf den bisherigen Stand zurück</b> – auch nach Datenbank-Änderungen, ohne Datenverlust.</p>
  {{template "hb-fig-verbundupdate"}}
  {{template "hb-fig-wartungsfenster"}}
  <div class="hb-howto"><b><i class="ti ti-calendar-time"></i> So richtest du das Wartungsfenster ein</b> (Recht „Wartungsfenster einstellen“)
    <ol class="hb-steps">
      <li><b>Server-Einstellungen → Ausfallschutz</b> öffnen, Kasten <b>Wartungsfenster</b>. Im Verbund geht das am aktiven (oder am ersten) Server, ohne Verbund am Einzelserver.</li>
      <li><b>Wartungsfenster</b> auf <i>täglich</i> oder <i>wöchentlich</i> stellen (bei wöchentlich den Wochentag wählen). Standard ist <i>aus</i>.</li>
      <li><b>Beginn</b> wählen: Das Fenster startet nach der täglichen Grundsicherung – <i>vor</i> oder <i>nach</i> dem nächsten Dateiabgleich (Standard: nach). Gibt es keine Ausfallschutz-Sicherung, gilt die <b>Uhrzeit</b> (Standard 02:00).</li>
      <li><b>Spätestens beginnen bis</b> (Standard 05:00) festlegen. Ist die Grundsicherung dann noch nicht fertig, fällt das Fenster aus und du bekommst eine Meldung.</li>
      <li><b>Neue Version einspielen</b> ankreuzen, wenn das Fenster auch aktualisieren soll. Eingespielt wird nur, wenn es eine neuere Version gibt, die nicht als fehlerhaft gemerkt ist.</li>
      <li>Im Verbund die <b>Update-Art</b> wählen (unten) und, wenn du willst, <b>Rollen im Fenster tauschen</b> ankreuzen. Bei „ohne Unterbrechung“ gehört ein Rollentausch schon zum Update – dann wird nicht zusätzlich getauscht, die Rollen bleiben vertauscht.</li>
      <li><b>Countdown vor der Sperre</b> (1–15 Minuten, Standard 2) und <b>Höchstdauer der Sperre</b> (10–120 Minuten, Standard 30) bei Bedarf anpassen, dann <b>Speichern</b>.</li>
    </ol>
    <p>Der Kasten zeigt das <b>nächste Fenster</b>, das <b>Ergebnis des letzten Fensters</b> und die als <b>fehlerhaft gemerkten Versionen</b>. Eine solche Version wird übersprungen, bis eine neuere erscheint. Mit <b>Wieder zulassen</b> (gleiches Recht) versucht das System sie doch noch einmal.</p>
    <p>Auch der Knopf <b>Update installieren</b> in den Core-Einstellungen folgt dieser Update-Art, nutzt aber nicht das Fenster. Er funktioniert auch bei <b>Automatik aus (Wartung)</b>: Dein Klick ist dann die Bestätigung. Am Spiegel ist der Knopf gesperrt („wird vom aktiven Server gesteuert“).</p>
    <p>Bei <b>Automatik an</b> spielt das Fenster ohne Nachfrage ein. Vor der Sperre lässt sich das Update mit <b>Abbrechen</b> stoppen.</p></div>
  <div class="hb-howto"><b><i class="ti ti-help-circle"></i> So beantwortest du die Nachfrage des Wartungsfensters</b> (bei <b>Automatik aus (Wartung)</b>)
    {{template "hb-fig-nachfrageband"}}
    <ol class="hb-steps">
      <li>Beginnt das Fenster mit einem Update, erscheint auf allen Seiten ein Band: „Wartungsfenster: Update auf … durchführen? Noch m:ss min“. Dasselbe steht im Fortschrittskasten unter <b>Server-Einstellungen → Ausfallschutz</b>.</li>
      <li><b>Durchführen</b> klicken, um das Update zu starten. Das System prüft noch einmal „alles grün“. Ist etwas nicht grün, entfällt das Update und der Grund steht in der Meldung. <b>Durchführen</b> braucht dasselbe Recht wie <b>Update installieren</b>.</li>
      <li><b>Absagen</b> klicken, wenn jetzt nicht aktualisiert werden soll. Dafür brauchst du das Recht „Automatische Wartung abbrechen“.</li>
      <li>Kommt innerhalb von <b>3 Minuten</b> keine Antwort, entfällt das Update („Update entfallen: nicht bestätigt“). Das System versucht es am nächsten Termin des Wartungsfensters wieder.</li>
      <li>Auf der Befehlszeile bestätigst du am aktiven Server mit <code>sudo pdh-ha update confirm</code>.</li>
    </ol>
    <p>Läuft schon der Countdown vor der Sperre, hat das Band den Knopf <b>Abbrechen</b> (gleiches Recht). Ihn gibt es auch im Fortschrittskasten.</p></div>
  <div class="hb-howto"><b><i class="ti ti-route-2"></i> Was bei einem Update im Verbund passiert</b>
    <p>Zuerst die <b>Prüfung „alles grün“</b>: Beide Server sehen sich, genau einer ist aktiv, der Spiegel ist synchron, beide haben denselben Stand, die letzte Grundsicherung und der letzte Dateiabgleich waren in Ordnung, bei eingeschalteter Datei-Spiegelung ist der Erstabgleich fertig, und beide Server haben mindestens 2 GB frei. Ein nicht erreichbarer Zeuge ist nur ein Hinweis. Ist etwas nicht grün, bricht das Wartungsfenster ab und meldet den Grund; der Knopf fragt nach („Trotzdem mit kurzer Unterbrechung?“) und nimmt bei „Ja“ die Art „alle nacheinander“.</p>
    <p><b>Update-Art „ohne Unterbrechung“</b> (Standard):</p>
    <ol class="hb-steps">
      <li>Der Spiegel (Server B) spielt die neue Version ein und wird geprüft. Alle arbeiten weiter am aktiven Server A.</li>
      <li>Ein <b>Countdown</b> erscheint als Band („Automatische Wartung in 2:00 min – bitte Eingaben speichern“).</li>
      <li><b>Sperre:</b> Alle werden abgemeldet, der Wartungsbildschirm erscheint. A gibt die Rolle ab und friert seine Datenbank ein, B wird aktiv und spielt die Datenbank-Änderungen ein.</li>
      <li>B wird geprüft (Prüffrist 10 Minuten). Ist alles gut, <b>gibt das System frei</b>: A wird Spiegel von B, die Sperre endet, ihr arbeitet auf B weiter.</li>
      <li>A spielt die neue Version ein und wird geprüft. Dann steht die Meldung „Update auf … abgeschlossen“. Die Rollen bleiben vertauscht.</li>
    </ol>
    <p><b>Update-Art „alle nacheinander“:</b> A baut die neue Version im Hintergrund, dann Countdown und Sperre. A schottet sich ab (das PDH hält kurz an, die Datenbank nimmt nichts mehr an) und wartet, bis der Spiegel alles übernommen hat. Erst dann wird B eingefroren, A startet mit der neuen Version und spielt die Datenbank-Änderungen ein. Nach der Prüfung folgt die Freigabe, danach zieht B nach. Das ist kürzer vorbereitet, aber die Unterbrechung ist spürbar länger.</p>
    <p>Auf dem Bildschirm und in den Meldungen steht die <b>neue Version</b> („Update auf 0.77.9“). Kennt der Auslöser sie noch nicht, übernimmt das System sie, sobald der erste Server die neue Version eingespielt hat. Vor der Sperre wartet der Spiegel mit der neuen Version auf die Datenbank-Änderungen – das ist erwartet und zählt nicht als Fehler.</p>
    <p><b>Wenn etwas scheitert:</b></p>
    <ul>
      <li><b>Vor der Sperre</b> (Spiegel scheitert): Der Spiegel geht auf den alten Stand zurück, die Version wird als fehlerhaft gemerkt, niemand hat etwas bemerkt.</li>
      <li><b>„Alle nacheinander“, Spiegel hinkt hinterher:</b> Holt der Spiegel nach dem Abschotten nicht innerhalb einer Minute auf, wird B <i>nicht</i> eingefroren. A arbeitet sofort weiter wie vorher, das Update bricht ab: „Spiegel nicht auf Gleichstand – Update abgebrochen, nichts geändert“. Die Version gilt nicht als fehlerhaft. Das gilt auch, wenn du mit „Trotzdem“ gestartet hast – der Gleichstand wird nie übersprungen.</li>
      <li><b>Rollentausch klappt nicht:</b> Der Auftrag gibt den Tausch-Befehl erneut. Ist nach 3 Minuten kein Tausch gelungen, setzt er zurück („Rollentausch nicht gelungen“) – nicht erst nach der Höchstdauer. Die Version gilt nicht als fehlerhaft.</li>
      <li><b>In der Sperre</b>: Das System setzt zurück. Der eingefrorene Server wird wieder aktiv (alter Stand, alte Version), der andere kommt als Spiegel zurück und geht auf den alten Stand. Das Zurücksetzen gibt es <b>immer</b>, auch wenn schon Datenbank-Änderungen liefen. Daten gehen nicht verloren, weil in der Sperre niemand schreibt – auch keine Schnittstelle – und weil ein Server nur mit bestätigtem Gleichstand eingefroren wird. Fehlt diese Bestätigung, setzt das System nicht zurück, hebt die Sperre auf und meldet dringend „bitte von Hand prüfen“.</li>
      <li><b>Nach dem Zurücksetzen</b> macht der aktive Server sofort eine <b>neue Grundsicherung</b>. Was der andere Server in der Zwischenzeit auf das Laufwerk gesichert hatte, verschiebt die Sicherung in den Ordner <code>wal-quarantaene</code> – eine spätere Wiederherstellung auf einen Zeitpunkt nimmt so nie den verworfenen Stand.</li>
      <li><b>Nach der Freigabe</b> (A scheitert): zweiter Versuch, danach wird A neu von B aufgesetzt. Scheitert auch das, kommt ein Alarm. Konnte A nach der Freigabe nicht wieder Spiegel werden, endet das Update mit „abgeschlossen – Spiegel ungeschützt, bitte prüfen“.</li>
      <li><b>Neustart während der Sperre:</b> Der Auftrag liegt auf beiden Servern, der aktive setzt ihn fort. Vor dem Tausch wird abgebrochen. Startet ein Server in der Prüfphase neu, läuft das Update weiter statt sofort zurückzusetzen – hängt es, erzwingen Prüffrist und Höchstdauer das Zurücksetzen. Dass das Zurückdrehen selbst <code>pdh-ha</code> neu startet, ist eingeplant: Der Auftrag erkennt den schon erledigten Schritt und wiederholt ihn nicht.</li>
      <li><b>Echter Ausfall:</b> Der Auftrag wird abgebrochen, es folgt kein weiterer automatischer Schritt.</li>
    </ul>
    <p><b>Solange ein Auftrag läuft</b>, lehnt <code>pdh-ha</code> <i>Rollen tauschen</i> und <i>Wartung an/aus</i> ab („Update läuft – zuerst <code>pdh-ha update abort</code>“). <i>Übernahme erzwingen</i> bleibt nur als Notweg, wenn der aktive Server nicht erreichbar ist – der Auftrag bricht dann ab.</p>
    <p><b>Wichtig zu wissen:</b></p>
    <ul>
      <li>Während der Sperre werden <b>alle Benutzer abgemeldet – auch Systembenutzer</b> (Terminals, Leitstand-Anzeigen). Sie müssen sich nach jeder Wartung neu anmelden.</li>
      <li>Die Sperre kann die <b>Höchstdauer</b> (Standard 30 Minuten) um bis zu die <b>Prüffrist</b> (Standard 10 Minuten) überschreiten, weil das Zurücksetzen nach Ablauf selbst Zeit braucht.</li>
      <li>Solange die Server unterschiedliche Versionen haben, bleibt die automatische Übernahme gesperrt („Versionen unterschiedlich“).</li>
      <li>Ein Spiegel, dessen Datenbank neuer ist als sein Programm, zeigt „Programm zu alt für diese Datenbank“ und sperrt sich.</li>
      <li>Meldungen (Fortschritt, Abbruch, Alarm) gehen an die Administratoren.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-lock"></i> Wartungsbildschirm und Abbrechen</b>
    <p>Vor der Sperre zeigt ein <b>Band</b> auf jeder Seite den Countdown. Mit der Sperre erscheint der <b>Wartungsbildschirm</b>: „Automatische Wartung läuft“, die Versionen („0.77.7 → 0.77.8“), ein Fortschrittsbalken (Abmelden → Rollentausch → Datenbank aktualisieren → Prüfen → Freigabe), ein Satz zum Geschehen und die geschätzte Restzeit. Beim Zurücksetzen steht dort „Wartung wird rückgängig gemacht“. Antwortet der Server kurz nicht (Neustart, Tausch), bleibt der Bildschirm stehen und fragt alle 2 Sekunden neu. Am Ende folgt „Wartung beendet“ und die Weiterleitung zur Anmeldung. Schnittstellen (App, n8n, Webhooks) antworten in dieser Zeit mit „503 – später versuchen“.</p>
    <ol class="hb-steps">
      <li>Wer das Recht <b>„Automatische Wartung abbrechen“</b> hat, bleibt angemeldet. Alle anderen melden sich unten auf dem Bildschirm über <b>Als Administrator anmelden</b> an; ohne das Recht klappt das nicht.</li>
      <li><b>Abbrechen und zurücksetzen</b> drücken und bestätigen. Das System setzt zurück und gibt frei; das Protokoll nennt deinen Namen. Die Version gilt dabei <i>nicht</i> als fehlerhaft. Läuft das Zurücksetzen schon oder ist das Update schon freigegeben, fehlt der Knopf – der Bildschirm sagt dann, warum (auch <code>pdh-ha update abort</code> lehnt mit diesem Grund ab).</li>
      <li><b>Notbremse ohne PDH:</b> auf der Konsole des aktiven Servers <code>sudo pdh-ha update abort</code>. Den Stand zeigt <code>sudo pdh-ha update status</code>.</li>
    </ol>
    <p>Andere Seiten bleiben auch für Administratoren gesperrt. Scheitert das Zurücksetzen selbst, bleibt die Sperre bis zur Höchstdauer, dann kommt ein dringender Alarm.</p></div>
  <div class="hb-howto"><b><i class="ti ti-server"></i> Update auf dem Einzelserver</b>
    <p>Ohne Verbund läuft das Update mit <b>Countdown und Sperre</b> (Wartungsbildschirm wie oben). Vorher prüft das System, dass die letzte Grundsicherung in Ordnung ist und mindestens 2 GB frei sind. Das Programm hält das PDH an (der Wartungsbildschirm zeigt solange „Server wird neu gestartet …“), legt die „Sicherung vor dem Update“ an – so geht nichts verloren, was zwischen Sicherung und Neustart gespeichert würde –, startet mit der neuen Version neu und spielt die Datenbank-Änderungen ein. Scheitert schon die Sicherung, läuft die bisherige Version gleich weiter. Scheitert die Prüfung (Frist 10 Minuten), kommt <b>automatisch der alte Stand zurück</b>: Datenbank aus der Sicherung, alte Version, Neustart. Die Version wird als fehlerhaft gemerkt. Das Wartungsfenster steht dort zunächst auf <i>aus</i>.</p></div>
  <div class="hb-howto"><b><i class="ti ti-eye-check"></i> Zeuge aktualisiert sich selbst</b>
    <p>Der Zeuge folgt den Servern: Haben beide Server denselben Stand, der Zeuge nicht, und läuft kein Auftrag, zieht er nach spätestens fünf Minuten nach.</p>
    <ol class="hb-steps">
      <li><b>Zeuge als Container:</b> Der Dienst <code>updater</code> aus <code>deploy/ha-witness/compose.yaml</code> baut den Zeugen neu. Er braucht dafür den <b>Docker-Socket</b> (<code>/var/run/docker.sock</code>) – damit kann der Helfer Container auf dem Rechner steuern. Das ist so gewollt, gib dem Rechner deshalb keine weitere Aufgabe. Schlüssel und Beitritt bleiben erhalten. Zeigt der Zeuge nach dem Neubau nicht innerhalb von 2 Minuten beide Server, baut der Helfer den alten Stand zurück.</li>
      <li><b>Zeuge als Programm:</b> <code>pdh-ha</code> startet <code>pdh-ha-join.sh --update &lt;Commit&gt; --witness</code> selbst.</li>
      <li><b>Abschalten:</b> beim Container <code>PDH_HA_AUTOUPDATE=0</code>, beim Programm <code>PDH_HA_SELFUPDATE=0</code>.</li>
      <li><b>Einmalig von Hand</b>: Hat dein Zeuge noch eine ältere <code>compose.yaml</code> ohne <code>updater</code>, die neue Datei einspielen und den Container einmal neu starten (Notweg unten).</li>
    </ol>
    <p>Als Sicherheitsnetz zeigt der Reiter <b>„Zeuge veraltet (…)“</b> mit dem Befehl zum Kopieren, wenn der Zeuge 30 Minuten nach einem abgeschlossenen Update noch auf dem alten Stand ist. Ein veralteter Zeuge sperrt weder Update noch Umschaltung.</p></div>
  <div class="hb-howto"><b><i class="ti ti-refresh"></i> Notweg: Server von Hand nachziehen</b>
    <p>Normalerweise ist das nicht mehr nötig. Zeigt die Übersicht trotzdem „Versionen unterschiedlich“ (etwa wenn ein Server beim Update nicht erreichbar war), zieht man ihn so von Hand nach. Der Befehl steht eingeklappt auch im Reiter Ausfallschutz.</p>
    <ol class="hb-steps">
      <li>Den <b>Commit</b> des ersten Servers ablesen: in der Übersicht in Klammern hinter seiner Version, oder dort <code>pdh-ha version</code> ausführen.</li>
      <li><b>Zweiter Server</b> und <b>Zeugen-Rechner</b> (Programm): <code>sudo bash /opt/pdh-ha-src/scripts/pdh-ha-join.sh --update &lt;Commit&gt;</code></li>
      <li><b>Zeuge als Container</b>: im PDH-Quelltext auf denselben Stand gehen (<code>git fetch</code>, <code>git checkout &lt;Commit&gt;</code>), dann in <code>deploy/ha-witness</code> <code>PDH_HA_COMMIT=&lt;Commit&gt; docker compose up -d --build</code> (der Commit erscheint dann auch in der Übersicht). <code>PDH_HA_ADDR</code> und Code sind nicht nötig – sie liegen schon in den Volumes.</li>
      <li>Nach kurzer Zeit verschwindet die Warnung „Versionen unterschiedlich“.</li>
    </ol>
    <p>Der Zeuge zieht normalerweise von selbst nach (siehe „Zeuge aktualisiert sich selbst“). Dieser Weg ist nur der Notweg, etwa wenn die Selbst-Aktualisierung abgeschaltet ist.</p></div>
  <div class="hb-howto"><b><i class="ti ti-trash"></i> So entfernst du einen Server oder Zeugen</b>
    <ol class="hb-steps">
      <li>Das geht nur am ersten Server (dort, wo der Ausfallschutz eingerichtet wurde): Bereich <b>Knoten entfernen</b>.</li>
      <li>Den Zeugen <b>zuerst</b> entfernen. Solange ein Zeuge da ist, lässt sich kein Server entfernen.</li>
      <li>Der <b>aktive</b> Server lässt sich nicht entfernen. Erst <b>Rollen tauschen</b>, dann den bisherigen aktiven (jetzt passiven) Server entfernen.</li>
      <li>Ist der Server dauerhaft weg und nicht erreichbar, <b>dauerhaft weg</b> ankreuzen und <b>Entfernen</b> wählen.</li>
      <li>Einen entfernten Server wieder verwenden: dort <code>sudo pdh-ha reset --yes</code> ausführen und danach mit einem neuen Beitrittscode erneut beitreten. Bis dahin bleibt er inaktiv.</li>
    </ol></div>
  <div class="hb-howto"><b><i class="ti ti-list-details"></i> So liest du die Übersicht</b>
    <ul>
      <li><b>Rolle:</b> <i>aktiv</i> arbeitet, <i>passiv</i> wartet bereit, <i>abgeschaltet</i> hat sich selbst abgeschaltet, <i>wiedereingliederung</i> kommt gerade zurück, <i>zeuge</i> ist der Zeuge.</li>
      <li><b>Amtszeit:</b> Zähler, der bei jedem Wechsel des aktiven Servers steigt. Die höhere Amtszeit gilt.</li>
      <li><b>Wege:</b> Jeder Teilnehmer ist über LAN und WireGuard verbunden. Grün heißt: Nachrichten kommen an. Ist nur ein Weg rot, gilt der Partner noch als erreichbar.</li>
      <li><b>Gateway:</b> Zeigt, ob der Server sein Netz (Router) erreicht. „nein“ heißt: der Fehler liegt eher bei diesem Server als beim Partner.</li>
      <li><b>Zuletzt gesehen:</b> Wann zuletzt eine Nachricht kam. „Uhrzeit prüfen“ warnt, wenn die Uhren zu stark abweichen.</li>
      <li><b>Datenbank:</b> <i>schreibend</i> ist die Datenbank des aktiven Servers, darunter „synchron“ oder „asynchron“ und der Rückstand des Partners. <i>Standby</i> ist der Spiegel, „nicht aktuell“ heißt: ihm fehlen Speicherungen, er übernimmt nicht automatisch.</li>
      <li><b>Ereignisse:</b> „Rolle“ und „Info“ erklären, was passiert ist. <b>„würde jetzt: …“</b> ist eine automatische Entscheidung, die bei „Beobachtung“ nur gemeldet wird.</li>
      <li><b>Übernahme gesperrt: …</b> Die Automatik übernimmt solange nicht. Beispiel „Wartungsstand beim Partner noch nicht angekommen“: Der Partner hat das Ende der Wartung noch nicht gesehen, die Automatik wartet darauf. Ist der Partner wirklich weg, hilft <b>Übernahme erzwingen</b> (dazu <b>ÜBERNEHMEN</b> eintippen). Nur verwenden, wenn der aktive Server sicher aus ist – laufen beide als aktiv, können Daten verloren gehen.</li>
      <li><b>Knöpfe:</b> <i>Rollen tauschen</i> gibt es nur am aktiven Server, <i>Übernahme erzwingen</i> nur an einem nicht aktiven – und nur, solange der aktive Server nicht erreichbar ist. Ist er erreichbar, lehnt der Dienst ab: Dann am aktiven Server <i>Rollen tauschen</i> verwenden. Am Zeugen und an einem entfernten Server gibt es keine Befehle.</li>
      <li><b>Alarm „Aktiver Server abgelöst (neue Amtszeit …)“:</b> Der andere Server führt jetzt eine höhere Amtszeit – dieser gibt die Rolle ab und kommt als passiver Server zurück.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-clock"></i> Zeiten, Umschaltungen und Alarme</b>
    <ul>
      <li>Die <b>Zeiten</b> (Takt, Selbst-Abschaltung, Übernahme mit und ohne Zeuge, Wartezeit, Umschaltungen je Tag) und die <b>Automatische Umschaltung</b> (Beobachtung oder echt) ändert man am <b>aktiven Server</b> (oder am ersten Server) im Bereich <b>Zeiten</b> ganz unten, dann <b>Speichern</b>. Der <b>Takt</b> ist der Abstand, in dem sich die Server „Ich bin da“ melden (Standard 1 Sekunde). Die <b>Selbst-Abschaltung</b> ist die Zeit, nach der sich ein aktiver Server selbst stoppt, wenn er niemanden mehr erreicht – damit nie zwei Server gleichzeitig aktiv sind. Die Übernahmezeit muss mindestens Selbst-Abschaltung + 2 × Takt + 5 s sein.</li>
      <li><b>Umschaltungen je Tag:</b> Jeder Server übernimmt höchstens so oft automatisch pro Tag. Danach geht die Automatik aus und es kommt ein Alarm.</li>
      <li><b>Datenbank-Spiegel:</b> „Asynchron nach“ (Standard 10 s), „Verzögerungsgrenze“ (16 MB: so viel Rückstand gilt noch als aktuell) und „Höchstmenge zurückgehaltener Änderungen“ (20 GB: so viel hebt der aktive Server für einen fehlenden Partner auf – danach braucht dieser eine vollständige Neukopie).</li>
      <li><b>Automatische Umschaltung:</b> „Beobachtung“ (Standard) oder „echt“. „echt“ ist erst nach der Pflicht-Testumschaltung wählbar.</li>
      <li><b>Alarme</b> gehen an die Administratoren. Je Art kommt höchstens einer alle 15 Minuten.</li>
      <li><b>Netzlaufwerk-Sicherung:</b> Sie läuft nur auf dem aktiven Server mit schreibbarer Datenbank. Der passive Server zeigt „Sicherung pausiert: passiver Knoten“. Nach einer Übernahme macht der neue aktive Server sofort eine neue Grundsicherung. Ist <code>pdh-ha</code> nicht erreichbar, pausiert die Sicherung, und nach 15 Minuten kommt ein Fehler.</li>
    </ul></div>
  <h3 id="hb-zugangsweg"><i class="ti ti-route"></i> Zugangsweg: so finden alle den aktiven Server</h3>
  <p>Nach einem Rollentausch oder Ausfall sollen Benutzer, Leitstand, Terminals und Drucker den neuen aktiven Server von selbst erreichen – ohne dass jemand Lesezeichen oder Geräte umstellt. Dafür gibt es drei Wege, die du einzeln einschaltest:</p>
  <ul>
    <li><b>Mitwandernde Adresse:</b> eine feste Adresse im LAN (z. B. <code>192.0.2.202</code>), die immer der aktive Server hat. Bei einem Wechsel nimmt sie der neue aktive Server innerhalb weniger Sekunden. Sie ist nie auf zwei Servern zugleich. Zusätzlich kann sie eine IPv6-Adresse begleiten (Feld „IPv6-Ende“).</li>
    <li><b>Cloudflare-Tunnel:</b> läuft auf beiden Servern eingerichtet, aber nur auf dem aktiven.</li>
    <li><b>Skripte beim Rollenwechsel:</b> eigene Skripte, z. B. um einen DNS-Eintrag umzustellen – für alles, was die Adresse allein nicht schafft.</li>
  </ul>
  <p>Den Zustand zeigt die Karte <b>Zugangsweg</b> im Reiter Ausfallschutz. Einstellen kannst du dort am aktiven Server (oder am ersten Server). Auf der Kommandozeile zeigt <code>sudo pdh-ha status</code> dasselbe in den Zeilen „Adresse …“, „Tunnel: …“ und „Skripte: …“.</p>
  {{template "hb-fig-zugangsweg"}}
  <div class="hb-howto"><b><i class="ti ti-network"></i> So richtest du die mitwandernde Adresse ein</b>
    <p>Du brauchst eine <b>freie Adresse</b> im selben Netz wie beide Server – nicht die eigene Adresse eines Servers oder des Zeugen, außerhalb des DHCP-Bereichs. Soll die bisherige Adresse eines Servers mitwandern, lies zuerst „So stellst du die bisherige Adresse um“.</p>
    <ol class="hb-steps">
      <li>Am aktiven Server <b>Server-Einstellungen → Ausfallschutz</b> öffnen, Karte <b>Zugangsweg</b>.</li>
      <li>Bei <b>Mitwandernde Adresse</b> die Adresse mit Präfix eintragen, z. B. <code>192.0.2.202/24</code>. Den Haken <b>Adresse mitwandern lassen</b> noch nicht setzen. <b>Speichern</b>.</li>
      <li><b>Testen</b> wählen (Testadresse leer lassen). Der Test legt die Adresse nacheinander auf jeden Server. Alle anderen Teilnehmer prüfen, ob sie dort antwortet – auch der <b>Zeuge</b>. Das dauert meist unter einer halben Minute; kommt ein Teilnehmer nicht gleich durch, versucht er es bis zu 15 Sekunden lang weiter, dann kann der Test bis zu zwei Minuten dauern. Jede Richtung erscheint grün oder rot.</li>
      <li>Ist alles grün: Haken <b>Adresse mitwandern lassen</b> setzen und <b>Speichern</b>. Ohne bestandenen Test lässt sich der Haken nicht speichern.</li>
      <li>Die Karte zeigt jetzt „192.0.2.202/24 liegt auf …“ mit dem Namen des aktiven Servers. Geräte und Lesezeichen auf diese Adresse umstellen – danach musst du sie nie wieder ändern.</li>
    </ol>
    <p>Mit <code>ip addr</code> siehst du die Adresse auf der Netzwerkkarte immer als <code>/32</code>, auch wenn du <code>/24</code> eingetragen hast. Das ist Absicht: So bleibt die feste Adresse des Servers der Absender seiner Verbindungen.</p>
    <p>Ein bestandener Test gilt für jede Adresse im selben Netz, solange beide Server dieselbe Netzwerkkarte benutzen. In einem anderen Netz oder mit einer anderen Karte testest du neu. Auf der Kommandozeile geht dasselbe mit <code>sudo pdh-ha vip test</code> und <code>sudo pdh-ha access --vip 192.0.2.202/24 --vip-on</code>; ausschalten mit <code>sudo pdh-ha access --vip-off</code>.</p>
    <p>Ist die Adresse schon eingeschaltet, testest du mit einer <b>freien Testadresse</b> im selben Netz. Mit der eingeschalteten Adresse selbst lehnt der Test ab („Adresse ist eingeschaltet – mit freier Testadresse testen oder vorher ausschalten“), damit er ihr nicht in die Quere kommt.</p></div>
  <div class="hb-howto"><b><i class="ti ti-network"></i> So lässt du zusätzlich eine IPv6-Adresse mitwandern</b>
    <p>Das ist ein Zusatz. Ohne ihn läuft alles wie bisher. Er gilt nur, wenn die mitwandernde Adresse eingeschaltet ist. Setze das Ende erst, wenn beide Server auf derselben Version sind – vorher lehnt das PDH es ab. Das Netz muss die Adressen selbst verteilen (SLAAC) oder der Server eine feste Adresse im aktuellen Präfix haben; ein Netz, das IPv6 nur einzeln zuteilt (DHCPv6), reicht nicht.</p>
    <ol class="hb-steps">
      <li>Am aktiven Server <b>Server-Einstellungen → Ausfallschutz</b> öffnen, Karte <b>Zugangsweg</b>.</li>
      <li>Im Feld <b>IPv6-Ende (Zusatz)</b> das Ende der Adresse eintragen, z. B. <code>15</code>. Leer heißt: aus. <b>Speichern</b>. Die Meldung nennt das Ende („IPv6-Ende 15 gespeichert“). Sagt sie „Der Verbund-Dienst hat das IPv6-Ende nicht übernommen“, erst beide Server aktualisieren.</li>
      <li>In der Zeile <b>Mitwandernde Adresse</b> die IPv6-Adresse ablesen, z. B. „… · IPv6 2001:db8::15“. Das PDH baut sie aus dem Präfix, das euer Anbieter gerade vergibt, und dem Ende.</li>
    </ol>
    <p>Auf der Kommandozeile geht dasselbe mit <code>sudo pdh-ha access --vip6-ende 15</code>; leeren mit <code>sudo pdh-ha access --vip6-ende ""</code>.</p>
    <ul>
      <li>Schaltest du die mitwandernde Adresse aus (auch mit <code>sudo pdh-ha access --vip-off</code>), löscht das PDH das IPv6-Ende mit.</li>
      <li>Hat euer Netz kein IPv6, passiert nichts. Die Zeile zeigt den Hinweis „Kein IPv6-Präfix …“, solange das Netz kein IPv6-Präfix hat.</li>
      <li>Hat die Netzwerkkarte mehrere Präfixe mit ähnlicher Laufzeit, bleibt die Adresse im bisherigen und springt nicht hin und her.</li>
      <li>Bei einem Rollentausch folgt die IPv6-Adresse der IPv4-Adresse etwa 5 Sekunden später. Vorher prüft der Server, ob die Adresse frei ist. In dieser Lücke nehmen die Geräte IPv4.</li>
      <li>Wechselt der Anbieter das Präfix, setzt der Server die Adresse selbst neu: sofort, wenn der Router das alte Präfix als abgelaufen meldet, sonst nach etwa 30 Minuten.</li>
      <li>Benutzt schon ein anderes Gerät die Adresse, meldet der Server einen Alarm und versucht es danach einmal pro Minute erneut.</li>
      <li>Änderst du das Ende, während der Dienst <code>pdh-ha</code> gestoppt ist, bleibt die alte Adresse bis zum nächsten Start des Servers.</li>
      <li>Ein Problem mit IPv6 hält nie einen Rollentausch auf.</li>
      <li>Die Adresse ist eine öffentliche. Ob sie von außen erreichbar ist, entscheidet die Firewall des Routers – wie schon bei der eigenen IPv6-Adresse jedes Servers. Das PDH prüft das nicht.</li>
      <li>Firewall: Regeln, die Port 443 nur für IPv4 erlauben (am Server oder zwischen Netzen am Router), verwerfen IPv6 still. Geräte ohne schnellen Rückfall auf IPv4 hängen dann. Prüfen mit <code>sudo ufw status</code> – Port 443 muss auch mit „(v6)“ erlaubt sein.</li>
      <li>Die Namen im Haus bekommen den passenden IPv6-Eintrag mit einer UniFi UDM Pro selbst – siehe „So zeigen die Namen im Haus auf den Server“.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-info-circle"></i> Gut zu wissen zur mitwandernden Adresse</b>
    <ul>
      <li><b>Netzwerkkarte:</b> Jeder Server nimmt die Karte, deren eigene Adresse im Netz der mitwandernden Adresse liegt. Passen keine oder mehrere, meldet die Karte „Netzwerkkarte nicht eindeutig“. Dann in <code>/etc/pdh/ha/node.json</code> den Eintrag <code>"vip_interface": "ens18"</code> (Name deiner Karte) ergänzen und <code>sudo systemctl restart pdh-ha</code> ausführen.</li>
      <li><b>Karte getauscht oder umbenannt:</b> <code>pdh-ha</code> wählt die Karte, wenn die Adresse eingeschaltet wird oder der Dienst startet. Nach einem Wechsel der Netzwerkkarte deshalb <code>sudo systemctl restart pdh-ha</code> ausführen. Am aktiven Server ist die Adresse dabei kurz weg.</li>
      <li><b><code>pdh-ha</code> beenden</b> (<code>systemctl stop</code> oder <code>restart</code>, Update): Bei automatischer Umschaltung <b>„echt“</b> gibt der Server die Adresse dabei ab. So kann der Partner sie übernehmen, wenn er die Datenbank übernimmt. Im Modus <b>„Beobachtung“</b> bleibt sie auf dem Server liegen – dort übernimmt der Partner nie von selbst, und die Geräte erreichen den Server weiter.</li>
      <li><b>Nach einem Neustart</b> hat zunächst kein Server die Adresse. Sie kommt, sobald <code>pdh-ha</code> den Server als aktiv bestätigt hat. Die Adresse gehört deshalb nie in die feste Netzwerkkonfiguration (netplan).</li>
      <li><b>Adresse wird noch benutzt:</b> Antwortet ein anderes Gerät auf die Adresse, nimmt der Server sie nicht und meldet „Adresse … wird noch von einem anderen Gerät benutzt“. Er versucht es laufend weiter. Die Datenbank schaltet trotzdem um – der neue aktive Server ist dann über den Tunnel und seine eigene Adresse erreichbar.</li>
      <li><b>Entfernt</b> der Netzwerkdienst die Adresse (z. B. durch <code>netplan apply</code>), setzt <code>pdh-ha</code> sie nach wenigen Sekunden wieder.</li>
      <li><b>Geräte im Netz</b> erfahren den Wechsel sofort: Der neue aktive Server kündigt die Adresse im LAN an (zweimal, nach 5 s noch einmal) – auch als ARP-Antwort, damit Windows-Rechner sie übernehmen. Windows fragt danach zur Sicherheit erst beim alten Server nach und erreicht den neuen nach etwa 8–10 Sekunden (im Testverbund gemessen, Rechner im WLAN). Ein Gerät, das die Ankündigung verpasst, findet den neuen Server spätestens nach etwa 30 Sekunden von selbst.</li>
      <li>Die Adresse braucht die Pakete <code>iproute2</code> und <code>iputils-arping</code>. Sie kommen beim Update von <code>pdh-ha</code> von selbst dazu – am ersten Server mit dem PDH-Update, an beigetretenen Servern mit dem Update im Verbund (siehe „Update im Verbund und Wartungsfenster“; als Notweg „Server von Hand nachziehen“). Fehlen sie trotzdem (z. B. ohne Internet beim Update), meldet <code>pdh-ha</code> „Paket … fehlt“; dann <code>sudo apt-get install iputils-arping iproute2</code>.</li>
      <li>Der Zeuge bekommt die Adresse nie.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-alert-triangle"></i> Wenn der Test scheitert</b>
    <p>Unter dem Ergebnis nennt das PDH die typischen Ursachen:</p>
    <ul>
      <li><b>Proxmox:</b> Die Firewall der virtuellen Netzwerkkarte hat einen IP-Filter und erlaubt nur die eigene Adresse. Den IP-Filter ausschalten oder die mitwandernde Adresse (und die Testadresse) dort freigeben.</li>
      <li><b>Switch:</b> ARP-Prüfung (Dynamic ARP Inspection) oder Port-Security lässt keine zweite Adresse am Anschluss zu. Die Adresse im Switch für beide Anschlüsse erlauben.</li>
      <li><b>Cloud-Server:</b> Zusätzliche Adressen lassen sich dort meist nicht frei verschieben. Stattdessen ein Skript beim Rollenwechsel nehmen (z. B. die Floating-IP des Anbieters umhängen oder DNS umstellen).</li>
      <li><b>Zeuge in einem anderen Netz:</b> Der Zeuge prüft mit. Erreicht er das Netz der Server nicht (z. B. hinter einer Firewall oder nur über einen anderen Weg), scheitert seine Richtung. Den Zeugen ins Netz der Server stellen oder ihm den Weg dorthin freigeben.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-arrows-right-left"></i> So stellst du die bisherige Adresse um</b>
    <p>Beispiel: Alle Geräte kennen den Server unter <code>192.0.2.202</code>. Diese Adresse soll mitwandern. Der Server bekommt dafür eine neue eigene Adresse, z. B. <code>192.0.2.203</code>. Das Skript <code>pdh-ha-adresse.sh</code> führt dich in Schritten durch. Jeder Schritt lässt sich einzeln starten, und am Ende steht immer <b>„Zurücknehmen: …“</b> mit den Befehlen, die ihn rückgängig machen. Änderungen am Netz testet es mit <code>netplan try</code>: Bestätigst du nicht mit <b>ENTER</b>, geht nach 120 Sekunden alles von selbst zurück.</p>
    <p><b>Wo das Skript liegt:</b> am <b>ersten Server</b> (dort, wo der Ausfallschutz eingerichtet wurde) unter <code>/opt/pdh-server/scripts/pdh-ha-adresse.sh</code>, an <b>beigetretenen Servern</b> unter <code>/opt/pdh-ha-src/scripts/pdh-ha-adresse.sh</code>. In den Befehlen unten steht dafür kurz <code>…/pdh-ha-adresse.sh</code>.</p>
    <ol class="hb-steps">
      <li><b>Neue eigene Adresse dazu</b> – auf dem Server, der heute <code>.202</code> hat:<br><code>sudo bash …/pdh-ha-adresse.sh neu 192.0.2.203/24</code><br><code>.202</code> bleibt, nichts wird unterbrochen. Das Skript setzt die neue Adresse sofort als Absender für Verbindungen zum Partner (<code>ip route replace …</code>) – ein Neustart ist nicht nötig. Stammt die Netzwerkdatei von cloud-init (<code>50-cloud-init.yaml</code>), schaltet das Skript die Netzwerkkonfiguration von cloud-init ab (<code>/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg</code>) und sagt das an. Sonst käme beim nächsten Start die alte Einstellung zurück.</li>
      <li><b>Verbund umstellen</b> – am <b>ersten Server</b> (dort, wo der Ausfallschutz eingerichtet wurde):<br><code>sudo bash …/pdh-ha-adresse.sh verbund 192.0.2.203</code><br>Herzschlag und Datenbank-Spiegel laufen danach über <code>.203</code>. PostgreSQL startet dabei kurz neu. Auf einem anderen Server führt das Skript nichts aus, sondern zeigt den Befehl für den ersten Server. Geht die Verbindung zum Partner noch von der alten Adresse aus, bricht es ab und zeigt den Befehl, der das richtet.</li>
      <li><b>Testen</b> – mit einer freien Testadresse, denn <code>.202</code> ist ja noch belegt:<br><code>sudo bash …/pdh-ha-adresse.sh test 192.0.2.15/24</code><br>Der Test gilt danach auch für <code>.202</code> (gleiches Netz, gleiche Karten). Alternativ in der Karte bei <b>Testadresse</b> eintragen und <b>Testen</b>.</li>
      <li><b>Prüfliste</b> – zeigt, was <code>.202</code> noch als „genau diesen Server“ benutzt:<br><code>sudo bash …/pdh-ha-adresse.sh pruefliste 192.0.2.202</code><br>Auf <code>.203</code> umstellen: SSH-Zugänge, Überwachung, Firewall-Freigaben nur für <code>.202</code> und vor allem die Netzlaufwerk-Freigabe <b>pdhnas</b> – ein Sicherungsziel darf nicht mitwandern.</li>
      <li><b>Übergabe</b> – zuerst per SSH über die <b>neue</b> Adresse <code>.203</code> anmelden, dann:<br><code>sudo bash …/pdh-ha-adresse.sh uebergabe 192.0.2.202/24</code><br>Das Skript schaltet <code>.202</code> zuerst als mitwandernde Adresse ein – sie liegt dabei noch fest an, <code>pdh-ha</code> übernimmt sie still. Danach nimmt <code>netplan try</code> sie aus der festen Netzwerkkonfiguration, und <code>pdh-ha</code> setzt sie sofort neu. Die Lücke dauert nur wenige Sekunden, egal wie lange du mit dem Bestätigen brauchst. Bestätigst du nicht, schaltet das Skript die mitwandernde Adresse wieder aus, wartet, bis <code>pdh-ha</code> sie abgegeben hat, und trägt <code>.202</code> wieder fest ein. Vorher prüft es die Einstellung <code>promote_secondaries</code> (sonst nähme der Kernel mit <code>.202</code> auch <code>.203</code> weg) und schaltet sie nach Rückfrage ein. Läuft deine SSH-Sitzung noch über <code>.202</code>, lehnt das Skript ab – sie würde abreißen. Zurücknehmen: erst <code>sudo pdh-ha access --vip-off</code>, warten, bis die Adresse bei niemand liegt, dann die Netzwerkdateien zurück, wie das Skript es ausgibt.</li>
    </ol>
    <p>Das Skript gibt am Ende jedes Schritts aus, wie es weitergeht. Gesicherte Netzwerkdateien liegen unter <code>/var/backups/pdh-ha-adresse/</code>. Weitere Angaben: <code>--if NAME</code> (Netzwerkkarte, Standard: die mit der Standardroute), <code>--partner IP</code> (Adresse des anderen Servers für die Absender-Prüfung). Das Skript braucht ein echtes Terminal (wegen <code>netplan try</code>).</p></div>
  <div class="hb-howto"><b><i class="ti ti-cloud-lock"></i> Cloudflare-Tunnel auf beiden Servern</b>
    <ul>
      <li>Das Tunnel-Token trägst du nur einmal ein (Server-Einstellungen → Cloudflare-Tunnel, siehe <a href="#server">Server-Einstellungen</a>). Das PDH gibt es an <code>pdh-ha</code> auf <b>beiden</b> Servern weiter – innerhalb etwa einer Minute, ganz ohne Skript.</li>
      <li>Der Tunnel läuft nur auf dem aktiven Server. Bei einem Wechsel verbindet er sich in 5–15 Sekunden neu; Anmeldungen bleiben gültig.</li>
      <li><b>Ohne Datenbank-Spiegel</b> (einzelner Server, oder der erste Server, bevor der Partner mit <code>--voll</code> beigetreten ist) bleibt der Autostart von <code>cloudflared</code>, wie er ist: Der Tunnel kommt nach einem Neustart des Rechners wie gewohnt hoch. Erst mit Spiegel startet <code>pdh-ha</code> ihn nur am aktiven Server und schaltet den Autostart ab. Schaltet etwas den Autostart später wieder ein (z. B. das Tunnel-Skript aus den Server-Einstellungen), schaltet <code>pdh-ha</code> ihn innerhalb von 30 Sekunden wieder ab und vermerkt das im Ereignisprotokoll.</li>
      <li>Das <b>Ziel im Cloudflare-Dashboard</b> ist immer <code>localhost:8090</code> (HTTP). Mit einer festen Server-Adresse liefe der Tunnel nach einem Wechsel ins Leere – die Karte warnt dann „Ziel im Cloudflare-Dashboard muss localhost:8090 sein“.</li>
      <li><code>cloudflared</code> installiert <code>pdh-ha-join.sh</code> nur mit <code>--voll</code>, also beim Einrichten des Datenbank-Spiegels – nie auf dem Zeugen, der keinen Tunnel braucht. Fehlt es auf einem schon eingerichteten Server, <b>nicht erneut mit <code>--voll</code> ausführen</b> – das legt die Datenbank-Kopie neu an. Stattdessen das Paket von Hand installieren, ohne <code>cloudflared service install</code> (bei ARM-Rechnern <code>arm64</code> statt <code>amd64</code>): <code>curl -fsSL -o /tmp/cloudflared.deb https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb</code> und <code>sudo dpkg -i /tmp/cloudflared.deb</code>. Den Rest richtet <code>pdh-ha</code> ein.</li>
      <li>Wurde <code>cloudflared</code> früher mit <code>cloudflared service install &lt;Token&gt;</code> (oder dem Tunnel-Skript aus dem PDH) eingerichtet, steht das alte Token weiter in dessen Dienstdatei. Entfernst du das Token im PDH, bleibt dieses alte Token dort stehen – zum vollständigen Entfernen <code>sudo cloudflared service uninstall</code> ausführen.</li>
      <li>Ist <code>cloudflared</code> installiert, aber hier kein Token abgelegt, zeigt die Karte „Token fehlt“ (am aktiven Server als Fehler). Ist im ganzen Verbund kein Token eingetragen, zeigt sie nur „nicht eingerichtet“ – ein Ausfallschutz ohne Tunnel ist in Ordnung. Dann das Token in den Server-Einstellungen eintragen bzw. das PDH auf diesem Server aktualisieren. Fehlt das Token auf dem anderen Server, meldet die Karte „Token fehlt auf …“.</li>
      <li>Die Karte meldet „Token auf den Servern verschieden“ oder einen Fehler, wenn der Tunnel auf dem nicht aktiven Server läuft. Die pdhadmin-Seiten (n8n, pgAdmin, code-server) laufen nach einem Wechsel noch nicht mit.</li>
    </ul></div>
  <div class="hb-howto"><b><i class="ti ti-terminal-2"></i> Skripte beim Rollenwechsel</b>
    <p>Wechselt ein Server die Rolle (zu aktiv, passiv oder abgeschaltet), führt <code>pdh-ha</code> deine Skripte aus. Der aktiv werdende Server tut das, nachdem er die mitwandernde Adresse übernommen hat. Die Skripte laufen im Hintergrund und halten die Umschaltung nie auf. Bearbeiten lassen sie sich nur auf dem Server selbst, nicht im PDH.</p>
    <ol class="hb-steps">
      <li>Skript in den Ordner <code>/etc/pdh/ha-hooks/</code> legen, z. B. <code>10-dns</code>. Ausgeführt werden alle ausführbaren Dateien in alphabetischer Reihenfolge.</li>
      <li>Rechte setzen: <code>sudo chown root:root /etc/pdh/ha-hooks/10-dns</code> und <code>sudo chmod 755 /etc/pdh/ha-hooks/10-dns</code>. Dateien, die nicht root gehören oder für Gruppe oder andere schreibbar sind, werden übersprungen („Skript … unsicher – übersprungen“). Verknüpfungen (Symlinks) laufen nie; sie werden einmal gemeldet („Skript … ist eine Verknüpfung – übersprungen“). Auch der Ordner selbst muss root gehören und darf nicht für Gruppe oder andere schreibbar sein, sonst läuft gar kein Skript und es kommt ein Alarm („Ordner … unsicher“) – beheben mit <code>sudo chown root:root /etc/pdh/ha-hooks</code> und <code>sudo chmod 755 /etc/pdh/ha-hooks</code>.</li>
      <li>Dasselbe Skript auf den <b>anderen Server</b> kopieren. Sind die Skripte verschieden, warnt die Karte „auf den Servern verschieden“.</li>
      <li>Testen: <code>sudo pdh-ha hook run</code> führt alle Skripte mit der aktuellen Rolle aus und zeigt die Ausgabe. In der Karte geht das mit <b>Jetzt ausführen</b>.</li>
      <li>In der Karte den Haken <b>Skripte bei Umschaltung ausführen</b> setzen und <b>Speichern</b> (oder <code>sudo pdh-ha access --hooks-on</code>).</li>
    </ol>
    <p>Jedes Skript darf höchstens <b>30 Sekunden</b> laufen. Endet es mit Fehler oder läuft zu lange, kommt ein Alarm; die letzten Zeilen der Ausgabe (höchstens 2 KB) stehen im Ereignisprotokoll. Die Skripte laufen als root – für SSH-Aufrufe den Schlüssel von root benutzen und <code>-o BatchMode=yes</code> setzen, damit nichts auf eine Eingabe wartet.</p>
    <table>
      <tr><th>Variable</th><th>Inhalt</th></tr>
      <tr><td><code>PDH_HA_ROLLE</code></td><td>neue Rolle: <code>aktiv</code>, <code>passiv</code> oder <code>abgeschaltet</code></td></tr>
      <tr><td><code>PDH_HA_AMTSZEIT</code></td><td>Amtszeit (Zähler der Wechsel)</td></tr>
      <tr><td><code>PDH_HA_KNOTEN</code></td><td>Kennung dieses Servers</td></tr>
      <tr><td><code>PDH_HA_EIGENE_ADRESSE</code></td><td>erste eigene Adresse dieses Servers (ohne Port)</td></tr>
      <tr><td><code>PDH_HA_PARTNER_ADRESSE</code></td><td>erste Adresse des anderen Servers</td></tr>
      <tr><td><code>PDH_HA_VIP</code></td><td>mitwandernde Adresse ohne Präfix, leer wenn keine eingetragen</td></tr>
    </table>
    <p><b>Beispiele</b> – jeweils nur auf dem Server, der aktiv wird. Sie stellen einen DNS-Namen (z. B. <code>pdh.firma.local</code>) auf die eigene Adresse des aktiven Servers um.</p>
    <p>Windows-DNS über SSH und PowerShell (OpenSSH auf dem DNS-Server):</p>
<pre>#!/bin/sh
# /etc/pdh/ha-hooks/10-dns-windows
[ "$PDH_HA_ROLLE" = "aktiv" ] || exit 0
ssh -o BatchMode=yes dnsadmin@dc01 "powershell -NoProfile -Command \"\$a = Get-DnsServerResourceRecord -ZoneName firma.local -Name pdh -RRType A; \$n = \$a.Clone(); \$n.RecordData.IPv4Address = [ipaddress]'$PDH_HA_EIGENE_ADRESSE'; Set-DnsServerResourceRecord -ZoneName firma.local -OldInputObject \$a -NewInputObject \$n\""</pre>
    <p>BIND oder ein anderer DNS-Server mit dynamischen Updates (<code>nsupdate</code>, Paket <code>bind9-dnsutils</code>):</p>
<pre>#!/bin/sh
# /etc/pdh/ha-hooks/10-dns-nsupdate
[ "$PDH_HA_ROLLE" = "aktiv" ] || exit 0
nsupdate -k /etc/pdh/dns.key &lt;&lt;EOF
server 192.0.2.2
update delete pdh.firma.local A
update add pdh.firma.local 60 A $PDH_HA_EIGENE_ADRESSE
send
EOF</pre>
    <p>Pi-hole bis Version 5 (Einträge unter „Local DNS“ in <code>/etc/pihole/custom.list</code>):</p>
<pre>#!/bin/sh
# /etc/pdh/ha-hooks/10-dns-pihole
[ "$PDH_HA_ROLLE" = "aktiv" ] || exit 0
ssh -o BatchMode=yes root@pihole "sed -i '/ pdh.firma.local\$/d' /etc/pihole/custom.list &amp;&amp; echo '$PDH_HA_EIGENE_ADRESSE pdh.firma.local' &gt;&gt; /etc/pihole/custom.list &amp;&amp; pihole reloaddns"</pre>
    <p>Cloudflare-DNS über die Schnittstelle (API-Token mit Recht „DNS bearbeiten“; Zonen- und Eintrags-Kennung aus dem Dashboard bzw. der API):</p>
<pre>#!/bin/sh
# /etc/pdh/ha-hooks/10-dns-cloudflare
[ "$PDH_HA_ROLLE" = "aktiv" ] || exit 0
. /etc/pdh/cloudflare-dns.env   # CF_TOKEN=…  CF_ZONE=…  CF_RECORD=…  (Datei: root, chmod 600)
curl -fsS -X PUT "https://api.cloudflare.com/client/v4/zones/$CF_ZONE/dns_records/$CF_RECORD" \
  -H "Authorization: Bearer $CF_TOKEN" -H "Content-Type: application/json" \
  --data "{\"type\":\"A\",\"name\":\"pdh-intern.firma.de\",\"content\":\"$PDH_HA_EIGENE_ADRESSE\",\"ttl\":60,\"proxied\":false}"</pre>
    <p>Namen, Zonen und Adressen in den Beispielen an euer Netz anpassen. Mit eingeschalteter mitwandernder Adresse braucht ihr für das LAN meist kein DNS-Skript – dann den DNS-Namen einfach fest auf die mitwandernde Adresse zeigen lassen.</p></div>
  <div class="hb-howto"><b><i class="ti ti-flask"></i> Testlabor</b>
    Für Tests gibt es ein Docker-Testlabor. Es dient nur zum Ausprobieren – im Betrieb laufen die Server mit systemd.</div>
  {{template "hb-shots" (dict "Ref" (index $s "spiegelbetrieb") "Can" $can)}}
</section>

<section class="hb-ch" id="pdh-app" data-title="PDH-App" data-pages="app_setup app_request app_devices app_install">
  <h2><i class="ti ti-device-mobile"></i> PDH-App</h2>
  <p>Die PDH-App verbindet Handy und Tablet mit diesem Server; die Einrichtungsseite <b>/app/setup</b> führt durch die Installation.</p>
  <div class="hb-howto"><b><i class="ti ti-info-circle"></i> Stand</b>
    Dieses Paket legt den <b>Zugang</b> an: Telefon anfragen, freigeben, sperren, Einstellungen. Die App selbst mit Störungen, Tickets und Aufgaben folgt mit den nächsten Paketen.</div>
  {{template "hb-fig-app"}}
  <div class="hb-howto"><b><i class="ti ti-users"></i> Einmal vorbereiten</b>
    <ol class="hb-steps">
      <li>Unter <b>Verwaltung → Abteilungen &amp; Gruppen</b> (oder am Benutzer) die Personen, die Telefone freigeben sollen, zur Gruppe <b>„App-Administratoren“</b> hinzufügen. Ohne Mitglieder meldet das APP-Ticket niemanden.</li>
    </ol>
  </div>
  <div class="hb-howto"><b><i class="ti ti-device-mobile-check"></i> So gibst du ein Telefon frei</b>
    <ol class="hb-steps">
      <li>Wer die App einrichtet, fragt den Zugang an. Dabei entsteht ein <b>APP-Ticket</b> für die Gruppe „App-Administratoren“; das Telefon zeigt einen sechsstelligen <b>Code</b>.</li>
      <li>Im Ticket auf <b>App-Konfiguration öffnen</b> klicken (nur mit dem Recht „App: Geräte freigeben und sperren“).</li>
      <li>Den Code eingeben, den das Telefon <i>jetzt</i> anzeigt. Stimmt er nicht, wird nichts gespeichert.</li>
      <li>Die Person wählen, der das Telefon gehört. Vorgeschlagen werden Personen mit gleichem Nachnamen oder aus derselben Abteilung. Du kannst nur Personen wählen, deren Rolle du verwalten darfst und für deren Abteilung du das Recht hast.</li>
      <li>Die erlaubten Vorgangsarten (Störungen, Tickets, Aufgaben, Wartung) ankreuzen. „Vorgänge aus der App anlegen“ erscheint nur, wenn die Person das Recht „App: Vorgänge anlegen“ hat.</li>
      <li><b>Freigeben</b> legt das Gerät an und schließt das Ticket; die App holt ihren Zugang danach selbst ab. <b>Ablehnen</b> schließt das Ticket ohne Gerät.</li>
    </ol>
    Die Rechte vergibst du nicht am Gerät: Es gelten die Rechte der Person; das Gerät kann sie nur einschränken. Einzelrechte änderst du über das Schild-Symbol neben der Person.
    Danach öffnet sich die Seite <b>App-Geräte</b> mit der Meldung „Das App-Gerät wurde freigegeben.“ bzw. nach <b>Ablehnen</b> „Die Anfrage wurde abgelehnt.“ Hat die gewählte Person das Recht „App: nutzen“ nicht, warnt die Seite vorher; die Freigabe ist trotzdem möglich, die App ist dann aber nicht nutzbar. Später zeigt die App-Konfiguration einer freigegebenen Anfrage einen Link zum Gerät und, wenn du es darfst, den Knopf <b>Sperren</b>.
  </div>
  <div class="hb-howto"><b><i class="ti ti-devices"></i> So sperrst du ein Telefon und stellst die App ein</b>
    <ol class="hb-steps">
      <li>Unter <b>Verwaltung → App-Geräte</b> stehen die eingerichteten Telefone mit Benutzer, System, App-Version und letztem Zugriff. Du siehst nur Geräte von Personen aus Abteilungen, für die du „App: Geräte freigeben und sperren“ hast; offene Anfragen stehen darüber mit einem Link zur App-Konfiguration.</li>
      <li><b>Sperren</b> trennt das Telefon sofort von diesem Server (spätestens nach 30 Sekunden); gesperrt wird nur, wenn deine Rolle die der Person übertrifft. Dasselbe Knöpfchen steht in der Benutzerverwaltung am Benutzer unter „App-Geräte“. Nach einer Sperre muss die Person die App auf dem Telefon <b>zurücksetzen</b> und den Zugang <b>neu anfragen</b>; dabei entsteht ein neuer Schlüssel, der alte Zugang bleibt gesperrt.</li>
      <li>Das Formular <b>Einstellungen für die App</b> (zusätzliche Adressen, eine je Zeile, nur http:// oder https://; neueste App-Version je System; ob die vorige Version weiter arbeiten darf; Store-Adressen) pflegen allein <b>Administratoren mit dem Recht „Server-Einstellungen (.env) bearbeiten &amp; Server neu starten“</b> auf der Seite <b>App-Geräte</b>; „App: Geräte freigeben und sperren“ genügt dafür nicht. Trägst du eine höhere „neueste Version“ ein, merkt sich der Server die alte als <b>vorige Version</b> (nur zur Anzeige); bei einer niedrigeren Version entfällt eine höhere vorige Version, damit keine App ausgesperrt wird.</li>
    </ol>
  </div>
  <div class="hb-howto"><b><i class="ti ti-world"></i> Wichtig für die Einrichtung</b>
    <ol class="hb-steps">
      <li>Die <b>öffentliche Adresse</b> des Servers (Einstellung <code>PDH_PUBLIC_URL</code>) muss gesetzt sein. Nur dann bekommt die App die richtige Serveradresse, auch hinter einem Proxy oder Tunnel.</li>
      <li>Die <b>Abteilungsliste</b> ist ohne Anmeldung lesbar: Wer den Zugang anfragt, wählt dabei seine Abteilung, bevor er einen Zugang hat. Darin stehen nur Abteilungsnamen.</li>
    </ol>
  </div>
  <div class="hb-howto"><b><i class="ti ti-qrcode"></i> So installierst du die App</b>
    <ol class="hb-steps">
      <li>Oben rechts im Benutzermenü <b>App installieren</b> wählen (nur mit dem Recht „App: nutzen“ und sobald mindestens eine Store-Adresse eingetragen ist; sonst steht auf der Seite „Die App ist noch nicht verfügbar.“).</li>
      <li>Den QR-Code mit der Kamera des Telefons scannen, die Seite öffnen und die App aus dem Store installieren; bei Bedarf stehen die Store-Knöpfe auch auf der Seite.</li>
      <li>In der App den Zugang anfragen; der Code, den das Telefon zeigt, geht an die App-Administratoren (siehe oben).</li>
    </ol>
  </div>
  {{template "hb-shots" (dict "Ref" (index $s "pdh-app") "Can" $can)}}
</section>

<section class="hb-ch" id="faq" data-title="Tipps &amp; häufige Fragen" data-pages="">
  <h2><i class="ti ti-help-circle"></i> Tipps &amp; häufige Fragen</h2>
  <h3>Ich sehe einen Reiter oder Knopf nicht.</h3>
  <p>Viele Funktionen hängen von Berechtigungen ab. Frag eure Administration.</p>
  <h3>Ein eingebettetes Portal bleibt leer.</h3>
  <p>Der Anbieter erlaubt das Einbetten nicht. Im Viewer über <i class="ti ti-external-link"></i> in einem neuen Tab öffnen.</p>
  <h3>Die Chat-Leiste geht zu oft auf.</h3>
  <p>Den Chat stummschalten (Glocke) – dann öffnet sie sich bei dieser Unterhaltung nicht mehr von selbst. Das gilt auch für die Unterhaltung mit <b>„Service“</b>; die Änderungshinweise lassen sich unter Mein Konto → Konto &amp; Dienste ganz abschalten.</p>
  <h3>Wie lösche ich eine Anlage, ein Ersatzteil oder einen Lagerplatz?</h3>
  <p>Gar nicht direkt: <b>Status → Zum Löschen vormerken</b>. Der Bereinigungslauf löscht den Datensatz oder blendet ihn aus, wenn er noch verwendet wird (<a href="#cleanup">mehr</a>).</p>
  <h3>Beim Speichern oder Buchen erscheint „gesperrt“.</h3>
  <p>Der Datensatz – bei Buchungen das Ersatzteil oder der Lagerplatz – wurde gesperrt. Wer bearbeiten darf, hebt die Sperre über <b>Status → Sperre aufheben</b> auf.</p>
  <h3>Wie lege ich PDH auf dem Handy oder Tablet als App ab?</h3>
  <p>PDH im Browser öffnen und <b>Zum Home-Bildschirm</b> (iPhone/iPad: Teilen-Symbol; Android: Menü ⋮) wählen. Es erscheint das PDH-Symbol, und PDH öffnet sich ohne Adressleiste wie eine App.</p>
  <h3>Etiketten werden zu groß oder zu klein gedruckt.</h3>
  <p>Das passende Format wählen und im Druckdialog 100 % Skalierung und keine Ränder einstellen.</p>
  {{template "hb-shots" (dict "Ref" (index $s "faq") "Can" $can)}}
</section>
{{end}}

{{define "context-list"}}{{end}}

{{define "scripts"}}
<script>
(function(){
  const body = document.getElementById('hb-body');
  const toc = document.getElementById('hb-toc');
  const sections = [...body.querySelectorAll('.hb-ch[id]')];
  toc.innerHTML = sections.map((s, i) => '<a href="#' + s.id + '"><span class="n">' + (i + 1) + '</span>' + s.dataset.title + '</a>').join('');
  const links = [...toc.querySelectorAll('a')];
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting) links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id)); });
  }, {rootMargin: '0px 0px -70% 0px'});
  sections.forEach(s => obs.observe(s));
  // Volltextsuche: Kapitel filtern und Treffer markieren (Bilder/Grafiken bleiben unveraendert)
  const q = document.getElementById('hb-q');
  let t;
  q.addEventListener('input', () => { clearTimeout(t); t = setTimeout(search, 200); });
  function unmark(root){ root.querySelectorAll('mark.hb-m').forEach(m => m.replaceWith(document.createTextNode(m.textContent))); root.normalize(); }
  function search(){
    const term = q.value.trim().toLowerCase();
    let hits = 0;
    sections.forEach(s => {
      unmark(s);
      const match = !term || s.textContent.toLowerCase().includes(term);
      s.classList.toggle('hb-hide', !match);
      if(match){ hits++; if(term) mark(s, term); }
    });
    links.forEach(a => { const s = document.querySelector(a.getAttribute('href')); a.style.display = s && s.classList.contains('hb-hide') ? 'none' : ''; });
    document.getElementById('hb-none').style.display = hits ? 'none' : '';
  }
  function mark(root, term){
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {acceptNode: n => n.parentElement.closest('svg,script,style') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT});
    const nodes = [];
    while(walker.nextNode()) if(walker.currentNode.nodeValue.toLowerCase().includes(term)) nodes.push(walker.currentNode);
    nodes.forEach(n => {
      const i = n.nodeValue.toLowerCase().indexOf(term);
      const m = document.createElement('mark'); m.className = 'hb-m';
      const hit = n.splitText(i); hit.splitText(term.length);
      m.textContent = hit.nodeValue; hit.replaceWith(m);
    });
  }
})();
</script>
{{end}}
