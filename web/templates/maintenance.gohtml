{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Wartungsplanung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.TotalPlans}} Pläne · {{.OpenTasks}} Aufträge offen</p>
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn" data-action="new" onclick="document.getElementById('new-plan-form').style.display='block'"><i class="ti ti-plus"></i>Neu</button>
    <button class="btn btn-primary" data-action="refresh"
      hx-post="/maintenance/generate"
      hx-target="#generate-result">
      <i class="ti ti-refresh"></i>Aktualisieren
    </button>
  </div>
</div>
<div id="generate-result"></div>

<!-- Neuer Plan -->
<div id="new-plan-form" style="display:none" class="card">
  <div class="card-title">Wartungsplan anlegen</div>
  <form hx-post="/maintenance/plans" hx-target="#plans-list" hx-swap="outerHTML">
    <div class="grid2">
      <div class="form-group"><label class="form-label">Name</label><input name="name" class="form-input" required></div>
      <div class="form-group"><label class="form-label">Typ</label>
        <select name="type" class="form-input">
          <option value="preventive">Vorbeugend</option>
          <option value="inspection">Inspektion</option>
          <option value="calibration">Kalibrierung</option>
          <option value="cleaning">Reinigung</option>
        </select>
      </div>
      <div class="form-group" style="grid-column:1/-1"><label class="form-label">Infrastruktur</label>
        <input type="hidden" id="maintenance-infra-id" name="infrastructure_id" required>
        <div class="infra-picker" data-infra-picker data-target="maintenance-infra-id" data-selected-label="maintenance-infra-selected">
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px">
            <div id="maintenance-infra-selected" style="flex:1;font-size:12px;color:var(--muted)">Keine Infrastruktur ausgewählt</div>
            <button type="button" class="btn" data-action="refresh" style="font-size:11px;padding:5px 10px" onclick="loadInfraPicker(this.closest('[data-infra-picker]'))"><i class="ti ti-refresh"></i>Aktualisieren</button>
            <button type="button" class="btn" data-action="cancel" style="font-size:11px;padding:5px 10px" onclick="clearInfraPicker(this.closest('[data-infra-picker]'))"><i class="ti ti-x"></i>Leeren</button>
          </div>
          <input class="form-input" data-infra-filter placeholder="Suchen: Gebäude, Linie, Anlage, Gerät..." oninput="filterInfraPicker(this)" style="margin-bottom:8px">
          <div data-infra-tree style="border:1px solid var(--border);border-radius:8px;max-height:220px;overflow:auto;padding:8px;background:var(--bg3);font-size:12px;color:var(--muted)">Noch nicht geladen</div>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Intervall</label>
        <select name="interval" class="form-input">
          <option value="daily">Täglich</option>
          <option value="weekly">Wöchentlich</option>
          <option value="monthly" selected>Monatlich</option>
          <option value="quarterly">Quartalsweise</option>
          <option value="yearly">Jährlich</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Erstes Fälligkeitsdatum</label><input name="first_due_at" type="date" class="form-input" value="{{.Today}}"></div>
      <div class="form-group"><label class="form-label">Priorität</label>
        <select name="priority" class="form-input">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button type="button" class="btn" data-action="cancel" onclick="document.getElementById('new-plan-form').style.display='none'"><i class="ti ti-x"></i>Abbrechen</button>
      <button type="submit" class="btn btn-primary" data-action="save"><i class="ti ti-check"></i>Anlegen</button>
    </div>
  </form>
</div>

<!-- Fällige Aufträge -->
{{if .DueTasks}}
<div class="card" style="border-color:rgba(245,158,11,.3);margin-bottom:14px">
  <div class="card-title"><i class="ti ti-alert-circle" style="color:var(--amber)"></i> Heute fällig</div>
  {{range .DueTasks}}
  <div class="li clickable" data-href="/maintenance/tasks/{{.ID}}">
    <div class="act-dot {{.PriorityDot}}"></div>
    <div class="li-text">
      <div class="li-title">{{.Title}}</div>
      <div class="li-sub">{{.InfraName}} · fällig {{.DueDate}}</div>
    </div>
    <span class="badge {{.PriorityClass}}">{{.Priority}}</span>
  </div>
  {{end}}
</div>
{{end}}

<div class="grid2">
  <!-- Wartungspläne -->
  <div class="card" id="plans-list">
    <div class="card-title">Wartungspläne <span class="card-action">{{.TotalPlans}} aktiv</span></div>
    {{range .Plans}}
    <div class="li">
      <div class="act-dot {{.PriorityDot}}"></div>
      <div class="li-text">
        <div class="li-title">{{.Name}}</div>
        <div class="li-sub">{{.InfraName}} · {{.IntervalLabel}} · nächste: {{.NextDue}}</div>
      </div>
      <span class="badge b-gray" style="font-size:10px">{{.TypeLabel}}</span>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Pläne vorhanden</div>
    {{end}}
  </div>

  <!-- Offene Aufträge -->
  <div class="card">
    <div class="card-title">Offene Aufträge
      <div style="display:flex;gap:6px">
        <a href="/maintenance?status=open" class="card-action">offen</a>
        <a href="/maintenance?status=in_progress" class="card-action">in Arbeit</a>
      </div>
    </div>
    {{range .Tasks}}
    <div class="li clickable" data-href="/maintenance/tasks/{{.ID}}">
      <div class="act-dot {{.PriorityDot}}"></div>
      <div class="li-text">
        <div class="li-title">{{.Title}}</div>
        <div class="li-sub">{{.InfraName}} · fällig {{.DueDate}}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span class="badge {{.StatusClass}}">{{.StatusLabel}}</span>
        <span class="badge {{.PriorityClass}}" style="font-size:9px">{{.Priority}}</span>
      </div>
    </div>
    {{else}}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Aufträge offen</div>
    {{end}}
  </div>
</div>
{{end}}

{{define "context-list"}}
{{range .DueTasks}}
<div class="act-item">
  <div class="act-dot {{.PriorityDot}}"></div>
  <div class="act-text">{{.Title}}</div>
  <span class="badge {{.StatusClass}}" style="font-size:9px">{{.StatusLabel}}</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
function pdhToken(){return document.cookie.split(';').find(c=>c.trim().startsWith('pdh_token='))?.split('=')[1] || localStorage.getItem('pdh_token') || ''}
function infraIcon(type){return ({building:'🏭',line:'🔄',plant:'⚙️',device:'🔌'}[type]||'📍')}
function flattenInfra(nodes, depth=0, out=[]){(nodes||[]).forEach(n=>{out.push({...n, depth}); flattenInfra(n.children||[], depth+1, out)}); return out}
async function loadInfraPicker(root){
  if(!root) return;
  const box=root.querySelector('[data-infra-tree]'); box.innerHTML='Lädt...';
  try{
    const res=await fetch('/api/v1/infrastructure/tree',{headers:{Authorization:'Bearer '+pdhToken()}});
    const json=await res.json(); const items=flattenInfra(json.data||[]);
    root.__infraItems=items;
    renderInfraPicker(root, items);
  }catch(e){box.innerHTML='<span style="color:var(--red)">Infrastruktur konnte nicht geladen werden</span>'}
}
function renderInfraPicker(root, items){
  const box=root.querySelector('[data-infra-tree]');
  if(!items.length){box.innerHTML='Keine Infrastruktur vorhanden'; return}
  box.innerHTML=items.map(i=>`<button type="button" data-infra-id="${i.id}" data-infra-name="${escapeHtml(i.name)}" onclick="selectInfra(this)" style="display:block;width:100%;text-align:left;background:none;border:0;color:var(--text);padding:5px 6px;border-radius:6px;cursor:pointer;margin-left:${i.depth*12}px">${infraIcon(i.type)} ${escapeHtml(i.name)} <span style="color:var(--muted);font-size:10px">${i.type}</span></button>`).join('');
}
function selectInfra(btn){const root=btn.closest('[data-infra-picker]'); document.getElementById(root.dataset.target).value=btn.dataset.infraId; document.getElementById(root.dataset.selectedLabel).textContent=btn.dataset.infraName}
function clearInfraPicker(root){document.getElementById(root.dataset.target).value=''; document.getElementById(root.dataset.selectedLabel).textContent='Keine Infrastruktur ausgewählt'}
function filterInfraPicker(input){const root=input.closest('[data-infra-picker]'); const q=input.value.toLowerCase(); renderInfraPicker(root,(root.__infraItems||[]).filter(i=>i.name.toLowerCase().includes(q)||String(i.type).includes(q)))}
function escapeHtml(s){return String(s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}
document.addEventListener('DOMContentLoaded',()=>document.querySelectorAll('[data-infra-picker]').forEach(loadInfraPicker));
</script>
{{end}}
