+--
+-- Zwei zusammengehoerige Ergaenzungen fuer die n8n-Anbindung:
+--
+-- 1) production_records: neue Erfassung von Stueckzahlen/Ausschuss/
+--    Zykluszeit pro Maschine (Infrastruktur-Eintrag) - gab es im System
+--    bisher nicht, ist die eigentliche "Produktionsdaten"-Tabelle.
+--    "source" unterscheidet manuell erfasste von importierten Datensaetzen.
+--
+-- 2) Generisches Integrations-Framework, wiederverwendbar fuer n8n oder
+--    jedes andere externe System:
+--    - integration_api_keys: Schluessel fuer eingehende Aufrufe (n8n -> PDH)
+--    - integration_webhooks: Ziel-URLs fuer ausgehende Ereignisse (PDH -> n8n)
+
+CREATE TABLE IF NOT EXISTS production_records (
+    id                 UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    infrastructure_id  UUID REFERENCES infrastructure(id),
+    recorded_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    quantity_good      INTEGER NOT NULL DEFAULT 0,
+    quantity_scrap     INTEGER NOT NULL DEFAULT 0,
+    cycle_time_seconds NUMERIC(10,2),
+    notes              TEXT,
+    source             VARCHAR(20) NOT NULL DEFAULT 'manual', -- manual | import | api
+    external_ref       VARCHAR(255), -- ID/Referenz im externen System, fuer Abgleich bei wiederholtem Import
+    created_by         UUID REFERENCES users(id),
+    created_at         TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE INDEX IF NOT EXISTS idx_production_records_infra ON production_records(infrastructure_id);
+CREATE INDEX IF NOT EXISTS idx_production_records_recorded_at ON production_records(recorded_at);
+CREATE INDEX IF NOT EXISTS idx_production_records_external_ref ON production_records(external_ref) WHERE external_ref IS NOT NULL;
+
+CREATE TABLE IF NOT EXISTS integration_api_keys (
+    id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    name         VARCHAR(255) NOT NULL,
+    key_hash     VARCHAR(64) NOT NULL UNIQUE,  -- sha256-Hex des eigentlichen Schluessels
+    key_prefix   VARCHAR(12) NOT NULL,          -- erste Zeichen zur Wiedererkennung in der UI
+    active       BOOLEAN NOT NULL DEFAULT true,
+    created_by   UUID REFERENCES users(id),
+    last_used_at TIMESTAMPTZ,
+    created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE TABLE IF NOT EXISTS integration_webhooks (
+    id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    name              VARCHAR(255) NOT NULL,
+    target_url        TEXT NOT NULL,
+    secret            VARCHAR(255) NOT NULL,
+    events            JSONB NOT NULL DEFAULT '[]',
+    active            BOOLEAN NOT NULL DEFAULT true,
+    created_by        UUID REFERENCES users(id),
+    last_triggered_at TIMESTAMPTZ,
+    last_status       VARCHAR(20),
+    last_error        TEXT,
+    created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+-- Neue Berechtigung fuer die Schnittstellen-Verwaltung (API-Keys/Webhooks),
+-- passend zum bestehenden Rollen-/Berechtigungskatalog aus Migration 045.
+INSERT INTO permissions (key, label, category) VALUES
+    ('integrations.manage', 'Schnittstellen (API-Keys/Webhooks) verwalten', 'System'),
+    ('production.view',     'Produktionsdaten ansehen',                    'Produktion'),
+    ('production.edit',     'Produktionsdaten erfassen',                   'Produktion')
+ON CONFLICT (key) DO NOTHING;
+
+-- Admin bekommt die neuen Berechtigungen automatisch mit (gleiches Muster
+-- wie in Migration 045: Admin startet mit allem, andere Rollen leer).
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM roles r CROSS JOIN permissions p
+WHERE r.key = 'admin' AND p.key IN ('integrations.manage', 'production.view', 'production.edit')
+ON CONFLICT DO NOTHING;
