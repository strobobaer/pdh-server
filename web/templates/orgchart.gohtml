{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Organigramm</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">Rollen-Hierarchie mit zugeordneten Benutzern · Karte auf eine andere Rolle ziehen, um sie umzustufen</p>
</div>

<p id="orgchart-error" style="display:none;color:var(--red);font-size:12px;margin-bottom:10px"></p>

<div style="display:flex;gap:14px;overflow-x:auto;padding-bottom:8px;align-items:flex-start">
  {{range .Columns}}
  <div class="card orgchart-column" data-role-key="{{.Key}}" data-can-assign="{{.CanAssign}}"
       style="min-width:220px;flex:0 0 220px;transition:outline .1s{{if not .CanAssign}};opacity:.55{{end}}"
       ondragover="orgchartDragOver(event, this)" ondragleave="orgchartDragLeave(event, this)" ondrop="orgchartDrop(event, this)">
    <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
      <span>{{.Label}}</span>
      <span style="font-size:10px;font-weight:400;color:var(--muted)" title="Rangstufe in der Hierarchie">Rang {{.Level}}</span>
    </div>
    <div style="font-size:11px;color:var(--muted);margin-bottom:10px">{{len .Users}} Benutzer</div>
    <div class="orgchart-users" style="display:flex;flex-direction:column;gap:6px;min-height:40px">
      {{range .Users}}
      <div class="orgchart-card" {{if .CanManage}}draggable="true" ondragstart="orgchartDragStart(event,'{{.ID}}')" ondragend="orgchartDragEnd(event)"{{end}}
           style="display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid var(--border);border-radius:8px;background:var(--bg3);{{if .CanManage}}cursor:grab{{else}}cursor:default{{end}}"
           title="{{.FullName}}{{if not .CanManage}} · Rang zu niedrig, um diesen Benutzer zu verschieben{{end}}">
        <div style="width:26px;height:26px;border-radius:50%;background:{{.AvatarBg}};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#fff;flex-shrink:0">{{.Initials}}</div>
        <div style="font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">{{.FullName}}</div>
        {{if $.CanManageRoles}}<a href="/users?permissions={{.ID}}" title="Einzelrechte bearbeiten" style="flex-shrink:0;color:var(--muted);display:flex" onclick="event.stopPropagation()"><i class="ti ti-shield-lock" style="font-size:14px"></i></a>{{end}}
      </div>
      {{end}}
      {{if not .Users}}<div style="font-size:12px;color:var(--muted);padding:8px 0">Keine Benutzer</div>{{end}}
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "scripts"}}
<script>
let orgchartDraggedUserID = null;

function orgchartDragStart(event, userID){
  orgchartDraggedUserID = userID;
  event.dataTransfer.effectAllowed = 'move';
  event.currentTarget.style.opacity = '.4';
}
function orgchartDragEnd(event){
  event.currentTarget.style.opacity = '';
  orgchartDraggedUserID = null;
}
function orgchartDragOver(event, column){
  if(column.dataset.canAssign !== 'true' || !orgchartDraggedUserID) return;
  event.preventDefault();
  column.style.outline = '2px solid var(--accent)';
}
function orgchartDragLeave(event, column){
  column.style.outline = '';
}
async function orgchartDrop(event, column){
  event.preventDefault();
  column.style.outline = '';
  const roleKey = column.dataset.roleKey;
  const userID = orgchartDraggedUserID;
  if(!userID || column.dataset.canAssign !== 'true') return;
  const errorBox = document.getElementById('orgchart-error');
  errorBox.style.display = 'none';
  try{
    const response = await fetch('/users/' + userID + '/role-web', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'role=' + encodeURIComponent(roleKey)
    });
    if(!response.ok) throw new Error((await response.text()) || ('HTTP ' + response.status));
    location.reload();
  }catch(error){
    errorBox.textContent = 'Zuweisung fehlgeschlagen: ' + error.message;
    errorBox.style.display = 'block';
  }
}
</script>
{{end}}
