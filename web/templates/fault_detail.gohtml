{{template "base" .}}

{{define "content"}}
{{$f := .Fault}}{{$open := not (or (eq $f.Status "resolved") (eq $f.Status "closed"))}}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
  {{template "icon-button" (dict "Action" "back" "Href" "/faults")}}
  <div style="flex:1;min-width:200px">
    <h1 style="font-size:18px;font-weight:600">{{$f.Title}}</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:2px">Erkannt {{$f.DetectedAgo}}{{if $f.InfraName}} · {{$f.InfraName}}{{end}}</p>
  </div>
  <span class="badge {{$f.SeverityClass}}" style="font-size:12px;padding:4px 12px">{{$f.Severity}}</span>
  <span class="badge {{$f.StatusClass}}" style="font-size:12px;padding:4px 12px">{{$f.StatusLabel}}</span>
</div>
<div id="archive-result" style="margin-bottom:10px"></div>
{{template "record-meta-slot" (dict "Module" "fault" "ID" $f.ID)}}
<div class="rec-tabs" role="tablist">
  <a class="rec-tab" data-tab="overview" href="?tab=overview"><i class="ti ti-layout-dashboard"></i> Übersicht</a>
  <a class="rec-tab" data-tab="edit" href="?tab=edit"><i class="ti ti-edit"></i> Bearbeiten</a>
  <a class="rec-tab" data-tab="work" href="?tab=work"><i class="ti ti-tool"></i> Maßnahmen & Ersatzteile</a>
  <a class="rec-tab" data-tab="time" href="?tab=time"><i class="ti ti-clock"></i> Zeit <b>{{len .TimeEntries}}</b></a>
  <a class="rec-tab" data-tab="copilot" href="?tab=copilot"><i class="ti ti-brain"></i> Copilot</a>
  <a class="rec-tab" data-tab="fields" href="?tab=fields"><i class="ti ti-forms"></i> Feldsätze</a>
  <a class="rec-tab" data-tab="docs" href="?tab=docs"><i class="ti ti-paperclip"></i> Dokumente</a>
  <a class="rec-tab" data-tab="links" href="?tab=links"><i class="ti ti-link"></i> Verknüpfungen</a>
  <a class="rec-tab" data-tab="history" href="?tab=history"><i class="ti ti-history"></i> Historie</a>
</div>

<!-- ── Übersicht ── -->
<div class="rec-pane" data-pane="overview">
{{template "work-do" (dict "Kind" "fault" "ID" $f.ID "Open" $open "Title" "Störung beheben" "Label" "Beheben & abschließen" "Icon" "ti-tool" "Due" $f.DueDate "DoneTitle" $f.StatusLabel "ArchiveURL" "/faults?view=archive")}}
{{if $f.TicketPending}}<div class="w11-infobar warning">Ticket wird angelegt, sobald die Störung einer Person oder Gruppe zugewiesen ist (Reiter „Bearbeiten“).</div>{{end}}
<div class="grid2" style="grid-template-columns:1fr 320px;gap:14px;align-items:start">
  <div>
    <div class="card">
      <div class="card-title">Symptome & Beschreibung</div>
      {{if $f.Description}}<p style="font-size:13px;margin-bottom:12px;line-height:1.6">{{$f.Description}}</p>{{end}}
      {{if $f.Symptoms}}
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        {{range $f.Symptoms}}
        <span style="background:var(--bg3);border:1px solid var(--border);padding:3px 10px;border-radius:20px;font-size:12px">{{.}}</span>
        {{end}}
      </div>
      {{end}}
      {{if not (or $f.Description $f.Symptoms)}}<p class="rec-sub">Keine Beschreibung</p>{{end}}
    </div>

    {{if $f.Resolution}}
    <div class="card" style="border-color:rgba(16,185,129,.3)">
      <div class="card-title"><i class="ti ti-check" style="color:var(--green)"></i> Gelöst</div>
      <p style="font-size:13px;margin-bottom:8px"><strong>Maßnahme:</strong> {{$f.Resolution}}</p>
      {{if $f.RootCause}}<p style="font-size:13px;color:var(--muted)"><strong>Grundursache:</strong> {{$f.RootCause}}</p>{{end}}
    </div>
    {{end}}
  </div>

  <div>
    <div class="card">
      <div class="card-title"><span>Details</span><a class="card-action rec-tab" data-tab="edit" href="?tab=edit" style="padding:0"><i class="ti ti-edit"></i> Bearbeiten</a></div>
      {{if $f.RecordImageURL}}
      <img src="{{$f.RecordImageURL}}" alt="Datensatzbild" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:4px;border:1px solid var(--stroke);margin-bottom:8px">
      {{end}}
      <dl class="w11-props">
        <dt>Status</dt><dd><span class="badge {{$f.StatusClass}}">{{$f.StatusLabel}}</span></dd>
        <dt>Schweregrad</dt><dd><span class="badge {{$f.SeverityClass}}">{{$f.Severity}}</span></dd>
        <dt>Termin</dt><dd>{{if $f.DueDate}}{{$f.DueDate}}{{else}}–{{end}}</dd>
        <dt>Verantwortlich</dt><dd>{{if $f.ResponsibleName}}{{$f.ResponsibleName}}{{else}}–{{end}}</dd>
        <dt>Zugewiesen</dt><dd>{{if $f.AssignedName}}{{$f.AssignedName}}{{else}}–{{end}}</dd>
        <dt>Infrastruktur</dt><dd>{{if $f.InfraName}}{{$f.InfraName}}{{else}}–{{end}}</dd>
        <dt>Kostenstelle</dt><dd>{{if $f.CostCenterNumber}}{{$f.CostCenterNumber}} – {{$f.CostCenterName}}{{else}}–{{end}}</dd>
        <dt>Erkannt</dt><dd>{{$f.DetectedAgo}}</dd>
      </dl>
    </div>
    <div class="card">
      <div class="card-title">Beteiligte</div>
      <div id="record-parties" hx-get="/records/fault/{{$f.ID}}/parties" hx-trigger="load" hx-swap="innerHTML"></div>
    </div>
  </div>
</div>
</div>

<!-- ── Bearbeiten (Einstellungs-Zeilen wie in Windows 11) ── -->
<div class="rec-pane" data-pane="edit">
  <div class="rec-edit">
    <div class="w11-group">Zuständigkeit</div>
    {{if $f.TicketPending}}<div class="w11-infobar warning">Das Ticket wird angelegt, sobald hier eine Person oder Gruppe zugewiesen ist.</div>{{end}}
    <div class="w11-row" data-save="/records/fault/{{$f.ID}}/people" data-label="Zuständigkeit">
      <i class="ti ti-users w11-row-icon"></i>
      <div class="w11-row-text"><b>Personen und Gruppe</b><span>Verantwortlich behält den Überblick, Zugewiesen macht die Arbeit.</span></div>
      <div class="w11-row-ctl">
        <div class="form-group"><label class="form-label">Verantwortlich</label>
          <select name="responsible_to" class="form-input"><option value="">Nicht gesetzt</option>{{range .Users}}<option value="{{.ID}}" {{if eq .ID $f.ResponsibleID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
        <div class="form-group"><label class="form-label">Zugewiesen</label>
          <select name="assigned_to" class="form-input"><option value="">Nicht zugewiesen</option>{{range .Users}}<option value="{{.ID}}" {{if eq .ID $f.AssignedID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
        <div class="form-group"><label class="form-label">Zugewiesene Gruppe</label>
          <select name="assigned_group_id" class="form-input" hx-get="/records/fault/{{$f.ID}}/group-options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"><option value="__keep__">Lädt…</option></select></div>
      </div>
    </div>
    <div class="w11-group">Zuordnung</div>
    <div class="w11-row" data-save="/api/v1/faults/{{$f.ID}}/due-date" data-label="Termin">
      <i class="ti ti-calendar w11-row-icon"></i>
      <div class="w11-row-text"><b>Termin</b><span>Bis wann die Störung behoben sein soll.</span></div>
      <div class="w11-row-ctl"><input name="due_date" type="date" class="form-input" value="{{$f.DueDateISO}}" aria-label="Termin"></div>
    </div>
    <div class="w11-row" data-save="/faults/{{$f.ID}}/infrastructure-web" data-label="Infrastruktur">
      <i class="ti ti-building-factory-2 w11-row-icon"></i>
      <div class="w11-row-text"><b>Infrastruktur</b><span>Anlage oder Bereich mit der Störung.</span></div>
      <div class="w11-row-ctl">{{template "infra-tree-picker" (dict "TargetID" "fault-detail-infra-id" "SelectedLabelID" "fault-detail-infra-selected" "Label" "Anlage / Bereich" "Value" $f.InfraID "SelectedLabel" $f.InfraName)}}</div>
    </div>
    <div class="w11-row" data-save="/api/v1/faults/{{$f.ID}}/cost-center" data-label="Kostenstelle">
      <i class="ti ti-coin w11-row-icon"></i>
      <div class="w11-row-text"><b>Kostenstelle</b><span>Auf welche Kostenstelle Material und Zeit gehen.</span></div>
      <div class="w11-row-ctl">{{template "cost-center-picker" (dict "Label" "Kostenstelle" "TargetID" "fault-cost-center-id" "Value" $f.CostCenterID)}}</div>
    </div>
    <div class="w11-actions">
      <div class="w11-infobar" role="status"></div>
      <button class="btn btn-primary" type="button" onclick="pdhRecSave(this)"><i class="ti ti-device-floppy"></i> Speichern</button>
    </div>
  </div>
</div>

<!-- ── Zeit ── -->
<div class="rec-pane" data-pane="time">
  <div class="rec-edit">
    <div class="w11-row">
      <i class="ti ti-clock w11-row-icon"></i>
      <div class="w11-row-text"><b>Zeiterfassung</b><span>{{if .RunningTime}}Läuft seit {{.RunningTime.StartedAt.Format "15:04"}}{{if .RunningTime.Description}} · {{.RunningTime.Description}}{{end}}{{else}}Startet deine Zeit für diese Störung.{{end}}</span></div>
      {{if .RunningTime}}
      <button class="btn" type="button" hx-post="/time/{{.RunningTime.ID}}/stop-web" hx-target="#time-result" hx-on::after-request="setTimeout(()=>location.reload(),1000)"><i class="ti ti-player-stop"></i> Zeit stoppen</button>
      {{else}}
      <button class="btn btn-primary" type="button" hx-post="/faults/{{$f.ID}}/time/start" hx-target="#time-result" hx-on::after-request="setTimeout(()=>location.reload(),1000)"><i class="ti ti-player-play"></i> Zeit erfassen</button>
      {{end}}
    </div>
    <div id="time-result"></div>
    <div class="w11-group">Zeiteinträge</div>
    {{range .TimeEntries}}
    <div class="w11-row"><i class="ti ti-clock-hour-4 w11-row-icon"></i><div class="w11-row-text"><b>{{if .Description}}{{.Description}}{{else}}Zeiteintrag{{end}}</b><span>{{.UserName}}</span></div><span style="font-size:13px">{{if .DurationMin}}{{.DurationMin}} min{{else}}läuft …{{end}}</span></div>
    {{else}}
    <div class="w11-infobar">Noch keine Zeiteinträge.</div>
    {{end}}
  </div>
</div>

<!-- ── Copilot ── -->
<div class="rec-pane" data-pane="copilot">
    {{if .Analysis}}
    <div class="card">
      <div class="card-title">
        <span><i class="ti ti-brain" style="color:var(--accent)"></i> Copilot-Analyse</span>
        <span style="font-size:11px;color:var(--muted)">Konfidenz: {{printf "%.0f" .Analysis.Confidence}}%</span>
      </div>
      <p style="font-size:13px;margin-bottom:14px;line-height:1.6;color:var(--muted)">{{.Analysis.Summary}}</p>
      {{if .Analysis.PossibleCauses}}
      <div style="margin-bottom:14px">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Mögliche Ursachen</div>
        {{range .Analysis.PossibleCauses}}
        <div class="li"><div class="act-dot d-amber"></div><div class="li-text">{{.}}</div></div>
        {{end}}
      </div>
      {{end}}
      {{if .Analysis.Steps}}
      <div>
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:8px">Entstörungsschritte</div>
        {{range .Analysis.Steps}}
        <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0">{{.Order}}</div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:500">{{.Title}}</div>
            <div style="font-size:12px;color:var(--muted);margin-top:2px">{{.Description}}</div>
            {{if .Command}}<code style="display:block;margin-top:6px;background:var(--bg3);padding:4px 8px;border-radius:5px;font-size:11px;color:#6ee7b7">{{.Command}}</code>{{end}}
          </div>
        </div>
        {{end}}
      </div>
      {{end}}
    </div>
    {{else}}
    <div class="card" style="text-align:center;padding:24px">
      <i class="ti ti-brain" style="font-size:32px;color:var(--muted);display:block;margin-bottom:10px"></i>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Noch keine Analyse vorhanden</p>
      <button class="btn btn-primary" type="button" hx-post="/faults/{{.Fault.ID}}/analyze" hx-target="#analyze-result" hx-indicator="#analyze-spinner"><i class="ti ti-brain"></i> Copilot analysieren lassen</button>
      <span id="analyze-spinner" class="htmx-indicator" style="margin-left:6px">...</span>
      <div id="analyze-result"></div>
    </div>
    {{end}}
    <div class="card">
      <div class="card-title"><i class="ti ti-brain" style="color:var(--accent)"></i> Copilot Chat</div>
      <div id="chat-messages" style="background:var(--bg3);border-radius:8px;padding:10px;min-height:180px;max-height:320px;overflow-y:auto;margin-bottom:10px;font-size:13px">
        <div style="color:var(--muted);font-style:italic;font-size:12px">Stelle Fragen zur Entstörung...</div>
      </div>
      <form hx-post="/faults/{{.Fault.ID}}/chat-web" hx-target="#chat-messages" hx-swap="beforeend" hx-on::before-request="appendUserMsg(this)" style="display:flex;gap:8px">
        <input name="message" id="chat-input" class="form-input" placeholder="z.B. Was könnte die Ursache sein?" style="font-size:12px" autocomplete="off">
        <button class="btn" type="submit" aria-label="Senden"><i class="ti ti-send"></i></button>
      </form>
    </div>
</div>

<!-- ── Maßnahmen & Ersatzteile ── -->
<div class="rec-pane" data-pane="work">
    <!-- Durchgeführte Maßnahmen -->
    <div class="card">
      <div class="card-title">Durchgeführte Maßnahmen</div>
      <div id="fault-actions-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      <div style="display:flex;gap:8px">
        <input data-suggest="action" id="fa-new-action" class="form-input" placeholder="z.B. Sicherung getauscht" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addFaultAction();}">
        <button type="button" class="btn" onclick="addFaultAction()"><i class="ti ti-plus"></i></button>
      </div>
    </div>

    <!-- Ersatzteile: Merkliste (Buchung erst beim Lösen) bzw. gebuchte Teile -->
    <div class="card">
      <div class="card-title">{{if .Fault.Resolution}}Verwendete Ersatzteile{{else}}Ersatzteile für die Reparatur{{end}}</div>
      {{if not .Fault.Resolution}}<p style="font-size:11px;color:var(--muted);margin-bottom:8px">Reservierte Teile werden sofort vom Lagerplatz abgebucht und beim Lösen zum Verbrauch. Nicht benötigte Mengen zurückbuchen.</p>{{end}}
      <div id="fault-parts-usage-list" style="margin-bottom:10px;font-size:12px;color:var(--muted)">Lade...</div>
      {{if not .Fault.Resolution}}<button type="button" class="btn" onclick="openFaultPartModal()"><i class="ti ti-package"></i> Ersatzteil reservieren</button>{{end}}
    </div>

    {{if not .Fault.Resolution}}
    {{template "work-part-dialog" (dict "ID" "fault-part-modal" "P" "fa" "Filter" "filterFaultParts" "Book" "bookFaultPart" "Close" "closeFaultPartModal")}}
    {{end}}
</div>

<!-- ── Feldsätze ── -->
<div class="rec-pane" data-pane="fields">
  <div class="card">{{template "record-fields-slot" (dict "Module" "fault" "ID" .Fault.ID)}}</div>
</div>

<!-- ── Dokumente ── -->
<div class="rec-pane" data-pane="docs">
    <!-- Anhänge -->
    <div class="card">
      <div class="card-title"><i class="ti ti-paperclip"></i> Fotos & Dokumente</div>
      <div id="attachments-{{.Fault.ID}}" data-attach-ref="fault:{{.Fault.ID}}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;min-height:20px"></div>
      {{template "work-upload-buttons" (dict "Module" "fault" "ID" .Fault.ID)}}
    </div>
</div>

<!-- ── Verknüpfungen ── -->
<div class="rec-pane" data-pane="links">{{template "record-links-slot" (dict "Module" "fault" "ID" .Fault.ID)}}</div>

<!-- ── Historie ── -->
<div class="rec-pane" data-pane="history">{{template "record-history" .History}}</div>
{{end}}

{{define "context-list"}}
{{range .SimilarFaults}}
<a class="act-item" href="/faults/{{.ID}}" title="{{if .Resolution}}Lösung: {{.Resolution}}{{else}}gelöst{{end}}" style="color:inherit;text-decoration:none">
  <div class="act-dot d-blue"></div>
  <div class="act-text">{{.Title}}</div>
  <span style="font-size:10px;color:var(--green)" title="Ähnlichkeit">{{if .Percent}}{{.Percent}} %{{else}}gelöst{{end}}</span>
</a>
{{end}}
{{end}}

{{block "scripts" .}}
{{template "work-style"}}
{{template "work-edit-script"}}
<script>

function appendUserMsg(form) {
  const input = form.querySelector('[name=message]');
  const msg = input.value.trim();
  if(!msg) return;
  const el = document.getElementById('chat-messages');
  el.innerHTML += '<div style="margin-bottom:8px"><div style="font-size:10px;color:var(--muted);margin-bottom:2px">Du</div><div style="color:var(--accent);font-size:12px">'+msg+'</div></div>';
  el.scrollTop = el.scrollHeight;
  input.value = '';
}
document.body.addEventListener('htmx:afterSettle', function() {
  const el = document.getElementById('chat-messages');
  if(el) el.scrollTop = el.scrollHeight;
});

// ── Durchgeführte Maßnahmen + Ersatzteilverwendung ──────────────
const FAULT_ID = '{{.Fault.ID}}';
const FAULT_RESOLVED = {{if .Fault.Resolution}}true{{else}}false{{end}};
let faPartsCache = null;

function escFa(s){return String(s||'').replace(/[&<>'"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'})[c];});}

async function loadFaultActions(){
  const box = document.getElementById('fault-actions-list');
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/actions', {credentials:'same-origin'});
    const json = await res.json();
    const actions = json.data || json || [];
    box.innerHTML = actions.length ? actions.map(function(a){
      const t = new Date(a.created_at);
      const timeStr = t.toLocaleString('de-DE', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(a.description)+'</div><div class="li-sub">'+timeStr+' · '+escFa(a.created_by_name)+'</div></div></div>';
    }).join('') : '<div style="padding:4px 0">Noch keine Maßnahmen erfasst</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}
async function addFaultAction(){
  const input = document.getElementById('fa-new-action');
  const description = input.value.trim();
  if(!description) return;
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/actions', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({description:description})
    });
    const json = await res.json();
    if(!res.ok) throw new Error(json.error||'Fehler');
    input.value='';
    loadFaultActions();
  }catch(e){ alert('Fehler: '+e.message); }
}

async function loadFaultPartsUsage(){
  const box = document.getElementById('fault-parts-usage-list');
  try{
    if(FAULT_RESOLVED){
      const res = await fetch('/api/v1/faults/'+FAULT_ID+'/parts-usage', {credentials:'same-origin'});
      const json = await res.json();
      const movements = json.data || json || [];
      box.innerHTML = movements.length ? movements.map(function(m){
        return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(m.part_name)+' <span style="color:var(--muted)">('+escFa(m.part_number)+')</span></div><div class="li-sub">'+m.qty+' Stk · '+escFa(m.created_by_name)+'</div></div></div>';
      }).join('') : '<div style="padding:4px 0">Keine Ersatzteile verwendet</div>';
      return;
    }
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts', {credentials:'same-origin'});
    const json = await res.json();
    const pending = json.data || json || [];
    box.innerHTML = pending.length ? pending.map(function(p){
      return '<div class="li"><div class="li-text"><div class="li-title" style="font-size:13px">'+escFa(p.part_name)+' <span style="color:var(--muted)">('+escFa(p.part_number)+')</span></div><div class="li-sub">'+p.qty+' Stk · '+escFa(p.storage_name)+''+pdhReservedTag(p,'fault',FAULT_ID,'loadFaultPartsUsage')+'</div></div><button type="button" class="btn" style="font-size:11px;color:var(--red)" onclick="removePendingPart(THISID)"><i class="ti ti-x"></i></button></div>'.replace('THISID', "'"+p.id+"'");
    }).join('') : '<div style="padding:4px 0">Noch keine Ersatzteile reserviert</div>';
  }catch(e){ box.innerHTML = '<span style="color:var(--red)">Fehler beim Laden</span>'; }
}

async function removePendingPart(id){
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts/'+id, {method:'DELETE', credentials:'same-origin'});
    const json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    loadFaultPartsUsage();
  }catch(e){ alert('Fehler beim Entfernen: '+e.message); }
}

async function loadFaultPartsCache(){
  if(faPartsCache) return faPartsCache;
  const res = await fetch('/api/v1/inventory/', {credentials:'same-origin'});
  const json = await res.json();
  faPartsCache = json.data || json || [];
  return faPartsCache;
}

async function loadStorageFlatOptions(selectEl){
  try{
    const res = await fetch('/api/v1/storage/', {credentials:'same-origin'});
    const json = await res.json();
    const tree = json.data || json;
    const options = [];
    function walk(nodes, prefix){
      (nodes||[]).forEach(function(n){
        const label = prefix ? prefix+' > '+n.name : n.name;
        options.push({id:n.id, label:label});
        if(n.children && n.children.length) walk(n.children, label);
      });
    }
    walk(Array.isArray(tree) ? tree : (tree.children||[]), '');
    selectEl.innerHTML = '<option value="">Lagerort wählen...</option>' + options.map(function(o){return '<option value="'+o.id+'">'+escFa(o.label)+'</option>';}).join('');
  }catch(e){
    selectEl.innerHTML = '<option value="">Fehler beim Laden</option>';
  }
}

function openFaultPartModal(){
  document.getElementById('fault-part-modal').style.display='flex';
  document.getElementById('fa-part-search').value='';
  document.getElementById('fa-part-id').value='';
  document.getElementById('fa-part-selected').textContent='';
  document.getElementById('fa-part-results').style.display='none';
  document.getElementById('fa-part-error').style.display='none';
  document.getElementById('fa-part-qty').value='1';
  loadStorageFlatOptions(document.getElementById('fa-part-location'));
}
function closeFaultPartModal(){ document.getElementById('fault-part-modal').style.display='none'; }

async function filterFaultParts(){
  const q = document.getElementById('fa-part-search').value.trim().toLowerCase();
  const box = document.getElementById('fa-part-results');
  if(!q){ box.style.display='none'; return; }
  const parts = await loadFaultPartsCache();
  const matches = parts.filter(function(p){
    return (p.name||'').toLowerCase().includes(q) || (p.part_number||'').toLowerCase().includes(q);
  }).slice(0,20);
  box.innerHTML = matches.length ? matches.map(function(p){
    return '<div style="padding:6px 8px;cursor:pointer;font-size:12px;border-bottom:1px solid var(--border)" onclick="selectFaultPart(\''+p.id+'\',\''+escFa(p.name).replace(/'/g,"\\'")+'\')">'+escFa(p.name)+' <span style="color:var(--muted)">('+escFa(p.part_number)+')</span></div>';
  }).join('') : '<div style="padding:6px 8px;font-size:12px;color:var(--muted)">Keine Treffer</div>';
  box.style.display='block';
}
function selectFaultPart(id,label){
  document.getElementById('fa-part-id').value=id;
  document.getElementById('fa-part-selected').textContent='Ausgewählt: '+label;
  document.getElementById('fa-part-results').style.display='none';
  document.getElementById('fa-part-search').value='';
}

async function bookFaultPart(){
  const partId = document.getElementById('fa-part-id').value;
  const locationId = document.getElementById('fa-part-location').value;
  const qty = parseFloat(document.getElementById('fa-part-qty').value);
  const errEl = document.getElementById('fa-part-error');
  errEl.style.display='none';
  if(!partId){ errEl.textContent='Bitte ein Ersatzteil auswählen'; errEl.style.display='block'; return; }
  if(!locationId){ errEl.textContent='Bitte einen Lagerort auswählen'; errEl.style.display='block'; return; }
  if(!qty || qty<=0){ errEl.textContent='Bitte eine gültige Menge angeben'; errEl.style.display='block'; return; }
  try{
    const res = await fetch('/api/v1/faults/'+FAULT_ID+'/pending-parts', {
      method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({part_id:partId, storage_node_id:locationId, qty:qty})
    });
    const json = await res.json();
    if(!res.ok || json.success===false) throw new Error(json.error || ('HTTP '+res.status));
    closeFaultPartModal();
    loadFaultPartsUsage();
  }catch(e){ errEl.textContent='Fehler: '+e.message; errEl.style.display='block'; }
}

if(document.readyState !== 'loading'){ loadFaultActions(); loadFaultPartsUsage(); }
else document.addEventListener('DOMContentLoaded', function(){ loadFaultActions(); loadFaultPartsUsage(); });
</script>
{{end}}
