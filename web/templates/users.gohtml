{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Benutzerverwaltung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.TotalUsers}} Benutzer · {{.ActiveUsers}} aktiv</p>
  </div>
  {{template "icon-button-toolbar" (dict
    "Class" "end"
    "Label" "Benutzer-Aktionen"
    "Items" (list
      (dict "Action" "new" "ShowLabel" true "Label" "Neuer Benutzer" "OnClick" "openNewUserModal()")
    )
  )}}
</div>

<!-- Benutzer erstellen und bearbeiten -->
<div id="user-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:300;align-items:center;justify-content:center;padding:18px" onclick="if(event.target===this)closeUserModal()">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;width:min(760px,100%);max-height:calc(100dvh - 36px);overflow:auto;padding:20px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <h2 id="user-modal-title" style="font-size:17px;margin:0">Benutzer anlegen</h2>
      <button type="button" class="btn-icon" aria-label="Schließen" title="Schließen" onclick="closeUserModal()"><i class="ti ti-x"></i></button>
    </div>
    <form id="user-form" onsubmit="return submitUserForm(event)">
      <input type="hidden" name="user_id">
      <div class="card-title">Zugang und Kontaktdaten</div>
      <div class="grid2">
        <div class="form-group"><label class="form-label" for="uf-first">Vorname</label><input id="uf-first" name="first_name" class="form-input" required></div>
        <div class="form-group"><label class="form-label" for="uf-last">Nachname</label><input id="uf-last" name="last_name" class="form-input" required></div>
        <div class="form-group"><label class="form-label" for="uf-username">Benutzername</label><input id="uf-username" name="username" class="form-input" required autocomplete="username"></div>
        <div class="form-group"><label class="form-label" for="uf-email">E-Mail</label><input id="uf-email" name="email" type="email" class="form-input" required autocomplete="email"></div>
        <div class="form-group"><label class="form-label" for="uf-nextcloud">Nextcloud-Benutzer-ID</label><input id="uf-nextcloud" name="nextcloud_user_id" class="form-input" placeholder="Optional, für SSO-Verknüpfung"></div>
        <div class="form-group"><label class="form-label" for="uf-password">Passwort <span id="password-help" style="color:var(--muted);font-weight:400">(Pflichtfeld)</span></label><input id="uf-password" name="password" type="password" class="form-input" minlength="8" autocomplete="new-password"></div>
        <div class="form-group"><label class="form-label" for="uf-phone">Telefon</label><input id="uf-phone" name="phone" class="form-input" autocomplete="tel"></div>
      </div>

      <div class="card-title" style="margin-top:14px">Rolle und Zugriff</div>
      <div class="grid2">
        <div class="form-group"><label class="form-label" for="uf-role">Rolle</label>
          <select id="uf-role" name="role" class="form-input" required>{{range .Roles}}<option value="{{.Key}}">{{.Label}}</option>{{end}}</select>
        </div>
        <div class="form-group"><label class="form-label" for="uf-department">Abteilung</label><input id="uf-department" name="department" class="form-input"></div>
        <div class="form-group"><label class="form-label" for="uf-rfid">RFID-Karte</label><input id="uf-rfid" name="rfid_uid" class="form-input" placeholder="UID oder Karte scannen"></div>
        <label class="form-group" style="display:flex;align-items:center;gap:8px;margin:0"><input type="checkbox" name="is_system_user"> Systemnutzer (dauerhaft angemeldet)</label>
      </div>

      <div class="card-title" style="margin-top:14px">Schicht-Qualifikationen</div>
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 14px;font-size:13px">
        <label><input type="checkbox" name="on_call_duty"> Bereitschaft</label>
        <label><input type="checkbox" name="sharpening"> Schärferei</label>
        <label><input type="checkbox" name="heating_fill"> Heizungsbefüllung</label>
        <label><input type="checkbox" name="shift_leader"> Schichtleiter</label>
      </div>
      <p id="user-form-error" role="alert" style="display:none;color:var(--red);font-size:12px;margin:12px 0 0"></p>
      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px">
        <button type="button" class="btn" onclick="closeUserModal()">Abbrechen</button>
        <button type="submit" class="btn btn-primary" id="user-save-button"><i class="ti ti-device-floppy"></i> Speichern</button>
      </div>
    </form>
  </div>
</div>

<!-- Filter -->
<div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">
  <a href="/users" class="btn {{if eq .Filter ""}}btn-primary{{end}}" style="font-size:12px;padding:5px 12px">Alle</a>
  <a href="/users?role=technician" class="btn {{if eq .Filter "technician"}}btn-primary{{end}}" style="font-size:12px;padding:5px 12px">🔧 Techniker</a>
  <a href="/users?role=manager" class="btn {{if eq .Filter "manager"}}btn-primary{{end}}" style="font-size:12px;padding:5px 12px">📋 Manager</a>
  <a href="/users?role=worker" class="btn {{if eq .Filter "worker"}}btn-primary{{end}}" style="font-size:12px;padding:5px 12px">👷 Mitarbeiter</a>
  <a href="/users?role=admin" class="btn {{if eq .Filter "admin"}}btn-primary{{end}}" style="font-size:12px;padding:5px 12px">👑 Admin</a>
</div>

<!-- Benutzer Tabelle -->
<div class="card" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Benutzer</th>
        <th>Rolle</th>
        <th>Abteilung</th>
        <th>Kontakt</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="user-tbody">
    {{range .Users}}
    <tr id="user-row-{{.ID}}">
      <td>
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:34px;height:34px;border-radius:50%;background:{{.AvatarBg}};display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:#fff;flex-shrink:0">{{.Initials}}</div>
          <div>
            <div style="font-weight:500">{{.FullName}}</div>
            <div style="font-size:11px;color:var(--muted)">@{{.Username}}</div>
          </div>
        </div>
      </td>
      <td><span class="badge {{.RoleClass}}">{{.RoleLabel}}</span>{{if .IsSystemUser}} <span class="badge b-blue" title="Bleibt dauerhaft eingeloggt"><i class="ti ti-device-desktop"></i> System</span>{{end}}{{if .RFIDUID}} <span class="badge b-gray" title="RFID-Karte hinterlegt"><i class="ti ti-credit-card"></i></span>{{end}}</td>
      <td style="font-size:13px;color:var(--muted)">{{.Department}}</td>
      <td style="font-size:12px">
        <div>{{.Email}}</div>
        {{if .Phone}}<div style="color:var(--muted)">{{.Phone}}</div>{{end}}
      </td>
      <td>
        {{if .Active}}
        <span style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--green)"><div style="width:7px;height:7px;border-radius:50%;background:var(--green)"></div>Aktiv</span>
        {{else}}
        <span style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted)"><div style="width:7px;height:7px;border-radius:50%;background:var(--muted)"></div>Inaktiv</span>
        {{end}}
      </td>
      <td>
        <div style="position:relative">
          {{template "icon-button" (dict "Action" "more" "OnClick" (printf "toggleMenu('umenu-%s')" .ID))}}
          <div id="umenu-{{.ID}}" style="display:none;position:absolute;right:0;top:28px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:6px;min-width:160px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.3)">
            <button type="button" class="menu-item" onclick="editUser(this);closeMenu('umenu-{{.ID}}')"
              data-id="{{.ID}}" data-first-name="{{.FirstName}}" data-last-name="{{.LastName}}"
              data-username="{{.Username}}" data-email="{{.Email}}" data-role="{{.RoleValue}}" data-nextcloud-user-id="{{.NextcloudUserID}}"
              data-department="{{.Department}}" data-phone="{{.Phone}}" data-rfid="{{.RFIDUID}}"
              data-system-user="{{.IsSystemUser}}" data-on-call="{{.OnCallDuty}}"
              data-sharpening="{{.Sharpening}}" data-heating-fill="{{.HeatingFill}}" data-shift-leader="{{.ShiftLeader}}"><i class="ti ti-edit"></i>Bearbeiten</button>
            <button class="menu-item" hx-post="/users/{{.ID}}/role-web" hx-target="#user-row-{{.ID}}" hx-swap="outerHTML" hx-vals='{"role":"admin"}' onclick="closeMenu('umenu-{{.ID}}')"><i class="ti ti-crown"></i>Admin machen</button>
            {{if .Active}}
            <button class="menu-item menu-danger" hx-delete="/users/{{.ID}}/deactivate-web" hx-target="#user-row-{{.ID}}" hx-swap="outerHTML" hx-confirm="Benutzer deaktivieren?" onclick="closeMenu('umenu-{{.ID}}')"><i class="ti ti-user-off"></i>Deaktivieren</button>
            {{end}}
          </div>
        </div>
      </td>
    </tr>
    {{else}}
    <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:32px">Keine Benutzer gefunden</td></tr>
    {{end}}
    </tbody>
  </table>
</div>

{{end}}

{{define "context-list"}}
{{range .RoleStats}}
<div class="act-item">
  <div style="font-size:13px">{{.Icon}}</div>
  <div class="act-text">{{.Label}}</div>
  <span style="font-size:11px;color:var(--muted)">{{.Count}}</span>
</div>
{{end}}
{{end}}

{{block "scripts" .}}
<script>
function toggleMenu(id){const m=document.getElementById(id);m.style.display=m.style.display==='none'?'block':'none';}
function closeMenu(id){document.getElementById(id).style.display='none';}
document.addEventListener('click',e=>{
  if(!e.target.closest('[onclick*="toggleMenu"]')&&!e.target.closest('[id^="umenu-"]'))
    document.querySelectorAll('[id^="umenu-"]').forEach(m=>m.style.display='none');
});

const userForm = document.getElementById('user-form');
const userModal = document.getElementById('user-modal');
const userPassword = userForm.elements.namedItem('password');
const userPasswordHelp = document.getElementById('password-help');

function openNewUserModal(){
  userForm.reset();
  userForm.elements.namedItem('user_id').value = '';
  userForm.elements.namedItem('role').value = userForm.elements.namedItem('role').options[0]?.value || '';
  userPassword.required = true;
  userPasswordHelp.textContent = '(Pflichtfeld, mindestens 8 Zeichen)';
  document.getElementById('user-modal-title').textContent = 'Benutzer anlegen';
  document.getElementById('user-save-button').innerHTML = '<i class="ti ti-device-floppy"></i> Benutzer anlegen';
  document.getElementById('user-form-error').style.display = 'none';
  userModal.style.display = 'flex';
  userForm.elements.namedItem('first_name').focus();
}

function editUser(button){
  openNewUserModal();
  const data = button.dataset;
  userForm.elements.namedItem('user_id').value = data.id || '';
  userForm.elements.namedItem('first_name').value = data.firstName || '';
  userForm.elements.namedItem('last_name').value = data.lastName || '';
  userForm.elements.namedItem('username').value = data.username || '';
  userForm.elements.namedItem('email').value = data.email || '';
  userForm.elements.namedItem('nextcloud_user_id').value = data.nextcloudUserId || '';
  userForm.elements.namedItem('role').value = data.role || '';
  userForm.elements.namedItem('department').value = data.department || '';
  userForm.elements.namedItem('phone').value = data.phone || '';
  userForm.elements.namedItem('rfid_uid').value = data.rfid || '';
  ['is_system_user','on_call_duty','sharpening','heating_fill','shift_leader'].forEach(function(name){
    userForm.elements.namedItem(name).checked = dataFieldFor(name, data) === 'true';
  });
  userPassword.required = false;
  userPassword.value = '';
  userPasswordHelp.textContent = '(leer lassen, um das Passwort beizubehalten)';
  document.getElementById('user-modal-title').textContent = 'Benutzer bearbeiten';
  document.getElementById('user-save-button').innerHTML = '<i class="ti ti-device-floppy"></i> Änderungen speichern';
}

function dataFieldFor(name, data){
  const fields = {
    is_system_user:'systemUser', on_call_duty:'onCall', sharpening:'sharpening',
    heating_fill:'heatingFill', shift_leader:'shiftLeader'
  };
  return data[fields[name]] || 'false';
}

function closeUserModal(){
  userModal.style.display = 'none';
  userForm.reset();
}

async function submitUserForm(event){
  event.preventDefault();
  if(!userForm.reportValidity()) return false;
  const button = document.getElementById('user-save-button');
  const errorBox = document.getElementById('user-form-error');
  button.disabled = true;
  errorBox.style.display = 'none';
  try{
    const response = await fetch('/users/save-web', {method:'POST',credentials:'same-origin',body:new FormData(userForm)});
    if(!response.ok) throw new Error((await response.text()) || ('HTTP '+response.status));
    closeUserModal();
    location.reload();
  }catch(error){
    errorBox.textContent = 'Speichern fehlgeschlagen: ' + error.message;
    errorBox.style.display = 'block';
  }finally{
    button.disabled = false;
  }
  return false;
}
</script>
{{end}}
