<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>PDH · Übersicht</title>
<style>
:root{color-scheme:dark;--bg:#101512;--surface:#19211c;--surface-2:#222d26;--border:#35443a;--text:#f1f5f2;--muted:#a2b0a6;--green:#2b8a57;--blue:#277da1;--red:#bd4747;--amber:#c48b22;--focus:#b6e3c6;font-family:"Aptos","Segoe UI",sans-serif}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text)}
body{display:flex;flex-direction:column;overflow:hidden}
button,input,textarea,select{font:inherit}
button{color:inherit}
header{min-height:74px;padding:12px 20px;display:flex;align-items:center;gap:16px;background:var(--surface);border-bottom:1px solid var(--border)}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.brand-mark{width:42px;height:42px;display:grid;place-items:center;background:var(--green);color:#fff;font-size:20px;font-weight:800;border-radius:7px;flex:none}
h1{font-size:21px;line-height:1.15;margin:0;font-weight:700}
.subtitle{margin-top:4px;color:var(--muted);font-size:13px}
.header-meta{margin-left:auto;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
.header-button,.action-button{min-height:48px;border:1px solid var(--border);border-radius:7px;background:var(--surface-2);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;text-decoration:none;cursor:pointer;font-weight:650;white-space:nowrap}
.header-button:hover,.action-button:hover{filter:brightness(1.14)}
.header-button:focus-visible,.action-button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
main{min-height:0;flex:1;display:flex;flex-direction:column;padding:14px 18px 18px;gap:10px}
.toolbar{min-height:40px;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}
#load-state{margin-left:auto}
#board-wrap{min-height:0;flex:1;overflow:auto;border:1px solid var(--border);border-radius:7px;background:var(--surface);overscroll-behavior:contain}
table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:14px}
thead{position:sticky;top:0;z-index:2;background:var(--surface-2)}
th{text-align:left;color:var(--muted);font-size:12px;font-weight:700;padding:12px 10px;border-bottom:1px solid var(--border)}
td{padding:9px 10px;border-bottom:1px solid var(--border);vertical-align:middle;overflow-wrap:anywhere}
tr:last-child td{border-bottom:0}
tbody tr:hover{background:rgba(255,255,255,.035)}
th:nth-child(1){width:110px}th:nth-child(2){width:120px}th:nth-child(4){width:120px}th:nth-child(5){width:170px}th:nth-child(6){width:380px}
.kind{display:inline-flex;padding:5px 7px;border-radius:5px;background:#254b43;color:#bce8d5;font-weight:700;font-size:12px}
.kind.ticket{background:#214b61;color:#b7e4f5}.kind.maintenance{background:#614719;color:#f3dcaa}.kind.task{background:#493d5a;color:#e1d1f4}
.item-title{font-weight:700}.item-sub{font-size:12px;color:var(--muted);margin-top:3px}.date{white-space:nowrap;font-weight:650}.date.overdue{color:#ff8989}.date.none{color:var(--muted);font-weight:400}
.status{color:var(--muted)}.priority{font-size:12px;font-weight:700;text-transform:uppercase}.priority.critical,.priority.high{color:#ff9999}.priority.medium{color:#f0cf81}.priority.low{color:#a9c9b6}
.action-set{display:flex;gap:6px;flex-wrap:wrap}.action-button{min-height:46px;padding:0 11px;font-size:13px}.accept{background:#24583d;border-color:#397b55}.finish{background:#20576a;border-color:#347890}.discard{background:#5b3030;border-color:#854545}.wait{background:#594817;border-color:#856e2a}
.empty,.error{padding:30px;text-align:center;color:var(--muted)}
dialog{width:min(520px,calc(100vw - 28px));max-height:calc(100dvh - 24px);padding:0;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--text);box-shadow:0 18px 60px #0008}
dialog::backdrop{background:#0009}.dialog-head{padding:17px 19px;border-bottom:1px solid var(--border)}.dialog-head h2{font-size:18px;margin:0}.dialog-body{padding:17px 19px;display:grid;gap:13px;overflow:auto}.dialog-body label{display:grid;gap:6px;font-size:13px;font-weight:650}.dialog-body input,.dialog-body textarea,.dialog-body select{width:100%;min-height:48px;padding:10px 11px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text)}.dialog-body textarea{min-height:96px;resize:vertical}.required-hint{color:var(--muted);font-weight:400;font-size:12px}.dialog-actions{padding:12px 19px 17px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--border)}.dialog-actions .action-button{min-width:110px}.hidden{display:none!important}
@media(max-width:1050px){main{padding:10px}header{padding:10px 12px}table{font-size:13px}th:nth-child(5){width:140px}th:nth-child(6){width:330px}.action-button{font-size:12px;padding:0 8px}}
@media(max-width:760px){header{min-height:64px}.brand-mark{width:38px;height:38px}h1{font-size:18px}.subtitle,#updated-at{display:none}.header-meta{gap:6px}.header-button{min-height:46px;padding:0 10px;font-size:12px}main{padding:8px}.toolbar{min-height:32px}table{min-width:980px}}
</style>
</head>
<body>
<header>
  <div class="brand"><div class="brand-mark">P</div><div><h1>PDH · Leitstand</h1><div class="subtitle">Störungen · Tickets · Wartungen · Aufgaben</div></div></div>
  <div class="header-meta"><span id="updated-at">Wird geladen</span>
    <button class="header-button" type="button" id="fullscreen-button" title="Vollbild umschalten"><span aria-hidden="true">⛶</span> Vollbild</button>
    <a class="header-button" href="/login" title="In den normalen PDH-Modus wechseln"><span aria-hidden="true">↪</span> Anmelden</a>
  </div>
</header>
<main>
  <div class="toolbar"><strong>Offene Vorgänge</strong><span id="item-count">0 Einträge</span><span id="load-state" role="status" aria-live="polite"></span></div>
  <div id="board-wrap">
    <table aria-label="Chronologische Übersicht aller offenen Vorgänge">
      <thead><tr><th>Bereich</th><th>Fälligkeit</th><th>Vorgang</th><th>Priorität</th><th>Status</th><th>Aktion</th></tr></thead>
      <tbody id="board-body"><tr><td colspan="6" class="empty">Übersicht wird geladen …</td></tr></tbody>
    </table>
  </div>
</main>
<dialog id="action-dialog">
  <form id="action-form">
    <div class="dialog-head"><h2 id="dialog-title">Vorgang bearbeiten</h2></div>
    <div class="dialog-body">
      <p id="dialog-item" class="item-sub"></p>
      <label id="worker-field" class="hidden">Zuständiger Mitarbeiter <span class="required-hint">Pflichtfeld</span>
        <select id="assigned-to" name="assigned_to" required><option value="">Mitarbeiter auswählen …</option></select>
      </label>
      <label id="date-field" class="hidden">Wiedervorlage am <span class="required-hint">Pflichtfeld</span>
        <input id="follow-up-date" type="date" name="follow_up_date">
      </label>
      <label>Kommentar <span class="required-hint">Pflichtfeld, mindestens 8 Zeichen</span>
        <textarea id="comment" name="comment" minlength="8" maxlength="1000" required placeholder="Was wurde entschieden oder erledigt?"></textarea>
      </label>
      <label id="parts-field" class="hidden" style="display:flex;align-items:center;gap:10px">
        <input id="no-parts" type="checkbox" name="no_parts_needed" style="width:22px;min-height:22px">
        Keine Ersatzteile benötigt
      </label>
      <label>RFID-Karte zur Bestätigung <span class="required-hint">Pflichtfeld</span>
        <input id="rfid-uid" name="rfid_uid" type="password" autocomplete="off" required placeholder="Karte scannen">
      </label>
    </div>
    <div class="dialog-actions">
      <button class="action-button" type="button" id="cancel-action">Abbrechen</button>
      <button class="action-button finish" type="submit" id="submit-action">Bestätigen</button>
    </div>
  </form>
</dialog>
<script>
(function(){
  const body = document.getElementById('board-body');
  const dialog = document.getElementById('action-dialog');
  const form = document.getElementById('action-form');
  const workerField = document.getElementById('worker-field');
  const dateField = document.getElementById('date-field');
  const partsField = document.getElementById('parts-field');
  const workerSelect = document.getElementById('assigned-to');
  const dateInput = document.getElementById('follow-up-date');
  const commentInput = document.getElementById('comment');
  const rfidInput = document.getElementById('rfid-uid');
  const loadState = document.getElementById('load-state');
  const actionNames = {accept:'Annehmen',done:'Fertig',discard:'Verwerfen',wait:'Warten'};
  let current = null;
  let workers = [];

  function setOptions(options){
    workerSelect.replaceChildren(new Option('Mitarbeiter auswählen …',''));
    options.forEach(function(worker){workerSelect.add(new Option(worker.name,worker.id));});
  }

  function createCell(text, className){
    const cell = document.createElement('td');
    if(className) cell.className = className;
    cell.textContent = text;
    return cell;
  }

  function openAction(item, action){
    current = {item:item,action:action};
    document.getElementById('dialog-title').textContent = actionNames[action] + ' · ' + item.type;
    document.getElementById('dialog-item').textContent = item.title;
    workerField.classList.toggle('hidden', action !== 'accept');
    workerSelect.required = action === 'accept';
    dateField.classList.toggle('hidden', action !== 'wait');
    dateInput.required = action === 'wait';
    partsField.classList.toggle('hidden', action !== 'done');
    document.getElementById('submit-action').textContent = actionNames[action];
    form.reset();
    workerSelect.required = action === 'accept';
    dateInput.required = action === 'wait';
    dialog.showModal();
    commentInput.focus();
  }

  function render(data){
    workers = data.workers || [];
    setOptions(workers);
    body.replaceChildren();
    document.getElementById('item-count').textContent = data.items.length + (data.items.length === 1 ? ' Eintrag' : ' Einträge');
    if(!data.items.length){
      const row = document.createElement('tr');
      const cell = createCell('Keine offenen Vorgänge vorhanden.', 'empty');
      cell.colSpan = 6;
      row.appendChild(cell);
      body.appendChild(row);
      return;
    }
    data.items.forEach(function(item){
      const row = document.createElement('tr');
      const kind = createCell('', '');
      const kindLabel = document.createElement('span');
      kindLabel.className = 'kind ' + item.type.toLowerCase();
      kindLabel.textContent = item.type;
      kind.appendChild(kindLabel);
      row.appendChild(kind);

      const due = createCell(item.due_date || 'Ohne Termin', 'date' + (item.due_date && item.due_date < new Date().toISOString().slice(0,10) ? ' overdue' : '') + (!item.due_date ? ' none' : ''));
      row.appendChild(due);
      const title = createCell(item.title, 'item-title');
      if(item.assignee){
        const sub = document.createElement('div');
        sub.className = 'item-sub';
        sub.textContent = 'Zuständig: ' + item.assignee;
        title.appendChild(sub);
      }
      row.appendChild(title);
      row.appendChild(createCell(item.priority || '—', 'priority ' + (item.priority || '').toLowerCase()));
      row.appendChild(createCell(item.status, 'status'));

      const actions = createCell('', '');
      const actionSet = document.createElement('div');
      actionSet.className = 'action-set';
      [['accept','Annehmen','accept'],['done','Fertig','finish'],['discard','Verwerfen','discard'],['wait','Warten','wait']].forEach(function(def){
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'action-button ' + def[2];
        button.textContent = def[1];
        button.addEventListener('click', function(){openAction(item,def[0]);});
        actionSet.appendChild(button);
      });
      actions.appendChild(actionSet);
      row.appendChild(actions);
      body.appendChild(row);
    });
  }

  async function refresh(){
    try{
      const response = await fetch('/global/data', {cache:'no-store'});
      if(!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      render(data);
      document.getElementById('updated-at').textContent = 'Stand ' + new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});
      loadState.textContent = '';
    }catch(error){
      loadState.textContent = 'Verbindung fehlgeschlagen · erneuter Versuch folgt';
    }
  }

  form.addEventListener('submit', async function(event){
    event.preventDefault();
    if(!current || !form.reportValidity()) return;
    const payload = {
      type: current.item.type_key,
      id: current.item.id,
      action: current.action,
      comment: commentInput.value.trim(),
      rfid_uid: rfidInput.value.trim(),
      assigned_to: workerSelect.value,
      follow_up_date: dateInput.value,
      no_parts_needed: document.getElementById('no-parts').checked
    };
    const submit = document.getElementById('submit-action');
    submit.disabled = true;
    try{
      const response = await fetch('/global/actions', {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){return {};});
      if(!response.ok) throw new Error(result.error || 'Aktion konnte nicht gespeichert werden');
      dialog.close();
      await refresh();
    }catch(error){
      loadState.textContent = error.message;
    }finally{
      submit.disabled = false;
      rfidInput.value = '';
    }
  });

  document.getElementById('cancel-action').addEventListener('click', function(){dialog.close();});
  document.getElementById('fullscreen-button').addEventListener('click', function(){
    if(document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen().catch(function(){});
  });
  refresh();
  window.setInterval(function(){if(!dialog.open) refresh();},30000);
})();
</script>
</body>
</html>
