{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Zuordnungen · Import</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a> · alle markierten Werte aus allen Import-Verbindungen an einem Ort</p>
</div>

<div class="card" style="margin-bottom:14px">
  <input id="mapping-search" class="form-input" placeholder="Suchen (Verbindung, Quelle, Bezeichnung, Infrastruktur)..." oninput="filterMappingRows()" autocomplete="off">
</div>

<div class="card" style="overflow-x:auto">
  <div class="card-title">Zuordnungen · {{len .ImportMappings}}</div>
  {{if .ImportMappings}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px" id="mapping-table">
    <thead>
      <tr>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Verbindung</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Quelle</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Bezeichnung</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Infrastruktur</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Zuordnung</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Letzter Wert</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Aktualisiert</th>
      </tr>
    </thead>
    <tbody>
      {{range .ImportMappings}}
      <tr data-mapping-id="{{.ID}}" data-mapping-name="{{.Name}}" data-conn-id="{{.ConnectionID}}" data-conn-path="{{.ConnectionPath}}" data-can-write="{{$.CanWrite}}"
          oncontextmenu="showContextMenu(event, overviewMappingContextItems(this, 'import')); return false;">
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.ConnectionName}} <span style="color:var(--muted)">({{.ConnectionKindLabel}})</span></td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border);word-break:break-all;font-family:monospace">{{.SourceRef}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Name}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.InfrastructureName}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Note}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border);font-family:monospace;word-break:break-all">{{if .LastValue}}{{.LastValue}}{{else}}<span style="color:var(--muted)">–</span>{{end}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">{{if .LastReceivedAt}}{{.LastReceivedAt}}{{else}}<span style="color:var(--muted)">noch kein Wert</span>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:10px 0">Noch keine Werte markiert.</div>
  {{end}}
</div>
{{end}}

{{define "scripts"}}
<script>
function filterMappingRows(){
  const q = document.getElementById('mapping-search').value.toLowerCase();
  document.querySelectorAll('#mapping-table tbody tr').forEach(function(row){
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
}

function overviewMappingContextItems(row, direction){
  const canWrite = row.dataset.canWrite === 'true';
  const items = [{heading: row.dataset.mappingName}];
  items.push({label: 'Zur Verbindung öffnen', icon: 'ti-external-link', onClick: function(){
    window.location = '/' + direction + '/connections/' + row.dataset.connId + '/' + row.dataset.connPath;
  }});
  if(canWrite){
    items.push({separator: true});
    items.push({label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){
      if(!confirm('Zuordnung "' + row.dataset.mappingName + '" wirklich löschen?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/' + direction + '/connections/' + row.dataset.connId + '/mappings/' + row.dataset.mappingId + '/delete-web';
      document.body.appendChild(form);
      form.submit();
    }});
  }
  return items;
}
</script>
{{end}}
