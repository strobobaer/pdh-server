{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">Rollen & Berechtigungen</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px">{{len .Roles}} Rollen · {{len .PermissionGroups}} Berechtigungsgruppen</p>
</div>

<div class="grid2" style="grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
  <!-- Neue Rolle -->
  <div class="card">
    <div class="card-title">Neue Rolle anlegen</div>
    <form method="POST" action="/admin/roles">
      <div class="grid2" style="gap:10px">
        <div class="form-group">
          <label class="form-label">Schlüssel (technisch, z.B. "einkauf")</label>
          <input name="key" class="form-input" pattern="[a-z0-9_]+" title="nur Kleinbuchstaben, Ziffern, Unterstrich" required>
        </div>
        <div class="form-group">
          <label class="form-label">Anzeigename</label>
          <input name="label" class="form-input" placeholder="z.B. Einkauf" required>
        </div>
        <div class="form-group">
          <label class="form-label">Rang (Hierarchie)</label>
          <input type="number" min="0" name="level" class="form-input" value="{{.NextRoleLevel}}" required>
        </div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Höherer Rang = mehr Befugnis. Eine Rolle kann nur Benutzer und Rollen mit echt niedrigerem Rang verwalten.</p>
      <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> Rolle anlegen</button>
    </form>
  </div>

  <!-- Auto-Logout -->
  <div class="card">
    <div class="card-title">Auto-Logout</div>
    <form method="POST" action="/admin/settings">
      <div class="grid2" style="gap:10px">
        <div class="form-group">
          <label class="form-label">Inaktivität bis Auto-Logout (Minuten)</label>
          <input type="number" min="1" name="idle_timeout_minutes" class="form-input" value="{{.IdleTimeoutMinutes}}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Override-Sitzung: Rücksprung nach (Minuten)</label>
          <input type="number" min="1" name="override_timeout_minutes" class="form-input" value="{{.OverrideTimeoutMinutes}}" required>
        </div>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:-4px 0 10px">Systemnutzer (Häkchen in der Benutzerverwaltung) sind von der Auto-Logout-Zeit ausgenommen und bleiben dauerhaft eingeloggt.</p>
      {{template "icon-button" (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Speichern")}}
    </form>
  </div>
</div>

<!-- Berechtigungs-Matrix -->
<div class="card" style="overflow-x:auto">
  <div class="card-title">Berechtigungs-Matrix</div>
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Berechtigung</th>
        {{range .Roles}}
        <th style="text-align:center;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap"
            {{if .CanManage}}oncontextmenu="showContextMenu(event, roleColumnContextItems('{{.ID}}','{{.Label}}',{{.IsBuiltin}})); return false;"{{end}}>
          {{.Label}}
          <div style="font-size:10px;font-weight:400;color:var(--muted);display:flex;align-items:center;justify-content:center;gap:3px" title="Rangstufe in der Hierarchie">
            Rang
            {{if .CanManage}}
            <input type="number" min="0" value="{{.Level}}" id="role-level-{{.ID}}" style="width:42px;font-size:10px;padding:1px 3px;background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--text);text-align:center"
                   onchange="saveRoleLevel(this,'{{.ID}}')">
            {{else}}
            {{.Level}}
            {{end}}
          </div>
          {{$rdep := index $.RoleDepartments .ID}}
          {{with index $.RoleTrainings .Key}}<div style="font-size:10px;font-weight:400;color:var(--muted);margin-top:2px;max-width:140px;white-space:normal" title="Pflichtschulungen dieser Rolle"><i class="ti ti-school"></i> {{join . ", "}}</div>{{end}}
          <div style="font-size:10px;font-weight:400;color:var(--muted);margin-top:2px" title="Abteilung der Rolle">
            {{if .CanManage}}
            <select onchange="saveRoleDepartment(this,'{{.ID}}')" style="max-width:120px;font-size:10px;padding:1px 3px;background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--text)" aria-label="Abteilung der Rolle {{.Label}}">
              <option value="">– Abteilung –</option>
              {{range $.Departments}}<option value="{{.ID}}" {{if eq .ID $rdep}}selected{{end}}>{{.Name}}</option>{{end}}
            </select>
            {{else}}{{range $.Departments}}{{if eq .ID $rdep}}{{.Name}}{{end}}{{end}}{{end}}
          </div>
          {{if and (not .IsBuiltin) .CanManage}}
          <form id="role-delete-form-{{.ID}}" method="POST" action="/admin/roles/{{.ID}}/delete-web" style="display:inline" onsubmit="return confirm('Rolle {{.Label}} wirklich löschen?')">
            <button type="submit" class="btn-icon" style="width:20px;height:20px;vertical-align:middle" title="Rolle löschen"><i class="ti ti-trash" style="font-size:12px"></i></button>
          </form>
          {{end}}
        </th>
        {{end}}
      </tr>
    </thead>
    <tbody>
      {{$roles := .Roles}}
      {{$matrix := .Matrix}}
      {{range .PermissionGroups}}
      <tr><td colspan="99" style="padding:10px 10px 4px;font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px">{{.Category}}</td></tr>
      {{range .Permissions}}
      {{$perm := .}}
      <tr>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Label}}</td>
        {{range $roles}}
        {{$role := .}}
        <td style="text-align:center;padding:6px 10px;border-bottom:1px solid var(--border)">
          <input type="checkbox" {{if index $matrix $role.ID $perm.ID}}checked{{end}} {{if not $role.CanManage}}disabled title="Rang zu niedrig, um diese Rolle zu bearbeiten"{{end}}
                 onchange="saveMatrixCell(this,'{{$role.ID}}','{{$perm.ID}}')">
        </td>
        {{end}}
      </tr>
      {{end}}
      {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "scripts"}}
<script>
function roleColumnContextItems(roleId, roleLabel, isBuiltin){
  const items = [
    {heading: roleLabel},
    {label: 'Rang ändern', icon: 'ti-arrows-sort', onClick: function(){
      const input = document.getElementById('role-level-' + roleId);
      if(input){ input.focus(); input.select(); }
    }}
  ];
  if(!isBuiltin){
    items.push({separator: true});
    items.push({label: 'Rolle löschen', icon: 'ti-trash', danger: true, onClick: function(){
      const form = document.getElementById('role-delete-form-' + roleId);
      if(form) form.requestSubmit();
    }});
  }
  return items;
}

async function saveRoleDepartment(sel, roleId){
  sel.disabled = true;
  try{
    const res = await fetch('/admin/roles/' + roleId + '/department-web', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'department_id=' + encodeURIComponent(sel.value)
    });
    if(!res.ok) throw new Error((await res.text()) || ('HTTP ' + res.status));
  }catch(e){ alert('Abteilung konnte nicht gespeichert werden: ' + e.message); location.reload(); }
  sel.disabled = false;
}
async function saveRoleLevel(input, roleId){
  const previous = input.defaultValue;
  input.disabled = true;
  try{
    const res = await fetch('/admin/roles/' + roleId + '/level-web', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'level=' + encodeURIComponent(input.value)
    });
    if(!res.ok) throw new Error((await res.text()) || ('HTTP ' + res.status));
    location.reload();
  }catch(e){
    alert('Rang konnte nicht gespeichert werden: ' + e.message);
    input.value = previous;
    input.disabled = false;
  }
}

async function saveMatrixCell(checkbox, roleId, permId){
  checkbox.disabled = true;
  try{
    const res = await fetch('/admin/roles/matrix-web', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: 'role_id=' + encodeURIComponent(roleId) + '&permission_id=' + encodeURIComponent(permId) + '&granted=' + (checkbox.checked ? 'true' : 'false')
    });
    if(!res.ok) throw new Error('HTTP ' + res.status);
  }catch(e){
    alert('Konnte nicht gespeichert werden: ' + e.message);
    checkbox.checked = !checkbox.checked;
  }
  checkbox.disabled = false;
}
</script>
{{end}}
