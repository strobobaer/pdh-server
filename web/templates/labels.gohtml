{{define "labels-page"}}<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PDH – {{.Title}}</title>
<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:#e5e7eb;color:#111}
.toolbar{position:sticky;top:0;z-index:5;background:#1a1d27;color:#e8eaf6;padding:10px 16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:13px}
.toolbar b{font-size:14px;margin-right:6px}
.toolbar select,.toolbar input{background:#222536;color:#e8eaf6;border:1px solid #2a2d3e;border-radius:6px;padding:5px 8px;font-size:13px}
.toolbar input[type=number]{width:64px}
.toolbar button{border:0;border-radius:6px;padding:7px 14px;font-size:13px;cursor:pointer;background:#4f6ef7;color:#fff}
.toolbar .muted{color:#9ca3af}
.toolbar label{display:inline-flex;gap:6px;align-items:center}
.err{margin:16px;padding:12px;background:#fee2e2;color:#991b1b;border-radius:8px}
.preview{padding:16px;display:flex;flex-direction:column;align-items:center;gap:12px}

/* Etikett */
.label{width:{{.Size.W}}mm;height:{{.Size.H}}mm;background:#fff;overflow:hidden;display:flex;gap:1.5mm;padding:1.5mm 2mm;position:relative}
.label .qr{flex-shrink:0;height:100%;aspect-ratio:1/1}
.label .qr svg{width:100%;height:100%;display:block}
.label .txt{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;line-height:1.12}
.label .loc{font-weight:700;font-size:{{if .Size.Compact}}9pt{{else}}11pt{{end}};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-bottom:.3mm solid #000;padding-bottom:.4mm}
.label .path{font-size:5.5pt;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.label .name{font-size:{{if .Size.Compact}}7pt{{else}}8.5pt{{end}};font-weight:600;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.label .cat{font-size:5.5pt;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.label .row{display:flex;justify-content:space-between;align-items:flex-end;gap:2mm}
.label .pn{font-family:"Courier New",monospace;font-weight:700;font-size:{{if .Size.Compact}}8pt{{else}}10pt{{end}};white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* Teilenummer immer vollständig (bricht notfalls um), darunter der Hersteller */
.label .pn-block{min-width:0;flex:1}
.label .pn-full{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere;word-break:break-all;line-height:1.05}
.label .mf{font-size:{{if .Size.Compact}}6pt{{else}}7pt{{end}};font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.label .min{font-size:6.5pt;white-space:nowrap;text-align:right}
.label .min b{font-size:{{if .Size.Compact}}8pt{{else}}9.5pt{{end}}}
.label .k{font-size:5pt;color:#555;text-transform:uppercase;letter-spacing:.2px}
.label .brand{position:absolute;right:1.5mm;top:1.2mm;max-height:3.6mm;max-width:12mm;object-fit:contain}
.label.has-brand .loc{padding-right:13mm}

/* gestaltetes Layout (Etiketten-Designer) */
.label.lx{display:block;padding:0;position:relative}
.lx-f{position:absolute;overflow:hidden;line-height:1.12;color:#000}
.lx-t{display:-webkit-box;-webkit-box-orient:vertical;word-break:break-word}
.lx-qr svg{width:100%;height:100%;display:block}
.lx-logo{object-fit:contain;object-position:left top}
/* Lagerort-Auswahl */
.lsel{position:relative}
.lsel > summary{list-style:none;cursor:pointer;padding:4px 10px;border:1px solid #888;border-radius:4px;background:#fff}
.lsel > summary::-webkit-details-marker{display:none}
.lsel-box{position:absolute;z-index:20;top:110%;left:0;width:min(440px,92vw);max-height:60vh;overflow:auto;background:#fff;color:#111;border:1px solid #bbb;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.2);padding:8px}
.lsel-box label{display:flex;align-items:center;gap:6px;padding:3px 0;font-size:13px;cursor:pointer}
.lsel-box label small{color:#666;margin-left:auto}
.lsel-box .lvl{font-size:10px;color:#666;border:1px solid #ccc;border-radius:3px;padding:0 4px}
.lsel-foot{display:flex;gap:8px;align-items:center;position:sticky;bottom:-8px;background:#fff;padding:6px 0 0;border-top:1px solid #eee;margin-top:6px}

/* A4-Bogen */
.sheet{width:210mm;height:297mm;background:#fff;padding:{{.Size.MarginTop}}mm 0 0 {{.Size.MarginLeft}}mm;display:grid;grid-template-columns:repeat({{.Size.Cols}},{{.Size.W}}mm);grid-auto-rows:{{.Size.H}}mm;justify-content:center;align-content:start}
.sheet .label{outline:.1mm dashed #ccc}
.sheet .empty{background:repeating-linear-gradient(45deg,#fafafa,#fafafa 2mm,#f0f0f0 2mm,#f0f0f0 4mm)}
.roll .label{outline:1px solid #ccc;box-shadow:0 1px 3px rgba(0,0,0,.2)}

@media print{
  body{background:#fff}
  .toolbar,.err{display:none}
  .preview{padding:0;display:block}
  .sheet .label{outline:none}
  .sheet .empty{background:none}
  .roll .label{outline:none;box-shadow:none;page-break-after:always;break-after:page}
  .sheet{page-break-after:always;break-after:page}
  {{if .Size.Sheet}}@page{size:A4;margin:0}{{else}}@page{size:{{.Size.W}}mm {{.Size.H}}mm;margin:0}{{end}}
}
</style>
</head>
<body>
<form class="toolbar" method="get" action="{{.Action}}">
  <b>Etiketten</b>
  {{range .Params}}<input type="hidden" name="{{.Key}}" value="{{.Value}}">{{end}}
  {{if not .Assets}}
  <details class="lsel" {{if .NeedSelect}}open{{end}}>
    <summary>📦 Lagerort wählen{{$n := 0}}{{range .Tree}}{{if .Selected}}{{$n = 1}}{{end}}{{end}}{{if $n}} ✓{{end}}</summary>
    <div class="lsel-box">
      <input type="search" placeholder="Lager, Regal, Fach, Platz suchen …" oninput="lselFilter(this.value)" style="width:100%;margin-bottom:6px">
      {{range .Tree}}<label style="{{.Indent}}" data-path="{{.Path}}"><input type="checkbox" name="node" value="{{.ID}}" {{if .Selected}}checked{{end}}> <span class="lvl">{{.Type}}</span> {{.Name}} <small>{{.Parts}}</small></label>
      {{else}}<div class="muted">Keine Lagerorte angelegt</div>{{end}}
      <div class="lsel-foot">
        <label style="padding:0"><input type="checkbox" name="stock" value="1" {{if .StockOnly}}checked{{end}}> nur mit Bestand</label>
        <span style="flex:1"></span>
        <button type="submit">Übernehmen</button>
      </div>
      <div class="muted" style="font-size:11px">Gewählt ist der Platz mit allen Unterplätzen. Die Zahl nennt die Etiketten (Teil × Platz).</div>
    </div>
  </details>
  {{end}}
  <label>Format <select name="size" onchange="this.form.submit()">{{range .Sizes}}<option value="{{.Key}}" {{if eq .Key $.Size.Key}}selected{{end}}>{{.Label}}</option>{{end}}</select></label>
  <label>Kopien <input type="number" name="copies" min="1" max="50" value="{{.Copies}}" onchange="this.form.submit()"></label>
  {{if .Size.Sheet}}<label title="Bereits verbrauchte Felder auf einem angebrochenen Bogen überspringen">Start bei Feld <input type="number" name="start" min="0" max="40" value="{{.Start}}" onchange="this.form.submit()"></label>{{end}}
  <label>{{if .Assets}}Pfad{{else}}Kategorie{{end}} <select name="cat_line" onchange="this.form.submit()"><option value="1">anzeigen</option><option value="0" {{if not .ShowCat}}selected{{end}}>ausblenden</option></select></label>
  <span class="muted">{{len .Labels}} Etikett(en){{if gt .Copies 1}} × {{.Copies}}{{end}}{{if .Layout}} · eigenes Layout{{end}}</span>
  {{if .CanDesign}}<a href="/inventory/labels/designer?size={{.Size.Key}}" target="_blank" rel="noopener" style="font-size:13px">✎ Designer</a>{{end}}
  <span style="flex:1"></span>
  <button type="button" onclick="window.print()">🖨 Drucken</button>
  {{if .Printers}}
  <span class="muted">oder direkt:</span>
  <select id="lp-printer" title="Eingerichtete Drucker (Verwaltung → Drucker)">{{range .Printers}}<option value="{{.ID}}" data-kind="{{.Kind}}" {{if and .IsDefault (ne .Kind "network")}}selected{{end}}>{{.Name}}{{if .Location}} · {{.Location}}{{end}}</option>{{end}}</select>
  <button type="button" id="lp-go" onclick="lpPrint()" style="background:#10b981">⇢ Direkt drucken</button>
  <span id="lp-msg" class="muted" style="width:100%;text-align:right"></span>
  {{end}}
</form>

{{if .Error}}<div class="err">{{.Error}}</div>{{end}}

<div class="preview {{if not .Size.Sheet}}roll{{end}}">
{{range .Pages}}
  {{if $.Size.Sheet}}<div class="sheet">{{end}}
  {{range .}}
    {{if and . .Parts}}{{$it := .}}
    <div class="label lx">{{range .Parts}}{{if eq .Kind "qr"}}<div class="lx-f lx-qr" style="{{.Style}}">{{$it.QR}}</div>{{else if eq .Kind "logo"}}<img class="lx-f lx-logo" style="{{.Style}}" src="{{$.Logo}}" alt="">{{else}}<div class="lx-f lx-t" style="{{.Style}}">{{.Text}}</div>{{end}}{{end}}</div>
    {{else if .}}
    <div class="label{{if and $.Logo (not $.Size.Compact)}} has-brand{{end}}">
      {{if and $.Logo (not $.Size.Compact)}}<img class="brand" src="{{$.Logo}}" alt="">{{end}}
      <div class="qr">{{.QR}}</div>
      <div class="txt">
        <div>
          <div class="loc">{{if .LocationLeaf}}{{.LocationLeaf}}{{else}}ohne Lagerplatz{{end}}</div>
          {{if and .Location (ne .Location .LocationLeaf) (not $.Size.Compact)}}<div class="path">{{.Location}}</div>{{end}}
        </div>
        <div class="name">{{.Name}}</div>
        {{if and $.ShowCat .Category (not $.Size.Compact)}}<div class="cat">{{.Category}}</div>{{end}}
        <div class="row">
          {{if .Asset}}
          <div style="min-width:0">{{if .PartNumber}}<div class="k">{{.NumKey}}</div><div class="pn">{{.PartNumber}}</div>{{end}}</div>
          <div class="min">{{if .RightKey}}<div class="k">{{.RightKey}}</div>{{end}}<b>{{.Right}}</b></div>
          {{else}}
          <div class="pn-block"><div class="k">Teile-Nr.</div><div class="pn pn-full">{{.PartNumber}}</div>
            <div class="mf">{{if .Manufacturer}}{{.Manufacturer}}{{else}}&nbsp;{{end}}</div></div>
          <div class="min"><div class="k">Mindestmenge</div><b>{{.MinQty}}</b> {{.Unit}}</div>
          {{end}}
        </div>
      </div>
    </div>
    {{else}}<div class="label empty"></div>{{end}}
  {{end}}
  {{if $.Size.Sheet}}</div>{{end}}
{{else}}
  {{if .NeedSelect}}<div class="err" style="background:#e0f2fe;color:#075985">Oben unter „📦 Lagerort wählen“ ein Lager, Regal, Fach oder einen Platz auswählen – oder Etiketten aus einem Ersatzteil bzw. der Ersatzteilliste aufrufen.</div>{{else if not .Error}}<div class="err" style="background:#fef3c7;color:#92400e">Keine Etiketten für diese Auswahl.</div>{{end}}
{{end}}
</div>
{{if .Printers}}
{{template "dymo-connect-js"}}
<script>
async function lpPrint(){
  const form = document.querySelector('form.toolbar'), sel = document.getElementById('lp-printer');
  const msg = document.getElementById('lp-msg'), btn = document.getElementById('lp-go');
  const body = new URLSearchParams(new FormData(form));
  body.set('printer', sel.value);
  btn.disabled = true; msg.style.color = ''; msg.textContent = 'Wird gesendet …';
  try{
    const res = await fetch({{.PrintURL}}, {method: 'POST', credentials: 'same-origin', body: body});
    const j = await res.json().catch(() => ({}));
    if(!res.ok || !j.success) throw new Error(j.error || ('HTTP ' + res.status));
    if(j.dymo){
      let n = 0;
      for(const xml of j.labels){ await pdhDymo.print(j.service_port, j.printer_name, xml); n++; msg.textContent = n + ' von ' + j.labels.length + ' an DYMO gesendet …'; }
      msg.textContent = n + ' Etikett(en) an „' + j.printer_name + '“ gesendet';
    } else {
      msg.textContent = j.message;
    }
    msg.style.color = '#34d399';
  }catch(e){ msg.textContent = e.message; msg.style.color = '#f87171'; }
  btn.disabled = false;
}
</script>
{{end}}
<script>function lselFilter(q){  q = q.trim().toLowerCase();  document.querySelectorAll('.lsel-box label[data-path]').forEach(function(l){ l.style.display = !q || l.dataset.path.toLowerCase().indexOf(q) >= 0 ? '' : 'none'; });}</script>
</body>
</html>
{{end}}
