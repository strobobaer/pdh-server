{{template "base" .}}

{{define "content"}}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
  <div>
    <h1 style="font-size:19px;font-weight:600">Störungserfassung</h1>
    <p style="font-size:12px;color:var(--muted);margin-top:3px">{{.Total}} Störungen · {{.Open}} offen</p>
  </div>
  {{template "icon-button-toolbar" (dict
  "Class" "end"
  "Label" "Störungsaktionen"
  "Items" (list
      (dict "Action" "new" "ShowLabel" true "OnClick" "document.getElementById('new-fault-form').style.display='block'")
      (dict "Action" "view" "ShowLabel" true "Label" "Auswahl öffnen" "OnClick" "runSelectedItemAction('view')")
      (dict "Action" "analyze" "ShowLabel" true "Label" "Auswahl analysieren" "OnClick" "runSelectedItemAction('analyze')")
      (dict "Action" "copy" "ShowLabel" true "Label" "Auswahl kopieren" "OnClick" "runSelectedItemAction('copy')")
      (dict "Action" "done" "ShowLabel" true "Label" "Auswahl erledigen" "OnClick" "runSelectedItemAction('done')")
  )
)}}
</div>

<!-- Neue Störung Form -->
<div id="new-fault-form" style="display:none;margin-bottom:16px" class="card">
  <div class="card-title">Störung erfassen
    {{template "icon-button" (dict "Action" "cancel" "OnClick" "document.getElementById('new-fault-form').style.display='none'")}}
  </div>
  <form onsubmit="return submitFaultForm(this)">
    <div class="grid2">
      <div class="form-group">
        <label class="form-label">Titel</label>
        <input name="title" class="form-input" placeholder="Kurzbeschreibung" required>
      </div>
      <div class="form-group">
        <label class="form-label">Schweregrad</label>
        <select name="severity" class="form-input">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Zugewiesen</label>
        <select name="assigned_to" class="form-input">
          <option value="">Nicht zugewiesen</option>
          {{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Verantwortlich</label>
        <select name="responsible_to" class="form-input">
          <option value="">Nicht gesetzt</option>
          {{range .Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Beschreibung</label>
      <input name="description" class="form-input" placeholder="Detaillierte Beschreibung">
    </div>
    <div class="form-group">
      <label class="form-label">Symptome (kommagetrennt)</label>
      <input name="symptoms" class="form-input" placeholder="Überhitzung, Lärm, Brandgeruch">
    </div>

    {{template "infra-tree-picker" (dict "TargetID" "fault-infra-id" "SelectedLabelID" "fault-infra-selected" "Label" "Infrastruktur")}}

    <div id="fault-create-result" style="font-size:12px;margin-bottom:8px"></div>
    {{template "icon-button-toolbar" (dict
      "Class" "end"
      "Label" "Formularaktionen"
  "Style" "width:100%;justify-content:flex-end"
  "Items" (list
        (dict "Action" "cancel" "ShowLabel" true "OnClick" "document.getElementById('new-fault-form').style.display='none'")
        (dict "Action" "save" "ShowLabel" true "Type" "submit" "Label" "Erfassen")
  )
)}}
  </form>
</div>

<!-- Filter -->
<div class="widget-icon-toolbar compact" style="margin-bottom:14px" aria-label="Störungsfilter">
  {{if eq .Filter ""}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/faults" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Alle" "Href" "/faults")}}{{end}}
  {{if eq .Filter "detected"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Erkannt" "Href" "/faults?status=detected" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "Erkannt" "Href" "/faults?status=detected")}}{{end}}
  {{if eq .Filter "in_progress"}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Bearbeitung" "Href" "/faults?status=in_progress" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "filter" "ShowLabel" true "Label" "In Bearbeitung" "Href" "/faults?status=in_progress")}}{{end}}
  {{if eq .Filter "archive"}}{{template "icon-button" (dict "Action" "history" "ShowLabel" true "Label" "Archiv" "Href" "/faults?status=archive" "Class" "btn-primary")}}{{else}}{{template "icon-button" (dict "Action" "history" "ShowLabel" true "Label" "Archiv" "Href" "/faults?status=archive")}}{{end}}
</div>

<!-- Liste -->
<div id="faults-list" class="card" style="padding:0">
  <table>
    <thead>
      <tr style="cursor:pointer">
        <th>Störung</th>
        <th>Schweregrad</th>
        <th>Status</th>
        <th>Erfasst</th>
        <th>Aktionen</th>
      </tr>
    </thead>
    <tbody>
    {{range .Faults}}
    <tr class="selectable-item" data-selectable data-title="{{.Title}}" data-view-href="/faults/{{.ID}}" data-copy-text="{{.Title}} {{.InfraName}}" data-done-url="/faults/{{.ID}}/resolve" {{if eq .Status "detected"}}data-analyze-url="/faults/{{.ID}}/analyze"{{end}} style="cursor:pointer">
      <td>
        <a href="/faults/{{.ID}}" style="display:block;color:inherit;text-decoration:none">
          <div style="font-weight:500">{{.Title}}</div>
          {{if .InfraName}}<div style="font-size:11px;color:var(--accent)">{{.InfraName}}</div>{{end}}
          <div style="font-size:11px;color:var(--muted)">{{.Description}}</div>
        </a>
      </td>
      <td><span class="badge {{.SeverityClass}}">{{.Severity}}</span></td>
      <td><span class="badge {{.StatusClass}}">{{.StatusLabel}}</span></td>
      <td style="font-size:11px;color:var(--muted)">{{.DetectedAgo}}</td>
      <td>
        <div class="widget-icon-toolbar compact">
          {{template "icon-button" (dict "Action" "view" "ShowLabel" true "Href" (printf "/faults/%s" .ID))}}
          {{if eq .Status "detected"}}
          {{template "icon-button" (dict "Action" "analyze" "ShowLabel" true "HxPost" (printf "/faults/%s/analyze" .ID) "HxTarget" "closest tr" "HxSwap" "outerHTML")}}
          {{end}}
        </div>
      </td>
    </tr>
    {{else}}
    <tr style="cursor:pointer"><td colspan="5" style="text-align:center;color:var(--muted);padding:24px">Keine Störungen vorhanden</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{define "context-list"}}
{{range .RecentAnalyses}}
<div class="act-item">
  <div class="act-dot d-blue"></div>
  <div class="act-text">{{.FaultTitle}}</div>
  <span style="font-size:10px;color:var(--muted)">{{printf "%.0f" .Confidence}}%</span>
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
async function submitFaultForm(form){
  const fd=new FormData(form);
  const symptoms=String(fd.get('symptoms')||'').split(',').map(s=>s.trim()).filter(Boolean);
  const payload={title:fd.get('title'),description:fd.get('description'),severity:fd.get('severity'),symptoms};
  if(fd.get('infrastructure_id')) payload.infrastructure_id=fd.get('infrastructure_id');
  if(fd.get('assigned_to')) payload.assigned_to=fd.get('assigned_to');
  if(fd.get('responsible_to')) payload.responsible_to=fd.get('responsible_to');
  const result=document.getElementById('fault-create-result'); result.textContent='Speichere...';
  try{
    const res=await fetch('/api/v1/faults/',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+pdhToken()},body:JSON.stringify(payload)});
    const json=await res.json(); if(!res.ok||!json.success) throw new Error(json.error||'Fehler');
    window.location.href='/faults';
  }catch(e){result.innerHTML='<span style="color:var(--red)">Fehler: '+escapeHtml(e.message)+'</span>'}
  return false;
}
</script>
{{end}}
