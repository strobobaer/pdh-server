{{template "base" .}}
{{define "content"}}
<div style="margin-bottom:18px">
  <h1 style="font-size:19px;font-weight:600">MQTT-Sniffer · {{.ConnectionName}}</h1>
  <p style="font-size:12px;color:var(--muted);margin-top:3px"><a href="/import">← zurück zu Import</a></p>
</div>

{{if .Integrated}}
<div class="card" role="status">
  Der integrierte Broker dieser Verbindung läuft noch nicht - der Sniffer ist aktuell nur für Verbindungen mit externem Broker verfügbar.
</div>
{{else if not .CanExecute}}
<div class="card" role="status">
  Zum Ausführen des Sniffers fehlt die Berechtigung "Import ausführen".
</div>
{{else}}
<div class="card" style="margin-bottom:14px">
  <div class="card-title">Verbindung</div>
  <dl style="display:grid;grid-template-columns:max-content 1fr;gap:6px 12px;font-size:13px;margin:0">
    <dt style="color:var(--muted)">Broker</dt><dd style="margin:0">{{.Target}}</dd>
    <dt style="color:var(--muted)">Topic-Filter</dt><dd style="margin:0">{{.Topic}}</dd>
  </dl>
  <p style="font-size:11px;color:var(--muted);margin:10px 0 0">Der Sniffer verbindet sich rein lesend (Subscribe) und beendet sich automatisch nach 15 Minuten oder beim Schließen dieser Seite.</p>
  <div style="display:flex;gap:8px;align-items:center;margin-top:12px">
    <button type="button" class="btn btn-primary" id="sniffer-start"><i class="ti ti-player-play"></i> Sniffer starten</button>
    <button type="button" class="btn" id="sniffer-stop" hidden><i class="ti ti-player-stop"></i> Stoppen</button>
    <span id="sniffer-status" style="font-size:12px;color:var(--muted)">Nicht verbunden</span>
  </div>
</div>

<div class="card" style="overflow-x:auto">
  <div class="card-title">Empfangene Nachrichten · <span id="sniffer-count">0</span></div>
  <table style="border-collapse:collapse;width:100%;font-size:12px">
    <thead>
      <tr>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Zeit</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Topic</th>
        <th style="text-align:center;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">QoS</th>
        <th style="text-align:center;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Retained</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Payload</th>
        {{if .CanWrite}}<th style="text-align:center;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Aktion</th>{{end}}
      </tr>
    </thead>
    <tbody id="sniffer-log"></tbody>
  </table>
  <div id="sniffer-empty" style="font-size:12px;color:var(--muted);padding:10px 0">Noch keine Nachrichten empfangen.</div>
</div>

{{if .CanWrite}}
<div class="card" id="mark-panel" style="margin:14px 0" hidden>
  <div class="card-title">Wert markieren</div>
  <div class="form-group">
    <label class="form-label">Topic</label>
    <input id="mark-topic" class="form-input" readonly>
  </div>
  {{template "infra-tree-picker" (dict "TargetID" "mark-infra-id" "SelectedLabelID" "mark-infra-selected" "Label" "Infrastruktur" "Required" true)}}
  <div class="form-group">
    <label class="form-label">Bezeichnung</label>
    <input id="mark-name" class="form-input" maxlength="150" placeholder="z.B. Temperatur Halle 1" required>
  </div>
  <div class="form-group">
    <label class="form-label">Zuordnung / Notiz <span style="color:var(--muted);font-weight:400">(optional)</span></label>
    <textarea id="mark-note" class="form-input" maxlength="500" placeholder="z.B. Einheit, Kontext, Verwendungszweck"></textarea>
  </div>
  <div style="display:flex;gap:8px">
    <button type="button" class="btn" id="mark-cancel">Abbrechen</button>
    <button type="button" class="btn btn-primary" id="mark-submit"><i class="ti ti-map-pin"></i> Zuordnung speichern</button>
  </div>
  <p id="mark-error" role="alert" style="font-size:12px;color:var(--red);margin:10px 0 0"></p>
</div>
{{end}}

<div class="card" style="overflow-x:auto;margin-top:14px">
  <div class="card-title">Zuordnungen · {{len .Mappings}}</div>
  {{if .Mappings}}
  <table style="border-collapse:collapse;width:100%;font-size:12.5px">
    <thead>
      <tr>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Topic</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Bezeichnung</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Infrastruktur</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)">Zuordnung</th>
        <th style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">Angelegt</th>
      </tr>
    </thead>
    <tbody>
      {{range .Mappings}}
      <tr data-mapping-id="{{.ID}}" data-mapping-name="{{.Name}}"
          {{if $.CanWrite}}oncontextmenu="showContextMenu(event, mappingContextItems(this)); return false;"{{end}}>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border);word-break:break-all">{{.Topic}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Name}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.InfrastructureName}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border)">{{.Note}}</td>
        <td style="padding:6px 10px;border-bottom:1px solid var(--border);white-space:nowrap">{{.CreatedAt}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div style="font-size:12px;color:var(--muted);padding:10px 0">Noch keine Werte markiert.</div>
  {{end}}
</div>
{{end}}
{{end}}

{{define "scripts"}}
<script>
(function(){
  const startBtn = document.getElementById('sniffer-start');
  const stopBtn = document.getElementById('sniffer-stop');
  const statusEl = document.getElementById('sniffer-status');
  const logBody = document.getElementById('sniffer-log');
  const emptyEl = document.getElementById('sniffer-empty');
  const countEl = document.getElementById('sniffer-count');
  if(!startBtn) return;

  const CAN_WRITE = {{if .CanWrite}}true{{else}}false{{end}};
  let source = null;
  let count = 0;
  const MAX_ROWS = 300;

  function escapeHTML(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function addMessage(msg){
    count++;
    countEl.textContent = String(count);
    emptyEl.hidden = true;
    const row = document.createElement('tr');
    const payload = escapeHTML(msg.payload) + (msg.truncated ? ' …' : '');
    const actionCell = CAN_WRITE
      ? '<td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:center"><button type="button" class="btn-icon" style="width:22px;height:22px;min-width:22px" data-topic="' + escapeHTML(msg.topic) + '" onclick="markTopic(this.dataset.topic)" title="Wert markieren"><i class="ti ti-map-pin" style="font-size:12px"></i></button></td>'
      : '';
    row.innerHTML =
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);white-space:nowrap">' + escapeHTML(msg.time) + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all">' + escapeHTML(msg.topic) + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:center">' + msg.qos + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:center">' + (msg.retained ? 'ja' : '') + '</td>' +
      '<td style="padding:5px 10px;border-bottom:1px solid var(--border);word-break:break-all;font-family:monospace">' + payload + '</td>' +
      actionCell;
    logBody.insertBefore(row, logBody.firstChild);
    while(logBody.children.length > MAX_ROWS) logBody.removeChild(logBody.lastChild);
  }

  function stopSniffer(message){
    if(source){ source.close(); source = null; }
    startBtn.hidden = false;
    stopBtn.hidden = true;
    statusEl.textContent = message || 'Nicht verbunden';
  }

  function startSniffer(){
    logBody.innerHTML = '';
    count = 0;
    countEl.textContent = '0';
    emptyEl.hidden = false;
    startBtn.hidden = true;
    stopBtn.hidden = false;
    statusEl.textContent = 'Verbinde …';

    source = new EventSource('/import/connections/{{.ConnectionID}}/sniffer/stream');
    source.addEventListener('connected', function(event){
      const data = JSON.parse(event.data);
      statusEl.textContent = 'Verbunden mit ' + data.broker + ' · Topic ' + data.topic;
    });
    source.addEventListener('message', function(event){
      addMessage(JSON.parse(event.data));
    });
    source.addEventListener('error', function(event){
      let message = 'Verbindung unterbrochen';
      if(event.data){
        try{ message = JSON.parse(event.data).message || message; }catch(e){}
      }
      stopSniffer(message);
    });
    source.onerror = function(){
      if(source && source.readyState === EventSource.CLOSED) stopSniffer('Verbindung getrennt');
    };
  }

  startBtn.addEventListener('click', startSniffer);
  stopBtn.addEventListener('click', function(){ stopSniffer('Gestoppt'); });
  window.addEventListener('beforeunload', function(){ if(source) source.close(); });
})();

function markTopic(topic){
  const panel = document.getElementById('mark-panel');
  if(!panel) return;
  document.getElementById('mark-topic').value = topic;
  document.getElementById('mark-name').value = '';
  document.getElementById('mark-note').value = '';
  document.getElementById('mark-error').textContent = '';
  const pickerRoot = document.querySelector('.infra-picker[data-target="mark-infra-id"]');
  if(pickerRoot) clearInfraPicker(pickerRoot);
  panel.hidden = false;
  panel.scrollIntoView({behavior:'smooth', block:'start'});
}

document.addEventListener('DOMContentLoaded', function(){
  const cancelBtn = document.getElementById('mark-cancel');
  const submitBtn = document.getElementById('mark-submit');
  if(cancelBtn) cancelBtn.addEventListener('click', function(){
    document.getElementById('mark-panel').hidden = true;
  });
  if(submitBtn) submitBtn.addEventListener('click', async function(){
    const errorEl = document.getElementById('mark-error');
    errorEl.textContent = '';
    const payload = {
      topic: document.getElementById('mark-topic').value,
      infrastructure_id: document.getElementById('mark-infra-id').value,
      name: document.getElementById('mark-name').value.trim(),
      note: document.getElementById('mark-note').value.trim()
    };
    if(!payload.infrastructure_id){ errorEl.textContent = 'Bitte eine Infrastruktur auswählen'; return; }
    if(payload.name.length < 2){ errorEl.textContent = 'Bitte eine Bezeichnung eingeben'; return; }
    submitBtn.disabled = true;
    try{
      const response = await fetch('/import/connections/{{.ConnectionID}}/mappings', {
        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)
      });
      const result = await response.json().catch(function(){ return {}; });
      if(!response.ok) throw new Error(result.error || 'Zuordnung konnte nicht gespeichert werden');
      location.reload();
    }catch(e){
      errorEl.textContent = e.message;
      submitBtn.disabled = false;
    }
  });
});

function mappingContextItems(row){
  return [
    {heading: row.dataset.mappingName},
    {label: 'Löschen', icon: 'ti-trash', danger: true, onClick: function(){
      if(!confirm('Zuordnung "' + row.dataset.mappingName + '" wirklich löschen?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/import/connections/{{.ConnectionID}}/mappings/' + row.dataset.mappingId + '/delete-web';
      document.body.appendChild(form);
      form.submit();
    }}
  ];
}
</script>
{{end}}
