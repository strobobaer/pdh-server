{{template "base" .}}
{{define "content"}}
{{/* TIA-Baustein herunterladen (tia_block.go): SCL-Quellen für Siemens-Steuerungen
     aus dem eigenen Datenbaustein. Farben nur über die Variablen des Farbschemas
     (Fiori und Fluent, hell und dunkel). Das Kennwort steht nie auf der Seite. */}}
<div class="tia-head">
  <div class="rec-sub" style="font-size:12px"><a href="/import" style="color:var(--accent)"><i class="ti ti-arrow-left" aria-hidden="true"></i> Import</a> · <a href="/import/connections/{{.ID}}?tab=tools" style="color:var(--accent)">Verbindung</a></div>
  <h1><i class="ti ti-cpu" aria-hidden="true"></i> TIA-Baustein herunterladen <span class="badge" style="background:var(--bg3);color:var(--text);border:1px solid var(--border)">{{.Name}}</span></h1>
  <p class="tia-intro">PDH baut aus deinem Datenbaustein einen Baustein für S7-1500 oder S7-1200 (ab Firmware 4.2, TIA Portal ab V17). Er schickt die Werte bei steigender Flanke an <code>trigger</code> als JSON an diese Verbindung und meldet sich regelmäßig per Heartbeat.</p>
</div>

{{if .Errors}}<div class="card tia-bad" role="alert"><b><i class="ti ti-alert-circle" aria-hidden="true"></i> Bitte prüfen:</b><ul>{{range .Errors}}<li>{{.}}</li>{{end}}</ul><div class="rec-sub">Die Datei bitte noch einmal auswählen.</div></div>{{end}}

<div class="card">
  <div class="card-title"><span><i class="ti ti-list-numbers" aria-hidden="true"></i> So geht's</span></div>
  <ol class="tia-steps">
    <li>Im TIA Portal den Datenbaustein mit den Werten wählen, Rechtsklick → <b>Quelle aus Baustein generieren</b>. Nutzt der Baustein PLC-Datentypen, die abhängigen Bausteine mit auswählen. Die <code>.db</code>-Datei hier auswählen.</li>
    <li><b>Prüfen</b> zeigt, welche Werte in welcher Nachricht stehen und was übersprungen wird.</li>
    <li><b>Herunterladen</b> liefert eine ZIP-Datei. Die Dateien in der Reihenfolge ihrer Nummer als externe Quellen ins TIA Portal holen und übersetzen – Einzelheiten stehen in <code>LIESMICH.txt</code>.</li>
  </ol>
</div>

<form id="tia-form" method="post" action="/import/connections/{{.ID}}/tia/download" enctype="multipart/form-data" onsubmit="tiaSubmitted()">
  <div class="tia-grid">
    <fieldset class="card tia-set">
      <legend><i class="ti ti-file-code" aria-hidden="true"></i> Datenbaustein</legend>
      <div class="form-group"><label class="form-label" for="tia-file">Quelle des Datenbausteins (.db, höchstens 1 MiB) *</label>
        <input class="form-input" id="tia-file" type="file" name="db_file" accept=".db,.scl,.txt" required></div>
      <button class="btn" type="button" hx-post="/import/connections/{{.ID}}/tia/check" hx-encoding="multipart/form-data" hx-include="#tia-form" hx-target="#tia-check" hx-swap="innerHTML"><i class="ti ti-checklist" aria-hidden="true"></i> Prüfen <span class="htmx-indicator">…</span></button>
    </fieldset>

    <fieldset class="card tia-set">
      <legend><i class="ti ti-cpu" aria-hidden="true"></i> Steuerung</legend>
      <div class="form-group"><span class="form-label">Variante</span>
        <label class="tia-check"><input type="radio" name="variant" value="standalone" {{if eq .Form.Variant "standalone"}}checked{{end}} onchange="tiaVariant()"> Eigenständig (TCON/TSEND/TRCV, ohne TLS)</label>
        <label class="tia-check"><input type="radio" name="variant" value="lmqtt" {{if eq .Form.Variant "lmqtt"}}checked{{end}} onchange="tiaVariant()"> Mit Siemens-Bibliothek LMQTT (TLS möglich)</label>
        <div class="rec-sub">LMQTT muss im Projekt schon eingebunden sein (<a href="{{.InfoURL}}" target="_blank" rel="noopener" style="color:var(--accent)">Beitrag bei Siemens</a>).</div></div>
      <div class="form-group"><label class="form-label" for="tia-family">Steuerung</label>
        <select class="form-input" id="tia-family" name="family">
          <option value="s7-1500" {{if eq .Form.Family "s7-1500"}}selected{{end}}>S7-1500</option>
          <option value="s7-1200" {{if eq .Form.Family "s7-1200"}}selected{{end}}>S7-1200 (ab Firmware 4.2)</option>
        </select></div>
      <div class="tia-pair">
        <div class="form-group"><label class="form-label" for="tia-hw">Hardware-Kennung (hwId)</label><input class="form-input" id="tia-hw" type="number" name="hw_id" min="1" max="65535" value="{{.Form.HwID}}" required></div>
        <div class="form-group"><label class="form-label" for="tia-conn">Verbindungsnummer (connId)</label><input class="form-input" id="tia-conn" type="number" name="conn_id" min="1" max="4095" value="{{.Form.ConnID}}" required></div>
      </div>
      <div class="rec-sub">hwId ist die Kennung der PROFINET-Schnittstelle (Systemkonstante, meist 64). connId darf im Programm nicht schon vergeben sein.</div>
    </fieldset>

    <fieldset class="card tia-set">
      <legend><i class="ti ti-server-2" aria-hidden="true"></i> Broker</legend>
      <div class="tia-pair">
        <div class="form-group"><label class="form-label" for="tia-host">Adresse *</label><input class="form-input" id="tia-host" name="broker_host" maxlength="254" value="{{.Form.BrokerHost}}" required>
          {{if .Integrated}}<div class="rec-sub">Integrierter Broker: die Adresse, unter der die Steuerung den PDH erreicht.{{if .BrokerName}} Der Broker heißt <b>{{.BrokerName}}</b>{{if .BrokerTLSPort}}; mit TLS setzt die Seite den Namen und Port {{.BrokerTLSPort}} ein{{end}}.{{end}}</div>{{end}}</div>
        <div class="form-group"><label class="form-label" for="tia-port">Port *</label><input class="form-input" id="tia-port" type="number" name="broker_port" min="1" max="65535" value="{{.Form.BrokerPort}}" required></div>
      </div>
      <label class="tia-check" id="tia-tls-row"><input type="checkbox" id="tia-tls" name="use_tls" {{if .Form.UseTLS}}checked{{end}}> TLS (nur mit LMQTT)</label>
      <div class="form-group"><label class="form-label" for="tia-client">Client-ID</label><input class="form-input" id="tia-client" name="client_id" maxlength="254" value="{{.Form.ClientID}}" placeholder="leer = pdh-sps-&lt;Datenbaustein&gt;"></div>
      <div class="form-group"><label class="form-label" for="tia-user">Benutzer</label><input class="form-input" id="tia-user" name="username" maxlength="254" value="{{.Form.Username}}" autocomplete="off"></div>
      {{if .CanWrite}}{{if .HasPassword}}
      <label class="tia-check"><input type="checkbox" name="include_password" {{if .Form.IncludePassword}}checked{{end}}> Kennwort der Verbindung mitliefern</label>
      <div class="rec-sub">Ohne Haken steht <code>PASSWORT_EINTRAGEN</code> in der Konfiguration – im TIA Portal eintragen. Mit Haken steht das Kennwort im Klartext in der Datei; der Download wird im Verlauf der Verbindung vermerkt.</div>
      {{end}}{{else}}<div class="rec-sub">Das Kennwort trägst du im TIA Portal ein (<code>PASSWORT_EINTRAGEN</code>).</div>{{end}}
    </fieldset>

    <fieldset class="card tia-set">
      <legend><i class="ti ti-message-2" aria-hidden="true"></i> Nachricht</legend>
      <div class="form-group"><label class="form-label" for="tia-topic">Topic *</label><input class="form-input" id="tia-topic" name="topic" maxlength="244" value="{{.Form.Topic}}" required>
        <div class="rec-sub">Endet es auf „/“, kommt der Name des Datenbausteins dazu. Heartbeat auf <code>&lt;Topic&gt;/heartbeat</code>.</div></div>
      <div class="tia-pair">
        <div class="form-group"><label class="form-label" for="tia-hb">Heartbeat alle … s (0 = aus)</label><input class="form-input" id="tia-hb" type="number" name="heartbeat_seconds" min="0" max="3600" value="{{.Form.HeartbeatSeconds}}" required></div>
        <div class="form-group"><label class="form-label" for="tia-ka">Keep-Alive (s)</label><input class="form-input" id="tia-ka" type="number" name="keepalive_seconds" min="10" max="600" value="{{.Form.KeepAliveSeconds}}" required></div>
      </div>
      <div class="form-group"><label class="form-label" for="tia-limit">Größengrenze je Nachricht (Byte)</label><input class="form-input" id="tia-limit" type="number" name="limit" min="{{.MinLimit}}" max="{{.MaxLimit}}" value="{{.Form.Limit}}" required>
        <div class="rec-sub">Mehr Werte werden auf mehrere Nachrichten verteilt ({{.MinLimit}}–{{.MaxLimit}}).</div></div>
      <label class="tia-check"><input type="checkbox" name="retain" {{if .Form.Retain}}checked{{end}}> Retain (der Broker behält die letzte Nachricht)<span class="rec-sub" style="display:block;margin-left:22px">Bei mehreren Nachrichten (Teilen) gehen alle an dasselbe Topic – der Broker behält nur den letzten Teil.</span></label>
    </fieldset>

    {{if .CanWrite}}
    <fieldset class="card tia-set tia-wide">
      <legend><i class="ti ti-map-pin" aria-hidden="true"></i> Zuordnungen</legend>
      <label class="tia-check"><input type="checkbox" name="create_mappings" {{if .Form.CreateMappings}}checked{{end}}> Beim Herunterladen die Zuordnungen anlegen (je Wert eine, dazu der Heartbeat)</label>
      <div class="rec-sub" style="margin-bottom:8px">Vorhandene Zuordnungen mit demselben Wert bleiben unverändert – zweimal herunterladen legt nichts doppelt an.</div>
      {{template "infra-tree-picker" (dict "TargetID" "tia-infra-id" "SelectedLabelID" "tia-infra-selected" "Label" "Anlage für die Zuordnungen" "Value" .Form.InfraID "SelectedLabel" .InfraLabel)}}
    </fieldset>
    {{end}}
  </div>

  <div class="tia-actions">
    <button class="btn btn-primary" type="submit"><i class="ti ti-download" aria-hidden="true"></i> Herunterladen</button>
  </div>
</form>

<div id="tia-check" aria-live="polite"></div>

<style>
.tia-head h1{font-size:19px;font-weight:600;display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:4px 0 6px}
.tia-intro{font-size:13px;color:var(--muted);max-width:820px;margin-bottom:12px}
.tia-steps{font-size:13px;padding-left:20px;display:grid;gap:4px}
.tia-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:12px}
.tia-set{margin:0;min-width:0}
.tia-set legend{font-size:12.5px;font-weight:600;padding:0 4px;color:var(--text)}
.tia-wide{grid-column:1/-1}
.tia-pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0 12px}
.tia-check{display:flex;gap:6px;align-items:flex-start;font-size:12.5px;margin-bottom:6px}
.tia-check input{margin-top:2px}
.tia-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.tia-bad{border-color:var(--red);color:var(--red)}
.tia-bad ul{margin:6px 0 4px 18px;font-size:13px}
.tia-ok{border-color:var(--green)}
.tia-part{border:1px solid var(--border);border-radius:8px;background:var(--bg3);padding:8px 10px;margin-bottom:8px}
.tia-part summary{cursor:pointer;font-size:12.5px;font-weight:600}
.tia-scroll{overflow-x:auto}
.tia-table{width:100%;border-collapse:collapse;font-size:12px;margin-top:6px}
.tia-table th,.tia-table td{text-align:left;padding:4px 8px;border-bottom:1px solid var(--border);vertical-align:top}
.tia-table th{color:var(--muted);font-weight:500}
.tia-mono{font-family:ui-monospace,Consolas,monospace;word-break:break-all}
#tia-tls-row.tia-off{color:var(--muted)}
</style>
{{end}}

{{define "scripts"}}
<script>
(function(){
  const form = document.getElementById('tia-form');
  const tls = document.getElementById('tia-tls'), row = document.getElementById('tia-tls-row'), port = document.getElementById('tia-port');
  // Broker mit eigenem Namen und TLS-Port: mit TLS gehören Name und TLS-Port zusammen
  const host = document.getElementById('tia-host');
  const brokerName = {{.BrokerName}}, brokerTLS = {{.BrokerTLSPort}};
  let plainHost = host.value, plainPort = port.value;
  // eigenständig kann kein TLS: Haken aus und gesperrt; Port 1883/8883 mitziehen, solange unverändert
  window.tiaVariant = function(){
    const lmqtt = form.querySelector('input[name=variant]:checked')?.value === 'lmqtt';
    if(!lmqtt && tls.checked){ tls.checked = false; tiaPort(); }
    tls.disabled = !lmqtt;
    row.classList.toggle('tia-off', !lmqtt);
  };
  function tiaPort(){
    if(brokerName && brokerTLS){
      if(tls.checked){
        if(host.value !== brokerName) plainHost = host.value;
        if(port.value !== String(brokerTLS)) plainPort = port.value;
        host.value = brokerName; port.value = String(brokerTLS);
      } else {
        if(host.value === brokerName) host.value = plainHost;
        if(port.value === String(brokerTLS)) port.value = plainPort;
      }
      return;
    }
    if(port.value === '1883' && tls.checked) port.value = '8883';
    else if(port.value === '8883' && !tls.checked) port.value = '1883';
  }
  tls.addEventListener('change', tiaPort);
  window.tiaVariant();
  // Ein Download wechselt die Seite nicht: Statusbalken danach zurücksetzen
  window.tiaSubmitted = function(){
    setTimeout(function(){ if(typeof setGlobalStatus === 'function') setGlobalStatus('ok', 'Bereit', 0, 'Keine Fehler'); }, 2500);
  };
})();
</script>
{{end}}
